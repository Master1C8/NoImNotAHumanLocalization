  "entries": [
    {
      "id": 110504456473354250,
      "target": "Bestson: Пуцају, туку се међусобно, не разумем…"
    },
    {
      "id": 110504456473354249,
      "target": "Bestson: Нека ненормална врућина, а још нешто није у реду ни с људима."
    },
    {
      "id": 110504456473354248,
      "target": "Bestson: Можеш ли ми рећи шта се дешава?"
    },
    {
      "id": 110504456460771331,
      "target": "Шта се десило?"
    },
    {
      "id": 110504456460771330,
      "target": "Ко ти је то урадио?"
    },
    {
      "id": 110504456460771329,
      "target": "Fugitive: Упуцали су ме, нећу још дуго издржати."
    },
    {
      "id": 110504456460771328,
      "target": "Fugitive: Помози ми."
    },
    {
      "id": 110504456448188418,
      "target": "Шта вам треба?"
    },
    {
      "id": 110504456448188417,
      "target": "За шта ће одговарати?"
    },
    {
      "id": 110504456448188416,
      "target": "Nun: Мислим да ће ми одговарати."
    },
    {
      "id": 110504456443994123,
      "target": "Nun: Видим да ваша кућица стоји најдаље од свих."
    },
    {
      "id": 110504456431411208,
      "target": "Да, имам пушку"
    },
    {
      "id": 110504456431411207,
      "target": "Зашто те то занима?"
    },
    {
      "id": 110504456431411206,
      "target": "Raskolnikov: Реци ми, јеси ли наоружан?"
    },
    {
      "id": 110504456431411205,
      "target": "Raskolnikov: Здраво, пријатељу."
    },
    {
      "id": 110504456418828294,
      "target": "Чиме се бави ваш муж?"
    },
    {
      "id": 110504456418828293,
      "target": "Како сте стигли овамо?"
    },
    {
      "id": 110504456418828292,
      "target": "Wifefema: Али, нажалост, на његовом послу не могу да ми обезбеде смештај."
    },
    {
      "id": 110504456418828291,
      "target": "Wifefema: Хтела сам да га изненадим и видим."
    },
    {
      "id": 110504456418828290,
      "target": "Wifefema: Дошла сам овамо код мужа. Преместили су га због посла."
    },
    {
      "id": 110504456418828289,
      "target": "Wifefema: Добар дан, могу ли мало да останем код вас?"
    },
    {
      "id": 110504456406245378,
      "target": "Не, нисам из КВС-а"
    },
    {
      "id": 110504456406245377,
      "target": "Да верујем чему?"
    },
    {
      "id": 110504456406245376,
      "target": "Theorist: Ви нисте ни на који начин повезани с КВС-ом?"
    },
    {
      "id": 110504456402051082,
      "target": "Theorist: Добар дан, реците ми, могу ли да вам верујем?"
    },
    {
      "id": 110504456360108036,
      "target": "Јесте ли обе болесне? Или само једна од вас?"
    },
    {
      "id": 110504456360108035,
      "target": "Да ли је вашем ближњем лоше?"
    },
    {
      "id": 110504456360108034,
      "target": "Twins: Не смета што смо дошле овамо?"
    },
    {
      "id": 110504456360108033,
      "target": "Twins: Добар дан. Ох, наслони се засад на мене."
    },
    {
      "id": 110504456347525120,
      "target": "Јесте ли дуго пешачиле?"
    },
    {
      "id": 110504456343330827,
      "target": "Јесте ли баш овамо ишле?"
    },
    {
      "id": 110504456343330826,
      "target": "NotTrue: Могу ли код тебе мало да се одморим?"
    },
    {
      "id": 110504456343330825,
      "target": "NotTrue: Здраво, мили! Баш сам се уморила долазећи довде."
    },
    {
      "id": 110504456334942210,
      "target": "Не намеравам да те пустим"
    },
    {
      "id": 110504456334942209,
      "target": "Шта ти треба?"
    },
    {
      "id": 110504456334942208,
      "target": "SuperFake: Здраво!"
    },
    {
      "id": 110504456326553605,
      "target": "Да ли се нешто десило?"
    },
    {
      "id": 110504456326553604,
      "target": "Јеси ли у хистерији?"
    },
    {
      "id": 110504456326553603,
      "target": "Daughter: Пустите м-ме."
    },
    {
      "id": 110504456326553602,
      "target": "Daughter: Д-д-добар дан."
    },
    {
      "id": 110504456313970692,
      "target": "Испричај ми нешто о свом тати."
    },
    {
      "id": 110504456313970691,
      "target": "Како се зове твој тата?"
    },
    {
      "id": 110504456313970690,
      "target": "Daughter: Дању ме није било страх, али сада јесте — много људи је ноћу изашло да шета…"
    },
    {
      "id": 110504456313970689,
      "target": "Daughter: Је ли мој тата код вас? Хоћете ли га позвати?"
    },
    {
      "id": 110504456313970688,
      "target": "Daughter: Здраво!"
    },
    {
      "id": 110504456284610565,
      "target": "И шта се то дешава?"
    },
    {
      "id": 110504456284610564,
      "target": "Шта ти треба?"
    },
    {
      "id": 110504456284610563,
      "target": "Scammer: Како ти иду послићи?"
    },
    {
      "id": 110504456284610562,
      "target": "Scammer: Видиш ли шта се дешава? Баш је јебено лудило."
    },
    {
      "id": 110504456284610561,
      "target": "Scammer: О, здраво."
    }
  ]
