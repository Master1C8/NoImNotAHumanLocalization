  "entries": [
    {
      "id": 110504457786171398,
      "target": "Phone: Хвала, ваше мишљење нам много значи. Свако добро."
    },
    {
      "id": 110504457786171395,
      "target": "Идите у курац, јебени преваранти"
    },
    {
      "id": 110504457786171394,
      "target": "Није ми помогло"
    },
    {
      "id": 110504457786171393,
      "target": "Позитивно"
    },
    {
      "id": 110504457786171392,
      "target": "Phone: Како бисте оценили сеансу?"
    },
    {
      "id": 110504457781977098,
      "target": "Phone: Ако сте пажљиво гледали рекламу, ситним словима је писало да се позив наплаћује."
    },
    {
      "id": 110504457781977096,
      "target": "Идите у курац, јебени преваранти"
    },
    {
      "id": 110504457781977095,
      "target": "Није ми помогло"
    },
    {
      "id": 110504457781977094,
      "target": "Позитивно"
    },
    {
      "id": 110504457781977093,
      "target": "Phone: Како бисте оценили сеансу?"
    },
    {
      "id": 110504457781977091,
      "target": "Phone: Да, тако је. Наши стручњаци за истеривање Гостинских духова морају од нечега да живе."
    },
    {
      "id": 110504457781977090,
      "target": "Мислио сам да је позив бесплатан"
    },
    {
      "id": 110504457781977089,
      "target": "Наплата?"
    },
    {
      "id": 110504457781977088,
      "target": "Phone: Накнада за консултацију биће ускоро наплаћена."
    },
    {
      "id": 110504457777782795,
      "target": "Phone: Сеанса са стручњаком за истеривање Гостинског духа је завршена. Хвала што сте користили наше услуге."
    },
    {
      "id": 110504457777782794,
      "target": "Phone: Држите се и довиђења."
    },
    {
      "id": 110504457777782793,
      "target": "Phone: Нажалост, овде морам да завршим нашу сеансу."
    },
    {
      "id": 110504457777782791,
      "target": "Phone: Ех, баш штета. Бојим се да онда не могу да утврдим о каквом је духу реч. А без тога не могу да вам помогнем."
    }
  ]
}
