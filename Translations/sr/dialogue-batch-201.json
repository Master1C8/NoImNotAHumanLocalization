  "status": "authored draft; semantic and runtime acceptance pending",
  "entries": [
    {
      "id": 110504457148637184,
      "target": "Ballerina: Видиш ли чупавка?"
    },
    {
      "id": 110504457144442890,
      "target": "Ballerina: Не говорим теби, него мачку."
    },
    {
      "id": 110504457144442889,
      "target": "Ballerina: Хајдемо, мацо, забављаћеш ме овде, хоћеш?"
    },
    {
      "id": 110504457144442886,
      "target": "Ballerina: Еее, рекли су ми да овде не сме да буде таквих. Хајде, истерај ту особу."
    },
    {
      "id": 110504457144442885,
      "target": "Ballerina: Да ли је {0} код тебе?"
    },
    {
      "id": 110504456574017540,
      "target": "Ballerina: Мој поклончић за тебе."
    },
    {
      "id": 110504456574017539,
      "target": "Ballerina: Наћи ћеш мачка испод куће."
    },
    {
      "id": 110504456574017537,
      "target": "Ballerina: Хајдемо, мацо, забављаћеш ме овде, хоћеш?"
    },
    {
      "id": 110504456574017536,
      "target": "Ballerina: Раскомоти се."
    },
    {
      "id": 110504456569823243,
      "target": "Ајде, одјеби већ"
    },
    {
      "id": 110504456569823242,
      "target": "…Уђи"
    },
    {
      "id": 110504456569823241,
      "target": "Ballerina: Размисли још једном."
    },
    {
      "id": 110504456569823240,
      "target": "Ballerina: Видиш ли мачка?"
    },
    {
      "id": 110504456569823239,
      "target": "Ballerina: И немој да мучиш мачка."
    },
    {
      "id": 110504456569823238,
      "target": "Ballerina: Не ваља терати жену да се смрзава напољу, младићу."
    },
    {
      "id": 110504456569823234,
      "target": "Ballerina: Отвараш ли? Не?"
    },
    {
      "id": 110504456569823233,
      "target": "Ballerina: Прошла сам цео твој тест?"
    },
    {
      "id": 110504456569823232,
      "target": "Ballerina: Није довољно?"
    },
    {
      "id": 110504456565628939,
      "target": "Ballerina: Имам две руке, две ноге, једну главу."
    },
    {
      "id": 110504456565628936,
      "target": "Ballerina: Хајде већ, одлучи шта ћемо."
    },
    {
      "id": 110504456565628935,
      "target": "Ballerina: Ја сам балетка."
    },
    {
      "id": 110504456565628934,
      "target": "Ballerina: Можда ћу и заиграти."
    },
    {
      "id": 110504456565628933,
      "target": "Ballerina: Да ти заиграм?"
    },
    {
      "id": 110504456565628932,
      "target": "Ballerina: Па шта?"
    },
    {
      "id": 110504456565628931,
      "target": "Докажи да си човек"
    },
    {
      "id": 110504456565628930,
      "target": "Не верујем да си човек"
    },
    {
      "id": 110504456565628929,
      "target": "Ballerina: Чудна реченица."
    },
    {
      "id": 110504456565628928,
      "target": "Ballerina: Шта даље? Подсетила сам те на њега? Или шта?"
    },
    {
      "id": 110504456561434635,
      "target": "Ballerina: Па… добро."
    },
    {
      "id": 110504456561434634,
      "target": "Докажи да си човек"
    },
    {
      "id": 110504456561434633,
      "target": "Не верујем да си човек"
    },
    {
      "id": 110504456561434632,
      "target": "Ballerina: Хе."
    },
    {
      "id": 110504456561434630,
      "target": "Ballerina: Не знам. Какве везе има?"
    },
    {
      "id": 110504456561434629,
      "target": "Подсећаш ме на једног… човека"
    },
    {
      "id": 110504456561434628,
      "target": "Да ли те је неко послао овамо?"
    },
    {
      "id": 110504456561434627,
      "target": "Ballerina: Код тебе није вруће."
    },
    {
      "id": 110504456561434626,
      "target": "Ballerina: Видела сам твоју кућу и дошла."
    },
    {
      "id": 110504456561434625,
      "target": "Ballerina: Видиш град? Тамо сам живела."
    },
    {
      "id": 110504456561434624,
      "target": "Подсећаш ме на једног… човека"
    },
    {
      "id": 110504456557240330,
      "target": "Да ли те је неко послао овамо?"
    },
    {
      "id": 110504456557240329,
      "target": "Ballerina: Бавила сам се балетом. Види ли се?"
    },
    {
      "id": 110504456557240328,
      "target": "Ballerina: Плешем."
    },
    {
      "id": 110504456557240327,
      "target": "Како си нашла моју кућу?"
    },
    {
      "id": 110504456557240325,
      "target": "Ballerina: Рекли су ми да дођем овамо, па сам дошла."
    },
    {
      "id": 110504456557240324,
      "target": "Ballerina: Отвараш ли врата или не?"
    }
  ]
}
