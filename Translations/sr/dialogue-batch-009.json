  "entries": [
    {"id": 110504457941360645, "target": "Phone: …"},
    {"id": 110504457941360644, "target": "Phone: Али и даље ми недостаје..."},
    {"id": 110504457941360643, "target": "Phone: ..."},
    {"id": 110504457941360642, "target": "Phone: Идите дођавола!"},
    {"id": 110504457941360641, "target": "Phone: Јој, зашто се уопште правдам пред вама?"},
    {"id": 110504457941360640, "target": "Phone: Молим вас..."},
    {"id": 110504457937166346, "target": "Phone: Не зовите више овамо..."},
    {"id": 110504457937166345, "target": "Phone: Опростите."},
    {"id": 110504457937166344, "target": "Phone: ..."},
    {"id": 110504457937166343, "target": "Phone: Сад ми је само жао што девојчицу која је заменила нашу ћерку нисмо питали шта је то урадило нашој маленој..."},
    {"id": 110504457937166342, "target": "Phone: Муж ми је помогао да то схватим."},
    {"id": 110504457937166341, "target": "Phone: Али онда сам схватила да то уопште није била наша ћерка."},
    {"id": 110504457937166340, "target": "Phone: Испрва сам хтела да убијем њега самог."},
    {"id": 110504457937166339, "target": "Phone: ..."},
    {"id": 110504457937166338, "target": "Phone: Он се одмах обрачунао с тим Гостом."},
    {"id": 110504457937166337, "target": "Phone: Чим сам то рекла мужу, он је..."},
    {"id": 110504457937166336, "target": "Phone: ..."},
    {"id": 110504457932972044, "target": "Phone: Све се поклапало."},
    {"id": 110504457932972043, "target": "Phone: Зато сам одмах приметила кад су се ти знаци појавили."},
    {"id": 110504457932972042, "target": "Phone: Знала сам је у душу."},
    {"id": 110504457932972041, "target": "Phone: По свим знацима."},
    {"id": 110504457932972040, "target": "Phone: Била је Гост."},
    {"id": 110504457932972039, "target": "Разумем"},
    {"id": 110504457932972038, "target": "Јеботе..."},
    {"id": 110504457932972037, "target": "Phone: Сигурно је била Гост! Знаци су се поклапали сто посто!"},
    {"id": 110504457932972036, "target": "Phone: Немате ви право да ми судите!"},
    {"id": 110504457932972034, "target": "И одлучили сте да убијете сопствено дете?"},
    {"id": 110504457932972033, "target": "Phone: Сви знаци су се поклапали, а муж је инсистирао."},
    {"id": 110504457932972032, "target": "Phone: Убили смо је. Схватите, морали смо."},
    {"id": 110504457928777740, "target": "(Прекини позив)"},
    {"id": 110504457928777738, "target": "Phone: Морали смо да је убијемо."},
    {"id": 110504457928777737, "target": "Phone: Морали смо..."},
    {"id": 110504457928777736, "target": "Phone: ..."},
    {"id": 110504457928777735, "target": "Phone: Умрла је..."},
    {"id": 110504457928777734, "target": "Phone: Наша ћеркица... она..."}
  ]
}
