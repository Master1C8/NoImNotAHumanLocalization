  "entries": [
    {"id": 110504456108449794, "target": "Али то касније."},
    {"id": 110504456108449793, "target": "Нико ми се не мота око ногу."},
    {"id": 110504456108449792, "target": "Баш је мирно."},
    {"id": 110504456037146633, "target": "Одспаваћу мало."},
    {"id": 110504456037146632, "target": "Некако сам се уморио."},
    {"id": 110504456037146630, "target": "Кад бих их бар поново све срео, целу породицу."},
    {"id": 110504456037146629, "target": "Хоће ли ико доћи код мене?"},
    {"id": 110504456037146628, "target": "Зашто су ме пустили овамо?"},
    {"id": 110504456037146627, "target": "Питам се шта је то уопште било?"},
    {"id": 110504456037146626, "target": "Само да ово потраје…"},
    {"id": 110504456037146625, "target": "Али нисам ни намеравао."},
    {"id": 110504456037146624, "target": "Не знам како да изађем."},
    {"id": 110504456032952331, "target": "Не сећам се како сам доспео овамо."},
    {"id": 110504456032952330, "target": "Нико ме не узнемирава. Нико ме не дира."},
    {"id": 110504456032952329, "target": "Али… сада сам спокојан."},
    {"id": 110504456032952328, "target": "Не знам колико дуго већ седим овде."},
    {"id": 110504456032952327, "target": "Овде се дан и ноћ не смењују."},
    {"id": 110504456032952324, "target": "Страх ме је"},
    {"id": 110504456032952323, "target": "Има ли кога овде?"},
    {"id": 110504456032952321, "target": "Страх ме је"},
    {"id": 110504456032952320, "target": "Има ли кога овде?"},
    {"id": 110504456028758025, "target": "Могу ли да погледам филм?"},
    {"id": 110504456028758024, "target": "Хоће ли још неко бити овде?"},
    {"id": 110504456028758022, "target": "Могу ли да погледам филм?"},
    {"id": 110504456028758021, "target": "Хоће ли још неко бити овде?"},
    {"id": 110504456028758019, "target": "Остајем ли овде заувек?"},
    {"id": 110504456028758018, "target": "Јесам ли умро?"},
    {"id": 110504456028758016, "target": "Уживај."},
    {"id": 110504456024563722, "target": "Деловаће велики, прашњави, посути компромисима."},
    {"id": 110504456024563721, "target": "С њеним кратким путевима који ће ти касније, зачудо, деловати широки."},
    {"id": 110504456024563720, "target": "Ово је твоје место."},
    {"id": 110504456024563719, "target": "То си хтео, зар не?"}
  ]
}
