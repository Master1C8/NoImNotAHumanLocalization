  "entries": [
    {"id": 110504456330747915, "target": "Daughter: ЈАКО МЕ ЈЕ СТРА-А-А-АХ!"},
    {"id": 110504456330747914, "target": "Daughter: АААААААААААА."},
    {"id": 110504456330747913, "target": "Daughter: Ааааааааааа."},
    {"id": 110504456330747912, "target": "Daughter: Ку-у-уда ћу да иде-е-ем?"},
    {"id": 110504456330747911, "target": "Daughter: Стра-а-а-х ме је."},
    {"id": 110504456330747910, "target": "Daughter: Хо-хоћете ли ми помо-помоћи?"},
    {"id": 110504456330747907, "target": "Daughter: Док сам тр-трчала, они су се само смејали."},
    {"id": 110504456330747906, "target": "Daughter: Онда су нешто ура-ра-дили, па су за-за-палили кућу."},
    {"id": 110504456330747905, "target": "Daughter: Они су мирно се-седели с татом у кухињи."},
    {"id": 110504456330747904, "target": "Daughter: Не-не знам."},
    {"id": 110504456326553623, "target": "Daughter: Наша кућа са-сад го-го-рииии!"},
    {"id": 110504456326553622, "target": "Daughter: Аааааааааа-хааааааа."},
    {"id": 110504456326553621, "target": "Daughter: Тата је о нечему при-при-чао с њима. Онда су га убили."},
    {"id": 110504456326553620, "target": "Daughter: Код нас су дошли Го-о-ости. Се-седели су код нас."},
    {"id": 110504456326553619, "target": "Зашто су то урадили?"},
    {"id": 110504456326553618, "target": "Ко је то урадио?"},
    {"id": 110504456326553617, "target": "Daughter: Убили су та-та-ту."},
    {"id": 110504456326553616, "target": "Daughter: А-а-а-а-ха-а-а-а-ах."},
    {"id": 110504456326553615, "target": "Daughter: Мо-мо-мог та-та…"},
    {"id": 110504456326553614, "target": "Daughter: А-а-а-а-а-а."},
    {"id": 110504456326553613, "target": "Зашто су то урадили?"},
    {"id": 110504456326553612, "target": "Ко је то урадио?"},
    {"id": 110504456326553611, "target": "Daughter: Та-ту."},
    {"id": 110504456326553610, "target": "Daughter: А-а-а-аха-а-а-а."},
    {"id": 110504456326553609, "target": "Daughter: У-у-били су та…"},
    {"id": 110504456326553608, "target": "Daughter: А-а-а-а-а-а."},
    {"id": 110504456326553607, "target": "Daughter: Љу-у-уди."},
    {"id": 110504456326553606, "target": "Daughter: Не-не знам шта да ра-радим."}
  ]
}
