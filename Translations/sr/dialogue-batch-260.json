  "entries": [
    { "id": 110504451956088838, "target": "Esenin: Па шта, јесам ли Гост?" },
    { "id": 110504451956088836, "target": "Esenin: Погледај нокте." },
    { "id": 110504451956088835, "target": "Esenin: Јебена глупост." },
    { "id": 110504451956088834, "target": "Esenin: Значи, сваки баштован одмах постаје Гост?" },
    { "id": 110504451956088833, "target": "Esenin: Па могу да оперу руке! И готово!" },
    { "id": 110504451956088832, "target": "Esenin: Нокти прљави од земље? То је знак?" },
    { "id": 110504451951894538, "target": "Esenin: Одакле су се уопште појавили?" },
    { "id": 110504451951894537, "target": "Esenin: Нисам Гост." },
    { "id": 110504451951894536, "target": "Esenin: Онда ме не дави тим својим тестовима." },
    { "id": 110504451951894535, "target": "Esenin: Жућкасти су, је л' тако?" },
    { "id": 110504451951894533, "target": "Esenin: Па погледај. На њима се још осећа укус несреће и дима." },
    { "id": 110504451951894532, "target": "Esenin: Да ти покажем зубе?" },
    { "id": 110504451947700232, "target": "Esenin: Шта хоћеш да провериш?" }
  ]
}
