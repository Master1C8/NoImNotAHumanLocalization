  "entries": [
    {"id": 110504457282854923, "target": "StaticBoy: Погрешио сам кућу."},
    {"id": 110504457282854922, "target": "StaticBoy: Извините."},
    {"id": 110504457282854921, "target": "StaticBoy: Погрешан мирис. Погрешан глас."},
    {"id": 110504457282854919, "target": "StaticBoy: Погрешио сам кућу."},
    {"id": 110504457282854918, "target": "StaticBoy: Извините."},
    {"id": 110504457282854917, "target": "StaticBoy: Погрешан мирис. Погрешан глас."},
    {"id": 110504457282854915, "target": "Да ти помогнем да нађеш кућу?"},
    {"id": 110504457282854914, "target": "Шта тражиш овде?"},
    {"id": 110504457282854913, "target": "StaticBoy: А да ли су уопште потребни?.."},
    {"id": 110504457282854912, "target": "StaticBoy: Немам их. Никада их нисам ни имао."},
    {"id": 110504457278660618, "target": "StaticBoy: Родитељи?"},
    {"id": 110504457278660616, "target": "Да ти помогнем да нађеш кућу?"},
    {"id": 110504457278660615, "target": "Шта тражиш овде?"},
    {"id": 110504457278660614, "target": "StaticBoy: Чуо сам како је степеница зашкрипала — значи, неко чека."},
    {"id": 110504457278660613, "target": "StaticBoy: Требало ми је светло из кухиње, али овде… одјек је другачији."},
    {"id": 110504457278660611, "target": "StaticBoy: Врата личе једна на друга кад је мрак."}
  ]
}
