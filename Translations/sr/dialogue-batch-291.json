  "entries": [
    {
      "id": 110504457236717568,
      "target": "Widow: Хвала… Нећу дуго остати… Само да предахнем…"
    },
    {
      "id": 110504457232523273,
      "target": "Widow: Нећу бити у истој кући с таквим."
    },
    {
      "id": 110504457232523272,
      "target": "Widow: Не."
    },
    {
      "id": 110504457232523271,
      "target": "Widow: Код тебе је {0}?"
    },
    {
      "id": 110504457232523270,
      "target": "Widow: Хвала што си помогао. За разлику од…"
    },
    {
      "id": 110504456284610560,
      "target": "Widow: Ти…"
    },
    {
      "id": 110504456280416266,
      "target": "Widow: Треба ми само да предахнем."
    },
    {
      "id": 110504456280416265,
      "target": "Widow: Не мислим да ћу остати дуго."
    },
    {
      "id": 110504456280416262,
      "target": "Widow: Баш је свима било стало."
    },
    {
      "id": 110504456280416261,
      "target": "Widow: Могао је још бити жив да…"
    },
    {
      "id": 110504456280416260,
      "target": "Widow: Сада је мртав."
    },
    {
      "id": 110504456280416259,
      "target": "Widow: Сад више није. Кад је требало, нико није помогао."
    },
    {
      "id": 110504456280416256,
      "target": "Widow: Сад не могу како треба да га сахраним. Нема смисла сада да га пустим."
    },
    {
      "id": 110504456276221961,
      "target": "Widow: Умро је."
    },
    {
      "id": 110504456276221960,
      "target": "Widow: То је мој муж."
    },
    {
      "id": 110504456276221959,
      "target": "Твом пријатељу треба помоћ?"
    },
    {
      "id": 110504456276221958,
      "target": "Твом партнеру није добро?"
    },
    {
      "id": 110504456276221957,
      "target": "Widow: Сад ми је свеједно где ћу завршити."
    },
    {
      "id": 110504456276221956,
      "target": "Widow: Ја… само желим да паднем негде и више не устанем."
    },
    {
      "id": 110504456276221955,
      "target": "Твом пријатељу треба помоћ?"
    },
    {
      "id": 110504456276221954,
      "target": "Твом партнеру није добро?"
    },
    {
      "id": 110504456276221953,
      "target": "Widow: Веома сам уморна. Ако се не одморим, пашћу ти под прозором."
    },
    {
      "id": 110504456276221952,
      "target": "Widow: Више се и не сећам. Свеједно је одакле."
    },
    {
      "id": 110504454455894021,
      "target": "Widow: Надам се да ћете наћи оно што тражите."
    },
    {
      "id": 110504454455894020,
      "target": "Widow: Не говорите много, али… били сте добар саговорник."
    },
    {
      "id": 110504454455894019,
      "target": "Widow: Хвала."
    },
    {
      "id": 110504454455894018,
      "target": "Widow: Док се не вратим, не желим ни о чему да одлучујем."
    },
    {
      "id": 110504454455894017,
      "target": "Widow: Толико желим кући."
    },
    {
      "id": 110504454455894016,
      "target": "Widow: Равнодушна сам према теби, опрости."
    },
    {
      "id": 110504454451699715,
      "target": "Widow: Неће ми бити лакше."
    },
    {
      "id": 110504454451699714,
      "target": "Widow: Зашто?"
    },
    {
      "id": 110504454451699713,
      "target": "Срећно"
    },
    {
      "id": 110504454451699712,
      "target": "Можеш да останеш"
    },
    {
      "id": 110504454447505416,
      "target": "Widow: Не желим више ништа."
    },
    {
      "id": 110504454447505415,
      "target": "Widow: Вратићемо се кући."
    },
    {
      "id": 110504454447505414,
      "target": "Widow: Нико није остао."
    },
    {
      "id": 110504454447505413,
      "target": "Срећно"
    },
    {
      "id": 110504454447505412,
      "target": "Можеш да останеш"
    },
    {
      "id": 110504454447505411,
      "target": "Widow: А тамо…"
    },
    {
      "id": 110504454447505410,
      "target": "Widow: Извадићу гитару."
    },
    {
      "id": 110504454447505409,
      "target": "Widow: Вратићу се кући."
    },
    {
      "id": 110504454447505408,
      "target": "Widow: Не желим да мислим о томе."
    },
    {
      "id": 110504454443311116,
      "target": "Идеш код родбине?"
    },
    {
      "id": 110504454443311115,
      "target": "Шта сад?"
    },
    {
      "id": 110504454443311114,
      "target": "Widow: Само ми је био потребан одмор."
    },
    {
      "id": 110504454443311113,
      "target": "Widow: Одмах сам рекла да не намеравам дуго да останем."
    },
    {
      "id": 110504454443311112,
      "target": "Widow: Одлазим ноћас."
    },
    {
      "id": 110504454443311108,
      "target": "Widow: Сад је тако тешко живети без њега…"
    },
    {
      "id": 110504454443311107,
      "target": "Widow: Да. Молим те."
    }
  ]
}
