  "entries": [
    {"id": 110504453788999687, "target": "Умити се"},
    {"id": 110504453788999684, "target": "Ма нек иде дођавола"},
    {"id": 110504453747056646, "target": "Какав је ово извештај био?"},
    {"id": 110504453747056644, "target": "С ушима је све у реду."},
    {"id": 110504453747056641, "target": "Морам да се умијем. Надам се да ће помоћи."},
    {"id": 110504453742862345, "target": "Изгледа као иритација или, још горе, гљивице."},
    {"id": 110504453742862344, "target": "Јеботе, какво је ово срање!?"},
    {"id": 110504453742862343, "target": "Баш како треба."},
    {"id": 110504453742862342, "target": "Длакави пазуси."},
    {"id": 110504453742862339, "target": "Нису црвене, па немам за шта да се закачим."},
    {"id": 110504453742862338, "target": "Очи као очи."},
    {"id": 110504453742862337, "target": "Није требало да пијем оно кофеинско срање."},
    {"id": 110504453742862336, "target": "Јеботе. Црвене су…"},
    {"id": 110504453591867396, "target": "На отисцима прстију има трагова барута. Али то је ситница."},
    {"id": 110504453591867395, "target": "Чисте руке…"},
    {"id": 110504453591867394, "target": "Све због оне пећине коју копам."},
    {"id": 110504453591867393, "target": "Прљави нокти…"},
    {"id": 110504453587673094, "target": "Утолико боље. Тако ме неће помешати с Гостом."},
    {"id": 110504453587673093, "target": "Жути зуби…"},
    {"id": 110504453587673092, "target": "Пушачи би продали бубрег за овакве."},
    {"id": 110504453587673091, "target": "Дођавола, бели су…"},
    {"id": 110504453587673088, "target": "Умити се"},
    {"id": 110504453583478786, "target": "Морам да се прегледам."}
  ]
}
