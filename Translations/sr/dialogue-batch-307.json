  "status": "authored draft; semantic and runtime acceptance pending",
  "entries": [
    {
      "id": 110504457287049219,
      "target": "Јавна кућа је на другој адреси"
    },
    {
      "id": 110504457287049218,
      "target": "Таквих овде нема"
    },
    {
      "id": 110504457287049217,
      "target": "Jacob: Да ли је случајно код тебе свраћала девојчица у пончу с љубичастом косом?"
    },
    {
      "id": 110504457287049216,
      "target": "Jacob: Здраво."
    },
    {
      "id": 110504457278660610,
      "target": "Где су ти родитељи?"
    },
    {
      "id": 110504457278660609,
      "target": "Јеси ли се изгубио?"
    },
    {
      "id": 110504457278660608,
      "target": "StaticBoy: Мора ваљда…"
    },
    {
      "id": 110504457274466315,
      "target": "StaticBoy: Зар он не спава?"
    },
    {
      "id": 110504457085722635,
      "target": "Изгледаш необично"
    },
    {
      "id": 110504457085722634,
      "target": "FatalDame: Што уопште питам кад ти живиш овде."
    },
    {
      "id": 110504457085722633,
      "target": "FatalDame: Јеси ли успео да се прилагодиш?"
    },
    {
      "id": 110504457085722632,
      "target": "FatalDame: Како ти се свиђа нови живот?"
    },
    {
      "id": 110504457068945415,
      "target": "Хоћеш да је нађеш?"
    },
    {
      "id": 110504457068945414,
      "target": "Како се држиш?"
    },
    {
      "id": 110504457068945413,
      "target": "Vigilante: Да ми брат није јебена кукавица, можда би бар сачувао жену и дете. А овако ко зна где му се то дериште смуца."
    },
    {
      "id": 110504457068945412,
      "target": "Vigilante: Вратио сам се. Јеботе, уопште не знам зашто сам опет дошао овамо."
    },
    {
      "id": 110504457052168195,
      "target": "Шта радиш ако се појави само један или два знака?"
    },
    {
      "id": 110504457052168194,
      "target": "Како си препознавао Госте?"
    },
    {
      "id": 110504457052168193,
      "target": "Vigilante: Је ли КВС дигао руке од овог града? Или само од нашег краја?"
    },
    {
      "id": 110504457052168192,
      "target": "Vigilante: Бар сам обишао куће. Јеботе, овде имате гомилу Гостију."
    },
    {
      "id": 110504457047973899,
      "target": "Vigilante: Покушао сам да нађем некога, али не иде ми баш…"
    },
    {
      "id": 110504457047973898,
      "target": "Vigilante: Вратио сам се."
    },
    {
      "id": 110504457035390976,
      "target": "Зашто се ниси склонио у кућу?"
    },
    {
      "id": 110504457031196684,
      "target": "А ко си ти?"
    },
    {
      "id": 110504457031196683,
      "target": "Vigilante: Ако ниси Гост, наравно."
    },
    {
      "id": 110504457031196682,
      "target": "Vigilante: Добро, веће су шансе да преживиш."
    },
    {
      "id": 110504457031196681,
      "target": "Vigilante: Држиш се по страни од осталих?"
    },
    {
      "id": 110504457027002371,
      "target": "Други се још није вратио?"
    },
    {
      "id": 110504457027002370,
      "target": "Мислиш да ти је друг још жив?"
    },
    {
      "id": 110504457027002369,
      "target": "Али та рупа… Размисли, колико си јој већ пута пришао? Признај, нешто те у њој вуче."
    },
    {
      "id": 110504457027002368,
      "target": "Или то већ од умора умишљам…"
    },
    {
      "id": 110504457022808076,
      "target": "Miner: О, ти си? Већ сам мислио да нећеш доћи. Знаш, овде нешто није у реду. Светло је чудно, уже као да је теже."
    },
    {
      "id": 110504457018613763,
      "target": "Твоји пријатељи се нису вратили?"
    },
    {
      "id": 110504457018613762,
      "target": "Јеси ли дуго овде?"
    },
    {
      "id": 110504457018613761,
      "target": "Miner: А? Опет си овде? Тише је него обично, зар не? Или сам оглувео од тог зујања? Па? Шта кажеш?"
    },
    {
      "id": 110504457001836552,
      "target": "Заглавио си се тамо?"
    },
    {
      "id": 110504457001836551,
      "target": "Шта радиш испод моје куће?"
    },
    {
      "id": 110504457001836550,
      "target": "Miner: Чини ми се."
    },
    {
      "id": 110504457001836549,
      "target": "Miner: А? Ко је ту? Чуо сам неку буку."
    },
    {
      "id": 110504456985059329,
      "target": "Зашто се одржава фестивал печурака?"
    },
    {
      "id": 110504456985059328,
      "target": "Зашто ритуал није успео?"
    },
    {
      "id": 110504456980865035,
      "target": "MushroomEater: У мицелијуму је такав неред да ритуал… није имао никаквог ефекта…"
    },
    {
      "id": 110504456980865034,
      "target": "MushroomEater: Изгледа да фестивал печурака ипак долази…"
    },
    {
      "id": 110504456951504906,
      "target": "Познајеш ли ме?"
    },
    {
      "id": 110504456951504904,
      "target": "MushroomEater: Здраво, драги мој пријатељу."
    },
    {
      "id": 110504456943116290,
      "target": "Губи се, немам сад времена за тебе"
    },
    {
      "id": 110504456943116289,
      "target": "Твоји људи су добро"
    },
    {
      "id": 110504456943116288,
      "target": "CultistPriest: Јеси ли добро?"
    },
    {
      "id": 110504456938921995,
      "target": "CultistPriest: Ето како ће се свет завршити. Не праском, него јецајем…"
    }
  ]
}
