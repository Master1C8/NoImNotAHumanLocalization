  "status": "authored draft; semantic and runtime acceptance pending",
  "entries": [
    {"id": 110504456112644102, "target": "И нема кога да кривиш за то."},
    {"id": 110504456112644101, "target": "Избацили су те на улицу."},
    {"id": 110504456112644100, "target": "То ће се ионако десити."},
    {"id": 110504456112644099, "target": "Видим шта су планирали за тебе."},
    {"id": 110504456112644098, "target": "Од страха човек лако може да полуди."},
    {"id": 110504456112644097, "target": "Страшно је умирати."},
    {"id": 110504456066506756, "target": "Осим ако…"},
    {"id": 110504456066506755, "target": "Полако ћеш изгорети."},
    {"id": 110504456066506754, "target": "Више немаш могућности да себи одузмеш живот како не би патио."},
    {"id": 110504456066506753, "target": "Немаш више снаге да отпузиш од сунчевих зрака."},
    {"id": 110504456066506752, "target": "Без пушке. Пребијеног."},
    {"id": 110504456062312457, "target": "Веома ми је жао."},
    {"id": 110504456062312456, "target": "Само… ти си то убрзао."},
    {"id": 110504456062312455, "target": "Пре или касније."},
    {"id": 110504456062312454, "target": "Плашиш се да нестанеш?"},
    {"id": 110504456062312453, "target": "Бола?"},
    {"id": 110504456062312452, "target": "А чега си се тачно уплашио?"},
    {"id": 110504456062312451, "target": "Веома је тужно гледати шта те чека."},
    {"id": 110504456062312450, "target": "Лако је донети страшне одлуке."},
    {"id": 110504456062312449, "target": "То добро разумем."}
  ]
}
