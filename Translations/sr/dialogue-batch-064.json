  "status": "authored draft; semantic and runtime acceptance pending",
  "entries": [
    {"id": 110504456100061186, "target": "Веома је тешко усредсредити се на њега."},
    {"id": 110504456100061185, "target": "Пред очима се појављује мала усамљена кућица."},
    {"id": 110504456100061184, "target": "Мрачи вам се пред очима."},
    {"id": 110504456095866891, "target": "Кидају вас на комаде."},
    {"id": 110504456095866890, "target": "Ужас вас је заслепео."},
    {"id": 110504456095866889, "target": "Чак и не помишљате да се спасете."},
    {"id": 110504456095866888, "target": "Страх од смрти вас је паралисао."},
    {"id": 110504456095866887, "target": "Осећате погледе на себи."},
    {"id": 110504456095866886, "target": "Људи не верују једни другима."},
    {"id": 110504455999397900, "target": "Дочекај ме…"},
    {"id": 110504455999397898, "target": "Бол се повлачи негде далеко."},
    {"id": 110504455999397897, "target": "Надате се да ћете ускоро бити тамо."},
    {"id": 110504455999397896, "target": "Оштар бол се шири телом."},
    {"id": 110504455999397895, "target": "У кућу нисте пуштали само људе."},
    {"id": 110504455999397894, "target": "Немате куда да побегнете."},
    {"id": 110504455999397893, "target": "Сада ће се све завршити."},
    {"id": 110504455999397892, "target": "Одмеравајући, хладни, туђи."},
    {"id": 110504455999397891, "target": "Параноја је све јача."},
    {"id": 110504455999397890, "target": "Сунце није једина опасност која се надвила над вама."},
    {"id": 110504455999397889, "target": "Већ око два месеца сви чекају крај."},
    {"id": 110504455999397888, "target": "Бројите дане на зиду подрума."},
    {"id": 110504455995203595, "target": "Затварате подрум. Сада нико неће моћи да уђе овамо."},
    {"id": 110504455995203594, "target": "Ако се штеди, хране би требало да буде довољно за месец-два."},
    {"id": 110504455995203593, "target": "Овде је хладније него у кући, али сви су и даље узнемирени."},
    {"id": 110504455995203592, "target": "С преживелима силазите у подрум."}
  ]
}
