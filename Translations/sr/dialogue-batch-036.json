    {
      "id": 110504457849085955,
      "target": "Phone: (Саговорник спушта слушалицу. То је било… помало другачије од онога што сте очекивали.)"
    },
    {
      "id": 110504457849085954,
      "target": "Phone: Зашто не одговараш? Желим да умрем."
    },
    {
      "id": 110504457849085953,
      "target": "Phone: Провери јој дисање."
    },
    {
      "id": 110504457844891658,
      "target": "Phone: Осим плача и растанка."
    },
    {
      "id": 110504457844891657,
      "target": "Phone: Сусре… ништа"
    },
    {
      "id": 110504457844891656,
      "target": "Phone: Иако је маме зву…,"
    },
    {
      "id": 110504457844891655,
      "target": "Phone: Бој се ти … гр…"
    },
    {
      "id": 110504457844891654,
      "target": "Phone: Грађа јабуке: надјабучник, земља печурака и папира."
    }
  ]
