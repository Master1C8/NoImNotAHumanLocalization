  "entries": [
    {
      "id": 110504456272027658,
      "target": "А куда ћеш после?"
    },
    {
      "id": 110504456272027657,
      "target": "Одакле си дошла?"
    },
    {
      "id": 110504456272027656,
      "target": "Widow: Могу ли да се одморим код тебе?"
    },
    {
      "id": 110504456263639042,
      "target": "Неће бити проблема с тобом?"
    },
    {
      "id": 110504456263639041,
      "target": "Ниси ваљда Гост?"
    },
    {
      "id": 110504456263639040,
      "target": "Esenin: Шта мислиш? Хоћеш ли ме пустити?"
    },
    {
      "id": 110504456259444747,
      "target": "Esenin: Али никога не повређујем, немој погрешно да ме схватиш. Само… понекад ми је мука. Разумеш и сам."
    },
    {
      "id": 110504456259444746,
      "target": "Esenin: Зашто? Хм. Не може свако да поднесе моју нарав."
    },
    {
      "id": 110504456259444745,
      "target": "Esenin: Једноставно су ме избацили."
    },
    {
      "id": 110504456259444744,
      "target": "Esenin: Скривао сам се у пабу, али…"
    },
    {
      "id": 110504456259444743,
      "target": "Esenin: Могу ли код вас?"
    },
    {
      "id": 110504456251056129,
      "target": "Како си се нашла овде?"
    },
    {
      "id": 110504456246861835,
      "target": "Anxiety: Имате ли можда месташце за мене?"
    },
    {
      "id": 110504456246861834,
      "target": "Anxiety: Извините што је овако касно, дању је прилично вруће, на телевизији су рекли да је боље да се не излази на сунце."
    },
    {
      "id": 110504456246861833,
      "target": "Anxiety: Добар дан!"
    },
    {
      "id": 110504456234278923,
      "target": "Плашиш ме."
    },
    {
      "id": 110504456234278921,
      "target": "Fanatic: ЕТО ТИ ЈЕБЕНОГ БЛАГОСЛОВА!"
    },
    {
      "id": 110504456234278920,
      "target": "Fanatic: И ми ћемо кренути у нови, чисти свет!"
    },
    {
      "id": 110504456234278919,
      "target": "Fanatic: Земља ће се очистити, сунце ће урадити своје."
    },
    {
      "id": 110504456234278918,
      "target": "Fanatic: Какве смо среће! Својим очима гледамо казну за људске страсти."
    },
    {
      "id": 110504456234278917,
      "target": "Fanatic: Здраво, човече."
    },
    {
      "id": 110504456221696002,
      "target": "Отвори при крају"
    },
    {
      "id": 110504456221696001,
      "target": "Отвори негде на средини"
    },
    {
      "id": 110504456221696000,
      "target": "Хајде негде на почетку"
    },
    {
      "id": 110504456217501707,
      "target": "Prophet: Хоћеш ли ми гатати из књиге? Коју страницу да отворим?"
    },
    {
      "id": 110504456217501706,
      "target": "Prophet: Желим да наш разговор започнем… једном активношћу."
    },
    {
      "id": 110504456217501705,
      "target": "Prophet: Хм, чудно, не знам како да објасним."
    },
    {
      "id": 110504456217501704,
      "target": "Prophet: Сећам се да је прошли пут било другачије. Али ми живимо…"
    },
    {
      "id": 110504456217501703,
      "target": "Prophet: Поново смо се срели."
    },
    {
      "id": 110504456204918788,
      "target": "Зашто бих ти веровао?"
    },
    {
      "id": 110504456204918787,
      "target": "Јеси ли дошао сам?"
    },
    {
      "id": 110504456204918786,
      "target": "Gasmask: Из екипе сам КВС-а, обилазимо ваш крај."
    },
    {
      "id": 110504456204918785,
      "target": "Gasmask: Добро вече."
    },
    {
      "id": 110504456192335873,
      "target": "FortuneTeller: Ви сте прилично упорна особа, зар не?"
    },
    {
      "id": 110504456192335872,
      "target": "FortuneTeller: Сунце, лав, пета кућа. Све је јасно."
    },
    {
      "id": 110504456188141579,
      "target": "FortuneTeller: Нешто веома лоше."
    },
    {
      "id": 110504456188141578,
      "target": "FortuneTeller: Овде осећам неки застој енергије."
    },
    {
      "id": 110504456175558664,
      "target": "Ниси међу тим зверима?"
    },
    {
      "id": 110504456175558662,
      "target": "Anger: Толико гадова је свуда около. Надам се да ниси један од њих."
    },
    {
      "id": 110504456175558661,
      "target": "Anger: Баш сам лоше воље, унапред се извињавам."
    },
    {
      "id": 110504456175558660,
      "target": "Anger: Здраво, станару."
    },
    {
      "id": 110504456162975753,
      "target": "Шта хоћете од мене?"
    },
    {
      "id": 110504456162975752,
      "target": "Да ли се нешто десило?"
    },
    {
      "id": 110504456162975751,
      "target": "Mother: Добар дан. Помозите, молим вас."
    },
    {
      "id": 110504456162975750,
      "target": "Mother: Тако, стој мирно, не врпољи се."
    },
    {
      "id": 110504456150392835,
      "target": "Познајемо ли се?"
    },
    {
      "id": 110504456150392834,
      "target": "WheelChair: Дуго се нисмо видели. Како живот?"
    }
  ]
}
