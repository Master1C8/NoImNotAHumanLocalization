  "entries": [
    {
      "id": 110504454418145286,
      "target": "Widow: Толико желим да верујем."
    },
    {
      "id": 110504454418145285,
      "target": "Widow: Тако желим…"
    },
    {
      "id": 110504454418145284,
      "target": "Widow: Он ме још чује."
    },
    {
      "id": 110504454418145283,
      "target": "Widow: Не, није тако."
    },
    {
      "id": 110504454418145282,
      "target": "Widow: Не."
    },
    {
      "id": 110504454418145280,
      "target": "Widow: Нећу га предати бездушној земљи."
    },
    {
      "id": 110504454413950982,
      "target": "Widow: Не могу тако."
    },
    {
      "id": 110504454413950981,
      "target": "Widow: И опет да се растанем од њега."
    },
    {
      "id": 110504454413950980,
      "target": "Widow: Тек су ми га недавно вратили."
    },
    {
      "id": 110504454413950979,
      "target": "Widow: Нисам спремна."
    },
    {
      "id": 110504454413950978,
      "target": "Widow: Не-не-не-не."
    },
    {
      "id": 110504454413950977,
      "target": "Widow: Не-е-е."
    },
    {
      "id": 110504454413950976,
      "target": "Од њега је остало само тело. Мораш то да прихватиш"
    },
    {
      "id": 110504454409756678,
      "target": "Треба га сахранити"
    },
    {
      "id": 110504454409756677,
      "target": "Widow: Само да престанем да плачем."
    },
    {
      "id": 110504454409756676,
      "target": "Widow: Али зар је то исправно?"
    },
    {
      "id": 110504454409756675,
      "target": "Widow: Као да више немам суза за плакање."
    },
    {
      "id": 110504454409756674,
      "target": "Widow: Тек недавно сам исплакала све сузе."
    },
    {
      "id": 110504454409756673,
      "target": "Widow: То је превише."
    },
    {
      "id": 110504454409756672,
      "target": "Widow: Још не могу."
    },
    {
      "id": 110504454405562376,
      "target": "Widow: Шта да радим?"
    },
    {
      "id": 110504454405562375,
      "target": "Widow: Не могу тебе."
    },
    {
      "id": 110504454405562373,
      "target": "Widow: Сахранити…"
    },
    {
      "id": 110504454405562372,
      "target": "Widow: Ја чак…"
    },
    {
      "id": 110504454405562371,
      "target": "Widow: Ти ми никога нећеш вратити."
    },
    {
      "id": 110504454405562370,
      "target": "Widow: Желим да будем с њим."
    },
    {
      "id": 110504454405562369,
      "target": "Widow: Зашто си такав?"
    },
    {
      "id": 110504454405562368,
      "target": "Widow: Тако је, сад ја сама да се сналазим."
    },
    {
      "id": 110504454401368071,
      "target": "Widow: И умро."
    },
    {
      "id": 110504454401368069,
      "target": "Widow: Рекао је да ће све бити у реду."
    },
    {
      "id": 110504454401368068,
      "target": "Widow: Па обећао је да ће све бити у реду."
    },
    {
      "id": 110504454401368067,
      "target": "Widow: Зашто си умро?"
    },
    {
      "id": 110504454401368065,
      "target": "Да седнем с тобом?"
    },
    {
      "id": 110504454401368064,
      "target": "За сада ћу те оставити овде"
    },
    {
      "id": 110504454397173767,
      "target": "Widow: Хоћу да седим."
    },
    {
      "id": 110504454397173766,
      "target": "Widow: Ја сам ту…"
    },
    {
      "id": 110504454397173765,
      "target": "Widow: Нисам гладна."
    },
    {
      "id": 110504454397173764,
      "target": "Да седнем с тобом?"
    },
    {
      "id": 110504454397173763,
      "target": "За сада ћу те оставити овде"
    },
    {
      "id": 110504454397173762,
      "target": "Widow: Попићу нешто ако ми затреба."
    },
    {
      "id": 110504454397173761,
      "target": "Widow: Седим поред славине."
    },
    {
      "id": 110504454397173760,
      "target": "Widow: Ја сам ту…"
    },
    {
      "id": 110504454392979464,
      "target": "Могу ли да ти дам нешто да једеш?"
    },
    {
      "id": 110504454392979463,
      "target": "Да ти донесем воде?"
    },
    {
      "id": 110504454392979462,
      "target": "Widow: Ништа ми више не треба."
    }
  ]
}
