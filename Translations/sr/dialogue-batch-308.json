  "entries": [
    {
      "id": 110504456938921994,
      "target": "CultistPriest: Смрт је престала да разговара са мном."
    },
    {
      "id": 110504456934727690,
      "target": "Баш ме брига. Имам својих послова"
    },
    {
      "id": 110504456934727689,
      "target": "Живи су, живи"
    },
    {
      "id": 110504456934727688,
      "target": "CultistPriest: Нећу околишати. Како су моји људи?"
    },
    {
      "id": 110504456913756166,
      "target": "Моја кућа одговара само мени"
    },
    {
      "id": 110504456913756165,
      "target": "Шта си осетио?"
    },
    {
      "id": 110504456913756164,
      "target": "CultistPriest: Баш то осећам."
    },
    {
      "id": 110504456913756163,
      "target": "CultistPriest: Даааа. Твоја кућа одговара."
    },
    {
      "id": 110504456892784646,
      "target": "Ништа посебно"
    },
    {
      "id": 110504456892784644,
      "target": "Intruder: Сањаш ли нешто?"
    },
    {
      "id": 110504456880201729,
      "target": "Овог пута су дошли по мене?"
    },
    {
      "id": 110504456880201728,
      "target": "Прво врати оне које сте одвели."
    },
    {
      "id": 110504456876007435,
      "target": "FormerFema: Хоћете ли… отворити?"
    },
    {
      "id": 110504456876007434,
      "target": "FormerFema: Чуо сам кораке, значи пришли сте вратима."
    },
    {
      "id": 110504456876007433,
      "target": "FormerFema: Има ли кога?"
    },
    {
      "id": 110504456863424519,
      "target": "Куцај себи по глави"
    },
    {
      "id": 110504456863424518,
      "target": "Не проваљуј овамо"
    },
    {
      "id": 110504456863424517,
      "target": "GraveDigger: Пустите ме, ајде!"
    },
    {
      "id": 110504456863424516,
      "target": "GraveDigger: Има ли овде живих? ХЕЈ!"
    },
    {
      "id": 110504456850841602,
      "target": "Зашто мислиш да је то добра идеја?"
    },
    {
      "id": 110504456850841601,
      "target": "Зашто идеш сам?"
    },
    {
      "id": 110504456850841600,
      "target": "Marauder: Слушај, могу ли да останем код тебе? Одавно нисам био у друштву."
    },
    {
      "id": 110504456846647306,
      "target": "Marauder: Мада…"
    },
    {
      "id": 110504456846647305,
      "target": "Marauder: Здраво. Мислио сам да овде више нема никога. Добро, одлазим."
    },
    {
      "id": 110504456846647304,
      "target": "Marauder: А, јао, неко овде живи."
    },
    {
      "id": 110504456838258690,
      "target": "Само пуштам људе код себе"
    },
    {
      "id": 110504456838258689,
      "target": "Тако нешто"
    },
    {
      "id": 110504456838258688,
      "target": "Provocateur: Добар дан, власниче. Да ли издајете овде нешто под закуп?"
    },
    {
      "id": 110504456825675777,
      "target": "Како да ти помогнем?"
    },
    {
      "id": 110504456825675776,
      "target": "Шта се десило?"
    },
    {
      "id": 110504456821481483,
      "target": "TaxiDriver: Слушај, у говнима сам до гуше, могу ли да се сакријем код тебе?"
    },
    {
      "id": 110504456821481482,
      "target": "TaxiDriver: Здраво, друже."
    },
    {
      "id": 110504456808898566,
      "target": "Шта је овде лепо?"
    },
    {
      "id": 110504456808898565,
      "target": "Зашто не седиш код куће?"
    },
    {
      "id": 110504456808898564,
      "target": "Edgar: Надам се да могу да останем код тебе."
    },
    {
      "id": 110504456808898563,
      "target": "Edgar: Још је тише него у граду. Тамо су таква бука и гужва."
    },
    {
      "id": 110504456808898562,
      "target": "Edgar: Здраво. Баш је лепо код вас."
    },
    {
      "id": 110504456800509955,
      "target": "Шта ти је?"
    },
    {
      "id": 110504456800509954,
      "target": "Foreigner: Пффыыыы."
    },
    {
      "id": 110504456800509953,
      "target": "Foreigner: Пффыыв."
    },
    {
      "id": 110504456787927044,
      "target": "Тражите ли нешто?"
    },
    {
      "id": 110504456787927043,
      "target": "Да ли сте посматрали кућу?"
    },
    {
      "id": 110504456787927042,
      "target": "Doctor: Добар дан! Могу ли да уђем?"
    },
    {
      "id": 110504456787927041,
      "target": "Doctor: Баш је тихо код вас ноћу."
    },
    {
      "id": 110504456787927040,
      "target": "Doctor: Јао, већ сам мислио да нема никога код куће."
    },
    {
      "id": 110504456775344138,
      "target": "А ти си један од тих зверова?"
    },
    {
      "id": 110504456775344137,
      "target": "О чему причаш?"
    },
    {
      "id": 110504456775344136,
      "target": "Wolfhound: Напокон нико не глуми."
    }
  ]
}
