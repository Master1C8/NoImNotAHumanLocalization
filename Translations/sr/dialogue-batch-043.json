  "entries": [
    {
      "id": 110504457316409347,
      "target": "SuperFake: Јеси ли сам код куће?"
    },
    {
      "id": 110504457316409346,
      "target": "SuperFake: Добро..."
    },
    {
      "id": 110504457316409345,
      "target": "SuperFake: А шта је у њему још важно? Остао си сам. Без родбине."
    },
    {
      "id": 110504457316409344,
      "target": "SuperFake: Што си се толико стегао? Баш си се ухватио за живот."
    },
    {
      "id": 110504456775344132,
      "target": "SuperFake: Зашто се онда опирати?"
    },
    {
      "id": 110504456775344131,
      "target": "SuperFake: ЗНАМ да ће се ускоро све решити."
    },
    {
      "id": 110504456775344130,
      "target": "SuperFake: За шта се држиш?"
    },
    {
      "id": 110504456775344129,
      "target": "SuperFake: Зашто?"
    },
    {
      "id": 110504456775344128,
      "target": "SuperFake: Стално бежиш. Од мојих људи, од проблема."
    },
    {
      "id": 110504456771149835,
      "target": "SuperFake: Зато сам овде."
    },
    {
      "id": 110504456771149834,
      "target": "SuperFake: Ниси спреман да ствар узмеш у своје руке."
    },
    {
      "id": 110504456771149833,
      "target": "SuperFake: Даааа."
    },
    {
      "id": 110504456771149832,
      "target": "SuperFake: Осећаш ли страх?"
    },
    {
      "id": 110504456771149830,
      "target": "SuperFake: Ипак си спреман."
    },
    {
      "id": 110504456771149829,
      "target": "Уклонио сам из куће неколико сувишних"
    },
    {
      "id": 110504456771149828,
      "target": "Уклонио сам из куће све сувишне"
    },
    {
      "id": 110504456771149827,
      "target": "Пуштао сам само оне које је требало"
    },
    {
      "id": 110504456771149826,
      "target": "У кући има много нељуди"
    },
    {
      "id": 110504456771149825,
      "target": "Никога нисам пуштао"
    },
    {
      "id": 110504456771149824,
      "target": "У кући има много људи"
    },
    {
      "id": 110504456766955531,
      "target": "SuperFake: Има ли сада у твојој кући мојих људи?"
    },
    {
      "id": 110504456766955530,
      "target": "SuperFake: А мене занима нешто друго."
    },
    {
      "id": 110504456766955528,
      "target": "SuperFake: Хоћеш ли ишта осећати?"
    },
    {
      "id": 110504456766955527,
      "target": "SuperFake: Само ћеш нестати? Заувек?"
    },
    {
      "id": 110504456766955526,
      "target": "SuperFake: Ето, умрећеш. А после?"
    },
    {
      "id": 110504456766955525,
      "target": "SuperFake: Изгледа да чешће размишљаш о томе шта ће бити после."
    },
    {
      "id": 110504456766955523,
      "target": "SuperFake: Питаш ли се често зашто си још жив?"
    },
    {
      "id": 110504456766955522,
      "target": "SuperFake: Плаши ли те непознато?"
    },
    {
      "id": 110504456766955521,
      "target": "Уклонио сам из куће неколико сувишних"
    },
    {
      "id": 110504456766955520,
      "target": "Уклонио сам из куће све сувишне"
    },
    {
      "id": 110504456762761228,
      "target": "Пуштао сам само оне које је требало"
    },
    {
      "id": 110504456762761227,
      "target": "У кући има много нељуди"
    },
    {
      "id": 110504456762761226,
      "target": "Никога нисам пуштао"
    },
    {
      "id": 110504456762761225,
      "target": "У кући има много људи"
    },
    {
      "id": 110504456762761223,
      "target": "SuperFake: Јеси ли пустио моје људе у кућу?"
    },
    {
      "id": 110504456762761222,
      "target": "SuperFake: А засад…"
    },
    {
      "id": 110504456762761221,
      "target": "SuperFake: Али ти ћеш сигурно нестати."
    },
    {
      "id": 110504456762761220,
      "target": "SuperFake: Ако не данас, онда сутра. Ако не сутра, онда касније."
    },
    {
      "id": 110504456762761219,
      "target": "SuperFake: Умрећеш."
    },
    {
      "id": 110504456762761218,
      "target": "SuperFake: А исход је исти."
    },
    {
      "id": 110504456762761217,
      "target": "SuperFake: Да нешто промениш?"
    },
    {
      "id": 110504456762761216,
      "target": "SuperFake: Шаљу ме само теби, да бих…"
    },
    {
      "id": 110504456758566923,
      "target": "SuperFake: Да ниси помислио да си изабран? Ха-ха."
    },
    {
      "id": 110504456758566922,
      "target": "SuperFake: Тек сад то питаш?"
    },
    {
      "id": 110504456758566921,
      "target": "Зашто одмах не развалиш врата?"
    },
    {
      "id": 110504456758566920,
      "target": "Зашто долазиш?"
    },
    {
      "id": 110504456758566919,
      "target": "SuperFake: Не брини, помоћи ћемо."
    },
    {
      "id": 110504456758566918,
      "target": "SuperFake: Занимљиво је што ти сам ништа не осећаш."
    },
    {
      "id": 110504456758566917,
      "target": "SuperFake: То ти нећу рећи."
    },
    {
      "id": 110504456758566916,
      "target": "Зашто одмах не развалиш врата?"
    },
    {
      "id": 110504456758566915,
      "target": "Зашто долазиш?"
    },
    {
      "id": 110504456758566914,
      "target": "SuperFake: Већ вам је за петама."
    },
    {
      "id": 110504456758566913,
      "target": "SuperFake: Осећаш ли како се Смрт све више приближава?"
    },
    {
      "id": 110504456758566912,
      "target": "SuperFake: И то је све."
    },
    {
      "id": 110504456754372619,
      "target": "SuperFake: Преносим ти оно што су ми рекли."
    }
  ]
}
