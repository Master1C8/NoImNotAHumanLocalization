  "entries": [
    {
      "id": 110504456343330824,
      "target": "SuperFake: Ја ћу отворити."
    },
    {
      "id": 110504456343330823,
      "target": "SuperFake: Хтео сам да видим хоћеш ли ме слагати."
    },
    {
      "id": 110504456343330822,
      "target": "SuperFake: Јасно ми је да си сам."
    },
    {
      "id": 110504456343330821,
      "target": "SuperFake: Хахахахаха."
    },
    {
      "id": 110504456343330820,
      "target": "SuperFake: Али ко зна шта ће бити за неколико дана?"
    },
    {
      "id": 110504456343330819,
      "target": "SuperFake: Чујем да неко шапуће по твојим собама."
    },
    {
      "id": 110504456343330818,
      "target": "SuperFake: Данас си имао среће."
    },
    {
      "id": 110504456339136523,
      "target": "SuperFake: Јеси ли сам код куће?"
    },
    {
      "id": 110504456339136522,
      "target": "SuperFake: Али реци ми…"
    },
    {
      "id": 110504456339136521,
      "target": "SuperFake: „Све што ми савест остави, појео бих и зубима“, је ли?"
    },
    {
      "id": 110504456339136520,
      "target": "SuperFake: То је одлично!"
    },
    {
      "id": 110504456339136517,
      "target": "SuperFake: Јеси ли сам код куће?"
    },
    {
      "id": 110504456339136516,
      "target": "SuperFake: Слуууушај…"
    },
    {
      "id": 110504456339136515,
      "target": "SuperFake: Да, да, разумем."
    },
    {
      "id": 110504456339136514,
      "target": "Имам пушку"
    },
    {
      "id": 110504456339136512,
      "target": "SuperFake: Разумеш и сам."
    },
    {
      "id": 110504456334942217,
      "target": "SuperFake: Никад се не зна."
    },
    {
      "id": 110504456334942216,
      "target": "SuperFake: Јесу ли ти врата чврста?"
    },
    {
      "id": 110504456334942215,
      "target": "Имам пушку"
    },
    {
      "id": 110504456334942213,
      "target": "SuperFake: Свиђа ми се."
    },
    {
      "id": 110504456334942212,
      "target": "SuperFake: Пространа кућа."
    }
  ]
}
