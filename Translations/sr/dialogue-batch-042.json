  "entries": [
    {
      "id": 110504456754372613,
      "target": "SuperFake: Видимо се?"
    },
    {
      "id": 110504456754372612,
      "target": "SuperFake: Па…"
    },
    {
      "id": 110504456754372611,
      "target": "SuperFake: Ја само извршавам ту вољу."
    },
    {
      "id": 110504456754372610,
      "target": "SuperFake: Постоје силе које су изнад мене."
    },
    {
      "id": 110504456754372609,
      "target": "SuperFake: Не мислиш ваљда да сам ја овде… неки главни?"
    },
    {
      "id": 110504456754372608,
      "target": "SuperFake: Промене нису ни најстрашније што те чека."
    },
    {
      "id": 110504456750178314,
      "target": "SuperFake: Чак ни мојих људи нема много. А тек вас, затворених у својим кућама."
    },
    {
      "id": 110504456750178313,
      "target": "SuperFake: Гле ти то."
    },
    {
      "id": 110504456750178312,
      "target": "SuperFake: Пођи са мном."
    },
    {
      "id": 110504456750178311,
      "target": "SuperFake: Ето, наше ново правило је већ прорадило."
    },
    {
      "id": 110504456750178310,
      "target": "SuperFake: Хмм…"
    },
    {
      "id": 110504456750178307,
      "target": "SuperFake: Јеси ли сам код куће?"
    },
    {
      "id": 110504456750178306,
      "target": "SuperFake: Али најпре ћемо проверити наше ново правило."
    },
    {
      "id": 110504456750178305,
      "target": "SuperFake: Наравно! Већ одлазим."
    },
    {
      "id": 110504456745984010,
      "target": "SuperFake: Јеси ли сам код куће?"
    },
    {
      "id": 110504456745984009,
      "target": "SuperFake: Али за почетак…"
    },
    {
      "id": 110504456745984008,
      "target": "SuperFake: Сад ћемо испробати."
    },
    {
      "id": 110504456745984007,
      "target": "SuperFake: Све је једноставно."
    },
    {
      "id": 110504456745984006,
      "target": "Можеш ли да дођеш касније?"
    },
    {
      "id": 110504456745984004,
      "target": "SuperFake: Отворићеш ми врата."
    },
    {
      "id": 110504456745984003,
      "target": "SuperFake: Ако у твојој кући буду бар двоје мојих људи…"
    },
    {
      "id": 110504456745984002,
      "target": "SuperFake: Хајде да то променимо."
    },
    {
      "id": 110504456745984001,
      "target": "SuperFake: Као да те није брига за самог себе."
    },
    {
      "id": 110504456745984000,
      "target": "SuperFake: Некако равнодушно."
    },
    {
      "id": 110504456741789707,
      "target": "Можеш ли да дођеш касније?"
    },
    {
      "id": 110504456741789705,
      "target": "SuperFake: Јер сада тела насељавају пси."
    },
    {
      "id": 110504456741789704,
      "target": "SuperFake: Отворићеш ми врата."
    },
    {
      "id": 110504456741789703,
      "target": "SuperFake: Ако у твојој кући буду бар двоје мојих људи…"
    },
    {
      "id": 110504456741789702,
      "target": "SuperFake: Ти и ја ћемо испробати нова правила."
    },
    {
      "id": 110504456741789701,
      "target": "SuperFake: Изгледа да ти треба помоћ."
    },
    {
      "id": 110504456741789700,
      "target": "SuperFake: Тешко ти је."
    }
  ]
}
