    {
      "id": 110504457752616961,
      "target": "Phone: Добро, поруџбина је примљена. Очекујте курира следеће ноћи."
    },
    {
      "id": 110504457752616960,
      "target": "Phone: Свако добро, довиђења."
    },
    {
      "id": 110504457748422667,
      "target": "Phone: Ако желите да наручите нешто, покушајте да позовете другог дана."
    },
    {
      "id": 110504457748422666,
      "target": "Phone: Због велике оптерећености морамо да правимо паузе између поруџбина."
    },
    {
      "id": 110504457748422665,
      "target": "Phone: Нажалост, не можемо да примимо вашу поруџбину јер сте недавно већ наручивали."
    },
    {
      "id": 110504457748422664,
      "target": "Предомислио сам се, нећу ништа да наручим"
    },
    {
      "id": 110504457748422663,
      "target": "1 лименку кафе, молим."
    },
    {
      "id": 110504457748422662,
      "target": "2 лименке Енержеке, молим."
    },
    {
      "id": 110504457748422661,
      "target": "Phone: Шта бисте желели да наручите?"
    },
    {
      "id": 110504457748422660,
      "target": "Phone: Добар дан, овде служба доставе хране For Rest."
