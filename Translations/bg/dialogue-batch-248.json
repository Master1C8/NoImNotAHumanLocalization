  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504454451699713,
      "target": "Успех"
    },
    {
      "id": 110504454451699712,
      "target": "Можеш да останеш"
    },
    {
      "id": 110504454447505416,
      "target": "Widow: Не искам нищо повече."
    },
    {
      "id": 110504454447505415,
      "target": "Widow: Ще се върнем вкъщи."
    },
    {
      "id": 110504454447505414,
      "target": "Widow: Никой не остана."
    },
    {
      "id": 110504454447505413,
      "target": "Успех"
    },
    {
      "id": 110504454447505412,
      "target": "Можеш да останеш"
    },
    {
      "id": 110504454447505411,
      "target": "Widow: А там…"
    },
    {
      "id": 110504454447505410,
      "target": "Widow: Ще взема китарата."
    },
    {
      "id": 110504454447505409,
      "target": "Widow: Ще се върна вкъщи."
    },
    {
      "id": 110504454447505408,
      "target": "Widow: Не искам да мисля за това."
    },
    {
      "id": 110504454443311116,
      "target": "Ще отидеш при роднините си?"
    },
    {
      "id": 110504454443311115,
      "target": "А сега какво?"
    },
    {
      "id": 110504454443311114,
      "target": "Widow: Просто имах нужда от почивка."
    },
    {
      "id": 110504454443311113,
      "target": "Widow: Още отначало казах, че няма да остана дълго."
    },
    {
      "id": 110504454443311112,
      "target": "Widow: Тръгвам си тази нощ."
    },
    {
      "id": 110504454443311111,
      "target": "Трябва да те проверя"
    },
    {
      "id": 110504454443311110,
      "target": "Нещо не е наред ли?"
    },
    {
      "id": 110504454443311109,
      "target": "Widow: Да си почина малко…"
    },
    {
      "id": 110504454443311108,
      "target": "Widow: Сега е толкова тежко да живея без него…"
    },
    {
      "id": 110504454443311107,
      "target": "Widow: Да. Моля ви."
    },
    {
      "id": 110504454443311106,
      "target": "Widow: Искам да остана сама."
    },
    {
      "id": 110504454443311105,
      "target": "Widow: …"
    },
    {
      "id": 110504454443311104,
      "target": "Widow: Вие убихте — на вас ще остане душата му. А на мен ще остане да крещя, че не ми е жал за никого."
    },
    {
      "id": 110504454439116811,
      "target": "Widow: …"
    },
    {
      "id": 110504454439116810,
      "target": "Widow: Наистина там…"
    },
    {
      "id": 110504454439116809,
      "target": "Widow: А той…"
    },
    {
      "id": 110504454439116808,
      "target": "Widow: При такива тъпаци винаги е пълен хаос. Достатъчно беше да облека лекарска престилка и да вляза в моргата."
    },
    {
      "id": 110504454439116807,
      "target": "Widow: Не мога да го взема у дома."
    },
    {
      "id": 110504454439116806,
      "target": "Widow: Не мога да огледам тялото."
    },
    {
      "id": 110504454439116805,
      "target": "Widow: Това е всичко."
    },
    {
      "id": 110504454439116804,
      "target": "Widow: Казаха ми: „Той почина.“"
    },
    {
      "id": 110504454439116803,
      "target": "Widow: …"
    },
    {
      "id": 110504454439116802,
      "target": "Widow: Само момент, извинете."
    },
    {
      "id": 110504454439116801,
      "target": "Widow: …"
    },
    {
      "id": 110504454439116800,
      "target": "Widow: Просто ми казаха сухо…"
    },
    {
      "id": 110504454434922503,
      "target": "Widow: Дойдох по-рано, само да го видя."
    },
    {
      "id": 110504454434922502,
      "target": "Widow: …"
    },
    {
      "id": 110504454434922501,
      "target": "Widow: КИС просто го поставиха под карантина. Не ми дадоха никаква възможност да се свържа с него. Казаха, че ще го пуснат след три седмици."
    },
    {
      "id": 110504454434922500,
      "target": "Widow: Отидохме в центъра, който КИС бяха открили."
    }
  ]
}
