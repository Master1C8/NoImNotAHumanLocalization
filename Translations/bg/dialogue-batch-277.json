  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504454028075013,
      "target": "Leper: Добре, както кажеш."
    },
    {
      "id": 110504454028075012,
      "target": "Leper: …"
    },
    {
      "id": 110504454028075011,
      "target": "Leper: Какво? Защо пък това?"
    },
    {
      "id": 110504454028075010,
      "target": "Извади пушката"
    },
    {
      "id": 110504454028075009,
      "target": "Пусни го"
    },
    {
      "id": 110504454028075008,
      "target": "Leper: Забравих да кажа, че понякога окото ми потрепва. И това е последица от вроденото ми заболяване."
    },
    {
      "id": 110504454023880716,
      "target": "Leper: Знам, че червеното око е признак. Но при мен е от същата кожна болест."
    },
    {
      "id": 110504454023880715,
      "target": "Leper: ..."
    },
    {
      "id": 110504454023880714,
      "target": "Leper: Добре, гледай."
    },
    {
      "id": 110504454023880713,
      "target": "Извади пушката"
    },
    {
      "id": 110504454023880712,
      "target": "Пусни го"
    },
    {
      "id": 110504454023880711,
      "target": "Leper: Надявам се, че няма да го сметнеш за признак на Гост?"
    },
    {
      "id": 110504454023880710,
      "target": "Leper: ..."
    },
    {
      "id": 110504454023880709,
      "target": "Leper: Е, тук за съжаление ще видиш кожния дефект."
    },
    {
      "id": 110504454023880708,
      "target": "Извади пушката"
    },
    {
      "id": 110504454023880707,
      "target": "Пусни го"
    },
    {
      "id": 110504454023880706,
      "target": "Leper: Е, зъбите ми са криви. Няма причина да ме смяташ за Гост."
    },
    {
      "id": 110504454023880705,
      "target": "Leper: Надявам се, че няма да ме убиеш само защото зъбите ми са равни, нали?"
    },
    {
      "id": 110504454023880704,
      "target": "Leper: Е, равни са, както виждаш. Кожата ми може да е дефектна, но поне по рождение имам хубави зъби."
    },
    {
      "id": 110504454019686410,
      "target": "Leper: ..."
    },
    {
      "id": 110504454019686409,
      "target": "Leper: Гледай, обикновени зъби."
    },
    {
      "id": 110504454019686408,
      "target": "Уши"
    },
    {
      "id": 110504454019686407,
      "target": "Снимка"
    },
    {
      "id": 110504454019686406,
      "target": "Подмишници"
    },
    {
      "id": 110504454019686405,
      "target": "Очи"
    },
    {
      "id": 110504454019686404,
      "target": "Ръце"
    },
    {
      "id": 110504454019686403,
      "target": "Зъби"
    },
    {
      "id": 110504454019686402,
      "target": "Leper: Е, щом толкова искаш, проверявай."
    },
    {
      "id": 110504454019686401,
      "target": "Nervous: Мамка ти…"
    },
    {
      "id": 110504454019686400,
      "target": "Nervous: Може би трябваше да остана в онзи хотел."
    },
    {
      "id": 110504454015492107,
      "target": "Nervous: Нищо, забрави."
    },
    {
      "id": 110504454015492106,
      "target": "Nervous: Не?.. Хи-хи, просто така ми се стори…"
    },
    {
      "id": 110504454015492105,
      "target": "Nervous: Някой… помоли ли те?"
    },
    {
      "id": 110504454015492104,
      "target": "Nervous: Как взе това решение?"
    },
    {
      "id": 110504454015492103,
      "target": "Nervous: Защо изобщо реши да насочиш оръжие към мен?"
    },
    {
      "id": 110504454015492102,
      "target": "Nervous: Или просто някакво пресветване?"
    },
    {
      "id": 110504454015492101,
      "target": "Nervous: Или е като игли?"
    },
    {
      "id": 110504454015492100,
      "target": "Nervous: А какво означават тези ивици? Знаеш ли?"
    },
    {
      "id": 110504454015492099,
      "target": "Nervous: Някой застана ли до мен? Или е някакво странно пресветване?"
    },
    {
      "id": 110504454015492098,
      "target": "Nervous: А какво изобщо означава всичко това? Защо има някаква сянка до мен?"
    }
  ]
}
