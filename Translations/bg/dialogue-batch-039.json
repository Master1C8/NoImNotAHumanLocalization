  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504457391906823,
      "target": "Bald: Здрасти, братле!"
    },
    {
      "id": 110504457391906822,
      "target": "Tough: Копеле."
    },
    {
      "id": 110504457391906821,
      "target": "Tough: Ето ти…"
    },
    {
      "id": 110504457391906820,
      "target": "Tough: Всъщност не очаквах друго."
    },
    {
      "id": 110504457391906819,
      "target": "Tough: Не?"
    },
    {
      "id": 110504457391906818,
      "target": "Tough: …"
    },
    {
      "id": 110504457391906817,
      "target": "Tough: Това проверка ли е?"
    },
    {
      "id": 110504457391906816,
      "target": "Tough: Ще се радвам да си поговорим."
    },
    {
      "id": 110504457387712524,
      "target": "Tough: Знаеш ли, за мен е чест да съм тук в този шибан ад, който стана животът ни."
    },
    {
      "id": 110504457387712523,
      "target": "Tough: Чудесно. Благодаря!"
    },
    {
      "id": 110504457387712522,
      "target": "По-добре си тръгни"
    },
    {
      "id": 110504457387712521,
      "target": "Влизай"
    },
    {
      "id": 110504457387712520,
      "target": "Tough: Да живееш значи да правиш всичко напук. Нищо не идва даром."
    },
    {
      "id": 110504457387712519,
      "target": "Tough: Оцеляваме само когато положим поне някакво усилие."
    },
    {
      "id": 110504457387712518,
      "target": "Tough: Искрено мисля, че ако сега всички се оставим на течението, човечеството няма бъдеще."
    },
    {
      "id": 110504457387712517,
      "target": "Tough: А, извини ме, ако съм оставила такова впечатление."
    },
    {
      "id": 110504457387712516,
      "target": "По-добре си тръгни"
    },
    {
      "id": 110504457387712515,
      "target": "Влизай"
    },
    {
      "id": 110504457387712514,
      "target": "Tough: Това не е първото бедствие за хората. Защо просто да легнем и да умрем?"
    },
    {
      "id": 110504457387712513,
      "target": "Tough: Но със сигурност не съм се отчаяла."
    },
    {
      "id": 110504457387712512,
      "target": "Tough: А, питаш защо съм дошла тук? Хахаха, кой знае. Може би съм луда."
    },
    {
      "id": 110504457383518219,
      "target": "Tough: Какво?"
    },
    {
      "id": 110504457383518218,
      "target": "Говориш като маниачка"
    },
    {
      "id": 110504457383518217,
      "target": "Толкова ли си отчаяна?"
    },
    {
      "id": 110504457383518216,
      "target": "Tough: Трябва да оцелеем на всяка цена."
    },
    {
      "id": 110504457383518215,
      "target": "Tough: Не можех да подмина такова място. Затова се надявам да намерим общ език."
    },
    {
      "id": 110504457383518214,
      "target": "Tough: Че ТИ не позволяваш на Гостите да ти отнемат това, което ти принадлежи по право. Живота ти."
    },
    {
      "id": 110504457383518213,
      "target": "Tough: Че тук не е лесно да оцелееш."
    },
    {
      "id": 110504457383518212,
      "target": "Говориш като маниачка"
    },
    {
      "id": 110504457383518211,
      "target": "Толкова ли си отчаяна?"
    },
    {
      "id": 110504457383518210,
      "target": "Tough: Но ти… Ти няма да се дадеш."
    },
    {
      "id": 110504457383518209,
      "target": "Tough: Някои се самоубиват. Други просто умират бавно, без сили да направят каквото и да било."
    },
    {
      "id": 110504457383518208,
      "target": "Tough: Виждала съм много хора, които са се предали. Не са готови да продължат да живеят."
    },
    {
      "id": 110504457379323915,
      "target": "Tough: Не, наистина."
    },
    {
      "id": 110504457379323914,
      "target": "Какво разказват за къщата ми?"
    },
    {
      "id": 110504457379323913,
      "target": "Благодаря?"
    },
    {
      "id": 110504457379323912,
      "target": "Tough: Но те уважавам."
    },
    {
      "id": 110504457379323911,
      "target": "Tough: Тук идват или отчаяните, или онези, които не разбират какво става тук."
    },
    {
      "id": 110504457379323910,
      "target": "Tough: Мнозина се опитват да заобикалят къщата ти."
    },
    {
      "id": 110504457379323909,
      "target": "Tough: Чувала съм за теб."
    }
  ]
}
