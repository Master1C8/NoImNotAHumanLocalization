  "entries": [
    {
      "id": 110504452803338246,
      "target": "Очи"
    },
    {
      "id": 110504452803338245,
      "target": "Ръце"
    },
    {
      "id": 110504452803338244,
      "target": "Зъби"
    },
    {
      "id": 110504452803338243,
      "target": "Greatmother: Какво искаш да провериш?"
    },
    {
      "id": 110504452803338242,
      "target": "Daughter: Сигурно скоро ще дойде."
    },
    {
      "id": 110504452803338241,
      "target": "Daughter: Когато татко дойде да ме вземе, непременно ще му кажа, че изобщо не сте Гост."
    },
    {
      "id": 110504452803338240,
      "target": "Daughter: Благодаря, че правите като татко."
    },
    {
      "id": 110504452799143942,
      "target": "Daughter: ..."
    },
    {
      "id": 110504452799143941,
      "target": "Daughter: Татко казваше да се пазя от паразити, кърлежи и бръмбари. Тях ли търсите?"
    },
    {
      "id": 110504452799143940,
      "target": "Daughter: Не ми хареса. Не ме карайте повече да се снимам."
    },
    {
      "id": 110504452799143939,
      "target": "Daughter: Благодаря."
    },
    {
      "id": 110504452799143938,
      "target": "Daughter: Мммм."
    },
    {
      "id": 110504452799143937,
      "target": "Daughter: ..."
    },
    {
      "id": 110504452799143936,
      "target": "Daughter: Ще ми покажете ли снимката после?"
    },
    {
      "id": 110504452794949639,
      "target": "Daughter: Мен рядко са ме снимали."
    },
    {
      "id": 110504452794949638,
      "target": "Daughter: Снимка?"
    },
    {
      "id": 110504452794949637,
      "target": "Уши"
    },
    {
      "id": 110504452794949636,
      "target": "Снимка"
    },
    {
      "id": 110504452794949635,
      "target": "Scammer: Набързо ще изкарам пари и ще си купя нова, после ще заживея добре."
    },
    {
      "id": 110504452794949634,
      "target": "Scammer: За мен не се тревожи, тук поне не плащам наем, ха-ха."
    },
    {
      "id": 110504452794949633,
      "target": "Scammer: Пфу, вече се бях напрегнал."
    },
    {
      "id": 110504452794949632,
      "target": "Scammer: Иначе ще се отпуснат, ще забравят благодарение на кого са тук и няма да плащат."
    },
    {
      "id": 110504452790755337,
      "target": "Scammer: Нека стоят нащрек."
    },
    {
      "id": 110504452790755336,
      "target": "Scammer: Мен не ме баламосвай, подгрявай онези балъци."
    },
    {
      "id": 110504452790755335,
      "target": "Изслушай"
    },
    {
      "id": 110504452790755334,
      "target": "Стреляй"
    },
    {
      "id": 110504452790755333,
      "target": "Scammer: Нямам пари, всичко набих в казиното, абсолютно всичко."
    },
    {
      "id": 110504452790755332,
      "target": "Scammer: Така. Нали те помолих..."
    },
    {
      "id": 110504452790755331,
      "target": "Изслушай"
    },
    {
      "id": 110504452790755330,
      "target": "Стреляй"
    },
    {
      "id": 110504452790755329,
      "target": "Scammer: Веднъж изгубих къщата на леля ми на карти и дори тогава не го отнесох толкова. А тук за една снимка..."
    },
    {
      "id": 110504452790755328,
      "target": "Scammer: Ти май се бъзикаш."
    },
    {
      "id": 110504452786561031,
      "target": "Извади пушката"
    },
    {
      "id": 110504452786561030,
      "target": "Пусни го"
    },
    {
      "id": 110504452786561029,
      "target": "Scammer: Всичко е наред, нали?"
    },
    {
      "id": 110504452786561028,
      "target": "Scammer: ..."
    },
    {
      "id": 110504452786561027,
      "target": "Scammer: Ще ти покажа ухото си, но не ми пробутвай същата шибана простотия."
    },
    {
      "id": 110504452786561026,
      "target": "Scammer: Гледаш човека, казваш му, че в него е Гостният дух, и му искаш пари, за да не разказваш на никого."
    },
    {
      "id": 110504452786561025,
      "target": "Scammer: Ей, аз пръв измислих тази измама."
    },
    {
      "id": 110504452786561024,
      "target": "Извади пушката"
    }
  ]
}
