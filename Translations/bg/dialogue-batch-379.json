  "entries": [
    {
      "id": 110504452107083786,
      "target": "Sirin: Сестра ми бръсне подмишниците. Грижи се за мен."
    },
    {
      "id": 110504452107083785,
      "target": "Извади пушката"
    },
    {
      "id": 110504452107083784,
      "target": "Пусни я"
    },
    {
      "id": 110504452107083783,
      "target": "Sirin: Но тя не признава пустотата в очите."
    },
    {
      "id": 110504452107083782,
      "target": "Sirin: По това със сестра ми си приличаме."
    },
    {
      "id": 110504452107083781,
      "target": "Извади пушката"
    },
    {
      "id": 110504452107083780,
      "target": "Пусни я"
    },
    {
      "id": 110504452107083779,
      "target": "Sirin: Остави ме да умра още тогава."
    },
    {
      "id": 110504452107083778,
      "target": "Sirin: По-добре да беше…"
    },
    {
      "id": 110504452107083777,
      "target": "Sirin: Но това е безсмислено."
    },
    {
      "id": 110504452107083776,
      "target": "Sirin: Сестра ми помага."
    },
    {
      "id": 110504452102889483,
      "target": "Извади пушката"
    },
    {
      "id": 110504452102889482,
      "target": "Пусни я"
    },
    {
      "id": 110504452102889481,
      "target": "Sirin: Ще ми ги избиеш ли?"
    },
    {
      "id": 110504452102889480,
      "target": "Sirin: Гледай."
    },
    {
      "id": 110504452102889479,
      "target": "Уши"
    },
    {
      "id": 110504452102889478,
      "target": "Снимка"
    },
    {
      "id": 110504452102889477,
      "target": "Подмишници"
    },
    {
      "id": 110504452102889476,
      "target": "Очи"
    },
    {
      "id": 110504452102889475,
      "target": "Ръце"
    },
    {
      "id": 110504452102889474,
      "target": "Зъби"
    },
    {
      "id": 110504452102889473,
      "target": "Sirin: Действай вече."
    },
    {
      "id": 110504452102889472,
      "target": "Alkonost: Какво следва? Гостите ще изчезнат или отсега нататък винаги ще делим градовете си с тях?"
    },
    {
      "id": 110504452098695178,
      "target": "Alkonost: Честно казано, и аз самата съм ужасно изплашена."
    },
    {
      "id": 110504452098695177,
      "target": "Alkonost: Но всичко това продължава, а краят сякаш не се вижда скоро."
    },
    {
      "id": 110504452098695176,
      "target": "Alkonost: Толкова искам най-сетне да си отдъхна и да не живея в постоянен страх."
    },
    {
      "id": 110504452098695175,
      "target": "Alkonost: Писна ми от всичко, мамка му."
    },
    {
      "id": 110504452098695174,
      "target": "Alkonost: Какво ще стане, ако продължиш да стоиш настрана от останалите?"
    },
    {
      "id": 110504452098695173,
      "target": "Alkonost: Но ако се поддадеш на паниката, по какво ще се различаваш от Гостите?"
    },
    {
      "id": 110504452098695172,
      "target": "Alkonost: Разбирам всичко. Озова се в много трудна ситуация."
    },
    {
      "id": 110504452098695171,
      "target": "Alkonost: Сестра ми не издържа, предаде се."
    },
    {
      "id": 110504452098695170,
      "target": "Alkonost: Животът винаги е изпитвал силите ни. Винаги ни е било много тежко."
    },
    {
      "id": 110504452098695169,
      "target": "Alkonost: С горчивина."
    },
    {
      "id": 110504452098695168,
      "target": "Alkonost: Ето как завърши песента на живота."
    },
    {
      "id": 110504452094500875,
      "target": "Изслушай"
    },
    {
      "id": 110504452094500874,
      "target": "Стреляй"
    },
    {
      "id": 110504452094500873,
      "target": "Alkonost: Помисли пак, не върши глупости."
    },
    {
      "id": 110504452094500872,
      "target": "Alkonost: Чакай, по новините казаха ли, че ТАКИВА подмишници са признак на Гост?"
    },
    {
      "id": 110504452094500871,
      "target": "Изслушай"
    },
    {
      "id": 110504452094500870,
      "target": "Стреляй"
    }
  ]
}
