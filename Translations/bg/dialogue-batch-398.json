  "entries": [
    {
      "id": 110504451809288196,
      "target": "Изслушай"
    },
    {
      "id": 110504451809288195,
      "target": "Стреляй"
    },
    {
      "id": 110504451809288194,
      "target": "Mother: Ако искаш, извади и граната. Това няма да ми помогне да се наспя."
    },
    {
      "id": 110504451809288193,
      "target": "Изслушай"
    },
    {
      "id": 110504451809288192,
      "target": "Стреляй"
    },
    {
      "id": 110504451805093898,
      "target": "Mother: Тези ръце ще ти сготвят супа, ако доживееш! А ти посягаш към пушката…"
    },
    {
      "id": 110504451805093897,
      "target": "Mother: От домакинските препарати вече ми излезе някакъв обрив. Не успях да отида на лекар."
    },
    {
      "id": 110504451805093896,
      "target": "Изслушай"
    },
    {
      "id": 110504451805093895,
      "target": "Стреляй"
    },
    {
      "id": 110504451805093894,
      "target": "Mother: А зъбите ми пак са жълти. С такива деца как да не пропушиш?"
    },
    {
      "id": 110504451805093893,
      "target": "Mother: Вече цяла седмица ми тече кръв, когато си мия зъбите."
    },
    {
      "id": 110504451805093892,
      "target": "Извади пушката"
    },
    {
      "id": 110504451805093891,
      "target": "Пусни я"
    },
    {
      "id": 110504451805093890,
      "target": "Mother: Вече не чувам половината неща заради детските писъци."
    },
    {
      "id": 110504451805093889,
      "target": "Mother: Отдавна не съм ги чистила. Може вече да се е образувала тапа."
    },
    {
      "id": 110504451805093888,
      "target": "Извади пушката"
    },
    {
      "id": 110504451800899594,
      "target": "Пусни я"
    },
    {
      "id": 110504451800899593,
      "target": "Mother: Разрошена и ядосана, както обикновено."
    },
    {
      "id": 110504451800899592,
      "target": "Mother: Може ли да седна? Не?"
    },
    {
      "id": 110504451800899591,
      "target": "Извади пушката"
    },
    {
      "id": 110504451800899590,
      "target": "Пусни я"
    },
    {
      "id": 110504451800899589,
      "target": "Mother: Дезодорантът ми отдавна свърши. Не се сърди."
    },
    {
      "id": 110504451800899588,
      "target": "Mother: Е, гледай."
    },
    {
      "id": 110504451800899587,
      "target": "Извади пушката"
    },
    {
      "id": 110504451800899586,
      "target": "Пусни я"
    },
    {
      "id": 110504451800899585,
      "target": "Mother: Виждаш ли огромните торбички? От недоспиване са…"
    },
    {
      "id": 110504451800899584,
      "target": "Mother: Е, гледай."
    },
    {
      "id": 110504451796705289,
      "target": "Извади пушката"
    },
    {
      "id": 110504451796705288,
      "target": "Пусни я"
    },
    {
      "id": 110504451796705287,
      "target": "Mother: Не са длани, а лопати. Всичко е за децата."
    },
    {
      "id": 110504451796705286,
      "target": "Mother: Ето, гледай."
    },
    {
      "id": 110504451796705285,
      "target": "Извади пушката"
    },
    {
      "id": 110504451796705284,
      "target": "Пусни я"
    },
    {
      "id": 110504451796705283,
      "target": "Mother: Знаеш ли, преди не им обръщах внимание. Просто нямах време. А сега... Сега съжалявам."
    },
    {
      "id": 110504451796705282,
      "target": "Mother: Е, моля ти се."
    },
    {
      "id": 110504451796705281,
      "target": "Уши"
    },
    {
      "id": 110504451796705280,
      "target": "Снимка"
    },
    {
      "id": 110504451792510985,
      "target": "Подмишници"
    },
    {
      "id": 110504451792510984,
      "target": "Очи"
    },
    {
      "id": 110504451792510983,
      "target": "Ръце"
    }
  ]
}
