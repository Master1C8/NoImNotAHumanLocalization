  "glossaryFingerprint": "28d7eb651d95b56a72a5a4acefcba5f434dcbe6925a2233126655e13b0e01cab",
  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504451905757187,
      "target": "Fanatic: ЗАЩО?"
    },
    {
      "id": 110504451905757186,
      "target": "Fanatic: Чакай, не ти ли харесват ръцете ми?"
    },
    {
      "id": 110504451905757185,
      "target": "Изслушай"
    },
    {
      "id": 110504451905757184,
      "target": "Стреляй"
    },
    {
      "id": 110504451901562890,
      "target": "Fanatic: Това не помага на жизнената ни сила."
    },
    {
      "id": 110504451901562889,
      "target": "Fanatic: Е, това вече е прекалено!"
    },
    {
      "id": 110504451901562888,
      "target": "Изслушай"
    },
    {
      "id": 110504451901562887,
      "target": "Стреляй"
    },
    {
      "id": 110504451901562886,
      "target": "Fanatic: Вече не само говорят зад гърба ми, а и стрелят..."
    },
    {
      "id": 110504451901562885,
      "target": "Fanatic: ИЗКУКУРЯСАХТЕ, НЕСХВАЩАЩИ ТЪПАЦИ!"
    },
    {
      "id": 110504451901562884,
      "target": "Fanatic: Човече, защо го правиш?"
    },
    {
      "id": 110504451901562883,
      "target": "Изслушай"
    },
    {
      "id": 110504451901562882,
      "target": "Стреляй"
    },
    {
      "id": 110504451901562881,
      "target": "Fanatic: Те-е-ежко-о-о-о-о."
    },
    {
      "id": 110504451901562880,
      "target": "Fanatic: Е, да, тежко-о-о-о е без бира в ръцете."
    },
    {
      "id": 110504451897368586,
      "target": "Изслушай"
    },
    {
      "id": 110504451897368585,
      "target": "Стреляй"
    },
    {
      "id": 110504451897368584,
      "target": "Fanatic: Ще прибереш ли пушчицата?"
    },
    {
      "id": 110504451897368583,
      "target": "Fanatic: ..."
    },
    {
      "id": 110504451897368582,
      "target": "Fanatic: Я се опитай да стреляш! Истината ще ме защити!"
    },
    {
      "id": 110504451897368581,
      "target": "Fanatic: ТОВА Е ЗА СПАСЕНИЕТО НА ЕНЕРГИЯТА НА СЛЪНЦЕТО!"
    },
    {
      "id": 110504451897368580,
      "target": "Fanatic: А ти ще ми дадеш малко пари за това."
    },
    {
      "id": 110504451897368579,
      "target": "Fanatic: Ела при мен, ще ти разказвам за живота си."
    },
    {
      "id": 110504451897368578,
      "target": "Fanatic: КОЛКО ПРЕКРАСНО СЕ ПОЛУЧИ ВСИЧКО!"
    },
    {
      "id": 110504451897368577,
      "target": "Fanatic: (Не забелязвате изкривявания)"
    },
    {
      "id": 110504451897368576,
      "target": "Fanatic: (Както в живота, и на снимката той изглежда занемарен и мръсен)"
    },
    {
      "id": 110504451893174280,
      "target": "Fanatic: (Снимате неугледния мъж)"
    },
    {
      "id": 110504451893174279,
      "target": "Fanatic: Хайде, СНИМАЙ МЕ!"
    },
    {
      "id": 110504451893174278,
      "target": "Fanatic: Да, учих го да гледа към слънцето, но за това ще ти разкажа друг път."
    },
    {
      "id": 110504451893174277,
      "target": "Fanatic: Някой каза ли ти, че се ръкувах със самия СЛЪНЧЕВ ВОДАЧ?"
    },
    {
      "id": 110504451893174276,
      "target": "Fanatic: Хм-хм-хм-хм."
    },
    {
      "id": 110504451893174275,
      "target": "Fanatic: Да се снимам ли?"
    },
    {
      "id": 110504451893174274,
      "target": "Извади пушката"
    },
    {
      "id": 110504451893174273,
      "target": "Пусни го"
    },
    {
      "id": 110504451893174272,
      "target": "Fanatic: Ако не, значи си просто слепец. Опитай да погледаш слънцето по-дълго, КАТО МЕН."
    },
    {
      "id": 110504451888979977,
      "target": "Fanatic: ВИДЯ ЛИ В ОЧИТЕ МИ ПРАВЕДНАТА СИЛА НА СЛЪНЦЕТО?"
    },
    {
      "id": 110504451888979976,
      "target": "Fanatic: ..."
    },
    {
      "id": 110504451888979975,
      "target": "Fanatic: Всичките си сили получавам от ОЧИТЕ!"
    },
    {
      "id": 110504451888979974,
      "target": "Fanatic: С тях попивам всички блага на светлината, прррревръщайки ги в енергия."
    },
    {
      "id": 110504451888979973,
      "target": "Fanatic: ПОГЛЕДНИ В ТЪМНИТЕ МИ ОЧИ!"
    }
  ]
}
