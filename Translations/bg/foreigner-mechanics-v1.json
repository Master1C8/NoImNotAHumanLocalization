{
  "schemaVersion": 1,
  "locale": "bg",
  "sourceSpecSha256": "13a6edc02ab914becdd86af5e8829299c7a7b11ff3c300e61b3aed023b441368",
  "editorialStatus": "development draft; independent mechanics review pending",
  "sourceInterpretationNotes": {
    "line:Foreigner_Death_0f116b2": "Damaged Russian keyboard-layout fragment interpreted as killing, not a person named Ivan.",
    "line:Foreigner_Photo_0c3c7aa": "Damaged photo/adoration wording interpreted using neighboring Photo_DontShoot preference for photos; exact damaged syntax unresolved."
  },
  "entries": [
    {
      "key": "line:FEMA_GivingPostcard_Foreigner_0af7d0d",
      "parts": [
        {
          "kind": "opaque",
          "text": "Добре, ще я взема..."
        }
      ]
    },
    {
      "key": "line:FEMA_GivingPostcard_Foreigner_0cc7047",
      "parts": [
        {
          "kind": "opaque",
          "text": "Какво е това?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_1_0e957d2",
      "parts": [
        {
          "kind": "understood",
          "text": "Късмеет!",
          "sourceCue": "Уууудаси!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_1_0c936e3",
      "parts": [
        {
          "kind": "opaque",
          "text": "Може би ще си бъда у дома след толкова време…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_1_0905b5d",
      "parts": [
        {
          "kind": "opaque",
          "text": "Но утре ще отида на гарата и сам ще разбера!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_1_0e19b62",
      "parts": [
        {
          "kind": "opaque",
          "text": "Не разбрах, извинявай."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_0ee031f",
      "parts": [
        {
          "kind": "understood",
          "text": "Чааао!",
          "sourceCue": "Пайкааа!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_02340b2",
      "parts": [
        {
          "kind": "opaque",
          "text": "Тази нощ си тръгвам. Чао!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_04527f2",
      "parts": [
        {
          "kind": "opaque",
          "text": "Утре ще тръгна към дома! Поне ще отида на гарата."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_08b6c83",
      "parts": [
        {
          "kind": "opaque",
          "text": "Не разбирам, приятелю."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_5_058e3f1",
      "parts": [
        {
          "kind": "opaque",
          "text": "Успяха да ми обяснят, че влаковете още вървят! Представяш ли си?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_5_0a05381",
      "parts": [
        {
          "kind": "opaque",
          "text": "А, за това говориш."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_2_043501e",
      "parts": [
        {
          "kind": "opaque",
          "text": "Още ли плават? Трябва да потърся информация, благодаря!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_2_020fa6b",
      "parts": [
        {
          "kind": "opaque",
          "text": "Тоест да замина с кораб?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_1_0264fa8",
      "parts": [
        {
          "kind": "opaque",
          "text": "Може би още наистина може да се отлети."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_1_03e6625",
      "parts": [
        {
          "kind": "opaque",
          "text": "Трябва да намеря информация някъде."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_1_06190d7",
      "parts": [
        {
          "kind": "opaque",
          "text": "Самолет? Мислиш ли, че още летят?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_0f3f5f9",
      "parts": [
        {
          "kind": "opaque",
          "text": "Положението е пълен шибан ужас, иначе не мога да го опиша."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_00450ac",
      "parts": [
        {
          "kind": "opaque",
          "text": "Дойдох на гости на приятел, а сега това."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_04109c2",
      "parts": [
        {
          "kind": "opaque",
          "text": "Дом? За дома ли питаш?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_0ba0261",
      "parts": [
        {
          "kind": "opaque",
          "text": "Какъв ужас."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_084c32d",
      "parts": [
        {
          "kind": "opaque",
          "text": "Дали у дома става същото?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_05970a6",
      "parts": [
        {
          "kind": "opaque",
          "text": "Трудничко е, но може би ще ми помогне."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_0ef9d29",
      "parts": [
        {
          "kind": "understood",
          "text": "Добре-е.",
          "sourceCue": "Харасхо."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_0a6ab5a",
      "parts": [
        {
          "kind": "understood",
          "text": "Доб…",
          "sourceCue": "Хара…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_041d9b1",
      "parts": [
        {
          "kind": "understood",
          "text": "Добре-е-е.",
          "sourceCue": "Харохооо."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_0a21905",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ще се опитам да повторя."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_2_04c6bc4",
      "parts": [
        {
          "kind": "opaque",
          "text": "Може би е въпросителна дума."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_2_090b6a7",
      "parts": [
        {
          "kind": "opaque",
          "text": "Но ти попита нещо."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_1_01c288c",
      "parts": [
        {
          "kind": "opaque",
          "text": "Може би е въпросителна дума."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_1_01a5f8a",
      "parts": [
        {
          "kind": "opaque",
          "text": "Пак не разбирам. Но ти попита нещо."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_09e3b4a",
      "parts": [
        {
          "kind": "understood",
          "text": "Как.",
          "sourceCue": "Как."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_0f0190b",
      "parts": [
        {
          "kind": "opaque",
          "text": "Може би така поне ще разбера какво казвам."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_075bcb9",
      "parts": [
        {
          "kind": "opaque",
          "text": "Мога да повтарям думите ти, а ти да реагираш."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_1_1_0ebd34d",
      "parts": [
        {
          "kind": "opaque",
          "text": "Да измислим някакъв общ език?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_1_1_0cd4635",
      "parts": [
        {
          "kind": "opaque",
          "text": "Не те разбирам. Какво може да се направи?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_1_0d71f9d",
      "parts": [
        {
          "kind": "opaque",
          "text": "ЗАШИХА МИ УСТАТА! Просто защото не ме разбират."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_1_09c22e5",
      "parts": [
        {
          "kind": "opaque",
          "text": "Това е някакъв кошмар!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Death_0f116b2",
      "parts": [
        {
          "kind": "opaque",
          "text": "У… биване…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Death_0b50221",
      "parts": [
        {
          "kind": "opaque",
          "text": "Така става. Не те разбират, страхуват се от теб и ти…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Ears_DontShoot_00a90ca",
      "parts": [
        {
          "kind": "opaque",
          "text": "Всичко бих дал пак да го видя. Много ми липсва. "
        },
        {
          "kind": "understood",
          "text": "Покаж",
          "sourceCue": "Пакаж"
        },
        {
          "kind": "opaque",
          "text": ", какво значи това?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Photo_DontShoot_0bf7704",
      "parts": [
        {
          "kind": "opaque",
          "text": "Харесвам снимките. Ти явно не ги цениш…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Armpit_DontShoot_05058dc",
      "parts": [
        {
          "kind": "understood",
          "text": "Проверява",
          "sourceCue": "Правирйат ба"
        },
        {
          "kind": "opaque",
          "text": " тук… Изглежда нередно…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Eyes_DontShoot_044b445",
      "parts": [
        {
          "kind": "opaque",
          "text": "Очи като очи. Защо ме плашиш?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Hands_DontShoot_062d5bf",
      "parts": [
        {
          "kind": "opaque",
          "text": "Трябва да си измия ръцете…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Teeth_DontShoot_0f917b2",
      "parts": [
        {
          "kind": "opaque",
          "text": "Знаеш, че ми зашиха устата. Сега и пушка насочваш и "
        },
        {
          "kind": "understood",
          "text": "стрел",
          "sourceCue": "расрел"
        },
        {
          "kind": "opaque",
          "text": " по всеки…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Ears_Gun_022cef2",
      "parts": [
        {
          "kind": "opaque",
          "text": "И после какво?!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Armpit_Gun_0488113",
      "parts": [
        {
          "kind": "opaque",
          "text": "Човече! Стига! Каква е тази глупост!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Eyes_Gun_0bf3d2f",
      "parts": [
        {
          "kind": "opaque",
          "text": "Недей! Аз съм добър! Просто не се разбираме!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Hands_Gun_0b64782",
      "parts": [
        {
          "kind": "opaque",
          "text": "Махни пушката! Нищо лошо не съм ти направил!!!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Teeth_Gun_0a4207d",
      "parts": [
        {
          "kind": "opaque",
          "text": "Защо, какво правиш!? Направих каквото искаше!!!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Ears_0f4eb6c",
      "parts": [
        {
          "kind": "opaque",
          "text": "Обица от моя скъп приятел."
        }
      ]
    },
    {
      "key": "line:Foreigner_Ears_076f3a7",
      "parts": [
        {
          "kind": "opaque",
          "text": "Уши като уши."
        }
      ]
    },
    {
      "key": "line:Foreigner_Photo_002e8e0",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ще ми покажеш ли?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Photo_0c3c7aa",
      "parts": [
        {
          "kind": "opaque",
          "text": "Снимка? Това много го обичам!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Armpit_0d48250",
      "parts": [
        {
          "kind": "opaque",
          "text": "Доволен?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Armpit_090c5f5",
      "parts": [
        {
          "kind": "opaque",
          "text": "Не разбирам всичко това… Е, добре…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Eyes_0b39cdc",
      "parts": [
        {
          "kind": "opaque",
          "text": "Все не разбирам защо ти е всичко това… "
        },
        {
          "kind": "understood",
          "text": "Слънсе",
          "sourceCue": "Солце"
        },
        {
          "kind": "opaque",
          "text": " може да изгори ретината. Аз не "
        },
        {
          "kind": "understood",
          "text": "гледа",
          "sourceCue": "смарет"
        },
        {
          "kind": "opaque",
          "text": " към "
        },
        {
          "kind": "understood",
          "text": "слънсе",
          "sourceCue": "солце"
        },
        {
          "kind": "opaque",
          "text": "."
        }
      ]
    },
    {
      "key": "line:Foreigner_Eyes_0aba9fb",
      "parts": [
        {
          "kind": "opaque",
          "text": "Очи?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Hands_0144f06",
      "parts": [
        {
          "kind": "opaque",
          "text": "Защо правиш всичко това? "
        },
        {
          "kind": "understood",
          "text": "Убива",
          "sourceCue": "Убйивай"
        },
        {
          "kind": "opaque",
          "text": " за забавление?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Hands_0654052",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ръце? Добре."
        }
      ]
    },
    {
      "key": "line:Foreigner_Teeth_02674b3",
      "parts": [
        {
          "kind": "opaque",
          "text": "И сега какво?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Teeth_03ba689",
      "parts": [
        {
          "kind": "opaque",
          "text": "Какво? Сочиш "
        },
        {
          "kind": "understood",
          "text": "уста",
          "sourceCue": "рхот"
        },
        {
          "kind": "opaque",
          "text": "? Да, зашита е. И сега какво? Да се усмихна?"
        }
      ]
    },
    {
      "key": "line:Foreigner_WannaCheck_0d955c8",
      "parts": [
        {
          "kind": "opaque",
          "text": "Нищо не разбирам. Какво искаш от мен?"
        }
      ]
    }
  ]
}
