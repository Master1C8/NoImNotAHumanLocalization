      "target": "TV: Вече и в асортимента за доставка на храна на For Rest. Обадете се на номер: {0}."
    },
    {
      "id": 110504457941360652,
      "target": "1 чайна гъба, моля"
    },
    {
      "id": 110504457941360651,
      "target": "1 пакет цигари, моля"
    },
    {
      "id": 110504457941360650,
      "target": "2 консерви котешка храна, моля"
    },
    {
      "id": 110504457941360649,
      "target": "TV: Следва репортаж за временното спиране на обезвреждането на телата."
    },
    {
      "id": 110504457941360648,
      "target": "TV: …"
    },
    {
      "id": 110504457941360647,
      "target": "TV: …"
    },
    {
      "id": 110504457941360646,
      "target": "TV: …"
    },
    {
      "id": 110504457941360645,
      "target": "Phone: …"
    },
    {
      "id": 110504457941360644,
      "target": "Phone: Но тя още ми липсва..."
    },
    {
      "id": 110504457941360643,
      "target": "Phone: ..."
    },
    {
      "id": 110504457941360642,
      "target": "Phone: Я вървете по дяволите!"
    },
    {
      "id": 110504457941360641,
      "target": "Phone: Защо изобщо ви се оправдавам?"
    },
    {
      "id": 110504457941360640,
      "target": "Phone: Моля ви..."
    },
    {
      "id": 110504457937166346,
      "target": "Phone: Не се обаждайте повече тук..."
    },
    {
      "id": 110504457937166345,
      "target": "Phone: Простете."
    },
    {
      "id": 110504457937166344,
      "target": "Phone: ..."
    },
    {
      "id": 110504457937166343,
      "target": "Phone: Сега съжалявам само, че не попитахме онова, което беше вместо дъщеря ни, какво е сторило с нашата мъничка..."
    },
    {
      "id": 110504457937166342,
      "target": "Phone: Съпругът ми помогна да го разбера."
    },
    {
      "id": 110504457937166341,
      "target": "Phone: Но после разбрах, че това изобщо не е била нашата дъщеря."
    },
    {
      "id": 110504457937166340,
      "target": "Phone: Отначало исках да убия самия него."
    },
    {
      "id": 110504457937166339,
      "target": "Phone: ..."
    },
    {
      "id": 110504457937166338,
      "target": "Phone: Той веднага се справи с този Гост."
    },
    {
      "id": 110504457937166337,
      "target": "Phone: Щом казах на съпруга си, той..."
    },
    {
      "id": 110504457937166336,
      "target": "Phone: ..."
    },
    {
      "id": 110504457932972044,
      "target": "Phone: Всичко съвпадаше."
    },
    {
      "id": 110504457932972043,
      "target": "Phone: Затова веднага забелязах, когато се появиха тези признаци."
    },
    {
      "id": 110504457932972042,
      "target": "Phone: Та аз я познавах като петте си пръста."
    },
    {
      "id": 110504457932972041,
      "target": "Phone: По всички признаци."
    },
    {
      "id": 110504457932972040,
      "target": "Phone: Тя беше Гост."
    }
  ]
}
