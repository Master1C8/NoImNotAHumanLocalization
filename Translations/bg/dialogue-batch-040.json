  "entries": [
    {
      "id": 110504457379323908,
      "target": "Jacket: Ето, имам {0}. Не е много, но се надявам да Ви свърши работа."
    },
    {
      "id": 110504457379323907,
      "target": "Jacket: Много Ви благодаря."
    },
    {
      "id": 110504457379323906,
      "target": "По-добре си тръгни"
    },
    {
      "id": 110504457379323905,
      "target": "Ще изгоня обитателя. Влез"
    },
    {
      "id": 110504457379323904,
      "target": "Jacket: О… Извинете, но при Вас е {0}. Не се доверявам много на такива хора…"
    },
    {
      "id": 110504457375129611,
      "target": "Не вземам подкупи"
    },
    {
      "id": 110504457375129610,
      "target": "Добре, влизай"
    },
    {
      "id": 110504457375129609,
      "target": "Jacket: Ако трябва, имам {0}. Това ще Ви устройва ли?"
    },
    {
      "id": 110504457375129608,
      "target": "Jacket: Не искам да попадна на патрул или, още по-лошо, на Гости."
    },
    {
      "id": 110504457375129607,
      "target": "Jacket: Не, моля Ви, позволете ми да вляза."
    },
    {
      "id": 110504457375129606,
      "target": "Jacket: Ето, имам {0}. Не е много, но се надявам да Ви свърши работа."
    },
    {
      "id": 110504457375129605,
      "target": "Jacket: Много Ви благодаря."
    },
    {
      "id": 110504457375129604,
      "target": "По-добре си тръгни"
    },
    {
      "id": 110504457375129603,
      "target": "Влизай"
    },
    {
      "id": 110504457375129602,
      "target": "Jacket: Не искам да попадам там."
    },
    {
      "id": 110504457375129601,
      "target": "Jacket: …"
    },
    {
      "id": 110504457375129600,
      "target": "Jacket: Но когато тръгна слухът, че „прокажените“ ги отвеждат в карантинните зони…"
    },
    {
      "id": 110504457370935307,
      "target": "Jacket: Дойдоха и казаха, че са длъжни да проверят всички, които са живели там."
    },
    {
      "id": 110504457370935306,
      "target": "Jacket: Служителите на КИС…"
    },
    {
      "id": 110504457370935305,
      "target": "По-добре си тръгни"
    },
    {
      "id": 110504457370935304,
      "target": "Влизай"
    },
    {
      "id": 110504457370935303,
      "target": "Jacket: Изобщо не искам да попадам в карантинна зона"
    },
    {
      "id": 110504457370935302,
      "target": "Jacket: …"
    },
    {
      "id": 110504457370935301,
      "target": "Jacket: Започнаха да отвеждат хора оттам. А аз…"
    },
    {
      "id": 110504457370935300,
      "target": "Jacket: Служителите на КИС…"
    },
    {
      "id": 110504457370935299,
      "target": "А какво се случи в общежитието ти?"
    },
    {
      "id": 110504457370935298,
      "target": "Защо?"
    },
    {
      "id": 110504457370935297,
      "target": "Jacket: Аз съм от общежитието, но трябваше да си тръгна оттам…"
    },
    {
      "id": 110504457370935296,
      "target": "Jacket: Да. Ако можете, моля Ви, пуснете ме."
    },
    {
      "id": 110504457366741004,
      "target": "А какво се случи в общежитието ти?"
    },
    {
      "id": 110504457366741003,
      "target": "Защо?"
    },
    {
      "id": 110504457366741002,
      "target": "Jacket: А да се върна в общежитието вече не е вариант…"
    },
    {
      "id": 110504457366741001,
      "target": "Jacket: Трябва да намеря подслон. Няма къде другаде да живея."
    },
    {
      "id": 110504457366741000,
      "target": "Търсиш подслон?"
    },
    {
      "id": 110504457366740999,
      "target": "Какво искаш?"
    },
    {
      "id": 110504457366740998,
      "target": "Jacket: Здравейте. Ще ме пуснете ли в къщата, моля Ви?"
    },
    {
      "id": 110504457366740997,
      "target": "Experienced: Браво, балък. Знаех си, че си свестен пич."
    },
    {
      "id": 110504457366740996,
      "target": "По-добре си тръгни"
    },
    {
      "id": 110504457366740995,
      "target": "Ще изгоня обитателя. Влез"
    },
    {
      "id": 110504457366740994,
      "target": "Experienced: Не ми допада {0}."
    }
  ]
