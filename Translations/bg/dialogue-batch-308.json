    },
    {
      "id": 110504453319237640,
      "target": "Зъби"
    },
    {
      "id": 110504453319237639,
      "target": "Cultist1: Смъртта ще ни стопли в студените си ръце."
    },
    {
      "id": 110504453319237638,
      "target": "Intruder: Или ще заспя."
    },
    {
      "id": 110504453319237637,
      "target": "Intruder: Няма сънища. Хората са полудели. Ще умра."
    },
    {
      "id": 110504453319237636,
      "target": "Intruder: Макар че това е по-скоро зловещо, отколкото смешно."
    },
    {
      "id": 110504453319237635,
      "target": "Intruder: Малко ми е смешно, че реши да убиеш човек заради нещо, което дори не е ясно."
    },
    {
      "id": 110504453319237634,
      "target": "Intruder: Макар че бих го разбрал. Странно."
    },
    {
      "id": 110504453319237633,
      "target": "Intruder: Може да си го сънувал?"
    },
    {
      "id": 110504453319237632,
      "target": "Intruder: Сигурен ли си, че видя този новинарски репортаж?"
    },
    {
      "id": 110504453315043336,
      "target": "Intruder: Интересен беше този новинарски репортаж. На границата между съня и реалността."
    },
    {
      "id": 110504453315043335,
      "target": "Intruder: Ние още не сме разбрали естествените явления."
    },
    {
      "id": 110504453315043334,
      "target": "Intruder: Изобщо ме плаши колко хора напоследък са се вманиачили по някакви свръхестествени неща."
    },
    {
      "id": 110504453315043333,
      "target": "Intruder: Всичко друго мога да разбера, но аурата?"
    },
    {
      "id": 110504453315043332,
      "target": "Intruder: Просто… не знам."
    },
    {
      "id": 110504453315043331,
      "target": "Intruder: А, от телевизията… Странно."
    },
    {
      "id": 110504453315043330,
      "target": "Intruder: А къде чу за този признак?"
    },
    {
      "id": 110504453315043329,
      "target": "Intruder: И с времето става само по-зле."
    }
  ]
}
