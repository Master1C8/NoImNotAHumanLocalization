  "entries": [
    {
      "id": 110504451985448965,
      "target": "Widow: (Не виждате нищо необичайно)"
    },
    {
      "id": 110504451985448964,
      "target": "Widow: (Снимате момичето)"
    },
    {
      "id": 110504451985448963,
      "target": "Widow: Прави каквото искаш и ме остави на мира."
    },
    {
      "id": 110504451985448962,
      "target": "Widow: Нямам думи."
    },
    {
      "id": 110504451985448961,
      "target": "Widow: ..."
    },
    {
      "id": 110504451985448960,
      "target": "Widow: ИСКАТЕ ДА ЗАПЕЧАТАТЕ СМЪРТТА МУ?"
    },
    {
      "id": 110504451981254666,
      "target": "Widow: Никой не ми помогна да спася съпруга си, а сега..."
    },
    {
      "id": 110504451981254665,
      "target": "Widow: Това не ти ли се струва издевателство?"
    },
    {
      "id": 110504451981254664,
      "target": "Widow: Но така и не успях да те съхраня, мой..."
    },
    {
      "id": 110504451981254663,
      "target": "Widow: Никакво повече страдание?"
    },
    {
      "id": 110504451981254662,
      "target": "Widow: Толкова лесно ли ще свърши всичко?"
    },
    {
      "id": 110504451981254661,
      "target": "Widow: Остава само да седя и да закривам лицето си с ръце."
    },
    {
      "id": 110504451981254660,
      "target": "Widow: Не винаги мога да говоря."
    },
    {
      "id": 110504451981254659,
      "target": "Widow: Не мога да се радвам, не бива да плача."
    },
    {
      "id": 110504451981254658,
      "target": "Widow: Можем ли сега да сме откровени?"
    },
    {
      "id": 110504451981254657,
      "target": "Извади пушката"
    },
    {
      "id": 110504451981254656,
      "target": "Пусни я"
    },
    {
      "id": 110504451977060360,
      "target": "Widow: Ако показвам чувства, значи съм Гост?"
    },
    {
      "id": 110504451977060359,
      "target": "Widow: ..."
    },
    {
      "id": 110504451977060358,
      "target": "Widow: Опитай."
    },
    {
      "id": 110504451977060357,
      "target": "Widow: Какво искаш да провериш? Зачервяването?"
    },
    {
      "id": 110504451977060356,
      "target": "Извади пушката"
    },
    {
      "id": 110504451977060355,
      "target": "Пусни я"
    },
    {
      "id": 110504451977060354,
      "target": "Widow: Вече нямам сили..."
    },
    {
      "id": 110504451977060353,
      "target": "Widow: Ако искаш да ме застреляш — просто стреляй."
    },
    {
      "id": 110504451977060352,
      "target": "Widow: А може ли изобщо да не ме караш да се занимавам с тази шибана глупост?"
    },
    {
      "id": 110504451972866058,
      "target": "Widow: ..."
    },
    {
      "id": 110504451972866057,
      "target": "Widow: Ръцете ми се умориха да носят онзи, когото отказаха да спасят."
    },
    {
      "id": 110504451972866056,
      "target": "Widow: Ръцете... чакай малко."
    },
    {
      "id": 110504451972866055,
      "target": "Извади пушката"
    },
    {
      "id": 110504451972866054,
      "target": "Пусни я"
    },
    {
      "id": 110504451972866053,
      "target": "Widow: Може ли да остана спокойно сама за малко?"
    },
    {
      "id": 110504451972866052,
      "target": "Widow: Това ли беше?"
    },
    {
      "id": 110504451972866051,
      "target": "Widow: ..."
    },
    {
      "id": 110504451972866050,
      "target": "Widow: ... добре."
    },
    {
      "id": 110504451972866049,
      "target": "Widow: Какво?"
    },
    {
      "id": 110504451972866048,
      "target": "Уши"
    },
    {
      "id": 110504451968671752,
      "target": "Снимка"
    },
    {
      "id": 110504451968671751,
      "target": "Подмишници"
    },
    {
      "id": 110504451968671750,
      "target": "Очи"
    }
  ]
}
