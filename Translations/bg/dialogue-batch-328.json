  "sourceInventorySha256": "ecd96645c2ca6f23f8bf3ab2fcf65709e961478ae15a38e83d94cc335a408bf0",
  "glossaryFingerprint": "28d7eb651d95b56a72a5a4acefcba5f434dcbe6925a2233126655e13b0e01cab",
  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504452924973059,
      "target": "Стреляй"
    },
    {
      "id": 110504452924973058,
      "target": "Wolfhound: Изтрепи всички и да се свършва."
    },
    {
      "id": 110504452924973057,
      "target": "Wolfhound: Докога ще се държиш за другите, щом толкова обичаш да си сам?"
    },
    {
      "id": 110504452924973056,
      "target": "Wolfhound: Не са успели да те укротят."
    },
    {
      "id": 110504452920778757,
      "target": "Изслушай"
    },
    {
      "id": 110504452920778756,
      "target": "Стреляй"
    },
    {
      "id": 110504452920778755,
      "target": "Wolfhound: Авторитетът се крепи на уважение, не на страх. Бързо ще те пометат, стига достатъчно да изтощиш хората си."
    },
    {
      "id": 110504452920778754,
      "target": "Wolfhound: Няма да си извоюваш авторитет, като размахваш оръжие."
    },
    {
      "id": 110504452920778753,
      "target": "Изслушай"
    },
    {
      "id": 110504452920778752,
      "target": "Стреляй"
    },
    {
      "id": 110504452916584457,
      "target": "Wolfhound: В нашите среди нямаше дълго да се церемонят с теб."
    },
    {
      "id": 110504452916584456,
      "target": "Wolfhound: Караш зрял мъж да играе по свирката ти. А после дори го заплашваш."
    },
    {
      "id": 110504452916584455,
      "target": "Изслушай"
    },
    {
      "id": 110504452916584454,
      "target": "Стреляй"
    },
    {
      "id": 110504452916584453,
      "target": "Wolfhound: Не те съветвам. Дори да умра, ще си разчистим сметките на оня свят. Ще ти одера кожата."
    },
    {
      "id": 110504452916584452,
      "target": "Wolfhound: Видя ли отражението си?"
    },
    {
      "id": 110504452916584451,
      "target": "Изслушай"
    },
    {
      "id": 110504452916584450,
      "target": "Стреляй"
    },
    {
      "id": 110504452916584449,
      "target": "Wolfhound: И какво следва?"
    },
    {
      "id": 110504452916584448,
      "target": "Wolfhound: Е, какво? Ще стреляш ли?"
    },
    {
      "id": 110504452912390153,
      "target": "Изслушай"
    },
    {
      "id": 110504452912390152,
      "target": "Стреляй"
    },
    {
      "id": 110504452912390151,
      "target": "Wolfhound: Мислиш, че никога не са насочвали оръжие към мен?"
    },
    {
      "id": 110504452912390150,
      "target": "Wolfhound: Цигарите съсипват не само онези, които не ги споделят, а и венците. Стават прекалено меки."
    },
    {
      "id": 110504452912390149,
      "target": "Извади пушката"
    },
    {
      "id": 110504452912390148,
      "target": "Пусни го"
    },
    {
      "id": 110504452912390147,
      "target": "Wolfhound: Да ти сложим ли усмирителна риза, за всеки случай?"
    },
    {
      "id": 110504452912390146,
      "target": "Wolfhound: ..."
    },
    {
      "id": 110504452912390145,
      "target": "Wolfhound: Питай ме и защо зъбите ми са толкова остри. Лудница."
    },
    {
      "id": 110504452912390144,
      "target": "Извади пушката"
    },
    {
      "id": 110504452908195849,
      "target": "Пусни го"
    },
    {
      "id": 110504452908195848,
      "target": "Wolfhound: Дай я насам. Сам ще я изхвърля."
    },
    {
      "id": 110504452908195847,
      "target": "Wolfhound: Само виж как съм излязъл! Няма да ти я оставя."
    },
    {
      "id": 110504452908195846,
      "target": "Wolfhound: ..."
    },
    {
      "id": 110504452908195845,
      "target": "Wolfhound: Разбираш ли го?"
    },
    {
      "id": 110504452908195844,
      "target": "Wolfhound: Ако после тези снимки не се окажат в кошчето, ще трябва да взема мерки."
    },
    {
      "id": 110504452908195843,
      "target": "Wolfhound: Не обичам да ме снимат."
    },
    {
      "id": 110504452908195842,
      "target": "Извади пушката"
    },
    {
      "id": 110504452908195841,
      "target": "Пусни го"
    },
    {
      "id": 110504452908195840,
      "target": "Wolfhound: Мъжът трябва да мирише естествено. Щом няма какво да крие."
    }
  ]
}
