  "entries": [
    {
      "id": 110504452052557824,
      "target": "Daughter: (Снимате момичето)"
    },
    {
      "id": 110504452048363530,
      "target": "Daughter: После ще ми покажеш ли снимката?"
    },
    {
      "id": 110504452048363529,
      "target": "Daughter: Мен рядко са ме снимали."
    },
    {
      "id": 110504452048363528,
      "target": "Daughter: Снимка?"
    },
    {
      "id": 110504452048363527,
      "target": "Daughter: Много съм уморена, може ли да постоя тук сама?"
    },
    {
      "id": 110504452048363526,
      "target": "Daughter: Просто искате да разберете как съм?"
    },
    {
      "id": 110504452048363525,
      "target": "Daughter: (Поглеждате я и разбирате, че това ви идва в повече.)"
    },
    {
      "id": 110504452048363524,
      "target": "Daughter: Какво трябва да направя?"
    },
    {
      "id": 110504452048363523,
      "target": "Daughter: А-а-аз и-и-искам во-одаааа."
    },
    {
      "id": 110504452048363522,
      "target": "Daughter: Вие … уааааа."
    },
    {
      "id": 110504452048363521,
      "target": "Daughter: Вие там ви-и-идяхте…"
    },
    {
      "id": 110504452048363520,
      "target": "Daughter: Защо ме погледнахте така?"
    },
    {
      "id": 110504452044169227,
      "target": "Daughter: ..."
    },
    {
      "id": 110504452044169226,
      "target": "Daughter: Тогава ще внимавам какво си мисля, не се тревожете."
    },
    {
      "id": 110504452044169225,
      "target": "Daughter: Там ще видите ли всичко, което си мисля?"
    },
    {
      "id": 110504452044169224,
      "target": "Daughter: А можете ли да погледнете вътре в окото?"
    },
    {
      "id": 110504452044169223,
      "target": "Daughter: Ще си вървя, искам да поседя сама."
    },
    {
      "id": 110504452044169222,
      "target": "Daughter: Аз сама си ги подрязах. Успях. Сама."
    },
    {
      "id": 110504452044169221,
      "target": "Daughter: Ето ми нокътчетата."
    },
    {
      "id": 110504452044169220,
      "target": "Daughter: ..."
    },
    {
      "id": 110504452044169219,
      "target": "Daughter: Гледайте."
    },
    {
      "id": 110504452044169218,
      "target": "Daughter: Още не мога много добре, на мен…"
    },
    {
      "id": 110504452044169217,
      "target": "Daughter: А аз вече мога сама да си режа ноктите."
    },
    {
      "id": 110504452044169216,
      "target": "Daughter: Всичко е наред, нали?"
    },
    {
      "id": 110504452039974921,
      "target": "Daughter: Какво значи това?"
    },
    {
      "id": 110504452039974920,
      "target": "Daughter: Ето моите."
    },
    {
      "id": 110504452039974919,
      "target": "Daughter: ..."
    },
    {
      "id": 110504452039974918,
      "target": "Daughter: Вече няма да плача."
    },
    {
      "id": 110504452039974917,
      "target": "Daughter: Защо? Аз още имам млечни зъбки. Татко казваше…"
    },
    {
      "id": 110504452039974916,
      "target": "Daughter: Зъби? Да ви покажа ли зъбите си?"
    },
    {
      "id": 110504452039974915,
      "target": "Уши"
    },
    {
      "id": 110504452039974914,
      "target": "Снимка"
    },
    {
      "id": 110504452039974913,
      "target": "Подмишници"
    },
    {
      "id": 110504452039974912,
      "target": "Очи"
    },
    {
      "id": 110504452035780617,
      "target": "Ръце"
    },
    {
      "id": 110504452035780616,
      "target": "Зъби"
    },
    {
      "id": 110504452035780615,
      "target": "Daughter: Какво искаш да провериш?"
    },
    {
      "id": 110504452035780614,
      "target": "Scammer: Накратко, не ти се сърдя. Честно."
    },
    {
      "id": 110504452035780613,
      "target": "Scammer: Пък и го правиш заради всички нас."
    },
    {
      "id": 110504452035780612,
      "target": "Scammer: Разбирам, разбира се, че човек се напряга заради разни Гости и други такива."
    }
  ]
}
