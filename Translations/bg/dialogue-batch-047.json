  "sourceInventorySha256": "ecd96645c2ca6f23f8bf3ab2fcf65709e961478ae15a38e83d94cc335a408bf0",
  "glossaryFingerprint": "28d7eb651d95b56a72a5a4acefcba5f434dcbe6925a2233126655e13b0e01cab",
  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504457282854912,
      "target": "StaticBoy: Нямам такива. И никога не съм имал."
    },
    {
      "id": 110504457278660618,
      "target": "StaticBoy: Родители?"
    },
    {
      "id": 110504457278660617,
      "target": "StaticBoy: …"
    },
    {
      "id": 110504457278660616,
      "target": "Да ти помогна да намериш къщата?"
    },
    {
      "id": 110504457278660615,
      "target": "Какво търсиш тук?"
    },
    {
      "id": 110504457278660614,
      "target": "StaticBoy: Чух как стъпалото изскърца – значи някой чака."
    },
    {
      "id": 110504457278660613,
      "target": "StaticBoy: Търсех светлината от кухнята, но тук… ехото е друго."
    },
    {
      "id": 110504457278660612,
      "target": "StaticBoy: …"
    },
    {
      "id": 110504457278660611,
      "target": "StaticBoy: Вратите си приличат, когато е тъмно."
    },
    {
      "id": 110504457278660610,
      "target": "Къде са родителите ти?"
    },
    {
      "id": 110504457278660609,
      "target": "Изгуби ли се?"
    },
    {
      "id": 110504457278660608,
      "target": "StaticBoy: Трябва все пак…"
    },
    {
      "id": 110504457274466315,
      "target": "StaticBoy: Той не спи ли?"
    },
    {
      "id": 110504457274466314,
      "target": "StaticBoy: …"
    },
    {
      "id": 110504457274466313,
      "target": "CultistPriest: Наглеждай хората ми. И помни: ако един умре, от къщата ти няма да остане нищо."
    },
    {
      "id": 110504457274466312,
      "target": "CultistPriest: Ще се видим по-късно, ще дойда да ги посетя."
    },
    {
      "id": 110504457274466311,
      "target": "CultistPriest: Мислиш, че имаш избор?"
    },
    {
      "id": 110504457274466310,
      "target": "CultistPriest: Ще се видим по-късно, ще дойда да ги посетя."
    },
    {
      "id": 110504457274466309,
      "target": "CultistPriest: Не им трябва много време. Но все пак наглеждай хората ми."
    },
    {
      "id": 110504457274466308,
      "target": "CultistPriest: Благодаря."
    },
    {
      "id": 110504457274466307,
      "target": "По-добре си тръгни"
    },
    {
      "id": 110504457274466306,
      "target": "Ще изгоня обитателите. Влез"
    },
    {
      "id": 110504457274466305,
      "target": "CultistPriest: Те пречат да постигнем целта си."
    },
    {
      "id": 110504457274466304,
      "target": "CultistPriest: и {0}"
    },
    {
      "id": 110504457270272010,
      "target": "CultistPriest: това ще бъде {0}"
    },
    {
      "id": 110504457270272009,
      "target": "CultistPriest: Това е много добре. Но първо трябва да изгониш своите хора:"
    },
    {
      "id": 110504457270272008,
      "target": "Courier: Хубава нощ..."
    },
    {
      "id": 110504457270272007,
      "target": "Courier: Дръж: {0}."
    },
    {
      "id": 110504457270272006,
      "target": "(Вземи поръчката)"
    },
    {
      "id": 110504457270272005,
      "target": "Courier: Добре, вземай поръчката и аз тръгвам."
    },
    {
      "id": 110504457270272004,
      "target": "Courier: …"
    },
    {
      "id": 110504457270272003,
      "target": "Courier: Омръзна ми цялата тази гадост. Просто искам всичко това най-сетне да свърши, мамка му…"
    },
    {
      "id": 110504457270272002,
      "target": "Courier: …"
    },
    {
      "id": 110504457270272001,
      "target": "Courier: Всичко това е толкова…"
    },
    {
      "id": 110504457270272000,
      "target": "Courier: Тези безкрайни сутрешни проверки с придружаващи служители на КИС с автомати…"
    },
    {
      "id": 110504457266077707,
      "target": "Courier: Постоянно виждам уморени, намръщени, озлобени лица…"
    },
    {
      "id": 110504457266077706,
      "target": "Courier: Помниш ли, че казвах как куриерската работа ми помага да се разсея? Усещам, че вече не става."
    },
    {
      "id": 110504457266077705,
      "target": "Courier: …"
    },
    {
      "id": 110504457266077704,
      "target": "Courier: Еххх…"
    },
    {
      "id": 110504457266077703,
      "target": "(Вземи поръчката)"
    }
  ]
}
