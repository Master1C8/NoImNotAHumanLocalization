    {
      "id": 110504453419900930,
      "target": "Cultist3: …"
    },
    {
      "id": 110504453419900929,
      "target": "Cultist3: Всичко важно остава в паметта."
    },
    {
      "id": 110504453419900928,
      "target": "Cultist3: Снимките нямат никакъв смисъл."
