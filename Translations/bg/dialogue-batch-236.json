  "entries": [
    {
      "id": 110504454627860487,
      "target": "Alkonost: ..."
    },
    {
      "id": 110504454627860486,
      "target": "Трябва да те проверя"
    },
    {
      "id": 110504454627860485,
      "target": "Трябва да те проверя"
    },
    {
      "id": 110504454627860484,
      "target": "Трябва да те проверя"
    },
    {
      "id": 110504454627860483,
      "target": "Трябва да те проверя"
    },
    {
      "id": 110504454627860482,
      "target": "Трябва да те проверя"
    },
    {
      "id": 110504454627860481,
      "target": "Sirin: Тогава най-сетне няма да има за какво да се тревожим, от какво да се страхуваме, да се притесняваме или срамуваме."
    },
    {
      "id": 110504454627860480,
      "target": "Sirin: Сега ще се грижа за нея, докато всички не умрем."
    },
    {
      "id": 110504454623666187,
      "target": "Sirin: Струва ми се, че съвсем е останала без сили."
    },
    {
      "id": 110504454623666186,
      "target": "Sirin: Той ѝ казваше, че всичко ще бъде наред, а после се самоуби, уплашен от истинския край."
    },
    {
      "id": 110504454623666185,
      "target": "Sirin: Да. Тя намери тялото на мъжа си."
    },
    {
      "id": 110504454623666184,
      "target": "Трябва да те проверя"
    },
    {
      "id": 110504454623666183,
      "target": "Все пак излязохте ли?"
    },
    {
      "id": 110504454623666182,
      "target": "Sirin: Това е краят."
    },
    {
      "id": 110504454623666181,
      "target": "Sirin: Не искам да я загубя, преди всички да умрем."
    },
    {
      "id": 110504454623666180,
      "target": "Sirin: Ако все пак тръгне да го търси, ще трябва и аз да отида."
    },
    {
      "id": 110504454623666179,
      "target": "Sirin: Имам чувството, че това е лоша идея. Но тя вече не може да стои спокойно."
    },
    {
      "id": 110504454623666178,
      "target": "Sirin: Да. За да спре да мисли за лошото, смята да потърси мъжа си."
    },
    {
      "id": 110504454623666177,
      "target": "Трябва да те проверя"
    },
    {
      "id": 110504454623666176,
      "target": "Сестра ти не е добре?"
    },
    {
      "id": 110504454619471884,
      "target": "Sirin: Това е краят."
    },
    {
      "id": 110504454619471883,
      "target": "Sirin: Но сестра ми много се плаши от това."
    },
    {
      "id": 110504454619471882,
      "target": "Sirin: Ако планетата изчезне, няма да има кой да скърби за нас. А и няма нужда."
    },
    {
      "id": 110504454619471881,
      "target": "Sirin: Никому не сме нужни, защото вече няма никого."
    },
    {
      "id": 110504454619471880,
      "target": "Sirin: В една безкрайно развиваща се Вселена ние сме никои."
    },
    {
      "id": 110504454619471879,
      "target": "Sirin: Струва ми се, че няма какво да губим."
    },
    {
      "id": 110504454619471878,
      "target": "Sirin: Тя се страхува да не загуби всичко."
    },
    {
      "id": 110504454619471877,
      "target": "Трябва да те проверя"
    },
    {
      "id": 110504454619471876,
      "target": "Как е сестра ти?"
    },
    {
      "id": 110504454619471875,
      "target": "Sirin: Това е краят."
    },
    {
      "id": 110504454619471874,
      "target": "Sirin: Интересно е да се замисли човек за това."
    },
    {
      "id": 110504454619471873,
      "target": "Sirin: Няма да остане дори следа, че сме съществували?"
    },
    {
      "id": 110504454619471872,
      "target": "Sirin: Значи това е краят?"
    },
    {
      "id": 110504454615277578,
      "target": "Sirin: Едва тази нощ научих за това."
    },
    {
      "id": 110504454615277577,
      "target": "Sirin: Ти знаеше ли за слънцето? То избухва ли?"
    },
    {
      "id": 110504454615277576,
      "target": "Sirin: Така е."
    },
    {
      "id": 110504454615277575,
      "target": "Трябва да те проверя"
    },
    {
      "id": 110504454615277574,
      "target": "Днес изглеждаш по-бодра"
    },
    {
      "id": 110504454615277573,
      "target": "Sirin: Това е краят."
    },
    {
      "id": 110504454615277572,
      "target": "Sirin: Аз… не искам."
    }
  ]
}
