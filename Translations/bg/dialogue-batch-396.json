  "sourceInventorySha256": "ecd96645c2ca6f23f8bf3ab2fcf65709e961478ae15a38e83d94cc335a408bf0",
  "glossaryFingerprint": "28d7eb651d95b56a72a5a4acefcba5f434dcbe6925a2233126655e13b0e01cab",
  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504451842842625,
      "target": "Anger: Баба казваше, че са го сложили, когато старият изгнил."
    },
    {
      "id": 110504451842842624,
      "target": "Anger: Блестеше така, сякаш слънцето беше заседнало в устата ѝ."
    },
    {
      "id": 110504451838648329,
      "target": "Anger: Баба ми имаше златен зъб. Още като хлапе разбрах, че искам такъв."
    },
    {
      "id": 110504451838648328,
      "target": "Anger: Майната ти тогава."
    },
    {
      "id": 110504451838648327,
      "target": "Anger: А ти, мамка му, си напълно безчувствен задник."
    },
    {
      "id": 110504451838648326,
      "target": "Изслушай"
    },
    {
      "id": 110504451838648325,
      "target": "Стреляй"
    },
    {
      "id": 110504451838648324,
      "target": "Anger: Ама ти си шибано болен в главата. Ела тук, копеле!"
    },
    {
      "id": 110504451838648323,
      "target": "Anger: Накрая и заради ушите ще вземеш да ме застреляш случайно."
    },
    {
      "id": 110504451838648322,
      "target": "Anger: По-внимателно размахвай тази своя пушка."
    },
    {
      "id": 110504451838648321,
      "target": "Изслушай"
    },
    {
      "id": 110504451838648320,
      "target": "Стреляй"
    },
    {
      "id": 110504451834454025,
      "target": "Anger: Ти, копеле, искаш да ме застреляш заради една шибана снимка?"
    },
    {
      "id": 110504451834454024,
      "target": "Изслушай"
    },
    {
      "id": 110504451834454023,
      "target": "Стреляй"
    },
    {
      "id": 110504451834454022,
      "target": "Anger: Не мога да повярвам. Ти си просто шибан откачалник!.."
    },
    {
      "id": 110504451834454021,
      "target": "Anger: Като се разчеша до кръв, сърбежът утихва."
    },
    {
      "id": 110504451834454020,
      "target": "Anger: Постоянно сърби, сякаш ме подтиква към нещо."
    },
    {
      "id": 110504451834454019,
      "target": "Изслушай"
    },
    {
      "id": 110504451834454018,
      "target": "Стреляй"
    },
    {
      "id": 110504451834454017,
      "target": "Anger: Какво, мамка му, намекваш? Да не ми завиждаш?"
    },
    {
      "id": 110504451834454016,
      "target": "Изслушай"
    },
    {
      "id": 110504451830259720,
      "target": "Стреляй"
    },
    {
      "id": 110504451830259719,
      "target": "Anger: Ти, копеле, мислиш, че с тая лапа няма да ти забия един в мутрата, преди да натиснеш спусъка?"
    },
    {
      "id": 110504451830259718,
      "target": "Изслушай"
    },
    {
      "id": 110504451830259717,
      "target": "Стреляй"
    },
    {
      "id": 110504451830259716,
      "target": "Anger: Да не си откачил, мамка му? Само ти показах зъбите си."
    },
    {
      "id": 110504451830259715,
      "target": "Извади пушката"
    },
    {
      "id": 110504451830259714,
      "target": "Пусни го"
    },
    {
      "id": 110504451830259713,
      "target": "Anger: Защо си се втренчил така? Нещо ли липсва?"
    },
    {
      "id": 110504451830259712,
      "target": "Anger: Мамка му…"
    },
    {
      "id": 110504451826065417,
      "target": "Извади пушката"
    },
    {
      "id": 110504451826065416,
      "target": "Пусни го"
    },
    {
      "id": 110504451826065415,
      "target": "Anger: Какво? Защо си се втренчил така в мен? Какво видя там?"
    },
    {
      "id": 110504451826065414,
      "target": "Anger: Давай, снимай, мамка му."
    },
    {
      "id": 110504451826065413,
      "target": "Извади пушката"
    },
    {
      "id": 110504451826065412,
      "target": "Пусни го"
    },
    {
      "id": 110504451826065411,
      "target": "Anger: Бесен съм, когато оставят космите под мишниците, сякаш ще отглеждат шибани храсти там."
    },
    {
      "id": 110504451826065410,
      "target": "Anger: Да, бръсна ги."
    },
    {
      "id": 110504451826065409,
      "target": "Anger: През кура ми е."
    }
  ]
}
