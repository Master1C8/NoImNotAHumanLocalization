    {
      "id": 110504455575773195,
      "target": "Player: (Изглежда, обитателят вече си е казал всичко и не е настроен да разговаря с вас)"
    },
    {
      "id": 110504455575773194,
      "target": "Jacob: Благодаря ти, безсмъртнико."
    },
    {
      "id": 110504455575773193,
      "target": "Jacob: Трябва да потърся дъщеря си."
    },
    {
      "id": 110504455575773192,
      "target": "Jacob: Не мога повече да оставам тук."
    },
    {
      "id": 110504455575773191,
      "target": "Jacob: …"
    },
    {
      "id": 110504455575773190,
      "target": "Jacob: Те са се родили тук!"
    },
    {
      "id": 110504455575773189,
      "target": "Jacob: Те са същите твари като нас двамата."
    },
    {
      "id": 110504455575773188,
      "target": "Jacob: Гостите не са пришълци, както смятат мнозина."
    },
    {
      "id": 110504455575773187,
      "target": "Jacob: КИС…"
    },
    {
      "id": 110504455575773186,
      "target": "Jacob: Но знам със сигурност кой го допусна."
    },
    {
      "id": 110504455575773185,
      "target": "Jacob: За съжаление, не знам как са проникнали в града…"
    },
    {
      "id": 110504455575773184,
      "target": "Jacob: Това са същите демони, за които всички говореха преди две години."
    }
  ]
}
