  "entries": [
    {
      "id": 110504456347525128,
      "target": "NotTrue: Дори ти. Сигурно си седиш у дома, но все пак ходиш."
    },
    {
      "id": 110504456347525127,
      "target": "NotTrue: Дали е отдавна — не мога да кажа. Пък и как се разбира кое е отдавна?"
    },
    {
      "id": 110504456347525126,
      "target": "Тогава защо не продължихте? Защо спряхте?"
    },
    {
      "id": 110504456347525125,
      "target": "Не разбирам, трябва ли ви нещо?"
    },
    {
      "id": 110504456347525124,
      "target": "NotTrue: Сигурно така трябва."
    },
    {
      "id": 110504456347525123,
      "target": "NotTrue: Щом съм дошла тук, значи краката и очите са ме довели."
    },
    {
      "id": 110504456347525122,
      "target": "NotTrue: С когото трябва, животът сам ще ни срещне. Няма да пропуснем никого."
    },
    {
      "id": 110504456347525121,
      "target": "NotTrue: Е, не точно тук, разбира се, ха-ха."
    },
    {
      "id": 110504456347525120,
      "target": "Дълго ли вървяхте?"
    },
    {
      "id": 110504456343330827,
      "target": "Направо насам ли идвахте?"
    },
    {
      "id": 110504456343330826,
      "target": "NotTrue: Може ли да си почина у теб?"
    },
    {
      "id": 110504456343330825,
      "target": "NotTrue: Здравей, миличък! Уморих се да вървя дотук."
    },
    {
      "id": 110504456343330824,
      "target": "SuperFake: Аз ще отворя."
    },
    {
      "id": 110504456343330823,
      "target": "SuperFake: Исках да проверя дали ще излъжеш."
    },
    {
      "id": 110504456343330822,
      "target": "SuperFake: Ясно ми е, че си сам."
    },
    {
      "id": 110504456343330821,
      "target": "SuperFake: Хахахахаха."
    },
    {
      "id": 110504456343330820,
      "target": "SuperFake: Но кой знае какво ще стане след няколко дни?"
    },
    {
      "id": 110504456343330819,
      "target": "SuperFake: Чувам някого да шепне в стаите ти."
    },
    {
      "id": 110504456343330818,
      "target": "SuperFake: Днес имаш късмет."
    },
    {
      "id": 110504456343330817,
      "target": "Сам съм"
    },
    {
      "id": 110504456343330816,
      "target": "Не съм сам"
    },
    {
      "id": 110504456339136523,
      "target": "SuperFake: Сам ли си вкъщи?"
    },
    {
      "id": 110504456339136522,
      "target": "SuperFake: Но кажи ми…"
    },
    {
      "id": 110504456339136521,
      "target": "SuperFake: „Всичко, което съвестта ми остави, бих изял дори със зъби“, нали?"
    },
    {
      "id": 110504456339136520,
      "target": "SuperFake: Чудесно!"
    },
    {
      "id": 110504456339136519,
      "target": "Сам съм"
    },
    {
      "id": 110504456339136518,
      "target": "Не съм сам"
    },
    {
      "id": 110504456339136517,
      "target": "SuperFake: Сам ли си вкъщи?"
    },
    {
      "id": 110504456339136516,
      "target": "SuperFake: Слуууушай…"
    },
    {
      "id": 110504456339136515,
      "target": "SuperFake: Да-да, разбирам."
    },
    {
      "id": 110504456339136514,
      "target": "Имам пушка"
    },
    {
      "id": 110504456339136513,
      "target": "Нищо не ми трябва"
    },
    {
      "id": 110504456339136512,
      "target": "SuperFake: Сам разбираш."
    },
    {
      "id": 110504456334942217,
      "target": "SuperFake: Човек никога не знае."
    },
    {
      "id": 110504456334942216,
      "target": "SuperFake: Здрава ли е вратата ти?"
    },
    {
      "id": 110504456334942215,
      "target": "Имам пушка"
    },
    {
      "id": 110504456334942214,
      "target": "Нищо не ми трябва"
    },
    {
      "id": 110504456334942213,
      "target": "SuperFake: Харесва ми."
    },
    {
      "id": 110504456334942212,
      "target": "SuperFake: Просторна къща."
    },
    {
      "id": 110504456334942211,
      "target": "SuperFake: …"
    }
  ]
