  "entries": [
    {
      "id": 110504453839331338,
      "target": "Rocker: Сега ушите ми просто са раздрани."
    },
    {
      "id": 110504453839331337,
      "target": "Rocker: ..."
    },
    {
      "id": 110504453839331336,
      "target": "Rocker: Правих си тунели в ушите. После… мамка му, просто ми писна."
    },
    {
      "id": 110504453839331335,
      "target": "Извади пушката"
    },
    {
      "id": 110504453839331334,
      "target": "Пусни го"
    },
    {
      "id": 110504453839331333,
      "target": "Rocker: Поне да беше свалил капачката на фотоапарата."
    },
    {
      "id": 110504453839331332,
      "target": "Rocker: Охо."
    },
    {
      "id": 110504453839331331,
      "target": "Rocker: ..."
    },
    {
      "id": 110504453839331330,
      "target": "Rocker: Хайде, поне с теб да се снимам."
    },
    {
      "id": 110504453839331329,
      "target": "Извади пушката"
    },
    {
      "id": 110504453839331328,
      "target": "Пусни го"
    },
    {
      "id": 110504453835137035,
      "target": "Rocker: Има ли нещо интересно?"
    },
    {
      "id": 110504453835137034,
      "target": "Rocker: ..."
    },
    {
      "id": 110504453835137033,
      "target": "Rocker: Това може."
    },
    {
      "id": 110504453835137032,
      "target": "Извади пушката"
    },
    {
      "id": 110504453835137031,
      "target": "Пусни го"
    },
    {
      "id": 110504453835137030,
      "target": "Rocker: И аз бих искал такива…"
    },
    {
      "id": 110504453835137029,
      "target": "Rocker: Пичът ослепя напълно. Но да беше видял очите му."
    },
    {
      "id": 110504453835137028,
      "target": "Rocker: Не на мен."
    },
    {
      "id": 110504453835137027,
      "target": "Rocker: ..."
    },
    {
      "id": 110504453835137026,
      "target": "Unstable: Още си спомням онази случка с тресенето."
    },
    {
      "id": 110504453835137025,
      "target": "Rocker: Веднъж ни хрумна да си инжектираме мастило направо в очите."
    },
    {
      "id": 110504453835137024,
      "target": "Извади пушката"
    },
    {
      "id": 110504453830942731,
      "target": "Пусни го"
    },
    {
      "id": 110504453830942730,
      "target": "Rocker: Вече не помня…"
    },
    {
      "id": 110504453830942729,
      "target": "Rocker: Или пък не е татуировка."
    },
    {
      "id": 110504453830942728,
      "target": "Rocker: Чакай."
    },
    {
      "id": 110504453830942727,
      "target": "Rocker: Направихме я на голям запой. Майсторът се беше натряскал за кеф, аз — за кураж."
    },
    {
      "id": 110504453830942726,
      "target": "Rocker: ..."
    },
    {
      "id": 110504453830942725,
      "target": "Rocker: Имам една татуировка."
    },
    {
      "id": 110504453830942724,
      "target": "Извади пушката"
    },
    {
      "id": 110504453830942723,
      "target": "Пусни го"
    },
    {
      "id": 110504453830942722,
      "target": "Rocker: А това е всичко, което ми остана от приятелите. Налепът по зъбите."
    },
    {
      "id": 110504453830942721,
      "target": "Rocker: ..."
    },
    {
      "id": 110504453830942720,
      "target": "Rocker: Само си помисли…"
    },
    {
      "id": 110504453826748427,
      "target": "Rocker: Да-а-а, колко гъст дим са попили тези зъби."
    },
    {
      "id": 110504453826748426,
      "target": "Уши"
    },
    {
      "id": 110504453826748425,
      "target": "Снимка"
    },
    {
      "id": 110504453826748424,
      "target": "Подмишници"
    },
    {
      "id": 110504453826748423,
      "target": "Очи"
    }
  ]
}
