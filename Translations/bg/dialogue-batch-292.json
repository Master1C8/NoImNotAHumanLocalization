  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504453814165505,
      "target": "Изслушай"
    },
    {
      "id": 110504453814165504,
      "target": "Стреляй"
    },
    {
      "id": 110504453809971211,
      "target": "Unstable: Или гърчовете вече са някакъв нов признак?"
    },
    {
      "id": 110504453809971210,
      "target": "Unstable: Няма да стреляш, нали?"
    },
    {
      "id": 110504453809971209,
      "target": "Unstable: Е, улучи точния момент, няма що."
    },
    {
      "id": 110504453809971208,
      "target": "Изслушай"
    },
    {
      "id": 110504453809971207,
      "target": "Стреляй"
    },
    {
      "id": 110504453809971206,
      "target": "Unstable: А аз, честно казано, мислех малко да си почина от насилието тук."
    },
    {
      "id": 110504453809971205,
      "target": "Unstable: А аз мислех, че няма да добавяш още насилие към всичкото, което вече ни заобикаля."
    },
    {
      "id": 110504453809971204,
      "target": "Unstable: Я виж ти."
    },
    {
      "id": 110504453809971203,
      "target": "Извади пушката"
    },
    {
      "id": 110504453809971202,
      "target": "Пусни го"
    },
    {
      "id": 110504453809971201,
      "target": "Unstable: Или какво?"
    },
    {
      "id": 110504453809971200,
      "target": "Unstable: Трябваше ли да ги почистя?"
    },
    {
      "id": 110504453805776907,
      "target": "Unstable: ..."
    },
    {
      "id": 110504453805776906,
      "target": "Unstable: Хайде, защо пък не."
    },
    {
      "id": 110504453805776905,
      "target": "Извади пушката"
    },
    {
      "id": 110504453805776904,
      "target": "Пусни го"
    },
    {
      "id": 110504453805776903,
      "target": "Unstable: За мен няма да ти стигнат енергийните напитки."
    },
    {
      "id": 110504453805776902,
      "target": "Unstable: Да, сърцето ми блъска като лудо."
    },
    {
      "id": 110504453805776901,
      "target": "Unstable: ..."
    },
    {
      "id": 110504453805776900,
      "target": "Unstable: Сега не се правят много купони. Или просто мен не ме канят."
    },
    {
      "id": 110504453805776899,
      "target": "Unstable: Снимаха ме само по купони."
    },
    {
      "id": 110504453805776898,
      "target": "Извади пушката"
    },
    {
      "id": 110504453805776897,
      "target": "Пусни го"
    },
    {
      "id": 110504453805776896,
      "target": "Unstable: Яко."
    },
    {
      "id": 110504453801582603,
      "target": "Unstable: Просто. Обикновени. Подмишници."
    },
    {
      "id": 110504453801582602,
      "target": "Unstable: Нито някакъв особен цвят, нито мръсотия, нито други глупости."
    },
    {
      "id": 110504453801582601,
      "target": "Unstable: ..."
    },
    {
      "id": 110504453801582600,
      "target": "Unstable: Ето, единственият нормален признак."
    },
    {
      "id": 110504453801582599,
      "target": "Извади пушката"
    },
    {
      "id": 110504453801582598,
      "target": "Пусни го"
    },
    {
      "id": 110504453801582597,
      "target": "Unstable: А защо по телевизията показваха зелени?"
    },
    {
      "id": 110504453801582596,
      "target": "Unstable: А защо по телевизията показваха зелени? А моите какви са?"
    },
    {
      "id": 110504453801582595,
      "target": "Unstable: ТРЯБВА ДА СА ЧЕРВЕНИ ЛИ?"
    },
    {
      "id": 110504453801582594,
      "target": "Unstable: Чакай, какво не е наред?"
    },
    {
      "id": 110504453801582593,
      "target": "Unstable: ..."
    },
    {
      "id": 110504453801582592,
      "target": "Unstable: Само не ги объркай — по света има много зелено."
    },
    {
      "id": 110504453797388298,
      "target": "Unstable: И аз гледах репортажа. Там казаха, че очите трябва да са тъмнозелени."
    },
    {
      "id": 110504453797388297,
      "target": "Извади пушката"
    }
  ]
}
