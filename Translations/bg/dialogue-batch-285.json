  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504453914828801,
      "target": "Jacket: Чакайте, какво не е наред с ушите ми?"
    },
    {
      "id": 110504453914828800,
      "target": "Изслушай"
    },
    {
      "id": 110504453910634506,
      "target": "Стреляй"
    },
    {
      "id": 110504453910634505,
      "target": "Jacket: Има ли нещо върху аурата ми?"
    },
    {
      "id": 110504453910634504,
      "target": "Jacket: Чакайте, чакайте! Какво не е наред?"
    },
    {
      "id": 110504453910634503,
      "target": "Изслушай"
    },
    {
      "id": 110504453910634502,
      "target": "Стреляй"
    },
    {
      "id": 110504453910634501,
      "target": "Jacket: ПО ДЯВОЛИТЕ, ПО ДЯВОЛИТЕ, ПО ДЯВОЛИТЕ!!!"
    },
    {
      "id": 110504453910634500,
      "target": "Jacket: Проклятие, наистина ли съм Гост?!"
    },
    {
      "id": 110504453910634499,
      "target": "Изслушай"
    },
    {
      "id": 110504453910634498,
      "target": "Стреляй"
    },
    {
      "id": 110504453910634497,
      "target": "Jacket: Но очите ми не са червени!"
    },
    {
      "id": 110504453910634496,
      "target": "Jacket: Какво?! Аз съм Гост?"
    },
    {
      "id": 110504453906440202,
      "target": "Изслушай"
    },
    {
      "id": 110504453906440201,
      "target": "Стреляй"
    },
    {
      "id": 110504453906440200,
      "target": "Jacket: НЕ СЪМ ГОСТ, НЕ СТРЕЛЯЙТЕ!!!"
    },
    {
      "id": 110504453906440199,
      "target": "Jacket: Чакайте, но нямам нищо по ръцете!"
    },
    {
      "id": 110504453906440198,
      "target": "Jacket: Чакайте, нали обясних, че раздразнението е от якето!"
    },
    {
      "id": 110504453906440197,
      "target": "Изслушай"
    },
    {
      "id": 110504453906440196,
      "target": "Стреляй"
    },
    {
      "id": 110504453906440195,
      "target": "Jacket: НЕ СТРЕЛЯЙТЕ, МОЛЯ ВИ!!!"
    },
    {
      "id": 110504453906440194,
      "target": "Jacket: Аз съм Гост?! Но зъбите ми са криви…"
    },
    {
      "id": 110504453906440193,
      "target": "Извади пушката"
    },
    {
      "id": 110504453906440192,
      "target": "Пусни го"
    },
    {
      "id": 110504453902245899,
      "target": "Jacket: Е, всичко наред ли е?"
    },
    {
      "id": 110504453902245898,
      "target": "Jacket: ..."
    },
    {
      "id": 110504453902245897,
      "target": "Jacket: Макар че, признавам, не знам съвсем точно кои са признаците. Може би само аз не съм в течение."
    },
    {
      "id": 110504453902245896,
      "target": "Jacket: Ушите нали не са обявявани за признак."
    },
    {
      "id": 110504453902245895,
      "target": "Jacket: …"
    },
    {
      "id": 110504453902245894,
      "target": "Извади пушката"
    },
    {
      "id": 110504453902245893,
      "target": "Пусни го"
    },
    {
      "id": 110504453902245892,
      "target": "Jacket: Честно казано, по вас не личи да вярвате в нещо подобно."
    },
    {
      "id": 110504453902245891,
      "target": "Jacket: Я виж! Това фотоапаратът от рекламата на „Фотолента за аура“ ли е?"
    },
    {
      "id": 110504453902245890,
      "target": "Jacket: ..."
    },
    {
      "id": 110504453902245889,
      "target": "Jacket: Нямам нищо против да ме снимате. Само че… фотоапаратът ви е странен."
    },
    {
      "id": 110504453902245888,
      "target": "Извади пушката"
    },
    {
      "id": 110504453898051595,
      "target": "Пусни го"
    },
    {
      "id": 110504453898051594,
      "target": "Jacket: Но е от якето — потя се в него, а няма къде да се изкъпя."
    },
    {
      "id": 110504453898051593,
      "target": "Jacket: Знам, че кожното раздразнение е признак на Гост."
    },
    {
      "id": 110504453898051592,
      "target": "Jacket: ..."
    }
  ]
}
