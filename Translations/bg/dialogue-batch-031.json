  "entries": [
    {
      "id": 110504457509347338,
      "target": "Tourist: Е, добре… Много жалко."
    },
    {
      "id": 110504457509347337,
      "target": "Tourist: Много Ви благодаря."
    },
    {
      "id": 110504457509347336,
      "target": "По-добре си тръгни"
    },
    {
      "id": 110504457509347335,
      "target": "Ще изгоня обитателя. Влез"
    },
    {
      "id": 110504457509347334,
      "target": "Tourist: Тук е {0}. Не съм сигурен, че ще се разбираме."
    },
    {
      "id": 110504457509347333,
      "target": "Tourist: Извинете, уважаеми, но се опасявам, че засега не мога да вляза."
    },
    {
      "id": 110504457509347332,
      "target": "Не вземам подкупи"
    },
    {
      "id": 110504457509347331,
      "target": "Добре, влизай"
    },
    {
      "id": 110504457509347330,
      "target": "Alt: Сега разбрахме ли се?"
    },
    {
      "id": 110504457509347329,
      "target": "Alt: Добре. {0} става ли?"
    },
    {
      "id": 110504457509347328,
      "target": "Alt: Свикнала съм с такъв подход. И разбирам накъде биеш."
    },
    {
      "id": 110504457505153033,
      "target": "Alt: Жалко, че на задниците им върви."
    },
    {
      "id": 110504457505153032,
      "target": "Alt: Още има време, ще намеря друг вариант."
    },
    {
      "id": 110504457505153031,
      "target": "Alt: Е, добре."
    },
    {
      "id": 110504457505153030,
      "target": "Alt: Благодаря. Не го очаквах, но много се надявах."
    },
    {
      "id": 110504457505153029,
      "target": "По-добре си тръгни"
    },
    {
      "id": 110504457505153028,
      "target": "Ще изгоня обитателя. Влез"
    },
    {
      "id": 110504457505153027,
      "target": "Alt: Но няма да ни видиш заедно."
    },
    {
      "id": 110504457505153026,
      "target": "Alt: Дълга история е и определено не съм готова да изсипя всичко тук."
    },
    {
      "id": 110504457505153025,
      "target": "Alt: Я виж, {0} е тук."
    },
    {
      "id": 110504457505153024,
      "target": "Не вземам подкупи"
    },
    {
      "id": 110504457500958729,
      "target": "Добре, влизай"
    },
    {
      "id": 110504457500958728,
      "target": "FunnyGuy: Ще се разберем ли?"
    },
    {
      "id": 110504457500958727,
      "target": "FunnyGuy: О, намерих ето това — {0}."
    },
    {
      "id": 110504457500958726,
      "target": "FunnyGuy: …"
    },
    {
      "id": 110504457500958725,
      "target": "FunnyGuy: Нека ти дам… какво имам тук?"
    },
    {
      "id": 110504457500958724,
      "target": "FunnyGuy: Добре. За последен път се хващам на това."
    },
    {
      "id": 110504457500958723,
      "target": "FunnyGuy: Напомняш ми за същите тези банки. Мамка му."
    },
    {
      "id": 110504457500958722,
      "target": "FunnyGuy: Е, аз ще тръгвам. Все още мога да намеря нещо преди изгрев."
    },
    {
      "id": 110504457500958721,
      "target": "FunnyGuy: Ясно. Разбрах те."
    },
    {
      "id": 110504457500958720,
      "target": "FunnyGuy: Да отпразнуваме края на ипотеката ми, а? Хахахаха!"
    },
    {
      "id": 110504457496764421,
      "target": "FunnyGuy: Така вече може!"
    },
    {
      "id": 110504457496764420,
      "target": "По-добре си тръгни"
    }
  ]
}
