  "entries": [
    {
      "id": 110504453931606016,
      "target": "Tough: ..."
    },
    {
      "id": 110504453927411723,
      "target": "Tough: Не ми казват такива неща. Но на мен ми е приятно да го мисля."
    },
    {
      "id": 110504453927411722,
      "target": "Tough: Харесва ми да се чувствам красива."
    },
    {
      "id": 110504453927411721,
      "target": "Извади пушката"
    },
    {
      "id": 110504453927411720,
      "target": "Пусни я"
    },
    {
      "id": 110504453927411719,
      "target": "Tough: Ако поискам, мога и да ги изтръгна на някое копеле."
    },
    {
      "id": 110504453927411718,
      "target": "Tough: ..."
    },
    {
      "id": 110504453927411717,
      "target": "Tough: Подиграваха ми се. Но вече не."
    },
    {
      "id": 110504453927411716,
      "target": "Tough: От дете кучешките ми зъби стърчат в различни посоки."
    },
    {
      "id": 110504453927411715,
      "target": "Уши"
    },
    {
      "id": 110504453927411714,
      "target": "Снимка"
    },
    {
      "id": 110504453927411713,
      "target": "Подмишници"
    },
    {
      "id": 110504453927411712,
      "target": "Очи"
    },
    {
      "id": 110504453923217419,
      "target": "Ръце"
    },
    {
      "id": 110504453923217418,
      "target": "Зъби"
    },
    {
      "id": 110504453923217417,
      "target": "Tough: Няма да позволя да ме тормозят."
    },
    {
      "id": 110504453923217416,
      "target": "Jacket: Съжалявам…"
    },
    {
      "id": 110504453923217415,
      "target": "Jacket: Мамо, татко, простете ми."
    },
    {
      "id": 110504453923217414,
      "target": "Jacket: Защо тогава извадихте пушката? ЗАЩО, ПО ДЯВОЛИТЕ!?"
    },
    {
      "id": 110504453923217413,
      "target": "Jacket: …"
    },
    {
      "id": 110504453923217412,
      "target": "Jacket: Значи не съм Гост?"
    },
    {
      "id": 110504453923217411,
      "target": "Jacket: Странна работа е тази камера за аура…"
    },
    {
      "id": 110504453923217410,
      "target": "Jacket: Уф, страхувах се, че там ще има много петна."
    },
    {
      "id": 110504453923217409,
      "target": "Jacket: Взехте шарката на якето ми върху снимката на аурата за признак на Гост?"
    },
    {
      "id": 110504453923217408,
      "target": "Jacket: Ако се колебаете и още не сте решили кой стои пред вас, може би не бива да вадите пушката и да плашите човека до насране?"
    },
    {
      "id": 110504453919023114,
      "target": "Jacket: Благодаря, че не натиснахте спусъка, но…"
    },
    {
      "id": 110504453919023113,
      "target": "Jacket: …"
    },
    {
      "id": 110504453919023112,
      "target": "Jacket: Размислихте ли да ме убиете?"
    },
    {
      "id": 110504453919023111,
      "target": "Jacket: Признавам, дори не знаех, че това е признак."
    },
    {
      "id": 110504453919023110,
      "target": "Jacket: …"
    },
    {
      "id": 110504453919023109,
      "target": "Jacket: Шарещата зеница е признак на Гост?"
    },
    {
      "id": 110504453919023108,
      "target": "Jacket: Чакайте…"
    },
    {
      "id": 110504453919023107,
      "target": "Jacket: Какво беше признакът!? Защо извадихте…"
    },
    {
      "id": 110504453919023106,
      "target": "Jacket: Сърцето ми слезе в петите. Защо направихте това?"
    },
    {
      "id": 110504453919023105,
      "target": "Jacket: Нарочно ли го направихте?!"
    },
    {
      "id": 110504453919023104,
      "target": "Jacket: Целият ми живот мина пред очите."
    },
    {
      "id": 110504453914828805,
      "target": "Jacket: Благодаря, че не стреляхте."
    },
    {
      "id": 110504453914828804,
      "target": "Изслушай"
    },
    {
      "id": 110504453914828803,
      "target": "Стреляй"
    },
    {
      "id": 110504453914828802,
      "target": "Jacket: Какво има там?"
    }
  ]
}
