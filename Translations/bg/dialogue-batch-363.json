  "entries": [
    {
      "id": 110504452341964800,
      "target": "Buddy: Няма какво да гледаш тук, честна дума. Дебели, космати, пък и с някаква гъбичка. Сигурно я прихванах, докато спях на пода с кучето."
    },
    {
      "id": 110504452337770507,
      "target": "Buddy: ..."
    },
    {
      "id": 110504452337770506,
      "target": "Buddy: Уф, приятелю, сигурен ли си? Добре тогава."
    },
    {
      "id": 110504452337770505,
      "target": "Извади пушката"
    },
    {
      "id": 110504452337770504,
      "target": "Пусни го"
    },
    {
      "id": 110504452337770503,
      "target": "Buddy: Обикновени, кафяви. Като на половината свят. Няма никаква тайна."
    },
    {
      "id": 110504452337770502,
      "target": "Buddy: ..."
    },
    {
      "id": 110504452337770501,
      "target": "Buddy: Гледай, гледай."
    },
    {
      "id": 110504452337770500,
      "target": "Извади пушката"
    },
    {
      "id": 110504452337770499,
      "target": "Пусни го"
    },
    {
      "id": 110504452337770498,
      "target": "Buddy: А аз отварям бутилки с тях. Такъв е животът."
    },
    {
      "id": 110504452337770497,
      "target": "Buddy: А аз отварям бутилки с тях и чупя неща от отчаяние. Такъв е животът."
    },
    {
      "id": 110504452337770496,
      "target": "Buddy: Големи са, нали? Такива ръце трябва да месят хляб или да строят къща…"
    },
    {
      "id": 110504452333576202,
      "target": "Buddy: ..."
    },
    {
      "id": 110504452333576201,
      "target": "Buddy: Ето ги, гледай."
    },
    {
      "id": 110504452333576200,
      "target": "Извади пушката"
    },
    {
      "id": 110504452333576199,
      "target": "Пусни го"
    },
    {
      "id": 110504452333576198,
      "target": "Buddy: Животът, знаеш ли, понякога е безмилостен."
    },
    {
      "id": 110504452333576197,
      "target": "Buddy: Е, да кажем, че част от тази половина е изгубила и малкото приличен вид, който е имала."
    },
    {
      "id": 110504452333576196,
      "target": "Buddy: Виждаш ли? Половината са като от картинка, едни такива белички. Останалите…"
    },
    {
      "id": 110504452333576195,
      "target": "Buddy: ..."
    },
    {
      "id": 110504452333576194,
      "target": "Buddy: Аха, гледай."
    },
    {
      "id": 110504452333576193,
      "target": "Уши"
    },
    {
      "id": 110504452333576192,
      "target": "Снимка"
    },
    {
      "id": 110504452329381899,
      "target": "Подмишници"
    },
    {
      "id": 110504452329381898,
      "target": "Очи"
    },
    {
      "id": 110504452329381897,
      "target": "Ръце"
    },
    {
      "id": 110504452329381896,
      "target": "Зъби"
    },
    {
      "id": 110504452329381895,
      "target": "Buddy: Мен ли? Разбира се, приятелю. Няма какво да крия, пък и защо да го правя."
    },
    {
      "id": 110504452329381894,
      "target": "Bestson: Прости ми, мамо…"
    },
    {
      "id": 110504452329381893,
      "target": "Bestson: Май пак развалих всичко."
    },
    {
      "id": 110504452329381892,
      "target": "Bestson: Сякаш дори не съществувам."
    },
    {
      "id": 110504452329381891,
      "target": "Bestson: Времето минава покрай мен и се чувствам толкова…"
    },
    {
      "id": 110504452329381890,
      "target": "Bestson: Но няма нищо."
    },
    {
      "id": 110504452329381889,
      "target": "Bestson: Че ще чуя гласовете им, стъпките им в коридора…"
    },
    {
      "id": 110504452329381888,
      "target": "Bestson: Дълго чаках да почукат на вратата…"
    },
    {
      "id": 110504452325187594,
      "target": "Bestson: Може би съм се променил и те дори не биха ме познали…"
    },
    {
      "id": 110504452325187593,
      "target": "Bestson: Но ако моята аура е различна от тази на родителите ми… може би вече не съм същият?"
    },
    {
      "id": 110504452325187592,
      "target": "Bestson: Не знам, честно… Никога не съм виждал такива неща."
    },
    {
      "id": 110504452325187591,
      "target": "Bestson: Аурата наистина ли означава нещо?"
    }
  ]
}
