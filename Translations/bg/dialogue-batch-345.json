  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504452610400266,
      "target": "Luka: Ето, погледни."
    },
    {
      "id": 110504452610400265,
      "target": "Уши"
    },
    {
      "id": 110504452610400264,
      "target": "Снимка"
    },
    {
      "id": 110504452610400263,
      "target": "Подмишници"
    },
    {
      "id": 110504452610400262,
      "target": "Очи"
    },
    {
      "id": 110504452610400261,
      "target": "Ръце"
    },
    {
      "id": 110504452610400260,
      "target": "Зъби"
    },
    {
      "id": 110504452610400259,
      "target": "Luka: Провери, ако това ще ти помогне."
    },
    {
      "id": 110504452610400258,
      "target": "BigLebowski: Благодаря ти…"
    },
    {
      "id": 110504452610400257,
      "target": "BigLebowski: Хах, мислех, че сама ще го направя със себе си…"
    },
    {
      "id": 110504452610400256,
      "target": "BigLebowski: Аааа, майната му…"
    },
    {
      "id": 110504452606205963,
      "target": "BigLebowski: Защо вземат такова решение вместо тях?.."
    },
    {
      "id": 110504452606205962,
      "target": "BigLebowski: А ако те не го искат?"
    },
    {
      "id": 110504452606205961,
      "target": "BigLebowski: Не разбирам защо някои родители пробиват ушите на едногодишните си дъщери."
    },
    {
      "id": 110504452606205960,
      "target": "BigLebowski: А, да, сложиха ми и онези тъпи брекети…"
    },
    {
      "id": 110504452606205959,
      "target": "BigLebowski: Чудя се какво се промени…"
    },
    {
      "id": 110504452606205958,
      "target": "BigLebowski: Имаме семеен албум. Често гледах снимките си отпреди да тръгна на училище и там винаги се усмихвах толкова широко."
    },
    {
      "id": 110504452606205957,
      "target": "BigLebowski: Още един такъв номер и се махам, мамка му."
    },
    {
      "id": 110504452606205956,
      "target": "BigLebowski: Ти си шибан откачалник."
    },
    {
      "id": 110504452606205955,
      "target": "BigLebowski: На кого му пука, мамка му? Важното е, че очите виждат…"
    },
    {
      "id": 110504452606205954,
      "target": "BigLebowski: За какви глупости се тревожат изобщо…"
    },
    {
      "id": 110504452606205953,
      "target": "BigLebowski: Знаеш ли, в класа ми имаше момичета, които твърдяха, че цветът на очите им се променя според настроението."
    },
    {
      "id": 110504452606205952,
      "target": "BigLebowski: Май ще пропусна."
    },
    {
      "id": 110504452602011658,
      "target": "BigLebowski: Аха, много смешно…"
    },
    {
      "id": 110504452602011657,
      "target": "BigLebowski: …"
    },
    {
      "id": 110504452602011656,
      "target": "BigLebowski: Да си намеря мъж, от когото да родя дете!"
    },
    {
      "id": 110504452602011655,
      "target": "BigLebowski: …"
    },
    {
      "id": 110504452602011654,
      "target": "BigLebowski: Защото знаеш ли кое е най-важното в живота?"
    },
    {
      "id": 110504452602011653,
      "target": "BigLebowski: Накратко, все тая…"
    },
    {
      "id": 110504452602011652,
      "target": "BigLebowski: А какво да направя, щом имам алергия? Все едно мога да контролирам този обрив…"
    },
    {
      "id": 110504452602011651,
      "target": "BigLebowski: Мама винаги ми се караше за ръцете. Казваше, че трябва да приличам повече на момиче."
    },
    {
      "id": 110504452602011650,
      "target": "Омръзна ми вече…"
    },
    {
      "id": 110504452602011649,
      "target": "BigLebowski: Следващия път направо стреляй. Няма да те моля за пощада. Вече ми е през оная работа."
    },
    {
      "id": 110504452602011648,
      "target": "Изслушай"
    },
    {
      "id": 110504452597817354,
      "target": "Стреляй"
    },
    {
      "id": 110504452597817353,
      "target": "BigLebowski: Добре, и сега какво?"
    },
    {
      "id": 110504452597817352,
      "target": "Изслушай"
    },
    {
      "id": 110504452597817351,
      "target": "Стреляй"
    },
    {
      "id": 110504452597817350,
      "target": "BigLebowski: Все ми е тая."
    },
    {
      "id": 110504452597817349,
      "target": "BigLebowski: Вече достатъчно пъти те видях с оръжие в ръка."
    }
  ]
}
