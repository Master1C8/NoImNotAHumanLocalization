  "entries": [
    {
      "id": 110504456754372610,
      "target": "SuperFake: Има сили, по-висши и от мен."
    },
    {
      "id": 110504456754372609,
      "target": "SuperFake: Да не мислиш, че аз съм… главният тук?"
    },
    {
      "id": 110504456754372608,
      "target": "SuperFake: Промените далеч не са най-страшното, което те очаква."
    },
    {
      "id": 110504456750178314,
      "target": "SuperFake: Дори моите хора не са чак толкова много. Какво остава за вас, затворени по домовете си."
    },
    {
      "id": 110504456750178313,
      "target": "SuperFake: Я виж ти."
    },
    {
      "id": 110504456750178312,
      "target": "SuperFake: Ела с мен."
    },
    {
      "id": 110504456750178311,
      "target": "SuperFake: Е, новото ни правило сработи."
    },
    {
      "id": 110504456750178310,
      "target": "SuperFake: Хмм…"
    },
    {
      "id": 110504456750178309,
      "target": "Не съм сам"
    },
    {
      "id": 110504456750178308,
      "target": "Сам съм"
    },
    {
      "id": 110504456750178307,
      "target": "SuperFake: Сам ли си вкъщи?"
    },
    {
      "id": 110504456750178306,
      "target": "SuperFake: Но първо ще проверим новото ни правило."
    },
    {
      "id": 110504456750178305,
      "target": "SuperFake: Разбира се! Вече си тръгвам."
    },
    {
      "id": 110504456750178304,
      "target": "Не съм сам"
    },
    {
      "id": 110504456745984011,
      "target": "Сам съм"
    },
    {
      "id": 110504456745984010,
      "target": "SuperFake: Сам ли си вкъщи?"
    },
    {
      "id": 110504456745984009,
      "target": "SuperFake: Но като начало…"
    },
    {
      "id": 110504456745984008,
      "target": "SuperFake: Сега ще го изпробваме."
    },
    {
      "id": 110504456745984007,
      "target": "SuperFake: Всичко е просто."
    },
    {
      "id": 110504456745984006,
      "target": "Можеш ли да дойдеш по-късно?"
    },
    {
      "id": 110504456745984005,
      "target": "Не разбирам"
    },
    {
      "id": 110504456745984004,
      "target": "SuperFake: Ти ще ми отвориш вратата."
    },
    {
      "id": 110504456745984003,
      "target": "SuperFake: Ако в дома ти има поне двама от моите хора…"
    },
    {
      "id": 110504456745984002,
      "target": "SuperFake: Хайде да променим това."
    },
    {
      "id": 110504456745984001,
      "target": "SuperFake: Сякаш изобщо не ти пука за самия себе си."
    },
    {
      "id": 110504456745984000,
      "target": "SuperFake: Някак безучастно."
    },
    {
      "id": 110504456741789707,
      "target": "Можеш ли да дойдеш по-късно?"
    },
    {
      "id": 110504456741789706,
      "target": "Не разбирам"
    },
    {
      "id": 110504456741789705,
      "target": "SuperFake: Защото сега в телата живеят кучета."
    },
    {
      "id": 110504456741789704,
      "target": "SuperFake: Ти ще ми отвориш вратата."
    },
    {
      "id": 110504456741789703,
      "target": "SuperFake: Ако в дома ти има поне двама от моите хора…"
    },
    {
      "id": 110504456741789702,
      "target": "SuperFake: С теб ще изпробваме нови правила."
    },
    {
      "id": 110504456741789701,
      "target": "SuperFake: Явно трябва да помогна."
    },
    {
      "id": 110504456741789700,
      "target": "SuperFake: Тежко ти е."
    },
    {
      "id": 110504456741789699,
      "target": "Все ми е едно"
    },
    {
      "id": 110504456741789698,
      "target": "Не го усещам"
    },
    {
      "id": 110504456741789697,
      "target": "SuperFake: Интересни неща се случват около теб."
    },
    {
      "id": 110504456741789696,
      "target": "SuperFake: Разбираш ли за кого говоря?"
    },
    {
      "id": 110504456737595403,
      "target": "SuperFake: Та той има само словото, само словото, но какво слово!"
    },
    {
      "id": 110504456737595402,
      "target": "SuperFake: А отделният човек престана да умира."
    }
  ]
}
