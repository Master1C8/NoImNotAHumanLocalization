  "entries": [
    {
      "id": 110504455097622529,
      "target": "Greatmother: Ох, синчо, моля те, не пускай никого."
    },
    {
      "id": 110504455097622528,
      "target": "Daughter: Май това е телефонният ѝ номер: {0}."
    },
    {
      "id": 110504455093428236,
      "target": "Daughter: Когато я повикат възрастните, я пускат... А ако аз я повикам, винаги ми се карат."
    },
    {
      "id": 110504455093428235,
      "target": "Daughter: И още нещо... може ли да поканите приятелката ми на гости?.."
    },
    {
      "id": 110504455093428234,
      "target": "Cold: Прости. Не исках това."
    },
    {
      "id": 110504455093428233,
      "target": "Cold: И все пак."
    },
    {
      "id": 110504455093428232,
      "target": "Cold: Разбирам колко ме мразиш."
    },
    {
      "id": 110504455093428231,
      "target": "Cold: Благодаря."
    },
    {
      "id": 110504455093428230,
      "target": "Cold: Може поне на слънце да успея да се стопля. За последен път."
    },
    {
      "id": 110504455093428229,
      "target": "Cold: Извинявай."
    },
    {
      "id": 110504455093428228,
      "target": "Cold: Разбрах."
    },
    {
      "id": 110504455093428227,
      "target": "Само ми дай повод да стрелям"
    },
    {
      "id": 110504455093428226,
      "target": "Тръгвай веднага"
    },
    {
      "id": 110504455093428225,
      "target": "Cold: Може ли да остана до нощта?"
    },
    {
      "id": 110504455093428224,
      "target": "Cold: Слънцето ще ме убива бавно."
    },
    {
      "id": 110504455089233931,
      "target": "Cold: По-етично би било да ме застреляш. За съжаление усещам болка."
    },
    {
      "id": 110504455089233930,
      "target": "Cold: Още сега?"
    },
    {
      "id": 110504455089233929,
      "target": "Cold: Не мисли, че го направих нарочно."
    },
    {
      "id": 110504455089233928,
      "target": "Cold: Само исках…"
    },
    {
      "id": 110504455089233927,
      "target": "Cold: Тогава проблемите със студа и самотата ще свършат."
    },
    {
      "id": 110504455089233926,
      "target": "Cold: Може би така е по-безопасно."
    },
    {
      "id": 110504455089233925,
      "target": "Изгони"
    },
    {
      "id": 110504455089233924,
      "target": "Стреляй"
    },
    {
      "id": 110504455089233923,
      "target": "Cold: Не исках това…"
    },
    {
      "id": 110504455089233922,
      "target": "Cold: Не го направих от злоба."
    },
    {
      "id": 110504455089233921,
      "target": "Cold: Не бързай със заключенията."
    },
    {
      "id": 110504455089233920,
      "target": "Cold: Защо си помислих, че този път нещо ще се промени?"
    },
    {
      "id": 110504455085039628,
      "target": "Cold: И преди е било така."
    },
    {
      "id": 110504455085039627,
      "target": "Изгони"
    },
    {
      "id": 110504455085039626,
      "target": "Стреляй"
    },
    {
      "id": 110504455085039625,
      "target": "Cold: Наистина не исках."
    },
    {
      "id": 110504455085039624,
      "target": "Cold: Не исках."
    },
    {
      "id": 110504455085039623,
      "target": "Cold: Защо ми се случва това?"
    },
    {
      "id": 110504455085039622,
      "target": "Cold: Надявах се, че тук няма да стане така."
    },
    {
      "id": 110504455085039621,
      "target": "Cold: Не беше нарочно…"
    },
    {
      "id": 110504455085039620,
      "target": "Ебан си"
    },
    {
      "id": 110504455085039619,
      "target": "Какво направи?"
    },
    {
      "id": 110504455085039618,
      "target": "Cold: О, не. Пак."
    },
    {
      "id": 110504455085039617,
      "target": "Cold: Виж."
    },
    {
      "id": 110504455085039616,
      "target": "Cold: Под дрехите си крия нещо, което според мен е причината за самотата и студа, които ме разяждат."
    }
  ]
}
