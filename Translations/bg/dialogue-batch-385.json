  "entries": [
    {
      "id": 110504452019003395,
      "target": "Scammer: Сигурно е някаква болест."
    },
    {
      "id": 110504452019003394,
      "target": "Scammer: Да, мамка му."
    },
    {
      "id": 110504452019003393,
      "target": "Scammer: ..."
    },
    {
      "id": 110504452019003392,
      "target": "Scammer: Как мислиш, от слънцето ли е? Или от какво?"
    },
    {
      "id": 110504452014809097,
      "target": "Scammer: Напоследък ме сърбят очите."
    },
    {
      "id": 110504452014809096,
      "target": "Scammer: Трябва да ставам в девет сутринта и да работя поне по 4 часа. Ебати ужаса."
    },
    {
      "id": 110504452014809095,
      "target": "Scammer: По ръцете трябва да разпознаваш шибаните тъпанари и балъците. Какво общо имат Гостите?"
    },
    {
      "id": 110504452014809094,
      "target": "Scammer: Струва ми се странно да разпознаваш онези чудовища по ръцете."
    },
    {
      "id": 110504452014809093,
      "target": "Изслушай"
    },
    {
      "id": 110504452014809092,
      "target": "Стреляй"
    },
    {
      "id": 110504452014809091,
      "target": "Scammer: Стига бе. Не мислех, че ще умра толкова тъпо."
    },
    {
      "id": 110504452014809090,
      "target": "Scammer: Няма да убиеш човек само заради мръсни нокти, нали?"
    },
    {
      "id": 110504452014809089,
      "target": "Извади пушката"
    },
    {
      "id": 110504452014809088,
      "target": "Пусни го"
    },
    {
      "id": 110504452010614794,
      "target": "Scammer: Абе, май са чисти."
    },
    {
      "id": 110504452010614793,
      "target": "Scammer: Къпя се, просто днес нямах време да си изплакна ръцете."
    },
    {
      "id": 110504452010614792,
      "target": "Scammer: Всъщност са чисти. Днес ще си измия ръцете, какво толкова."
    },
    {
      "id": 110504452010614791,
      "target": "Scammer: Къпя се, просто видях монета на пътя и я вдигнах."
    },
    {
      "id": 110504452010614790,
      "target": "Scammer: Не, да не си помислиш нещо."
    },
    {
      "id": 110504452010614789,
      "target": "Scammer: ..."
    },
    {
      "id": 110504452010614788,
      "target": "Scammer: Нищо не си правя на ноктите, ето, гледай."
    },
    {
      "id": 110504452010614787,
      "target": "Scammer: Абе, аз съм си нормален."
    },
    {
      "id": 110504452010614786,
      "target": "Scammer: А ти ми смучи к..."
    },
    {
      "id": 110504452010614785,
      "target": "Scammer: Майтапиш ли се?"
    },
    {
      "id": 110504452010614784,
      "target": "Изслушай"
    },
    {
      "id": 110504452006420489,
      "target": "Стреляй"
    },
    {
      "id": 110504452006420488,
      "target": "Scammer: Моля те?"
    },
    {
      "id": 110504452006420487,
      "target": "Scammer: Да ме гръмнеш в лицето заради зъбите, мамка му... това не е по правилата."
    },
    {
      "id": 110504452006420486,
      "target": "Scammer: Абе, какво ти става? Историята си беше добра."
    },
    {
      "id": 110504452006420485,
      "target": "Извади пушката"
    },
    {
      "id": 110504452006420484,
      "target": "Пусни го"
    },
    {
      "id": 110504452006420483,
      "target": "Scammer: Нормални са, нали?"
    },
    {
      "id": 110504452006420482,
      "target": "Scammer: ..."
    },
    {
      "id": 110504452006420481,
      "target": "Scammer: А, трябва да ги покажа. Чакай."
    },
    {
      "id": 110504452006420480,
      "target": "Scammer: Избили са му, представяш ли си, всички шибани зъби ХАХАХАХАХАХА."
    },
    {
      "id": 110504452002226186,
      "target": "Scammer: Братлето ми си оправяше зъбите."
    },
    {
      "id": 110504452002226185,
      "target": "Scammer: Опа, зъбите мога да ги покажа."
    },
    {
      "id": 110504452002226184,
      "target": "Уши"
    },
    {
      "id": 110504452002226183,
      "target": "Снимка"
    },
    {
      "id": 110504452002226182,
      "target": "Подмишници"
    }
  ]
}
