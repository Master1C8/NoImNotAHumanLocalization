  "entries": [
    {
      "id": 110504452782366729,
      "target": "Пусни го"
    },
    {
      "id": 110504452782366728,
      "target": "Scammer: Майната му, и без това не си измил камерата — виж какви петна са излезли."
    },
    {
      "id": 110504452782366727,
      "target": "Scammer: Майната му, и без това се вижда само силуетът. Напразно позирах."
    },
    {
      "id": 110504452782366726,
      "target": "Scammer: Ето за това ти говорех."
    },
    {
      "id": 110504452782366725,
      "target": "Scammer: ..."
    },
    {
      "id": 110504452782366724,
      "target": "Scammer: Просто съм много чувствителен към светлина. Може да мръдна."
    },
    {
      "id": 110504452782366723,
      "target": "Scammer: Искаш да се снимаш с мен? Хайде."
    },
    {
      "id": 110504452782366722,
      "target": "Уши"
    },
    {
      "id": 110504452782366721,
      "target": "Снимка"
    },
    {
      "id": 110504452782366720,
      "target": "Widow: Просто ще поседя тук. Надявам се, че мога да остана насаме с мислите си."
    },
    {
      "id": 110504452778172422,
      "target": "Widow: Искам да си почина, може ли да излезеш?"
    },
    {
      "id": 110504452778172421,
      "target": "Widow: Повече няма да говоря с него."
    },
    {
      "id": 110504452778172420,
      "target": "Widow: А и тя ще се смачка и скъса с времето."
    },
    {
      "id": 110504452778172419,
      "target": "Widow: Нима всичко, което остана от него... е само една снимка?"
    },
    {
      "id": 110504452778172418,
      "target": "Widow: Имам само една снимка с него."
    },
    {
      "id": 110504452778172417,
      "target": "Изслушай"
    },
    {
      "id": 110504452778172416,
      "target": "Стреляй"
    },
    {
      "id": 110504452773978117,
      "target": "Widow: Провери ли каквото искаше?"
    },
    {
      "id": 110504452773978116,
      "target": "Widow: ..."
    },
    {
      "id": 110504452773978115,
      "target": "Widow: Не знам какво да ти кажа."
    },
    {
      "id": 110504452773978114,
      "target": "Widow: Дори така..."
    },
    {
      "id": 110504452773978113,
      "target": "Изслушай"
    },
    {
      "id": 110504452773978112,
      "target": "Стреляй"
    },
    {
      "id": 110504452769783817,
      "target": "Widow: Но... продължаваш да ме измъчваш. Защо?"
    },
    {
      "id": 110504452769783816,
      "target": "Widow: Знаеш защо. Знаеш, че ми е тежко."
    },
    {
      "id": 110504452769783815,
      "target": "Widow: Разбира се, моята снимка ще бъде ИДЕАЛНО СИНЯ."
    },
    {
      "id": 110504452769783814,
      "target": "Извади пушката"
    },
    {
      "id": 110504452769783813,
      "target": "Пусни я"
    },
    {
      "id": 110504452769783812,
      "target": "Widow: Търпението ми се изчерпа. Развих алергия към шибаните глупости."
    },
    {
      "id": 110504452769783811,
      "target": "Widow: Какво искаш от мен?"
    },
    {
      "id": 110504452769783810,
      "target": "Widow: ..."
    },
    {
      "id": 110504452769783809,
      "target": "Извади пушката"
    },
    {
      "id": 110504452769783808,
      "target": "Пусни я"
    },
    {
      "id": 110504452765589513,
      "target": "Widow: Сега просто си тръгни."
    },
    {
      "id": 110504452765589512,
      "target": "Widow: ..."
    },
    {
      "id": 110504452765589511,
      "target": "Widow: Прави каквото искаш и ме остави на мира."
    },
    {
      "id": 110504452765589510,
      "target": "Widow: Нямам думи."
    },
    {
      "id": 110504452765589509,
      "target": "Widow: ..."
    },
    {
      "id": 110504452765589508,
      "target": "Widow: ИСКАТЕ ДА ЗАПЕЧАТАТЕ СМЪРТТА МУ?"
    },
    {
      "id": 110504452765589507,
      "target": "Widow: Никой не ми помогна да спася съпруга си, а сега..."
    }
  ]
}
