  "entries": [
    {
      "id": 110504453294071808,
      "target": "Intruder: Това би обяснило много неща."
    },
    {
      "id": 110504453289877510,
      "target": "Intruder: Знаеш ли, от толкова време не съм спал, че вече не знам дали всичко това става насън, или наистина."
    },
    {
      "id": 110504453289877509,
      "target": "Извади пушката"
    },
    {
      "id": 110504453289877508,
      "target": "Пусни го"
    },
    {
      "id": 110504453289877507,
      "target": "Intruder: Знаеш ли точно какво да провериш?"
    },
    {
      "id": 110504453289877506,
      "target": "Intruder: Ииии… какъв е изводът?"
    },
    {
      "id": 110504453289877505,
      "target": "Intruder: ..."
    },
    {
      "id": 110504453289877504,
      "target": "Intruder: Е, хайде да опитаме."
    },
    {
      "id": 110504453285683206,
      "target": "Intruder: М? Не съм чувал за това."
    },
    {
      "id": 110504453285683205,
      "target": "Извади пушката"
    },
    {
      "id": 110504453285683204,
      "target": "Пусни го"
    },
    {
      "id": 110504453285683203,
      "target": "Intruder: Сънища съществуват. Поне някога съществуваха. Но аурата…"
    },
    {
      "id": 110504453285683202,
      "target": "Intruder: Просто… изобщо има ли аура? Виждал ли си я?"
    },
    {
      "id": 110504453285683201,
      "target": "Intruder: Сигурен ли си, че това нещо изобщо работи?"
    },
    {
      "id": 110504453285683200,
      "target": "Intruder: Някак… празно е."
    },
    {
      "id": 110504453281488903,
      "target": "Intruder: А, значи не е обикновена снимка, а такава с някаква аура?"
    },
    {
      "id": 110504453281488902,
      "target": "Intruder: ..."
    },
    {
      "id": 110504453281488901,
      "target": "Intruder: Интересно ми е да видя снимката."
    },
    {
      "id": 110504453281488900,
      "target": "Извади пушката"
    },
    {
      "id": 110504453281488899,
      "target": "Пусни го"
    },
    {
      "id": 110504453281488898,
      "target": "Intruder: Е, какво? Не е много добре, а?"
    },
    {
      "id": 110504453281488897,
      "target": "Intruder: ..."
    },
    {
      "id": 110504453281488896,
      "target": "Intruder: Защо ли ме боли там, сякаш кожата ми е раздразнена."
    },
    {
      "id": 110504453277294599,
      "target": "Извади пушката"
    },
    {
      "id": 110504453277294598,
      "target": "Пусни го"
    },
    {
      "id": 110504453277294597,
      "target": "Intruder: Защо очите не се зачервяват?"
    },
    {
      "id": 110504453277294596,
      "target": "Intruder: Между другото, аз вече не спя от… ами, доста време."
    },
    {
      "id": 110504453277294595,
      "target": "Intruder: Хм. Да, преди бяха по-светли. Дори се зачервиха много."
    },
    {
      "id": 110504453277294594,
      "target": "Intruder: ..."
    },
    {
      "id": 110504453277294593,
      "target": "Intruder: Интересно дали е вярно."
    },
    {
      "id": 110504453277294592,
      "target": "Intruder: Чух някъде, че от безсъние очите потъмняват."
    },
    {
      "id": 110504453273100295,
      "target": "Извади пушката"
    },
    {
      "id": 110504453273100294,
      "target": "Пусни го"
    },
    {
      "id": 110504453273100293,
      "target": "Intruder: А аз трябва да видя сънища…"
    },
    {
      "id": 110504453273100292,
      "target": "Intruder: С кого се бия всъщност?"
    },
    {
      "id": 110504453273100291,
      "target": "Intruder: ..."
    },
    {
      "id": 110504453273100290,
      "target": "Intruder: Може би се опитвам да пропълзя в собствения си сън с ръце?"
    },
    {
      "id": 110504453273100289,
      "target": "Intruder: За да стигнем до целта, сме готови да преминем през всяко препятствие."
    },
    {
      "id": 110504453273100288,
      "target": "Извади пушката"
    },
    {
      "id": 110504453268905992,
      "target": "Пусни го"
    }
  ]
}
