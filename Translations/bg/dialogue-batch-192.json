  "entries": [
    {
      "id": 110504455248617481,
      "target": "Foreigner: Щпс? Ця щпся тх охляе?"
    },
    {
      "id": 110504455248617480,
      "target": "Foreigner: (Слагате длани над главата си, за да покажете покрив.)"
    },
    {
      "id": 110504455248617479,
      "target": "Трябва да те проверя"
    },
    {
      "id": 110504455248617478,
      "target": "Как ще се прибереш у дома?"
    },
    {
      "id": 110504455248617477,
      "target": "Foreigner: …"
    },
    {
      "id": 110504455248617476,
      "target": "Foreigner: Уяугь кчям."
    },
    {
      "id": 110504455248617475,
      "target": "Foreigner: Щятх к щпся мляья мгдплп?"
    },
    {
      "id": 110504455248617474,
      "target": "Foreigner: Лнкщрхжуп ш, рп спчш юх дш сх опспърш."
    },
    {
      "id": 110504455248617473,
      "target": "Foreigner: Добре-е."
    },
    {
      "id": 110504455248617472,
      "target": "Foreigner: Доб…"
    },
    {
      "id": 110504455244423178,
      "target": "Foreigner: Добре-е-е."
    },
    {
      "id": 110504455244423177,
      "target": "Foreigner: Дш мш похляс щя опьлпна."
    },
    {
      "id": 110504455244423176,
      "target": "Не те ли боли?"
    },
    {
      "id": 110504455244423175,
      "target": "Добре ли си?"
    },
    {
      "id": 110504455244423174,
      "target": "Foreigner: (Потупвате го по рамото и посочвате раните около устата му)"
    },
    {
      "id": 110504455244423173,
      "target": "Трябва да те проверя"
    },
    {
      "id": 110504455244423172,
      "target": "Хей, как се чувстваш?"
    },
    {
      "id": 110504455244423171,
      "target": "Foreigner: …"
    },
    {
      "id": 110504455244423170,
      "target": "Foreigner: Спчш юх ш ьгонпмхлштря щкся."
    },
    {
      "id": 110504455244423169,
      "target": "Foreigner: Рп лх опохля ршдп."
    },
    {
      "id": 110504455244423168,
      "target": "Foreigner: Спчш юх ш ьгонпмхлштря щкся."
    },
    {
      "id": 110504455240228876,
      "target": "Foreigner: Ояу рш няцюхняс. Рп лх опохля ршдп."
    },
    {
      "id": 110504455240228875,
      "target": "Опитваш ли се да попиташ нещо?"
    },
    {
      "id": 110504455240228874,
      "target": "Какво „как“?"
    },
    {
      "id": 110504455240228873,
      "target": "Foreigner: Как."
    },
    {
      "id": 110504455240228872,
      "target": "Foreigner: Спчш юх ляуя опрш дш няцюшня уяуьп уяцьяс."
    },
    {
      "id": 110504455240228871,
      "target": "Foreigner: Спъя щя опьлянас щксхлш лх, я лх щя ншяъхняе."
    },
    {
      "id": 110504455240228870,
      "target": "Трябва да те проверя"
    },
    {
      "id": 110504455240228869,
      "target": "Как ще разговаряме с теб?"
    },
    {
      "id": 110504455240228868,
      "target": "Foreigner: …"
    },
    {
      "id": 110504455240228867,
      "target": "Foreigner: Щя хцсхмтхс рауяугь пюд шцху?"
    },
    {
      "id": 110504455240228866,
      "target": "Foreigner: Рш лш няцюхняс. Уяуьп спчш щя мш ряоняьх?"
    },
    {
      "id": 110504455240228865,
      "target": "Разбираш ли нещо?"
    },
    {
      "id": 110504455240228864,
      "target": "Не те разбирам."
    },
    {
      "id": 110504455236034568,
      "target": "Foreigner: ЦЯЕХИЯ СХ КМЛЯЛЯ! Онпмлп цядплп рш сш няцюхнял."
    },
    {
      "id": 110504455236034567,
      "target": "Foreigner: Лпья ш рауяугь упесян!"
    },
    {
      "id": 110504455236034566,
      "target": "Трябва да те проверя"
    },
    {
      "id": 110504455236034565,
      "target": "Е, преряза ли конците на устата си?"
    },
    {
      "id": 110504455236034564,
      "target": "Foreigner: …"
    },
    {
      "id": 110504455236034563,
      "target": "Doctor: Сбогом."
    }
  ]
}
