  "entries": [
    {
      "id": 110504452883030025,
      "target": "Sirin: Гостите няма да се хвърлят върху теб, ако ги държиш на мушка. Няма да се издадат."
    },
    {
      "id": 110504452883030024,
      "target": "Sirin: Защо проверяваш, прицелваш се, но не стреляш?"
    },
    {
      "id": 110504452883030023,
      "target": "Изслушай"
    },
    {
      "id": 110504452883030022,
      "target": "Стреляй"
    },
    {
      "id": 110504452883030021,
      "target": "Sirin: Просто направи каквото трябва."
    },
    {
      "id": 110504452883030020,
      "target": "Sirin: Не се бави."
    },
    {
      "id": 110504452883030019,
      "target": "Изслушай"
    },
    {
      "id": 110504452883030018,
      "target": "Стреляй"
    },
    {
      "id": 110504452883030017,
      "target": "Sirin: И тази снимка изгори."
    },
    {
      "id": 110504452883030016,
      "target": "Извади пушката"
    },
    {
      "id": 110504452878835720,
      "target": "Пусни я"
    },
    {
      "id": 110504452878835719,
      "target": "Sirin: Още ѝ е неприятно да си спомня за тях."
    },
    {
      "id": 110504452878835718,
      "target": "Sirin: И аз трябва да се отърва от нея."
    },
    {
      "id": 110504452878835717,
      "target": "Sirin: А сестра ми я свали."
    },
    {
      "id": 110504452878835716,
      "target": "Sirin: ..."
    },
    {
      "id": 110504452878835715,
      "target": "Sirin: Спомен от родителите ни."
    },
    {
      "id": 110504452878835714,
      "target": "Sirin: Остана ми една обица."
    },
    {
      "id": 110504452878835713,
      "target": "Извади пушката"
    },
    {
      "id": 110504452878835712,
      "target": "Пусни я"
    },
    {
      "id": 110504452874641412,
      "target": "Sirin: А как трябва?"
    },
    {
      "id": 110504452874641411,
      "target": "Sirin: ..."
    },
    {
      "id": 110504452874641410,
      "target": "Sirin: Прави каквото смяташ за правилно."
    },
    {
      "id": 110504452874641409,
      "target": "Sirin: Не ме интересува дали ще остане нещо след това."
    },
    {
      "id": 110504452874641408,
      "target": "Уши"
    },
    {
      "id": 110504452870447109,
      "target": "Снимка"
    },
    {
      "id": 110504452870447108,
      "target": "Уши"
    },
    {
      "id": 110504452870447107,
      "target": "Снимка"
    },
    {
      "id": 110504452870447106,
      "target": "Alkonost: А понякога съм сигурна."
    },
    {
      "id": 110504452870447105,
      "target": "Alkonost: Всички тези признаци… не знам, понякога ми се струва, че всичко това е пълна лудост."
    },
    {
      "id": 110504452870447104,
      "target": "Alkonost: Надявам се в КИС да знаят какво правят."
    },
    {
      "id": 110504452866252808,
      "target": "Alkonost: Едва не умрях от страх."
    },
    {
      "id": 110504452866252807,
      "target": "Alkonost: Той… той скоро ще дойде да помогне на мен и сестра ми."
    },
    {
      "id": 110504452866252806,
      "target": "Alkonost: И без това съм много притеснена заради съпруга си."
    },
    {
      "id": 110504452866252805,
      "target": "Alkonost: Значи така се пошегува? Моля те, не го прави повече."
    },
    {
      "id": 110504452866252804,
      "target": "Изслушай"
    },
    {
      "id": 110504452866252803,
      "target": "Стреляй"
    },
    {
      "id": 110504452866252802,
      "target": "Alkonost: Какво точно те разтревожи, мамка му?"
    },
    {
      "id": 110504452866252801,
      "target": "Alkonost: Как реши, че съм Гост?"
    },
    {
      "id": 110504452866252800,
      "target": "Изслушай"
    },
    {
      "id": 110504452862058504,
      "target": "Стреляй"
    }
  ]
}
