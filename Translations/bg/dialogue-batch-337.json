  "glossaryFingerprint": "28d7eb651d95b56a72a5a4acefcba5f434dcbe6925a2233126655e13b0e01cab",
  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504452740423685,
      "target": "Стреляй"
    },
    {
      "id": 110504452740423684,
      "target": "Cold: Тогава само не се бави, моля те. Чакането е по-лошо от смъртта."
    },
    {
      "id": 110504452740423683,
      "target": "Cold: Жажда за убийство ли говори в теб? Очите ми не са червени."
    },
    {
      "id": 110504452740423682,
      "target": "Изслушай"
    },
    {
      "id": 110504452740423681,
      "target": "Стреляй"
    },
    {
      "id": 110504452740423680,
      "target": "Cold: Искам да ти разкажа нещо. Но ме е страх."
    },
    {
      "id": 110504452736229385,
      "target": "Cold: Извини ме, че те моля, но... ако можеш, не стреляй засега."
    },
    {
      "id": 110504452736229384,
      "target": "Cold: Да, ръцете ми в това състояние трудно могат да се проверят за признаци на Гост."
    },
    {
      "id": 110504452736229383,
      "target": "Изслушай"
    },
    {
      "id": 110504452736229382,
      "target": "Стреляй"
    },
    {
      "id": 110504452736229381,
      "target": "Cold: Но изглежда, че скоро няма да има смисъл да напомням за това."
    },
    {
      "id": 110504452736229380,
      "target": "Извади пушката"
    },
    {
      "id": 110504452736229379,
      "target": "Пусни го"
    },
    {
      "id": 110504452736229378,
      "target": "Cold: Дори най-близкият човек непременно ще изчезне. Рано или късно."
    },
    {
      "id": 110504452736229377,
      "target": "Cold: ..."
    },
    {
      "id": 110504452736229376,
      "target": "Cold: Може би затова човек изчезва толкова лесно, щом само за миг се извърнеш."
    },
    {
      "id": 110504452732035080,
      "target": "Cold: Цялото ни тяло е осеяно с дупки."
    },
    {
      "id": 110504452732035079,
      "target": "Извади пушката"
    },
    {
      "id": 110504452732035078,
      "target": "Пусни го"
    },
    {
      "id": 110504452732035077,
      "target": "Cold: Дай да погледна."
    },
    {
      "id": 110504452732035076,
      "target": "Cold: Видя ли нещо?"
    },
    {
      "id": 110504452732035075,
      "target": "Cold: ..."
    },
    {
      "id": 110504452732035074,
      "target": "Cold: Но от мен не зависи почти нищо. Разбира се, снимай."
    },
    {
      "id": 110504452732035073,
      "target": "Cold: Не ти ли се струва странно?"
    },
    {
      "id": 110504452732035072,
      "target": "Cold: Как една снимка може да определи каквото и да било?"
    },
    {
      "id": 110504452727840774,
      "target": "Извади пушката"
    },
    {
      "id": 110504452727840773,
      "target": "Пусни го"
    },
    {
      "id": 110504452727840772,
      "target": "Cold: Да, беше неприятно."
    },
    {
      "id": 110504452727840771,
      "target": "Cold: Само от уважение към теб..."
    },
    {
      "id": 110504452727840770,
      "target": "Cold: ..."
    },
    {
      "id": 110504452727840769,
      "target": "Cold: Готово, гледай. Но бързо."
    },
    {
      "id": 110504452727840768,
      "target": "Cold: Сега..."
    },
    {
      "id": 110504452723646469,
      "target": "Cold: Много ме е страх, честно казано. Почакай, трябва да се подготвя."
    },
    {
      "id": 110504452723646468,
      "target": "Cold: Ох..."
    },
    {
      "id": 110504452723646467,
      "target": "Извади пушката"
    },
    {
      "id": 110504452723646466,
      "target": "Пусни го"
    },
    {
      "id": 110504452723646465,
      "target": "Cold: Поне се стоплих под слънцето."
    },
    {
      "id": 110504452723646464,
      "target": "Cold: Жалко, че слънцето ме изгаря също като останалите."
    },
    {
      "id": 110504452719452163,
      "target": "Cold: Явно така ме сковава студът."
    },
    {
      "id": 110504452719452162,
      "target": "Cold: Тесни зеници?"
    }
  ]
}
