  "glossaryFingerprint": "28d7eb651d95b56a72a5a4acefcba5f434dcbe6925a2233126655e13b0e01cab",
  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504452253884420,
      "target": "Nun: Бог вижда всичко. Вижда и как се подигравате с една бедна старица, Божия рабиня! Не ви ли е срам от поведението ви???"
    },
    {
      "id": 110504452253884419,
      "target": "Изслушай"
    },
    {
      "id": 110504452253884418,
      "target": "Стреляй"
    },
    {
      "id": 110504452253884417,
      "target": "Nun: Вашите очи ме плашат повече. В тях няма нищо."
    },
    {
      "id": 110504452253884416,
      "target": "Изслушай"
    },
    {
      "id": 110504452249690121,
      "target": "Стреляй"
    },
    {
      "id": 110504452249690120,
      "target": "Nun: Куршумите не измиват греховете. Мислите, че пушката ще ме подтикне към изповед?"
    },
    {
      "id": 110504452249690119,
      "target": "Изслушай"
    },
    {
      "id": 110504452249690118,
      "target": "Стреляй"
    },
    {
      "id": 110504452249690117,
      "target": "Nun: Плашите бедна старица? От Бога се бойте!"
    },
    {
      "id": 110504452249690116,
      "target": "Nun: Май съвсем сте си изгубили срама."
    },
    {
      "id": 110504452249690115,
      "target": "Nun: Ръцете далеч от мен, не съм ви крава на пазара!"
    },
    {
      "id": 110504452249690114,
      "target": "Nun: ..."
    },
    {
      "id": 110504452249690113,
      "target": "Nun: Какво-о-о?! Ушите ще ми проверявате?! Да не сте болен?"
    },
    {
      "id": 110504452249690112,
      "target": "Извади пушката"
    },
    {
      "id": 110504452245495818,
      "target": "Пусни я"
    },
    {
      "id": 110504452245495817,
      "target": "Nun: Мислите, че снимките казват истината? Като малък сигурно са ви лъгали като глупава гъска! Че и гълъбите в манастирския двор са по-умни от вас."
    },
    {
      "id": 110504452245495816,
      "target": "Nun: ..."
    },
    {
      "id": 110504452245495815,
      "target": "Nun: Да разглеждам снимки, друг път. Сякаш имам цялото време на света за това!"
    },
    {
      "id": 110504452245495814,
      "target": "Извади пушката"
    },
    {
      "id": 110504452245495813,
      "target": "Пусни я"
    },
    {
      "id": 110504452245495812,
      "target": "Nun: ..."
    },
    {
      "id": 110504452245495811,
      "target": "Nun: Е… всичко е по Божията воля…"
    },
    {
      "id": 110504452245495810,
      "target": "Nun: Вие няма да ме оставите на мира, нали?"
    },
    {
      "id": 110504452245495809,
      "target": "Nun: …"
    },
    {
      "id": 110504452245495808,
      "target": "Nun: Къде се е чуло и видяло такова нещо!?"
    },
    {
      "id": 110504452241301513,
      "target": "Nun: …"
    },
    {
      "id": 110504452241301512,
      "target": "Nun: Няма да стане!"
    },
    {
      "id": 110504452241301511,
      "target": "Nun: Гледай ти какво са намислили! Стара и болна жена да си вдига ръцете и да се разголва пред такъв негодник."
    },
    {
      "id": 110504452241301510,
      "target": "Nun: Съвсем ли сте полудели?"
    },
    {
      "id": 110504452241301509,
      "target": "Извади пушката"
    },
    {
      "id": 110504452241301508,
      "target": "Пусни я"
    },
    {
      "id": 110504452241301507,
      "target": "Nun: Да знаете само колко човешки грехове съм видяла през живота си!"
    },
    {
      "id": 110504452241301506,
      "target": "Nun: Нещо не е наред ли? От умората е."
    },
    {
      "id": 110504452241301505,
      "target": "Nun: Нещо не е наред ли? От тежките времена е."
    },
    {
      "id": 110504452241301504,
      "target": "Nun: ..."
    },
    {
      "id": 110504452237107217,
      "target": "Nun: Хайде, гледайте."
    },
    {
      "id": 110504452237107216,
      "target": "Извади пушката"
    },
    {
      "id": 110504452237107215,
      "target": "Пусни я"
    },
    {
      "id": 110504452237107214,
      "target": "Nun: От старостта е, да. Обрив от тебешира против хлебарки. Колкото и да ги изтребваш, все нови се появяват. Не разбирам откъде се вземат на такива пълчища!"
    }
  ]
}
