  "entries": [
    {
      "id": 110504456766955525,
      "target": "SuperFake: Изглежда, по-често мислиш за това какво ще стане след това."
    },
    {
      "id": 110504456766955524,
      "target": "SuperFake: …"
    },
    {
      "id": 110504456766955523,
      "target": "SuperFake: Често ли се питаш защо още си жив?"
    },
    {
      "id": 110504456766955522,
      "target": "SuperFake: Страхуваш ли се от неизвестното?"
    },
    {
      "id": 110504456766955521,
      "target": "Махнах няколко излишни от къщата"
    },
    {
      "id": 110504456766955520,
      "target": "Махнах всички излишни от къщата"
    },
    {
      "id": 110504456762761228,
      "target": "Пусках само когото трябваше"
    },
    {
      "id": 110504456762761227,
      "target": "В къщата има много нечовеци"
    },
    {
      "id": 110504456762761226,
      "target": "Не съм пускал никого"
    },
    {
      "id": 110504456762761225,
      "target": "В къщата има много хора"
    },
    {
      "id": 110504456762761224,
      "target": "SuperFake: Сам ли си вкъщи?"
    },
    {
      "id": 110504456762761223,
      "target": "SuperFake: Пусна ли хората ми?"
    },
    {
      "id": 110504456762761222,
      "target": "SuperFake: А засега…"
    },
    {
      "id": 110504456762761221,
      "target": "SuperFake: Но със сигурност ще изчезнеш."
    },
    {
      "id": 110504456762761220,
      "target": "SuperFake: Ако не днес, утре. Ако не утре, по-късно."
    },
    {
      "id": 110504456762761219,
      "target": "SuperFake: Ще умреш."
    },
    {
      "id": 110504456762761218,
      "target": "SuperFake: А резултатът е един и същ."
    },
    {
      "id": 110504456762761217,
      "target": "SuperFake: Да промениш нещо?"
    },
    {
      "id": 110504456762761216,
      "target": "SuperFake: Изпращат ме само при теб, за да…"
    },
    {
      "id": 110504456758566923,
      "target": "SuperFake: Да не си помисли, че си избран? Ха-ха."
    },
    {
      "id": 110504456758566922,
      "target": "SuperFake: Едва сега ли питаш?"
    },
    {
      "id": 110504456758566921,
      "target": "Защо не разбиваш вратата веднага?"
    },
    {
      "id": 110504456758566920,
      "target": "Защо идваш?"
    },
    {
      "id": 110504456758566919,
      "target": "SuperFake: Не се тревожи, ще помогнем."
    },
    {
      "id": 110504456758566918,
      "target": "SuperFake: Забавно е, че самият ти не усещаш нищо."
    },
    {
      "id": 110504456758566917,
      "target": "SuperFake: Това няма да ти кажа."
    },
    {
      "id": 110504456758566916,
      "target": "Защо не разбиваш вратата веднага?"
    },
    {
      "id": 110504456758566915,
      "target": "Защо идваш?"
    },
    {
      "id": 110504456758566914,
      "target": "SuperFake: Тя вече ви е по петите."
    },
    {
      "id": 110504456758566913,
      "target": "SuperFake: А ти усещаш ли как Смъртта се приближава все повече?"
    },
    {
      "id": 110504456758566912,
      "target": "SuperFake: Това е всичко."
    },
    {
      "id": 110504456754372619,
      "target": "SuperFake: Споделям с теб онова, което ми казаха."
    },
    {
      "id": 110504456754372618,
      "target": "Към какъв край?"
    },
    {
      "id": 110504456754372617,
      "target": "За какво говориш?"
    },
    {
      "id": 110504456754372616,
      "target": "SuperFake: Ако не сме ние, ще се справите и сами занапред."
    },
    {
      "id": 110504456754372615,
      "target": "SuperFake: Цялата тази история върви към края си."
    },
    {
      "id": 110504456754372614,
      "target": "SuperFake: Казаха ми, че това е последната ни среща."
    },
    {
      "id": 110504456754372613,
      "target": "SuperFake: Ще се видим?"
    },
    {
      "id": 110504456754372612,
      "target": "SuperFake: Ами…"
    },
    {
      "id": 110504456754372611,
      "target": "SuperFake: Аз само изпълнявам тази воля."
    }
  ]
}
