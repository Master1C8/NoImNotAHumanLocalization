  "entries": [
    {
      "id": 110504456171364354,
      "target": "Mother: Не, не говорете така."
    },
    {
      "id": 110504456171364353,
      "target": "По-добре си върви"
    },
    {
      "id": 110504456171364352,
      "target": "Влизай"
    },
    {
      "id": 110504456167170059,
      "target": "Mother: Разбира се, че не. Ох, добре, най-важното е да намеря децата."
    },
    {
      "id": 110504456167170058,
      "target": "Mother: Да, скарахме се с него, но това не е чудно. Ако се държиш като задник, можеш ли да живееш с други хора?"
    },
    {
      "id": 110504456167170057,
      "target": "Mother: Не знам, може баща им да ги е взел? Искам утре да отида до дома му, но вече просто не мога."
    },
    {
      "id": 110504456167170056,
      "target": "Децата ви мъртви ли са?"
    },
    {
      "id": 110504456167170055,
      "target": "Къде изчезнаха останалите деца?"
    },
    {
      "id": 110504456167170054,
      "target": "Mother: Вече не знам къде какво да търся. Трябва само хубаво да се наспя."
    },
    {
      "id": 110504456167170053,
      "target": "Mother: Преди имах пет деца. Остана само последното, ето го."
    },
    {
      "id": 110504456167170052,
      "target": "Mother: Пуснете ме да си почина, ужасно съм уморена."
    },
    {
      "id": 110504456167170051,
      "target": "Децата ви мъртви ли са?"
    },
    {
      "id": 110504456167170050,
      "target": "Къде изчезнаха останалите деца?"
    },
    {
      "id": 110504456167170049,
      "target": "Mother: Сега бих легнала и бих спала няколко дни."
    },
    {
      "id": 110504456167170048,
      "target": "Mother: Мъжът ми изчезна някъде. Вече не знам какво да мисля — дали са го убили, дали ни е изоставил, или какво."
    },
    {
      "id": 110504456162975755,
      "target": "Mother: От петте деца остана само едно."
    },
    {
      "id": 110504456162975754,
      "target": "Mother: Нямам повече сили. Много ми се спи."
    },
    {
      "id": 110504456162975753,
      "target": "Какво искате от мен?"
    },
    {
      "id": 110504456162975752,
      "target": "Нещо случило ли се е?"
    },
    {
      "id": 110504456162975751,
      "target": "Mother: Здравейте. Помогнете ми, моля ви."
    },
    {
      "id": 110504456162975750,
      "target": "Mother: Стига, стой мирно, не се върти."
    },
    {
      "id": 110504456162975749,
      "target": "Wheelchair: О-о-ой, махам се оттук. Откачалник."
    },
    {
      "id": 110504456162975748,
      "target": "Wheelchair: Как да си тръгна?"
    },
    {
      "id": 110504456162975747,
      "target": "Wheelchair: Да си тръгна? Шибан идиот ли си?"
    },
    {
      "id": 110504456162975746,
      "target": "Wheelchair: Ще се надбягваме из дома ти, а?"
    },
    {
      "id": 110504456162975745,
      "target": "Wheelchair: Ето това е!"
    },
    {
      "id": 110504456162975744,
      "target": "По-добре си върви"
    },
    {
      "id": 110504456158781451,
      "target": "Влизай"
    },
    {
      "id": 110504456158781450,
      "target": "Wheelchair: Слушай, изминах толкова път. Може ли, моля те, да ме пуснеш у вас?"
    },
    {
      "id": 110504456158781449,
      "target": "Wheelchair: Май наистина съм се объркал."
    },
    {
      "id": 110504456158781448,
      "target": "Wheelchair: Мамка му…"
    },
    {
      "id": 110504456158781447,
      "target": "Wheelchair: …"
    },
    {
      "id": 110504456158781446,
      "target": "Wheelchair: …"
    },
    {
      "id": 110504456158781445,
      "target": "Wheelchair: Не-е-е…"
    },
    {
      "id": 110504456158781444,
      "target": "Wheelchair: …"
    },
    {
      "id": 110504456158781443,
      "target": "Wheelchair: Абе не, няма как да съм…"
    },
    {
      "id": 110504456158781442,
      "target": "По-добре си върви"
    },
    {
      "id": 110504456158781441,
      "target": "Влизай"
    },
    {
      "id": 110504456158781440,
      "target": "Wheelchair: Слушай, изминах толкова път. Може ли, моля те, да ме пуснеш у вас?"
    },
    {
      "id": 110504456154587147,
      "target": "Wheelchair: …"
    }
  ]
}
