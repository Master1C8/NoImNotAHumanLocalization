  "sourceInventorySha256": "ecd96645c2ca6f23f8bf3ab2fcf65709e961478ae15a38e83d94cc335a408bf0",
  "glossaryFingerprint": "28d7eb651d95b56a72a5a4acefcba5f434dcbe6925a2233126655e13b0e01cab",
  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504456561434625,
      "target": "Ballerina: Виждаш ли града? Живеех там."
    },
    {
      "id": 110504456561434624,
      "target": "Напомняш ми за един… човек"
    },
    {
      "id": 110504456557240330,
      "target": "Някой ли те прати тук?"
    },
    {
      "id": 110504456557240329,
      "target": "Ballerina: Занимавах се с балет. Личи ли си?"
    },
    {
      "id": 110504456557240328,
      "target": "Ballerina: Танцувам."
    },
    {
      "id": 110504456557240327,
      "target": "Как намери къщата ми?"
    },
    {
      "id": 110504456557240326,
      "target": "Коя си ти?"
    },
    {
      "id": 110504456557240325,
      "target": "Ballerina: Казаха ми да дойда тук и ето ме."
    },
    {
      "id": 110504456557240324,
      "target": "Ballerina: Ще отвориш ли вратата, или не?"
    },
    {
      "id": 110504456557240323,
      "target": "Ballerina: …"
    },
    {
      "id": 110504456557240322,
      "target": "Ballerina: Каса бира. Нощно шкафче. Бут. Не знам. Дай ми каквото искаш."
    },
    {
      "id": 110504456557240321,
      "target": "Как намери къщата ми?"
    },
    {
      "id": 110504456557240320,
      "target": "Коя си ти?"
    },
    {
      "id": 110504456553046028,
      "target": "Ballerina: И как точно ще ти помогне това?"
    },
    {
      "id": 110504456553046027,
      "target": "Ballerina: Много въпроси. Да, знам."
    },
    {
      "id": 110504456553046026,
      "target": "Ballerina: …"
    },
    {
      "id": 110504456553046025,
      "target": "Какво искаш?"
    },
    {
      "id": 110504456553046024,
      "target": "Познаваш ли… един плешив мъж?"
    },
    {
      "id": 110504456553046023,
      "target": "Ballerina: Ще отвориш ли вратата?"
    },
    {
      "id": 110504456553046022,
      "target": "Ballerina: …"
    },
    {
      "id": 110504456553046021,
      "target": "Ballerina: Здрасти."
    },
    {
      "id": 110504456553046020,
      "target": "Teacher: Обещайте ми, че ако срещнете деца, ще се погрижите за тях. Сбогом."
    },
    {
      "id": 110504456553046019,
      "target": "Teacher: Не ви виня. Но ми обещайте…"
    },
    {
      "id": 110504456553046018,
      "target": "Teacher: Жалко, че децата няма как да се върнат."
    },
    {
      "id": 110504456553046017,
      "target": "Teacher: Благодаря ви, че ме изслушахте и ме пуснахте вътре."
    },
    {
      "id": 110504456553046016,
      "target": "По-добре си вървете"
    },
    {
      "id": 110504456548851723,
      "target": "Заповядайте"
    },
    {
      "id": 110504456548851722,
      "target": "Teacher: Хората подпалиха детската градина и ме принудиха да гледам…"
    },
    {
      "id": 110504456548851721,
      "target": "Teacher: …"
    },
    {
      "id": 110504456548851720,
      "target": "Teacher: Защо им причиниха това? Та те не бяха виновни за нищо…"
    },
    {
      "id": 110504456548851719,
      "target": "Teacher: В какво се превърнаха хората? Решиха да се саморазправят с нещастните малчугани?"
    },
    {
      "id": 110504456548851718,
      "target": "Teacher: …"
    },
    {
      "id": 110504456548851717,
      "target": "Teacher: Някой научи, че вземам под опеката си деца с признаци на Гости."
    },
    {
      "id": 110504456548851716,
      "target": "Teacher: Заради… заради хората."
    },
    {
      "id": 110504456548851715,
      "target": "По-добре си вървете"
    },
    {
      "id": 110504456548851714,
      "target": "Заповядайте"
    },
    {
      "id": 110504456548851713,
      "target": "Teacher: Още виждам уплашените очички на децата…"
    },
    {
      "id": 110504456548851712,
      "target": "Teacher: …"
    },
    {
      "id": 110504456544657420,
      "target": "Teacher: Принудиха ме… да гледам как заключиха вратите, заковаха прозорците и… подпалиха детската градина…"
    },
    {
      "id": 110504456544657419,
      "target": "Teacher: Сториха го хора… които се страхуваха, че децата може да са Гости…"
    }
  ]
}
