  "entries": [
    {
      "id": 110504456041340928,
      "target": "Страшно е да си представя какво ще стане с тях след полунощ..."
    },
    {
      "id": 110504456037146635,
      "target": "Буквално не с дни, а с часове."
    },
    {
      "id": 110504456037146634,
      "target": "Гъбите са удивителни създания!.."
    },
    {
      "id": 110504456037146633,
      "target": "Ще поспя малко."
    },
    {
      "id": 110504456037146632,
      "target": "Някак се уморих."
    },
    {
      "id": 110504456037146631,
      "target": "…"
    },
    {
      "id": 110504456037146630,
      "target": "Дано пак се срещна с тях, с цялото семейство."
    },
    {
      "id": 110504456037146629,
      "target": "Ще дойде ли някой при мен?"
    },
    {
      "id": 110504456037146628,
      "target": "Защо ме пуснаха тук?"
    },
    {
      "id": 110504456037146627,
      "target": "Чудя се какво изобщо беше това."
    },
    {
      "id": 110504456037146626,
      "target": "Дано продължи така по-дълго…"
    },
    {
      "id": 110504456037146625,
      "target": "Но аз и не смятам."
    },
    {
      "id": 110504456037146624,
      "target": "Не знам как да изляза."
    },
    {
      "id": 110504456032952331,
      "target": "Не помня как попаднах тук."
    },
    {
      "id": 110504456032952330,
      "target": "Никой не се натрапва. Никой не ме закача."
    },
    {
      "id": 110504456032952329,
      "target": "Но… сега ми е спокойно."
    },
    {
      "id": 110504456032952328,
      "target": "Не знам колко време вече седя тук."
    },
    {
      "id": 110504456032952327,
      "target": "Тук денят и нощта не се сменят."
    },
    {
      "id": 110504456032952326,
      "target": "..."
    },
    {
      "id": 110504456032952325,
      "target": "..."
    },
    {
      "id": 110504456032952324,
      "target": "Страх ме е"
    },
    {
      "id": 110504456032952323,
      "target": "Има ли някого тук?"
    },
    {
      "id": 110504456032952322,
      "target": "..."
    },
    {
      "id": 110504456032952321,
      "target": "Страх ме е"
    },
    {
      "id": 110504456032952320,
      "target": "Има ли някого тук?"
    },
    {
      "id": 110504456028758026,
      "target": "..."
    },
    {
      "id": 110504456028758025,
      "target": "Мога ли да гледам филм?"
    },
    {
      "id": 110504456028758024,
      "target": "Ще има ли още някого тук?"
    },
    {
      "id": 110504456028758023,
      "target": "..."
    },
    {
      "id": 110504456028758022,
      "target": "Мога ли да гледам филм?"
    },
    {
      "id": 110504456028758021,
      "target": "Ще има ли още някого тук?"
    },
    {
      "id": 110504456028758020,
      "target": "..."
    },
    {
      "id": 110504456028758019,
      "target": "Завинаги ли съм тук?"
    },
    {
      "id": 110504456028758018,
      "target": "Умрях ли?"
    },
    {
      "id": 110504456028758017,
      "target": "..."
    },
    {
      "id": 110504456028758016,
      "target": "Наслаждавай се."
    },
    {
      "id": 110504456024563722,
      "target": "Ще ти се сторят големи, прашни, осеяни с компромиси."
    },
    {
      "id": 110504456024563721,
      "target": "С кратките ѝ пътища, които после ще ти се сторят странно широки."
    },
    {
      "id": 110504456024563720,
      "target": "Това е твоето място."
    },
    {
      "id": 110504456024563719,
      "target": "Нали това искаше?"
    }
  ]
}
