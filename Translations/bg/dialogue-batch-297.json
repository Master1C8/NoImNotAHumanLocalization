  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504453587673092,
      "target": "Пушачите биха продали бъбрек за такива."
    },
    {
      "id": 110504453587673091,
      "target": "По дяволите, бели са…"
    },
    {
      "id": 110504453587673090,
      "target": "..."
    },
    {
      "id": 110504453587673089,
      "target": "..."
    },
    {
      "id": 110504453587673088,
      "target": "Измий се"
    },
    {
      "id": 110504453583478791,
      "target": "Уши"
    },
    {
      "id": 110504453583478790,
      "target": "Подмишници"
    },
    {
      "id": 110504453583478789,
      "target": "Очи"
    },
    {
      "id": 110504453583478788,
      "target": "Ръце"
    },
    {
      "id": 110504453583478787,
      "target": "Зъби"
    },
    {
      "id": 110504453583478786,
      "target": "Трябва да се прегледам."
    },
    {
      "id": 110504453583478785,
      "target": "FatalDame: ..."
    },
    {
      "id": 110504453583478784,
      "target": "Мамичко..."
    },
    {
      "id": 110504453579284487,
      "target": "Daughter: Татенце..."
    },
    {
      "id": 110504453579284486,
      "target": "Daughter: Трябва да отида при приятелката си, когато татко дойде да ме вземе..."
    },
    {
      "id": 110504453579284485,
      "target": "Daughter: И на мен татко ми забранява разни неща, но не всичко!"
    },
    {
      "id": 110504453579284484,
      "target": "Daughter: Дали майка ѝ не е Гост?"
    },
    {
      "id": 110504453579284483,
      "target": "Daughter: Тя ѝ забранява много неща."
    },
    {
      "id": 110504453579284482,
      "target": "Daughter: Просто ѝ е трудно вкъщи. Майка ѝ е много строга."
    },
    {
      "id": 110504453579284481,
      "target": "Daughter: Но иначе е добро момиче."
    },
    {
      "id": 110504453579284480,
      "target": "Daughter: А после — хоп! — ще направи някоя пакост!"
    },
    {
      "id": 110504453575090183,
      "target": "Daughter: Играем си с нея, играем си."
    },
    {
      "id": 110504453575090182,
      "target": "Изслушай"
    },
    {
      "id": 110504453575090181,
      "target": "Стреляй"
    },
    {
      "id": 110504453575090180,
      "target": "Daughter: Понякога сте точно като най-добрата ми приятелка..."
    },
    {
      "id": 110504453575090179,
      "target": "Daughter: Да не искате да ме обидите?"
    },
    {
      "id": 110504453575090178,
      "target": "Daughter: И за това ще разкажа!"
    },
    {
      "id": 110504453575090177,
      "target": "Daughter: Ох..."
    },
    {
      "id": 110504453575090176,
      "target": "Извади пушката"
    },
    {
      "id": 110504453570895880,
      "target": "Пусни я"
    },
    {
      "id": 110504453570895879,
      "target": "Daughter: Не помня-а-а-а-а-а..."
    },
    {
      "id": 110504453570895878,
      "target": "Daughter: Или може би съм го сънувала?.."
    },
    {
      "id": 110504453570895877,
      "target": "Daughter: ..."
    },
    {
      "id": 110504453570895876,
      "target": "Daughter: Татко се уплаши, а после се прегърнаха."
    },
    {
      "id": 110504453570895875,
      "target": "Daughter: С дълга коса и дълго палто."
    },
    {
      "id": 110504453570895874,
      "target": "Daughter: На едно място някакъв чичко насочи оръжие към мен и татко."
    },
    {
      "id": 110504453570895873,
      "target": "Daughter: Веднъж с татко отидохме на пазара."
    },
    {
      "id": 110504453570895872,
      "target": "Daughter: О, сетих се!"
    },
    {
      "id": 110504453566701575,
      "target": "Daughter: Май не."
    },
    {
      "id": 110504453566701574,
      "target": "Изслушай"
    }
  ]
}
