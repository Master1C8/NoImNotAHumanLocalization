  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504454418145284,
      "target": "Widow: Той още ме чува."
    },
    {
      "id": 110504454418145283,
      "target": "Widow: Не, не е така."
    },
    {
      "id": 110504454418145282,
      "target": "Widow: Не."
    },
    {
      "id": 110504454418145281,
      "target": "Widow: …"
    },
    {
      "id": 110504454418145280,
      "target": "Widow: Няма да го дам на бездушната земя."
    },
    {
      "id": 110504454413950982,
      "target": "Widow: Не мога така."
    },
    {
      "id": 110504454413950981,
      "target": "Widow: И отново да се разделя с него."
    },
    {
      "id": 110504454413950980,
      "target": "Widow: Върнаха ми го едва наскоро."
    },
    {
      "id": 110504454413950979,
      "target": "Widow: Не съм готова."
    },
    {
      "id": 110504454413950978,
      "target": "Widow: Не-не-не-не."
    },
    {
      "id": 110504454413950977,
      "target": "Widow: Не-е-е-е."
    },
    {
      "id": 110504454413950976,
      "target": "От него е останало само тялото. Трябва да го приемеш"
    },
    {
      "id": 110504454409756678,
      "target": "Трябва да го погребеш"
    },
    {
      "id": 110504454409756677,
      "target": "Widow: Просто да спра да плача."
    },
    {
      "id": 110504454409756676,
      "target": "Widow: Но правилно ли е?"
    },
    {
      "id": 110504454409756675,
      "target": "Widow: Сякаш вече нямам с какво да плача."
    },
    {
      "id": 110504454409756674,
      "target": "Widow: Сълзите ми едва наскоро пресъхнаха."
    },
    {
      "id": 110504454409756673,
      "target": "Widow: Това е прекалено."
    },
    {
      "id": 110504454409756672,
      "target": "Widow: Засега не мога."
    },
    {
      "id": 110504454405562379,
      "target": "Трябва да те проверя"
    },
    {
      "id": 110504454405562378,
      "target": "Как умря той?"
    },
    {
      "id": 110504454405562377,
      "target": "Widow: Да си почина малко…"
    },
    {
      "id": 110504454405562376,
      "target": "Widow: Какво да правя?"
    },
    {
      "id": 110504454405562375,
      "target": "Widow: Не мога да те…"
    },
    {
      "id": 110504454405562374,
      "target": "Widow: …"
    },
    {
      "id": 110504454405562373,
      "target": "Widow: Да те погреба…"
    },
    {
      "id": 110504454405562372,
      "target": "Widow: Аз дори…"
    },
    {
      "id": 110504454405562371,
      "target": "Widow: Няма да ми върнеш никого."
    },
    {
      "id": 110504454405562370,
      "target": "Widow: Искам да бъда с него."
    },
    {
      "id": 110504454405562369,
      "target": "Widow: Защо правиш така?"
    },
    {
      "id": 110504454405562368,
      "target": "Widow: Точно така, сега аз сама да оцелявам."
    },
    {
      "id": 110504454401368071,
      "target": "Widow: И умря."
    },
    {
      "id": 110504454401368070,
      "target": "Widow: …"
    },
    {
      "id": 110504454401368069,
      "target": "Widow: Каза, че всичко ще бъде наред."
    },
    {
      "id": 110504454401368068,
      "target": "Widow: Нали обеща, че всичко ще бъде наред."
    },
    {
      "id": 110504454401368067,
      "target": "Widow: Защо умря?"
    },
    {
      "id": 110504454401368066,
      "target": "Widow: …"
    },
    {
      "id": 110504454401368065,
      "target": "Да поседя ли с теб?"
    },
    {
      "id": 110504454401368064,
      "target": "Засега ще те оставя тук"
    },
    {
      "id": 110504454397173767,
      "target": "Widow: Искам да поседя."
    }
  ]
}
