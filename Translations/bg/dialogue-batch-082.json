  "entries": [
    {
      "id": 110504456779538441,
      "target": "Как сам оцеля през цялото това време?"
    },
    {
      "id": 110504456779538440,
      "target": "Колко къщи смени?"
    },
    {
      "id": 110504456779538439,
      "target": "Wolfhound: Който твърди, че не е от тези хора, утре вече ще е мъртъв."
    },
    {
      "id": 110504456779538438,
      "target": "Wolfhound: Сега редът е нов — по-силният е прав."
    },
    {
      "id": 110504456779538437,
      "target": "Wolfhound: Ако дълго го отричаш, ще те изядат жив. Няма да оставят и кост."
    },
    {
      "id": 110504456779538436,
      "target": "Wolfhound: Всички сме точно такива зверове."
    },
    {
      "id": 110504456779538435,
      "target": "Как сам оцеля през цялото това време?"
    },
    {
      "id": 110504456779538434,
      "target": "Колко къщи смени?"
    },
    {
      "id": 110504456779538433,
      "target": "Wolfhound: По-силният е прав. Ако можеш да разкъсаш другите, значи си победил и си наложил ред."
    },
    {
      "id": 110504456779538432,
      "target": "Wolfhound: Тия ваши обществени норми и всякакви други шибани простотии вече не важат."
    },
    {
      "id": 110504456775344139,
      "target": "Wolfhound: Не си ли бил в домовете на други хора? Навън, на улицата?"
    },
    {
      "id": 110504456775344138,
      "target": "И ти ли си от тези зверове?"
    },
    {
      "id": 110504456775344137,
      "target": "За какво говориш?"
    },
    {
      "id": 110504456775344136,
      "target": "Wolfhound: Най-сетне никой не се преструва."
    },
    {
      "id": 110504456775344135,
      "target": "Wolfhound: Какво общество е това? Зверовете наоколо се показаха."
    },
    {
      "id": 110504456775344134,
      "target": "Wolfhound: Ужас какво става. Видя ли?"
    },
    {
      "id": 110504456775344133,
      "target": "Wolfhound: Здрасти."
    },
    {
      "id": 110504456775344132,
      "target": "SuperFake: Защо тогава се съпротивляваш?"
    },
    {
      "id": 110504456775344131,
      "target": "SuperFake: ЗНАМ, че скоро всичко ще се реши."
    },
    {
      "id": 110504456775344130,
      "target": "SuperFake: За какво се вкопчваш?"
    },
    {
      "id": 110504456775344129,
      "target": "SuperFake: Защо?"
    },
    {
      "id": 110504456775344128,
      "target": "SuperFake: Все бягаш. От хората ми, от проблемите."
    },
    {
      "id": 110504456771149835,
      "target": "SuperFake: Затова съм тук."
    },
    {
      "id": 110504456771149834,
      "target": "SuperFake: Не си готов да вземеш нещата в свои ръце."
    },
    {
      "id": 110504456771149833,
      "target": "SuperFake: Даааа."
    },
    {
      "id": 110504456771149832,
      "target": "SuperFake: Изпитваш ли страх?"
    },
    {
      "id": 110504456771149831,
      "target": "SuperFake: …"
    },
    {
      "id": 110504456771149830,
      "target": "SuperFake: И все пак си готов."
    },
    {
      "id": 110504456771149829,
      "target": "Махнах няколко излишни от къщата"
    },
    {
      "id": 110504456771149828,
      "target": "Махнах всички излишни от къщата"
    },
    {
      "id": 110504456771149827,
      "target": "Пусках само когото трябваше"
    },
    {
      "id": 110504456771149826,
      "target": "В къщата има много нечовеци"
    },
    {
      "id": 110504456771149825,
      "target": "Не съм пускал никого"
    },
    {
      "id": 110504456771149824,
      "target": "В къщата има много хора"
    },
    {
      "id": 110504456766955531,
      "target": "SuperFake: Има ли сега мои хора в къщата ти?"
    },
    {
      "id": 110504456766955530,
      "target": "SuperFake: А мен ме интересува друго."
    },
    {
      "id": 110504456766955529,
      "target": "SuperFake: …"
    },
    {
      "id": 110504456766955528,
      "target": "SuperFake: Ще почувстваш ли нещо?"
    },
    {
      "id": 110504456766955527,
      "target": "SuperFake: Просто изчезваш? Завинаги?"
    },
    {
      "id": 110504456766955526,
      "target": "SuperFake: Ето, умираш. А после?"
    }
  ]
}
