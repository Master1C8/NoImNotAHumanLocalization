  "sourceInventorySha256": "ecd96645c2ca6f23f8bf3ab2fcf65709e961478ae15a38e83d94cc335a408bf0",
  "glossaryFingerprint": "28d7eb651d95b56a72a5a4acefcba5f434dcbe6925a2233126655e13b0e01cab",
  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504452690092034,
      "target": "Hunter: Или наистина се паникьоса?"
    },
    {
      "id": 110504452690092033,
      "target": "Hunter: А какво те усъмни? Нали уж не отговарям на признаците."
    },
    {
      "id": 110504452690092032,
      "target": "Hunter: За малко да повярвам, че ще стреляш."
    },
    {
      "id": 110504452685897738,
      "target": "Hunter: Никога не прави прибързани изводи. На лов така винаги се стига до това да те разкъсат."
    },
    {
      "id": 110504452685897737,
      "target": "Hunter: Ето така е правилно."
    },
    {
      "id": 110504452685897736,
      "target": "Hunter: Да вървим на лов за тях."
    },
    {
      "id": 110504452685897735,
      "target": "Hunter: И ти ли ще давиш Гости тази нощ?"
    },
    {
      "id": 110504452685897734,
      "target": "Hunter: Че как иначе!"
    },
    {
      "id": 110504452685897733,
      "target": "Hunter: Добре, че се осъзна навреме."
    },
    {
      "id": 110504452685897732,
      "target": "Hunter: Но трябва да избиваме Гостите, не един друг."
    },
    {
      "id": 110504452685897731,
      "target": "Hunter: Разбирам те, стрес и всичко останало."
    },
    {
      "id": 110504452685897730,
      "target": "Изслушай"
    },
    {
      "id": 110504452685897729,
      "target": "Стреляй"
    },
    {
      "id": 110504452685897728,
      "target": "Hunter: Интересен извод. А как стигна до него?"
    },
    {
      "id": 110504452681703435,
      "target": "Hunter: Аха. Значи аз съм Гостът?"
    },
    {
      "id": 110504452681703434,
      "target": "Изслушай"
    },
    {
      "id": 110504452681703433,
      "target": "Стреляй"
    },
    {
      "id": 110504452681703432,
      "target": "Hunter: Това ли беше?"
    },
    {
      "id": 110504452681703431,
      "target": "Hunter: ОЙ!"
    },
    {
      "id": 110504452681703430,
      "target": "Hunter: ..."
    },
    {
      "id": 110504452681703429,
      "target": "Hunter: Ще подскоча."
    },
    {
      "id": 110504452681703428,
      "target": "Hunter: Ох..."
    },
    {
      "id": 110504452681703427,
      "target": "Hunter: Снимай другите. Трепи Гостите. А мен ме остави на мира, мамка му."
    },
    {
      "id": 110504452681703426,
      "target": "Hunter: Мамка му, разкарай се, няма да ме накараш."
    },
    {
      "id": 110504452681703425,
      "target": "Изслушай"
    },
    {
      "id": 110504452681703424,
      "target": "Стреляй"
    },
    {
      "id": 110504452677509130,
      "target": "Hunter: Параноята само помага на тези чудовища. Успокой се, добре?"
    },
    {
      "id": 110504452677509129,
      "target": "Hunter: Не бива да полудяваме."
    },
    {
      "id": 110504452677509128,
      "target": "Изслушай"
    },
    {
      "id": 110504452677509127,
      "target": "Стреляй"
    },
    {
      "id": 110504452677509126,
      "target": "Hunter: Не прави прибързани изводи. Така винаги можеш да сбъркаш."
    },
    {
      "id": 110504452677509125,
      "target": "Hunter: Чакай, какво те разтревожи? Какво ти става, момче?"
    },
    {
      "id": 110504452677509124,
      "target": "Hunter: Хайде, покажи ми поне една болница, която още работи както трябва! После ела да ми гледаш очите."
    },
    {
      "id": 110504452677509123,
      "target": "Hunter: Ебати, вече избиваш ли и всички без ръце? Те няма как да ти покажат ноктите си!"
    },
    {
      "id": 110504452677509122,
      "target": "Изслушай"
    },
    {
      "id": 110504452677509121,
      "target": "Стреляй"
    },
    {
      "id": 110504452677509120,
      "target": "Hunter: Поне аз нощем оглеждам прозорците, за да не се приближи някой Гост. Сам ще ти е по-трудно."
    },
    {
      "id": 110504452673314827,
      "target": "Hunter: Поеми си дъх, че да не натиснеш случайно спусъка."
    },
    {
      "id": 110504452673314826,
      "target": "Изслушай"
    },
    {
      "id": 110504452673314825,
      "target": "Стреляй"
    }
  ]
}
