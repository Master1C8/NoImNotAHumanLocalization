  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504454397173766,
      "target": "Widow: Аз съм тук…"
    },
    {
      "id": 110504454397173765,
      "target": "Widow: Не съм гладна."
    },
    {
      "id": 110504454397173764,
      "target": "Да поседя ли с теб?"
    },
    {
      "id": 110504454397173763,
      "target": "Засега ще те оставя тук"
    },
    {
      "id": 110504454397173762,
      "target": "Widow: Ще пия, ако се наложи."
    },
    {
      "id": 110504454397173761,
      "target": "Widow: Седя до крана."
    },
    {
      "id": 110504454397173760,
      "target": "Widow: Аз съм тук…"
    },
    {
      "id": 110504454392979464,
      "target": "Да ти дам ли нещо за ядене?"
    },
    {
      "id": 110504454392979463,
      "target": "Да ти донеса ли вода?"
    },
    {
      "id": 110504454392979462,
      "target": "Widow: Вече не ми трябва нищо."
    },
    {
      "id": 110504454392979461,
      "target": "Widow: Аз изобщо…"
    },
    {
      "id": 110504454392979460,
      "target": "Widow: Той да е жив."
    },
    {
      "id": 110504454392979459,
      "target": "Widow: …"
    },
    {
      "id": 110504454392979458,
      "target": "Трябва да те проверя"
    },
    {
      "id": 110504454392979457,
      "target": "Имаш ли нужда от нещо?"
    },
    {
      "id": 110504454392979456,
      "target": "Widow: Да си почина малко…"
    },
    {
      "id": 110504454388785163,
      "target": "Esenin: Защо изобщо дойдох тук?.."
    },
    {
      "id": 110504454388785162,
      "target": "Esenin: Просто не издържам."
    },
    {
      "id": 110504454388785161,
      "target": "Esenin: Това е пълен ад. Всичко ме плаши до осиране."
    },
    {
      "id": 110504454388785160,
      "target": "Esenin: Стопанино, искам само всичко това да свърши."
    },
    {
      "id": 110504454388785159,
      "target": "Esenin: Тясно ми е у вас. Изобщо ми е тясно на тази планета."
    },
    {
      "id": 110504454388785158,
      "target": "Esenin: Там можеше да се обеся."
    },
    {
      "id": 110504454388785157,
      "target": "Esenin: В пъба поне имаше висок таван."
    },
    {
      "id": 110504454388785156,
      "target": "Трябва да те проверя"
    },
    {
      "id": 110504454388785155,
      "target": "Ти… добре ли си?"
    },
    {
      "id": 110504454388785154,
      "target": "Esenin: Да? Искаше ли нещо?"
    },
    {
      "id": 110504454388785153,
      "target": "Esenin: Аз… искам да бъда сам."
    },
    {
      "id": 110504454388785152,
      "target": "Esenin: Празното пространство на безкрайния мрак. Ако след смъртта попаднем там, все едно изчезваме…"
    },
    {
      "id": 110504454384590859,
      "target": "Esenin: Сигурно, ако имаше нещо, вече щяхме да уловим някакъв сигнал или нещо подобно. Не знам."
    },
    {
      "id": 110504454384590858,
      "target": "Esenin: Няма друг живот. Само празен, студен космос."
    },
    {
      "id": 110504454384590857,
      "target": "Esenin: В космоса освен нас няма нищо."
    },
    {
      "id": 110504454384590856,
      "target": "Esenin: А като се замислиш…"
    },
    {
      "id": 110504454384590855,
      "target": "Esenin: Сега не ми се говори."
    },
    {
      "id": 110504454384590854,
      "target": "Esenin: Изобщо няма да има нищо… Просто… тъмнина?"
    },
    {
      "id": 110504454384590853,
      "target": "Esenin: Може и да си прав. Но е толкова ужасяващо."
    },
    {
      "id": 110504454384590852,
      "target": "Esenin: Толкова ми се искаше да кажеш друго."
    },
    {
      "id": 110504454384590851,
      "target": "Esenin: …"
    },
    {
      "id": 110504454384590850,
      "target": "Esenin: Не, стопанино. Не ми стана по-спокойно."
    },
    {
      "id": 110504454384590849,
      "target": "Esenin: …"
    },
    {
      "id": 110504454384590848,
      "target": "Esenin: А когато силите за този сън свършат, тогава какво?"
    }
  ]
}
