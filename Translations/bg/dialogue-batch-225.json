  "entries": [
    {
      "id": 110504454783049737,
      "target": "Buddy: Да не си решил да ме гръмнеш, приятелче?"
    },
    {
      "id": 110504454783049736,
      "target": "И какво?"
    },
    {
      "id": 110504454783049735,
      "target": "И какво толкова?"
    },
    {
      "id": 110504454783049734,
      "target": "Buddy: Имах куче и преди няколко дни… тя умря."
    },
    {
      "id": 110504454783049733,
      "target": "Buddy: Всъщност… Повече не мога така."
    },
    {
      "id": 110504454783049732,
      "target": "Buddy: …"
    },
    {
      "id": 110504454783049731,
      "target": "Buddy: Не мога… Ще ме гледаш накриво."
    },
    {
      "id": 110504454783049730,
      "target": "Ще трябва да разкажеш. Иначе ще стане по-лошо"
    },
    {
      "id": 110504454783049729,
      "target": "Просто ми кажи какво ти е"
    },
    {
      "id": 110504454783049728,
      "target": "Buddy: Не е твоя работа, приятелче! Остави ме на мира!"
    },
    {
      "id": 110504454778855434,
      "target": "Трябва да те проверя"
    },
    {
      "id": 110504454778855433,
      "target": "Разкажи какво ти е"
    },
    {
      "id": 110504454778855432,
      "target": "Buddy: Питай, приятелче."
    },
    {
      "id": 110504454778855431,
      "target": "Buddy: Благодаря, наистина не ми е спокойно."
    },
    {
      "id": 110504454778855430,
      "target": "Buddy: Остави ме."
    },
    {
      "id": 110504454778855429,
      "target": "Buddy: Не ме притискай! И без това ми е тежко на душата."
    },
    {
      "id": 110504454778855428,
      "target": "Добре, няма да се бъркам"
    },
    {
      "id": 110504454778855427,
      "target": "Трябва да знам"
    },
    {
      "id": 110504454778855426,
      "target": "Buddy: Слушай, наистина не искам да говоря за това."
    },
    {
      "id": 110504454778855425,
      "target": "Добре, няма да се бъркам"
    },
    {
      "id": 110504454778855424,
      "target": "Трябва да знам"
    },
    {
      "id": 110504454774661130,
      "target": "Buddy: Няма значение, така или иначе няма да ме разбереш."
    },
    {
      "id": 110504454774661129,
      "target": "За какво говориш?"
    },
    {
      "id": 110504454774661128,
      "target": "Каква тема?"
    },
    {
      "id": 110504454774661127,
      "target": "Buddy: Не искам да повдигам тази тема."
    },
    {
      "id": 110504454774661126,
      "target": "Buddy: …"
    },
    {
      "id": 110504454774661125,
      "target": "Buddy: Аз…"
    },
    {
      "id": 110504454774661124,
      "target": "Трябва да те проверя"
    },
    {
      "id": 110504454774661123,
      "target": "Май си мрачен днес"
    },
    {
      "id": 110504454774661122,
      "target": "Buddy: Питай, приятелче."
    },
    {
      "id": 110504454774661121,
      "target": "Buddy: Няма значение, просто се замислих."
    },
    {
      "id": 110504454774661120,
      "target": "Buddy: …"
    },
    {
      "id": 110504454770466825,
      "target": "Buddy: Хм…"
    },
    {
      "id": 110504454770466824,
      "target": "Buddy: Не, аз просто…"
    },
    {
      "id": 110504454770466823,
      "target": "Buddy: Няма значение, забрави."
    },
    {
      "id": 110504454770466822,
      "target": "Buddy: …"
    },
    {
      "id": 110504454770466821,
      "target": "Buddy: А? Какво?"
    },
    {
      "id": 110504454770466820,
      "target": "Защо си застинал така?"
    },
    {
      "id": 110504454770466819,
      "target": "Всичко наред ли е?"
    },
    {
      "id": 110504454770466818,
      "target": "Buddy: …"
    }
  ]
}
