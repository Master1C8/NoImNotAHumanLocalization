  "sourceInventorySha256": "ecd96645c2ca6f23f8bf3ab2fcf65709e961478ae15a38e83d94cc335a408bf0",
  "glossaryFingerprint": "28d7eb651d95b56a72a5a4acefcba5f434dcbe6925a2233126655e13b0e01cab",
  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504452673314824,
      "target": "Hunter: Ебати."
    },
    {
      "id": 110504452673314823,
      "target": "Hunter: Чакай, и сега какво?"
    },
    {
      "id": 110504452673314822,
      "target": "Извади пушката"
    },
    {
      "id": 110504452673314821,
      "target": "Пусни го"
    },
    {
      "id": 110504452673314820,
      "target": "Hunter: Само да разберем за какво изобщо да гледаме."
    },
    {
      "id": 110504452673314819,
      "target": "Hunter: Е, какво има там? Какво, вижда ли се нещо? Какво, какво има?"
    },
    {
      "id": 110504452673314818,
      "target": "Hunter: ..."
    },
    {
      "id": 110504452673314817,
      "target": "Hunter: Да, и аз гледах този новинарски репортаж. Хайде да видим, добре."
    },
    {
      "id": 110504452673314816,
      "target": "Извади пушката"
    },
    {
      "id": 110504452669120521,
      "target": "Пусни го"
    },
    {
      "id": 110504452669120520,
      "target": "Hunter: Няма да се снимам."
    },
    {
      "id": 110504452669120519,
      "target": "Hunter: Светкавицата ми напомня за буря и веднага ме хваща паника."
    },
    {
      "id": 110504452669120518,
      "target": "Hunter: Абе не обичам много да се снимам."
    },
    {
      "id": 110504452669120517,
      "target": "Извади пушката"
    },
    {
      "id": 110504452669120516,
      "target": "Пусни го"
    },
    {
      "id": 110504452669120515,
      "target": "Hunter: Аз съм нормален мъж, как иначе?"
    },
    {
      "id": 110504452669120514,
      "target": "Hunter: ..."
    },
    {
      "id": 110504452669120513,
      "target": "Hunter: Чудесно, колкото повече признаци има, толкова по-лесно ще отличим своите от Гостите. Нали?"
    },
    {
      "id": 110504452669120512,
      "target": "Извади пушката"
    },
    {
      "id": 110504452664926217,
      "target": "Пусни го"
    },
    {
      "id": 110504452664926216,
      "target": "Hunter: Тогава пак ще живеем спокойно."
    },
    {
      "id": 110504452664926215,
      "target": "Hunter: Но ще ги настигна всичките. Ще ги разкъсам с ръце."
    },
    {
      "id": 110504452664926214,
      "target": "Hunter: ..."
    },
    {
      "id": 110504452664926213,
      "target": "Hunter: ..."
    },
    {
      "id": 110504452664926212,
      "target": "Hunter: Сега, разбира се, от такъв живот на всички ни остават само сиви очи."
    },
    {
      "id": 110504452664926211,
      "target": "Hunter: Ай-ай, боли, по-внимателно."
    },
    {
      "id": 110504452664926210,
      "target": "Hunter: ..."
    },
    {
      "id": 110504452664926209,
      "target": "Hunter: Когато убивах един Гост, той ми хвърли в очите нещо — пръст или някакви лайна. Оттогава постоянно ме болят."
    },
    {
      "id": 110504452664926208,
      "target": "Hunter: А след скорошния случай очите ми са само червени."
    },
    {
      "id": 110504452660731914,
      "target": "Hunter: Знаеш ли, някога очите ми имаха цвят."
    },
    {
      "id": 110504452660731913,
      "target": "Извади пушката"
    },
    {
      "id": 110504452660731912,
      "target": "Пусни го"
    },
    {
      "id": 110504452660731911,
      "target": "Hunter: Съветвам те да правиш същото."
    },
    {
      "id": 110504452660731910,
      "target": "Hunter: Така дори по-лесно се убиват!"
    },
    {
      "id": 110504452660731909,
      "target": "Hunter: Разбира се, че ръцете ми са мръсни, нощем ходя да изравям тези дяволи."
    },
    {
      "id": 110504452660731908,
      "target": "Hunter: ..."
    },
    {
      "id": 110504452660731907,
      "target": "Hunter: Хайде, хайде."
    },
    {
      "id": 110504452660731906,
      "target": "Извади пушката"
    },
    {
      "id": 110504452660731905,
      "target": "Пусни го"
    },
    {
      "id": 110504452660731904,
      "target": "Hunter: Кракът ми няма да стъпи при зъболекар. Вкъщи ме пребиха, разбира се, но така и не отидох на лекар."
    }
  ]
}
