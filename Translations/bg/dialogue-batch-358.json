    {
      "id": 110504452417462278,
      "target": "Blind: Как въздухът се раздвижва, когато ТО вдишва миризмата ти…"
    },
    {
      "id": 110504452417462277,
      "target": "Blind: Как стъпките МУ се смесват с твоите…"
    },
    {
      "id": 110504452417462276,
      "target": "Blind: Ако можеше да чуеш как се плъзга…"
    },
    {
      "id": 110504452417462275,
      "target": "Изслушай"
    },
    {
      "id": 110504452417462274,
      "target": "Стреляй"
    },
    {
      "id": 110504452417462273,
      "target": "Blind: А сега…"
    },
    {
      "id": 110504452417462272,
      "target": "Blind: А преди обичах снимките. Обичах да ги разглеждам. Всеки дребен детайл."
    },
    {
      "id": 110504452413267980,
      "target": "Изслушай"
    },
    {
      "id": 110504452413267979,
      "target": "Стреляй"
    },
    {
      "id": 110504452413267978,
      "target": "Blind: Усещам гъдел по цялото си тяло. Сякаш трябва да се разчесвам навсякъде, да си одера кожата. Непоносимо е…"
    },
    {
      "id": 110504452413267977,
      "target": "Изслушай"
    },
    {
      "id": 110504452413267976,
      "target": "Стреляй"
    },
    {
      "id": 110504452413267975,
      "target": "Blind: Погледът ти се привлича към тях и не можеш да се откъснеш, докато не си ги издереш напълно."
    },
    {
      "id": 110504452413267974,
      "target": "Изслушай"
    },
    {
      "id": 110504452413267973,
      "target": "Стреляй"
    },
    {
      "id": 110504452413267972,
      "target": "Blind: Насън сякаш мога да докосна това същество, да усетя какво е на допир, но после…"
    },
    {
      "id": 110504452413267971,
      "target": "Изслушай"
    },
    {
      "id": 110504452413267970,
      "target": "Стреляй"
    },
    {
      "id": 110504452413267969,
      "target": "Blind: Обикновено оръжие няма да ти помогне да се отървеш от това същество! Дори не знам какво би могло да ни спаси…"
    },
    {
      "id": 110504452413267968,
      "target": "Извади пушката"
    },
    {
      "id": 110504452409073674,
      "target": "Пусни го"
    },
    {
      "id": 110504452409073673,
      "target": "Blind: Тихо…"
    },
    {
      "id": 110504452409073672,
      "target": "Blind: ..."
    },
    {
      "id": 110504452409073671,
      "target": "Blind: Чу ли това?"
    },
    {
      "id": 110504452409073670,
      "target": "Извади пушката"
    },
    {
      "id": 110504452409073669,
      "target": "Пусни го"
    },
    {
      "id": 110504452409073668,
      "target": "Blind: Дори резултата няма да ми покажеш."
    },
    {
      "id": 110504452409073667,
      "target": "Blind: ..."
    },
    {
      "id": 110504452409073666,
      "target": "Blind: Хехе, може и със светкавица. Все ми е едно."
    },
    {
      "id": 110504452409073665,
      "target": "Извади пушката"
    },
    {
      "id": 110504452409073664,
      "target": "Пусни го"
    },
    {
      "id": 110504452404879370,
      "target": "Blind: Сега знам."
    },
    {
      "id": 110504452404879369,
      "target": "Blind: Не?"
    },
    {
      "id": 110504452404879368,
      "target": "Blind: Знаеш ли кое първо покрива лепкавата сянка?"
    },
    {
      "id": 110504452404879367,
      "target": "Blind: ..."
    },
    {
      "id": 110504452404879366,
      "target": "Blind: Ха… смешно."
