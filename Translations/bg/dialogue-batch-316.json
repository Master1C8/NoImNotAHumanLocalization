  "sourceInventorySha256": "ecd96645c2ca6f23f8bf3ab2fcf65709e961478ae15a38e83d94cc335a408bf0",
  "glossaryFingerprint": "28d7eb651d95b56a72a5a4acefcba5f434dcbe6925a2233126655e13b0e01cab",
  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504453164048387,
      "target": "Marauder: Слушай, дори да намерех някакъв мехлем за това, пак нямаше да се мажа, а щях да го продам."
    },
    {
      "id": 110504453164048386,
      "target": "Изслушай"
    },
    {
      "id": 110504453164048385,
      "target": "Стреляй"
    },
    {
      "id": 110504453164048384,
      "target": "Marauder: Е, какво не ти хареса? Може ли да обсъдим положението като цивилизовани хора?"
    },
    {
      "id": 110504453159854087,
      "target": "Изслушай"
    },
    {
      "id": 110504453159854086,
      "target": "Стреляй"
    },
    {
      "id": 110504453159854085,
      "target": "Marauder: Каква ирония: да убиеш мародер, защото е взел неща, които вече не трябват на никого. Ха-ха."
    },
    {
      "id": 110504453159854084,
      "target": "Изслушай"
    },
    {
      "id": 110504453159854083,
      "target": "Стреляй"
    },
    {
      "id": 110504453159854082,
      "target": "Marauder: Е, ако не може да се живее с развалени зъби — стреляй. Не знаех, че светът вече работи така."
    },
    {
      "id": 110504453159854081,
      "target": "Извади пушката"
    },
    {
      "id": 110504453159854080,
      "target": "Пусни го"
    },
    {
      "id": 110504453155659781,
      "target": "Marauder: Убеди ли се?"
    },
    {
      "id": 110504453155659780,
      "target": "Marauder: ..."
    },
    {
      "id": 110504453155659779,
      "target": "Marauder: Не е скъсано, не е нахапано като на бездомните. Съвсем обикновено ухо."
    },
    {
      "id": 110504453155659778,
      "target": "Извади пушката"
    },
    {
      "id": 110504453155659777,
      "target": "Пусни го"
    },
    {
      "id": 110504453155659776,
      "target": "Marauder: Дали машинката ти ще види какъв съм всъщност?"
    },
    {
      "id": 110504453151465480,
      "target": "Marauder: ..."
    },
    {
      "id": 110504453151465479,
      "target": "Marauder: Е, добре. Твоята къща — твоите правила…"
    },
    {
      "id": 110504453151465478,
      "target": "Marauder: Хайде стига. Защо ти е?"
    },
    {
      "id": 110504453151465477,
      "target": "Извади пушката"
    },
    {
      "id": 110504453151465476,
      "target": "Пусни го"
    },
    {
      "id": 110504453151465475,
      "target": "Marauder: Има раздразнение, да. Малко боли. Но какво да се прави при тези условия?"
    },
    {
      "id": 110504453151465474,
      "target": "Marauder: ..."
    },
    {
      "id": 110504453151465473,
      "target": "Marauder: Мда, пък уж аз не можех да се разбирам с хората…"
    },
    {
      "id": 110504453151465472,
      "target": "Извади пушката"
    },
    {
      "id": 110504453147271173,
      "target": "Пусни го"
    },
    {
      "id": 110504453147271172,
      "target": "Marauder: Нищо особено, виждаш ли?"
    },
    {
      "id": 110504453147271171,
      "target": "Marauder: ..."
    },
    {
      "id": 110504453147271170,
      "target": "Marauder: Очите ми са си съвсем обикновени."
    },
    {
      "id": 110504453147271169,
      "target": "Извади пушката"
    },
    {
      "id": 110504453147271168,
      "target": "Пусни го"
    },
    {
      "id": 110504453143076871,
      "target": "Marauder: И нищо от това вече не ми принадлежи. Може би така е по-добре. Поне оцелях."
    },
    {
      "id": 110504453143076870,
      "target": "Marauder: Но знаеш ли кое е смешното? Тези пръсти са пипали толкова ценности, толкова скъпи неща са минали през тях…"
    },
    {
      "id": 110504453143076869,
      "target": "Marauder: Ноктите ми не са първа свежест. Мда…"
    },
    {
      "id": 110504453143076868,
      "target": "Marauder: Ноктите ми не са първа свежест. Не виждам смисъл да ги чистя, щом пак ще ги изцапам."
    },
    {
      "id": 110504453143076867,
      "target": "Marauder: ..."
    },
    {
      "id": 110504453143076866,
      "target": "Marauder: Дланчици, дланчици."
    },
    {
      "id": 110504453143076865,
      "target": "Извади пушката"
    }
  ]
}
