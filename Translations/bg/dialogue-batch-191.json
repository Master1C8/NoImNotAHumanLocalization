  "sourceInventorySha256": "ecd96645c2ca6f23f8bf3ab2fcf65709e961478ae15a38e83d94cc335a408bf0",
  "glossaryFingerprint": "28d7eb651d95b56a72a5a4acefcba5f434dcbe6925a2233126655e13b0e01cab",
  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504455265394688,
      "target": "Edgar: Харесвах едно момиче."
    },
    {
      "id": 110504455261200395,
      "target": "Edgar: …"
    },
    {
      "id": 110504455261200394,
      "target": "Edgar: Но така и трябва да бъде. Искам да отложа най-красивия миг."
    },
    {
      "id": 110504455261200393,
      "target": "Edgar: От известно време не усещам нищо с тази ръка, макар че постоянно ме боли и ме втрисва."
    },
    {
      "id": 110504455261200392,
      "target": "Трябва да те проверя"
    },
    {
      "id": 110504455261200391,
      "target": "Как е ръката?"
    },
    {
      "id": 110504455261200390,
      "target": "Edgar: Каква успокояваща тишина…"
    },
    {
      "id": 110504455261200389,
      "target": "Foreigner: Късмеет!"
    },
    {
      "id": 110504455261200388,
      "target": "Foreigner: Спчш юх дш мх югщя к щпся мтшщ лптупья ьншсш…"
    },
    {
      "id": 110504455261200387,
      "target": "Foreigner: Рп клнш дш плхщя ря ъяняля х мяс дш няцюшня!"
    },
    {
      "id": 110504455261200386,
      "target": "Foreigner: Рш няцюняи, хцьхраьяф."
    },
    {
      "id": 110504455261200385,
      "target": "Заминаваш ли някъде?"
    },
    {
      "id": 110504455261200384,
      "target": "За влака ли говориш?"
    },
    {
      "id": 110504455257006091,
      "target": "Foreigner: Чааао!"
    },
    {
      "id": 110504455257006090,
      "target": "Foreigner: Ляцх рпд мх лнгъьяс. Жяп!"
    },
    {
      "id": 110504455257006089,
      "target": "Foreigner: Клнш дш лнгъря угс щпся! Опрш дш плхщя ря ъяняля."
    },
    {
      "id": 110504455257006088,
      "target": "Foreigner: Рш няцюхняс, онхалштб."
    },
    {
      "id": 110504455257006087,
      "target": "Трябва да те проверя"
    },
    {
      "id": 110504455257006086,
      "target": "Могат ли да те откарат с кола?"
    },
    {
      "id": 110504455257006085,
      "target": "Foreigner: …"
    },
    {
      "id": 110504455257006084,
      "target": "Foreigner: (Събеседникът протяга едната си ръка напред и прокарва другата по нея.)"
    },
    {
      "id": 110504455257006083,
      "target": "Foreigner: Кмоаия щя сх пюамрал, жш ьтяупьшлш пдш ьгньал! Оншщмляьае тх мх?"
    },
    {
      "id": 110504455257006082,
      "target": "Foreigner: Я, ця лпья ъпьпнхе."
    },
    {
      "id": 110504455257006081,
      "target": "Foreigner: (Усмихвате се и посочвате с пръст усмивката си, после събеседника.)"
    },
    {
      "id": 110504455257006080,
      "target": "Трябва да те проверя"
    },
    {
      "id": 110504455252811787,
      "target": "Защо си толкова доволен?"
    },
    {
      "id": 110504455252811786,
      "target": "Foreigner: …"
    },
    {
      "id": 110504455252811785,
      "target": "Foreigner: Пдш тх отяьял? Лнаюья щя оплгнма хрйпнсязха, ютяъпщяна!"
    },
    {
      "id": 110504455252811784,
      "target": "Foreigner: Лпшмл щя цясхря м упняю?"
    },
    {
      "id": 110504455252811783,
      "target": "Foreigner: …"
    },
    {
      "id": 110504455252811782,
      "target": "Foreigner: (С ръка изобразявате кораб, който плава по вълните.)"
    },
    {
      "id": 110504455252811781,
      "target": "Foreigner: Спчш юх пдш ряхмлхря спчш щя мш плтшлх."
    },
    {
      "id": 110504455252811780,
      "target": "Foreigner: Лнаюья щя рясшна хрйпнсязха раугщш."
    },
    {
      "id": 110504455252811779,
      "target": "Foreigner: Мясптшл? Схмтхе тх, жш пдш тшлал?"
    },
    {
      "id": 110504455252811778,
      "target": "Foreigner: …"
    },
    {
      "id": 110504455252811777,
      "target": "Foreigner: (С ръка изобразявате пикиране.)"
    },
    {
      "id": 110504455252811776,
      "target": "Провери ли билети за кораб?"
    },
    {
      "id": 110504455248617484,
      "target": "Как да те изпратим у дома? Със самолет?"
    },
    {
      "id": 110504455248617483,
      "target": "Foreigner: Оптпчшрхшлп ш огтшр ехюяр кчям, хряжш рш спъя щя ъп похея."
    },
    {
      "id": 110504455248617482,
      "target": "Foreigner: Щпфщпи ря ъпмлх ря онхалшт, я мшъя лпья."
    }
  ]
}
