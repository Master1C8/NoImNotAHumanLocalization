  "entries": [
    {
      "id": 110504455953260555,
      "target": "Ама това е някаква простотия"
    },
    {
      "id": 110504455953260554,
      "target": "…"
    },
    {
      "id": 110504455953260553,
      "target": "Аз съм щастлив човек!"
    },
    {
      "id": 110504455953260552,
      "target": "FortuneTeller: Продължавай."
    },
    {
      "id": 110504455953260551,
      "target": "Ама това е някаква простотия"
    },
    {
      "id": 110504455953260550,
      "target": "…"
    },
    {
      "id": 110504455953260549,
      "target": "Аз съм щастлив човек!"
    },
    {
      "id": 110504455953260548,
      "target": "FortuneTeller: Повтаряй след мен: аз съм щастлив човек!"
    },
    {
      "id": 110504455953260547,
      "target": "FortuneTeller: Но стига думи — да преминем към практиката."
    },
    {
      "id": 110504455953260546,
      "target": "FortuneTeller: Е, добре, не се предавай на унинието. Редовните афирмации за щастие ще ти помогнат."
    },
    {
      "id": 110504455953260545,
      "target": "FortuneTeller: Странно, трябваше да помогне."
    },
    {
      "id": 110504455953260544,
      "target": "FortuneTeller: …"
    },
    {
      "id": 110504455949066252,
      "target": "FortuneTeller: Какво, не помогна ли?"
    },
    {
      "id": 110504455949066251,
      "target": "Какво, мамка му?"
    },
    {
      "id": 110504455949066250,
      "target": "А трябваше ли?"
    },
    {
      "id": 110504455949066249,
      "target": "FortuneTeller: Е, помогна ли? Вече усещаш ли прилив на щастие?"
    },
    {
      "id": 110504455949066248,
      "target": "FortuneTeller: …"
    },
    {
      "id": 110504455949066247,
      "target": "FortuneTeller: ДА ИЗПЪЛНИМ ТАНЦА НА КОЗИРОГА!"
    },
    {
      "id": 110504455949066246,
      "target": "FortuneTeller: Само трябва…"
    },
    {
      "id": 110504455949066245,
      "target": "FortuneTeller: Знаеш ли, май знам какво може да ти помогне да раздвижиш енергията."
    },
    {
      "id": 110504455949066244,
      "target": "FortuneTeller: …"
    },
    {
      "id": 110504455949066243,
      "target": "Esenin: Добре, както кажеш."
    },
    {
      "id": 110504455949066242,
      "target": "Esenin: …"
    },
    {
      "id": 110504455949066241,
      "target": "Esenin: Благодаря, че ме изслуша, стопанино."
    },
    {
      "id": 110504455949066240,
      "target": "Esenin: Знаеш ли, дори малко ми олекна."
    },
    {
      "id": 110504455944871945,
      "target": "Esenin: …"
    },
    {
      "id": 110504455944871944,
      "target": "Стих като стих"
    },
    {
      "id": 110504455944871943,
      "target": "Красиво"
    },
    {
      "id": 110504455944871942,
      "target": "Esenin: Ето такъв стих. Как ти се струва?"
    },
    {
      "id": 110504455944871941,
      "target": "Не, благодаря"
    },
    {
      "id": 110504455944871940,
      "target": "Разбира се"
    },
    {
      "id": 110504455944871939,
      "target": "Esenin: Стопанино, имаш ли нещо против да прочета едно стихотворение?"
    },
    {
      "id": 110504455944871938,
      "target": "Esenin: Намерих у теб една книжка със стихове."
    },
    {
      "id": 110504455944871937,
      "target": "Esenin: …"
    },
    {
      "id": 110504455944871936,
      "target": ">>"
    },
    {
      "id": 110504455940677643,
      "target": "WheelChair: Добре, тръгвам. Но ще си взема количката."
    },
    {
      "id": 110504455940677642,
      "target": "WheelChair: …"
    },
    {
      "id": 110504455940677641,
      "target": "WheelChair: Мамка му, какво ти става?"
    },
    {
      "id": 110504455940677640,
      "target": "WheelChair: Затова пък на мен ми е кеф. От живота трябва да вземаш всичко."
    },
    {
      "id": 110504455940677639,
      "target": "WheelChair: Е, добре тогава."
    }
  ]
}
