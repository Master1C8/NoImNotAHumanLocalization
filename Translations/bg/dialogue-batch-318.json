  "entries": [
    {
      "id": 110504453122105351,
      "target": "Изслушай"
    },
    {
      "id": 110504453122105350,
      "target": "Стреляй"
    },
    {
      "id": 110504453122105349,
      "target": "Provocateur: Сериозно!? А сега какво не е наред?"
    },
    {
      "id": 110504453122105348,
      "target": "Изслушай"
    },
    {
      "id": 110504453122105347,
      "target": "Стреляй"
    },
    {
      "id": 110504453122105346,
      "target": "Provocateur: А сега пък какво не е наред?"
    },
    {
      "id": 110504453122105345,
      "target": "Provocateur: Какви ги говорите, по дяволите!? Мръсотията под ноктите вече означава, че съм Гост?"
    },
    {
      "id": 110504453122105344,
      "target": "Изслушай"
    },
    {
      "id": 110504453117911045,
      "target": "Стреляй"
    },
    {
      "id": 110504453117911044,
      "target": "Provocateur: Хайде, стреляйте. Чистите зъби със сигурност доказват, че съм Гост."
    },
    {
      "id": 110504453117911043,
      "target": "Provocateur: Естествено, не очаквах нищо друго от вас."
    },
    {
      "id": 110504453117911042,
      "target": "Извади пушката"
    },
    {
      "id": 110504453117911041,
      "target": "Пусни го"
    },
    {
      "id": 110504453117911040,
      "target": "Provocateur: Иска ти се да играеш на доктор? Е, намерихте ли тапи от ушна кал? Какво ще предпишете, господин докторе?"
    },
    {
      "id": 110504453113716744,
      "target": "Provocateur: ..."
    },
    {
      "id": 110504453113716743,
      "target": "Provocateur: А ако кажат, че окосмяването по слабините е нов признак, ще смъквате ли панталоните на всички!?"
    },
    {
      "id": 110504453113716742,
      "target": "Provocateur: Боже, вие вярвате ли на всичко, което казват по телевизията?"
    },
    {
      "id": 110504453113716741,
      "target": "Извади пушката"
    },
    {
      "id": 110504453113716740,
      "target": "Пусни го"
    },
    {
      "id": 110504453113716739,
      "target": "Provocateur: ..."
    },
    {
      "id": 110504453113716738,
      "target": "Provocateur: Не, сериозно, защо да не ме снимате? Това със сигурност ще докаже нещо."
    },
    {
      "id": 110504453113716737,
      "target": "Provocateur: А, снимка ви трябва… Да ви се усмихна ли и за нея?"
    },
    {
      "id": 110504453113716736,
      "target": "Извади пушката"
    },
    {
      "id": 110504453109522440,
      "target": "Пусни го"
    },
    {
      "id": 110504453109522439,
      "target": "Provocateur: Бръсна ги — не понасям потта. Няма да решите, че съм Гост заради едни обръснати подмишници, нали?"
    },
    {
      "id": 110504453109522438,
      "target": "Provocateur: ..."
    },
    {
      "id": 110504453109522437,
      "target": "Provocateur: Какво!? Подмишниците?"
    },
    {
      "id": 110504453109522436,
      "target": "Извади пушката"
    },
    {
      "id": 110504453109522435,
      "target": "Пусни го"
    },
    {
      "id": 110504453109522434,
      "target": "Provocateur: Е! Намерихте ли нещо!?"
    },
    {
      "id": 110504453109522433,
      "target": "Provocateur: Е! Няма зачервяване, нали!"
    },
    {
      "id": 110504453109522432,
      "target": "Provocateur: ..."
    },
    {
      "id": 110504453105328135,
      "target": "Provocateur: И какво търсите в тях? Злобен поглед?"
    },
    {
      "id": 110504453105328134,
      "target": "Provocateur: И какво търсите в тях? Зачервяване?"
    },
    {
      "id": 110504453105328133,
      "target": "Извади пушката"
    },
    {
      "id": 110504453105328132,
      "target": "Пусни го"
    },
    {
      "id": 110504453105328131,
      "target": "Provocateur: Само не ми казвайте, че неподрязаните нокти вече доказват, че съм Гост."
    },
    {
      "id": 110504453105328130,
      "target": "Provocateur: Само не ми казвайте, че мръсотията под ноктите доказва, че съм Гост."
    },
    {
      "id": 110504453105328129,
      "target": "Provocateur: ..."
    },
    {
      "id": 110504453105328128,
      "target": "Provocateur: Ръцете? Защо?"
    }
  ]
}
