  "entries": [
    {
      "id": 110504452123860996,
      "target": "Sirin: Колко е прекрасна!"
    },
    {
      "id": 110504452123860995,
      "target": "Sirin: Но тя беше предназначена за теб!"
    },
    {
      "id": 110504452123860994,
      "target": "Sirin: Моята песен."
    },
    {
      "id": 110504452123860993,
      "target": "Sirin: Значи ще дочакам своя час."
    },
    {
      "id": 110504452123860992,
      "target": "Sirin: Няма значение."
    },
    {
      "id": 110504452119666698,
      "target": "Sirin: Вечна агония и предвкусване на смъртта."
    },
    {
      "id": 110504452119666697,
      "target": "Sirin: И никога няма да видим своя край."
    },
    {
      "id": 110504452119666696,
      "target": "Sirin: Много дълго ще ни засмуква хоризонтът на събитията."
    },
    {
      "id": 110504452119666695,
      "target": "Sirin: Ами ако просто се подготвяме да бъдем погълнати от черна дупка?"
    },
    {
      "id": 110504452119666694,
      "target": "Sirin: Може би следващия път."
    },
    {
      "id": 110504452119666693,
      "target": "Sirin: Не отговаряше на признаците."
    },
    {
      "id": 110504452119666692,
      "target": "Sirin: Жалко."
    },
    {
      "id": 110504452119666691,
      "target": "Sirin: Може би следващия път."
    },
    {
      "id": 110504452119666690,
      "target": "Sirin: Жалко."
    },
    {
      "id": 110504452119666689,
      "target": "Sirin: Все едно ще умреш."
    },
    {
      "id": 110504452119666688,
      "target": "Sirin: ..."
    },
    {
      "id": 110504452115472395,
      "target": "Sirin: Не ти стигна смелостта?"
    },
    {
      "id": 110504452115472394,
      "target": "Изслушай"
    },
    {
      "id": 110504452115472393,
      "target": "Стреляй"
    },
    {
      "id": 110504452115472392,
      "target": "Sirin: Ще натиснеш ли заветния бутон?"
    },
    {
      "id": 110504452115472391,
      "target": "Sirin: Е, какво?"
    },
    {
      "id": 110504452115472390,
      "target": "Изслушай"
    },
    {
      "id": 110504452115472389,
      "target": "Стреляй"
    },
    {
      "id": 110504452115472388,
      "target": "Sirin: Харесва ли ти?"
    },
    {
      "id": 110504452115472387,
      "target": "Sirin: Тя просто ще премине в теб."
    },
    {
      "id": 110504452115472386,
      "target": "Sirin: Когато затворя очи, пустотата няма да изчезне."
    },
    {
      "id": 110504452115472385,
      "target": "Изслушай"
    },
    {
      "id": 110504452115472384,
      "target": "Стреляй"
    },
    {
      "id": 110504452111278091,
      "target": "Sirin: Аз сама ще го направя."
    },
    {
      "id": 110504452111278090,
      "target": "Sirin: Дай ми пушката."
    },
    {
      "id": 110504452111278089,
      "target": "Sirin: Можеш просто да оставиш това на мен."
    },
    {
      "id": 110504452111278088,
      "target": "Sirin: Смъртта така или иначе вече е близо."
    },
    {
      "id": 110504452111278087,
      "target": "Sirin: Недей."
    },
    {
      "id": 110504452111278086,
      "target": "Изслушай"
    },
    {
      "id": 110504452111278085,
      "target": "Стреляй"
    },
    {
      "id": 110504452111278084,
      "target": "Sirin: Изтръгни духа от мен."
    },
    {
      "id": 110504452111278083,
      "target": "Sirin: Така е дори по-добре."
    },
    {
      "id": 110504452111278082,
      "target": "Извади пушката"
    },
    {
      "id": 110504452111278081,
      "target": "Пусни я"
    },
    {
      "id": 110504452111278080,
      "target": "Sirin: Изглежда, не съм го правила напразно."
    }
  ]
}
