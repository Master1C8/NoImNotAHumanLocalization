  "entries": [
    {
      "id": 110504452824309763,
      "target": "Извади пушката"
    },
    {
      "id": 110504452824309762,
      "target": "Пусни я"
    },
    {
      "id": 110504452824309761,
      "target": "Greatmother: Ох, мамка му, хвани я! Хвани я, убий я!"
    },
    {
      "id": 110504452824309760,
      "target": "Greatmother: ..."
    },
    {
      "id": 110504452820115463,
      "target": "Greatmother: Нощем чувам някакво шумолене. Сякаш нещо стърже."
    },
    {
      "id": 110504452820115462,
      "target": "Извади пушката"
    },
    {
      "id": 110504452820115461,
      "target": "Пусни я"
    },
    {
      "id": 110504452820115460,
      "target": "Greatmother: А защо почти не се виждам? Само петна, петна, петна."
    },
    {
      "id": 110504452820115459,
      "target": "Greatmother: ..."
    },
    {
      "id": 110504452820115458,
      "target": "Greatmother: Хайде, защо пък не?"
    },
    {
      "id": 110504452820115457,
      "target": "Greatmother: Отдавна не са ме снимали."
    },
    {
      "id": 110504452820115456,
      "target": "Извади пушката"
    },
    {
      "id": 110504452815921161,
      "target": "Пусни я"
    },
    {
      "id": 110504452815921160,
      "target": "Greatmother: Пробвах какво ли не, но нищо не помага."
    },
    {
      "id": 110504452815921159,
      "target": "Greatmother: Все ме сърби. Вече не знам какво да правя."
    },
    {
      "id": 110504452815921158,
      "target": "Greatmother: ..."
    },
    {
      "id": 110504452815921157,
      "target": "Greatmother: Стара жена съм вече. Тялото ми за нищо не става."
    },
    {
      "id": 110504452815921156,
      "target": "Извади пушката"
    },
    {
      "id": 110504452815921155,
      "target": "Пусни я"
    },
    {
      "id": 110504452815921154,
      "target": "Greatmother: Какво ще направиш?"
    },
    {
      "id": 110504452815921153,
      "target": "Greatmother: ..."
    },
    {
      "id": 110504452815921152,
      "target": "Greatmother: Не знам как ще определиш дали съм Гост."
    },
    {
      "id": 110504452811726856,
      "target": "Greatmother: Кръвоносните съдове в очите ми все са спукани."
    },
    {
      "id": 110504452811726855,
      "target": "Извади пушката"
    },
    {
      "id": 110504452811726854,
      "target": "Пусни я"
    },
    {
      "id": 110504452811726853,
      "target": "Greatmother: Боли и е неприятно."
    },
    {
      "id": 110504452811726852,
      "target": "Greatmother: Вече не помня как се казва болестта, но ноктите ми се отлепят."
    },
    {
      "id": 110504452811726851,
      "target": "Greatmother: ..."
    },
    {
      "id": 110504452811726850,
      "target": "Greatmother: Старостта не е радост, синко."
    },
    {
      "id": 110504452811726849,
      "target": "Greatmother: Е, с това ще имаме проблем."
    },
    {
      "id": 110504452811726848,
      "target": "Извади пушката"
    },
    {
      "id": 110504452807532552,
      "target": "Пусни я"
    },
    {
      "id": 110504452807532551,
      "target": "Greatmother: Поискала стара вещица като мен фасети — и сега ще ме убиваш? Ще ги довършат по-късно."
    },
    {
      "id": 110504452807532550,
      "target": "Greatmother: И какво от това?"
    },
    {
      "id": 110504452807532549,
      "target": "Greatmother: ..."
    },
    {
      "id": 110504452807532548,
      "target": "Greatmother: Е, погледни, защо пък не."
    },
    {
      "id": 110504452807532547,
      "target": "Greatmother: Хахахаха, какви зъби, синко?"
    },
    {
      "id": 110504452807532546,
      "target": "Уши"
    },
    {
      "id": 110504452807532545,
      "target": "Снимка"
    },
    {
      "id": 110504452807532544,
      "target": "Подмишници"
    }
  ]
}
