  "glossaryFingerprint": "28d7eb651d95b56a72a5a4acefcba5f434dcbe6925a2233126655e13b0e01cab",
  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504454141321224,
      "target": "Извади пушката"
    },
    {
      "id": 110504454141321223,
      "target": "Пусни го"
    },
    {
      "id": 110504454141321222,
      "target": "Tourist: Леко изгоряха на слънцето. Но това все пак не е зараза."
    },
    {
      "id": 110504454141321221,
      "target": "Tourist: Не се учудвайте, ръцете ме сърбят от тена. Затова ги разчесах."
    },
    {
      "id": 110504454141321220,
      "target": "Tourist: ..."
    },
    {
      "id": 110504454141321219,
      "target": "Tourist: Ръцете? Търсите някакво раздразнение?"
    },
    {
      "id": 110504454141321218,
      "target": "Извади пушката"
    },
    {
      "id": 110504454141321217,
      "target": "Пусни го"
    },
    {
      "id": 110504454141321216,
      "target": "Tourist: Равни са, нали? В нашия град зъболекарските услуги не са скъпи."
    },
    {
      "id": 110504454137126924,
      "target": "Tourist: ..."
    },
    {
      "id": 110504454137126923,
      "target": "Tourist: Е, ако това помогне…"
    },
    {
      "id": 110504454137126922,
      "target": "Tourist: …"
    },
    {
      "id": 110504454137126921,
      "target": "Tourist: Искате да кажете, че зъбите ще покажат дали съм се заразил с вируса?"
    },
    {
      "id": 110504454137126920,
      "target": "Уши"
    },
    {
      "id": 110504454137126919,
      "target": "Снимка"
    },
    {
      "id": 110504454137126918,
      "target": "Подмишници"
    },
    {
      "id": 110504454137126917,
      "target": "Очи"
    },
    {
      "id": 110504454137126916,
      "target": "Ръце"
    },
    {
      "id": 110504454137126915,
      "target": "Зъби"
    },
    {
      "id": 110504454137126914,
      "target": "Tourist: Мислите, че съм заразен?"
    },
    {
      "id": 110504454137126913,
      "target": "Alt: Страшно е."
    },
    {
      "id": 110504454137126912,
      "target": "Alt: Излязох от шибания цирк, а клоуните ме настигнаха и тук."
    },
    {
      "id": 110504454132932619,
      "target": "Alt: Колко странни времена настъпиха, господи…"
    },
    {
      "id": 110504454132932618,
      "target": "Alt: Жалко, няма кой да скърби за мен. Никой няма да си направи татуировка след смъртта ми."
    },
    {
      "id": 110504454132932617,
      "target": "Alt: По принцип е по-добре да не си правиш татуировки на неподходящи места."
    },
    {
      "id": 110504454132932616,
      "target": "Alt: За да го виждам винаги до себе си, когато погледна в огледалото."
    },
    {
      "id": 110504454132932615,
      "target": "Alt: Но си налях мастило в очите, когато почина най-близкият ми човек."
    },
    {
      "id": 110504454132932614,
      "target": "Alt: И както се досещаш, животът ми не е лек."
    },
    {
      "id": 110504454132932613,
      "target": "Alt: Като снимка за спомен."
    },
    {
      "id": 110504454132932612,
      "target": "Alt: Правех си татуировки, когато умираше някой от приятелите или близките ми."
    },
    {
      "id": 110504454132932611,
      "target": "Alt: Кой знае какво ще стане, щом се върна там."
    },
    {
      "id": 110504454132932610,
      "target": "Alt: Заради ноктите си няма да се върна в града. Не."
    },
    {
      "id": 110504454132932609,
      "target": "Alt: Доста е изнервящо, когато те заплашват, че ще те убият."
    },
    {
      "id": 110504454132932608,
      "target": "Alt: Знаеш ли, ще си почина за малко от приключенията, става ли?"
    },
    {
      "id": 110504454128738316,
      "target": "Изслушай"
    },
    {
      "id": 110504454128738315,
      "target": "Стреляй"
    },
    {
      "id": 110504454128738314,
      "target": "Alt: Поне да беше ясно защо ме убиват."
    },
    {
      "id": 110504454128738313,
      "target": "Alt: А сега съжалявам, че ги свалих."
    },
    {
      "id": 110504454128738312,
      "target": "Изслушай"
    },
    {
      "id": 110504454128738311,
      "target": "Стреляй"
    }
  ]
}
