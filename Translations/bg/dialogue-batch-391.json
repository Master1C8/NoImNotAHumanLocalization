  "entries": [
    {
      "id": 110504451922534401,
      "target": "Anxiety: Значи съм Гост? Как? КААААК? Недей!"
    },
    {
      "id": 110504451922534400,
      "target": "Извади пушката"
    },
    {
      "id": 110504451918340106,
      "target": "Пусни я"
    },
    {
      "id": 110504451918340105,
      "target": "Anxiety: Това значи ли… че отговарям на описанието?"
    },
    {
      "id": 110504451918340104,
      "target": "Anxiety: ..."
    },
    {
      "id": 110504451918340103,
      "target": "Anxiety: Господи, от страх не мога да си спомня дори какво ядох вчера."
    },
    {
      "id": 110504451918340102,
      "target": "Anxiety: Не мога да си спомня кога ходих на зъболекар. Изобщо ходила ли съм?"
    },
    {
      "id": 110504451918340101,
      "target": "Anxiety: Макар че, честно казано…"
    },
    {
      "id": 110504451918340100,
      "target": "Anxiety: Нали наскоро си оправях зъбите."
    },
    {
      "id": 110504451918340099,
      "target": "Anxiety: Хах, значи ще вземаш решения по зъбите? Ох-ооох."
    },
    {
      "id": 110504451918340098,
      "target": "Уши"
    },
    {
      "id": 110504451918340097,
      "target": "Снимка"
    },
    {
      "id": 110504451918340096,
      "target": "Подмишници"
    },
    {
      "id": 110504451914145801,
      "target": "Очи"
    },
    {
      "id": 110504451914145800,
      "target": "Ръце"
    },
    {
      "id": 110504451914145799,
      "target": "Зъби"
    },
    {
      "id": 110504451914145798,
      "target": "Anxiety: Какво искаш да провериш?"
    },
    {
      "id": 110504451914145797,
      "target": "Извади пушката"
    },
    {
      "id": 110504451914145796,
      "target": "Пусни го"
    },
    {
      "id": 110504451914145795,
      "target": "Fanatic: Отделяме жизненоважна влага, за да продължи да тече животът!"
    },
    {
      "id": 110504451914145794,
      "target": "Fanatic: Ето го резултата от слънчевата работа."
    },
    {
      "id": 110504451914145793,
      "target": "Fanatic: ..."
    },
    {
      "id": 110504451914145792,
      "target": "Fanatic: Е, помириши, щом искаш."
    },
    {
      "id": 110504451909951497,
      "target": "Fanatic: Гледай го ти, палавник!"
    },
    {
      "id": 110504451909951496,
      "target": "Fanatic: Ето го резултата от грижата за себе си."
    },
    {
      "id": 110504451909951495,
      "target": "Fanatic: ..."
    },
    {
      "id": 110504451909951494,
      "target": "Fanatic: Е, помириши, щом искаш."
    },
    {
      "id": 110504451909951493,
      "target": "Fanatic: Гледай го ти, палавник!"
    },
    {
      "id": 110504451909951492,
      "target": "Fanatic: Имаш щедър запас от живителна студена влага!"
    },
    {
      "id": 110504451909951491,
      "target": "Fanatic: А за мен не се тревожи, не се обиждам."
    },
    {
      "id": 110504451909951490,
      "target": "Fanatic: Няма да застреляш Слънцето!"
    },
    {
      "id": 110504451909951489,
      "target": "Fanatic: Така е правилно."
    },
    {
      "id": 110504451909951488,
      "target": "Fanatic: И ми е все тая, мамка му."
    },
    {
      "id": 110504451905757194,
      "target": "Fanatic: ..."
    },
    {
      "id": 110504451905757193,
      "target": "Fanatic: Чакай малко."
    },
    {
      "id": 110504451905757192,
      "target": "Fanatic: Там нещо не беше както трябва."
    },
    {
      "id": 110504451905757191,
      "target": "Fanatic: А, не, почакай..."
    },
    {
      "id": 110504451905757190,
      "target": "Fanatic: И какво? Сега да се стреляме ли?"
    },
    {
      "id": 110504451905757189,
      "target": "Fanatic: Казват, че в очите няма истина."
    },
    {
      "id": 110504451905757188,
      "target": "Fanatic: Стиснат си, невежа си, а на мен ми се пие бира."
    }
  ]
