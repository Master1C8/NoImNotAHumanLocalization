  "entries": [
    {
      "id": 110504455533830147,
      "target": "Teacher: Не мога да живея с насилие."
    },
    {
      "id": 110504455533830146,
      "target": "Teacher: За никого с меко сърце."
    },
    {
      "id": 110504455533830145,
      "target": "Сега с меко сърце не се оцелява. Трябва да стоите близо до някого"
    },
    {
      "id": 110504455533830144,
      "target": "Страхувате ли се, че за вас няма да има място в новия свят?"
    },
    {
      "id": 110504455529635851,
      "target": "Teacher: Какво бъдеще ни чака?"
    },
    {
      "id": 110504455529635850,
      "target": "Teacher: Ако не измрем масово, ако оцелеем, тогава какво ще стане с нас?"
    },
    {
      "id": 110504455529635849,
      "target": "Teacher: Просто се замислих…"
    },
    {
      "id": 110504455529635848,
      "target": "Teacher: А?"
    },
    {
      "id": 110504455529635847,
      "target": "Трябва да ви проверя"
    },
    {
      "id": 110504455529635846,
      "target": "Нещо не е наред ли?"
    },
    {
      "id": 110504455529635845,
      "target": "Teacher: Горките дечица…"
    },
    {
      "id": 110504455529635844,
      "target": "Cat: (Кой знае, може би тази нощ смъртта ще подмине дома ви?)"
    },
    {
      "id": 110504455529635843,
      "target": "Cat: (Сякаш пухкавият любимец ви е отстъпил един от животите си в знак на благодарност.)"
    },
    {
      "id": 110504455529635842,
      "target": "Cat: (Имате странното усещане, че тази нощ може да спите спокойно.)"
    },
    {
      "id": 110504455529635841,
      "target": "Cat: (Макар по муцунката на котарака да е трудно да разберете какво чувства, той сигурно се радва.)"
    },
    {
      "id": 110504455529635840,
      "target": "Cat: …"
    },
    {
      "id": 110504455525441548,
      "target": "Cat: Мяу! МЯУ! Мяу!"
    },
    {
      "id": 110504455525441547,
      "target": "Cat: (Но как да откажете на такъв сладур?)"
    },
    {
      "id": 110504455525441546,
      "target": "Cat: (Струва ви се, че сега сам се подлага под ръката ви, за да го погалите)"
    },
    {
      "id": 110504455525441545,
      "target": "Cat: (Котаракът много обича да го галите толкова често)"
    },
    {
      "id": 110504455525441544,
      "target": "Нахрани котарака с котешка консерва"
    },
    {
      "id": 110504455525441543,
      "target": "Вземи го на ръце"
    },
    {
      "id": 110504455525441542,
      "target": "Погали"
    },
    {
      "id": 110504455525441541,
      "target": "Cat: Мяу!"
    },
    {
      "id": 110504455525441540,
      "target": "Cat: (Изглежда, той постепенно свиква с вас)"
    },
    {
      "id": 110504455525441539,
      "target": "Cat: (А той не е толкова опърничав, колкото ви се стори отначало.)"
    },
    {
      "id": 110504455525441538,
      "target": "Cat: (Изглежда, все пак много му харесва)"
    },
    {
      "id": 110504455525441537,
      "target": "Cat: (Решавате да погалите котарака)"
    },
    {
      "id": 110504455525441536,
      "target": "Нахрани котарака с котешка консерва"
    },
    {
      "id": 110504455521247243,
      "target": "Вземи го на ръце"
    },
    {
      "id": 110504455521247242,
      "target": "Погали"
    },
    {
      "id": 110504455521247241,
      "target": "Cat: Мяу!"
    },
    {
      "id": 110504455521247240,
      "target": "Cat: (Трудно е да разберете дали му харесва.)"
    },
    {
      "id": 110504455521247239,
      "target": "Cat: (Протягате ръка и галите котарака.)"
    },
    {
      "id": 110504455521247238,
      "target": "Нахрани котарака с котешка консерва"
    },
    {
      "id": 110504455521247237,
      "target": "Вземи го на ръце"
    },
    {
      "id": 110504455521247236,
      "target": "Погали"
    },
    {
      "id": 110504455521247235,
      "target": "Cat: Мяу!"
    },
    {
      "id": 110504455521247234,
      "target": "Neighbour: Изпий една бира и си лягай."
    },
    {
      "id": 110504455521247233,
      "target": "Neighbour: Е, това вече със сигурност е всичко."
    }
  ]
}
