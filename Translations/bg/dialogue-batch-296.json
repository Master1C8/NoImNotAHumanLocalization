  "entries": [
    {
      "id": 110504453751250952,
      "target": "Ръце"
    },
    {
      "id": 110504453751250951,
      "target": "Зъби"
    },
    {
      "id": 110504453751250950,
      "target": "Jacob: Знаех си, че ще го кажеш."
    },
    {
      "id": 110504453751250949,
      "target": "Sirin: Готова съм..."
    },
    {
      "id": 110504453751250948,
      "target": "Sirin: Как ще живея... без нея..."
    },
    {
      "id": 110504453751250947,
      "target": "Sirin: Смъртта отне сестра ми..."
    },
    {
      "id": 110504453751250946,
      "target": "Alkonost: Просто стреляй."
    },
    {
      "id": 110504453751250945,
      "target": "Alkonost: Какъв смисъл има вече да правя каквото и да било... или да се старая..."
    },
    {
      "id": 110504453751250944,
      "target": "Alkonost: ..."
    },
    {
      "id": 110504453747056650,
      "target": "Alkonost: Сестра ми... Защо?"
    },
    {
      "id": 110504453747056649,
      "target": "Anger: Това адски ме напряга, ебаси. Но се усещам твърде късно, че пак правя тая шибана простотия."
    },
    {
      "id": 110504453747056648,
      "target": "Anger: Понякога стискам челюсти толкова силно, че чувам как хрущят."
    },
    {
      "id": 110504453747056647,
      "target": "..."
    },
    {
      "id": 110504453747056646,
      "target": "Що за репортаж беше това изобщо?"
    },
    {
      "id": 110504453747056645,
      "target": "…"
    },
    {
      "id": 110504453747056644,
      "target": "С ушите всичко е наред."
    },
    {
      "id": 110504453747056643,
      "target": "..."
    },
    {
      "id": 110504453747056642,
      "target": "..."
    },
    {
      "id": 110504453747056641,
      "target": "Трябва да си измия лицето. Дано помогне."
    },
    {
      "id": 110504453747056640,
      "target": "…"
    },
    {
      "id": 110504453742862345,
      "target": "Прилича на раздразнение или, още по-лошо, на гъбички."
    },
    {
      "id": 110504453742862344,
      "target": "Мамка му, що за гадост е това!?"
    },
    {
      "id": 110504453742862343,
      "target": "Както трябва."
    },
    {
      "id": 110504453742862342,
      "target": "Окосмени подмишници."
    },
    {
      "id": 110504453742862341,
      "target": "..."
    },
    {
      "id": 110504453742862340,
      "target": "..."
    },
    {
      "id": 110504453742862339,
      "target": "Не са червени, така че няма за какво да се заядат, мамка му."
    },
    {
      "id": 110504453742862338,
      "target": "Очите са си очи."
    },
    {
      "id": 110504453742862337,
      "target": "Не биваше да пия онази кофеинова гадост."
    },
    {
      "id": 110504453742862336,
      "target": "Мамка му. Червени са…"
    },
    {
      "id": 110504453738668032,
      "target": "..."
    },
    {
      "id": 110504453591867397,
      "target": "..."
    },
    {
      "id": 110504453591867396,
      "target": "По отпечатъците от пръстите има следи от барут. Но това е дреболия."
    },
    {
      "id": 110504453591867395,
      "target": "Чисти ръце…"
    },
    {
      "id": 110504453591867394,
      "target": "Всичко е заради онази пещера, която копая."
    },
    {
      "id": 110504453591867393,
      "target": "Мръсни нокти…"
    },
    {
      "id": 110504453591867392,
      "target": "..."
    },
    {
      "id": 110504453587673095,
      "target": "..."
    },
    {
      "id": 110504453587673094,
      "target": "Така е и по-добре. Няма да ме вземат за Гост."
    },
    {
      "id": 110504453587673093,
      "target": "Жълти зъби…"
    }
  ]
}
