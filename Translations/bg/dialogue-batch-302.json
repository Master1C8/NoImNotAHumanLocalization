  "glossaryFingerprint": "28d7eb651d95b56a72a5a4acefcba5f434dcbe6925a2233126655e13b0e01cab",
  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504453474426885,
      "target": "Стреляй"
    },
    {
      "id": 110504453474426884,
      "target": "FatalDame: И ми се струва, че не съм първата."
    },
    {
      "id": 110504453474426883,
      "target": "FatalDame: Колко романтично — да пазиш снимка на жертвата си."
    },
    {
      "id": 110504453474426882,
      "target": "FatalDame: Садистично удоволствие ли изпитваш?"
    },
    {
      "id": 110504453474426881,
      "target": "Изслушай"
    },
    {
      "id": 110504453474426880,
      "target": "Стреляй"
    },
    {
      "id": 110504453470232579,
      "target": "FatalDame: Смяташ красивите хора за опасни? Но какво бих могла да ти сторя?"
    },
    {
      "id": 110504453470232578,
      "target": "FatalDame: Красотата ли те плаши? Защото не можеш да ѝ се довериш или има и нещо друго?"
    },
    {
      "id": 110504453470232577,
      "target": "Изслушай"
    },
    {
      "id": 110504453470232576,
      "target": "Стреляй"
    },
    {
      "id": 110504453453455360,
      "target": "FatalDame: Само следваш една парадигма. Сам ли си я наложи?"
    },
    {
      "id": 110504453449261058,
      "target": "FatalDame: Само следваш една парадигма. А на човек му е присъщо да търси информация и да се съмнява."
    },
    {
      "id": 110504453449261057,
      "target": "FatalDame: Плаши ме, че не виждам съмнение в очите ти."
    },
    {
      "id": 110504453449261056,
      "target": "Изслушай"
    },
    {
      "id": 110504453445066758,
      "target": "Стреляй"
    },
    {
      "id": 110504453445066757,
      "target": "FatalDame: Кого виждаш в мен? На кого искаш да отмъстиш?"
    },
    {
      "id": 110504453445066756,
      "target": "FatalDame: Изглежда, все пак е злоба."
    },
    {
      "id": 110504453445066755,
      "target": "Изслушай"
    },
    {
      "id": 110504453445066754,
      "target": "Стреляй"
    },
    {
      "id": 110504453445066753,
      "target": "FatalDame: Но защо си го изкарваш на мен, човек, когото виждаш за първи път?"
    },
    {
      "id": 110504453445066752,
      "target": "FatalDame: Виждаш ли в мен онзи, който те е наранил?"
    },
    {
      "id": 110504453440872455,
      "target": "Извади пушката"
    },
    {
      "id": 110504453440872454,
      "target": "Пусни я"
    },
    {
      "id": 110504453440872453,
      "target": "FatalDame: Но откъде идва този твой интерес към ушите? Какво ти харесва в тях?"
    },
    {
      "id": 110504453440872452,
      "target": "FatalDame: ..."
    },
    {
      "id": 110504453440872451,
      "target": "FatalDame: Не, нямам нищо против."
    },
    {
      "id": 110504453440872450,
      "target": "FatalDame: Това фетиш ли ти е?"
    },
    {
      "id": 110504453440872449,
      "target": "Извади пушката"
    },
    {
      "id": 110504453440872448,
      "target": "Пусни я"
    },
    {
      "id": 110504453436678151,
      "target": "FatalDame: Какво искаш да направиш със снимката?"
    },
    {
      "id": 110504453436678150,
      "target": "FatalDame: ..."
    },
    {
      "id": 110504453436678149,
      "target": "FatalDame: Хайде бързо да приключим с това и да си гледаме работата."
    },
    {
      "id": 110504453436678148,
      "target": "FatalDame: Извини ме, но това само ме изморява."
    },
    {
      "id": 110504453436678147,
      "target": "Извади пушката"
    },
    {
      "id": 110504453436678146,
      "target": "Пусни я"
    },
    {
      "id": 110504453436678145,
      "target": "FatalDame: Радвам се, че с теб нямаме проблем с това."
    },
    {
      "id": 110504453436678144,
      "target": "FatalDame: Тялото винаги ни се отблагодарява за грижите и нежността."
    },
    {
      "id": 110504453432483847,
      "target": "FatalDame: Разбира се. Можеш да погледнеш. Не мога да ти откажа."
    },
    {
      "id": 110504453432483846,
      "target": "Извади пушката"
    },
    {
      "id": 110504453432483845,
      "target": "Пусни я"
    }
  ]
}
