  "entries": [
    {
      "id": 110504452513931276,
      "target": "Пусни я"
    },
    {
      "id": 110504452513931275,
      "target": "Ballerina: Поне хареса ли ти?"
    },
    {
      "id": 110504452513931274,
      "target": "Ballerina: ..."
    },
    {
      "id": 110504452513931273,
      "target": "Ballerina: АХАХАХАХА! Хайде, гледай. Души. Какво още правиш?"
    },
    {
      "id": 110504452513931272,
      "target": "Извади пушката"
    },
    {
      "id": 110504452513931271,
      "target": "Пусни я"
    },
    {
      "id": 110504452513931270,
      "target": "Ballerina: Е, как е усещането?"
    },
    {
      "id": 110504452513931269,
      "target": "Ballerina: А ти вече живееш в нея."
    },
    {
      "id": 110504452513931268,
      "target": "Ballerina: В тях е записана трагедия."
    },
    {
      "id": 110504452513931267,
      "target": "Ballerina: ..."
    },
    {
      "id": 110504452513931266,
      "target": "Ballerina: Знаеш ли какво има в зениците?"
    },
    {
      "id": 110504452513931265,
      "target": "Ballerina: А-а-а-а, най-сетне стигна до интересното."
    },
    {
      "id": 110504452513931264,
      "target": "Извади пушката"
    },
    {
      "id": 110504452509736971,
      "target": "Пусни я"
    },
    {
      "id": 110504452509736970,
      "target": "Ballerina: Някаква шибана досада."
    },
    {
      "id": 110504452509736969,
      "target": "Ballerina: Ако не ме беше помолил, отдавна щях да заровя котката."
    },
    {
      "id": 110504452509736968,
      "target": "Ballerina: Този косматко ме издраска."
    },
    {
      "id": 110504452509736967,
      "target": "Ballerina: ..."
    },
    {
      "id": 110504452509736966,
      "target": "Ballerina: Танцувам, какво още искаш да намериш в ръцете ми?"
    },
    {
      "id": 110504452509736965,
      "target": "Ballerina: Е, защо не?"
    },
    {
      "id": 110504452509736964,
      "target": "Извади пушката"
    },
    {
      "id": 110504452509736963,
      "target": "Пусни я"
    },
    {
      "id": 110504452509736962,
      "target": "Ballerina: Ако знаех какво е съвест."
    },
    {
      "id": 110504452509736961,
      "target": "Ballerina: С такива зъби бих изяла всичко. И от съвестта бих отхапала."
    },
    {
      "id": 110504452509736960,
      "target": "Ballerina: ..."
    },
    {
      "id": 110504452505542667,
      "target": "Ballerina: Би ли изгризал със зъби всичко, което съвестта остави?"
    },
    {
      "id": 110504452505542666,
      "target": "Ballerina: Зъби?"
    },
    {
      "id": 110504452505542665,
      "target": "Уши"
    },
    {
      "id": 110504452505542664,
      "target": "Снимка"
    },
    {
      "id": 110504452505542663,
      "target": "Подмишници"
    },
    {
      "id": 110504452505542662,
      "target": "Очи"
    },
    {
      "id": 110504452505542661,
      "target": "Ръце"
    },
    {
      "id": 110504452505542660,
      "target": "Зъби"
    },
    {
      "id": 110504452505542659,
      "target": "Ballerina: Да ме проверяваш? Хах, хайде, убеди се в нещо."
    },
    {
      "id": 110504452505542658,
      "target": "Wheelchair: Но тези грешки водят до много страшни последици."
    },
    {
      "id": 110504452505542657,
      "target": "Wheelchair: На хората, разбира се, им е присъщо да грешат."
    },
    {
      "id": 110504452505542656,
      "target": "Wheelchair: Може би всички те еднакво точно сочат към Гост?"
    },
    {
      "id": 110504452501348361,
      "target": "Wheelchair: Ако… ако ти не вярваш на този признак, как аз да им вярвам?"
    },
    {
      "id": 110504452501348360,
      "target": "Wheelchair: ..."
    },
    {
      "id": 110504452501348359,
      "target": "Wheelchair: Да, да. Но какво „да, да“?"
    }
  ]
}
