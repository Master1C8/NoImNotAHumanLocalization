  "entries": [
    {
      "id": 110504456125227011,
      "target": "Колко дни минаха? Колко часа?"
    },
    {
      "id": 110504456125227010,
      "target": "Направих всичко правилно."
    },
    {
      "id": 110504456125227009,
      "target": "Така трябваше. За да оцелея. Така… е правилно."
    },
    {
      "id": 110504456125227008,
      "target": "Оцелях. Останах сам, разчитам само на себе си."
    },
    {
      "id": 110504456121032715,
      "target": "Това е всичко."
    },
    {
      "id": 110504456121032714,
      "target": "..."
    },
    {
      "id": 110504456121032713,
      "target": "..."
    },
    {
      "id": 110504456121032712,
      "target": "..."
    },
    {
      "id": 110504456121032711,
      "target": "..."
    },
    {
      "id": 110504456121032710,
      "target": "От вас не остана нищо."
    },
    {
      "id": 110504456121032709,
      "target": "Вещи, творения, работа, мисли, емоции."
    },
    {
      "id": 110504456121032708,
      "target": "Аз вече изгубих всичко. А вие имате какво да губите."
    },
    {
      "id": 110504456121032707,
      "target": "Vigilante: ..."
    },
    {
      "id": 110504456121032706,
      "target": "Vigilante: ..."
    },
    {
      "id": 110504456121032705,
      "target": "Vigilante: ..."
    },
    {
      "id": 110504456121032704,
      "target": "Vigilante: ..."
    },
    {
      "id": 110504456116838411,
      "target": "Vigilante: ..."
    },
    {
      "id": 110504456116838410,
      "target": "Vigilante: ..."
    },
    {
      "id": 110504456116838409,
      "target": "Не знаете какво е станало с дома ви."
    },
    {
      "id": 110504456116838408,
      "target": "И дори не е ясно какво да правите на работа."
    },
    {
      "id": 110504456116838407,
      "target": "Не е ясно и кога ще ви пуснат да се приберете."
    },
    {
      "id": 110504456116838406,
      "target": "Gasmask: ..."
    },
    {
      "id": 110504456116838405,
      "target": "Gasmask: ..."
    },
    {
      "id": 110504456116838404,
      "target": "Gasmask: ..."
    },
    {
      "id": 110504456116838403,
      "target": "Gasmask: ..."
    },
    {
      "id": 110504456116838402,
      "target": "Каквото и да последва, те убиха дете."
    },
    {
      "id": 110504456116838401,
      "target": "От думите на дамата се вкаменихте."
    },
    {
      "id": 110504456116838400,
      "target": "Но ти… ти ще отведеш ада по-далеч."
    },
    {
      "id": 110504456112644107,
      "target": "Детето щеше да ни отведе в царството на нещо ужасно."
    },
    {
      "id": 110504456112644106,
      "target": "Ти изобличаваш греховете на нашия свят."
    },
    {
      "id": 110504456112644105,
      "target": "Какво става?"
    },
    {
      "id": 110504456112644104,
      "target": "Срещата с тях добър знак ли е?"
    },
    {
      "id": 110504456112644103,
      "target": "Нещо непрекъснато ви наблюдава?"
    },
    {
      "id": 110504456112644102,
      "target": "И няма кого да виниш за това."
    },
    {
      "id": 110504456112644101,
      "target": "Изхвърлиха те на улицата."
    },
    {
      "id": 110504456112644100,
      "target": "Това така или иначе ще се случи."
    },
    {
      "id": 110504456112644099,
      "target": "Виждам какви планове са имали за теб."
    },
    {
      "id": 110504456112644098,
      "target": "От страх човек лесно може да полудее."
    },
    {
      "id": 110504456112644097,
      "target": "Страшно е да умреш."
    },
    {
      "id": 110504456112644096,
      "target": "..."
    }
  ]
}
