    {
      "id": 110504452597817345,
      "target": "BigLebowski: СЛАБАК ЛИ СИ???"
    },
    {
      "id": 110504452597817344,
      "target": "BigLebowski: НАТИСНИ СПУСЪКА!"
    },
    {
      "id": 110504452593623050,
      "target": "BigLebowski: ХАЙДЕ, НАПРАВИ ГО!"
    },
    {
      "id": 110504452593623049,
      "target": "BigLebowski: Знаеш ли, майната му! Стреляй! Вече толкова се уморих от всичко това наоколо!"
    },
    {
      "id": 110504452593623048,
      "target": "BigLebowski: Ебати кошмара! Изобщо разбираш ли какво правиш?"
    },
    {
      "id": 110504452593623047,
      "target": "Изслушай"
    },
    {
