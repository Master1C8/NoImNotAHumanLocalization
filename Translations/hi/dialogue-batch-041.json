  "entries": [
    {"id": 110504456343330824, "target": "SuperFake: मैं खोलूँगा।"},
    {"id": 110504456343330823, "target": "SuperFake: देखना चाहता था कि तुम झूठ बोलोगे या नहीं।"},
    {"id": 110504456343330822, "target": "SuperFake: साफ़ है कि तुम अकेले हो।"},
    {"id": 110504456343330821, "target": "SuperFake: हाहाहाहाहा।"},
    {"id": 110504456343330820, "target": "SuperFake: मगर कौन जानता है कि कुछ दिनों बाद क्या होगा?"},
    {"id": 110504456343330819, "target": "SuperFake: तुम्हारे कमरों में किसी के फुसफुसाने की आवाज़ सुन रहा हूँ।"},
    {"id": 110504456343330818, "target": "SuperFake: आज तुम्हारी क़िस्मत अच्छी है।"},
    {"id": 110504456339136523, "target": "SuperFake: क्या तुम घर में अकेले हो?"},
    {"id": 110504456339136522, "target": "SuperFake: मगर बताओ…"},
    {"id": 110504456339136521, "target": "SuperFake: ‘मेरी अंतरात्मा जो कुछ छोड़ दे, उसे भी दाँतों से खा जाऊँ’, है न?"},
    {"id": 110504456339136520, "target": "SuperFake: यह तो बहुत अच्छा है!"},
    {"id": 110504456339136517, "target": "SuperFake: क्या तुम घर में अकेले हो?"},
    {"id": 110504456339136516, "target": "SuperFake: सुनोओओ…"},
    {"id": 110504456339136515, "target": "SuperFake: हाँ-हाँ, समझता हूँ।"},
    {"id": 110504456339136514, "target": "मेरे पास बंदूक है"},
    {"id": 110504456339136513, "target": "मुझे कुछ नहीं चाहिए"},
    {"id": 110504456339136512, "target": "SuperFake: ख़ुद समझते हो।"},
    {"id": 110504456334942217, "target": "SuperFake: क्या पता क्या हो जाए।"},
    {"id": 110504456334942216, "target": "SuperFake: तुम्हारा दरवाज़ा मज़बूत है?"},
    {"id": 110504456334942215, "target": "मेरे पास बंदूक है"},
    {"id": 110504456334942214, "target": "मुझे कुछ नहीं चाहिए"},
    {"id": 110504456334942213, "target": "SuperFake: अच्छा लगा।"},
    {"id": 110504456334942212, "target": "SuperFake: खुला-खुला घर है।"},
    {"id": 110504456334942211, "target": "SuperFake: …"}
  ]
}
