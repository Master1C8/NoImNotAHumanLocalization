          "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504456980865030",
          "key": "line:MushroomEater_Entrance_2_4_09f2283",
          "source": "MushroomEater: Я приду вновь, когда настанет время.",
          "target": "MushroomEater: वक़्त आने पर मैं फिर आऊँगा।",
          "sourceSha256": "1a500445bd438f91efc1f840e8e40a4e0fde1fac1efa2054d76a059c8692738a",
          "targetSha256": "293834a1e21daa33c95ed59d606ca3565e4e82ed62a7238ce6ce80f98e749c98",
          "nodeNames": [
            "MushroomEater_Entrance_2_4"
          ],
          "authoredPath": "Translations/hi/dialogue-batch-078.json"
        }
      ]
    },
    {
      "index": 6,
      "opcode": 2,
      "strings": [
        "line:MushroomEater_Entrance_2_4_01be690"
      ],
      "pairs": [
        {
          "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504456980865031",
          "key": "line:MushroomEater_Entrance_2_4_01be690",
          "source": "MushroomEater: Мы убедимся, что грибы не вырастут, а фестиваль не наступит.",
          "target": "MushroomEater: हम सुनिश्चित करेंगे कि मशरूम न उगें और उत्सव न आए।",
          "sourceSha256": "a013dd259e4f467d66dc15573fab38e1e7c1060414d5a5a82eb20fde9ca78b30",
          "targetSha256": "288ef12f204d086cc1768bb5963cc4d8b08904a8df22bca1de7564d243118d2a",
          "nodeNames": [
            "MushroomEater_Entrance_2_4"
          ],
          "authoredPath": "Translations/hi/dialogue-batch-078.json"
        }
      ]
    },
    {
      "index": 7,
      "opcode": 2,
      "strings": [
        "line:MushroomEater_Entrance_2_4_0091f8a"
      ],
      "pairs": [
        {
          "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504456980865032",
          "key": "line:MushroomEater_Entrance_2_4_0091f8a",
          "source": "MushroomEater: И помни: грибы – не то, чем кажутся.",
          "target": "MushroomEater: और याद रखो: मशरूम जैसे दिखते हैं, वैसे हैं नहीं।",
          "sourceSha256": "88cf7762ad6391d9f968c5c4cf20e1880d971242437bd98c8ce0df5137d23761",
          "targetSha256": "d72da8871cc6d6589b3aca3da9ae64808355b027c791f3c36be7c4649f6eac2d",
          "nodeNames": [
            "MushroomEater_Entrance_2_4"
          ],
          "authoredPath": "Translations/hi/dialogue-batch-078.json"
        }
      ]
    },
    {
      "index": 8,
      "opcode": 3,
      "strings": [
        "SetEmotion Happy"
      ],
      "pairs": []
    },
    {
      "index": 9,
      "opcode": 2,
      "strings": [
        "line:MushroomEater_Entrance_2_4_0fa18bb"
      ],
      "pairs": [
        {
          "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504456980865033",
          "key": "line:MushroomEater_Entrance_2_4_0fa18bb",
          "source": "MushroomEater: Не прощаемся, о дорогой юноша.",
          "target": "MushroomEater: फिर मिलेंगे, मेरे प्रिय युवक।",
          "sourceSha256": "74368eabda73f0eb03164d491c5c77d4e100cefe42e8a9ad2d25a9983d4bb96b",
          "targetSha256": "69a1126e7dfa80ede018658901bec880c27287d27b2fbd9dbfcece11c032bdbc",
          "nodeNames": [
            "MushroomEater_Entrance_2_4"
          ],
