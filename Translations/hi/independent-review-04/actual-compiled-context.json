      ],
      "pairs": [
        {
          "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504456972476420",
          "key": "line:MushroomEater_Entrance_2_1_0358999",
          "source": "MushroomEater: Это огромный источник информации. И сейчас он находится в такой же опасности, как и все мы.",
          "target": "MushroomEater: वह जानकारी का विशाल भंडार है। और अभी वह भी हम सबकी तरह ख़तरे में है।",
          "sourceSha256": "668e02b41563060d9640417c72fffbbf8cc6484a735e2105ce1d4c95b5b67283",
          "targetSha256": "ee82d6cb59062b23dadd6c6cc79687e4c3ac75c5703eb48267903a7a29b11787",
          "nodeNames": [
            "MushroomEater_Entrance_2_1"
          ],
          "authoredPath": "Translations/hi/dialogue-batch-078.json"
        }
      ]
    },
    {
      "index": 4,
      "opcode": 2,
      "strings": [
        "line:MushroomEater_Entrance_2_1_05c2b0b"
      ],
      "pairs": [
        {
          "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504456972476421",
          "key": "line:MushroomEater_Entrance_2_1_05c2b0b",
          "source": "MushroomEater: И причиной наших действий стал бурный рост грибов.",
          "target": "MushroomEater: और हमारे कदम उठाने की वजह मशरूमों की तेज़ बढ़त थी।",
          "sourceSha256": "13356963802c91f6973fff301eb5511bdcb706aa6584e1a534f8f2b258e671f5",
          "targetSha256": "f0227519ee4ba5894342161b0b801e09bb202af56b9f440f75ca4cd4e5e60586",
          "nodeNames": [
            "MushroomEater_Entrance_2_1"
          ],
          "authoredPath": "Translations/hi/dialogue-batch-078.json"
        }
      ]
    },
    {
      "index": 5,
      "opcode": 4,
      "strings": [
        "line:MushroomEater_Entrance_2_1_0bd9958",
        "L2176shortcutoption_MushroomEater_Entrance_2_1_1"
