      "pairs": [
        {
          "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504456972476422",
          "key": "line:MushroomEater_Entrance_2_1_0bd9958",
          "source": "Как именно наши действия остановят фестиваль грибов?",
          "target": "हमारे किए से मशरूम उत्सव आख़िर कैसे रुकेगा?",
          "sourceSha256": "f9ce889401204074b96fc1769997b1d1e053e85a268e589d1aea2c92d5b27517",
          "targetSha256": "cbba5897b5aba7ce453309434a829307244be38f028d7d5fd781926660acbcb8",
          "nodeNames": [
            "MushroomEater_Entrance_2_1"
          ],
          "authoredPath": "Translations/hi/dialogue-batch-078.json"
        }
      ]
    },
    {
      "index": 6,
      "opcode": 4,
      "strings": [
        "line:MushroomEater_Entrance_2_1_0310cea",
        "L2177shortcutoption_MushroomEater_Entrance_2_1_2"
      ],
      "pairs": [
