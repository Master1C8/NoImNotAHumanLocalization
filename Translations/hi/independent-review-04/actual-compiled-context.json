      "pairs": [
        {
          "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504456976670725",
          "key": "line:MushroomEater_Entrance_2_3_06cb0a4",
          "source": "MushroomEater: Нами совершён ритуал, о дорогой друг.",
          "target": "MushroomEater: हमने अनुष्ठान कर लिया है, मेरे प्रिय मित्र।",
          "sourceSha256": "fe60da536795271c9ba27124474806b088539ab1f24bd28708d0837cb5ea2578",
          "targetSha256": "62649cef11db20fc4194eee9eb9e4d4590954d73807d4d43850dc400147df02d",
          "nodeNames": [
            "MushroomEater_Entrance_2_3"
          ],
          "authoredPath": "Translations/hi/dialogue-batch-078.json"
        }
      ]
    },
    {
      "index": 1,
      "opcode": 2,
      "strings": [
        "line:MushroomEater_Entrance_2_3_07f08c5"
      ],
      "pairs": [
        {
          "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504456976670726",
          "key": "line:MushroomEater_Entrance_2_3_07f08c5",
          "source": "MushroomEater: Мы не можем говорить с грибами напрямую, так как не являемся частью мицелия.",
          "target": "MushroomEater: हम मशरूमों से सीधे बात नहीं कर सकते, क्योंकि हम माइसीलियम का हिस्सा नहीं हैं।",
          "sourceSha256": "7566dfb95728cee1f3ab9d66159a2702595c30b902f0727887de1491c2d9456e",
          "targetSha256": "4568e77c9edd7a9dc88bcab77459d3e713d6c39917a189a5630c3efdbd32ab8b",
          "nodeNames": [
            "MushroomEater_Entrance_2_3"
          ],
          "authoredPath": "Translations/hi/dialogue-batch-078.json"
        }
      ]
    },
    {
      "index": 2,
      "opcode": 2,
      "strings": [
        "line:MushroomEater_Entrance_2_3_04f196d"
      ],
      "pairs": [
        {
          "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504456976670727",
          "key": "line:MushroomEater_Entrance_2_3_04f196d",
          "source": "MushroomEater: Но можем утихомирить рост грибов с помощью древнего ритуала, что был описан в «Учебнике улыбок».",
          "target": "MushroomEater: मगर हम «मुस्कानों की पाठ्यपुस्तक» में बताए गए प्राचीन अनुष्ठान से मशरूमों की बढ़त थाम सकते हैं।",
          "sourceSha256": "902953f034639c27a9041b3232b0c9ca02ef2150c3131d3c5055fa273a1cb5e0",
          "targetSha256": "1b84260b8ad1f5c4340e46c8348edb325a2984a609f1739a212f66288d6fb99c",
          "nodeNames": [
            "MushroomEater_Entrance_2_3"
          ],
          "authoredPath": "Translations/hi/dialogue-batch-078.json"
        }
      ]
    },
    {
