[
  {
    "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504456980865035",
    "key": "line:entrance_mushroomeater_3_0a58437",
    "source": "MushroomEater: Внутри мицелия такой беспорядок, что ритуал… не произвёл никакого эффекта…",
    "target": "MushroomEater: माइसीलियम के भीतर इतनी अव्यवस्था है कि अनुष्ठान का… कोई असर ही नहीं हुआ…",
    "sourceSha256": "53017677fa8b1d09525d6ed66361df2eda139e9687b13478feb62506addfc702",
    "targetSha256": "68d152373f976ecffd343322624e2ff9e8b2516067af7d462cce19b6f5b26bca",
    "nodeNames": [
      "entrance_mushroomeater_10"
    ],
    "authoredPath": "Translations/hi/dialogue-batch-301.json"
  },
  {
    "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504456980865027",
    "key": "line:MushroomEater_Entrance_2_4_0e89ef9",
    "source": "MushroomEater: Они являются лишь частью мицелия.",
    "target": "MushroomEater: वे तो बस माइसीलियम का एक हिस्सा हैं।",
    "sourceSha256": "7a69dd11117298eb70ec3b350db730572658b521213c44bea73792f59a398e29",
    "targetSha256": "df31ac5dfd7a693cc5b2fd58a19361e7ebf1e3e289b69b2c66aa526c77425716",
    "nodeNames": [
      "MushroomEater_Entrance_2_4"
    ],
    "authoredPath": "Translations/hi/dialogue-batch-078.json"
  },
  {
    "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504456976670726",
    "key": "line:MushroomEater_Entrance_2_3_07f08c5",
    "source": "MushroomEater: Мы не можем говорить с грибами напрямую, так как не являемся частью мицелия.",
    "target": "MushroomEater: हम मशरूमों से सीधे बात नहीं कर सकते, क्योंकि हम माइसीलियम का हिस्सा नहीं हैं।",
    "sourceSha256": "7566dfb95728cee1f3ab9d66159a2702595c30b902f0727887de1491c2d9456e",
    "targetSha256": "4568e77c9edd7a9dc88bcab77459d3e713d6c39917a189a5630c3efdbd32ab8b",
    "nodeNames": [
      "MushroomEater_Entrance_2_3"
    ],
    "authoredPath": "Translations/hi/dialogue-batch-078.json"
  },
  {
    "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504456972476419",
    "key": "line:MushroomEater_Entrance_2_1_0778dd8",
    "source": "MushroomEater: Я узнал это от мицелия.",
    "target": "MushroomEater: यह मुझे माइसीलियम से पता चला।",
    "sourceSha256": "a9821718bc65816149c9a9356b70b3080f1936be58eee778f645d912bc7f0c03",
    "targetSha256": "5bf5456e5a7e7dd13074655720dd613669561edbc65eacb3432c74541181e79f",
    "nodeNames": [
      "MushroomEater_Entrance_2_1"
    ],
    "authoredPath": "Translations/hi/dialogue-batch-078.json"
  },
  {
    "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504456108449797",
    "key": "line:Mushroom_end_2_039b8e9",
    "source": "Их накопилось столько, что шляпа гриба покроет всю поверхность Земли.",
    "target": "वे इतने बढ़ गए हैं कि मशरूम की छतरी पूरी पृथ्वी को ढक लेगी।",
    "sourceSha256": "7be2bc17a5e2c59cc89039b350c76118dc39443b30e10e59840753e5fb47e7dd",
    "targetSha256": "4988e78e5f1276d0b28b04f7f95f7285b40ad924e568b09416eaa2bd23d3ae39",
    "nodeNames": [
      "Mushroom_end_2"
    ],
    "authoredPath": "Translations/hi/dialogue-batch-080.json"
  },
  {
    "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504456108449796",
    "key": "line:Mushroom_end_2_0bbb282",
    "source": "И чем больше грибы...",
    "target": "और मशरूम जितने बड़े...",
    "sourceSha256": "a92bdf83690c95cae641d961d37ad1442a2aadc5df506c7c9446b28ea7cca794",
    "targetSha256": "0bc53266ebe044ecbc83d0c37d7904b3b94ed0bb17f6e067176d89a9e6ee7262",
    "nodeNames": [
      "Mushroom_end_2"
    ],
    "authoredPath": "Translations/hi/dialogue-batch-080.json"
  },
  {
    "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504456041340931",
    "key": "line:Mushroom_end_2_0699a5b",
    "source": "Теперь, мицелию надо эту злобу куда-то деть...",
    "target": "अब माइसीलियम को यह द्वेष कहीं निकालना होगा...",
    "sourceSha256": "f4a228895f1ab192a3f8159307b6c84d5cf7e00b4796be9bb5ca52406ef4816f",
    "targetSha256": "5d6aaf59de5075038c19d74e2a1b74db9b22ddfa4eca74cdbd9acfa26e76b786",
    "nodeNames": [
      "Mushroom_end_2"
    ],
    "authoredPath": "Translations/hi/dialogue-batch-080.json"
  },
  {
    "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504456041340930",
    "key": "line:Mushroom_end_2_02a5ab8",
    "source": "И ничего не останется.",
    "target": "और कुछ भी नहीं बचेगा।",
    "sourceSha256": "9a19732bd17a9260f0ac797be2af4fd29abb87ee1664bbf95ad177ee984cd905",
    "targetSha256": "473c396cd5bf64f84377b0e4a7d33fdeb550efd91865a6a23d0c806479ec6f0d",
    "nodeNames": [
      "Mushroom_end_2"
    ],
    "authoredPath": "Translations/hi/dialogue-batch-080.json"
  },
  {
    "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504456041340929",
    "key": "line:Mushroom_end_2_0f27bf6",
    "source": "Тем больше комков злобы в мицелии.",
    "target": "माइसीलियम में द्वेष की उतनी ही ज़्यादा गाँठें बनेंगी।",
    "sourceSha256": "41b32f29cfbf1f336d7b7aa0537a65416d01b19b17735f9305ffcaac14a37b98",
    "targetSha256": "0d384016be3b0a6fcf27d0120a66d8d74e7276ffe9c4dba49ec23941ed848bc3",
    "nodeNames": [
