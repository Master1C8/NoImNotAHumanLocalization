  "entries": [
    {"id": 110504453788999687, "target": "मुँह-हाथ धोएँ"},
    {"id": 110504453788999684, "target": "भाड़ में जाए यह सब"},
    {"id": 110504453747056646, "target": "आख़िर वह कैसी रिपोर्ट थी?"},
    {"id": 110504453747056644, "target": "कान ठीक हैं।"},
    {"id": 110504453747056641, "target": "मुँह-हाथ धोने चाहिए। उम्मीद है इससे फ़ायदा होगा।"},
    {"id": 110504453742862345, "target": "जलन लग रही है या, उससे भी बुरा, फफूँद संक्रमण।"},
    {"id": 110504453742862344, "target": "भाड़ में जाए, यह क्या बकवास है!?"},
    {"id": 110504453742862343, "target": "जैसा होना चाहिए।"},
    {"id": 110504453742862342, "target": "बगलों में बाल हैं।"},
    {"id": 110504453742862339, "target": "लाल नहीं हैं, तो नुक़्स निकालने की कोई वजह नहीं।"},
    {"id": 110504453742862338, "target": "आँखें ठीक लग रही हैं।"},
    {"id": 110504453742862337, "target": "कैफ़ीन वाली वह बकवास नहीं पीनी चाहिए थी।"},
    {"id": 110504453742862336, "target": "धत् तेरे की। ये लाल हैं…"},
    {"id": 110504453591867396, "target": "उँगलियों के निशानों पर बारूद के चिह्न हैं। मगर यह कोई बड़ी बात नहीं।"},
    {"id": 110504453591867395, "target": "हाथ साफ़ हैं…"},
    {"id": 110504453591867394, "target": "सब उस गुफा की खुदाई की वजह से है।"},
    {"id": 110504453591867393, "target": "नाख़ून गंदे हैं…"},
    {"id": 110504453587673094, "target": "अच्छा ही है। इस तरह कोई मुझे अतिथि नहीं समझेगा।"},
    {"id": 110504453587673093, "target": "दाँत पीले हैं…"},
    {"id": 110504453587673092, "target": "धूम्रपान करने वाले ऐसे दाँतों के लिए अपनी एक किडनी बेच दें।"},
    {"id": 110504453587673091, "target": "धत्, सफ़ेद हैं…"},
    {"id": 110504453587673088, "target": "मुँह-हाथ धोएँ"},
    {"id": 110504453583478786, "target": "मुझे अपनी जाँच करनी चाहिए।"}
  ]
}
