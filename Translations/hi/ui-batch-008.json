    {"id": 78987670541029376, "target": "अपनी रक्षा करनी होगी। हर तरीका जायज़ है।"},
    {"id": 78987749125509120, "target": "पूरी कोशिश करो तो बचा जा सकता है।\r\nयह दुनिया पहले ही अभिशप्त हो चुकी है।\r"},
    {"id": 78988993487425536, "target": "खिड़कियों पर तख्ते ठोकने होंगे। हालात और बिगड़ेंगे, फिर भी बचने की कोशिश करनी होगी।"},
