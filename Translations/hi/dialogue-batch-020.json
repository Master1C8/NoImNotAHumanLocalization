  "entries": [
    {"id": 110504452799143942, "target": "Daughter: ..."},
    {"id": 110504452799143941, "target": "Daughter: पापा कहते थे परजीवियों, किलनियों और कीड़ों से डरना चाहिए। क्या आप वही ढूँढ़ रहे हैं?"},
    {"id": 110504452799143940, "target": "Daughter: मुझे अच्छा नहीं लगा। मुझसे फिर फ़ोटो खिंचवाने को मत कहिए।"},
    {"id": 110504452799143939, "target": "Daughter: शुक्रिया।"},
    {"id": 110504452799143938, "target": "Daughter: हम्म्म।"},
    {"id": 110504452799143937, "target": "Daughter: ..."},
    {"id": 110504452799143936, "target": "Daughter: बाद में फ़ोटो दिखाएँगे?"},
    {"id": 110504452794949639, "target": "Daughter: मेरी तो ज़्यादा फ़ोटो खींची ही नहीं गईं।"},
    {"id": 110504452794949638, "target": "Daughter: फ़ोटो?"},
    {"id": 110504452052557829, "target": "Daughter: मुझे अच्छा नहीं लगा। मुझसे फिर फ़ोटो खिंचवाने को मत कहना।"},
    {"id": 110504452052557828, "target": "Daughter: शुक्रिया।"},
    {"id": 110504452052557827, "target": "Daughter: हम्म्म।"},
    {"id": 110504452052557826, "target": "Daughter: (फ़ोटो खींचने का काम ख़त्म होने से पहले ही बच्ची आपके पास दौड़ आई।)"},
    {"id": 110504452052557825, "target": "Daughter: (फ़ोटो थोड़ी धुँधली आई।)"},
    {"id": 110504452052557824, "target": "Daughter: (आप बच्ची की फ़ोटो खींचते हैं।)"},
    {"id": 110504452048363530, "target": "Daughter: बाद में फ़ोटो दिखाओगे?"},
    {"id": 110504452048363529, "target": "Daughter: मेरी तो ज़्यादा फ़ोटो खींची ही नहीं गईं।"},
    {"id": 110504452048363528, "target": "Daughter: फ़ोटो?"},
    {"id": 110504452048363523, "target": "Daughter: म-मुझे कुछ पी-ई-ना है।"},
    {"id": 110504452048363522, "target": "Daughter: आप... आआआ..."},
    {"id": 110504452048363521, "target": "Daughter: आपने वहाँ क-क्या देखा..."},
    {"id": 110504452048363520, "target": "Daughter: आपने ऐसे क्यों देखा?"},
    {"id": 110504452044169227, "target": "Daughter: ..."},
    {"id": 110504452044169226, "target": "Daughter: तो मैं सोचते समय सावधान रहूँगी, चिंता मत कीजिए।"},
    {"id": 110504452044169225, "target": "Daughter: क्या आप मेरी आँख में मेरी सारी सोच देख लेंगे?"},
    {"id": 110504452044169224, "target": "Daughter: क्या आप आँख के अंदर झाँक सकते हैं?"},
    {"id": 110504452044169223, "target": "Daughter: मैं जा रही हूँ, कुछ देर अकेले बैठना चाहती हूँ।"},
    {"id": 110504452044169222, "target": "Daughter: ये मैंने ख़ुद काटे हैं। कर लिया। ख़ुद ही।"},
    {"id": 110504452044169221, "target": "Daughter: देखिए, मेरे नाखून कैसे हैं।"},
    {"id": 110504452044169220, "target": "Daughter: ..."},
    {"id": 110504452044169219, "target": "Daughter: देखिए।"},
    {"id": 110504452044169218, "target": "Daughter: मैं अभी उतनी अच्छी तरह नहीं कर पाती, मुझे..."},
    {"id": 110504452044169217, "target": "Daughter: अब मैं अपने नाखून ख़ुद काट सकती हूँ।"},
    {"id": 110504452044169216, "target": "Daughter: सब ठीक है ना?"},
    {"id": 110504452039974921, "target": "Daughter: इसका क्या मतलब है?"},
    {"id": 110504452039974920, "target": "Daughter: देखिए, मेरे कैसे हैं।"},
    {"id": 110504452039974919, "target": "Daughter: ..."},
    {"id": 110504452039974918, "target": "Daughter: अब मैं नहीं रोऊँगी।"},
    {"id": 110504452039974917, "target": "Daughter: क्यों? मेरे तो अभी दूध के दाँत हैं। पापा कहते थे..."},
    {"id": 110504452039974916, "target": "Daughter: दाँत? आपको अपने दाँत दिखाऊँ?"}
  ]
}
