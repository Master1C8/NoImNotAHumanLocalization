  "entries": [
    {
      "id": 110504451956088838,
      "target": "Esenin: तो बोल, क्या मैं अतिथि हूँ?"
    },
    {
      "id": 110504451956088837,
      "target": "Esenin: ..."
    },
    {
      "id": 110504451956088836,
      "target": "Esenin: मेरे नाख़ून देख ले।"
    },
    {
      "id": 110504451956088835,
      "target": "Esenin: कैसी बकवास है।"
    },
    {
      "id": 110504451956088834,
      "target": "Esenin: तो फिर कोई माली भी सीधे अतिथि बन जाता है क्या?"
    },
    {
      "id": 110504451956088833,
      "target": "Esenin: वे हाथ धो भी तो सकते हैं! बस!"
    },
    {
      "id": 110504451956088832,
      "target": "Esenin: नाख़ूनों में मिट्टी? यह कोई लक्षण है?"
    },
    {
      "id": 110504451951894538,
      "target": "Esenin: वे आए कहाँ से?"
    },
    {
      "id": 110504451951894537,
      "target": "Esenin: मैं अतिथि नहीं हूँ।"
    },
    {
      "id": 110504451951894536,
      "target": "Esenin: तो अपनी जाँचों को लेकर मेरे पीछे मत पड़।"
    },
    {
      "id": 110504451951894535,
      "target": "Esenin: पीले-से हैं, है न?"
    },
    {
      "id": 110504451951894534,
      "target": "Esenin: ..."
    },
    {
      "id": 110504451951894533,
      "target": "Esenin: देख ले। इनमें अब भी बदकिस्मती और धुएँ का स्वाद बसा है।"
    },
    {
      "id": 110504451951894532,
      "target": "Esenin: मेरे दाँत देखना चाहता है?"
    },
    {
      "id": 110504451947700232,
      "target": "Esenin: क्या जाँचना चाहता है?"
    }
  ]
}
