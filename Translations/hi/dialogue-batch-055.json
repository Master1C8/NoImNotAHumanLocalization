  "entries": [
    {"id": 110504456108449794, "target": "मगर यह बाद में।"},
    {"id": 110504456108449793, "target": "कोई रास्ते में नहीं आता।"},
    {"id": 110504456108449792, "target": "बहुत शांति है।"},
    {"id": 110504456037146633, "target": "थोड़ा सो लेता हूँ।"},
    {"id": 110504456037146632, "target": "कुछ थक गया हूँ।"},
    {"id": 110504456037146630, "target": "काश फिर उन सबसे पूरे परिवार के साथ मिल पाता।"},
    {"id": 110504456037146629, "target": "क्या कोई मेरे पास आएगा?"},
    {"id": 110504456037146628, "target": "मुझे यहाँ क्यों आने दिया गया?"},
    {"id": 110504456037146627, "target": "यह सब आख़िर था क्या?"},
    {"id": 110504456037146626, "target": "काश यह ऐसे ही कुछ और समय रहे…"},
    {"id": 110504456037146625, "target": "मगर मेरा ऐसा इरादा भी नहीं।"},
    {"id": 110504456037146624, "target": "मुझे नहीं पता यहाँ से कैसे निकलूँ।"},
    {"id": 110504456032952331, "target": "मुझे याद नहीं कि यहाँ कैसे पहुँचा।"},
    {"id": 110504456032952330, "target": "कोई दख़ल नहीं देता। कोई छूता नहीं।"},
    {"id": 110504456032952329, "target": "मगर… अब मन शांत है।"},
    {"id": 110504456032952328, "target": "पता नहीं कब से यहाँ बैठा हूँ।"},
    {"id": 110504456032952327, "target": "यहाँ दिन और रात बदलते नहीं।"},
    {"id": 110504456032952324, "target": "मुझे डर लग रहा है"},
    {"id": 110504456032952323, "target": "क्या यहाँ कोई है?"},
    {"id": 110504456032952321, "target": "मुझे डर लग रहा है"},
    {"id": 110504456032952320, "target": "क्या यहाँ कोई है?"},
    {"id": 110504456028758025, "target": "क्या मैं कोई फ़िल्म देख सकता हूँ?"},
    {"id": 110504456028758024, "target": "क्या यहाँ कोई और आएगा?"},
    {"id": 110504456028758022, "target": "क्या मैं कोई फ़िल्म देख सकता हूँ?"},
    {"id": 110504456028758021, "target": "क्या यहाँ कोई और आएगा?"},
    {"id": 110504456028758019, "target": "क्या मैं यहाँ हमेशा रहूँगा?"},
    {"id": 110504456028758018, "target": "क्या मैं मर गया हूँ?"},
    {"id": 110504456028758016, "target": "इसका आनंद लो।"},
    {"id": 110504456024563722, "target": "वे बड़ी, धूल भरी और समझौतों से अटी हुई लगेंगी।"},
    {"id": 110504456024563721, "target": "उसकी छोटी राहें बाद में तुम्हें अजीब तरह से चौड़ी लगेंगी।"},
    {"id": 110504456024563720, "target": "यह तुम्हारी जगह है।"},
    {"id": 110504456024563719, "target": "तुम यही चाहते थे, है न?"}
  ]
}
