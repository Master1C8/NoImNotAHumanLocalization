  "entries": [
    {"id": 110504456330747915, "target": "Daughter: मुझे ब-बहुत ड-ड-डर लग रहा है!"},
    {"id": 110504456330747914, "target": "Daughter: आआआआआआआ!"},
    {"id": 110504456330747913, "target": "Daughter: आआआआआ..."},
    {"id": 110504456330747912, "target": "Daughter: मैं क-क-कहाँ जाऊँगी?"},
    {"id": 110504456330747911, "target": "Daughter: म-मुझे डर लग रहा है।"},
    {"id": 110504456330747910, "target": "Daughter: आ-आप मेरी म-मदद करेंगे?"},
    {"id": 110504456330747907, "target": "Daughter: ज-ज-जब मैं भाग रही थी, वे बस हँस रहे थे।"},
    {"id": 110504456330747906, "target": "Daughter: फिर उन्होंने कुछ कि-किया, और उसके बाद घर में आ-आग लगा दी।"},
    {"id": 110504456330747905, "target": "Daughter: वे आराम से पापा के साथ रसोई में ब-बैठे थे।"},
    {"id": 110504456330747904, "target": "Daughter: म-मुझे नहीं पता।"},
    {"id": 110504456326553623, "target": "Daughter: हमारा घर अब ज-ज-जल रहा है।"},
    {"id": 110504456326553622, "target": "Daughter: आआआ-हाआआ..."},
    {"id": 110504456326553621, "target": "Daughter: पापा उनसे कुछ ब-बात कर रहे थे। फिर उन्होंने पापा को मार डाला।"},
    {"id": 110504456326553620, "target": "Daughter: हमारे घर अ-अतिथि आए थे। वे हमारे यहाँ ब-बैठे थे।"},
    {"id": 110504456326553619, "target": "उन्होंने ऐसा क्यों किया?"},
    {"id": 110504456326553618, "target": "यह किसने किया?"},
    {"id": 110504456326553617, "target": "Daughter: पा-पापा को मार डाला।"},
    {"id": 110504456326553616, "target": "Daughter: आ-आ-हाआआ..."},
    {"id": 110504456326553615, "target": "Daughter: मे-मेरे पा-पापा को..."},
    {"id": 110504456326553614, "target": "Daughter: आ-आ-आआ..."},
    {"id": 110504456326553613, "target": "उन्होंने ऐसा क्यों किया?"},
    {"id": 110504456326553612, "target": "यह किसने किया?"},
    {"id": 110504456326553611, "target": "Daughter: पा-पापा को।"},
    {"id": 110504456326553610, "target": "Daughter: आ-आ-हाआआ..."},
    {"id": 110504456326553609, "target": "Daughter: मा-मार डाला पा..."},
    {"id": 110504456326553608, "target": "Daughter: आ-आ-आआ..."},
    {"id": 110504456326553607, "target": "Daughter: लो-ओ-ोग।"},
    {"id": 110504456326553606, "target": "Daughter: म-मुझे नहीं पता मैं क्या क-करूँ।"}
  ]
}
