  "entries": [
    {"id": 110504457148637184, "target": "Ballerina: Lihat si berbulu itu?"},
    {"id": 110504457144442890, "target": "Ballerina: Aku bicara pada kucing itu, bukan padamu."},
    {"id": 110504457144442889, "target": "Ballerina: Ayo, Kucing, hibur aku di sini, ya?"},
    {"id": 110504457144442886, "target": "Ballerina: Eh, katanya orang seperti itu tak boleh ada di sini. Ayo, usir dia."},
    {"id": 110504457144442885, "target": "Ballerina: Apa {0} ada di rumahmu?"},
    {"id": 110504456574017540, "target": "Ballerina: Itu hadiah kecil dariku untukmu."},
    {"id": 110504456574017539, "target": "Ballerina: Kau akan menemukan kucing itu di bawah rumah."},
    {"id": 110504456574017537, "target": "Ballerina: Ayo, Kucing, hibur aku di sini, ya?"},
    {"id": 110504456574017536, "target": "Ballerina: Anggap saja ini rumahmu sendiri."},
    {"id": 110504456569823243, "target": "Enyahlah, sialan"},
    {"id": 110504456569823242, "target": "…Masuklah"},
    {"id": 110504456569823241, "target": "Ballerina: Pikirkan lagi."},
    {"id": 110504456569823240, "target": "Ballerina: Lihat kucing itu?"},
    {"id": 110504456569823239, "target": "Ballerina: Dan jangan siksa kucingnya."},
    {"id": 110504456569823238, "target": "Ballerina: Jangan biarkan seorang perempuan membeku kedinginan di luar, Anak Muda."},
    {"id": 110504456569823234, "target": "Ballerina: Mau buka pintunya? Tidak?"},
    {"id": 110504456569823233, "target": "Ballerina: Aku sudah lulus semua pemeriksaanmu?"},
    {"id": 110504456569823232, "target": "Ballerina: Belum cukup?"},
    {"id": 110504456565628939, "target": "Ballerina: Aku punya dua tangan, dua kaki, satu kepala."},
    {"id": 110504456565628936, "target": "Ballerina: Ayo, putuskan apa yang akan kita lakukan."},
    {"id": 110504456565628935, "target": "Ballerina: Aku anak balet."},
    {"id": 110504456565628934, "target": "Ballerina: Mungkin aku akan menari juga."},
    {"id": 110504456565628933, "target": "Ballerina: Mau aku menari untukmu?"},
    {"id": 110504456565628932, "target": "Ballerina: Lalu kenapa?"},
    {"id": 110504456565628931, "target": "Buktikan bahwa kamu manusia"},
    {"id": 110504456565628930, "target": "Aku tidak percaya kamu manusia"},
    {"id": 110504456565628929, "target": "Ballerina: Kalimat yang aneh."},
    {"id": 110504456565628928, "target": "Ballerina: Lalu apa? Aku mengingatkanmu tentang dia? Atau bagaimana?"},
    {"id": 110504456561434635, "target": "Ballerina: Hmm… baiklah."},
    {"id": 110504456561434634, "target": "Buktikan bahwa kamu manusia"},
    {"id": 110504456561434633, "target": "Aku tidak percaya kamu manusia"},
    {"id": 110504456561434632, "target": "Ballerina: Heh."},
    {"id": 110504456561434630, "target": "Ballerina: Entahlah. Memangnya kenapa?"},
    {"id": 110504456561434629, "target": "Kamu mengingatkanku pada seorang… manusia"},
    {"id": 110504456561434628, "target": "Ada yang mengirimmu ke sini?"},
    {"id": 110504456561434627, "target": "Ballerina: Rumahmu tidak panas."},
    {"id": 110504456561434626, "target": "Ballerina: Aku melihat rumahmu lalu datang."},
    {"id": 110504456561434625, "target": "Ballerina: Lihat kota itu? Aku dulu tinggal di sana."},
    {"id": 110504456561434624, "target": "Kamu mengingatkanku pada seorang… manusia"},
    {"id": 110504456557240330, "target": "Ada yang mengirimmu ke sini?"},
    {"id": 110504456557240329, "target": "Ballerina: Aku pernah belajar balet. Kelihatan?"},
    {"id": 110504456557240328, "target": "Ballerina: Aku menari."},
    {"id": 110504456557240327, "target": "Bagaimana kamu menemukan rumahku?"},
    {"id": 110504456557240325, "target": "Ballerina: Mereka menyuruhku datang ke sini, jadi aku datang."},
    {"id": 110504456557240324, "target": "Ballerina: Kamu mau membuka pintu atau tidak?"}
  ]
}
