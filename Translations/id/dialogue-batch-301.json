  "entries": [
    {
      "id": 110504456938921994,
      "target": "CultistPriest: Kematian berhenti berbicara kepadaku."
    },
    {
      "id": 110504456934727690,
      "target": "Aku tak peduli. Aku punya banyak urusan sendiri"
    },
    {
      "id": 110504456934727689,
      "target": "Mereka hidup, mereka hidup"
    },
    {
      "id": 110504456934727688,
      "target": "CultistPriest: Aku akan langsung bertanya. Bagaimana keadaan orang-orangku?"
    },
    {
      "id": 110504456913756166,
      "target": "Rumahku hanya cocok untukku"
    },
    {
      "id": 110504456913756165,
      "target": "Apa yang kaurasakan?"
    },
    {
      "id": 110504456913756164,
      "target": "CultistPriest: Aku benar-benar bisa merasakannya."
    },
    {
      "id": 110504456913756163,
      "target": "CultistPriest: Yaaa. Rumahmu cocok."
    },
    {
      "id": 110504456892784646,
      "target": "Tidak banyak"
    },
    {
      "id": 110504456892784645,
      "target": "Apa?"
    },
    {
      "id": 110504456892784644,
      "target": "Intruder: Apa kau memimpikan sesuatu?"
    },
    {
      "id": 110504456880201729,
      "target": "Kali ini kalian datang untukku?"
    },
    {
      "id": 110504456880201728,
      "target": "Kembalikan dulu orang-orang yang kaubawa pergi."
    },
    {
      "id": 110504456876007435,
      "target": "FormerFema: Apakah Anda… akan membuka pintu?"
    },
    {
      "id": 110504456876007434,
      "target": "FormerFema: Aku mendengar langkah kaki, jadi Anda pasti sudah mendekati pintu."
    },
    {
      "id": 110504456876007433,
      "target": "FormerFema: Ada orang di sini?"
    },
    {
      "id": 110504456863424519,
      "target": "Ketuk saja kepalamu sendiri"
    },
    {
      "id": 110504456863424518,
      "target": "Jangan dobrak pintuku"
    },
    {
      "id": 110504456863424517,
      "target": "GraveDigger: Izinkan aku masuk, dong!"
    },
    {
      "id": 110504456863424516,
      "target": "GraveDigger: Ada orang hidup di sini? HALO!"
    },
    {
      "id": 110504456850841602,
      "target": "Kenapa menurutmu itu ide bagus?"
    },
    {
      "id": 110504456850841601,
      "target": "Kenapa kau berjalan sendirian?"
    },
    {
      "id": 110504456850841600,
      "target": "Marauder: Dengar, boleh aku tinggal di rumahmu? Sudah lama aku tak berada dalam kelompok."
    },
    {
      "id": 110504456846647306,
      "target": "Marauder: Walaupun…"
    },
    {
      "id": 110504456846647305,
      "target": "Marauder: Halo. Kukira tak ada orang lagi di sini. Sudahlah, aku pergi."
    },
    {
      "id": 110504456846647304,
      "target": "Marauder: Ah, oh, ternyata ada orang yang tinggal di sini."
    },
    {
      "id": 110504456838258690,
      "target": "Aku cuma mengizinkan orang masuk ke rumahku"
    },
    {
      "id": 110504456838258689,
      "target": "Kurang lebih begitu"
    },
    {
      "id": 110504456838258688,
      "target": "Provocateur: Halo, pemilik rumah. Apa Anda menyewakan tempat di sini?"
    },
    {
      "id": 110504456825675777,
      "target": "Apa yang bisa kubantu?"
    },
    {
      "id": 110504456825675776,
      "target": "Apa yang terjadi?"
    },
    {
      "id": 110504456821481483,
      "target": "TaxiDriver: Dengar, aku benar-benar terjerat masalah. Boleh aku bersembunyi di rumahmu?"
    },
    {
      "id": 110504456821481482,
      "target": "TaxiDriver: Halo, Bung."
    },
    {
      "id": 110504456808898566,
      "target": "Apa yang indah di sini?"
    },
    {
      "id": 110504456808898565,
      "target": "Kenapa kau tidak tinggal di rumah saja?"
    },
    {
      "id": 110504456808898564,
      "target": "Edgar: Kuharap aku boleh tinggal di rumahmu."
    },
    {
      "id": 110504456808898563,
      "target": "Edgar: Bahkan lebih sunyi daripada di kota. Di sana sangat bising dan sibuk."
    },
    {
      "id": 110504456808898562,
      "target": "Edgar: Halo. Tempatmu indah."
    },
    {
      "id": 110504456800509956,
      "target": "Apa?"
    },
    {
      "id": 110504456800509955,
      "target": "Ada apa denganmu?"
    },
    {
      "id": 110504456800509954,
      "target": "Foreigner: Пффыыыы."
    },
    {
      "id": 110504456800509953,
      "target": "Foreigner: Пффыыв."
    },
    {
      "id": 110504456787927044,
      "target": "Apa Anda sedang mencari sesuatu?"
    },
    {
      "id": 110504456787927043,
      "target": "Apa Anda mengawasi rumah ini?"
    },
    {
      "id": 110504456787927042,
      "target": "Doctor: Halo! Bolehkah aku masuk?"
    },
    {
      "id": 110504456787927041,
      "target": "Doctor: Rumah Anda sunyi sekali pada malam hari."
    },
    {
      "id": 110504456787927040,
      "target": "Doctor: Oh, kukira tak ada orang di rumah."
    },
    {
      "id": 110504456775344138,
      "target": "Apa kau salah satu dari gerombolan binatang itu?"
    },
    {
      "id": 110504456775344137,
      "target": "Apa maksudmu?"
    },
    {
      "id": 110504456775344136,
      "target": "Wolfhound: Akhirnya tak ada yang berpura-pura."
    }
  ]
}
