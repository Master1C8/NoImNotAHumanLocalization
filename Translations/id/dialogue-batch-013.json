  "entries": [
    {"id": 110504456330747915, "target": "Daughter: AKU TAKUUUUUT SEKALIIII."},
    {"id": 110504456330747914, "target": "Daughter: AAAAAAAAAAA."},
    {"id": 110504456330747913, "target": "Daughter: Aaaaaaaaaaa."},
    {"id": 110504456330747912, "target": "Daughter: Aku harus pergi ke manaaaa?"},
    {"id": 110504456330747911, "target": "Daughter: Aku ta-a-akut."},
    {"id": 110504456330747910, "target": "Daughter: Anda akan me-membantuku?"},
    {"id": 110504456330747907, "target": "Daughter: Waktu aku la-lari, mereka malah tertawa."},
    {"id": 110504456330747906, "target": "Daughter: Lalu mereka me-melakukan sesuatu, terus me-membakar rumah."},
    {"id": 110504456330747905, "target": "Daughter: Mereka tadi duduk tenang bersama Ayah di dapur."},
    {"id": 110504456330747904, "target": "Daughter: A-aku tidak tahu."},
    {"id": 110504456326553623, "target": "Daughter: Rumah kami se-sekarang te-terbakaaaar."},
    {"id": 110504456326553622, "target": "Daughter: Aaaaaaaaaa-haaaaaa."},
    {"id": 110504456326553621, "target": "Daughter: Ayah tadi bi-bicara dengan mereka. Lalu mereka membunuhnya."},
    {"id": 110504456326553620, "target": "Daughter: Ta-a-amu datang ke rumah kami. Mereka du-duduk di rumah."},
    {"id": 110504456326553619, "target": "Kenapa mereka melakukan itu?"},
    {"id": 110504456326553618, "target": "Siapa yang melakukannya?"},
    {"id": 110504456326553617, "target": "Daughter: A-a-ayah dibunuh."},
    {"id": 110504456326553616, "target": "Daughter: A-a-a-ha-a-a-ah."},
    {"id": 110504456326553615, "target": "Daughter: A-a-ayahku..."},
    {"id": 110504456326553614, "target": "Daughter: A-a-a-a-a-a."},
    {"id": 110504456326553613, "target": "Kenapa mereka melakukan itu?"},
    {"id": 110504456326553612, "target": "Siapa yang melakukannya?"},
    {"id": 110504456326553611, "target": "Daughter: A-ayah."},
    {"id": 110504456326553610, "target": "Daughter: A-a-a-ha-a-a-a."},
    {"id": 110504456326553609, "target": "Daughter: Di-dibunuh... A..."},
    {"id": 110504456326553608, "target": "Daughter: A-a-a-a-a-a."},
    {"id": 110504456326553607, "target": "Daughter: Oraaaang-orang."},
    {"id": 110504456326553606, "target": "Daughter: A-aku ti-tidak tahu harus ba-bagaimana."}
