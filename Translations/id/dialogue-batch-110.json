  "entries": [
    {
      "id": 110504457228328960,
      "target": "Wheelchair: Lihat, kakiku—bukti berjalan! Kelihatan, kan, keduanya memang tidak ada, hah?"
    },
    {
      "id": 110504457224134666,
      "target": "Wheelchair: Pasti berhasil!"
    },
    {
      "id": 110504457224134665,
      "target": "Wheelchair: Tidak mau membiarkanku masuk? Biar kuatasi! Ini {0}, ambil, kibaskan di pintu masuk dan — hop! — kau jadi tak terlihat."
    },
    {
      "id": 110504456162975749,
      "target": "Wheelchair: O-o-oh, aku meluncur dari sini. Gila kau."
    },
    {
      "id": 110504456162975748,
      "target": "Wheelchair: Bagaimana aku bisa pergi?"
    },
    {
      "id": 110504456162975747,
      "target": "Wheelchair: Pergi? Dasar goblok!"
    },
    {
      "id": 110504456162975746,
      "target": "Wheelchair: Kita balapan di rumahmu, ya?"
    },
    {
      "id": 110504456162975745,
      "target": "Wheelchair: Nah, begitu dong!"
    },
    {
      "id": 110504456158781450,
      "target": "Wheelchair: Dengar, aku sudah jauh-jauh datang. Tolong biarkan aku masuk, ya?"
    },
    {
      "id": 110504456158781449,
      "target": "Wheelchair: Sepertinya aku memang salah."
    },
    {
      "id": 110504456158781448,
      "target": "Wheelchair: Sial…"
    },
    {
      "id": 110504456158781445,
      "target": "Wheelchair: Tidaaak…"
    },
    {
      "id": 110504456158781443,
      "target": "Wheelchair: Tidak, aku tak mungkin..."
    },
    {
      "id": 110504456158781440,
      "target": "Wheelchair: Dengar, aku sudah jauh-jauh datang. Tolong biarkan aku masuk, ya?"
    },
    {
      "id": 110504456154587146,
      "target": "Wheelchair: Temanku pasti tinggal… maksudku, dulu tinggal di sini."
    },
    {
      "id": 110504456154587145,
      "target": "Wheelchair: Aku tak mungkin salah, ingatanku tak pernah meleset."
    },
    {
      "id": 110504456154587144,
      "target": "Wheelchair: Tidak, ayolah."
    },
    {
      "id": 110504456154587143,
      "target": "Kurasa kamu cuma salah alamat."
    },
    {
      "id": 110504456154587142,
      "target": "Rumah ini selalu milik keluarga kami."
    },
    {
      "id": 110504456154587141,
      "target": "Wheelchair: Sudah berapa lama Anda tinggal di sini?"
    },
    {
      "id": 110504456154587140,
      "target": "Wheelchair: Kamu bukan temanku."
    },
    {
      "id": 110504456154587138,
      "target": "Wheelchair: Oh, kamu bukan…"
    },
    {
      "id": 110504456154587137,
      "target": "Kurasa kamu cuma salah alamat."
    },
    {
      "id": 110504456154587136,
      "target": "Rumah ini selalu milik keluargaku."
    },
    {
      "id": 110504456150392842,
      "target": "Wheelchair: Sejak kapan rumah ini berganti pemilik?"
    },
    {
      "id": 110504456150392840,
      "target": "Wheelchair: Tunggu, suaramu berbeda…"
    },
    {
      "id": 110504456150392838,
      "target": "Wheelchair: Tapi kita ini…"
    },
    {
      "id": 110504456150392837,
      "target": "Wheelchair: Bagaimana bisa? Kamu… tidak ingat aku?"
    }
  ]
}
