  "entries": [
    {"id": 110504457941360644, "target": "Phone: Tapi aku masih merindukannya..."},
    {"id": 110504457941360642, "target": "Phone: Pergi jauh-jauh!"},
    {"id": 110504457941360641, "target": "Phone: Ah, kenapa aku malah membela diri di hadapan Anda?"},
    {"id": 110504457941360640, "target": "Phone: Kumohon..."},
    {"id": 110504457937166346, "target": "Phone: Jangan telepon ke sini lagi..."},
    {"id": 110504457937166345, "target": "Phone: Maafkan aku."},
    {"id": 110504457937166343, "target": "Phone: Sekarang aku hanya menyesal kami tidak bertanya kepada putri pengganti itu apa yang telah makhluk itu lakukan kepada putri kecil kami..."},
    {"id": 110504457937166342, "target": "Phone: Suamiku membantuku menyadarinya."},
    {"id": 110504457937166341, "target": "Phone: Tapi kemudian aku sadar dia bukan putri kami."},
    {"id": 110504457937166340, "target": "Phone: Awalnya aku ingin membunuh suamiku sendiri."},
    {"id": 110504457937166338, "target": "Phone: Dia langsung menangani Tamu itu."},
    {"id": 110504457937166337, "target": "Phone: Begitu kuceritakan hal itu kepada suamiku, dia langsung..."},
    {"id": 110504457932972044, "target": "Phone: Semuanya cocok."},
    {"id": 110504457932972043, "target": "Phone: Karena itu aku langsung menyadari saat tanda-tanda itu muncul."},
    {"id": 110504457932972042, "target": "Phone: Aku mengenalnya luar dalam."},
    {"id": 110504457932972041, "target": "Phone: Dari semua tandanya."},
    {"id": 110504457932972040, "target": "Phone: Dia Tamu."},
    {"id": 110504457932972039, "target": "Aku mengerti"},
    {"id": 110504457932972038, "target": "Bangsat..."},
    {"id": 110504457932972037, "target": "Phone: Dia benar-benar Tamu! Semua tandanya cocok seratus persen!"},
    {"id": 110504457932972036, "target": "Phone: Anda tidak berhak menghakimiku!"},
    {"id": 110504457932972034, "target": "Jadi Anda memutuskan untuk membunuh anak sendiri?"},
    {"id": 110504457932972033, "target": "Phone: Semua tandanya cocok, dan suamiku bersikeras."},
    {"id": 110504457932972032, "target": "Phone: Kami membunuhnya. Mengertilah, kami harus melakukannya."},
    {"id": 110504457928777740, "target": "(Tutup telepon)"},
    {"id": 110504457928777739, "target": "Apa?"},
    {"id": 110504457928777738, "target": "Phone: Kami terpaksa membunuhnya."},
    {"id": 110504457928777737, "target": "Phone: Kami terpaksa..."},
    {"id": 110504457928777735, "target": "Phone: Dia meninggal..."},
    {"id": 110504457928777734, "target": "Phone: Putri kecil kami... dia..."}
  ]
}
