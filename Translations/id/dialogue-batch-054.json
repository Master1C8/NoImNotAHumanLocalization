  "entries": [
    {
      "id": 110504456108449794,
      "target": "Tapi itu nanti."
    },
    {
      "id": 110504456108449793,
      "target": "Tak seorang pun menghalangi langkahku."
    },
    {
      "id": 110504456108449792,
      "target": "Rasanya sangat tenang."
    },
    {
      "id": 110504456037146633,
      "target": "Aku akan tidur sebentar."
    },
    {
      "id": 110504456037146632,
      "target": "Entah kenapa aku lelah."
    },
    {
      "id": 110504456037146630,
      "target": "Andai aku bisa bertemu mereka lagi sebagai satu keluarga utuh."
    },
    {
      "id": 110504456037146629,
      "target": "Akankah ada yang datang kepadaku?"
    },
    {
      "id": 110504456037146628,
      "target": "Mengapa mereka membiarkanku masuk ke sini?"
    },
    {
      "id": 110504456037146627,
      "target": "Sebenarnya apa yang baru saja terjadi?"
    },
    {
      "id": 110504456037146626,
      "target": "Semoga keadaan ini bertahan lebih lama…"
    },
    {
      "id": 110504456037146625,
      "target": "Tapi aku juga tidak berniat begitu."
    },
    {
      "id": 110504456037146624,
      "target": "Aku tidak tahu cara keluar."
    },
    {
      "id": 110504456032952331,
      "target": "Aku tidak ingat bagaimana aku sampai di sini."
    },
    {
      "id": 110504456032952330,
      "target": "Tak ada yang mengusik. Tak ada yang menyentuhku."
    },
    {
      "id": 110504456032952329,
      "target": "Tapi… sekarang aku tenang."
    },
    {
      "id": 110504456032952328,
      "target": "Aku tidak tahu sudah berapa lama duduk di sini."
    },
    {
      "id": 110504456032952327,
      "target": "Di sini siang dan malam tidak berganti."
    },
    {
      "id": 110504456032952324,
      "target": "Aku takut"
    },
    {
      "id": 110504456032952323,
      "target": "Apa ada orang di sini?"
    },
    {
      "id": 110504456032952321,
      "target": "Aku takut"
    },
    {
      "id": 110504456032952320,
      "target": "Apa ada orang di sini?"
    },
    {
      "id": 110504456028758025,
      "target": "Bolehkah aku menonton film?"
    },
    {
      "id": 110504456028758024,
      "target": "Akankah ada orang lain di sini?"
    },
    {
      "id": 110504456028758022,
      "target": "Bolehkah aku menonton film?"
    },
    {
      "id": 110504456028758021,
      "target": "Akankah ada orang lain di sini?"
    },
    {
      "id": 110504456028758019,
      "target": "Apakah aku akan di sini selamanya?"
    },
    {
      "id": 110504456028758018,
      "target": "Apakah aku sudah mati?"
    },
    {
      "id": 110504456028758016,
      "target": "Nikmatilah."
    },
    {
      "id": 110504456024563722,
      "target": "Akan tampak besar, berdebu, dan penuh kompromi."
    },
    {
      "id": 110504456024563721,
      "target": "Dengan jalan-jalannya yang pendek, yang kelak akan tampak begitu lebar bagimu sampai terasa aneh."
    },
    {
      "id": 110504456024563720,
      "target": "Inilah tempatmu."
    },
    {
      "id": 110504456024563719,
      "target": "Bukankah ini yang kamu inginkan?"
    }
  ]
