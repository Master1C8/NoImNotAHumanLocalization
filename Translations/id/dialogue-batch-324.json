    {"id": 110504454258761731, "target": "Dari mana kau tahu semua itu tentangku?"},
    {"id": 110504454258761730, "target": "FortuneTeller: Mau kubacakan nasibmu dengan kartu?"},
    {"id": 110504454250373129, "target": "Apa yang terjadi antara kau dan istrimu?"},
    {"id": 110504454250373128, "target": "Anger: Bangsat, kacau sekali…"},
    {"id": 110504454246178826, "target": "Ada orang yang direnggut para anggota kultus darimu?"},
    {"id": 110504454246178825, "target": "Anger: Bangsat, kacau sekali…"},
    {"id": 110504454241984522, "target": "Kenapa kau begitu marah?"},
    {"id": 110504454241984521, "target": "Anger: Bangsat, kacau sekali…"},
    {"id": 110504454237790218, "target": "Nah, sudah reda amarahmu?"},
    {"id": 110504454237790217, "target": "Anger: Bangsat, kacau sekali…"},
    {"id": 110504454237790212, "target": "Apa yang mengerikan?"},
    {"id": 110504454237790211, "target": "Mother: Pengap sekali di sini…"},
    {"id": 110504454233595913, "target": "Anda tidak khawatir pada anak-anak Anda?"},
    {"id": 110504454233595912, "target": "Mother: Pengap sekali di sini…"},
    {"id": 110504454233595906, "target": "Memangnya apa yang dia lakukan?"},
    {"id": 110504454233595905, "target": "Mother: Pengap sekali di sini…"},
    {"id": 110504454229401608, "target": "Sudah pergi menemui suami Anda?"},
    {"id": 110504454229401607, "target": "Mother: Pengap sekali di sini…"},
    {"id": 110504454229401601, "target": "Bagaimana? Sudah menelepon suami Anda?"},
    {"id": 110504454229401600, "target": "Mother: Pengap sekali di sini…"},
    {"id": 110504454225207303, "target": "Anda datang bersama seorang anak tadi."},
    {"id": 110504454225207302, "target": "Mother: Pengap sekali di sini…"},
    {"id": 110504454221012998, "target": "Lalu, ada apa dengan kakimu?"},
    {"id": 110504454221012997, "target": "WheelChair: Ah, hidupku ini bagai kaleng rombeng…"},
    {"id": 110504454216818695, "target": "Bagaimana kau kehilangan kakimu?"},
    {"id": 110504454216818694, "target": "WheelChair: Ah, hidupku ini bagai kaleng rombeng…"},
    {"id": 110504454208430087, "target": "Kepalamu kepanasan, ya?"},
    {"id": 110504454208430086, "target": "WheelChair: Ah, hidupku ini bagai kaleng rombeng…"},
    {"id": 110504454195847177, "target": "Kau… baik-baik saja?"},
    {"id": 110504454195847176, "target": "WheelChair: Ah, hidupku ini bagai kaleng rombeng…"},
    {"id": 110504454191652868, "target": "Siapa yang kaucari?"},
    {"id": 110504454191652867, "target": "WheelChair: Ah, hidupku ini bagai kaleng rombeng…"},
    {"id": 110504454183264256, "target": "Kau kelihatan sakit sekali."},
