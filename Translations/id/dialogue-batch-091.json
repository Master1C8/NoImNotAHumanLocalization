  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504453751250949,
      "target": "Sirin: Aku siap..."
    },
    {
      "id": 110504453751250948,
      "target": "Sirin: Bagaimana aku... tanpa dia..."
    },
    {
      "id": 110504453751250947,
      "target": "Sirin: Kematian telah merenggut saudara perempuanku..."
    },
    {
      "id": 110504452887224323,
      "target": "Sirin: Seberapa cepat itu akan terjadi?"
    },
    {
      "id": 110504452887224322,
      "target": "Sirin: Para Tamu? Bencana? Atau kita saling membunuh?"
    },
    {
      "id": 110504452887224321,
      "target": "Sirin: Menurutmu, apa yang akan membunuh kita?"
    },
    {
      "id": 110504452887224320,
      "target": "Sirin: Selalu ada cara yang lebih mudah…"
    },
    {
      "id": 110504452883030025,
      "target": "Sirin: Para Tamu tidak akan menerkammu hanya karena kamu membidik mereka. Mereka tidak akan menunjukkan jati diri."
    },
    {
      "id": 110504452883030024,
      "target": "Sirin: Mengapa kamu memeriksa dan membidik, tetapi tidak menembak?"
    },
    {
      "id": 110504452883030021,
      "target": "Sirin: Lakukan saja apa yang harus kamu lakukan."
    },
    {
      "id": 110504452883030020,
      "target": "Sirin: Jangan menunda."
    },
    {
      "id": 110504452883030017,
      "target": "Sirin: Bakar gambar itu juga."
    },
    {
      "id": 110504452878835719,
      "target": "Sirin: Dia masih tak suka mengingat mereka."
    },
    {
      "id": 110504452878835718,
      "target": "Sirin: Aku juga harus menyingkirkannya."
    },
    {
      "id": 110504452878835717,
      "target": "Sirin: Sedangkan saudara perempuanku sudah melepasnya."
    },
    {
      "id": 110504452878835715,
      "target": "Sirin: Kenang-kenangan dari orang tua kami."
    },
    {
      "id": 110504452878835714,
      "target": "Sirin: Aku masih menyimpan sebuah anting."
    },
    {
      "id": 110504452874641412,
      "target": "Sirin: Lalu bagaimana seharusnya?"
    },
    {
      "id": 110504452874641410,
      "target": "Sirin: Lakukan yang menurutmu benar."
    },
    {
      "id": 110504452874641409,
      "target": "Sirin: Aku tidak peduli apakah nanti ada sesuatu yang tersisa."
    },
    {
      "id": 110504452123860996,
      "target": "Sirin: Betapa indahnya!"
    },
    {
      "id": 110504452123860995,
      "target": "Sirin: Tapi itu ditujukan untukmu!"
    },
    {
      "id": 110504452123860994,
      "target": "Sirin: Laguku."
    },
    {
      "id": 110504452123860993,
      "target": "Sirin: Kalau begitu, aku akan menunggu giliranku."
    },
    {
      "id": 110504452123860992,
      "target": "Sirin: Tak penting."
    },
    {
      "id": 110504452119666698,
      "target": "Sirin: Penderitaan abadi dan penantian akan kematian."
    },
    {
      "id": 110504452119666697,
      "target": "Sirin: Dan kita tak akan pernah menyaksikan ajal kita sendiri."
    },
    {
      "id": 110504452119666696,
      "target": "Sirin: Kita akan tersedot ke horizon peristiwa selama sangat lama."
    },
    {
      "id": 110504452119666695,
      "target": "Sirin: Bagaimana jika kita hanya sedang bersiap untuk ditelan lubang hitam?"
    },
    {
      "id": 110504452119666694,
      "target": "Sirin: Mungkin lain kali."
    },
    {
      "id": 110504452119666693,
      "target": "Sirin: Dia tidak cocok dengan tanda-tandanya."
    },
    {
      "id": 110504452119666692,
      "target": "Sirin: Sayang sekali."
    },
    {
      "id": 110504452119666691,
      "target": "Sirin: Mungkin lain kali."
    },
    {
      "id": 110504452119666690,
      "target": "Sirin: Sayang sekali."
    },
    {
      "id": 110504452119666689,
      "target": "Sirin: Kamu tetap akan mati."
    },
    {
      "id": 110504452115472395,
      "target": "Sirin: Kamu tak punya nyali?"
    },
    {
      "id": 110504452115472392,
      "target": "Sirin: Kamu akan menekan tombol yang kau idam-idamkan itu?"
    },
    {
      "id": 110504452115472391,
      "target": "Sirin: Jadi?"
    },
    {
      "id": 110504452115472388,
      "target": "Sirin: Suka?"
    },
    {
      "id": 110504452115472387,
      "target": "Sirin: Kekosongan ini hanya akan berpindah kepadamu."
    },
    {
      "id": 110504452115472386,
      "target": "Sirin: Saat aku memejamkan mata, kekosongan itu tidak akan hilang."
    },
    {
      "id": 110504452111278091,
      "target": "Sirin: Biar kulakukan sendiri."
    },
    {
      "id": 110504452111278090,
      "target": "Sirin: Berikan senapannya."
    },
    {
      "id": 110504452111278089,
      "target": "Sirin: Kamu bisa menyerahkan urusan ini kepadaku saja."
    },
    {
      "id": 110504452111278088,
      "target": "Sirin: Kematian toh sudah dekat."
    },
    {
      "id": 110504452111278087,
      "target": "Sirin: Jangan lakukan itu."
    },
    {
      "id": 110504452111278084,
      "target": "Sirin: Tembak saja aku sampai mati."
    },
    {
      "id": 110504452111278083,
      "target": "Sirin: Malah lebih baik begitu."
    },
    {
      "id": 110504452111278080,
      "target": "Sirin: Sepertinya aku tidak melakukan itu sia-sia."
    },
    {
      "id": 110504452107083786,
      "target": "Sirin: Saudara perempuanku mencukur bulu ketiakku. Dia merawatku."
    },
    {
      "id": 110504452107083783,
      "target": "Sirin: Tapi dia tidak mau mengakui kekosongan di mataku."
    },
    {
      "id": 110504452107083782,
      "target": "Sirin: Dalam hal ini, aku dan saudara perempuanku mirip."
    },
    {
      "id": 110504452107083779,
      "target": "Sirin: Dia membiarkanku mati sejak saat itu."
    },
    {
      "id": 110504452107083778,
      "target": "Sirin: Andai saja…"
    },
    {
      "id": 110504452107083777,
      "target": "Sirin: Tapi itu sia-sia."
    },
    {
      "id": 110504452107083776,
      "target": "Sirin: Saudara perempuanku membantuku."
    },
    {
      "id": 110504452102889481,
      "target": "Sirin: Kamu mau merontokkan gigiku?"
    },
    {
      "id": 110504452102889480,
      "target": "Sirin: Lihat."
    },
    {
      "id": 110504452102889473,
      "target": "Sirin: Lakukan saja sekarang."
    }
  ]
}
