  "entries": [
    {"id": 110504454418145286, "target": "Widow: Aku ingin sekali memercayainya."},
    {"id": 110504454418145285, "target": "Widow: Aku sangat ingin…"},
    {"id": 110504454418145284, "target": "Widow: Dia masih bisa mendengarku."},
    {"id": 110504454418145283, "target": "Widow: Tidak, bukan begitu."},
    {"id": 110504454418145282, "target": "Widow: Tidak."},
    {"id": 110504454418145280, "target": "Widow: Aku tak akan menyerahkannya kepada tanah yang tak berjiwa."},
    {"id": 110504454413950982, "target": "Widow: Aku tak sanggup melakukannya."},
    {"id": 110504454413950981, "target": "Widow: Dan harus berpisah lagi dengannya."},
    {"id": 110504454413950980, "target": "Widow: Dia baru saja dikembalikan kepadaku."},
    {"id": 110504454413950979, "target": "Widow: Aku belum siap."},
    {"id": 110504454413950978, "target": "Widow: Tidak, tidak, tidak, tidak."},
    {"id": 110504454413950977, "target": "Widow: Tidaaak."},
    {"id": 110504454413950976, "target": "Yang tersisa darinya hanya jasad. Kau harus mengakuinya."},
    {"id": 110504454409756678, "target": "Dia harus dikuburkan."},
    {"id": 110504454409756677, "target": "Widow: Berhenti menangis saja."},
    {"id": 110504454409756676, "target": "Widow: Tapi apa itu benar?"},
    {"id": 110504454409756675, "target": "Widow: Seolah tak ada lagi air mata untuk menangis."},
    {"id": 110504454409756674, "target": "Widow: Baru belakangan ini air mataku habis."},
    {"id": 110504454409756673, "target": "Widow: Ini terlalu berat."},
    {"id": 110504454409756672, "target": "Widow: Saat ini aku belum bisa."},
    {"id": 110504454405562376, "target": "Widow: Apa yang harus kulakukan?"},
    {"id": 110504454405562375, "target": "Widow: Aku tak bisa… kau…"},
    {"id": 110504454405562373, "target": "Widow: Menguburkan…"},
    {"id": 110504454405562372, "target": "Widow: Aku bahkan…"},
    {"id": 110504454405562371, "target": "Widow: Kau tak akan mengembalikan siapa pun kepadaku."},
    {"id": 110504454405562370, "target": "Widow: Aku ingin bersama dia sebentar."},
    {"id": 110504454405562369, "target": "Widow: Kenapa kau berbuat begitu?"},
    {"id": 110504454405562368, "target": "Widow: Bagus, sekarang aku sendirian dan harus bertahan hidup."},
    {"id": 110504454401368071, "target": "Widow: Lalu meninggal."},
    {"id": 110504454401368069, "target": "Widow: Kau bilang semuanya akan baik-baik saja."},
    {"id": 110504454401368068, "target": "Widow: Padahal kau berjanji semuanya akan baik-baik saja."},
    {"id": 110504454401368067, "target": "Widow: Kenapa kau meninggal?"},
    {"id": 110504454401368065, "target": "Boleh aku duduk menemanimu?"},
    {"id": 110504454401368064, "target": "Untuk sekarang, aku akan meninggalkanmu di sini."},
    {"id": 110504454397173767, "target": "Widow: Aku ingin duduk sebentar."},
    {"id": 110504454397173766, "target": "Widow: Aku di sini…"},
    {"id": 110504454397173765, "target": "Widow: Aku tak lapar."},
    {"id": 110504454397173764, "target": "Boleh aku duduk menemanimu?"},
    {"id": 110504454397173763, "target": "Untuk sekarang, aku akan meninggalkanmu di sini."},
    {"id": 110504454397173762, "target": "Widow: Aku akan minum kalau perlu."},
    {"id": 110504454397173761, "target": "Widow: Aku duduk di dekat keran."},
    {"id": 110504454397173760, "target": "Widow: Aku di sini…"},
    {"id": 110504454392979464, "target": "Perlu kuberi makanan?"},
    {"id": 110504454392979463, "target": "Mau kubawakan air?"},
    {"id": 110504454392979462, "target": "Widow: Aku tak butuh apa-apa lagi."}
  ]
}
