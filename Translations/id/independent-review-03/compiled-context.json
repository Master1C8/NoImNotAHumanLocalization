          0.0
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453575090178",
        "source": "Daughter: А об этом тоже расскажу!",
        "target": "Daughter: Aku akan menceritakan yang ini juga!"
      },
      {
        "index": 3,
        "opcode": 2,
        "operands": [
          "line:Daughter_Ears_Gun_056edc6",
          0.0
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453575090179",
        "source": "Daughter: Вы что, хотите меня обидеть?",
        "target": "Daughter: Apa Anda ingin menyakitiku?"
      },
      {
        "index": 4,
        "opcode": 2,
        "operands": [
          "line:Daughter_Ears_Gun_0f0ac04",
          0.0
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453575090180",
        "source": "Daughter: Вы прям как моя лучшая подружка порой...",
        "target": "Daughter: Kadang Anda persis seperti sahabat perempuan terbaikku..."
      },
      {
        "index": 5,
        "opcode": 4,
        "operands": [
          "line:Daughter_Ears_Gun_0d0a482",
          "L2033shortcutoption_Daughter_Ears_Gun_1",
          0.0,
          false
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453575090181",
        "source": "Выстрелить",
        "target": "Tembak"
      },
      {
        "index": 6,
        "opcode": 4,
        "operands": [
