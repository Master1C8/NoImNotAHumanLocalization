    "Daughter_Ears_DontShoot": [
      {
        "index": 0,
        "opcode": 3,
        "operands": [
          "SetupGun false",
          0.0
        ]
      },
      {
        "index": 1,
        "opcode": 2,
        "operands": [
          "line:Daughter_Ears_DontShoot_007da24",
          0.0
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453575090183",
        "source": "Daughter: Мы с ней играем, играем.",
        "target": "Daughter: Kami bermain dan bermain bersama."
      },
      {
        "index": 2,
        "opcode": 2,
        "operands": [
          "line:Daughter_Ears_DontShoot_08f1b5f",
          0.0
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453579284480",
        "source": "Daughter: А потом – бац! – и сделает какую-то пакость!",
        "target": "Daughter: Lalu, tiba-tiba—bam!—dia melakukan hal jahil!"
      },
      {
        "index": 3,
        "opcode": 2,
        "operands": [
          "line:Daughter_Ears_DontShoot_05c499d",
          0.0
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453579284481",
        "source": "Daughter: Но она вообще хорошая.",
        "target": "Daughter: Tapi dia sebenarnya baik."
      },
      {
        "index": 4,
        "opcode": 2,
        "operands": [
          "line:Daughter_Ears_DontShoot_05d04e2",
          0.0
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453579284482",
        "source": "Daughter: Ей просто дома тяжело. У неё мама очень строгая.",
        "target": "Daughter: Dia cuma susah di rumah. Ibunya sangat keras."
      },
      {
        "index": 5,
        "opcode": 2,
        "operands": [
          "line:Daughter_Ears_DontShoot_0ac09c3",
          0.0
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453579284483",
        "source": "Daughter: Она много чего ей запрещает.",
        "target": "Daughter: Ibunya melarangnya melakukan banyak hal."
      },
      {
        "index": 6,
        "opcode": 2,
        "operands": [
          "line:Daughter_Ears_DontShoot_0bfa33d",
          0.0
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453579284484",
        "source": "Daughter: Может быть, её мама Гость?",
        "target": "Daughter: Jangan-jangan ibunya Tamu?"
      },
      {
        "index": 7,
        "opcode": 2,
        "operands": [
          "line:Daughter_Ears_DontShoot_01d49b0",
          0.0
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453579284485",
        "source": "Daughter: Мне вот папа тоже запрещает, но не всё же!",
        "target": "Daughter: Ayah juga melarangku macam-macam, tapi tidak semuanya!"
      },
      {
        "index": 8,
        "opcode": 2,
        "operands": [
          "line:Daughter_Ears_DontShoot_0b73773",
          0.0
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453579284486",
        "source": "Daughter: Надо бы сходить к моей подружке, как папа за мной зайдёт...",
        "target": "Daughter: Aku harus mengunjungi temanku setelah Ayah menjemputku..."
      },
      {
        "index": 9,
        "opcode": 15,
        "operands": []
      }
    ],
