        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454548168711",
        "source": "Daughter: Не придёт? Почему вы так думаете?",
        "target": "Daughter: Dia tidak akan datang? Kenapa Anda berpikir begitu?"
      },
      {
        "index": 1,
        "opcode": 4,
        "operands": [
          "line:Daughter_Asking_3_2_0f1cb5b",
          "L1935shortcutoption_Daughter_Asking_3_2_1",
          0.0,
          false
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454548168712",
        "source": "Почему он так и не пришёл за тобой?",
        "target": "Kenapa dia belum datang menjemputmu?"
      },
      {
        "index": 2,
        "opcode": 4,
        "operands": [
          "line:Daughter_Asking_3_2_0c6da31",
          "L1936shortcutoption_Daughter_Asking_3_2_2",
          0.0,
          false
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454548168713",
        "source": "Каким ты его видела в последний раз?",
        "target": "Seperti apa kondisinya terakhir kali kaulihat?"
      },
      {
        "index": 3,
        "opcode": 5,
        "operands": []
      },
