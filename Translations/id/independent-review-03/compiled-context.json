    "Daughter_Asking_3_1": [
      {
        "index": 0,
        "opcode": 2,
        "operands": [
          "line:Daughter_Asking_3_1_0eb83d1",
          0.0
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454548168706",
        "source": "Daughter: Вы же не видели, что там было!",
        "target": "Daughter: Anda kan tidak melihat apa yang terjadi di sana!"
      },
      {
        "index": 1,
        "opcode": 2,
        "operands": [
          "line:Daughter_Asking_3_1_0d50884",
          0.0
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454548168707",
        "source": "Daughter: А я была там! Он пошевелился, когда я убегала.",
        "target": "Daughter: Tapi aku ada di sana! Dia bergerak saat aku melarikan diri."
      },
      {
        "index": 2,
        "opcode": 2,
        "operands": [
          "line:Daughter_Asking_3_1_0db4696",
          0.0
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454548168708",
        "source": "Daughter: Значит, скоро он придёт!",
        "target": "Daughter: Berarti dia akan segera datang!"
      },
      {
        "index": 3,
        "opcode": 4,
        "operands": [
          "line:Daughter_Asking_3_1_035ef3a",
          "L1931shortcutoption_Daughter_Asking_3_1_1",
          0.0,
          false
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454548168709",
        "source": "Почему он так и не пришёл за тобой?",
        "target": "Kenapa dia belum datang menjemputmu?"
      },
      {
        "index": 4,
        "opcode": 4,
        "operands": [
          "line:Daughter_Asking_3_1_049e0c0",
          "L1932shortcutoption_Daughter_Asking_3_1_2",
          0.0,
          false
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454548168710",
        "source": "Каким ты его видела в последний раз?",
        "target": "Seperti apa kondisinya terakhir kali kaulihat?"
      },
