        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453973549064",
        "source": "Bald: Может, фотик у тебя какой бракованный, а?",
        "target": "Bald: Jangan-jangan kameramu rusak, ya?"
