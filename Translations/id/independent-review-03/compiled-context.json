    "Bald_Photo_DontShoot": [
      {
        "index": 0,
        "opcode": 3,
        "operands": [
          "SetEmotion Base",
          0.0
        ]
      },
      {
        "index": 1,
        "opcode": 2,
        "operands": [
          "line:Bald_Photo_DontShoot_0855c08",
          0.0
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453981937669",
        "source": "Bald: Мы как-то пьянствовали в очередной раз.",
        "target": "Bald: Suatu kali kami mabuk-mabukan lagi."
      },
      {
        "index": 2,
        "opcode": 3,
        "operands": [
          "SetupGun false",
          0.0
        ]
      },
      {
        "index": 3,
        "opcode": 2,
        "operands": [
          "line:Bald_Photo_DontShoot_03c6083",
          0.0
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453981937670",
        "source": "Bald: А потом через несколько дней узнали, что наша подруга, которая домой возвращалась, не дошла.",
        "target": "Bald: Beberapa hari kemudian baru kami tahu teman perempuan kami yang pulang itu tak pernah sampai di rumah."
      },
      {
        "index": 4,
        "opcode": 2,
        "operands": [
          "line:Bald_Photo_DontShoot_09b12c5",
          0.0
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453981937671",
        "source": "Bald: Мы нашли её фотку, распечатали и развесили всюду объявления о том, что она пропала.",
        "target": "Bald: Kami mencari fotonya, mencetaknya, lalu memasang pengumuman orang hilang di mana-mana."
      },
      {
        "index": 5,
        "opcode": 2,
        "operands": [
          "line:Bald_Photo_DontShoot_0badd9a",
          0.0
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453981937672",
        "source": "Bald: И знаешь что?",
        "target": "Bald: Dan kau tahu apa yang terjadi?"
      },
      {
        "index": 6,
        "opcode": 2,
        "operands": [
          "line:Bald_Photo_DontShoot_0a5b3e8",
          0.0
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453981937673",
        "source": "Bald: Она бухая шла, оступилась, упала в речку и утонула.",
        "target": "Bald: Dia berjalan dalam keadaan mabuk, salah langkah, jatuh ke sungai, lalu tenggelam."
      },
      {
        "index": 7,
        "opcode": 2,
        "operands": [
          "line:Bald_Photo_DontShoot_096467c",
          0.0
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453981937674",
        "source": "Bald: Это пиздец…",
        "target": "Bald: Sialan, kacau sekali…"
      },
      {
        "index": 8,
        "opcode": 2,
        "operands": [
          "line:Bald_Photo_DontShoot_03b16f4",
          0.0
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453981937675",
        "source": "Bald: А ведь хорошая девчонка была. Симпатичная…",
        "target": "Bald: Padahal dia gadis yang baik. Cantik pula…"
      },
      {
        "index": 9,
        "opcode": 15,
        "operands": []
      }
    ],
