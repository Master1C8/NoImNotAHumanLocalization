  "entries": [
    {"id": 110504451956088838, "target": "Esenin: Jadi bagaimana, aku Tamu?"},
    {"id": 110504451956088836, "target": "Esenin: Periksa kukuku."},
    {"id": 110504451956088835, "target": "Esenin: Omong kosong sialan."},
    {"id": 110504451956088834, "target": "Esenin: Jadi tukang kebun mana pun langsung dianggap Tamu?"},
    {"id": 110504451956088833, "target": "Esenin: Mereka kan bisa mencuci tangan! Selesai!"},
    {"id": 110504451956088832, "target": "Esenin: Kuku yang kotor oleh tanah? Itu tanda?"},
    {"id": 110504451951894538, "target": "Esenin: Dari mana mereka semua muncul?"},
    {"id": 110504451951894537, "target": "Esenin: Aku bukan Tamu."},
    {"id": 110504451951894536, "target": "Esenin: Kalau begitu jangan ganggu aku lagi dengan pemeriksaan sialanmu."},
    {"id": 110504451951894535, "target": "Esenin: Agak kekuningan, ya?"},
    {"id": 110504451951894533, "target": "Esenin: Lihat saja. Di gigi ini masih tertinggal rasa kemalangan dan asap."},
    {"id": 110504451951894532, "target": "Esenin: Mau kutunjukkan gigiku?"},
    {"id": 110504451947700232, "target": "Esenin: Apa yang ingin kau periksa?"}
  ]
}
