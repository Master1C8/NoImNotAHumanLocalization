  "entries": [
    {
      "id": 110504455940677643,
      "target": "WheelChair: Oke, aku pergi. Tapi kursi rodaku kubawa."
    },
    {
      "id": 110504455940677641,
      "target": "WheelChair: Sial, apaan sih kamu?"
    },
    {
      "id": 110504455940677640,
      "target": "WheelChair: Tapi aku suka. Hidup harus dinikmati sepenuhnya."
    },
    {
      "id": 110504455940677639,
      "target": "WheelChair: Ya sudah."
    },
    {
      "id": 110504455940677638,
      "target": "Minggat sana, baik-baik."
    },
    {
      "id": 110504455940677637,
      "target": "Sial, kamu aneh banget."
    },
    {
      "id": 110504455940677636,
      "target": "WheelChair: Jangan bilang kamu belum pernah mencobanya. Serius, asyik banget!"
    },
    {
      "id": 110504455940677635,
      "target": "WheelChair: Memangnya tidak keren meluncur cepat dan nge-drift dengan kursi roda?"
    },
    {
      "id": 110504455940677634,
      "target": "Minggat sana, baik-baik."
    },
    {
      "id": 110504455940677633,
      "target": "Sial, kamu aneh banget."
    },
    {
      "id": 110504455940677632,
      "target": "WheelChair: Kalau maksudmu kursi roda, aku cuma suka berkeliling dengannya."
    },
    {
      "id": 110504455936483340,
      "target": "WheelChair: Aku tidak berpura-pura. Kakiku jadi lebih hangat begitu."
    },
    {
      "id": 110504455936483339,
      "target": "Kalau begitu buat apa kau butuh kursi roda, sialan?"
    },
    {
      "id": 110504455936483338,
      "target": "Kenapa kau berpura-pura punya disabilitas?"
    },
    {
      "id": 110504455936483337,
      "target": "WheelChair: Ayolah, kakiku cuma kesemutan. Memangnya kenapa?"
    },
    {
      "id": 110504455936483336,
      "target": "Apa-apaan ini, sialan?"
    },
    {
      "id": 110504455936483335,
      "target": "WheelChair: Fiuh, jauh lebih lega."
    },
    {
      "id": 110504455936483334,
      "target": "WheelChair: Sebentar."
    },
    {
      "id": 110504455936483333,
      "target": "WheelChair: Sial, kakiku sakit."
    }
  ]
}
