  "entries": [
    {
      "id": 110504453788999687,
      "target": "Membasuh diri"
    },
    {
      "id": 110504453788999684,
      "target": "Ah, persetan"
    },
    {
      "id": 110504453747056646,
      "target": "Tadi itu laporan macam apa?"
    },
    {
      "id": 110504453747056644,
      "target": "Telingaku baik-baik saja."
    },
    {
      "id": 110504453747056641,
      "target": "Aku harus membasuh diri. Semoga membantu."
    },
    {
      "id": 110504453742862345,
      "target": "Kelihatannya seperti iritasi atau, lebih buruk lagi, jamur."
    },
    {
      "id": 110504453742862344,
      "target": "Sialan, apa-apaan ini!?"
    },
    {
      "id": 110504453742862343,
      "target": "Seperti seharusnya."
    },
    {
      "id": 110504453742862342,
      "target": "Ketiakku berbulu."
    },
    {
      "id": 110504453742862339,
      "target": "Tidak merah, jadi tak ada yang bisa dipermasalahkan."
    },
    {
      "id": 110504453742862338,
      "target": "Mataku tampak biasa saja."
    },
    {
      "id": 110504453742862337,
      "target": "Seharusnya aku tidak minum minuman berkafein sialan itu."
    },
    {
      "id": 110504453742862336,
      "target": "Sial. Mataku merah…"
    },
    {
      "id": 110504453591867396,
      "target": "Ada bekas mesiu pada sidik jariku. Tapi itu bukan masalah besar."
    },
    {
      "id": 110504453591867395,
      "target": "Tanganku bersih…"
    },
    {
      "id": 110504453591867394,
      "target": "Ini semua gara-gara gua yang sedang kugali."
    },
    {
      "id": 110504453591867393,
      "target": "Kukuku kotor…"
    },
    {
      "id": 110504453587673094,
      "target": "Baguslah. Dengan begitu aku tidak akan dikira Tamu."
    },
    {
      "id": 110504453587673093,
      "target": "Gigiku kuning…"
    },
    {
      "id": 110504453587673092,
      "target": "Para perokok rela menjual ginjal demi gigi seperti ini."
    },
    {
      "id": 110504453587673091,
      "target": "Sial, putih…"
    },
    {
      "id": 110504453587673088,
      "target": "Membasuh diri"
    },
    {
      "id": 110504453583478786,
      "target": "Aku harus memeriksa diriku."
    }
  ]
}
