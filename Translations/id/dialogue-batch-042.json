      "id": 110504456754372613,
      "target": "SuperFake: Sampai bertemu lagi?"
    },
    {
      "id": 110504456754372612,
      "target": "SuperFake: Yah…"
    },
    {
      "id": 110504456754372611,
      "target": "SuperFake: Aku hanya menjalankan kehendak itu."
    },
    {
      "id": 110504456754372610,
      "target": "SuperFake: Ada kekuatan yang lebih tinggi dariku."
    },
    {
      "id": 110504456754372609,
      "target": "SuperFake: Kamu tidak mengira aku ini… pemimpin mereka, kan?"
    },
    {
      "id": 110504456754372608,
      "target": "SuperFake: Perubahan bukan hal paling mengerikan yang menunggumu."
    },
    {
      "id": 110504456750178314,
      "target": "SuperFake: Bahkan orang-orangku pun tidak banyak. Apalagi kalian yang terkurung di rumah masing-masing."
    },
    {
      "id": 110504456750178313,
      "target": "SuperFake: Wah, begitu rupanya."
    },
    {
      "id": 110504456750178312,
      "target": "SuperFake: Ikut aku."
    },
    {
      "id": 110504456750178311,
      "target": "SuperFake: Nah, aturan baru kita akhirnya berlaku."
    },
    {
      "id": 110504456750178310,
      "target": "SuperFake: Hmm…"
    },
    {
      "id": 110504456750178307,
      "target": "SuperFake: Kamu sendirian di rumah?"
    },
    {
      "id": 110504456750178306,
      "target": "SuperFake: Tapi pertama, kita uji aturan baru kita."
    },
    {
      "id": 110504456750178305,
      "target": "SuperFake: Tentu! Aku akan pergi sekarang."
