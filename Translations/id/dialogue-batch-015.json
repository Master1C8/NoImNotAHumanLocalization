    {"id": 110504457182191624, "target": "Daughter: Aaaaaaaaa..."},
    {"id": 110504457182191623, "target": "Daughter: AKU TAKUUUUUT SEKALIIII..."},
    {"id": 110504457182191622, "target": "Daughter: A-aku tidak kenal siapa-siapa lagi..."},
    {"id": 110504457182191621, "target": "Daughter: KE MANAAAA?"},
    {"id": 110504457182191620, "target": "Daughter: AYAAAAH, AYAHKU!"},
    {"id": 110504457182191617, "target": "Daughter: Aku mau ke Ayaaaaah..."},
    {"id": 110504457182191616, "target": "Daughter: Aku... aku cuma mau di sana. Pokoknya mauuuu! Di sana... sepertinya Ayah pernah duduk... Dia pernah bercerita kepadaku."},
    {"id": 110504457177997323, "target": "Daughter: Oh, {0} ada di sini."},
    {"id": 110504457177997322, "target": "Daughter: Aku... tidak ada tempat untukku!"},
    {"id": 110504453583478784, "target": "Mama..."},
    {"id": 110504453579284487, "target": "Daughter: Ayah..."},
    {"id": 110504452048363527, "target": "Daughter: Aku sangat lelah. Boleh aku berdiri di sini sendirian?"},
    {"id": 110504452048363526, "target": "Daughter: Anda cuma ingin tahu kabarku?"},
    {"id": 110504452048363525, "target": "Daughter: (Anda menatapnya dan sadar semua ini terlalu berat bagi Anda.)"},
    {"id": 110504452048363524, "target": "Daughter: Apa yang perlu dilakukan?"},
    {"id": 110504452035780615, "target": "Daughter: Apa yang ingin kauperiksa?"}
