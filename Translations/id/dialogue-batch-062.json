  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504456112644102,
      "target": "Dan tak ada siapa pun yang bisa disalahkan."
    },
    {
      "id": 110504456112644101,
      "target": "Kamu dilempar ke jalan."
    },
    {
      "id": 110504456112644100,
      "target": "Itu tetap akan terjadi."
    },
    {
      "id": 110504456112644099,
      "target": "Aku bisa melihat apa yang telah direncanakan untukmu."
    },
    {
      "id": 110504456112644098,
      "target": "Ketakutan bisa dengan mudah membuat orang kehilangan akal."
    },
    {
      "id": 110504456112644097,
      "target": "Mati itu menakutkan."
    },
    {
      "id": 110504456066506756,
      "target": "Kecuali…"
    },
    {
      "id": 110504456066506755,
      "target": "Kamu akan terbakar perlahan."
    },
    {
      "id": 110504456066506754,
      "target": "Kamu tak lagi punya cara untuk mengakhiri hidupmu sendiri agar tak menderita."
    },
    {
      "id": 110504456066506753,
      "target": "Kamu tak punya tenaga lagi untuk merangkak menjauhi sinar matahari."
    },
    {
      "id": 110504456066506752,
      "target": "Tanpa senapan. Babak belur."
    },
    {
      "id": 110504456062312457,
      "target": "Aku turut menyesal."
    },
    {
      "id": 110504456062312456,
      "target": "Hanya saja… kamu membuatnya datang lebih cepat."
    },
    {
      "id": 110504456062312455,
      "target": "Cepat atau lambat."
    },
    {
      "id": 110504456062312454,
      "target": "Kamu takut lenyap?"
    },
    {
      "id": 110504456062312453,
      "target": "Takut sakit?"
    },
    {
      "id": 110504456062312452,
      "target": "Sebenarnya apa yang membuatmu takut?"
    },
    {
      "id": 110504456062312451,
      "target": "Sedih sekali melihat apa yang menunggumu."
    },
    {
      "id": 110504456062312450,
      "target": "Mudah sekali mengambil keputusan yang mengerikan."
    },
    {
      "id": 110504456062312449,
      "target": "Aku sangat memahaminya."
    }
  ]
}
