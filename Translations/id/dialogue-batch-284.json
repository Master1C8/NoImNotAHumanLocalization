  "entries": [
    {"id": 110504457236717568, "target": "Widow: Terima kasih… Aku tak akan tinggal lama… Aku hanya perlu beristirahat…"},
    {"id": 110504457232523273, "target": "Widow: Aku tak akan tinggal serumah dengan yang seperti itu."},
    {"id": 110504457232523272, "target": "Widow: Tidak."},
    {"id": 110504457232523271, "target": "Widow: Ada {0} di rumahmu?"},
    {"id": 110504457232523270, "target": "Widow: Terima kasih sudah membantu. Tidak seperti…"},
    {"id": 110504456284610560, "target": "Widow: Kau…"},
    {"id": 110504456280416266, "target": "Widow: Aku hanya perlu beristirahat."},
    {"id": 110504456280416265, "target": "Widow: Kurasa aku tak akan tinggal lama."},
    {"id": 110504456280416262, "target": "Widow: Semua orang peduli."},
    {"id": 110504456280416261, "target": "Widow: Dia mungkin masih hidup seandainya…"},
    {"id": 110504456280416260, "target": "Widow: Sekarang dia sudah meninggal."},
    {"id": 110504456280416259, "target": "Widow: Sekarang tidak lagi. Saat dia butuh bantuan, tak seorang pun menolong."},
    {"id": 110504456280416256, "target": "Widow: Sekarang aku tak bisa menguburkannya dengan layak. Melepaskannya sekarang tak ada gunanya."},
    {"id": 110504456276221961, "target": "Widow: Dia sudah meninggal."},
    {"id": 110504456276221960, "target": "Widow: Dia suamiku."},
    {"id": 110504456276221959, "target": "Temanmu butuh bantuan?"},
    {"id": 110504456276221958, "target": "Rekanmu sedang sakit?"},
    {"id": 110504456276221957, "target": "Widow: Sekarang tak penting lagi aku berakhir di mana."},
    {"id": 110504456276221956, "target": "Widow: Aku… aku hanya ingin jatuh di suatu tempat dan tak bangun lagi."},
    {"id": 110504456276221955, "target": "Temanmu butuh bantuan?"},
    {"id": 110504456276221954, "target": "Rekanmu sedang sakit?"},
    {"id": 110504456276221953, "target": "Widow: Aku sangat lelah. Kalau tak beristirahat, aku akan jatuh tepat di bawah jendela."},
    {"id": 110504456276221952, "target": "Widow: Aku sudah tak ingat. Dari mana pun tak penting."},
    {"id": 110504454455894021, "target": "Widow: Semoga Anda menemukan apa yang Anda cari."},
    {"id": 110504454455894020, "target": "Widow: Anda tak banyak bicara, tapi… ternyata menyenangkan diajak bicara."},
    {"id": 110504454455894019, "target": "Widow: Terima kasih."},
    {"id": 110504454455894018, "target": "Widow: Sebelum aku kembali, aku tak ingin memutuskan apa pun."},
    {"id": 110504454455894017, "target": "Widow: Aku sangat ingin pulang."},
    {"id": 110504454455894016, "target": "Widow: Aku tak punya perasaan khusus padamu, maaf."},
    {"id": 110504454451699715, "target": "Widow: Aku tak akan merasa lebih baik."},
    {"id": 110504454451699714, "target": "Widow: Untuk apa?"},
    {"id": 110504454451699713, "target": "Semoga berhasil."},
    {"id": 110504454451699712, "target": "Kau boleh tetap tinggal."},
    {"id": 110504454447505416, "target": "Widow: Aku tak menginginkan apa pun lagi."},
    {"id": 110504454447505415, "target": "Widow: Kami akan pulang."},
    {"id": 110504454447505414, "target": "Widow: Tak ada siapa pun yang tersisa."},
    {"id": 110504454447505413, "target": "Semoga berhasil."},
    {"id": 110504454447505412, "target": "Kau boleh tetap tinggal."},
    {"id": 110504454447505411, "target": "Widow: Dan di sana…"},
    {"id": 110504454447505410, "target": "Widow: Aku akan mengambil gitar."},
    {"id": 110504454447505409, "target": "Widow: Aku akan pulang."},
    {"id": 110504454447505408, "target": "Widow: Aku tak mau memikirkannya."},
    {"id": 110504454443311116, "target": "Kau mau menemui kerabatmu?"},
    {"id": 110504454443311115, "target": "Lalu sekarang bagaimana?"},
    {"id": 110504454443311114, "target": "Widow: Aku hanya butuh istirahat."},
    {"id": 110504454443311113, "target": "Widow: Sejak awal aku sudah bilang tak berniat tinggal lama."},
    {"id": 110504454443311112, "target": "Widow: Aku pergi malam ini."},
    {"id": 110504454443311108, "target": "Widow: Berat sekali hidup tanpa dia sekarang…"},
    {"id": 110504454443311107, "target": "Widow: Ya. Tolong."}
  ]
}
