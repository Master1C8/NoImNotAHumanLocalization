  "entries": [
    {
      "id": 110504456473354250,
      "target": "Bestson: Orang-orang saling tembak, saling pukul. Aku tak mengerti…"
    },
    {
      "id": 110504456473354249,
      "target": "Bestson: Panasnya tak masuk akal, dan ada yang tidak beres dengan orang-orang."
    },
    {
      "id": 110504456473354248,
      "target": "Bestson: Bisa kaujelaskan apa yang sedang terjadi?"
    },
    {
      "id": 110504456460771331,
      "target": "Apa yang terjadi?"
    },
    {
      "id": 110504456460771330,
      "target": "Siapa yang membuatmu seperti itu?"
    },
    {
      "id": 110504456460771329,
      "target": "Fugitive: Aku tertembak. Aku tak akan bertahan lama."
    },
    {
      "id": 110504456460771328,
      "target": "Fugitive: Tolong aku."
    },
    {
      "id": 110504456448188418,
      "target": "Apa yang Anda perlukan?"
    },
    {
      "id": 110504456448188417,
      "target": "Cocok untuk apa?"
    },
    {
      "id": 110504456448188416,
      "target": "Nun: Kurasa rumah itu cocok untukku."
    },
    {
      "id": 110504456443994123,
      "target": "Nun: Kulihat rumah kecil Anda berdiri paling jauh dari yang lain."
    },
    {
      "id": 110504456431411208,
      "target": "Ya, aku punya senapan"
    },
    {
      "id": 110504456431411207,
      "target": "Kenapa kau ingin tahu?"
    },
    {
      "id": 110504456431411206,
      "target": "Raskolnikov: Katakan, apa kau bersenjata?"
    },
    {
      "id": 110504456431411205,
      "target": "Raskolnikov: Halo, Kawan."
    },
    {
      "id": 110504456418828294,
      "target": "Apa pekerjaan suami Anda?"
    },
    {
      "id": 110504456418828293,
      "target": "Bagaimana Anda bisa sampai ke sini?"
    },
    {
      "id": 110504456418828292,
      "target": "Wifefema: Tapi sayangnya, tempat kerjanya tak bisa menyediakan tempat tinggal untukku."
    },
    {
      "id": 110504456418828291,
      "target": "Wifefema: Aku ingin memberinya kejutan dan bertemu dengannya."
    },
    {
      "id": 110504456418828290,
      "target": "Wifefema: Aku datang ke sini untuk menemui suamiku. Dia dipindahkan ke sini karena pekerjaannya."
    },
    {
      "id": 110504456418828289,
      "target": "Wifefema: Halo, bolehkah aku tinggal sebentar di rumah Anda?"
    },
    {
      "id": 110504456406245378,
      "target": "Tidak, aku bukan dari KChS"
    },
    {
      "id": 110504456406245377,
      "target": "Memercayai apa?"
    },
    {
      "id": 110504456406245376,
      "target": "Theorist: Anda tidak punya hubungan dengan KChS, kan?"
    },
    {
      "id": 110504456402051082,
      "target": "Theorist: Halo, bolehkah aku memercayai Anda?"
    },
    {
      "id": 110504456360108036,
      "target": "Kalian berdua sakit? Atau hanya salah satu?"
    },
    {
      "id": 110504456360108035,
      "target": "Orang yang dekat dengan Anda sedang tidak sehat?"
    },
    {
      "id": 110504456360108034,
      "target": "Twins: Tak apa-apa kami datang ke sini?"
    },
    {
      "id": 110504456360108033,
      "target": "Twins: Halo. Oh, bersandarlah padaku dulu."
    },
    {
      "id": 110504456347525120,
      "target": "Sudah lama Anda berjalan?"
    },
    {
      "id": 110504456343330827,
      "target": "Anda memang hendak ke sini?"
    },
    {
      "id": 110504456343330826,
      "target": "NotTrue: Boleh aku beristirahat di tempatmu?"
    },
    {
      "id": 110504456343330825,
      "target": "NotTrue: Halo, Nak! Aku agak lelah berjalan kemari."
    },
    {
      "id": 110504456334942210,
      "target": "Aku tak akan mengizinkanmu masuk"
    },
    {
      "id": 110504456334942209,
      "target": "Apa maumu?"
    },
    {
      "id": 110504456334942208,
      "target": "SuperFake: Halo!"
    },
    {
      "id": 110504456326553605,
      "target": "Ada sesuatu yang terjadi?"
    },
    {
      "id": 110504456326553604,
      "target": "Kau sedang histeris?"
    },
    {
      "id": 110504456326553603,
      "target": "Daughter: I-izinkan aku masuk."
    },
    {
      "id": 110504456326553602,
      "target": "Daughter: H-h-halo."
    },
    {
      "id": 110504456313970692,
      "target": "Ceritakan sesuatu tentang ayahmu."
    },
    {
      "id": 110504456313970691,
      "target": "Siapa nama ayahmu?"
    },
    {
      "id": 110504456313970690,
      "target": "Daughter: Siang tadi aku tidak takut, tapi sekarang aku takut. Banyak orang keluar untuk berjalan-jalan pada malam hari…"
    },
    {
      "id": 110504456313970689,
      "target": "Daughter: Apa ayahku ada di rumah Anda? Maukah Anda memanggilnya?"
    },
    {
      "id": 110504456313970688,
      "target": "Daughter: Halo!"
    },
    {
      "id": 110504456284610565,
      "target": "Jadi apa yang sedang terjadi?"
    },
    {
      "id": 110504456284610564,
      "target": "Apa yang kauperlukan?"
    },
    {
      "id": 110504456284610563,
      "target": "Scammer: Bagaimana urusanmu?"
    },
    {
      "id": 110504456284610562,
      "target": "Scammer: Kau lihat apa yang terjadi? Gila banget, sialan."
    },
    {
      "id": 110504456284610561,
      "target": "Scammer: Oh, halo."
    }
  ]
}
