        ]
      },
      {
        "instructionIndex": 12,
        "opcode": 2,
        "operands": [
          "line:Bestson_Teeth_DontShoot_0bee8f5",
          0.0
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452316798981",
        "source": "Bestson: Они напомнили бы мне, заставили бы… Не дали бы мне так запустить себя…",
        "correctedTarget": "Bestson: Mereka pasti akan mengingatkanku, memaksaku… Tak akan membiarkanku menelantarkan diriku sampai begini…"
      },
      {
        "instructionIndex": 13,
        "opcode": 2,
        "operands": [
          "line:Bestson_Teeth_DontShoot_0187c54",
          0.0
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452316798982",
        "source": "Bestson: Но их нет.",
        "correctedTarget": "Bestson: Tapi mereka tak ada."
      },
      {
        "instructionIndex": 14,
