          "line:Bestson_Teeth_DontShoot_0b0f5a1",
          0.0
        ],
        "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452316798980",
        "source": "Bestson: Может, если бы родители были рядом, всё было бы по-другому?",
        "correctedTarget": "Bestson: Mungkin semuanya akan berbeda kalau orang tuaku ada di sini?"
      },
      {
        "instructionIndex": 11,
        "opcode": 3,
        "operands": [
          "SetupGun false",
