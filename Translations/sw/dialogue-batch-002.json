    },
    {
      "id": 110504457941360644,
      "target": "Phone: Lakini bado ninamkosa..."
    },
    {
      "id": 110504457941360643,
      "target": "Phone: ..."
    },
    {
      "id": 110504457941360642,
      "target": "Phone: Nenda zako mbali!"
    },
    {
      "id": 110504457941360641,
      "target": "Phone: Mbona hata ninajitetea kwako?"
    },
    {
      "id": 110504457941360640,
      "target": "Phone: Tafadhali..."
    },
    {
      "id": 110504457937166346,
      "target": "Phone: Usipige simu hapa tena..."
    },
    {
      "id": 110504457937166345,
      "target": "Phone: Samahani."
    },
    {
      "id": 110504457937166344,
      "target": "Phone: ..."
    },
    {
      "id": 110504457937166343,
      "target": "Phone: Sasa ninajutia tu kwamba hatukumuuliza binti aliyechukua nafasi ya binti yetu kile alichomfanyia binti yetu mdogo..."
    },
    {
      "id": 110504457937166342,
      "target": "Phone: Mume wangu alinisaidia kulielewa hilo."
    },
    {
      "id": 110504457937166341,
      "target": "Phone: Lakini baadaye nilielewa kwamba hakuwa binti yetu hata kidogo."
    },
    {
      "id": 110504457937166340,
      "target": "Phone: Mwanzoni nilitaka kumuua yeye mwenyewe."
    },
    {
      "id": 110504457937166339,
      "target": "Phone: ..."
    },
    {
      "id": 110504457937166338,
      "target": "Phone: Alimshughulikia huyo Mgeni mara moja."
    },
    {
      "id": 110504457937166337,
      "target": "Phone: Mara tu nilipomwambia mume wangu, yeye..."
    },
    {
      "id": 110504457937166336,
      "target": "Phone: ..."
    },
    {
      "id": 110504457932972044,
      "target": "Phone: Kila kitu kililingana."
    },
    {
      "id": 110504457932972043,
      "target": "Phone: Ndiyo maana niliona mara moja dalili hizo zilipoanza kuonekana."
    },
    {
      "id": 110504457932972042,
      "target": "Phone: Nilimjua vizuri kabisa."
    },
    {
      "id": 110504457932972041,
      "target": "Phone: Kwa dalili zote."
    },
    {
      "id": 110504457932972040,
      "target": "Phone: Alikuwa Mgeni."
    },
    {
      "id": 110504457932972039,
      "target": "Ninaelewa"
    },
    {
      "id": 110504457932972038,
      "target": "Shenzi..."
    },
    {
      "id": 110504457932972037,
      "target": "Phone: Bila shaka alikuwa Mgeni! Dalili zililingana kwa asilimia mia moja!"
    },
    {
      "id": 110504457932972036,
      "target": "Phone: Wewe si wa kunihukumu!"
    },
    {
      "id": 110504457932972034,
      "target": "Na mliamua kumuua mtoto wenu?"
    },
    {
      "id": 110504457932972033,
      "target": "Phone: Dalili zote zililingana, na mume wangu alisisitiza."
    },
    {
      "id": 110504457932972032,
      "target": "Phone: Tulimuua. Elewa, ilibidi tufanye hivyo."
    },
    {
      "id": 110504457928777740,
      "target": "(Kata simu)"
    },
    {
      "id": 110504457928777739,
      "target": "Nini?"
    },
    {
      "id": 110504457928777738,
      "target": "Phone: Ilibidi tumuue."
    },
    {
      "id": 110504457928777737,
      "target": "Phone: Ilitubidi..."
    },
    {
      "id": 110504457928777736,
      "target": "Phone: ..."
    },
    {
      "id": 110504457928777735,
      "target": "Phone: Alikufa..."
    },
    {
      "id": 110504457928777734,
      "target": "Phone: Binti yetu mpendwa... yeye..."
    },
    {
      "id": 110504457928777733,
      "target": "Phone: Na kwaheri."
    },
    {
      "id": 110504457928777732,
      "target": "Phone: Tafadhali, mwambie msichana huyo maneno haya."
    },
    {
      "id": 110504457928777731,
      "target": "Phone: Na hata machozi hayawezi kusaidia hapa."
    },
    {
      "id": 110504457928777730,
      "target": "Phone: Ikiwa baba yake alichomwa moto, basi ndivyo ilivyopaswa kuwa."
    },
    {
      "id": 110504457928777729,
      "target": "Phone: Hakuna kinachotokea bila sababu."
    },
    {
      "id": 110504457928777728,
      "target": "Phone: Unaelewa..."
    },
    {
      "id": 110504457924583435,
      "target": "Phone: Nawe pia utaweza kuvumilia. Na msichana huyo pia."
    },
    {
      "id": 110504457924583434,
      "target": "Phone: Lakini mume wangu alinisaidia kulivumilia hilo."
    },
    {
      "id": 110504457924583433,
      "target": "Phone: Mwanzoni nililia sana. Nilitaka kujiua. Sikuweza kuishi bila yeye."
    },
    {
      "id": 110504457924583432,
      "target": "Phone: ..."
    },
    {
      "id": 110504457924583431,
      "target": "Phone: Pale pale kwenye shule yake ya chekechea."
    },
    {
      "id": 110504457924583430,
      "target": "Phone: Yeye pia walimchoma moto."
    },
    {
      "id": 110504457924583429,
      "target": "Phone: Kwa hiyo, alikuwa Mgeni. Kama binti yetu mpendwa."
    },
    {
      "id": 110504457924583428,
      "target": "Phone: Hakuna mtu atakayewachoma watu moto bila sababu."
    },
    {
      "id": 110504457924583427,
      "target": "Hapana, wapumbavu fulani walimchoma moto bila sababu yoyote"
    }
  ]
}
