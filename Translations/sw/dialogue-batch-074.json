      "id": 110504456292999179,
      "target": "Neighbour: Sikiliza, nilikuja kwa sababu nina wasiwasi kidogo juu yako."
    },
    {
      "id": 110504456292999178,
      "target": "Siko vibaya"
    },
    {
      "id": 110504456292999177,
      "target": "Mambo ni yaleyale"
    },
    {
      "id": 110504456292999176,
      "target": "Neighbour: Habari, jirani. Hatujaonana kwa muda mrefu. Maisha yakoje?"
    },
    {
      "id": 110504456292999175,
      "target": "Scammer: Basi, baadaye."
    },
    {
      "id": 110504456292999174,
      "target": "Scammer: Basi nitawaendea majirani zako."
    },
    {
      "id": 110504456292999173,
      "target": "Scammer: Wewe ni mjinga, kweli. Lakini sawa, sijali juu yako."
    },
    {
      "id": 110504456292999172,
      "target": "Scammer: Hatimaye nimekutana na mtu mwenye akili."
    },
    {
      "id": 110504456292999171,
      "target": "Scammer: Oooo, hilo ni jambo kali."
    },
    {
      "id": 110504456292999168,
      "target": "Scammer: Tuchangamke, tuchangamke, unaelewa? Basi, twende?"
    },
    {
      "id": 110504456288804875,
      "target": "Scammer: Tunahitaji kupanga dili wakati nafasi bado ipo; jua halinihusu."
    },
    {
      "id": 110504456288804874,
      "target": "Scammer: Kuishi, nini kingine?"
    },
    {
      "id": 110504456288804871,
      "target": "Scammer: Mimi na wewe tutafanya sherehe kubwa ya maisha hapa!"
    },
    {
      "id": 110504456288804870,
      "target": "Scammer: Unakusanya watu, unapanga mambo hapa. Unaleta shughuli."
    },
    {
      "id": 110504456288804869,
      "target": "Scammer: Unaona, tayari una shughuli ya maana!"
    },
    {
      "id": 110504456288804868,
      "target": "Unapendekeza nini?"
    },
    {
      "id": 110504456288804867,
      "target": "Na kwa nini umekuja kwangu?"
    },
    {
      "id": 110504456288804866,
      "target": "Scammer: Kwa kifupi, tunapaswa kufurahi."
    },
    {
      "id": 110504456288804865,
      "target": "Scammer: Wote wananung’unika, wanakimbia na kuhangaika, kumbe tunaweza tu kufanya mambo kwa moyo, basi."
    },
    {
      "id": 110504456288804864,
      "target": "Scammer: Fursa mpya, huzioni kabisa, bwana?"
    },
    {
      "id": 110504456284610571,
      "target": "Unapendekeza nini?"
    },
    {
      "id": 110504456284610570,
      "target": "Na kwa nini umekuja kwangu?"
    },
    {
      "id": 110504456284610569,
      "target": "Scammer: Wapuuzi fulani wanaogopa kila kitu, kumbe mtu anahitaji tu kuchangamka!"
    },
    {
      "id": 110504456284610568,
      "target": "Scammer: Kwa hali hii tamu ya jua, unaweza kupata pesa bila kujisumbua."
    },
    {
      "id": 110504456284610567,
      "target": "Scammer: Kwa kweli nina wazo moja, unaweza kupata pesa kirahisi."
    },
    {
      "id": 110504456284610566,
      "target": "Scammer: Ah, nauliza tu."
    },
    {
      "id": 110504456284610565,
      "target": "Basi nini kinaendelea?"
    },
    {
      "id": 110504456284610564,
      "target": "Unahitaji nini?"
    },
    {
      "id": 110504456284610563,
      "target": "Scammer: Shughuli zako zinaendaje?"
    },
    {
      "id": 110504456284610562,
      "target": "Scammer: Umeona kinachoendelea? Ni balaa kabisa."
    },
    {
      "id": 110504456284610561,
      "target": "Scammer: Lo, habari."
    },
    {
      "id": 110504456284610560,
      "target": "Widow: Wewe…"
    },
    {
      "id": 110504456280416266,
      "target": "Widow: Nataka kupumzika kidogo tu."
    },
    {
      "id": 110504456280416265,
      "target": "Widow: Sidhani nitakaa muda mrefu."
    },
    {
      "id": 110504456280416262,
      "target": "Widow: Kila mtu alijali."
    },
    {
      "id": 110504456280416261,
      "target": "Widow: Angeweza kuwa hai kama…"
    },
    {
      "id": 110504456280416260,
      "target": "Widow: Sasa amekufa."
    },
    {
      "id": 110504456280416259,
      "target": "Widow: Hakuna tena. Wakati ulipohitajika, hakuna aliyesaidia."
    },
    {
      "id": 110504456280416256,
      "target": "Widow: Siwezi kumzika ipasavyo sasa. Kumwacha aende sasa hakuna maana."
    },
    {
      "id": 110504456276221961,
      "target": "Widow: Amekufa."
    },
    {
      "id": 110504456276221960,
      "target": "Widow: Huyu ni mume wangu."
    },
    {
      "id": 110504456276221959,
      "target": "Rafiki yako anahitaji msaada?"
    },
    {
      "id": 110504456276221958,
      "target": "Mwenzako anaumwa?"
    },
    {
      "id": 110504456276221957,
      "target": "Widow: Haijalishi tena nitakuwa wapi."
    },
    {
      "id": 110504456276221956,
      "target": "Widow: Mimi… nataka tu kuanguka mahali fulani na nisiinuke tena."
    },
    {
      "id": 110504456276221955,
      "target": "Rafiki yako anahitaji msaada?"
    },
