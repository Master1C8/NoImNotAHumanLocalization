  "entries": [
    {
      "id": 110504456301387787,
      "target": "Neighbour: Ndiyo. Inaonekana hivyo ndivyo wanavyowaita watu wanaotoka ardhini."
    },
    {
      "id": 110504456301387786,
      "target": "Na binti na mke wako je?"
    },
    {
      "id": 110504456301387785,
      "target": "Naweza kujitetea"
    },
    {
      "id": 110504456301387783,
      "target": "Neighbour: Ndiyo maana nimekuja kuhakikisha hakuna atakayekuua."
    },
    {
      "id": 110504456301387782,
      "target": "Neighbour: Dada yangu alisema kwamba ni hatari kukaa nyumbani peke yako."
    },
    {
      "id": 110504456301387780,
      "target": "Neighbour: Inaonekana tunahitaji kujiandaa kwa mabaya zaidi."
    },
    {
      "id": 110504456301387779,
      "target": "Neighbour: Umegundua kwamba huu ndio msimu wa joto wenye joto kali zaidi?"
    },
    {
      "id": 110504456301387778,
      "target": "Neighbour: Jambo moja linajulikana: kuna kitu kibaya nacho."
    },
    {
      "id": 110504456301387777,
      "target": "Neighbour: Labda kuna milipuko juu yake, au mianga ya ghafla…"
    },
    {
      "id": 110504456301387776,
      "target": "Wageni?"
    },
    {
      "id": 110504456297193483,
      "target": "Na jua lina nini?"
    },
    {
      "id": 110504456297193482,
      "target": "Neighbour: Inatisha. Natumaini haya yote si kweli."
    },
    {
      "id": 110504456297193481,
      "target": "Neighbour: Pia kuna watu wanaotoka ardhini. Kwa sababu fulani wanaitwa Wageni."
    },
    {
      "id": 110504456297193480,
      "target": "Neighbour: Binamu yangu wa kike alinipigia simu. Habari za kwao zinasema kuna jambo la ajabu linaloendelea juani."
    },
    {
      "id": 110504456297193479,
      "target": "Neighbour: Jambo baya linakaribia."
    },
    {
      "id": 110504456297193478,
      "target": "Neighbour: Sikiliza, nilikuja kwa sababu nina wasiwasi kidogo juu yako."
    },
    {
