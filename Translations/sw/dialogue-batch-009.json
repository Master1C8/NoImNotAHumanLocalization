  "entries": [
    {
      "id": 110504457807142923,
      "target": "Phone: Hata hivyo, sasa ninajisikia vizuri zaidi nikiwa na watu wanaonielewa."
    },
    {
      "id": 110504457807142922,
      "target": "Phone: …"
    },
    {
      "id": 110504457807142921,
      "target": "Phone: Anatumaini kurekebisha kila kitu, kukirudisha jinsi kilivyokuwa zamani. Lakini haiwezekani: hakuna anayeweza kurudisha wakati nyuma."
    },
    {
      "id": 110504457807142920,
      "target": "Phone: Hana ujasiri wa kukubali makosa yake. Wala kukubali yaliyotokea."
    },
    {
      "id": 110504457807142919,
      "target": "Phone: Tatizo ni kwamba yeye mwenyewe hawezi kunipigia simu. Unajua kwa nini?"
    },
    {
      "id": 110504457807142918,
      "target": "Phone: Labda hujui, lakini tayari amewataka watu wengine kuniomba msamaha kwa niaba yake."
    },
    {
      "id": 110504457807142917,
      "target": "Phone: Nini, tena?"
    },
    {
      "id": 110504457807142916,
      "target": "Phone: Ha, anajuta!?"
    },
    {
      "id": 110504457807142915,
      "target": "Alitaka kukuambia uende kuzimu"
    },
    {
      "id": 110504457807142914,
      "target": "Alitaka kukufikishia kwamba anajutia alichofanya"
    },
    {
      "id": 110504457807142913,
      "target": "Phone: Baada ya yote aliyoyafanya... sitaki kusikia habari zake."
    },
    {
      "id": 110504457807142912,
      "target": "Phone: …"
    },
    {
      "id": 110504457802948620,
      "target": "Phone: Mume wangu?"
    },
    {
      "id": 110504457802948619,
      "target": "Alitaka kukuambia uende kuzimu"
    },
    {
      "id": 110504457802948618,
      "target": "Alitaka kukufikishia kwamba anajutia alichofanya"
    },
    {
      "id": 110504457802948617,
      "target": "Phone: Baada ya yote aliyoyafanya... sitaki kusikia habari zake."
    },
    {
      "id": 110504457802948616,
      "target": "Phone: …"
    },
    {
      "id": 110504457802948615,
      "target": "Phone: Nini? Mume wangu?"
    },
    {
      "id": 110504457802948614,
      "target": "Sawa, bila mahubiri. Ninapiga simu kuhusu mume wako"
    },
    {
      "id": 110504457802948613,
      "target": "Mume wako aliniomba nikupigie simu"
    },
    {
      "id": 110504457802948612,
      "target": "Phone: Niambie, unaamini katika kifo?"
    },
    {
      "id": 110504457802948611,
      "target": "Phone: Basi... kila la heri. Ishi kwa furaha."
    },
    {
      "id": 110504457802948610,
      "target": "Phone: Kwa nini unajiingiza katika jambo hili? Sielewi."
    },
    {
      "id": 110504457802948609,
      "target": "Phone: Hatujaliana hata kidogo."
    },
    {
      "id": 110504457802948608,
      "target": "Phone: Hakuna haja ya kusema chochote. Kuna faida gani?"
    },
    {
      "id": 110504457798754315,
      "target": "Phone: Basi nitamwambia kwamba uko hai na unamngoja"
    },
    {
      "id": 110504457798754314,
      "target": "Phone: Niache tu, kwa kuzimu."
    },
    {
      "id": 110504457798754313,
      "target": "Phone: Fanyeni mnachotaka huko pamoja, hata hivyo yeye ni mpuuzi asiyejali chochote."
    },
    {
      "id": 110504457798754312,
      "target": "Phone: Basi kwa nini ulipiga simu? Kumsaidia mwanamke maskini aliye taabani?"
    },
    {
      "id": 110504457798754311,
      "target": "Phone: …"
    },
    {
      "id": 110504457798754310,
      "target": "Basi nitamwambia kwamba uko hai na unamngoja"
    },
    {
      "id": 110504457798754309,
      "target": "Mtatue wenyewe"
    },
    {
      "id": 110504457798754308,
      "target": "Phone: Ana miguu, sivyo? Tatizo ni nini?"
    },
    {
      "id": 110504457798754307,
      "target": "Phone: Basi aje mwenyewe. Si binti wa mfalme."
    },
    {
      "id": 110504457798754306,
      "target": "Basi nitamwambia kwamba uko hai na unamngoja"
    },
    {
      "id": 110504457798754305,
      "target": "Mtatue wenyewe"
    },
    {
      "id": 110504457798754304,
      "target": "Phone: Basi aende yeye. Mwambie, yeye ni mama wa aina gani?"
    },
    {
      "id": 110504457794560012,
      "target": "Phone: Mimi siendi kwake."
    },
    {
      "id": 110504457794560011,
      "target": "Phone: Labda wapo huko."
    },
    {
      "id": 110504457794560010,
      "target": "Phone: Ndiyo."
    },
    {
      "id": 110504457794560009,
      "target": "Labda unaweza kuja kumchukua hapa?"
    },
    {
      "id": 110504457794560007,
      "target": "Phone: Mmeangalia kwa mama wa mke wangu?"
    },
    {
      "id": 110504457794560006,
      "target": "Phone: Sishangai."
    },
    {
      "id": 110504457794560005,
      "target": "Phone: Hapana. Hawapo pamoja naye?"
    },
    {
      "id": 110504457794560004,
      "target": "Labda unaweza kuja kumchukua hapa?"
    },
    {
      "id": 110504457794560002,
      "target": "Phone: Mmeangalia kwa mama wa mke wangu?"
    },
    {
      "id": 110504457794560001,
      "target": "Phone: Na sasa ni mimi nitakayelazimika kushughulikia fujo yote..."
    },
    {
      "id": 110504457794560000,
      "target": "Phone: Aaah. Kwa mara nyingine, hajali hata chembe watoto wake mwenyewe."
    },
    {
      "id": 110504457790365707,
      "target": "Je, watoto wapo kwako?"
    },
    {
      "id": 110504457790365706,
      "target": "Amewapoteza watoto wote"
    },
    {
      "id": 110504457790365705,
      "target": "Phone: Hakuna jipya."
    },
    {
      "id": 110504457790365704,
      "target": "Phone: Anakaa tu hapo akisema, “oh, nimechoka.”"
    },
    {
      "id": 110504457790365703,
      "target": "Phone: Kama kawaida. Mimi peke yangu ndiye ninayepaswa kutatua kila kitu."
    },
    {
      "id": 110504457790365702,
      "target": "Je, watoto wapo kwako?"
    },
    {
      "id": 110504457790365701,
      "target": "Amewapoteza watoto wote"
    },
    {
      "id": 110504457790365700,
      "target": "Phone: Ndiyo, sasa nini?"
    },
    {
      "id": 110504457790365699,
      "target": "Mke wako anahitaji msaada"
    },
    {
      "id": 110504457790365698,
      "target": "Mke wako alinipa namba hii"
    },
    {
      "id": 110504457790365697,
      "target": "Phone: Eh? Halo?"
    },
    {
      "id": 110504457790365696,
      "target": "TV: Kinachofuata ni taarifa kuhusu Wageni ni akina nani."
    },
    {
      "id": 110504457786171403,
      "target": "TV: Kamati ya Hali za Dharura imeripoti dalili mpya ya Wageni..."
    },
    {
      "id": 110504457786171402,
      "target": "TV: Licha ya moto, Wageni wanaendelea kuwatia hofu wakazi."
    },
    {
      "id": 110504457786171401,
      "target": "TV: Habari za mchana, hizi ni habari."
    },
    {
      "id": 110504457786171400,
      "target": "TV: Sasa pia inapatikana kupitia huduma ya kuleta chakula ya For Rest. Piga simu kwa namba: {0}."
    },
    {
      "id": 110504457786171399,
      "target": "TV: Hayo ndiyo yote."
    },
    {
      "id": 110504457786171398,
      "target": "Phone: Asante, maoni yako yana thamani kubwa kwetu. Kila la heri."
    },
    {
      "id": 110504457786171397,
      "target": "Phone: …"
    },
    {
      "id": 110504457786171395,
      "target": "Nendeni zenu kuzimu, matapeli wa kishenzi"
    },
    {
      "id": 110504457786171394,
      "target": "Haikunisaidia"
    },
    {
      "id": 110504457786171393,
      "target": "Vizuri"
    },
    {
      "id": 110504457786171392,
      "target": "Phone: Ungetathminije kikao kilichofanyika?"
    },
    {
      "id": 110504457781977099,
      "target": "Phone: …"
    },
    {
      "id": 110504457781977098,
      "target": "Phone: Ikiwa ulilitazama tangazo kwa makini, kulikuwa na maandishi madogo yaliyosema kwamba kupiga simu kunalipiwa."
    },
    {
      "id": 110504457781977096,
      "target": "Nendeni zenu kuzimu, matapeli wa kishenzi"
    },
    {
      "id": 110504457781977095,
      "target": "Haikunisaidia"
    },
    {
      "id": 110504457781977094,
