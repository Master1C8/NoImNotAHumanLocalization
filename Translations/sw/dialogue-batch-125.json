  "entries": [
    {
      "id": 110504454808215559,
      "target": "Fatman: (Unapata Kombucha)"
    },
    {
      "id": 110504454808215558,
      "target": "Fatman: Ah, na jambo jingine. Haya, chukua."
    },
    {
      "id": 110504454808215557,
      "target": "Fatman: Sitawabania pesa watu wanaonisaidia."
    },
    {
      "id": 110504454808215556,
      "target": "Fatman: Nipe kila ninachoomba, na utalipwa kama meneja wa kiwanda."
    },
    {
      "id": 110504454808215555,
      "target": "Fatman: Hivyo ndivyo!"
    },
    {
      "id": 110504454808215554,
      "target": "Sihitaji pesa zako"
    },
    {
      "id": 110504454808215553,
      "target": "Naam… Asante"
    },
    {
      "id": 110504454808215552,
      "target": "Fatman: (Unapata noti zilizokunjamana ambazo hazina faida katika hali yako)"
    },
    {
      "id": 110504454804021259,
      "target": "Fatman: Haya, chukua pesa kidogo."
    },
    {
      "id": 110504454804021258,
      "target": "Fatman: Mmm, ni tamu sana. Ndiyo ninayoipenda zaidi."
    },
    {
      "id": 110504454804021256,
      "target": "Fatman: Ooo, hiki ndicho tunachohitaji!"
    },
    {
      "id": 110504454804021254,
      "target": "Fatman: Usinidanganye, niliona ulikuwa na bia nyingi kwenye friji. Umewezaje kunywa bia yote haraka hivi?"
    },
    {
      "id": 110504454804021252,
      "target": "Fatman: Huna bia?"
    },
    {
      "id": 110504454804021251,
      "target": "Naweza kukupa bia (mpe kopo la bia)"
    },
    {
      "id": 110504454804021250,
      "target": "Fatman: Unajua, nina njaa kidogo. Unaweza kunipa kitu cha kutafuna?"
    },
    {
      "id": 110504454804021249,
      "target": "Fatman: Ingawa…"
    },
    {
      "id": 110504454799826954,
      "target": "Fatman: Ndiyo, ndiyo, nafuu zaidi."
    },
    {
      "id": 110504454799826952,
      "target": "Unajisikia afadhali?"
    },
    {
      "id": 110504454799826949,
      "target": "Buddy: Ninaogopa sitawahi kujua…"
    },
    {
      "id": 110504454799826948,
      "target": "Buddy: Kila siku ninajiuliza kama nilifanya jambo sahihi nilipokomesha mateso yake."
    },
    {
      "id": 110504454799826947,
      "target": "Buddy: Uko sahihi, rafiki. Labda itakuwa bora hivyo."
    },
    {
      "id": 110504454799826946,
      "target": "Buddy: Nafurahi umenielewa."
    },
    {
      "id": 110504454799826945,
      "target": "Buddy: Asante, rafiki."
    },
    {
      "id": 110504454795632651,
      "target": "Sawa, unaweza kubaki"
    },
    {
      "id": 110504454795632650,
      "target": "Buddy: Unajua msemo: kwa sisi wao ni muda mfupi, kwao sisi ni maisha yote; tena wanatufundisha mengi kuliko mtu yeyote."
    },
    {
      "id": 110504454795632649,
      "target": "Buddy: Huwezi kufikiria ugumu wa kumpoteza mnyama wa nyumbani."
    },
    {
      "id": 110504454795632647,
      "target": "Buddy: Mwanaharamu, ningetoa kila kitu ili nimnyonge. Lakini alitoroka, nami sikuweza kuona nambari ya gari…"
    },
    {
      "id": 110504454795632646,
      "target": "Buddy: Kana kwamba hakuwa kiumbe hai, bali jiwe fulani!"
    },
    {
      "id": 110504454795632645,
      "target": "Buddy: Yule mwanaharamu alimkanyaga mbwa wangu kwa gari! Kisha akaondoka kana kwamba hakuna kilichotokea!"
    },
    {
      "id": 110504454795632644,
      "target": "Buddy: DEREVA WA TEKSI WA KULAANIWA!"
    },
    {
      "id": 110504454795632642,
      "target": "Buddy: Kwa kweli sikutaka! Sikutaka, mikono yangu isingeweza kamwe…"
    },
    {
      "id": 110504454795632641,
      "target": "Buddy: Umewahi kuona mbwa wakilia? Macho yake yalionekana kuniomba nikomeshe mateso hayo yote."
    },
    {
      "id": 110504454795632640,
      "target": "Buddy: Siku baada ya siku nilimwona hali yake ikizidi kuwa mbaya. Usiku alikuwa analia kwa maumivu, na machozi…"
    },
    {
      "id": 110504454791438347,
      "target": "Buddy: Aliteseka… sana. Sikuweza kuendelea kutazama."
    },
    {
      "id": 110504454791438346,
      "target": "Buddy: Ndiyo, najua… Mimi ni mwanaharamu. Bado siwezi kujisamehe."
    },
    {
      "id": 110504454791438344,
      "target": "Sawa, unaweza kubaki"
    },
    {
      "id": 110504454791438343,
      "target": "Buddy: Unajua msemo: kwa sisi wao ni muda mfupi, kwao sisi ni maisha yote; tena wanatufundisha mengi kuliko mtu yeyote."
    },
    {
      "id": 110504454791438342,
      "target": "Buddy: Huwezi kufikiria ugumu wa kumpoteza mnyama wa nyumbani."
    },
    {
      "id": 110504454791438340,
      "target": "Buddy: Mwanaharamu, ningetoa kila kitu ili nimnyonge. Lakini alitoroka, nami sikuweza kuona nambari ya gari…"
    },
    {
      "id": 110504454791438339,
      "target": "Buddy: GARI LA KULAANIWA! Laiti dereva wa teksi angeangalia alikokuwa anaenda, angeishi muda mrefu zaidi."
    },
    {
      "id": 110504454791438338,
      "target": "Buddy: Siku baada ya siku nilimwona akiteseka. Usiku alikuwa analia kwa maumivu ya miguu yake."
    },
    {
      "id": 110504454791438337,
      "target": "Buddy: Najua hili linaweza kusikika vibaya. Lakini niruhusu niseme, rafiki. Aliteseka… sana. Sikuweza kuendelea kutazama."
    },
    {
      "id": 110504454791438336,
      "target": "Wewe mwanaharamu!"
    },
    {
      "id": 110504454787244046,
      "target": "Ulifanya nini!?"
    },
    {
      "id": 110504454787244045,
      "target": "Buddy: Nilimuua."
    },
    {
      "id": 110504454787244043,
      "target": "Buddy: Mimi…"
    },
    {
      "id": 110504454787244042,
      "target": "Wewe mwanaharamu!"
    },
    {
      "id": 110504454787244041,
      "target": "Ulifanya nini!?"
    },
    {
      "id": 110504454787244040,
      "target": "Buddy: Nilimuua…"
