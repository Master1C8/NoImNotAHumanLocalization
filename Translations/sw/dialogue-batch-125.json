    },
    {
      "id": 110504454774661130,
      "target": "Buddy: Haijalishi, hata hivyo hutaelewa."
    },
    {
      "id": 110504454774661128,
      "target": "Jambo gani?"
    },
    {
      "id": 110504454774661127,
      "target": "Buddy: Sitaki kulizungumzia jambo hilo."
    },
