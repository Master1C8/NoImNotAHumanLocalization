    {
      "id": 110504454787244038,
      "target": "Buddy: Mimi…"
    },
    {
      "id": 110504454787244037,
      "target": "Buddy: Hakufa kwa…"
    },
    {
      "id": 110504454787244036,
      "target": "Buddy: Hilo ndilo jambo. Ingawa alikuwa mzee na mgonjwa, lakini…"
    },
    {
      "id": 110504454787244034,
      "target": "Na kuna ubaya gani?"
    },
    {
      "id": 110504454787244033,
      "target": "Buddy: Nilikuwa na mbwa, na siku chache zilizopita… alikufa."
    },
    {
      "id": 110504454787244032,
      "target": "Buddy: Sawa, kwa kuwa lazima nisimulie…"
    },
    {
      "id": 110504454783049737,
      "target": "Buddy: Unataka kuniua kwa risasi, rafiki?"
    },
    {
      "id": 110504454783049735,
      "target": "Na kuna ubaya gani?"
    },
    {
      "id": 110504454783049734,
      "target": "Buddy: Nilikuwa na mbwa, na siku chache zilizopita… alikufa."
    },
    {
      "id": 110504454783049733,
      "target": "Buddy: Lakini… siwezi kuendelea hivi."
    },
    {
      "id": 110504454783049731,
      "target": "Buddy: Siwezi… Utaniangalia vibaya."
    },
    {
      "id": 110504454783049730,
      "target": "Lazima uniambie. La sivyo mambo yatakuwa mabaya zaidi"
    },
    {
      "id": 110504454783049729,
      "target": "Nisimulie tu kinachokusumbua"
    },
    {
      "id": 110504454783049728,
      "target": "Buddy: Hilo halikuhusu, rafiki! Niache!"
    },
    {
      "id": 110504454778855433,
      "target": "Niambie, kuna nini?"
    },
    {
      "id": 110504454778855432,
      "target": "Buddy: Uliza, rafiki."
    },
    {
      "id": 110504454778855431,
      "target": "Buddy: Asante, kwa kweli sijisikii vizuri."
