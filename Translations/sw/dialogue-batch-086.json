  "entries": [
    {
      "id": 110504455961649159,
      "target": "Intruder: Humo unatambaa kwenye ukanda kama konokono mchafu asiye na gamba."
    },
    {
      "id": 110504455961649158,
      "target": "Intruder: Isipokuwa moja yenye wasiwasi…"
    },
    {
      "id": 110504455961649157,
      "target": "Intruder: Sasa jiulize mwenyewe kama nimesema ukweli au nimekudanganya tu kwa upuuzi."
    },
    {
      "id": 110504455961649156,
      "target": "Intruder: Kwa hiyo unaweza kutulia."
    },
    {
      "id": 110504455961649155,
      "target": "Intruder: Lakini tayari nimeona machoni mwako — huna ndoto."
    },
    {
      "id": 110504455961649154,
      "target": "Intruder: Elewa, NINAHITAJI SANA ndoto."
    },
    {
      "id": 110504455961649153,
      "target": "Ondoka mbele yangu."
    },
    {
      "id": 110504455961649152,
      "target": "Sina ndoto"
    },
    {
      "id": 110504455957454859,
      "target": "Nitakupiga sasa hivi usiposogea mbali."
    },
    {
      "id": 110504455957454858,
      "target": "Intruder: Unazificha wapi? Sema!"
    },
    {
      "id": 110504455957454857,
      "target": "Intruder: Nataka kupata utulivu. Hata chembe tu."
    },
    {
      "id": 110504455957454856,
      "target": "Intruder: Ninatafuta ndoto zako."
    },
    {
      "id": 110504455957454855,
      "target": "Unafanya nini?"
    },
    {
      "id": 110504455957454853,
      "target": "FortuneTeller: Ninaogopa hili haliwezekani. Samahani. Hata matamko ya kujipa moyo hayakusaidia…"
    },
    {
      "id": 110504455957454851,
      "target": "FortuneTeller: Bila matamanio hakuna matokeo — ulimwengu hautasikia wala kulifanya jambo hilo kuwa halisi."
    },
    {
      "id": 110504455957454850,
      "target": "FortuneTeller: Katika aura yako… Hutaki kuwa na furaha. Ndani yako kuna utupu tu."
    },
    {
      "id": 110504455957454849,
      "target": "FortuneTeller: Subiri… Kwa nini sikuona hili mapema…"
    },
    {
      "id": 110504455957454848,
      "target": "FortuneTeller: Hujaribu kabisa!"
    },
    {
      "id": 110504455953260555,
      "target": "Huu ni upuuzi mtupu"
    },
    {
      "id": 110504455953260553,
      "target": "Mimi ni mtu mwenye furaha!"
    },
    {
      "id": 110504455953260552,
      "target": "FortuneTeller: Endelea."
    },
    {
      "id": 110504455953260551,
      "target": "Huu ni upuuzi mtupu"
    },
    {
      "id": 110504455953260549,
      "target": "Mimi ni mtu mwenye furaha!"
    },
    {
      "id": 110504455953260548,
      "target": "FortuneTeller: Rudia baada yangu: mimi ni mtu mwenye furaha!"
    },
    {
      "id": 110504455953260547,
      "target": "FortuneTeller: Lakini maneno yanatosha — tuanze mazoezi."
    },
    {
      "id": 110504455953260546,
      "target": "FortuneTeller: Sawa, usikate tamaa. Matamko ya kujipa moyo ya mara kwa mara yatakusaidia kuwa na furaha."
    },
    {
      "id": 110504455953260545,
      "target": "FortuneTeller: Ajabu, ilipaswa kusaidia."
    },
    {
      "id": 110504455949066252,
      "target": "FortuneTeller: Nini, haikusaidia?"
    },
    {
      "id": 110504455949066251,
      "target": "Nini tena hiki?"
    },
    {
      "id": 110504455949066250,
      "target": "Ilipaswa kusaidia?"
    },
    {
      "id": 110504455949066249,
      "target": "FortuneTeller: Basi, imesaidia? Tayari unahisi wimbi la furaha?"
    },
    {
      "id": 110504455949066247,
      "target": "FortuneTeller: CHEZA NGOMA YA KAPRIKONI!"
    },
    {
      "id": 110504455949066246,
      "target": "FortuneTeller: Kinachohitajika tu ni…"
    },
    {
      "id": 110504455949066245,
      "target": "FortuneTeller: Unajua, nadhani najua jambo litakalosaidia kuisogeza nishati yako."
    },
    {
      "id": 110504455949066243,
      "target": "Esenin: Sawa, kama unavyosema."
    },
    {
      "id": 110504455949066241,
      "target": "Esenin: Asante kwa kunisikiliza, mwenye nyumba."
    },
    {
      "id": 110504455949066240,
      "target": "Esenin: Unajua, sasa nahisi nafuu kidogo."
    },
    {
      "id": 110504455944871944,
      "target": "Ni shairi tu"
    },
    {
      "id": 110504455944871943,
      "target": "Limependeza"
    },
    {
      "id": 110504455944871942,
      "target": "Esenin: Basi hilo ndilo shairi. Unaonaje?"
    },
    {
      "id": 110504455944871941,
      "target": "Hapana, asante"
    },
    {
      "id": 110504455944871940,
      "target": "Bila shaka"
    },
    {
      "id": 110504455944871939,
      "target": "Esenin: Mwenye nyumba, utajali nikikusomea shairi moja?"
    },
    {
      "id": 110504455944871938,
      "target": "Esenin: Nimepata kitabu cha mashairi kwako."
    },
    {
      "id": 110504455944871936,
      "target": ">>"
    },
    {
      "id": 110504455940677643,
      "target": "WheelChair: Sawa, naondoka. Lakini nitaondoka na kiti changu cha magurudumu."
    },
    {
      "id": 110504455940677641,
      "target": "WheelChair: Laana, mbona hivyo?"
    },
    {
      "id": 110504455940677640,
      "target": "WheelChair: Lakini mimi nafurahia. Maisha yanahitaji uyafurahie kikamilifu."
    },
    {
      "id": 110504455940677639,
      "target": "WheelChair: Basi sawa."
    },
    {
      "id": 110504455940677638,
      "target": "Ondoka kwa amani sasa"
    },
    {
      "id": 110504455940677637,
      "target": "Wewe ni wa ajabu kupita kiasi"
    },
    {
      "id": 110504455940677636,
      "target": "WheelChair: Usiniambie hujawahi kujaribu. Ni raha sana!"
    },
    {
      "id": 110504455940677635,
      "target": "WheelChair: Kwani si raha kuteleza na kukimbia kwa kasi ndani yake?"
    },
    {
      "id": 110504455940677634,
      "target": "Ondoka kwa amani sasa"
    },
    {
      "id": 110504455940677633,
      "target": "Wewe ni wa ajabu kupita kiasi"
    },
    {
      "id": 110504455940677632,
      "target": "WheelChair: Kama unamaanisha kiti cha magurudumu, napenda tu kuzunguka ndani yake."
    },
    {
      "id": 110504455936483340,
      "target": "WheelChair: Sikujifanya. Miguu yangu ilikuwa na joto zaidi hivyo."
    },
    {
      "id": 110504455936483339,
      "target": "Basi ulikihitaji kiti cha magurudumu kwa nini?"
    },
    {
      "id": 110504455936483338,
      "target": "Kwa nini ulijifanya mlemavu?"
    },
    {
      "id": 110504455936483337,
      "target": "WheelChair: Acha, miguu yangu ilikuwa imekakamaa tu. Kuna nini kibaya hapo?"
    },
    {
      "id": 110504455936483336,
      "target": "Hii ina maana gani sasa?"
    },
    {
      "id": 110504455936483335,
      "target": "WheelChair: Aah, sasa ni rahisi zaidi."
    },
    {
      "id": 110504455936483334,
      "target": "WheelChair: Sasa hivi."
    },
    {
      "id": 110504455936483333,
      "target": "WheelChair: Laana, miguu inaniuma."
    },
    {
      "id": 110504455936483331,
      "target": "Dude: Na sasa nitakaa hapa kidogo..."
    },
    {
      "id": 110504455936483330,
      "target": "Dude: Samahani, hiyo ilikuwa ya mwisho. Chukua sigara ya kawaida. Natumaini hujanikasirikia, bro."
    },
    {
      "id": 110504455936483329,
      "target": "Dude: Sikufikiria kabisa kukushirikisha."
    },
    {
      "id": 110504455936483328,
      "target": "Dude: Aah, brooo..."
    }
  ]
}
