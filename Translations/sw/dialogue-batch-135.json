  "entries": [
    {
      "id": 110504454460088323,
      "target": "Scammer: Laiti ungejua kiasi cha pesa kilichopita mikononi mwangu, ungetokwa na mate."
    },
    {
      "id": 110504454460088322,
      "target": "Scammer: Eeh, mbona sasa? Mimi ni mchambuzi wa michezo, mwanaharamu."
    },
    {
      "id": 110504454460088321,
      "target": "Nimesikia kidogo"
    },
    {
      "id": 110504454460088320,
      "target": "Wewe ni mraibu wa kamari?"
    },
    {
      "id": 110504454455894027,
      "target": "Scammer: Dau za michezo?"
    },
    {
      "id": 110504454455894026,
      "target": "Scammer: Umewahi kusikia kuhusu…"
    },
    {
      "id": 110504454455894025,
      "target": "Scammer: Ooo, nimefurahi umeuliza."
    },
    {
      "id": 110504454455894023,
      "target": "Ulifanya kazi gani kabla ya janga?"
    },
    {
      "id": 110504454455894022,
      "target": "Scammer: He-he. Vipi sasa, jamani?"
    },
    {
      "id": 110504454455894021,
      "target": "Widow: Natumaini utapata unachotafuta."
    },
    {
      "id": 110504454455894020,
      "target": "Widow: Huzungumzi sana, lakini… umekuwa mwenzi mzuri wa mazungumzo."
    },
    {
      "id": 110504454455894019,
      "target": "Widow: Asante."
    },
    {
      "id": 110504454455894018,
      "target": "Widow: Sitaki kuamua chochote kabla sijarudi."
    },
    {
      "id": 110504454455894017,
      "target": "Widow: Nataka sana kurudi nyumbani."
    },
    {
      "id": 110504454455894016,
      "target": "Widow: Sina hisia zozote kwako, samahani."
    },
    {
      "id": 110504454451699715,
      "target": "Widow: Sitajisikia afadhali."
    },
    {
      "id": 110504454451699714,
      "target": "Widow: Kwa nini?"
    },
    {
      "id": 110504454451699713,
      "target": "Kila la heri"
    },
    {
      "id": 110504454451699712,
      "target": "Unaweza kubaki"
    },
    {
      "id": 110504454447505416,
      "target": "Widow: Sitaki kitu chochote tena."
    },
    {
      "id": 110504454447505415,
      "target": "Widow: Tutarudi nyumbani."
    },
    {
      "id": 110504454447505414,
      "target": "Widow: Hakuna aliyebaki."
    },
    {
      "id": 110504454447505413,
      "target": "Kila la heri"
    },
    {
      "id": 110504454447505412,
      "target": "Unaweza kubaki"
    },
    {
      "id": 110504454447505411,
      "target": "Widow: Na huko…"
    },
    {
      "id": 110504454447505410,
      "target": "Widow: Nitatoa gitaa."
    },
    {
      "id": 110504454447505409,
      "target": "Widow: Nitarudi nyumbani."
    },
    {
      "id": 110504454447505408,
      "target": "Widow: Sitaki kufikiria hilo."
    },
    {
      "id": 110504454443311116,
      "target": "Unakwenda kwa jamaa zako?"
    },
    {
      "id": 110504454443311115,
      "target": "Nini sasa?"
    },
    {
      "id": 110504454443311114,
      "target": "Widow: Nilihitaji kupumzika tu."
    },
    {
      "id": 110504454443311113,
      "target": "Widow: Nilikwambia tangu mwanzo sikupanga kukaa muda mrefu."
    },
    {
      "id": 110504454443311112,
      "target": "Widow: Ninaondoka usiku huu."
    },
    {
      "id": 110504454443311108,
      "target": "Widow: Ni vigumu sana kuishi bila yeye sasa…"
    },
    {
      "id": 110504454443311107,
      "target": "Widow: Ndiyo. Tafadhali."
    },
    {
      "id": 110504454443311106,
      "target": "Widow: Nataka kuwa peke yangu."
    },
    {
      "id": 110504454443311104,
      "target": "Widow: Wewe uliua — roho yake itabaki kwako. Mimi nitabaki kupiga kelele kwamba simhurumii mtu yeyote."
    },
    {
      "id": 110504454439116810,
      "target": "Widow: Kweli huko…"
    },
    {
      "id": 110504454439116809,
      "target": "Widow: Lakini yeye…"
    },
    {
      "id": 110504454439116808,
      "target": "Widow: Wapumbavu kama hao huwa na vurugu kila wakati, kwa hiyo ilinibidi tu kuvaa koti la daktari na kuingia chumba cha maiti."
    },
    {
      "id": 110504454439116807,
      "target": "Widow: Sikuweza kuupeleka mwili wake nyumbani."
    },
    {
      "id": 110504454439116806,
      "target": "Widow: Sikuweza kuukagua mwili."
    },
    {
      "id": 110504454439116805,
      "target": "Widow: Basi."
    },
    {
      "id": 110504454439116804,
      "target": "Widow: Waliniambia, «Amekufa»."
    },
    {
      "id": 110504454439116802,
      "target": "Widow: Subiri kidogo, samahani."
    },
    {
      "id": 110504454439116800,
      "target": "Widow: Waliniambia kwa sauti kavu tu…"
    },
    {
      "id": 110504454434922503,
      "target": "Widow: Nilikuja mapema, kumtembelea tu."
    },
    {
      "id": 110504454434922501,
      "target": "Widow: KHD walimweka tu karantini. Hawakunipa njia yoyote ya kuwasiliana naye. Wakasema watamwachia baada ya wiki tatu."
    },
    {
      "id": 110504454434922500,
      "target": "Widow: Tulifika katika kituo kilichofunguliwa na KHD."
    },
    {
      "id": 110504454434922499,
      "target": "Widow: Mume wangu alikuwa hajisikii vizuri. Tulienda hospitalini, lakini wakampeleka akakaguliwe na wale wanaharamu."
    },
    {
      "id": 110504454434922498,
      "target": "Naweza kuacha kuuliza kuhusu hilo"
    },
    {
      "id": 110504454434922497,
      "target": "Basi kilitokea nini?"
    },
    {
      "id": 110504454434922496,
      "target": "Widow: Na mtu fulani atawaaua."
    },
    {
      "id": 110504454430728198,
      "target": "Widow: Natumaini wale wanaharamu watapata wanachostahili."
    },
    {
      "id": 110504454430728197,
      "target": "Widow: Nilikuwa mkali. Lakini siwezi kuzungumza kwa utulivu kumhusu."
    },
    {
      "id": 110504454430728196,
      "target": "Widow: Ndiyo. Ndiyo, ninaelewa."
    },
    {
      "id": 110504454430728194,
      "target": "Naweza kuacha kuuliza kuhusu hilo"
    },
    {
      "id": 110504454430728193,
      "target": "Basi kilitokea nini?"
    },
    {
      "id": 110504454430728192,
      "target": "Widow: Lakini zaidi ya yote nataka waliohusika na… yote haya waungue juani."
    },
    {
      "id": 110504454426533897,
      "target": "Widow: Kila usiku siwezi kuyazuia machozi."
    },
    {
      "id": 110504454426533896,
      "target": "Widow: Samahani, siwezi tu…"
    },
    {
      "id": 110504454426533894,
      "target": "Mimi si mwenye kosa kwa kifo chake"
    },
    {
      "id": 110504454426533893,
      "target": "Ninaelewa. Samahani kama nimekuumiza"
    },
    {
      "id": 110504454426533892,
      "target": "Widow: Jamani, amekufa."
    },
    {
      "id": 110504454426533890,
      "target": "Basi kilimpata nini?"
    },
    {
      "id": 110504454426533888,
      "target": "Widow: Hutanipigia muziki tena. Umeniimbia wimbo wako wa mwisho."
    },
    {
      "id": 110504454422339595,
      "target": "Widow: Ilipasuka kidogo…"
    },
    {
      "id": 110504454422339594,
      "target": "Widow: Bado nina picha ya jioni ile."
    },
    {
      "id": 110504454422339592,
      "target": "Widow: Baadaye nilijua kwamba alijifunza wimbo mmoja kwa makusudi ili anivutie."
    },
    {
      "id": 110504454422339591,
      "target": "Widow: Kisha akasimama, akasema lazima aende, akagonga glasi, akajaribu kuidaka, gitaa likaanguka…"
    },
    {
      "id": 110504454422339590,
      "target": "Widow: Marafiki wakaanza kumwomba apige nyimbo mbalimbali; alikaa hapo, kisha…"
    },
    {
      "id": 110504454422339589,
      "target": "Widow: Na alipiga vizuri sana, nilifurahia kweli."
    },
    {
      "id": 110504454422339588,
      "target": "Widow: «Nipeni gitaa, tuimbe sasa»."
    },
    {
      "id": 110504454422339587,
      "target": "Widow: Alikaa kimya kwa muda, kisha ghafla akasema:"
    },
    {
      "id": 110504454422339586,
      "target": "Widow: Wakati huo tulikuwa tayari tumekunywa pombe nyingi."
    },
    {
      "id": 110504454422339585,
      "target": "Widow: Tulikuwa tumekaa tukinywa. Kwa kawaida alikuwa mkimya na hakuzungumza sana katika mikutano hiyo."
    },
    {
      "id": 110504454422339584,
      "target": "Widow: Wakati huo tulikuwa vijana zaidi."
    },
    {
      "id": 110504454418145291,
      "target": "Widow: Siku moja tulienda kwa marafiki zetu."
    },
    {
      "id": 110504454418145288,
      "target": "Nisimulie unachokumbuka kumhusu?"
    },
    {
      "id": 110504454418145286,
      "target": "Widow: Natamani kuamini hivyo."
    }
  ]
}
