  "entries": [
    {
      "id": 110504454418145285,
      "target": "Widow: Natamani sana…"
    },
    {
      "id": 110504454418145284,
      "target": "Widow: Bado ananisikia."
    },
    {
      "id": 110504454418145283,
      "target": "Widow: Hapana, si hivyo."
    },
    {
      "id": 110504454418145282,
      "target": "Widow: Hapana."
    },
    {
      "id": 110504454418145280,
      "target": "Widow: Sitamkabidhi kwa ardhi isiyo na roho."
    },
    {
      "id": 110504454413950982,
      "target": "Widow: Siwezi kufanya hivyo."
    },
    {
      "id": 110504454413950981,
      "target": "Widow: Na kuachana naye tena."
    },
    {
      "id": 110504454413950980,
      "target": "Widow: Nimempata tena hivi majuzi tu."
    },
    {
      "id": 110504454413950979,
      "target": "Widow: Siko tayari."
    },
    {
      "id": 110504454413950978,
      "target": "Widow: Hapana, hapana, hapana, hapana."
    },
    {
      "id": 110504454413950977,
      "target": "Widow: Hapaaana."
    },
    {
      "id": 110504454413950976,
      "target": "Kilichobaki ni mwili wake tu. Lazima ukubali hilo"
    },
    {
      "id": 110504454409756678,
      "target": "Lazima azikwe"
    },
    {
      "id": 110504454409756677,
      "target": "Widow: Niache tu kulia."
    },
    {
      "id": 110504454409756676,
      "target": "Widow: Lakini je, hilo ni sahihi?"
    },
    {
      "id": 110504454409756675,
      "target": "Widow: Ni kana kwamba sina machozi tena."
    },
    {
      "id": 110504454409756674,
      "target": "Widow: Hivi majuzi machozi yangu yote yameisha."
    },
    {
      "id": 110504454409756673,
      "target": "Widow: Hili ni kubwa mno."
    },
    {
      "id": 110504454409756672,
      "target": "Widow: Bado siwezi."
    },
    {
      "id": 110504454405562378,
      "target": "Alikufaje?"
    },
    {
      "id": 110504454405562376,
      "target": "Widow: Nifanye nini?"
    },
    {
      "id": 110504454405562375,
      "target": "Widow: Siwezi kuku…"
    },
    {
      "id": 110504454405562373,
      "target": "Widow: Kumzika…"
    },
    {
      "id": 110504454405562372,
      "target": "Widow: Hata mimi…"
    },
    {
      "id": 110504454405562371,
      "target": "Widow: Huwezi kunirudishia mtu yeyote."
    },
    {
      "id": 110504454405562370,
      "target": "Widow: Nataka kukaa naye."
    },
    {
      "id": 110504454405562369,
      "target": "Widow: Mbona unafanya hivi?"
    },
    {
      "id": 110504454405562368,
      "target": "Widow: Naam, sasa nibaki peke yangu nijaribu kuishi."
    },
    {
      "id": 110504454401368071,
      "target": "Widow: Na akafa."
    },
    {
      "id": 110504454401368069,
      "target": "Widow: Alisema kila kitu kitakuwa sawa."
    },
    {
      "id": 110504454401368068,
      "target": "Widow: Si aliahidi kwamba kila kitu kitakuwa sawa?"
    },
    {
      "id": 110504454401368067,
      "target": "Widow: Kwa nini ulikufa?"
    },
    {
      "id": 110504454401368065,
      "target": "Niketi nawe?"
    },
    {
      "id": 110504454401368064,
      "target": "Nitakuacha hapa kwa sasa"
    },
    {
      "id": 110504454397173767,
      "target": "Widow: Nataka kukaa."
    },
    {
      "id": 110504454397173766,
      "target": "Widow: Mimi niko hapa…"
    },
    {
      "id": 110504454397173765,
      "target": "Widow: Sina njaa."
    },
    {
      "id": 110504454397173764,
      "target": "Niketi nawe?"
    },
    {
      "id": 110504454397173763,
      "target": "Nitakuacha hapa kwa sasa"
    },
    {
      "id": 110504454397173762,
      "target": "Widow: Nitakunywa nikihitaji."
    },
    {
      "id": 110504454397173761,
      "target": "Widow: Nimekaa karibu na bomba la maji."
    },
    {
      "id": 110504454397173760,
      "target": "Widow: Mimi niko hapa…"
    },
    {
      "id": 110504454392979464,
      "target": "Nikuletee chakula?"
    },
    {
      "id": 110504454392979463,
      "target": "Nikuletee maji?"
    },
    {
      "id": 110504454392979462,
      "target": "Widow: Sihitaji kitu chochote tena."
    },
    {
      "id": 110504454392979461,
      "target": "Widow: Mimi…"
    },
    {
      "id": 110504454392979460,
      "target": "Widow: Nataka awe hai."
    },
    {
      "id": 110504454392979457,
      "target": "Unahitaji kitu chochote?"
    },
    {
      "id": 110504454388785163,
      "target": "Esenin: Kwa nini nilikuja hapa?.."
    },
    {
      "id": 110504454388785162,
      "target": "Esenin: Siwezi kuvumilia tena."
    },
    {
      "id": 110504454388785161,
      "target": "Esenin: Haya ni maafa ya kishenzi. Kila kitu kinanitisha hadi nahisi nitajinyea."
    },
    {
      "id": 110504454388785160,
      "target": "Esenin: Mwenye nyumba, nataka tu yote haya yaishie hapa."
    },
    {
      "id": 110504454388785159,
      "target": "Esenin: Nyumbani kwako nahisi kubanwa. Hata katika sayari hii nahisi kubanwa."
    },
    {
      "id": 110504454388785158,
      "target": "Esenin: Kule ningeweza kujinyonga."
    },
    {
      "id": 110504454388785157,
      "target": "Esenin: Angalau kwenye baa dari ilikuwa juu."
    },
    {
      "id": 110504454388785155,
      "target": "Wewe… uko sawa?"
    },
    {
      "id": 110504454388785153,
      "target": "Esenin: Mimi… nataka kuwa peke yangu."
    },
    {
      "id": 110504454388785152,
      "target": "Esenin: Nafasi tupu ya giza lisilo na mwisho. Ikiwa baada ya kifo tunaenda huko, ni sawa na kutoweka…"
    },
    {
      "id": 110504454384590859,
      "target": "Esenin: Labda kama kungekuwa na kitu huko, tungepokea ishara fulani au jambo lingine. Sijui."
    },
    {
      "id": 110504454384590858,
      "target": "Esenin: Hakuna maisha mengine. Anga tupu lenye baridi."
    },
    {
      "id": 110504454384590857,
      "target": "Esenin: Hakuna kitu angani isipokuwa sisi."
    },
    {
      "id": 110504454384590856,
      "target": "Esenin: Lakini ukifikiria…"
    },
    {
      "id": 110504454384590855,
      "target": "Esenin: Sijisikii kuzungumza sasa."
    },
    {
      "id": 110504454384590854,
      "target": "Esenin: Hakutakuwa na chochote kabisa… Giza tu?"
    },
    {
      "id": 110504454384590853,
      "target": "Esenin: Labda uko sahihi. Lakini hilo linatisha sana."
    },
    {
      "id": 110504454384590852,
      "target": "Esenin: Nilitamani sana ungesema vinginevyo."
    },
    {
      "id": 110504454384590850,
      "target": "Esenin: Hapana, mwenye nyumba. Sijapata utulivu."
    },
    {
      "id": 110504454384590848,
      "target": "Esenin: Na nguvu za kuota ndoto hiyo zitakapoisha, nini kitafuata?"
    },
    {
      "id": 110504454380396556,
      "target": "Esenin: Nitakapokuwa nikifa, ubongo wangu utatambua hilo. Utaanza kunionyesha sehemu ambayo ningependa kurudi."
    },
    {
      "id": 110504454380396555,
      "target": "Esenin: Lakini hilo halinitulizi hata kidogo. Unajua kwa nini?"
    },
    {
      "id": 110504454380396554,
      "target": "Esenin: Hilo lina mantiki."
    },
    {
      "id": 110504454380396553,
      "target": "Sijui, labda tutaenda angani"
    },
    {
      "id": 110504454380396552,
      "target": "Hakuna chochote"
    },
    {
      "id": 110504454380396551,
      "target": "Kile ninachoamini ndicho kitakachotokea"
    },
    {
      "id": 110504454380396550,
      "target": "Esenin: Umewahi kufikiria, «nini kitatupata tukifa»?"
    },
    {
      "id": 110504454380396549,
      "target": "Esenin: Siku moja tutakufa kwa hakika, hatuwezi kuepuka hilo."
    },
    {
      "id": 110504454380396548,
      "target": "Esenin: Mwenye nyumba…"
    },
    {
      "id": 110504454380396545,
      "target": "Umepata nafuu?"
    },
    {
      "id": 110504454376202251,
      "target": "Esenin: Tokomea, tafadhali. Sijisikii vizuri."
    },
    {
      "id": 110504454376202250,
      "target": "Esenin: Ooooh."
    }
  ]
}
