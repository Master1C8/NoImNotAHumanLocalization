  "entries": [
    {
      "id": 110504454560751619,
      "target": "NotTrue: Sina nyumba ya likizo. Wala jamaa. Wala wajukuu… Ah, mwanangu…"
    },
    {
      "id": 110504454560751618,
      "target": "NotTrue: Mimi ni wa mjini, mwanangu. Niliishi kwenye nyumba yangu ndogo."
    },
    {
      "id": 110504454560751617,
      "target": "NotTrue: Ndiyo maana natangatanga. Sina cha kupoteza."
    },
    {
      "id": 110504454560751616,
      "target": "NotTrue: Na nani atanitembelea kwenye kibanda changu?"
    },
    {
      "id": 110504454556557324,
      "target": "NotTrue: Ninajisikia vizuri humo, lakini bila mazungumzo ninanyauka."
    },
    {
      "id": 110504454556557323,
      "target": "NotTrue: Nina nyumba. Kibanda."
    },
    {
      "id": 110504454556557322,
      "target": "NotTrue: Unaweza kufikiria?"
    },
    {
      "id": 110504454556557321,
      "target": "NotTrue: Watu hutumia hadithi zangu kisha hunichukia kwa hadithi hizo hizo."
    },
    {
      "id": 110504454556557320,
      "target": "NotTrue: Ndiyo. Kuna ubaya gani?"
    },
    {
      "id": 110504454556557318,
      "target": "Unatoka wapi?"
    },
    {
      "id": 110504454556557316,
      "target": "Daughter: (Unaamua kwamba matatizo ya sasa yanatosha. Usimsumbue mtoto.)"
    },
    {
      "id": 110504454556557315,
      "target": "Daughter: (Lakini je, ni vyema kuharibu utoto wake sasa? Ataweza kustahimili pigo hilo?)"
    },
    {
      "id": 110504454556557314,
      "target": "Daughter: (Unaona msichana ameanza kuitikia kwa kuchelewa. Ni wazi anafikiria jambo fulani.)"
    },
    {
      "id": 110504454556557313,
      "target": "Daughter: Ndivyo ninavyofikiri pia."
    },
    {
      "id": 110504454556557312,
      "target": "Daughter: (Mbaya zaidi akiendelea kuishi kwa kudanganywa. Lazima akubali kifo mapema iwezekanavyo.)"
    },
    {
      "id": 110504454552363019,
      "target": "Daughter: (Baada ya muda anapatwa na mshtuko mkubwa wa hisia. Inaonekana huwezi kufanya lolote zaidi.)"
    },
    {
      "id": 110504454552363018,
      "target": "Daughter: (Msichana anakutazama kana kwamba anatazama mbali kupita wewe. Unaogopa kusogea na unasubiri tu jambo litokee.)"
    },
    {
      "id": 110504454552363017,
      "target": "Sawa, bila shaka baba yako atakuja hivi karibuni"
    },
    {
      "id": 110504454552363016,
      "target": "Ninasikitika sana kuhusu baba yako. Alikuwa Binadamu wa kweli. Lakini mwema kupita kiasi"
    },
    {
      "id": 110504454552363015,
      "target": "Daughter: Sikumbuki."
    },
    {
      "id": 110504454552363014,
      "target": "Daughter: Walimpiga… kwa hiyo…"
    },
    {
      "id": 110504454552363013,
      "target": "Daughter: Mwema."
    },
    {
      "id": 110504454552363011,
      "target": "Sawa, bila shaka baba yako atakuja hivi karibuni"
    },
    {
      "id": 110504454552363010,
      "target": "Ninasikitika sana kuhusu baba yako. Alikuwa Binadamu wa kweli. Lakini mwema kupita kiasi"
    },
    {
      "id": 110504454552363009,
      "target": "Daughter: Yeye… anapaswa kuja hivi karibuni."
    },
    {
      "id": 110504454552363008,
      "target": "Daughter: Alienda kuwapiga wale watu wabaya."
    },
    {
      "id": 110504454548168715,
      "target": "Daughter: Labda ana kitu cha kufanya kwanza?"
    },
    {
      "id": 110504454548168713,
      "target": "Ulimwonaje mara ya mwisho?"
    },
    {
      "id": 110504454548168712,
      "target": "Kwa nini hajaja kukuchukua?"
    },
    {
      "id": 110504454548168711,
      "target": "Daughter: Hatakuja? Kwa nini unafikiri hivyo?"
    },
    {
      "id": 110504454548168710,
      "target": "Ulimwonaje mara ya mwisho?"
    },
    {
      "id": 110504454548168709,
      "target": "Kwa nini hajaja kukuchukua?"
    },
    {
      "id": 110504454548168708,
      "target": "Daughter: Basi atakuja hivi karibuni!"
    },
    {
      "id": 110504454548168707,
      "target": "Daughter: Nami nilikuwa pale! Alitikisika nilipokuwa nikikimbia."
    },
    {
      "id": 110504454548168706,
      "target": "Daughter: Wewe hukuona kilichotokea pale!"
    },
    {
      "id": 110504454548168705,
      "target": "Labda baba yako hatakuja kukuchukua. Sijui kilichompata"
    },
    {
      "id": 110504454548168704,
      "target": "Sijui ulichoona. Lakini inaonekana baba yako amekufa"
    },
    {
      "id": 110504454543974411,
      "target": "Daughter: Niliona televisheni chumbani kwako. Naweza kutazama katuni humo?"
    },
    {
      "id": 110504454543974410,
      "target": "Daughter: Unazungumzia nini?"
    },
    {
      "id": 110504454543974408,
      "target": "Lazima ukubali kilichotokea"
    },
    {
      "id": 110504454543974407,
      "target": "Daughter: Mimi… Nata-ka kwa ma-ma."
    },
    {
      "id": 110504454543974406,
      "target": "Daughter: Ingawa nilikuwa nikikimbia, nilimwona."
    },
    {
      "id": 110504454543974405,
      "target": "Daughter: Nilimwona akisimama baadaye na kuondoka."
    },
    {
      "id": 110504454543974404,
      "target": "Daughter: Atakuja kunichukua, sivyo?"
    },
    {
      "id": 110504454543974403,
      "target": "Daughter: Siendi popote bila baba."
    },
    {
      "id": 110504454543974402,
      "target": "Daughter: Atakuja hivi karibuni, sivyo?"
    },
    {
      "id": 110504454543974401,
      "target": "Daughter: Au ameenda tu kunitafuta."
    },
    {
      "id": 110504454543974400,
      "target": "Daughter: Basi… basi angeweza kuzima moto pia."
    },
    {
      "id": 110504454539780107,
      "target": "Daughter: Walimpiga baba, lakini alisimama baadaye. Niliona."
    },
    {
      "id": 110504454539780106,
      "target": "Daughter: Sina hakika."
    },
    {
      "id": 110504454539780105,
      "target": "Daughter: Sijui."
    },
    {
      "id": 110504454539780104,
      "target": "Ni bora ubaki hapa kwa sasa"
    },
    {
      "id": 110504454539780103,
      "target": "Uliona kilichotokea"
    },
    {
      "id": 110504454539780102,
      "target": "Daughter: Je, kuna mtu mwingine aliyebaki nyumbani kwetu?"
    },
    {
      "id": 110504454539780101,
      "target": "Daughter: Mama hatakuja kutuchukua?"
    },
    {
      "id": 110504454539780099,
      "target": "Daughter: Na chumba changu? Nacho pia kimeungua?"
    },
    {
      "id": 110504454539780098,
      "target": "Daughter: Lakini baba yuko salama?"
    },
    {
      "id": 110504454539780097,
      "target": "Ni bora ubaki hapa kwa sasa"
    },
    {
      "id": 110504454539780096,
      "target": "Uliona kilichotokea"
    },
    {
      "id": 110504454535585803,
      "target": "Daughter: Basi baba atakuja kunichukua, sivyo?"
    },
    {
      "id": 110504454535585802,
      "target": "Daughter: Watanijengea chumba kipya?"
    },
    {
      "id": 110504454535585801,
      "target": "Daughter: Au katika nyumba ileile?"
    },
    {
      "id": 110504454535585800,
      "target": "Daughter: Na kunipeleka kwenye nyumba mpya?"
    },
    {
      "id": 110504454535585799,
      "target": "Daughter: Sawa. Basi watakuja kunichukua hivi karibuni?"
    },
    {
      "id": 110504454535585798,
      "target": "Si hivi karibuni. Nyumba yenu imeungua"
    },
    {
      "id": 110504454535585797,
      "target": "Baadaye, kuna matengenezo huko"
    },
    {
      "id": 110504454535585796,
      "target": "Daughter: Nitarudi nyumbani lini?"
    },
    {
      "id": 110504454535585795,
      "target": "Daughter: Nataka kwenda nyumbani…"
    },
    {
      "id": 110504454535585794,
      "target": "Daughter: Hapa si pabaya."
    },
    {
      "id": 110504454535585792,
      "target": "Unaendeleaje? Unapapenda hapa?"
    },
    {
      "id": 110504454531391500,
      "target": "Daughter: Mimi… Nata-ka kwa ma-ma."
    },
    {
      "id": 110504454531391499,
      "target": "Daughter: (Msichana hata hakusikii. Yuko peke yake katika huzuni yake.)"
    },
    {
      "id": 110504454531391498,
      "target": "Daughter: (Msichana anamwita baba yake bila kuacha; mshtuko wake hautaisha hivi karibuni.)"
    },
    {
      "id": 110504454531391497,
      "target": "Nitazungumza nawe tena kesho, sawa?"
    },
    {
      "id": 110504454531391496,
      "target": "Wewe… pumzika kwa sasa"
    },
    {
      "id": 110504454531391495,
      "target": "Daughter: BA-A-A-A-BA-A-A!"
    },
    {
      "id": 110504454531391494,
      "target": "Daughter: BABA, BABAAA!"
    },
    {
      "id": 110504454531391493,
      "target": "Daughter: Waliingia, wakaanza kuzungumza, baba akasema hawapaswi kufanya hivyo, nao wakasema kwamba… wakasema…"
    },
    {
      "id": 110504454531391492,
      "target": "Daughter: Siju-u-u-i."
    },
    {
      "id": 110504454531391490,
      "target": "Nisimulie kilichotokea"
    }
  ]
}
