  "entries": [
    {
      "id": 110504456645320706,
      "target": "Gasmask: Kisha tutaondoka."
    },
    {
      "id": 110504456645320705,
      "target": "Gasmask: Kwa hiyo TUTAWACHUKUA WATU WAWILI."
    },
    {
      "id": 110504456645320704,
      "target": "Gasmask: Wewe utabaki hapa ufe."
    },
    {
      "id": 110504456641126412,
      "target": "Gasmask: Tunawachukua wote."
    },
    {
      "id": 110504456641126411,
      "target": "Gasmask: Tutavunja mlango."
    },
    {
      "id": 110504456641126410,
      "target": "Gasmask: Ni kama naongea na ukuta. Tukiondoka sasa bila watu, tutafyatua risasi."
    },
    {
      "id": 110504456641126409,
      "target": "Gasmask: Basi, uwe salama."
    },
    {
      "id": 110504456641126407,
      "target": "Gasmask: Mimi pia."
    },
    {
      "id": 110504456641126406,
      "target": "Sitawakabidhi mtu mwingine tena"
    },
    {
      "id": 110504456641126405,
      "target": "Natumaini hatutaonana tena"
    },
    {
      "id": 110504456641126404,
      "target": "Gasmask: Tutakushughulikia wewe pia."
    },
    {
      "id": 110504456641126403,
      "target": "Gasmask: Wewe si wa kwanza kupinga. Tumeshakabiliana na watu wa aina hiyo."
    },
    {
      "id": 110504456641126402,
      "target": "Gasmask: Sasa ama tutavunja mlango na kuwachukua wote katika nyumba yako ya ovyo, ama utatupa watu wawili kwa hiari."
    },
    {
      "id": 110504456641126401,
      "target": "Gasmask: Sitabishana nawe."
    },
    {
      "id": 110504456641126400,
      "target": "Gasmask: Sina la kusema."
    },
    {
      "id": 110504456636932106,
      "target": "Sitawakabidhi mtu mwingine tena"
    },
    {
      "id": 110504456636932105,
      "target": "Natumaini hatutaonana tena"
    },
    {
      "id": 110504456636932104,
      "target": "Gasmask: Kisha ama tutapata njia ya kuwaathiri Wageni, ama hatutaonana tena."
    },
    {
      "id": 110504456636932103,
      "target": "Gasmask: Hata sasa hatuwachukui wote. Tunahitaji wawili tu."
    },
    {
      "id": 110504456636932102,
      "target": "Gasmask: Watu wawili zaidi."
    },
    {
      "id": 110504456636932101,
      "target": "Mnasaidia nini, laana, ikiwa bado hamfanikiwi?"
    },
    {
      "id": 110504456636932100,
      "target": "Tunahitaji nini ili kuokoka?"
    },
    {
      "id": 110504456636932099,
      "target": "Gasmask: Tusipobuni sasa njia yenye ufanisi ya kujiokoa, wengine watatubunia."
    },
    {
      "id": 110504456636932098,
      "target": "Gasmask: Wanatupangia malengo yasiyowezekana."
    },
    {
      "id": 110504456636932097,
      "target": "Gasmask: Mamlaka zinataka kulipua mji mzima kwa sababu hali hii haiwezi kudhibitiwa."
    },
    {
      "id": 110504456636932096,
      "target": "Gasmask: Hili ni balaa kubwa."
    },
    {
      "id": 110504456632737804,
      "target": "Mnasaidia nini, laana, ikiwa bado hamfanikiwi?"
    },
    {
      "id": 110504456632737803,
      "target": "Tunahitaji nini ili kuokoka?"
    },
    {
      "id": 110504456632737802,
      "target": "Gasmask: Ukiendelea kupinga, tutawachukua tu wote ndani ya nyumba hii."
    },
    {
      "id": 110504456632737801,
      "target": "Gasmask: DUNIA IKO UKINGONI MWA KUANGAMIA."
    },
    {
      "id": 110504456632737800,
      "target": "Gasmask: ACHENI UPUUZI WENU!"
    },
    {
      "id": 110504456632737799,
      "target": "Janga gani?"
    },
    {
      "id": 110504456632737798,
      "target": "Watu. Wangu. Wako wapi?"
    },
    {
      "id": 110504456632737797,
      "target": "Gasmask: La sivyo kutakuwa na janga."
    },
    {
      "id": 110504456632737796,
      "target": "Gasmask: Tunahitaji kuchukua watu wengine."
    },
    {
      "id": 110504456632737795,
      "target": "Gasmask: Tutawarudisha hivi karibuni. Asante."
    },
    {
      "id": 110504456632737794,
      "target": "Gasmask: Tupeni. Watu. Tu."
    },
    {
      "id": 110504456632737793,
      "target": "Gasmask: Tunaujali mji huu."
    },
    {
      "id": 110504456632737792,
      "target": "Gasmask: Ukiendelea kupinga, milipuko itaendelea."
    },
    {
      "id": 110504456628543499,
      "target": "Gasmask: Ni kwa sababu wapumbavu wakaidi wanatuzuia kufanya kazi."
    },
    {
      "id": 110504456628543498,
      "target": "Gasmask: Unapenda unachokiona nyuma yangu?"
    },
    {
      "id": 110504456628543497,
      "target": "Gasmask: Sawa."
    },
    {
      "id": 110504456628543496,
      "target": "Gasmask: Laana…"
    },
    {
      "id": 110504456628543495,
      "target": "Gasmask: Kisha tutawashughulikia Wageni."
    },
    {
      "id": 110504456628543494,
      "target": "Gasmask: Sasa tutawachukua wawili, lakini hivi karibuni tutawarudisha wote."
    },
    {
      "id": 110504456628543493,
      "target": "Gasmask: Asante kwa kunisikiliza."
    },
    {
      "id": 110504456628543492,
      "target": "Gasmask: Ndiyo, hilo litasaidia."
    },
    {
      "id": 110504456628543491,
      "target": "Hapana. Imenitosha"
    },
    {
      "id": 110504456628543490,
      "target": "Sawa. Ikiwa hilo litasaidia…"
    },
    {
      "id": 110504456628543489,
      "target": "Gasmask: Hivi karibuni mambo yatakuwa sawa."
    },
    {
      "id": 110504456628543488,
      "target": "Gasmask: Haijalishi ni nani, tupeni mtu yeyote haraka."
    },
    {
      "id": 110504456624349196,
      "target": "Gasmask: Lakini mara hii tunahitaji wawili."
    },
    {
      "id": 110504456624349195,
      "target": "Gasmask: Ndiyo."
    },
    {
      "id": 110504456624349194,
      "target": "Hapana. Imenitosha"
    },
    {
      "id": 110504456624349193,
      "target": "Sawa. Ikiwa hilo litasaidia…"
    }
  ]
