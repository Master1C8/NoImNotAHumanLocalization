  "sourceInventorySha256": "ecd96645c2ca6f23f8bf3ab2fcf65709e961478ae15a38e83d94cc335a408bf0",
  "glossaryFingerprint": "95fe1a773cf228dfabad22f97b085694a725bf5d3e2d83e0a07f8fda316beeb3",
  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504457895223302,
      "target": "Unaishi wapi?"
    },
    {
      "id": 110504457895223301,
      "target": "Phone: Ungependa kujua nini?"
    },
    {
      "id": 110504457895223300,
      "target": "Phone: Nadhani ili tuzungumze kwa urahisi zaidi, naweza kukueleza jambo fulani kunihusu."
    },
    {
      "id": 110504457895223299,
      "target": "Phone: Asante sana. Asante!"
    },
    {
      "id": 110504457895223298,
      "target": "Phone: Kwaheri."
    },
    {
      "id": 110504457895223297,
      "target": "Phone: Sawa, samahani kama nimekusumbua."
    },
    {
      "id": 110504457895223296,
      "target": "Phone: …"
    },
    {
      "id": 110504457891029004,
      "target": "Phone: Oh…"
    },
    {
      "id": 110504457891029003,
      "target": "Siko tayari kwa mazungumzo marefu"
    },
    {
      "id": 110504457891029001,
      "target": "Phone: Je, hutajali kunisikiliza?"
    },
    {
      "id": 110504457891029000,
      "target": "Phone: Huwezi kuwazia jinsi mazungumzo tu yatakavyonisaidia. Yatanifanya nijisikie mtulivu zaidi."
    },
    {
      "id": 110504457891028999,
      "target": "Phone: Najua si sawa kumbebesha mtu nisiyemjua matatizo yangu, lakini…"
    },
    {
      "id": 110504457891028998,
      "target": "Phone: Labda hapa si mahali pazuri zaidi pa kumwaga moyo, lakini ni bora kuliko kutokuwa na mahali kabisa."
    },
    {
      "id": 110504457891028997,
      "target": "Phone: Kisha nikasikia kuhusu ruleti ya simu."
    },
    {
      "id": 110504457891028996,
      "target": "Phone: Nilijaribu kuwasiliana na marafiki na watu ninaowafahamu, lakini hakuna anayejibu…"
    },
    {
      "id": 110504457891028995,
      "target": "Phone: Mimi... nahitaji mtu wa kumweleza yaliyo moyoni. Mambo mengi sana yametokea hivi karibuni…"
    },
    {
      "id": 110504457891028994,
      "target": "Phone: …"
    },
    {
      "id": 110504457891028993,
      "target": "Phone: Inaonekana hakuna mtu…"
    },
    {
      "id": 110504457891028992,
      "target": "Phone: …"
    },
    {
      "id": 110504457886834699,
      "target": "Phone: …"
    },
    {
      "id": 110504457886834697,
      "target": "Habari"
    },
    {
      "id": 110504457886834696,
      "target": "Phone: Halo?"
    },
    {
      "id": 110504457886834695,
      "target": "Phone: …"
    },
    {
      "id": 110504457886834693,
      "target": "Habari"
    },
    {
      "id": 110504457886834692,
      "target": "Phone: Halo, habari."
    },
    {
      "id": 110504457886834691,
      "target": "Phone: …"
    },
    {
      "id": 110504457886834690,
      "target": "Phone: …"
    },
    {
      "id": 110504457886834689,
      "target": "Phone: Habari, umepiga simu kwenye ruleti ya simu. Sasa tutakutafutia mtu anayekufaa kabisa kuzungumza naye. Tafadhali subiri."
    },
    {
      "id": 110504457886834688,
      "target": "Phone: …"
    },
    {
      "id": 110504457882640396,
      "target": "Phone: …"
    },
    {
      "id": 110504457882640395,
      "target": "Phone: Basi swali la mwisho: je, damu imemwagika nyumbani kwako?"
    },
    {
      "id": 110504457882640394,
      "target": "Phone: …"
    },
    {
      "id": 110504457882640393,
      "target": "Phone: Sawa, niambie, je, unakula uyoga?"
    },
    {
      "id": 110504457882640392,
      "target": "Phone: …"
    },
    {
      "id": 110504457882640391,
      "target": "Phone: …"
    },
    {
      "id": 110504457882640390,
      "target": "Phone: Tutashauriana na wakubwa wetu na kukujulisha baadaye."
    },
    {
      "id": 110504457882640389,
      "target": "Phone: Masikio? Subiri..."
    },
    {
      "id": 110504457882640388,
      "target": "Phone: …"
    },
    {
      "id": 110504457882640387,
      "target": "Phone: …"
    },
    {
      "id": 110504457882640386,
      "target": "Phone: Epuka kuoga na kunawa mikono."
    },
    {
      "id": 110504457882640385,
      "target": "Phone: Ili vipimo vya makwapa viwe sahihi, lazima uepuke kugusana na maji kwa namna yoyote."
    },
    {
      "id": 110504457882640384,
      "target": "Phone: …"
    },
    {
      "id": 110504457878446091,
      "target": "Phone: …"
    },
    {
      "id": 110504457878446090,
      "target": "Phone: …"
    },
    {
      "id": 110504457878446089,
      "target": "Nifanye nini kuhusu masikio yangu?"
    },
    {
      "id": 110504457878446088,
      "target": "Nifanye nini kuhusu makwapa yangu?"
    },
    {
      "id": 110504457878446087,
      "target": "Phone: WEWE NI MJINGA KABISA?! KATA SIMU MARA MOJA!"
    },
    {
      "id": 110504457878446086,
      "target": "Phone: (Kabla mwanamke hajapata nafasi ya kujibu, kilisikika kilio kikubwa cha mwanaume)"
    },
    {
      "id": 110504457878446085,
      "target": "Unamaanisha nini?"
    },
    {
      "id": 110504457878446084,
      "target": "Nini? Kamati ya Hali za Dharura? Hiyo ni nini tena?"
    },
    {
      "id": 110504457878446083,
      "target": "Phone: Habari, umepiga simu kwenye laini maalumu ya Kamati ya Hali za Dharura. Tunaweza kukusaidiaje?"
    },
    {
      "id": 110504457870057480,
      "target": "Piga simu sasa hivi kwa namba 891-533 nasi tutakutafutia mtu anayekufaa kabisa kuzungumza naye."
    },
    {
      "id": 110504457870057479,
      "target": "Basi ruleti ya simu ndiyo unayohitaji."
    },
    {
      "id": 110504457870057478,
      "target": "Huna mtu wa kuzungumza naye na unahisi wasiwasi?"
    },
    {
      "id": 110504457870057477,
      "target": "Unajihisi mpweke?"
    },
    {
      "id": 110504457870057476,
      "target": "Nimekuwa nikijaribu kuamua kwa miaka kumi na mitano. Na bado ni vigumu kufanya uamuzi."
    },
    {
      "id": 110504457870057475,
      "target": "Wakati ule alisema: «Nisipoendelea kuwepo, utaamua mwenyewe kama utaangalia ndani ya sanduku hili au la»."
    },
    {
      "id": 110504457870057474,
      "target": "Kwa nini kuzimu nitafute mtu? Laiti watu wangeniacha kwa amani…"
    },
    {
      "id": 110504457870057473,
      "target": "Mojawapo ya majarida yale ambayo unapaswa kumtafuta mtu fulani katikati ya umati…"
    }
  ]
}
