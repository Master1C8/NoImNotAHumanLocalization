  "collection": "Dialogs",
  "sourceInventorySha256": "ecd96645c2ca6f23f8bf3ab2fcf65709e961478ae15a38e83d94cc335a408bf0",
  "glossaryFingerprint": "95fe1a773cf228dfabad22f97b085694a725bf5d3e2d83e0a07f8fda316beeb3",
  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504457836503047,
      "target": "Phone: Ikiwa hicho si kitisho."
    },
    {
      "id": 110504457836503046,
      "target": "Phone: Sawa, una swali gani? Bado sielewi jinsi ninavyoweza kukusaidia."
    },
    {
      "id": 110504457836503045,
      "target": "Phone: …"
    },
    {
      "id": 110504457836503044,
      "target": "Kuna mtu hapa mwenye kujali wengine anayetaka kufanya kazi kwenu"
    },
    {
      "id": 110504457836503043,
      "target": "Nina mke wa afisa wa Kamati ya Hali za Dharura hapa"
    },
    {
      "id": 110504457836503042,
      "target": "Phone: Kamati ya upokeaji ya Kamati ya Hali za Dharura, habari."
    },
    {
      "id": 110504457836503041,
      "target": "Phone: Hakubahatika kuwa amezungukwa na watu dhaifu tu. Unaelewa, ndiyo maana niliamua kumwacha."
    },
    {
      "id": 110504457836503040,
      "target": "Phone: Labda anamng’ang’ania dada yake. Bila shaka hajawahi kujua kuachia, heh…"
    },
    {
      "id": 110504457832308747,
      "target": "Phone: Kwaheri kabisa…"
    },
    {
      "id": 110504457832308746,
      "target": "Phone: Asante kwa kupiga simu. Na kwa kunisikiliza."
    },
    {
      "id": 110504457832308745,
      "target": "Phone: …"
    },
    {
      "id": 110504457832308744,
      "target": "Phone: Sitaki ajue kwamba sikuondoka naye…"
    },
    {
      "id": 110504457832308743,
      "target": "Phone: Ingawa... bora usimwambie chochote. Tafadhali hakikisha haji kunitafuta."
    },
    {
      "id": 110504457832308742,
      "target": "Phone: …"
    },
    {
      "id": 110504457832308741,
      "target": "Phone: Tafadhali mwambie kwamba ninampenda."
    },
    {
      "id": 110504457832308740,
      "target": "Phone: …"
    },
    {
      "id": 110504457832308739,
      "target": "Phone: Mimi tu... nataka tu yote haya yaishe. Nimebakiwa na njia moja tu... unaelewa?"
    },
    {
      "id": 110504457832308738,
      "target": "Phone: Mimi... siwezi tena kuvumilia yote haya. Jua, Wageni, watu waliochanganyikiwa. Yote yanatisha sana. Nahisi kama nimepooza."
    },
    {
      "id": 110504457832308737,
      "target": "Mke wako yuko salama"
    },
    {
      "id": 110504457832308736,
      "target": "Unamaanisha nini? Una tatizo gani?"
    },
    {
      "id": 110504457828114443,
      "target": "Phone: Hivi karibuni sitakuwepo tena."
    },
    {
      "id": 110504457828114442,
      "target": "Phone: …"
    },
    {
      "id": 110504457828114441,
      "target": "Phone: Lakini naogopa kwamba siwezi tena kusaidiwa."
    },
    {
      "id": 110504457828114440,
      "target": "Phone: Yeye ni imara, anaweza kustahimili jambo lolote, na hata atawasaidia wengine wanaohitaji msaada njiani!"
    },
    {
      "id": 110504457828114439,
      "target": "Phone: Tafadhali niambie kwamba yuko salama."
    },
    {
      "id": 110504457828114438,
      "target": "Mke wako yuko salama"
    },
    {
      "id": 110504457828114437,
      "target": "Unamaanisha nini? Una tatizo gani?"
    },
    {
      "id": 110504457828114436,
      "target": "Phone: Na hivi karibuni hakutakuwa na mtu wa kutoa chochote."
    },
    {
      "id": 110504457828114435,
      "target": "Phone: …"
    },
    {
      "id": 110504457828114434,
      "target": "Phone: Naogopa sina tena chochote cha kutoa."
    },
    {
      "id": 110504457828114433,
      "target": "Phone: Unasikika kana kwamba unataka fidia ili kuwaachia."
    },
    {
      "id": 110504457828114432,
      "target": "Mke wako alinipa namba hii"
    },
    {
      "id": 110504457823920139,
      "target": "Mke wako na dada yake wako nyumbani kwangu"
    },
    {
      "id": 110504457823920138,
      "target": "Phone: Ndiyo? Nani anayepiga simu?"
    },
    {
      "id": 110504457823920137,
      "target": "Phone: Kwaheri."
    },
    {
      "id": 110504457823920136,
      "target": "Phone: Na... asante kwa kumsaidia."
    },
    {
      "id": 110504457823920135,
      "target": "Phone: Niko tayari kumpa ndugu yangu wa kiume hifadhi. Tafadhali mwambie hilo. Anaijua anwani yangu."
    },
    {
      "id": 110504457823920134,
      "target": "Phone: …"
    },
    {
      "id": 110504457823920133,
      "target": "Phone: Mungu wangu... Hilo limetokeaje?..."
    },
    {
      "id": 110504457823920132,
      "target": "Phone: …"
    },
    {
      "id": 110504457823920130,
      "target": "Huenda hivyo"
    },
    {
      "id": 110504457823920128,
      "target": "Phone: Laana... Haiwezekani... Wamekufa?"
    },
    {
      "id": 110504457819725835,
      "target": "Phone: …"
    },
    {
      "id": 110504457819725834,
      "target": "Phone: Inawezekana kweli kwamba wao..."
    },
    {
      "id": 110504457819725833,
      "target": "Phone: Kutafuta hifadhi? Lakini anaishi na wazazi wake, sivyo?"
    },
    {
      "id": 110504457819725831,
      "target": "Huenda hivyo"
    },
    {
      "id": 110504457819725829,
      "target": "Phone: Laana... Haiwezekani... Wamekufa?"
    },
    {
      "id": 110504457819725828,
      "target": "Phone: …"
    },
    {
      "id": 110504457819725827,
      "target": "Phone: Hutaki kuniambia kwamba..."
    },
    {
      "id": 110504457819725826,
      "target": "Phone: Wametoweka? Imekuwaje?"
    },
    {
      "id": 110504457819725825,
      "target": "Alikuja kwangu kutafuta hifadhi"
    },
    {
      "id": 110504457819725824,
      "target": "Wazazi wake wametoweka"
    },
    {
      "id": 110504457815531532,
      "target": "Phone: Lakini subiri... Wewe ni nani? Na kwa nini yuko kwako?"
    },
    {
      "id": 110504457815531531,
      "target": "Phone: Ah, unamzungumzia ndugu yangu wa kiume wa damu, sivyo?"
    },
    {
      "id": 110504457815531530,
      "target": "Phone: …"
    },
    {
      "id": 110504457815531529,
      "target": "Phone: Ndugu gani wa kiume? Sina..."
    },
    {
      "id": 110504457815531528,
      "target": "Unaweza kumsaidia ndugu yako wa kiume?"
    },
    {
      "id": 110504457815531527,
      "target": "Habari. Ndugu yako wa kiume alinipa namba hii"
    },
    {
      "id": 110504457815531526,
      "target": "Phone: Halo, nani huyu?"
    },
    {
      "id": 110504457815531525,
      "target": "Phone: Kila la heri."
    },
    {
      "id": 110504457815531524,
      "target": "Phone: …"
    },
    {
      "id": 110504457815531523,
      "target": "Phone: Asante kwa kunielewa."
    },
    {
      "id": 110504457815531522,
      "target": "Phone: Kila la heri."
    },
    {
      "id": 110504457815531521,
      "target": "Phone: …"
    },
    {
      "id": 110504457815531520,
      "target": "Phone: Labda siku moja wewe mwenyewe utaelewa kila kitu na kukubaliana na tafsiri zetu za yanayotokea."
    },
    {
      "id": 110504457811337226,
      "target": "Phone: Furaha imo katika utulivu na kutokuwepo kwa mateso. Bila shaka nawe umepitia nyakati ngumu maishani."
    },
    {
      "id": 110504457811337225,
      "target": "Phone: Huenda hili likasikika ajabu kwako, lakini kuja kwa Kifo kunamaanisha furaha, si huzuni."
    },
    {
      "id": 110504457811337224,
      "target": "Phone: Kwa sababu tuna maoni yanayofanana kuhusu kitakachotokea baadaye: kuja kwa Kifo."
    },
    {
      "id": 110504457811337223,
      "target": "Phone: Kila la heri."
    },
    {
      "id": 110504457811337222,
      "target": "Phone: …"
    },
    {
      "id": 110504457811337221,
      "target": "Phone: Na kwamba kitaleta amani na utulivu, si mateso."
    },
    {
      "id": 110504457811337220,
      "target": "Phone: Tunaamini kwamba Kifo kitakuja katika ulimwengu wetu hivi karibuni."
    },
    {
      "id": 110504457811337219,
      "target": "Phone: Unaweza kuwaita utakavyo, lakini wao ni familia yangu."
    },
    {
      "id": 110504457811337218,
      "target": "Kama usemavyo"
    },
    {
      "id": 110504457811337217,
      "target": "Kwa nini hata ulijiunga na kundi hilo la ibada?"
    },
    {
      "id": 110504457811337216,
      "target": "Unafikiri kundi dogo la washupavu linakuelewa?"
    }
  ]
}
