    {
      "id": 110504456355913730,
      "target": "NotTrue: Halafu nitaweza hata kufumba macho kwa muda."
    },
    {
      "id": 110504456355913729,
      "target": "NotTrue: Utaniambia hadithi, nami nitakushirikisha zangu."
    },
    {
      "id": 110504456355913728,
      "target": "NotTrue: Angalau itakuwa burudani fulani kwa kikongwe kama mimi."
    },
    {
      "id": 110504456351719435,
      "target": "NotTrue: Kwako naweza angalau kupumua, kuzungumza na mtu."
    },
    {
      "id": 110504456351719434,
      "target": "NotTrue: Nimechoka kutembea."
    },
    {
      "id": 110504456351719433,
      "target": "NotTrue: Ni kama hunisikilizi, kijana wangu."
    },
    {
      "id": 110504456351719430,
      "target": "NotTrue: Sihitaji kingine. Kuwa peke yangu hunichosha na kunihuzunisha."
    },
    {
      "id": 110504456351719429,
      "target": "NotTrue: Na kutoa pumzi vizuri."
    },
    {
      "id": 110504456351719428,
      "target": "NotTrue: Kisha nijilaze, nifumbe macho kwa raha."
    },
    {
      "id": 110504456351719427,
      "target": "NotTrue: Makao, kusikiliza hadithi, na mimi pia kushirikisha mambo ya kuvutia."
    },
    {
      "id": 110504456351719426,
      "target": "NotTrue: Kama kila mtu mwingine."
    },
    {
      "id": 110504456351719425,
      "target": "Basi ungeendelea kutembea. Mbona umesimama?"
    },
    {
      "id": 110504456351719424,
      "target": "Sielewi, unahitaji kitu?"
    },
    {
      "id": 110504456347525131,
      "target": "NotTrue: Ndivyo ilivyo, kijana wangu."
    },
    {
      "id": 110504456347525130,
      "target": "NotTrue: Nami nimekuwa nikitembea na kucheza kwa muda mrefu kuliko wewe."
    },
    {
      "id": 110504456347525129,
      "target": "NotTrue: Umekuwa ukitembea kwa muda mrefu? Ndiyo, huenda muda mrefu."
    },
    {
      "id": 110504456347525128,
      "target": "NotTrue: Hata wewe. Labda unakaa tu nyumbani, lakini bado unatembea."
    },
    {
      "id": 110504456347525127,
      "target": "NotTrue: Ni muda gani, siwezi kusema. Na unajuaje kama ni mrefu?"
    },
    {
      "id": 110504456347525126,
      "target": "Basi ungeendelea kutembea. Mbona umesimama?"
    },
    {
      "id": 110504456347525125,
      "target": "Sielewi, unahitaji kitu?"
    },
    {
      "id": 110504456347525124,
      "target": "NotTrue: Labda ndivyo inavyopaswa kuwa."
    },
    {
      "id": 110504456347525123,
      "target": "NotTrue: Kwa kuwa nimefika hapa, basi miguu yangu imenileta hapa, macho yangu yamenileta."
    },
    {
      "id": 110504456347525122,
      "target": "NotTrue: Maisha yatatuunganisha na tunaopaswa kukutana nao, hatutamkosa yeyote."
    },
    {
      "id": 110504456347525121,
      "target": "NotTrue: Si hapa moja kwa moja, bila shaka, ha-ha."
    },
    {
      "id": 110504456347525120,
      "target": "Umetembea kwa muda mrefu?"
    },
    {
      "id": 110504456343330827,
      "target": "Ulikuwa unakuja hapa moja kwa moja?"
    },
    {
      "id": 110504456343330826,
      "target": "NotTrue: Naweza kupumzika kwako?"
    },
    {
      "id": 110504456343330825,
      "target": "NotTrue: Habari, kijana wangu! Nimechoka kidogo kutembea hadi hapa."
