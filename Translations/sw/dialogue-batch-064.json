  "entries": [
    {
      "id": 110504456569823239,
      "target": "Ballerina: Na usimteshe paka."
    },
    {
      "id": 110504456569823238,
      "target": "Ballerina: Si vyema kumwacha mwanamke agande barabarani, kijana."
    },
    {
      "id": 110504456569823234,
      "target": "Ballerina: Unafungua? Hapana?"
    },
    {
      "id": 110504456569823233,
      "target": "Ballerina: Nimefaulu majaribio yako yote?"
    },
    {
      "id": 110504456569823232,
      "target": "Ballerina: Hiyo haitoshi?"
    },
    {
      "id": 110504456565628939,
      "target": "Ballerina: Nina mikono miwili, miguu miwili na kichwa kimoja."
    },
    {
      "id": 110504456565628936,
      "target": "Ballerina: Haya, amua sasa, tufanye nini?"
    },
    {
      "id": 110504456565628935,
      "target": "Ballerina: Mimi ni mcheza baleti."
    },
    {
      "id": 110504456565628934,
      "target": "Ballerina: Labda nitacheza pia."
    },
    {
      "id": 110504456565628933,
      "target": "Ballerina: Nikuchezee?"
    },
    {
      "id": 110504456565628932,
      "target": "Ballerina: Halafu?"
    },
    {
      "id": 110504456565628931,
      "target": "Thibitisha kwamba wewe ni binadamu"
    },
    {
      "id": 110504456565628930,
      "target": "Siamini kwamba wewe ni binadamu"
    },
    {
      "id": 110504456565628929,
      "target": "Ballerina: Kauli ya ajabu."
    },
    {
      "id": 110504456565628928,
      "target": "Ballerina: Halafu? Nimekukumbusha yeye? Au nini?"
    },
    {
      "id": 110504456561434635,
      "target": "Ballerina: Naam… sawa."
    },
    {
      "id": 110504456561434634,
      "target": "Thibitisha kwamba wewe ni binadamu"
    },
    {
      "id": 110504456561434633,
      "target": "Siamini kwamba wewe ni binadamu"
    },
    {
      "id": 110504456561434632,
      "target": "Ballerina: Heh."
    },
    {
      "id": 110504456561434630,
      "target": "Ballerina: Sijui. Kuna tofauti gani?"
    },
    {
      "id": 110504456561434629,
      "target": "Unanikumbusha mtu fulani… binadamu"
    },
    {
      "id": 110504456561434628,
      "target": "Kuna mtu aliyekutuma hapa?"
    },
    {
      "id": 110504456561434627,
      "target": "Ballerina: Kwako hakuna joto."
    },
    {
      "id": 110504456561434626,
      "target": "Ballerina: Niliiona nyumba yako, nikaja."
    },
    {
      "id": 110504456561434625,
      "target": "Ballerina: Unauona ule mji? Niliishi huko."
    },
    {
      "id": 110504456561434624,
      "target": "Unanikumbusha mtu fulani… binadamu"
    },
    {
      "id": 110504456557240330,
      "target": "Kuna mtu aliyekutuma hapa?"
    },
    {
      "id": 110504456557240329,
      "target": "Ballerina: Nilifanya baleti. Unaona?"
    },
    {
      "id": 110504456557240328,
      "target": "Ballerina: Ninacheza."
    },
    {
      "id": 110504456557240327,
      "target": "Uliipataje nyumba yangu?"
    },
    {
      "id": 110504456557240325,
      "target": "Ballerina: Niliambiwa nije hapa, basi nimekuja."
    },
    {
      "id": 110504456557240324,
      "target": "Ballerina: Unafungua mlango au la?"
    },
    {
      "id": 110504456557240322,
      "target": "Ballerina: Kreti ya bia. Kabati dogo. Paja la nyama. Sijui. Nipe chochote utakacho."
    },
    {
      "id": 110504456557240321,
      "target": "Uliipataje nyumba yangu?"
    },
    {
      "id": 110504456553046028,
      "target": "Ballerina: Hilo litakusaidiaje?"
    },
    {
      "id": 110504456553046027,
      "target": "Ballerina: Maswali mengi. Ndiyo, najua."
    },
    {
      "id": 110504456553046025,
      "target": "Unahitaji nini?"
    },
    {
      "id": 110504456553046024,
      "target": "Unamjua… mwanaume mwenye upara?"
    },
    {
      "id": 110504456553046023,
      "target": "Ballerina: Unafungua mlango?"
    },
    {
      "id": 110504456553046021,
      "target": "Ballerina: Habari."
    },
    {
      "id": 110504456553046020,
      "target": "Teacher: Ahidi kwamba ukiwakutana na watoto, utawatunza. Kwaheri."
    },
    {
      "id": 110504456553046019,
      "target": "Teacher: Sikulaumu. Lakini ahidi…"
    },
    {
      "id": 110504456553046018,
      "target": "Teacher: Inasikitisha kwamba hatuwezi kuwarudisha watoto wale."
    },
    {
      "id": 110504456553046017,
      "target": "Teacher: Asante kwa kunisikiliza na kunikaribisha ndani."
    },
    {
      "id": 110504456548851722,
      "target": "Teacher: Watu walichoma shule ya chekechea na kunilazimisha nitazame…"
    },
    {
      "id": 110504456548851720,
      "target": "Teacher: Walistahili nini kufanyiwa hivyo? Hawakuwa na kosa lolote…"
    },
    {
      "id": 110504456548851719,
      "target": "Teacher: Watu wamekuwa nini? Wakaamua kuwahukumu wenyewe watoto wadogo wasio na hatia?"
    },
    {
      "id": 110504456548851717,
      "target": "Teacher: Mtu fulani aligundua kwamba ninawalea watoto wenye dalili za Wageni."
    },
    {
      "id": 110504456548851716,
      "target": "Teacher: Kwa sababu ya… kwa sababu ya watu."
    },
    {
      "id": 110504456548851713,
      "target": "Teacher: Bado ninaona macho yale madogo ya watoto yaliyojaa hofu…"
    },
    {
      "id": 110504456544657420,
      "target": "Teacher: Walinilazimisha… kutazama walivyofunga milango, wakapigilia mbao madirishani na.. kuichoma shule ya chekechea…"
    },
    {
      "id": 110504456544657419,
      "target": "Teacher: Ni watu waliofanya hivyo… waliogopa kwamba watoto hao huenda walikuwa Wageni…"
    }
  ]
}
