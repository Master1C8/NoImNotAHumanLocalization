  "entries": [
    {
      "id": 110504453763833861,
      "target": "Jacob: Hawawezi kufa."
    },
    {
      "id": 110504453763833860,
      "target": "Jacob: Hawaonekani kwenye picha, hutenda usiku na…"
    },
    {
      "id": 110504453763833859,
      "target": "Jacob: Umewahi kusikia kuhusu vampaya?"
    },
    {
      "id": 110504453763833857,
      "target": "Jacob: Mungu apishe mbali, usimwonyeshe hili mtu yeyote wa KHD."
    },
    {
      "id": 110504453759639560,
      "target": "Jacob: Haya, yatazame upendezwe."
    },
    {
      "id": 110504453759639558,
      "target": "Jacob: Unataka nikuonyeshe kitu kingine?"
    },
    {
      "id": 110504453759639555,
      "target": "Jacob: Ni vigumu kulala binti yako akipotea."
    },
    {
      "id": 110504453759639553,
      "target": "Jacob: Sijalala siku hizi zote."
    },
    {
      "id": 110504453755445258,
      "target": "Jacob: Samahani, hivi karibuni imenibidi kuchakura kwenye uchafu mara nyingi."
    },
    {
      "id": 110504453755445256,
      "target": "Jacob: Mikono? Kweli?"
    },
    {
      "id": 110504453755445253,
      "target": "Jacob: Kwa bahati yangu."
    },
    {
      "id": 110504453755445252,
      "target": "Jacob: Kwa wiki kadhaa zilizopita sikuweza kusafisha meno."
    },
    {
      "id": 110504453755445250,
      "target": "Jacob: Sawa."
    },
    {
      "id": 110504453751250950,
      "target": "Jacob: Nilijua ungesema hivyo."
    },
    {
      "id": 110504453751250949,
      "target": "Sirin: Niko tayari..."
    },
    {
      "id": 110504453751250948,
      "target": "Sirin: Nitaishije... bila yeye..."
    },
    {
      "id": 110504453751250947,
      "target": "Sirin: Kifo kimemchukua dada yangu..."
    },
    {
      "id": 110504453751250946,
      "target": "Alkonost: Nipige risasi tu."
    },
    {
      "id": 110504453751250945,
      "target": "Alkonost: Kuna maana gani sasa ya kufanya chochote... au kujitahidi..."
    },
    {
      "id": 110504453747056650,
      "target": "Alkonost: Dada yangu... Kwa nini?"
    },
    {
      "id": 110504453747056649,
      "target": "Anger: Hilo linanikwaza sana. Lakini huwa naligundua nimechelewa mno."
    },
    {
      "id": 110504453747056648,
      "target": "Anger: Wakati mwingine ninakaza taya hadi nasikia mlio wa kukatika."
    },
    {
      "id": 110504453747056646,
      "target": "Taarifa ile ilikuwa ya nini hasa?"
    },
    {
      "id": 110504453747056644,
      "target": "Masikio yako sawa."
    },
    {
      "id": 110504453747056641,
      "target": "Nahitaji kunawa uso. Natumaini itasaidia."
    },
    {
      "id": 110504453742862345,
      "target": "Inaonekana kama mwasho au, baya zaidi, fangasi."
    },
    {
      "id": 110504453742862344,
      "target": "Laana, hiki ni kitu gani cha ajabu!?"
    },
    {
      "id": 110504453742862343,
      "target": "Kama inavyopaswa kuwa."
    },
    {
      "id": 110504453742862342,
      "target": "Makwapa yana nywele."
    },
    {
      "id": 110504453742862339,
      "target": "Si mekundu, kwa hiyo hakuna la kutia shaka."
    },
    {
      "id": 110504453742862338,
      "target": "Macho ni ya kawaida."
    },
    {
      "id": 110504453742862337,
      "target": "Sikupaswa kunywa kile kinywaji chenye kafeini."
    },
    {
      "id": 110504453742862336,
      "target": "Laana. Ni mekundu…"
    },
    {
      "id": 110504453591867396,
      "target": "Kuna mabaki ya baruti kwenye alama za vidole. Lakini si jambo kubwa."
    },
    {
      "id": 110504453591867395,
      "target": "Mikono safi…"
    },
    {
      "id": 110504453591867394,
      "target": "Yote ni kwa sababu ya pango ninalochimba."
    },
    {
      "id": 110504453591867393,
      "target": "Kucha chafu…"
    },
    {
      "id": 110504453587673094,
      "target": "Ni afadhali hivyo. Hawatanichukulia kuwa Mgeni."
    },
    {
      "id": 110504453587673093,
      "target": "Meno ya manjano…"
    },
    {
      "id": 110504453587673092,
      "target": "Wavuta sigara wangeuza figo kwa meno kama haya."
    },
    {
      "id": 110504453587673091,
      "target": "Laana, ni meupe…"
    },
    {
      "id": 110504453587673088,
      "target": "Kunawa uso"
    },
    {
      "id": 110504453583478786,
      "target": "Nahitaji kujichunguza."
    },
    {
      "id": 110504453583478784,
      "target": "Mama yangu..."
    },
    {
      "id": 110504453579284487,
      "target": "Daughter: Baba yangu..."
    },
    {
      "id": 110504453579284486,
      "target": "Daughter: Ningependa kumtembelea rafiki yangu baba akija kunichukua..."
    },
    {
      "id": 110504453579284485,
      "target": "Daughter: Baba yangu pia hunikataza mambo, lakini si kila kitu!"
    },
    {
      "id": 110504453579284484,
      "target": "Daughter: Labda mama yake ni Mgeni?"
    },
    {
      "id": 110504453579284483,
      "target": "Daughter: Humkataza mambo mengi."
    },
    {
      "id": 110504453579284482,
      "target": "Daughter: Maisha yake nyumbani ni magumu tu. Mama yake ni mkali sana."
    },
    {
      "id": 110504453579284481,
      "target": "Daughter: Lakini yeye kwa kweli ni mzuri."
    },
    {
      "id": 110504453579284480,
      "target": "Daughter: Halafu ghafla, pap! Anafanya kitendo kibaya!"
    },
    {
      "id": 110504453575090183,
      "target": "Daughter: Tunacheza pamoja, tunacheza."
    },
    {
      "id": 110504453575090180,
      "target": "Daughter: Wakati mwingine unafanana kabisa na rafiki yangu mkubwa..."
    },
    {
      "id": 110504453575090179,
      "target": "Daughter: Unataka kuniumiza?"
    },
    {
      "id": 110504453575090178,
      "target": "Daughter: Nitawaambia kuhusu hili pia!"
    },
    {
      "id": 110504453575090177,
      "target": "Daughter: Lo..."
    },
    {
      "id": 110504453570895879,
      "target": "Daughter: Sikumbukiii..."
    },
    {
      "id": 110504453570895878,
      "target": "Daughter: Au niliota tu?.."
    },
    {
      "id": 110504453570895876,
      "target": "Daughter: Baba aliogopa, kisha wakakumbatiana."
    },
    {
      "id": 110504453570895875,
      "target": "Daughter: Alikuwa na nywele ndefu na koti refu."
    },
    {
      "id": 110504453570895874,
      "target": "Daughter: Siku moja mahali fulani, bwana mmoja alituelekezea silaha mimi na baba."
    },
    {
      "id": 110504453570895873,
      "target": "Daughter: Siku moja mimi na baba tulienda sokoni."
    },
    {
      "id": 110504453570895872,
      "target": "Daughter: Lo, sasa nimekumbuka!"
    },
    {
      "id": 110504453566701575,
      "target": "Daughter: Labda hapana."
    },
    {
      "id": 110504453566701572,
      "target": "Daughter: Kwani una bunduki kama ile?"
    },
    {
      "id": 110504453566701571,
      "target": "Daughter: Kwenye katuni mbwa alikuwa na bunduki iliyobofya, na picha zikatokea!"
    },
    {
      "id": 110504453566701570,
      "target": "Daughter: Lo, nimekumbuka katuni niliyoiona!"
    },
    {
      "id": 110504453562507270,
      "target": "Daughter: Natumaini atarudi sasa pia. Amepotea tu mahali fulani. Ndiyo..."
    },
    {
      "id": 110504453562507269,
      "target": "Daughter: Lakini baadaye baba alipatikana."
    },
    {
      "id": 110504453562507268,
      "target": "Daughter: Hata sikujua njia ya kurudi nyumbani, tulikuwa mbali sana!"
    },
    {
      "id": 110504453562507267,
      "target": "Daughter: Niliogopa kwamba ningekufa bila yeye!"
    },
    {
      "id": 110504453562507266,
      "target": "Daughter: Lakini wakati ule baba alipotea, akaenda mahali fulani."
    },
    {
      "id": 110504453562507265,
      "target": "Daughter: Nilipanda slaidi hiyo mara nyingi sana hata nilikuwa tayari kunywa bahari nzima. Hapana, bahari kuu nzima!"
    },
    {
      "id": 110504453562507264,
      "target": "Daughter: Wala sikuogopa hata kidogo! Kabisa! Ilikuwa ya kufurahisha!"
    },
    {
      "id": 110504453558312968,
      "target": "Daughter: Sikuwa nimewahi kuona kitu kama hicho!"
    },
    {
      "id": 110504453558312967,
      "target": "Daughter: Kulikuwa na slaidi kubwa sa-a-ana!"
    },
    {
      "id": 110504453558312966,
      "target": "Daughter: Siku moja nilikuwa kwenye uwanja wa michezo wa mbali kabisa!"
    },
    {
      "id": 110504453558312962,
      "target": "Daughter: Ninaku-u-u-u-fa!!!"
    },
    {
      "id": 110504453558312961,
      "target": "Daughter: Tafadha-a-a-a-li!!!"
    }
  ]
}
