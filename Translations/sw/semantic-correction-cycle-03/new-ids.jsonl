{"sourceIndex":16261,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451758956548","collection":"Dialogs","key":"line:Wheelchair_Armpit_025b696","nodeNames":["Wheelchair_Armpit"],"source":"Wheelchair: АААААХАХАХАХА.","target":"Wheelchair: AAAAAHAHAHAHA.","previousTarget":"Wheelchair: AAAAAHAHAHAHA.","authoredPath":"Translations/sw/dialogue-batch-181.json"}
{"sourceIndex":16264,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451758956545","collection":"Dialogs","key":"line:Wheelchair_Armpit_0a054d8","nodeNames":["Wheelchair_Armpit"],"source":"Wheelchair: За окном происходит ад, космос хочет размазать всю планету.","target":"Wheelchair: Kuzimu iko nje ya dirisha, anga linataka kuisambaratisha dunia nzima.","previousTarget":"Wheelchair: Kuzimu iko nje ya dirisha, anga linataka kuisambaratisha dunia nzima.","authoredPath":"Translations/sw/dialogue-batch-181.json"}
