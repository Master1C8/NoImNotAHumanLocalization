{"sourceIndex":16095,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451826065412","collection":"Dialogs","key":"line:Anger_Armpit_064e394","nodeNames":["Anger_Armpit"],"source":"Отпустить","target":"Mwache","previousTarget":"Mwache","authoredPath":"Translations/sw/dialogue-batch-001.json"}
