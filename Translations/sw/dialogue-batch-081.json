  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504456104255491,
      "target": "Hamtaweza kuishi katika nguvu za kichaa za Ulimwengu."
    },
    {
      "id": 110504456104255490,
      "target": "Kama watu walivyotaka."
    },
    {
      "id": 110504456104255489,
      "target": "Nitawapa utulivu."
    },
    {
      "id": 110504456104255488,
      "target": "Nitawarudisha mahali mlipopaswa kuwa tangu mwanzo."
    },
    {
      "id": 110504456100061195,
      "target": "Nitawaficha."
    },
    {
      "id": 110504456100061194,
      "target": "Sasa ninahitaji kuingilia kati."
    },
    {
      "id": 110504456100061193,
      "target": "Unahisi? Ni yeye."
    },
    {
      "id": 110504456100061192,
      "target": "Labda hata Kifo chenyewe kitashuka kwetu na..."
    },
    {
      "id": 110504456100061191,
      "target": "Hakuna atakayeondoka akiwa na huzuni."
    },
    {
      "id": 110504456100061190,
      "target": "Wote watapata utulivu."
    },
    {
      "id": 110504456100061189,
      "target": "Sasa tunafanya kila kitu kwa usahihi."
    },
    {
      "id": 110504456100061188,
      "target": "Mtazamo wa zamani kuhusu Kifo ulituzuia kufa ipasavyo."
    },
    {
      "id": 110504456100061187,
      "target": "Nafurahi umejiunga nasi. Kifo hakikukuchagua bure."
    },
    {
      "id": 110504456100061186,
      "target": "Ni vigumu sana kuikazia macho."
    },
    {
      "id": 110504456100061185,
      "target": "Nyumba ndogo ya upweke inakujia machoni."
    },
    {
      "id": 110504456100061184,
      "target": "Macho yako yanatiwa giza."
    },
    {
      "id": 110504456095866891,
      "target": "Unararuliwa vipande vipande."
    },
    {
      "id": 110504456095866890,
      "target": "Hofu imekupofusha."
    },
    {
      "id": 110504456095866889,
      "target": "Hata hufikirii kujinusuru."
    },
    {
      "id": 110504456095866888,
      "target": "Hofu ya kufa imekugandisha."
    },
    {
      "id": 110504456095866887,
      "target": "Unahisi macho ya wengine yakikutazama."
    },
    {
      "id": 110504456095866886,
      "target": "Watu hawaaminiani."
    },
    {
      "id": 110504456095866885,
      "target": "Wanasayansi wanatabiri kwamba baada ya siku kadhaa..."
    },
    {
      "id": 110504456095866884,
      "target": "«Nishati ya jua inapungua taratibu."
    },
    {
      "id": 110504456095866883,
      "target": "KILA MMOJA."
    },
    {
      "id": 110504456095866882,
      "target": "Kila mhuni mwenye silaha mikononi atakufa leo."
    },
    {
      "id": 110504456095866881,
      "target": "Nitafunika KILA KITU kwa damu yenu."
    },
    {
      "id": 110504456095866880,
      "target": "Nitawasukuma ndani kabisa ya ardhi."
    },
    {
      "id": 110504456091672587,
      "target": "Vichwa vilivyolaaniwa kwa wazimu."
    },
    {
      "id": 110504456091672586,
      "target": "Nitawaponda!"
    },
    {
      "id": 110504456091672585,
      "target": "Unafikiri hakuna atakayejitetea?"
    },
    {
      "id": 110504456091672584,
      "target": "Na watu kama wewe hawatamwacha yeyote kwa amani."
    },
    {
      "id": 110504456091672583,
      "target": "Watu kama wewe walimuua rafiki yangu."
    },
    {
      "id": 110504456091672582,
      "target": "Kwa sababu ya wahuni kama wewe, watu wengi wamekufa."
    },
    {
      "id": 110504456091672581,
      "target": "Ametulia. Lazima niangalie."
    },
    {
      "id": 110504456091672580,
      "target": "Alinifuata mimi kwa sababu sijiruhusu kunyanyaswa. Na wengine je?"
    },
    {
      "id": 110504456091672579,
      "target": "Mnyama huyu. Amenijeruhi."
    },
    {
      "id": 110504456091672578,
      "target": "Nasikia anavyopumua kwa shida."
    },
    {
      "id": 110504456091672577,
      "target": "Hasira iliyojaa machoni mwa mtu mwenye silaha inatisha zaidi kuliko Mgeni."
    },
    {
      "id": 110504456091672576,
      "target": "Lakini unasubiri tu ukitumaini hakuna kitakachotokea."
    },
    {
      "id": 110504456087478283,
      "target": "Unamsikia mwendawazimu akiyafoka maneno kwa ukali nyuma ya mlango."
    },
    {
      "id": 110504456087478282,
      "target": "Unajuta tu kwamba hukulichukua bango pamoja nawe."
    },
    {
      "id": 110504456087478281,
      "target": "Kutokana na maelekezo ya kazi, ni wazi huwezi kuvumilia hivyo kwa muda mrefu."
    },
    {
      "id": 110504456087478280,
      "target": "Unahisi kwamba hutaweza kurudi kwenye maisha ya zamani."
    },
    {
      "id": 110504456087478279,
      "target": "Hujui pia kilichowapata wale walioishi nawe."
    },
    {
      "id": 110504456087478278,
      "target": "Na baada ya hapo?"
    },
    {
      "id": 110504456087478277,
      "target": "Itatubidi kuwapeleka watu kwenye maeneo ya karantini?"
    },
    {
      "id": 110504456087478276,
      "target": "Je, wafanyakazi wanaondoka kazini kwa wingi hivyo? Kwa nini wanaajiri watu… kwa nguvu kiasi hicho?"
    },
    {
      "id": 110504456087478275,
      "target": "Kwa kweli, ni ajabu kuwachukua watu na kuwaajiri papo hapo."
    },
    {
      "id": 110504456087478274,
      "target": "Kazi hii ni hatari kwa kiasi gani?"
    },
    {
      "id": 110504456087478273,
      "target": "Kuna kazi nyingi huko. Labda zamu za kazi ni za kukaa kwa muda."
    },
    {
      "id": 110504456087478272,
      "target": "Hilo ni shirika kubwa. Labda utahitaji kuzungumza na watu wengi."
    },
    {
      "id": 110504456083283979,
      "target": "Umechanganyikiwa. Hivi KHD wanaajiri watu ghafla namna hii?"
    },
    {
      "id": 110504456083283978,
      "target": "Gasmask: Tunakusubiri."
    },
    {
      "id": 110504456083283977,
      "target": "Gasmask: Hutakuwa na sababu ya kurudi hapa. Angalau si hivi karibuni."
    },
    {
      "id": 110504456083283976,
      "target": "Gasmask: Vizuri. Chukua vitu muhimu zaidi, utapewa makao."
    },
    {
      "id": 110504456083283975,
      "target": "Gasmask: Chagua."
    },
    {
      "id": 110504456083283974,
      "target": "Gasmask: Kusanya vitu vyako, la sivyo tutakuburuta kwenye gari sisi wenyewe."
    },
    {
      "id": 110504456083283973,
      "target": "Gasmask: Lakini hatukukuuliza maoni yako."
    },
    {
      "id": 110504456083283972,
      "target": "Niko tayari"
    },
    {
      "id": 110504456083283971,
      "target": "Hilo halinivutii"
    },
    {
      "id": 110504456083283970,
      "target": "Gasmask: Hasa sasa tunahitaji watu wapya."
    },
    {
      "id": 110504456083283969,
      "target": "Gasmask: Ni vizuri sana: watu wapya kwenye shirika hutusaidia kuona mambo tunayoweza kuyakosa sisi wenyewe."
    },
    {
      "id": 110504456083283968,
      "target": "Gasmask: Una ari ya kuanzisha mambo na kuchukua hatua."
    },
    {
      "id": 110504456079089675,
      "target": "Niko tayari"
    },
    {
      "id": 110504456079089674,
      "target": "Hilo halinivutii"
    },
    {
      "id": 110504456079089673,
      "target": "Gasmask: Jiandae, tunakuondoa hapa sasa hivi."
    },
    {
      "id": 110504456079089672,
      "target": "Gasmask: Tunaelewa, lakini hakuna haja ya kuwa na wasiwasi. Utalipwa vizuri na utapata marupurupu, bila shaka."
    },
    {
      "id": 110504456079089671,
      "target": "Mnanihitaji kwa nini hasa?"
    },
    {
      "id": 110504456079089670,
      "target": "Hili limenishangaza"
    },
    {
      "id": 110504456079089669,
      "target": "Gasmask: Tunawahitaji sana watu kama wewe."
    },
    {
      "id": 110504456079089668,
      "target": "Gasmask: Mchango wako katika kuendeleza mapambano dhidi ya hali za dharura umeonekana."
    },
    {
      "id": 110504456079089667,
      "target": "Gasmask: Habari."
    },
    {
      "id": 110504456079089666,
      "target": "Jambo baya sana litatokea mjini."
    },
    {
      "id": 110504456079089665,
      "target": "Unaona misumari iking’aa mikononi mwa mtu fulani kwenye umati."
    },
    {
      "id": 110504456079089664,
      "target": "Haijulikani watakufanyia nini."
    },
    {
      "id": 110504456074895371,
      "target": "Anazungumzia nini hasa?"
    },
    {
      "id": 110504456074895370,
      "target": "Nawe utatusaidia kuokoa… kila kitu!"
    },
    {
      "id": 110504456074895369,
      "target": "Hapa patakuwa peponi kweli."
    },
    {
      "id": 110504456074895368,
      "target": "Hakuna aliye tayari kwa hilo."
    }
  ]
}
