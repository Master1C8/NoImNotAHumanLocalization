  "entries": [
    {
      "id": 110504456045535241,
      "target": "Kwa mfano, tulimfunika Olun. Sasa hilo ndilo jina lake."
    },
    {
      "id": 110504456045535240,
      "target": "Tunawapa majina waliokufa. Hivyo tutajua kwamba hawakufa bure; watachukuliwa kama sisi tutakavyochukuliwa."
    },
    {
      "id": 110504456045535238,
      "target": "Tunapaswa kumaliza mambo ya mwisho kwa wakati, kisha tungoje."
    },
    {
      "id": 110504456045535237,
      "target": "Leo tutaokolewa."
    },
    {
      "id": 110504456045535236,
      "target": "Hakuna tena cha kuhofia. Watu wangu watahakikisha hakuna mateso tena. Kwa yeyote."
    },
    {
      "id": 110504456045535234,
      "target": "Ninahisi hakuna atakayeshambulia tena. Sasa ni wakati mwingine."
    },
    {
      "id": 110504456045535233,
      "target": "Umegundua kwamba mchana nje hakung’ai sana tena?"
    },
    {
      "id": 110504456045535232,
      "target": "Wewe, eeh... umebakiza Kombucha?"
    },
    {
      "id": 110504456041340939,
      "target": "Basi… sawa."
    },
    {
      "id": 110504456041340938,
      "target": "Aah, tumechelewa, rafiki yangu."
    },
    {
      "id": 110504456041340937,
      "target": "Moja kwa moja chini ya ardhi."
    },
    {
      "id": 110504456041340936,
      "target": "Lazima tuizuie Miseliamu kabla uyoga haujakua na kuenea kabisa!"
    },
    {
      "id": 110504456041340935,
      "target": "Nchi ya Uyoga iko mahali fulani huko!"
    },
    {
      "id": 110504456041340934,
      "target": "Lakini inaonekana Miseliamu imeingiwa na wazimu kwa hasira yote iliyojikusanya ndani yake."
    },
    {
      "id": 110504456041340933,
      "target": "Mbegu za tufaha zilipaswa kuikumbusha uhusiano wa watu na uyoga."
    },
    {
      "id": 110504456041340932,
      "target": "Tambiko letu lilipaswa kuirudisha Miseliamu katika akili zake."
    },
    {
      "id": 110504456041340931,
      "target": "Sasa Miseliamu inahitaji kuitoa hasira hiyo mahali fulani..."
    },
    {
      "id": 110504456041340930,
      "target": "Na hakuna kitakachobaki."
    },
    {
      "id": 110504456041340929,
      "target": "Ndivyo mafungu ya hasira yanavyozidi ndani ya Miseliamu."
    },
    {
      "id": 110504456041340928,
      "target": "Inatisha kufikiria kitakachowapata baada ya usiku wa manane..."
    },
    {
      "id": 110504456037146635,
      "target": "Kwa kasi ya kila saa, si ya kila siku."
    },
    {
      "id": 110504456037146634,
      "target": "Uyoga ni viumbe wa ajabu!.."
    },
    {
      "id": 110504456037146633,
      "target": "Nitalala kidogo."
    },
    {
      "id": 110504456037146632,
      "target": "Nimechoka kwa namna fulani."
    },
    {
      "id": 110504456037146630,
      "target": "Laiti ningekutana nao tena wote kama familia."
    },
    {
      "id": 110504456037146629,
      "target": "Kuna mtu atakayekuja kwangu?"
    },
    {
      "id": 110504456037146628,
      "target": "Kwa nini waliniingiza humu?"
    },
    {
      "id": 110504456037146627,
      "target": "Najiuliza hiki kilikuwa nini hasa?"
    },
    {
      "id": 110504456037146626,
      "target": "Laiti hali hii iendelee kwa muda mrefu zaidi…"
    },
    {
      "id": 110504456037146625,
      "target": "Lakini hata mimi sina nia hiyo."
    },
    {
      "id": 110504456037146624,
      "target": "Sijui jinsi ya kutoka."
    },
    {
      "id": 110504456032952331,
      "target": "Sikumbuki nilivyofika hapa."
    },
    {
      "id": 110504456032952330,
      "target": "Hakuna anayenisumbua. Hakuna anayenigusa."
    },
    {
      "id": 110504456032952329,
      "target": "Lakini… sasa ninahisi utulivu."
    },
    {
      "id": 110504456032952328,
      "target": "Sijui nimekaa hapa kwa muda gani."
    },
    {
      "id": 110504456032952327,
      "target": "Hapa mchana na usiku havibadiliki."
    },
    {
      "id": 110504456032952324,
      "target": "Ninaogopa"
    },
    {
      "id": 110504456032952323,
      "target": "Kuna mtu hapa?"
    },
    {
      "id": 110504456032952321,
      "target": "Ninaogopa"
    },
    {
      "id": 110504456032952320,
      "target": "Kuna mtu hapa?"
    },
    {
      "id": 110504456028758025,
      "target": "Naweza kutazama filamu?"
    },
    {
      "id": 110504456028758024,
      "target": "Kuna mtu mwingine atakayekuja hapa?"
    },
    {
      "id": 110504456028758022,
      "target": "Naweza kutazama filamu?"
    },
    {
      "id": 110504456028758021,
      "target": "Kuna mtu mwingine atakayekuja hapa?"
    },
    {
      "id": 110504456028758019,
      "target": "Nitakuwa hapa milele?"
    },
    {
      "id": 110504456028758018,
      "target": "Nimekufa?"
    },
    {
      "id": 110504456028758016,
      "target": "Furahia."
    },
    {
      "id": 110504456024563722,
      "target": "Zitaonekana kubwa, zenye vumbi na zilizojaa maafikiano."
    },
    {
      "id": 110504456024563721,
      "target": "Pamoja na barabara zake fupi ambazo baadaye zitaonekana pana ajabu kwako."
    },
    {
      "id": 110504456024563720,
      "target": "Hapa ndipo mahali pako."
    },
    {
      "id": 110504456024563719,
      "target": "Hiki ndicho ulichotaka?"
    },
    {
      "id": 110504456024563718,
      "target": "Nitakupeleka usiku ambako msonobari unafika hadi kwenye nyota."
    },
    {
      "id": 110504456024563717,
      "target": "Ninaelewa kwamba uko tayari."
    },
    {
      "id": 110504456024563716,
      "target": "Vizuri kwamba sasa hakuna anayebaki gizani: si mtu aliyevaa mavazi ya kuigiza wala kitu kingine. Ni kivuli tu kwenye tofali langu."
    },
    {
      "id": 110504456024563715,
      "target": "Huna haja ya kuogopa. Wakati umeumbwa na mimi. Hapa hakuna cha kukuogopesha."
    },
    {
      "id": 110504456024563714,
      "target": "Kwenye nchi zenye huzuni, ambazo maandishi yake ya mwanzo ni vioo vinavyozalisha hisia ya wingi."
    },
    {
      "id": 110504456024563713,
      "target": "Huko ndiko unakopaswa kwenda."
    },
    {
      "id": 110504456024563712,
      "target": "Umechoka."
    },
    {
      "id": 110504456020369419,
      "target": "Hapana, hutaki kwenda kwao."
    },
    {
      "id": 110504456020369418,
      "target": "Kwa wale ambao macho yao yaliacha kovu moyoni?"
    },
    {
      "id": 110504456020369417,
      "target": "Unataka kwenda wapi?"
    },
    {
      "id": 110504456020369416,
      "target": "Ufalme mdogo namna hii umemeza usingizi mwingi sana."
    },
    {
      "id": 110504456020369415,
      "target": "Bila shaka."
    },
    {
      "id": 110504456020369414,
      "target": "Ninaogopa kuendelea"
    },
    {
      "id": 110504456020369413,
      "target": "Hapa… kuna mahali pa kwenda mbele?"
    },
    {
      "id": 110504456020369412,
      "target": "Mimi ni ndugu wa kiume asiyetambuliwa, mtengwa katika familia ya watu."
    },
    {
      "id": 110504456020369411,
      "target": "Mimi na wewe tunafanana kwa namna fulani."
    },
    {
      "id": 110504456020369410,
      "target": "Labda mimi na wewe tumechoka na tukajilaza kulala."
    },
    {
      "id": 110504456020369409,
      "target": "Nini maana ya «kufa»?"
    },
    {
      "id": 110504456020369408,
      "target": "Nimekufa?"
    },
    {
      "id": 110504456016175115,
      "target": "Ninaogopa kuendelea"
    }
  ]
}
