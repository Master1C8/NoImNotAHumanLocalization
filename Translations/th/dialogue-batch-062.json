    {
      "id": 110504453788999687,
      "target": "ล้างหน้า"
    },
    {
      "id": 110504453788999684,
      "target": "ช่างแม่ง"
    },
    {
      "id": 110504453747056646,
      "target": "เมื่อกี้มันข่าวบ้าอะไร?"
    },
    {
      "id": 110504453747056644,
      "target": "หูปกติดี"
    },
    {
      "id": 110504453747056641,
      "target": "ต้องล้างหน้า หวังว่าจะช่วยได้"
    },
    {
      "id": 110504453742862345,
      "target": "ดูเหมือนผื่นระคายเคือง หรือแย่กว่านั้นก็เชื้อรา"
    },
    {
      "id": 110504453742862344,
      "target": "เชี่ย นี่มันอะไรวะ!?"
    },
    {
      "id": 110504453742862343,
      "target": "ก็เป็นอย่างที่ควร"
    },
    {
      "id": 110504453742862342,
      "target": "รักแร้มีขน"
    },
    {
      "id": 110504453742862339,
      "target": "ไม่แดง งั้นก็ไม่มีอะไรให้แม่งจับผิด"
    },
    {
      "id": 110504453742862338,
      "target": "ตาก็เป็นตาปกติ"
    },
    {
      "id": 110504453742862337,
      "target": "ไม่น่าไปดื่มไอ้ของคาเฟอีนบ้านั่นเลย"
    },
    {
      "id": 110504453742862336,
      "target": "แม่งเอ๊ย ตาแดงแล้ว…"
    },
    {
      "id": 110504453591867396,
      "target": "มีคราบดินปืนตามรอยนิ้วมือ แต่เรื่องเล็ก"
    },
    {
      "id": 110504453591867395,
      "target": "มือสะอาด…"
    },
    {
      "id": 110504453591867394,
      "target": "ทั้งหมดเป็นเพราะถ้ำที่ฉันกำลังขุด"
    },
    {
      "id": 110504453591867393,
      "target": "เล็บสกปรก…"
    },
    {
      "id": 110504453587673094,
      "target": "ก็ดีแล้ว แบบนี้คงไม่มีใครคิดว่าฉันเป็นแขก"
    },
    {
      "id": 110504453587673093,
      "target": "ฟันเหลือง…"
    },
    {
      "id": 110504453587673092,
      "target": "คนสูบบุหรี่คงยอมขายไตเพื่อฟันแบบนี้"
    },
    {
      "id": 110504453587673091,
      "target": "บ้าจริง ขาว…"
    },
    {
      "id": 110504453587673088,
      "target": "ล้างหน้า"
    },
    {
      "id": 110504453583478786,
      "target": "ฉันต้องตรวจดูตัวเอง"
    }
  ]
