{"ordinal":14178,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452555874308","collection":"Dialogs","key":"line:Couple_Ears_0d90b24","source":"Couple: И как результаты?","target":"Couple: Și ce rezultate aveți?","batchPath":"Translations/ro/dialogue-batch-360.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
{"ordinal":14179,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452555874307","collection":"Dialogs","key":"line:Couple_Ears_0c00c3f","source":"Couple: ...","target":"Couple: ...","batchPath":"Translations/ro/dialogue-batch-360.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
{"ordinal":14180,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452555874306","collection":"Dialogs","key":"line:Couple_Ears_0c36835","source":"Couple: Но давайте покажу. Скрывать тут нечего.","target":"Couple: Dar haideți să vă arăt. N-am nimic de ascuns.","batchPath":"Translations/ro/dialogue-batch-360.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
{"ordinal":14181,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452555874305","collection":"Dialogs","key":"line:Couple_Ears_002d8ed","source":"Couple: Не очень понимаю, какое это отношение имеет к Гостям.","target":"Couple: Nu prea înțeleg ce legătură are asta cu Musafirii.","batchPath":"Translations/ro/dialogue-batch-360.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
