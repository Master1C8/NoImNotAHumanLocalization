{"ordinal":14124,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452572651528","collection":"Dialogs","key":"line:Couple_Death_0782013","source":"Couple: Почему вы…","target":"Couple: De ce dumneavoastră…","batchPath":"Translations/ro/dialogue-batch-360.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
