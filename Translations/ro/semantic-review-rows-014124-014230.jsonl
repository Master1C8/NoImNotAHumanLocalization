{"ordinal":14183,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452551680011","collection":"Dialogs","key":"line:Couple_Photo_0b4f6ba","source":"Отпустить","target":"Dă-i drumul","batchPath":"Translations/ro/dialogue-batch-001.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
{"ordinal":14184,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452551680010","collection":"Dialogs","key":"line:Couple_Photo_0b7a75b","source":"Couple: Я возьму фото?","target":"Couple: Pot să iau fotografia?","batchPath":"Translations/ro/dialogue-batch-361.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
