  "entries": [
    {
      "id": 110504453751250949,
      "target": "Sirin: Sunt pregătită…"
    },
    {
      "id": 110504453751250948,
      "target": "Sirin: Cum o să mă descurc… fără ea…"
    },
    {
      "id": 110504453751250947,
      "target": "Sirin: Moartea mi-a luat sora…"
    },
    {
      "id": 110504453751250946,
      "target": "Alkonost: Trage odată."
    },
    {
      "id": 110504453751250945,
      "target": "Alkonost: Ce rost mai are acum să fac ceva… sau să încerc…"
    },
    {
      "id": 110504453751250944,
      "target": "Alkonost: ..."
    },
    {
      "id": 110504453747056650,
      "target": "Alkonost: Sora mea… De ce?"
    },
    {
      "id": 110504453747056649,
      "target": "Anger: Mă stresează de-mi vine să urlu. Dar îmi dau seama prea târziu când fac căcatu’ ăsta."
    },
    {
      "id": 110504453747056648,
      "target": "Anger: Uneori îmi încleștez maxilarele atât de tare că aud cum trosnesc."
    },
    {
      "id": 110504453747056646,
      "target": "Ce fel de reportaj a mai fost și ăsta?"
    },
    {
      "id": 110504453747056644,
      "target": "Cu urechile e totul în regulă."
    },
    {
      "id": 110504453747056641,
      "target": "Trebuie să mă spăl. Sper să ajute."
    },
    {
      "id": 110504453742862345,
      "target": "Arată ca o iritație sau, mai rău, o micoză."
    },
    {
      "id": 110504453742862344,
      "target": "Futu-i, ce-i rahatul ăsta!?"
    },
    {
      "id": 110504453742862343,
      "target": "Așa cum ar trebui."
    },
    {
      "id": 110504453742862342,
      "target": "Axile păroase."
    },
    {
      "id": 110504453742862339,
      "target": "Nu sunt roșii, deci n-are nimeni de ce să se lege."
    },
    {
      "id": 110504453742862338,
      "target": "Ochi ca toți ochii."
    },
    {
      "id": 110504453742862337,
      "target": "N-ar fi trebuit să beau porcăria aia cu cofeină."
    },
    {
      "id": 110504453742862336,
      "target": "Fir-ar să fie. Sunt roșii…"
    },
    {
      "id": 110504453591867396,
      "target": "Sunt urme de praf de pușcă pe amprente. Dar e un fleac."
    },
    {
      "id": 110504453591867395,
      "target": "Mâini curate…"
    },
    {
      "id": 110504453591867394,
      "target": "Totul e din cauza peșterii pe care o sap."
    },
    {
      "id": 110504453591867393,
      "target": "Unghii murdare…"
    },
    {
      "id": 110504453587673094,
      "target": "Cu atât mai bine. Așa nu mă vor lua drept Musafir."
    },
    {
      "id": 110504453587673093,
      "target": "Dinți galbeni…"
    },
    {
      "id": 110504453587673092,
      "target": "Fumătorii și-ar vinde un rinichi pentru așa ceva."
    },
    {
      "id": 110504453587673091,
      "target": "La naiba, sunt albi…"
    },
    {
      "id": 110504453587673088,
      "target": "Spală-te"
    },
    {
      "id": 110504453583478786,
      "target": "Trebuie să mă examinez."
    }
  ]
}
