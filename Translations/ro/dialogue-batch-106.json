  "entries": [
    {
      "id": 110504456574017540,
      "target": "Ballerina: Un mic dar de la mine pentru tine."
    },
    {
      "id": 110504456574017539,
      "target": "Ballerina: O să găsești pisica sub casă."
    },
    {
      "id": 110504456574017538,
      "target": "Ballerina: …"
    },
    {
      "id": 110504456574017537,
      "target": "Ballerina: Hai, pisicuțule, o să mă ții de urât aici, da?"
    },
    {
      "id": 110504456574017536,
      "target": "Ballerina: Simte-te ca acasă."
    },
    {
      "id": 110504456569823243,
      "target": "Du-te dracului odată"
    },
    {
      "id": 110504456569823242,
      "target": "…Intră"
    },
    {
      "id": 110504456569823241,
      "target": "Ballerina: Mai gândește-te."
    },
    {
      "id": 110504456569823240,
      "target": "Ballerina: Vezi pisica?"
    },
    {
      "id": 110504456569823239,
      "target": "Ballerina: Și nu chinui pisica."
    },
    {
      "id": 110504456569823238,
      "target": "Ballerina: Nu-i frumos să lași o femeie să înghețe afară, tinere."
    },
    {
      "id": 110504456569823237,
      "target": "Ballerina: …"
    },
    {
      "id": 110504456569823234,
      "target": "Ballerina: Deschizi? Nu?"
    },
    {
      "id": 110504456569823233,
      "target": "Ballerina: Am trecut tot testul tău?"
    },
    {
      "id": 110504456569823232,
      "target": "Ballerina: Nu-i de ajuns?"
    },
    {
      "id": 110504456565628939,
      "target": "Ballerina: Am două mâini, două picioare, un cap."
    },
    {
      "id": 110504456565628936,
      "target": "Ballerina: Hai odată, hotărăște-te. Ce facem?"
    },
    {
      "id": 110504456565628935,
      "target": "Ballerina: Sunt un pantof de balet."
    },
    {
      "id": 110504456565628934,
      "target": "Ballerina: Poate chiar o să dansez."
    },
    {
      "id": 110504456565628933,
      "target": "Ballerina: Să dansez pentru tine?"
    },
    {
      "id": 110504456565628932,
      "target": "Ballerina: Și ce dacă?"
    },
    {
      "id": 110504456565628931,
      "target": "Dovedește că ești om"
    },
    {
      "id": 110504456565628930,
      "target": "Nu cred că ești om"
    },
    {
      "id": 110504456565628929,
      "target": "Ballerina: Ce vorbă ciudată."
    },
    {
      "id": 110504456565628928,
      "target": "Ballerina: Ce urmează? Ți-am amintit de el? Sau ce?"
    },
    {
      "id": 110504456561434635,
      "target": "Ballerina: Păi… bine."
    },
    {
      "id": 110504456561434634,
      "target": "Dovedește că ești om"
    },
    {
      "id": 110504456561434633,
      "target": "Nu cred că ești om"
    },
    {
      "id": 110504456561434632,
      "target": "Ballerina: Heh."
    },
    {
      "id": 110504456561434631,
      "target": "Ballerina: …"
    },
    {
      "id": 110504456561434630,
      "target": "Ballerina: Nu știu. Ce importanță are?"
    },
    {
      "id": 110504456561434629,
      "target": "Îmi amintești de un… om"
    },
    {
      "id": 110504456561434628,
      "target": "Te-a trimis cineva aici?"
    },
    {
      "id": 110504456561434627,
      "target": "Ballerina: La tine nu e cald."
    },
    {
      "id": 110504456561434626,
      "target": "Ballerina: Ți-am văzut casa și am venit."
    },
    {
      "id": 110504456561434625,
      "target": "Ballerina: Vezi orașul? Am locuit acolo."
    },
    {
      "id": 110504456561434624,
      "target": "Îmi amintești de un… om"
    },
    {
      "id": 110504456557240330,
      "target": "Te-a trimis cineva aici?"
    },
    {
      "id": 110504456557240329,
      "target": "Ballerina: Am făcut balet. Se vede?"
    },
    {
      "id": 110504456557240328,
      "target": "Ballerina: Dansez."
    },
    {
      "id": 110504456557240327,
      "target": "Cum mi-ai găsit casa?"
    },
    {
      "id": 110504456557240325,
      "target": "Ballerina: Mi-au spus să vin aici, așa că am venit."
    },
    {
      "id": 110504456557240324,
      "target": "Ballerina: Deschizi ușa sau nu?"
    },
    {
      "id": 110504456557240323,
      "target": "Ballerina: …"
    },
    {
      "id": 110504456557240322,
      "target": "Ballerina: O ladă de bere. O noptieră. Șuncă. Nu știu. Dă-mi ce vrei."
    },
    {
      "id": 110504456557240321,
      "target": "Cum mi-ai găsit casa?"
    }
  ]
}
