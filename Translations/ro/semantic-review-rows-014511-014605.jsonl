{"ordinal":14588,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452396490763","collection":"Dialogs","key":"line:Blind_Hands_0db0eea","source":"Blind: Но тогда… Тогда…","target":"Blind: Am început să înfulec, să urlu, să vomit, să mă sfâșii în bucăți.","batchPath":"Translations/ro/dialogue-batch-369.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
