{"ordinal":10303,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454380396553","collection":"Dialogs","key":"line:Esenin_Asking_4_05fe92c","source":"Не знаю, в космосе окажемся","target":"Nu știu, vom ajunge în spațiu","batchPath":"Translations/ro/dialogue-batch-262.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
{"ordinal":10304,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454380396552","collection":"Dialogs","key":"line:Esenin_Asking_4_03fd8ba","source":"Ничего","target":"Nimic","batchPath":"Translations/ro/dialogue-batch-262.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
{"ordinal":10305,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454380396551","collection":"Dialogs","key":"line:Esenin_Asking_4_09159f6","source":"Во что верю, то и будет","target":"Se va întâmpla ce cred eu","batchPath":"Translations/ro/dialogue-batch-262.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
