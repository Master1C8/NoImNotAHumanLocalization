{"ordinal":10276,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454388785163","collection":"Dialogs","key":"line:Esenin_Asking_5_008f83e","source":"Esenin: Зачем я сюда пришёл?..","target":"Esenin: De ce am venit aici?..","batchPath":"Translations/ro/dialogue-batch-262.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
