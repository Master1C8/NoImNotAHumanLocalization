  "sourceInventorySha256": "ecd96645c2ca6f23f8bf3ab2fcf65709e961478ae15a38e83d94cc335a408bf0",
  "glossaryFingerprint": "c67cc629aa173a6710090c12cb5ccfea5adb0bbeb0136fc5df06039196b499c9",
  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504454455894021,
      "target": "Widow: Sper să găsiți ceea ce căutați."
    },
    {
      "id": 110504454455894020,
      "target": "Widow: Nu vorbiți mult, dar… ați fost un bun interlocutor."
    },
    {
      "id": 110504454455894019,
      "target": "Widow: Vă mulțumesc."
    },
    {
      "id": 110504454455894018,
      "target": "Widow: Până nu mă întorc, nu vreau să hotărăsc nimic."
    },
    {
      "id": 110504454455894017,
      "target": "Widow: Vreau foarte mult să merg acasă."
    },
    {
      "id": 110504454455894016,
      "target": "Widow: Față de tine nu simt nimic, iartă-mă."
    },
    {
      "id": 110504454451699715,
      "target": "Widow: Nu mă voi simți mai bine."
    },
    {
      "id": 110504454451699714,
      "target": "Widow: De ce?"
    },
    {
      "id": 110504454451699713,
      "target": "Noroc"
    },
    {
      "id": 110504454451699712,
      "target": "Poți să rămâi"
    },
    {
      "id": 110504454447505416,
      "target": "Widow: Nu mai vreau nimic."
    },
    {
      "id": 110504454447505415,
      "target": "Widow: Ne vom întoarce acasă."
    },
    {
      "id": 110504454447505414,
      "target": "Widow: N-a mai rămas nimeni."
    },
    {
      "id": 110504454447505413,
      "target": "Noroc"
    },
    {
      "id": 110504454447505412,
      "target": "Poți să rămâi"
    },
    {
      "id": 110504454447505411,
      "target": "Widow: Iar acolo…"
    },
    {
      "id": 110504454447505410,
      "target": "Widow: O să scot chitara."
    },
    {
      "id": 110504454447505409,
      "target": "Widow: Mă întorc acasă."
    },
    {
      "id": 110504454447505408,
      "target": "Widow: Nu vreau să mă gândesc la asta."
    },
    {
      "id": 110504454443311116,
      "target": "Mergi la rude?"
    },
    {
      "id": 110504454443311115,
      "target": "Și acum ce faci?"
    },
    {
      "id": 110504454443311114,
      "target": "Widow: Aveam nevoie doar să mă odihnesc."
    },
    {
      "id": 110504454443311113,
      "target": "Widow: V-am spus de la început că nu voi sta mult."
    },
    {
      "id": 110504454443311112,
      "target": "Widow: Plec în noaptea asta."
    },
    {
      "id": 110504454443311109,
      "target": "Widow: Aș vrea să mă odihnesc puțin…"
    },
    {
      "id": 110504454443311108,
      "target": "Widow: E atât de greu să trăiesc fără el acum…"
    },
    {
      "id": 110504454443311107,
      "target": "Widow: Da. Vă rog."
    },
    {
      "id": 110504454443311106,
      "target": "Widow: Vreau să fiu singură."
    },
    {
      "id": 110504454443311105,
      "target": "Widow: …"
    },
    {
      "id": 110504454443311104,
      "target": "Widow: Ați ucis, iar sufletul lui va rămâne la dumneavoastră. Iar eu nu voi putea decât să strig că nu-mi pare rău pentru nimeni."
    },
    {
      "id": 110504454439116811,
      "target": "Widow: …"
    },
    {
      "id": 110504454439116810,
      "target": "Widow: Chiar era acolo…"
    },
    {
      "id": 110504454439116809,
      "target": "Widow: Iar el…"
    },
    {
      "id": 110504454439116808,
      "target": "Widow: La tâmpiții ăia e mereu haos, așa că a fost de ajuns să-mi pun un halat de doctor și să intru în morgă."
    },
    {
      "id": 110504454439116807,
      "target": "Widow: Nu mă lasă să-i duc trupul acasă."
    },
    {
      "id": 110504454439116806,
      "target": "Widow: Nu mă lasă să-i examinez trupul."
    },
    {
      "id": 110504454439116805,
      "target": "Widow: Atât."
    },
    {
      "id": 110504454439116804,
      "target": "Widow: Mi-au spus: „A murit.”"
    },
    {
      "id": 110504454439116803,
      "target": "Widow: …"
    },
    {
      "id": 110504454439116802,
      "target": "Widow: O clipă, iertați-mă."
    },
    {
      "id": 110504454439116801,
      "target": "Widow: …"
    },
    {
      "id": 110504454439116800,
      "target": "Widow: Mi-au spus doar, sec…"
    },
    {
      "id": 110504454434922503,
      "target": "Widow: Am venit mai devreme, doar să văd cum se simte."
    },
    {
      "id": 110504454434922502,
      "target": "Widow: …"
    },
    {
      "id": 110504454434922501,
      "target": "Widow: Comitetul l-a pus pur și simplu în carantină. Nu mi-au dat voie să iau legătura cu el. Au spus că-l vor elibera peste trei săptămâni."
    },
    {
      "id": 110504454434922500,
      "target": "Widow: Am mers la centrul deschis de Comitet."
    },
    {
      "id": 110504454434922499,
      "target": "Widow: Soțul meu se simțea rău. Am mers la spital, dar l-au trimis să fie verificat de nenorociții ăia."
    },
    {
      "id": 110504454434922498,
      "target": "Pot să nu te mai întreb despre asta"
    },
    {
      "id": 110504454434922497,
      "target": "Atunci ce s-a întâmplat?"
    },
    {
      "id": 110504454434922496,
      "target": "Widow: Și cineva o să-i omoare."
    },
    {
      "id": 110504454430728198,
      "target": "Widow: Sper ca nenorociții ăia să primească ce merită."
    },
    {
      "id": 110504454430728197,
      "target": "Widow: A fost nepoliticos din partea mea. Dar nu pot vorbi calm despre el."
    },
    {
      "id": 110504454430728196,
      "target": "Widow: Da. Da, înțeleg."
    },
    {
      "id": 110504454430728195,
      "target": "Widow: …"
    },
    {
      "id": 110504454430728194,
      "target": "Pot să nu te mai întreb despre asta"
    },
    {
      "id": 110504454430728193,
      "target": "Atunci ce s-a întâmplat?"
    },
    {
      "id": 110504454430728192,
      "target": "Widow: Dar cel mai mult vreau ca aceia din vina cărora… s-au întâmplat toate astea să ardă sub Soare."
    },
    {
      "id": 110504454426533897,
      "target": "Widow: În fiecare noapte plâng fără să mă pot opri."
    },
    {
      "id": 110504454426533896,
      "target": "Widow: Iertați-mă, pur și simplu nu pot…"
    },
    {
      "id": 110504454426533895,
      "target": "Widow: …"
    },
    {
      "id": 110504454426533894,
      "target": "Nu eu sunt vinovat de moartea lui"
    },
    {
      "id": 110504454426533893,
      "target": "Înțeleg. Iartă-mă dacă te-am rănit"
    },
    {
      "id": 110504454426533892,
      "target": "Widow: Futu-i, a murit."
    },
    {
      "id": 110504454426533890,
      "target": "Atunci ce i s-a întâmplat?"
    },
    {
      "id": 110504454426533889,
      "target": "Widow: Aș vrea să mă odihnesc puțin…"
    }
  ]
}
