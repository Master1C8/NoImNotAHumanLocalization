{"ordinal":13381,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452904001543","collection":"Dialogs","key":"line:Wolfhound_Armpit_0057b1a","source":"Wolfhound: ...","target":"Wolfhound: ...","batchPath":"Translations/ro/dialogue-batch-338.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
