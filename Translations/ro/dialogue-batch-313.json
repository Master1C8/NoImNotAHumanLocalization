  "entries": [
    {
      "id": 110504453419900932,
      "target": "Cultist3: Te vor arde, dar nu vei ajunge la Moarte."
    },
    {
      "id": 110504453419900931,
      "target": "Cultist3: Mai bine să nu faci asta."
    },
    {
      "id": 110504453419900930,
      "target": "Cultist3: …"
    },
    {
      "id": 110504453419900929,
      "target": "Cultist3: Tot ce contează va rămâne în memorie."
    },
    {
      "id": 110504453419900928,
      "target": "Cultist3: Fotografiile n-au niciun rost."
    },
    {
      "id": 110504453415706631,
      "target": "Cultist3: …"
    },
    {
      "id": 110504453415706630,
      "target": "Cultist3: …"
    },
    {
      "id": 110504453415706629,
      "target": "Cultist3: Fiecare să-și vadă de treaba lui."
    },
    {
      "id": 110504453415706628,
      "target": "Cultist3: Ți-am arătat tot. Acum mă voi pregăti."
    },
    {
      "id": 110504453415706625,
      "target": "Cultist3: …"
    },
    {
      "id": 110504453411512326,
      "target": "Cultist3: Ce te-a făcut să crezi că ar fi mai bine să mă omori?"
    },
    {
      "id": 110504453411512323,
      "target": "Cultist3: …"
    },
    {
      "id": 110504453411512320,
      "target": "Cultist3: Dar tu să nu te amesteci în ce se petrece."
    },
    {
      "id": 110504453407318022,
      "target": "Cultist3: Ești confuz. Mai bine lasă pușca jos."
    },
    {
      "id": 110504453407318019,
      "target": "Cultist3: Nu mă împiedica. Te rog."
    },
    {
      "id": 110504453407318016,
      "target": "Cultist3: …"
    },
    {
      "id": 110504453403123719,
      "target": "Cultist3: ..."
    },
    {
      "id": 110504453403123718,
      "target": "Cultist3: …"
    },
    {
      "id": 110504453403123715,
      "target": "Cultist3: …"
    },
    {
      "id": 110504453403123714,
      "target": "Cultist3: ..."
    },
    {
      "id": 110504453403123713,
      "target": "Cultist3: Stai, hainele mă încurcă."
    },
    {
      "id": 110504453398929413,
      "target": "Cultist3: …"
    },
    {
      "id": 110504453398929412,
      "target": "Cultist3: ..."
    },
    {
      "id": 110504453398929411,
      "target": "Cultist3: …"
    },
    {
      "id": 110504453398929408,
      "target": "Cultist3: S-ar putea să plec înaintea fraților mei."
    },
    {
      "id": 110504453394735112,
      "target": "Cultist3: ..."
    },
    {
      "id": 110504453394735111,
      "target": "Cultist3: Ochii mei abia mai văd."
    },
    {
      "id": 110504453394735108,
      "target": "Cultist3: Asta ar trebui să atragă Moartea. Să ne salveze."
    },
    {
      "id": 110504453394735107,
      "target": "Cultist3: ..."
    },
    {
      "id": 110504453394735106,
      "target": "Cultist3: Așa semănăm cu străinii."
    },
    {
      "id": 110504453390540806,
      "target": "Cultist3: …"
    },
    {
      "id": 110504453390540805,
      "target": "Cultist3: ..."
    },
    {
      "id": 110504453390540804,
      "target": "Cultist3: Mă amuză și pe mine că maxilarul de jos și cel de sus pot fi diferite."
    },
    {
      "id": 110504453386346502,
      "target": "Cultist3: Fă ce vrei. Numai nu mă încurca."
    }
  ]
}
