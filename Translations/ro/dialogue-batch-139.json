  "entries": [
    {
      "id": 110504456162975749,
      "target": "Wheelchair: O-o-o, mă car de aici pe roți. Nebunule."
    },
    {
      "id": 110504456162975748,
      "target": "Wheelchair: Cum să plec?"
    },
    {
      "id": 110504456162975747,
      "target": "Wheelchair: Să plec? Ești tâmpit?"
    },
    {
      "id": 110504456162975746,
      "target": "Wheelchair: Facem o cursă prin casa ta, da?"
    },
    {
      "id": 110504456162975745,
      "target": "Wheelchair: Asta da treabă!"
    },
    {
      "id": 110504456158781450,
      "target": "Wheelchair: Uite, am străbătut atâta drum. Mă lași și pe mine la tine, te rog?"
    },
    {
      "id": 110504456158781449,
      "target": "Wheelchair: Chiar m-am înșelat, se pare."
    },
    {
      "id": 110504456158781448,
      "target": "Wheelchair: Futu-i…"
    },
    {
      "id": 110504456158781447,
      "target": "Wheelchair: …"
    },
    {
      "id": 110504456158781446,
      "target": "Wheelchair: …"
    },
    {
      "id": 110504456158781445,
      "target": "Wheelchair: Nu-u-u…"
    },
    {
      "id": 110504456158781444,
      "target": "Wheelchair: …"
    },
    {
      "id": 110504456158781443,
      "target": "Wheelchair: Nu, nu se poate să fi…"
    },
    {
      "id": 110504456158781440,
      "target": "Wheelchair: Uite, am străbătut atâta drum. Mă lași și pe mine la tine, te rog?"
    },
    {
      "id": 110504456154587147,
      "target": "Wheelchair: …"
    },
    {
      "id": 110504456154587146,
      "target": "Wheelchair: Prietenul meu sigur locuiește… adică locuia aici."
    },
    {
      "id": 110504456154587145,
      "target": "Wheelchair: Nu aveam cum să greșesc, memoria nu mă lasă niciodată."
    },
    {
      "id": 110504456154587144,
      "target": "Wheelchair: Ba nu, hai măi."
    },
    {
      "id": 110504456154587143,
      "target": "Cred că ai greșit adresa."
    },
    {
      "id": 110504456154587142,
      "target": "Casa asta a fost mereu a familiei noastre."
    },
    {
      "id": 110504456154587141,
      "target": "Wheelchair: De cât timp locuiți aici?"
    },
    {
      "id": 110504456154587140,
      "target": "Wheelchair: Tu nu ești prietenul meu."
    },
    {
      "id": 110504456154587139,
      "target": "Wheelchair: …"
    },
    {
      "id": 110504456154587138,
      "target": "Wheelchair: O, tu nu ești…"
    },
    {
      "id": 110504456154587137,
      "target": "Cred că ai greșit adresa."
    },
    {
      "id": 110504456154587136,
      "target": "Casa asta a fost mereu a familiei mele."
    },
    {
      "id": 110504456150392842,
      "target": "Wheelchair: De când s-a schimbat proprietarul aici?"
    },
    {
      "id": 110504456150392841,
      "target": "Wheelchair: …"
    },
    {
      "id": 110504456150392840,
      "target": "Wheelchair: Stai puțin, vocea ta e alta…"
    },
    {
      "id": 110504456150392839,
      "target": "Wheelchair: …"
    },
    {
      "id": 110504456150392838,
      "target": "Wheelchair: Păi noi…"
    },
    {
      "id": 110504456150392837,
      "target": "Wheelchair: Cum adică, tu… Nu mă mai ții minte?"
    },
    {
      "id": 110504456150392835,
      "target": "Ne cunoaștem?"
    },
    {
      "id": 110504456150392834,
      "target": "WheelChair: Nu ne-am mai văzut de mult. Cum îți merge?"
    },
    {
      "id": 110504456150392833,
      "target": "Wheelchair: He-ei, salut!"
    }
  ]
}
