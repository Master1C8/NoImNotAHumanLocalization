{"ordinal":11623,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453910634505","collection":"Dialogs","key":"line:Jacket_Photo_Gun_034a7c5","source":"Jacket: На ауре что-то есть?","target":"Jacket: Se vede ceva în aură?","batchPath":"Translations/ro/dialogue-batch-295.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
