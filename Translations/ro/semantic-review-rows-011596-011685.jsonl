{"ordinal":11640,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453906440195","collection":"Dialogs","key":"line:Jacket_Teeth_Gun_0e68e4c","source":"Jacket: НЕ СТРЕЛЯЙТЕ, ПОЖАЛУЙСТА!!!","target":"Jacket: NU TRAGEȚI, VĂ ROG!!!","batchPath":"Translations/ro/dialogue-batch-295.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
{"ordinal":11641,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453906440194","collection":"Dialogs","key":"line:Jacket_Teeth_Gun_05f8913","source":"Jacket: Я Гость?! Но у меня же неровные зубы…","target":"Jacket: Sunt Musafir?! Dar am dinții strâmbi…","batchPath":"Translations/ro/dialogue-batch-295.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
