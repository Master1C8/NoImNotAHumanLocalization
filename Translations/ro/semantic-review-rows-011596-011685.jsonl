{"ordinal":11626,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453910634502","collection":"Dialogs","key":"line:Jacket_Armpit_Gun_05e36a8","source":"Выстрелить","target":"Trage","batchPath":"Translations/ro/dialogue-batch-001.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
{"ordinal":11627,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453910634501","collection":"Dialogs","key":"line:Jacket_Armpit_Gun_09bfbc9","source":"Jacket: ЧЁРТ, ЧЁРТ, ЧЁРТ!!!","target":"Jacket: LA DRACU’, LA DRACU’, LA DRACU’!!!","batchPath":"Translations/ro/dialogue-batch-295.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
{"ordinal":11628,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453910634500","collection":"Dialogs","key":"line:Jacket_Armpit_Gun_03f3588","source":"Jacket: Проклятье, я правда Гость?!","target":"Jacket: La naiba, chiar sunt Musafir?!","batchPath":"Translations/ro/dialogue-batch-295.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
{"ordinal":11629,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453910634499","collection":"Dialogs","key":"line:Jacket_Eyes_Gun_011d7e7","source":"Выслушать","target":"Ascultă","batchPath":"Translations/ro/dialogue-batch-001.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
