  "entries": [
    {
      "id": 110504452589428738,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452589428737,
      "target": "BigLebowski: Și? Sunt curate? Se ridică la standardele tale?"
    },
    {
      "id": 110504452589428736,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452585234440,
      "target": "BigLebowski: Bine, mi se rupe complet."
    },
    {
      "id": 110504452585234437,
      "target": "BigLebowski: Ei? Arată-mi!"
    },
    {
      "id": 110504452585234436,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452585234435,
      "target": "BigLebowski: Dacă vrei să trimiți poza asta ca să mă găsească ai mei după ea, du-te dracului."
    },
    {
      "id": 110504452585234434,
      "target": "BigLebowski: …"
    },
    {
      "id": 110504452581040138,
      "target": "BigLebowski: Nu. E o tâmpenie ciudată. N-o să fac asta."
    },
    {
      "id": 110504452581040135,
      "target": "BigLebowski: …"
    },
    {
      "id": 110504452581040134,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452581040133,
      "target": "BigLebowski: Îți amintesc: dacă pui la cale ceva dubios, îți scot eu ochiul!"
    },
    {
      "id": 110504452581040130,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452581040129,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452581040128,
      "target": "BigLebowski: Poftim."
    },
    {
      "id": 110504452576845836,
      "target": "BigLebowski: E o alergie. De-asta mă mănâncă pielea. E foarte nasol. Am asta de când eram mică."
    },
    {
      "id": 110504452576845835,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452576845834,
      "target": "BigLebowski: Numai să nu te sperii…"
    },
    {
      "id": 110504452576845833,
      "target": "BigLebowski: Hm…"
    },
    {
      "id": 110504452576845830,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452576845829,
      "target": "BigLebowski: Părinții se îngrijorau de dinții mei mult mai mult decât de mine…"
    },
    {
      "id": 110504452576845828,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452576845827,
      "target": "BigLebowski: Ce chestie ciudată. Ține minte: dacă-ți trece ceva prin cap, pot să-ți trag una în față!"
    },
    {
      "id": 110504452572651529,
      "target": "BigLebowski: Bine, hai, nene. Mi se rupe."
    }
  ]
}
