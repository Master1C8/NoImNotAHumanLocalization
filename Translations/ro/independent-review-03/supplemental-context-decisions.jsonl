{"ordinal": 8751, "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454955016203", "key": "line:Couple_Asking_3_025fa41", "source": "Couple: Мы вас не сильно стесняем же? Извините ещё раз!", "target": "Couple: Nu vă încurcăm prea tare, nu? Scuzați-ne încă o dată!", "sourceSha256": "e293c9d3b4cdcba2483de088646c0ac8947815af579e17cfcdf385651f8b819c", "targetSha256": "e1e697250ed6c11865e3cb4dea035ddd2387e94562a4750e1d715928054fcb4f", "fullSourceAndCurrentTargetRead": true, "compiledPlacements": [{"node": "Couple_Asking_3", "instruction": 20, "opcode": 2}], "decision": "no-objective-correction-in-context-unit", "mandatoryRegressions": ["couple-past-night-context"], "boundary": "Independent full pair read with ordered compiled source context; no live game or rendered text."}
