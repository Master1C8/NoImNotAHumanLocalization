{"ordinal":9686,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454619471878","collection":"Dialogs","key":"line:Sirin_Asking_3_0bb7613","source":"Sirin: Она боится всё потерять.","target":"Sirin: Îi este teamă să nu piardă totul.","batchPath":"Translations/ro/dialogue-batch-250.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
