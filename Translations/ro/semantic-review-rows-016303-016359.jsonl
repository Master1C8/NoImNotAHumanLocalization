{"ordinal":16348,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451725402112","collection":"Dialogs","key":"line:Firefighter_Hands_0e809bf","source":"Firefighter: Вот, смотри. Кх-кх…","target":"Firefighter: Uite, privește. Cof-cof…","batchPath":"Translations/ro/dialogue-batch-407.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
