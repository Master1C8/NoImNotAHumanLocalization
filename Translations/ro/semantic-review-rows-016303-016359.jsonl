{"ordinal":16332,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451729596421","collection":"Dialogs","key":"line:Firefighter_Ears_0174130","source":"Firefighter: Тут всё просто – обгорели до хрящей.","target":"Firefighter: E simplu: au ars până la cartilaj.","batchPath":"Translations/ro/dialogue-batch-407.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
