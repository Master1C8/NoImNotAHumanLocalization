{"ordinal":16320,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451733790726","collection":"Dialogs","key":"line:Firefighter_Eyes_Gun_030a061","source":"Выслушать","target":"Ascultă","batchPath":"Translations/ro/dialogue-batch-001.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
{"ordinal":16321,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451733790725","collection":"Dialogs","key":"line:Firefighter_Eyes_Gun_0a58c78","source":"Выстрелить","target":"Trage","batchPath":"Translations/ro/dialogue-batch-001.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
{"ordinal":16322,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451733790724","collection":"Dialogs","key":"line:Firefighter_Eyes_Gun_0e7addd","source":"Firefighter: Может, так будет даже легче…","target":"Firefighter: Poate așa o să fie chiar mai ușor…","batchPath":"Translations/ro/dialogue-batch-407.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
