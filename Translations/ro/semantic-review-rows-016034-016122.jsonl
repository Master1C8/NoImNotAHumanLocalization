{"ordinal":16071,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451838648320","collection":"Dialogs","key":"line:Anger_Photo_Gun_0b6bae1","source":"Выстрелить","target":"Trage","batchPath":"Translations/ro/dialogue-batch-001.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
{"ordinal":16072,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451834454025","collection":"Dialogs","key":"line:Anger_Photo_Gun_07b678c","source":"Anger: Ты, сука, хочешь в меня выстрелить из-за ёбаной фотки?","target":"Anger: Vrei să mă împuști, nenorocitule, pentru o poză de căcat?","batchPath":"Translations/ro/dialogue-batch-401.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
{"ordinal":16073,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451834454024","collection":"Dialogs","key":"line:Anger_Armpit_Gun_0fbd3fb","source":"Выслушать","target":"Ascultă","batchPath":"Translations/ro/dialogue-batch-001.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
