{"ordinal":16115,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451817676806","collection":"Dialogs","key":"line:Anger_Teeth_0d341e3","source":"Anger: Да похуй. На.","target":"Anger: Mă doare-n cur. Na.","batchPath":"Translations/ro/dialogue-batch-402.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
