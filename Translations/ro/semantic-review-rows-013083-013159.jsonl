{"ordinal":13120,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453034024962","collection":"Dialogs","key":"line:Edgar_Ears_0c6c999","source":"Edgar: Какое было, такое и осталось.","target":"Edgar: E la fel ca înainte.","batchPath":"Translations/ro/dialogue-batch-330.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
