{"ordinal":13125,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453029830663","collection":"Dialogs","key":"line:Edgar_Photo_0c694d9","source":"Edgar: ...","target":"Edgar: ...","batchPath":"Translations/ro/dialogue-batch-330.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
