  "entries": [
    {
      "id": 110504455097622528,
      "target": "Daughter: Cred că acesta e numărul ei de telefon: {0}."
    },
    {
      "id": 110504455093428236,
      "target": "Daughter: Când o cheamă adulții, o lasă să vină... Dar dacă o chem eu, mă ceartă mereu."
    },
    {
      "id": 110504455093428235,
      "target": "Daughter: Și încă ceva... poate o chemați pe prietena mea în vizită?.."
    },
    {
      "id": 110504455093428234,
      "target": "Cold: Iartă-mă. N-am vrut asta."
    },
    {
      "id": 110504455093428233,
      "target": "Cold: Și totuși."
    },
    {
      "id": 110504455093428232,
      "target": "Cold: Înțeleg cât de mult mă urăști."
    },
    {
      "id": 110504455093428231,
      "target": "Cold: Mulțumesc."
    },
    {
      "id": 110504455093428230,
      "target": "Cold: Poate măcar la soare voi reuși să mă încălzesc. Pentru ultima oară."
    },
    {
      "id": 110504455093428229,
      "target": "Cold: Iartă-mă."
    },
    {
      "id": 110504455093428228,
      "target": "Cold: Am înțeles."
    },
    {
      "id": 110504455093428227,
      "target": "Dă-mi numai un motiv să trag"
    },
    {
      "id": 110504455093428226,
      "target": "Pleacă acum"
    },
    {
      "id": 110504455093428225,
      "target": "Cold: Pot să rămân până se lasă noaptea?"
    },
    {
      "id": 110504455093428224,
      "target": "Cold: Soarele mă va ucide încet."
    },
    {
      "id": 110504455089233931,
      "target": "Cold: Ar fi mai etic să mă împuști. Din păcate, simt durerea."
    },
    {
      "id": 110504455089233930,
      "target": "Cold: Chiar acum?"
    },
    {
      "id": 110504455089233929,
      "target": "Cold: Să nu crezi că am făcut-o intenționat."
    },
    {
      "id": 110504455089233928,
      "target": "Cold: Aș vrea doar…"
    },
    {
      "id": 110504455089233927,
      "target": "Cold: Atunci se vor sfârși problemele mele cu frigul și singurătatea."
    },
    {
      "id": 110504455089233926,
      "target": "Cold: Probabil e mai sigur așa."
    },
    {
      "id": 110504455089233925,
      "target": "Dă-l afară"
    },
    {
      "id": 110504455089233923,
      "target": "Cold: Nu asta am vrut…"
    },
    {
      "id": 110504455089233922,
      "target": "Cold: Nu am făcut-o din răutate."
    },
    {
      "id": 110504455089233921,
      "target": "Cold: Nu trage concluzii pripite."
    },
    {
      "id": 110504455089233920,
      "target": "Cold: De ce am crezut că de data asta ceva se va schimba?"
    },
    {
      "id": 110504455085039628,
      "target": "Cold: Așa se întâmpla înainte."
    },
    {
      "id": 110504455085039627,
      "target": "Dă-l afară"
    },
    {
      "id": 110504455085039625,
      "target": "Cold: Chiar nu am vrut."
    },
    {
      "id": 110504455085039624,
      "target": "Cold: Nu am vrut."
    },
    {
      "id": 110504455085039623,
      "target": "Cold: De ce mi se întâmplă asta?"
    },
    {
      "id": 110504455085039622,
      "target": "Cold: Speram că aici nu se va întâmpla așa."
    },
    {
      "id": 110504455085039621,
      "target": "Cold: N-am făcut-o intenționat…"
    },
    {
      "id": 110504455085039620,
      "target": "Ai belit-o"
    },
    {
      "id": 110504455085039619,
      "target": "Ce-ai făcut?"
    },
    {
      "id": 110504455085039618,
      "target": "Cold: O, nu. Din nou."
    },
    {
      "id": 110504455085039617,
      "target": "Cold: Uite."
    },
    {
      "id": 110504455085039616,
      "target": "Cold: Sub haine ascund ceea ce cred că îmi provoacă frigul și singurătatea care mă mistuie."
    },
    {
      "id": 110504455080845324,
      "target": "Cold: De obicei nu se termină bine, dar poate acum va fi altfel."
    },
    {
      "id": 110504455080845323,
      "target": "Cold: Cred că sunt pregătit."
    },
    {
      "id": 110504455080845322,
      "target": "Cold: Da, voiam să-ți dezvălui un secret."
    },
    {
      "id": 110504455080845320,
      "target": "Ce ascunzi acolo?"
    },
    {
      "id": 110504455080845319,
      "target": "Cold: De-aș simți puțină căldură..."
    }
  ]
}
