  "entries": [
    {
      "id": 110504456330747915,
      "target": "Daughter: MI-E FOARTE FRIII-I-I-ICĂĂĂĂ."
    },
    {
      "id": 110504456330747914,
      "target": "Daughter: AAAAAAAAAAAA."
    },
    {
      "id": 110504456330747913,
      "target": "Daughter: Aaaaaaaaaaaa."
    },
    {
      "id": 110504456330747912,
      "target": "Daughter: Unde să mă du-u-u-uc?"
    },
    {
      "id": 110504456330747911,
      "target": "Daughter: Mi-e fri-i-i-că."
    },
    {
      "id": 110504456330747910,
      "target": "Daughter: Mă a-a-ajutați?"
    },
    {
      "id": 110504456330747907,
      "target": "Daughter: Când am fu-fugit, ei doar râdeau."
    },
    {
      "id": 110504456330747906,
      "target": "Daughter: Apoi au fă-fă-făcut ceva, apoi au da-dat foc casei."
    },
    {
      "id": 110504456330747905,
      "target": "Daughter: Stăteau liniștiți cu ta-tata în bucătărie."
    },
    {
      "id": 110504456330747904,
      "target": "Daughter: Nu-nu știu."
    },
    {
      "id": 110504456326553623,
      "target": "Daughter: Casa noastră a-a-acum a-a-arde!"
    },
    {
      "id": 110504456326553622,
      "target": "Daughter: Aaaaaaaaaa-haaaaaa."
    },
    {
      "id": 110504456326553621,
      "target": "Daughter: Tata vo-vorbea cu ei despre ceva. Apoi l-au omorât."
    },
    {
      "id": 110504456326553620,
      "target": "Daughter: Au venit Mu-u-usafiri la noi. Stă-stăteau la noi."
    },
    {
      "id": 110504456326553619,
      "target": "De ce au făcut asta?"
    },
    {
      "id": 110504456326553618,
      "target": "Cine a făcut asta?"
    },
    {
      "id": 110504456326553617,
      "target": "Daughter: L-au omorât pe ta-ta-tata."
    },
    {
      "id": 110504456326553616,
      "target": "Daughter: A-a-a-a-ha-a-a-ah."
    },
    {
      "id": 110504456326553615,
      "target": "Daughter: Pe ta-ta-tata me-me-meu…"
    },
    {
      "id": 110504456326553614,
      "target": "Daughter: A-a-a-a-a-a."
    },
    {
      "id": 110504456326553613,
      "target": "De ce au făcut asta?"
    },
    {
      "id": 110504456326553612,
      "target": "Cine a făcut asta?"
    },
    {
      "id": 110504456326553611,
      "target": "Daughter: Pe ta-tata."
    },
    {
      "id": 110504456326553610,
      "target": "Daughter: A-a-a-aha-a-a-a."
    },
    {
      "id": 110504456326553609,
      "target": "Daughter: L-au omorâ-â-ât pe ta…"
    },
    {
      "id": 110504456326553608,
      "target": "Daughter: A-a-a-a-a-a."
    },
    {
      "id": 110504456326553607,
      "target": "Daughter: Oame-e-e-enii."
    },
    {
      "id": 110504456326553606,
      "target": "Daughter: Nu-nu ști-u-u-u ce să fa-fac."
    },
    {
      "id": 110504456326553605,
      "target": "S-a întâmplat ceva?"
    },
    {
      "id": 110504456326553604,
      "target": "Ai o criză de isterie?"
    },
    {
      "id": 110504456326553603,
      "target": "Daughter: Lăsați-mă să i-intru."
    },
    {
