{"ordinal":14666,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452367130634","collection":"Dialogs","key":"line:Fatman_Eyes_06d38ce","source":"Fatman: Ага, сейчас, погоди…","target":"Fatman: Da, imediat, așteaptă…","batchPath":"Translations/ro/dialogue-batch-371.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
