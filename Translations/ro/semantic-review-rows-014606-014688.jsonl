{"ordinal":14679,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452362936327","collection":"Dialogs","key":"line:Fatman_Teeth_0316b2d","source":"Fatman: Ты ж не отстанешь, да?","target":"Fatman: Nu mă lași în pace, nu?","batchPath":"Translations/ro/dialogue-batch-371.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
{"ordinal":14680,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452362936326","collection":"Dialogs","key":"line:Fatman_Teeth_00e47c0","source":"Fatman: …","target":"Fatman: …","batchPath":"Translations/ro/dialogue-batch-371.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
