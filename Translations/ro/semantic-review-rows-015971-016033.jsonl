{"ordinal":16015,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451859619845","collection":"Dialogs","key":"line:FortuneTeller_Eyes_0680641","source":"Отпустить","target":"Dă-i drumul","batchPath":"Translations/ro/dialogue-batch-001.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
