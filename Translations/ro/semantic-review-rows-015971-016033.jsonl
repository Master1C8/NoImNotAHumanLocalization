{"ordinal":16009,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451863814144","collection":"Dialogs","key":"line:FortuneTeller_Photo_032121c","source":"FortuneTeller: Будь осторожен. Моя аура может и ослепить!","target":"FortuneTeller: Ai grijă. Aura mea te poate chiar orbi!","batchPath":"Translations/ro/dialogue-batch-400.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
