{"ordinal":13576,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452807532547","collection":"Dialogs","key":"line:Greatmother_Teeth_09988a8","source":"Greatmother: Хахахаха, какие зубы, сынок?","target":"Greatmother: Ha-ha-ha, ce dinți, fiule?","batchPath":"Translations/ro/dialogue-batch-344.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
