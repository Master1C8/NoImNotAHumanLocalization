  "entries": [
    {
      "id": 110504456754372613,
      "target": "SuperFake: Ne mai vedem?"
    },
    {
      "id": 110504456754372612,
      "target": "SuperFake: Păi…"
    },
    {
      "id": 110504456754372611,
      "target": "SuperFake: Eu doar împlinesc voința aceea."
    },
    {
      "id": 110504456754372610,
      "target": "SuperFake: Există forțe mai presus de mine."
    },
    {
      "id": 110504456754372609,
      "target": "SuperFake: Doar nu crezi că eu sunt aici… vreun fel de șef?"
    },
    {
      "id": 110504456754372608,
      "target": "SuperFake: Schimbările nu sunt cel mai înfricoșător lucru care te așteaptă."
    },
    {
      "id": 110504456750178314,
      "target": "SuperFake: Nici oamenii mei nu sunt prea mulți. Ce să mai zic de voi, închiși în propriile case."
    },
    {
      "id": 110504456750178313,
      "target": "SuperFake: Ia te uită."
    },
    {
      "id": 110504456750178312,
      "target": "SuperFake: Vino cu mine."
    },
    {
      "id": 110504456750178311,
      "target": "SuperFake: Ei, iată că a intrat în joc noua noastră regulă."
    },
    {
      "id": 110504456750178310,
      "target": "SuperFake: Hmmm…"
    },
    {
      "id": 110504456750178307,
      "target": "SuperFake: Ești singur acasă?"
    },
    {
      "id": 110504456750178306,
      "target": "SuperFake: Dar mai întâi vom verifica noua noastră regulă."
    },
    {
      "id": 110504456750178305,
      "target": "SuperFake: Sigur! Deja plec."
    },
    {
      "id": 110504456745984010,
      "target": "SuperFake: Ești acasă singur?"
    },
    {
      "id": 110504456745984009,
      "target": "SuperFake: Dar pentru început…"
    },
    {
      "id": 110504456745984008,
      "target": "SuperFake: O vom încerca acum."
    },
    {
      "id": 110504456745984007,
      "target": "SuperFake: E simplu."
    },
    {
      "id": 110504456745984006,
      "target": "Poți veni mai târziu?"
    },
    {
      "id": 110504456745984004,
      "target": "SuperFake: Îmi vei deschide ușa."
    },
    {
      "id": 110504456745984003,
      "target": "SuperFake: Dacă în casa ta vor fi măcar doi dintre oamenii mei…"
    },
    {
      "id": 110504456745984002,
      "target": "SuperFake: Hai să schimbăm asta."
    },
    {
      "id": 110504456745984001,
      "target": "SuperFake: De parcă nu ți-ar păsa deloc de tine însuți."
    },
    {
      "id": 110504456745984000,
      "target": "SuperFake: Parcă ești nepăsător."
    },
    {
      "id": 110504456741789707,
      "target": "Poți veni mai târziu?"
    },
    {
      "id": 110504456741789705,
      "target": "SuperFake: Pentru că acum trupurile sunt locuite de câini."
    },
    {
      "id": 110504456741789704,
      "target": "SuperFake: Îmi vei deschide ușa."
    },
    {
      "id": 110504456741789703,
      "target": "SuperFake: Dacă în casa ta vor fi măcar doi dintre oamenii mei…"
    },
    {
      "id": 110504456741789702,
      "target": "SuperFake: Vom încerca împreună niște reguli noi."
    },
    {
      "id": 110504456741789701,
      "target": "SuperFake: Se pare că trebuie să te ajut."
    },
    {
      "id": 110504456741789700,
      "target": "SuperFake: Îți e greu."
    },
    {
      "id": 110504456741789699,
      "target": "Nu-mi pasă"
    },
    {
      "id": 110504456741789698,
      "target": "Nu simt asta"
    },
    {
      "id": 110504456741789697,
      "target": "SuperFake: Se întâmplă lucruri interesante în jurul tău."
    },
    {
      "id": 110504456741789696,
      "target": "SuperFake: Înțelegi despre cine vorbesc?"
    },
    {
      "id": 110504456737595403,
      "target": "SuperFake: Căci el are doar cuvântul, doar cuvântul, dar ce cuvânt!"
    },
    {
      "id": 110504456737595402,
      "target": "SuperFake: Iar omul, luat separat, a încetat să mai moară."
    },
    {
      "id": 110504456737595401,
      "target": "SuperFake: Și eu."
    },
    {
      "id": 110504456737595400,
      "target": "SuperFake: Schimbările te urmăresc."
    },
    {
      "id": 110504456737595399,
      "target": "SuperFake: Simți?"
    }
  ]
}
