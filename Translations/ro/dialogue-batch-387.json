  "entries": [
    {
      "id": 110504452123860996,
      "target": "Sirin: Ce frumoasă e!"
    },
    {
      "id": 110504452123860995,
      "target": "Sirin: Dar pentru tine era menită!"
    },
    {
      "id": 110504452123860994,
      "target": "Sirin: Cântarea mea."
    },
    {
      "id": 110504452123860993,
      "target": "Sirin: Atunci îmi voi aștepta ceasul."
    },
    {
      "id": 110504452123860992,
      "target": "Sirin: Nu contează."
    },
    {
      "id": 110504452119666698,
      "target": "Sirin: Agonie fără sfârșit și așteptarea morții."
    },
    {
      "id": 110504452119666697,
      "target": "Sirin: Iar sfârșitul nostru nu-l vom vedea niciodată."
    },
    {
      "id": 110504452119666696,
      "target": "Sirin: Vom fi absorbiți foarte mult timp în orizontul evenimentelor."
    },
    {
      "id": 110504452119666695,
      "target": "Sirin: Și dacă doar ne pregătim să fim înghițiți de o gaură neagră?"
    },
    {
      "id": 110504452119666694,
      "target": "Sirin: Poate data viitoare."
    },
    {
      "id": 110504452119666693,
      "target": "Sirin: Nu corespundea semnelor."
    },
    {
      "id": 110504452119666692,
      "target": "Sirin: Păcat."
    },
    {
      "id": 110504452119666691,
      "target": "Sirin: Poate data viitoare."
    },
    {
      "id": 110504452119666690,
      "target": "Sirin: Păcat."
    },
    {
      "id": 110504452119666689,
      "target": "Sirin: Oricum vei muri."
    },
    {
      "id": 110504452119666688,
      "target": "Sirin: ..."
    },
    {
      "id": 110504452115472395,
      "target": "Sirin: N-ai avut curaj?"
    },
    {
      "id": 110504452115472392,
      "target": "Sirin: Vei apăsa butonul acela mult dorit?"
    },
    {
      "id": 110504452115472391,
      "target": "Sirin: Ei?"
    },
    {
      "id": 110504452115472388,
      "target": "Sirin: Îți place?"
    },
    {
      "id": 110504452115472387,
      "target": "Sirin: Doar ți se va transmite."
    },
    {
      "id": 110504452115472386,
      "target": "Sirin: Când îmi voi închide ochii, golul nu va dispărea."
    },
    {
      "id": 110504452111278091,
      "target": "Sirin: O să fac eu totul."
    },
    {
      "id": 110504452111278090,
      "target": "Sirin: Dă-mi pușca."
    },
    {
      "id": 110504452111278089,
      "target": "Sirin: Poți să lași asta în seama mea."
    },
    {
      "id": 110504452111278088,
      "target": "Sirin: Moartea e oricum deja aproape."
    },
    {
      "id": 110504452111278087,
      "target": "Sirin: Nu face asta."
    },
    {
      "id": 110504452111278084,
      "target": "Sirin: Scoate-mi sufletul din trup."
    },
    {
      "id": 110504452111278083,
      "target": "Sirin: Așa e chiar mai bine."
    },
    {
      "id": 110504452111278080,
      "target": "Sirin: Se pare că n-am făcut asta degeaba."
    },
    {
      "id": 110504452107083786,
      "target": "Sirin: Sora mea mă rade la subraț. Are grijă de mine."
    },
    {
      "id": 110504452107083783,
      "target": "Sirin: Dar ea nu recunoaște golul din ochi."
    },
    {
      "id": 110504452107083782,
      "target": "Sirin: În privința asta, eu și sora mea semănăm."
    },
    {
      "id": 110504452107083779,
      "target": "Sirin: M-a lăsat să mor încă de atunci."
    },
    {
      "id": 110504452107083778,
      "target": "Sirin: Mai bine ar fi…"
    },
    {
      "id": 110504452107083777,
      "target": "Sirin: Dar e fără rost."
    },
    {
      "id": 110504452107083776,
      "target": "Sirin: Sora mea mă ajută."
    },
    {
      "id": 110504452102889481,
      "target": "Sirin: Mi-i scoți?"
    },
    {
      "id": 110504452102889480,
      "target": "Sirin: Uită-te."
    },
    {
      "id": 110504452102889473,
      "target": "Sirin: Fă-o odată."
    }
  ]
}
