  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504452887224323,
      "target": "Sirin: Cât de curând se va întâmpla?"
    },
    {
      "id": 110504452887224322,
      "target": "Sirin: Musafirii? Cataclismele? Noi unii pe alții?"
    },
    {
      "id": 110504452887224321,
      "target": "Sirin: Tu ce crezi că ne va ucide?"
    },
    {
      "id": 110504452887224320,
      "target": "Sirin: Se poate face oricând mai simplu…"
    },
    {
      "id": 110504452883030025,
      "target": "Sirin: Musafirii nu vor sări la tine dacă îi țintești. Nu se vor da de gol."
    },
    {
      "id": 110504452883030024,
      "target": "Sirin: De ce verifici, țintești, dar nu tragi?"
    },
    {
      "id": 110504452883030021,
      "target": "Sirin: Fă doar ce trebuie să faci."
    },
    {
      "id": 110504452883030020,
      "target": "Sirin: Nu șovăi."
    },
    {
      "id": 110504452883030017,
      "target": "Sirin: Și arde și fotografia asta."
    },
    {
      "id": 110504452878835719,
      "target": "Sirin: Și acum îi e neplăcut să-și amintească de ei."
    },
    {
      "id": 110504452878835718,
      "target": "Sirin: Ar trebui să scap și eu de ea."
    },
    {
      "id": 110504452878835717,
      "target": "Sirin: Iar sora mea și-a scos-o."
    },
    {
      "id": 110504452878835716,
      "target": "Sirin: ..."
    },
    {
      "id": 110504452878835715,
      "target": "Sirin: Îmi amintește de părinți."
    },
    {
      "id": 110504452878835714,
      "target": "Sirin: Mi-a rămas un cercel."
    },
    {
      "id": 110504452874641412,
      "target": "Sirin: Și cum ar trebui?"
    },
    {
      "id": 110504452874641411,
      "target": "Sirin: ..."
    },
    {
      "id": 110504452874641410,
      "target": "Sirin: Fă cum crezi tu de cuviință."
    },
    {
      "id": 110504452874641409,
      "target": "Sirin: Nu-mi pasă dacă mai rămâne ceva după aceea."
    }
  ]
}
