  "entries": [
    {
      "id": 110504454149709824,
      "target": "Tourist: Și niște puncte ciudate pe fotografie."
    },
    {
      "id": 110504454145515532,
      "target": "Tourist: Vai… Ce peliculă ciudată."
    },
    {
      "id": 110504454145515531,
      "target": "Tourist: ..."
    },
    {
      "id": 110504454145515530,
      "target": "Tourist: Dacă e așa, am încredere în metoda asta de verificare."
    },
    {
      "id": 110504454145515529,
      "target": "Tourist: E vreo invenție a guvernului pentru a-i depista pe cei infectați?"
    },
    {
      "id": 110504454145515526,
      "target": "Tourist: Să fiu sincer, căldura asta mă face să transpir foarte tare. De aceea am iritația."
    },
    {
      "id": 110504454145515525,
      "target": "Tourist: ..."
    },
    {
      "id": 110504454145515524,
      "target": "Tourist: …"
    },
    {
      "id": 110504454145515523,
      "target": "Tourist: Ce?"
    },
    {
      "id": 110504454145515520,
      "target": "Tourist: Noroc că am ochelarii de soare la mine."
    },
    {
      "id": 110504454141321227,
      "target": "Tourist: Din păcate, ochelarii de soare nu mă apără de Soare."
    },
    {
      "id": 110504454141321226,
      "target": "Tourist: ..."
    },
    {
      "id": 110504454141321225,
      "target": "Tourist: Ochii? Fără probleme."
    },
    {
      "id": 110504454141321222,
      "target": "Tourist: Mi s-au ars puțin la Soare. Dar tot nu e o infecție."
    },
    {
      "id": 110504454141321221,
      "target": "Tourist: Nu vă mirați, mâinile mă mănâncă din cauza bronzului. De aceea m-am scărpinat."
    },
    {
      "id": 110504454141321220,
      "target": "Tourist: ..."
    },
    {
      "id": 110504454141321219,
      "target": "Tourist: Mâinile? Căutați vreo iritație?"
    },
    {
      "id": 110504454141321216,
      "target": "Tourist: Sunt drepți, nu? La noi în oraș sunt servicii stomatologice ieftine."
    },
    {
      "id": 110504454137126924,
      "target": "Tourist: ..."
    },
    {
      "id": 110504454137126923,
      "target": "Tourist: Ei bine, dacă ajută…"
    },
    {
      "id": 110504454137126922,
      "target": "Tourist: …"
    },
    {
      "id": 110504454137126921,
      "target": "Tourist: Vreți să spuneți că dinții arată dacă am luat virusul?"
    },
    {
      "id": 110504454137126914,
      "target": "Tourist: Credeți că m-am infectat?"
    }
  ]
}
