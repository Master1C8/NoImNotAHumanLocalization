  "entries": [
    {
      "id": 110504456121032710,
      "target": "Nu a mai rămas nimic din dumneavoastră."
    },
    {
      "id": 110504456121032709,
      "target": "Lucrurile, creațiile, munca, gândurile, emoțiile."
    },
    {
      "id": 110504456121032708,
      "target": "Eu am pierdut deja totul. Dar voi mai aveți ce pierde."
    },
    {
      "id": 110504456121032707,
      "target": "Vigilante: ..."
    },
    {
      "id": 110504456121032706,
      "target": "Vigilante: ..."
    },
    {
      "id": 110504456121032705,
      "target": "Vigilante: ..."
    },
    {
      "id": 110504456121032704,
      "target": "Vigilante: ..."
    },
    {
      "id": 110504456116838411,
      "target": "Vigilante: ..."
    },
    {
      "id": 110504456116838410,
      "target": "Vigilante: ..."
    },
    {
      "id": 110504456116838409,
      "target": "Nu știți ce s-a întâmplat cu locuința dumneavoastră."
    },
    {
      "id": 110504456116838408,
      "target": "Și nici măcar nu știți ce aveți de făcut la serviciu."
    },
    {
      "id": 110504456116838407,
      "target": "Și nici nu e limpede când vă vor lăsa să mergeți acasă."
    },
    {
      "id": 110504456116838406,
      "target": "Gasmask: ..."
    },
    {
      "id": 110504456116838405,
      "target": "Gasmask: ..."
    },
    {
      "id": 110504456116838404,
      "target": "Gasmask: ..."
    },
    {
      "id": 110504456116838403,
      "target": "Gasmask: ..."
    },
    {
      "id": 110504456116838402,
      "target": "Orice ar urma de aici, ei au ucis copilul."
    },
    {
      "id": 110504456116838401,
      "target": "Cuvintele doamnei v-au lăsat împietrit."
    },
    {
      "id": 110504456116838400,
      "target": "Dar tu… tu vei lua iadul cu tine, departe de aici."
    },
    {
      "id": 110504456112644107,
      "target": "Copilul ne-ar fi dus spre împărăția unui lucru cumplit."
    },
    {
      "id": 110504456112644106,
      "target": "Tu acuzi lumea noastră de păcate."
    },
    {
      "id": 110504456112644105,
      "target": "Ce se întâmplă?"
    },
    {
      "id": 110504456112644104,
      "target": "Întâlnirea cu ei e un semn bun?"
    },
    {
      "id": 110504456112644103,
      "target": "Ceva vă privește tot timpul?"
    },
    {
      "id": 110504456112644102,
      "target": "Și nu ai pe cine să învinovățești."
    },
    {
      "id": 110504456112644101,
      "target": "Te-au aruncat în stradă."
    },
    {
      "id": 110504456112644100,
      "target": "Oricum se va întâmpla."
    },
    {
      "id": 110504456112644099,
      "target": "Văd ce planuri aveau cu tine."
    },
    {
      "id": 110504456112644098,
      "target": "Frica te poate face ușor să-ți pierzi mințile."
    },
    {
      "id": 110504456112644097,
      "target": "E înfricoșător să mori."
    }
  ]
}
