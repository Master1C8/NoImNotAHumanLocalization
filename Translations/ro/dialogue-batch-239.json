  "entries": [
    {
      "id": 110504454783049734,
      "target": "Buddy: Aveam un câine, iar zilele trecute… a murit."
    },
    {
      "id": 110504454783049733,
      "target": "Buddy: Dar, de fapt… Nu mai pot continua așa."
    },
    {
      "id": 110504454783049732,
      "target": "Buddy: …"
    },
    {
      "id": 110504454783049731,
      "target": "Buddy: Nu pot… O să mă privești strâmb."
    },
    {
      "id": 110504454783049730,
      "target": "Va trebui să-mi spui. Altfel o să fie mai rău"
    },
    {
      "id": 110504454783049729,
      "target": "Spune-mi doar ce se întâmplă cu tine"
    },
    {
      "id": 110504454783049728,
      "target": "Buddy: Nu-i treaba ta, amice! Lasă-mă în pace!"
    },
    {
      "id": 110504454778855433,
      "target": "Spune-mi, ce se întâmplă cu tine?"
    },
    {
      "id": 110504454778855432,
      "target": "Buddy: Întreabă-mă, amice."
    },
    {
      "id": 110504454778855431,
      "target": "Buddy: Mulțumesc, chiar nu mă simt în apele mele."
    },
    {
      "id": 110504454778855430,
      "target": "Buddy: Lasă-mă în pace."
    },
    {
      "id": 110504454778855429,
      "target": "Buddy: Nu mă presa! Și așa mă apasă sufletul."
    },
    {
      "id": 110504454778855428,
      "target": "Bine, nu mă mai bag"
    },
    {
      "id": 110504454778855427,
      "target": "Trebuie să știu"
    },
    {
      "id": 110504454778855426,
      "target": "Buddy: Ascultă, chiar nu vreau să vorbesc despre asta."
    },
    {
      "id": 110504454778855425,
      "target": "Bine, nu mă mai bag"
    },
    {
      "id": 110504454778855424,
      "target": "Trebuie să știu"
    },
    {
      "id": 110504454774661130,
      "target": "Buddy: Nu contează, oricum n-ai să înțelegi."
    },
    {
      "id": 110504454774661128,
      "target": "Ce subiect?"
    },
    {
      "id": 110504454774661127,
      "target": "Buddy: Nu vreau să aduc vorba despre asta."
    },
    {
      "id": 110504454774661126,
      "target": "Buddy: …"
    },
    {
      "id": 110504454774661125,
      "target": "Buddy: Eu…"
    },
    {
      "id": 110504454774661123,
      "target": "Pari cam posomorât azi"
    },
    {
      "id": 110504454774661122,
      "target": "Buddy: Întreabă-mă, amice."
    },
    {
      "id": 110504454774661121,
      "target": "Buddy: Nu contează, doar m-am pus pe gânduri."
    },
    {
      "id": 110504454774661120,
      "target": "Buddy: …"
    },
    {
      "id": 110504454770466825,
      "target": "Buddy: Hm…"
    },
    {
      "id": 110504454770466824,
      "target": "Buddy: Nu, doar că eu…"
    },
    {
      "id": 110504454770466823,
      "target": "Buddy: Nu contează, uită."
    },
    {
      "id": 110504454770466822,
      "target": "Buddy: …"
    },
    {
      "id": 110504454770466821,
      "target": "Buddy: A? Ce?"
    },
    {
      "id": 110504454770466820,
      "target": "De ce ai încremenit?"
    },
    {
      "id": 110504454770466819,
      "target": "E totul în regulă?"
    },
    {
      "id": 110504454770466818,
      "target": "Buddy: …"
    },
    {
      "id": 110504454770466817,
      "target": "Buddy: …"
    },
    {
      "id": 110504454770466816,
      "target": "Buddy: Fir-ar, dacă n-ar fi fost toată porcăria asta, amice, am fi putut să bem bere și să ne uităm la fotbal. Ți-aș fi făcut cunoștință cu…"
    },
    {
      "id": 110504454766272519,
      "target": "Buddy: …"
    },
    {
      "id": 110504454766272518,
      "target": "Buddy: Bine, fie! Păstrează-ți secretele!"
    },
    {
      "id": 110504454766272517,
      "target": "Buddy: De unde ai făcut rost? Ai vreun neam care lucrează la o fabrică de bere, nu?"
    },
    {
      "id": 110504454766272516,
      "target": "Buddy: M-am uitat în frigiderul tău. Fir-ar, dacă știam că ai ATÂTA BERE…"
    },
    {
      "id": 110504454766272515,
      "target": "Buddy: E beton, amice!"
    },
    {
      "id": 110504454766272513,
      "target": "Ce mai faci?"
    },
    {
      "id": 110504454766272512,
      "target": "Buddy: Întreabă-mă, amice."
    }
  ]
