  "entries": [
    {
      "id": 110504455957454853,
      "target": "FortuneTeller: Mă tem că n-are rost. Îmi pare rău. Nici afirmațiile n-au ajutat…"
    },
    {
      "id": 110504455957454852,
      "target": "FortuneTeller: …"
    },
    {
      "id": 110504455957454851,
      "target": "FortuneTeller: Iar fără aspirații nu vor veni nici rezultatele — universul pur și simplu nu te va auzi și nu le va materializa."
    },
    {
      "id": 110504455957454850,
      "target": "FortuneTeller: În aura ta… Nu-ți dorești fericirea. În tine e doar un gol."
    },
    {
      "id": 110504455957454849,
      "target": "FortuneTeller: Stai puțin… Cum de nu am văzut asta mai devreme…"
    },
    {
      "id": 110504455957454848,
      "target": "FortuneTeller: Nici măcar nu încerci!"
    },
    {
      "id": 110504455953260555,
      "target": "Ce căcaturi sunt astea?"
    },
    {
      "id": 110504455953260553,
      "target": "Eu sunt un om fericit!"
    },
    {
      "id": 110504455953260552,
      "target": "FortuneTeller: Continuă."
    },
    {
      "id": 110504455953260551,
      "target": "Ce căcaturi sunt astea?"
    },
    {
      "id": 110504455953260549,
      "target": "Eu sunt un om fericit!"
    },
    {
      "id": 110504455953260548,
      "target": "FortuneTeller: Repetă după mine: eu sunt un om fericit!"
    },
    {
      "id": 110504455953260547,
      "target": "FortuneTeller: Dar destul cu vorbele — să trecem la practică."
    },
    {
      "id": 110504455953260546,
      "target": "FortuneTeller: Bine, nu te lăsa pradă deznădejdii. Afirmațiile făcute regulat pentru fericire te vor ajuta."
    },
    {
      "id": 110504455953260545,
      "target": "FortuneTeller: Ciudat, ar fi trebuit să ajute."
    },
    {
      "id": 110504455953260544,
      "target": "FortuneTeller: …"
    },
    {
      "id": 110504455949066252,
      "target": "FortuneTeller: Ce, n-a ajutat?"
    },
    {
      "id": 110504455949066251,
      "target": "Ce pula mea?"
    },
    {
      "id": 110504455949066250,
      "target": "Ar fi trebuit?"
    },
    {
      "id": 110504455949066249,
      "target": "FortuneTeller: Ei, a ajutat? Simți deja un val de fericire?"
    },
    {
      "id": 110504455949066248,
      "target": "FortuneTeller: …"
    },
    {
      "id": 110504455949066247,
      "target": "FortuneTeller: SĂ EXECUȚI DANSUL CAPRICORNULUI!"
    },
    {
      "id": 110504455949066246,
      "target": "FortuneTeller: Trebuie doar să…"
    },
    {
      "id": 110504455949066245,
      "target": "FortuneTeller: Știi, cred că știu ce te-ar putea ajuta să-ți pui energia în mișcare."
    },
    {
      "id": 110504455949066244,
      "target": "FortuneTeller: …"
    },
    {
      "id": 110504455949066243,
      "target": "Esenin: Bine, cum spui tu."
    },
    {
      "id": 110504455949066242,
      "target": "Esenin: …"
    },
    {
      "id": 110504455949066241,
      "target": "Esenin: Mulțumesc că m-ai ascultat, proprietarule."
    },
    {
      "id": 110504455949066240,
      "target": "Esenin: Știi, parcă mă simt puțin mai bine."
    },
    {
      "id": 110504455944871945,
      "target": "Esenin: …"
    },
    {
      "id": 110504455944871944,
      "target": "O poezie ca oricare alta."
    },
    {
      "id": 110504455944871943,
      "target": "Frumos."
    },
    {
      "id": 110504455944871942,
      "target": "Esenin: Cam asta e poezia. Ce zici?"
    },
    {
      "id": 110504455944871941,
      "target": "Nu, mulțumesc."
    },
    {
      "id": 110504455944871940,
      "target": "Sigur."
    },
    {
      "id": 110504455944871939,
      "target": "Esenin: Proprietarule, te superi dacă-ți citesc o poezie?"
    },
    {
      "id": 110504455944871938,
      "target": "Esenin: Am găsit la tine o carte de poezii."
    },
    {
      "id": 110504455944871937,
      "target": "Esenin: …"
    }
  ]
}
