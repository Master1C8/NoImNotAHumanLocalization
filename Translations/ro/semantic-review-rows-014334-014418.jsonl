{"ordinal":14364,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452492959749","collection":"Dialogs","key":"line:Teacher_Photo_Gun_048818b","source":"Teacher: Просто сделайте это…","target":"Teacher: Faceți-o odată…","batchPath":"Translations/ro/dialogue-batch-365.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
