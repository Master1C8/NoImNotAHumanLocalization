{"ordinal":13714,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452736229377","collection":"Dialogs","key":"line:Cold_Ears_0d082da","source":"Cold: ...","target":"Cold: ...","batchPath":"Translations/ro/dialogue-batch-350.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
