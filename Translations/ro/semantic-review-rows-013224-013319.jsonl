{"ordinal":13298,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452945944577","collection":"Dialogs","key":"line:Doctor_Hands_0f8b7b6","source":"Doctor: Стараюсь держать эти руки в тонусе, чтобы не расслабляться.","target":"Doctor: Încerc să-mi mențin mâinile în formă, ca să nu-mi ies din mână.","batchPath":"Translations/ro/dialogue-batch-335.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
{"ordinal":13299,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452945944576","collection":"Dialogs","key":"line:Doctor_Hands_03db016","source":"Doctor: ...","target":"Doctor: ...","batchPath":"Translations/ro/dialogue-batch-335.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
