{"ordinal":13286,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452950138888","collection":"Dialogs","key":"line:Doctor_Eyes_0b7356c","source":"Достать ружьё","target":"Scoate pușca","batchPath":"Translations/ro/dialogue-batch-001.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
