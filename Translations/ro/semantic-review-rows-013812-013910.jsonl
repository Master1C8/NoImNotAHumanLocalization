{"ordinal":13841,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452681703428","collection":"Dialogs","key":"line:Hunter_Photo_Gun_0a26479","source":"Hunter: Ох...","target":"Hunter: Of...","batchPath":"Translations/ro/dialogue-batch-353.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
