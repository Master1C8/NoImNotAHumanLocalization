{"ordinal":13834,"stableId":"string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452681703435","collection":"Dialogs","key":"line:Hunter_Ears_Gun_0a102d1","source":"Hunter: Ага. Это я — Гость, получается?","target":"Hunter: Aha. Deci eu sunt un Musafir?","batchPath":"Translations/ro/dialogue-batch-353.json","reviewResult":"read-with-adjacent-scene-and-branch-context"}
