  "entries": [
    {"id": 110504456284610560, "target": "Widow: تو…"},
    {"id": 110504456280416267, "target": "Widow: …"},
    {"id": 110504456280416266, "target": "Widow: فقط می‌خواهم کمی نفس تازه کنم."},
    {"id": 110504456280416265, "target": "Widow: فکر نمی‌کنم مدت زیادی بمانم."},
    {"id": 110504456280416262, "target": "Widow: همه بی‌خیال نبودند."},
    {"id": 110504456280416261, "target": "Widow: شاید هنوز زنده بود، اگر…"},
    {"id": 110504456280416260, "target": "Widow: حالا مرده است."},
    {"id": 110504456280416259, "target": "Widow: حالا دیگر نه. آن وقت که لازم بود، هیچ‌کس کمک نکرد."},
    {"id": 110504456280416256, "target": "Widow: حالا حتی نمی‌توانم درست‌وحسابی دفنش کنم. دیگر رها کردنش بی‌معناست."},
    {"id": 110504456276221961, "target": "Widow: او مرده است."},
    {"id": 110504456276221960, "target": "Widow: شوهر من است."},
    {"id": 110504456276221959, "target": "دوستت به کمک نیاز دارد؟"},
    {"id": 110504456276221958, "target": "حال همراهت بد است؟"},
    {"id": 110504456276221957, "target": "Widow: دیگر فرقی نمی‌کند سر از کجا دربیاورم."},
    {"id": 110504456276221956, "target": "Widow: من… فقط می‌خواهم جایی بیفتم و دیگر بلند نشوم."},
    {"id": 110504456276221955, "target": "دوستت به کمک نیاز دارد؟"},
    {"id": 110504456276221954, "target": "حال همراهت بد است؟"},
    {"id": 110504456276221953, "target": "Widow: خیلی خسته‌ام. اگر استراحت نکنم، همین زیر پنجره‌ها از پا می‌افتم."},
    {"id": 110504456276221952, "target": "Widow: دیگر یادم نیست. فرقی نمی‌کند از کجا."},
    {"id": 110504456272027658, "target": "بعد از این کجا می‌روی؟"},
    {"id": 110504456272027657, "target": "از کجا آمده‌ای؟"},
    {"id": 110504456272027656, "target": "Widow: می‌توانم پیش تو استراحت کنم؟"},
    {"id": 110504456272027655, "target": "Widow: …"}
  ]
}
