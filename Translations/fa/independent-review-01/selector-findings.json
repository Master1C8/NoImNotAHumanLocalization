    {
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451851231233",
      "key": "line:Anger_Photo_DontShoot_0d1b77b",
      "source": "Anger: Ну и вот, блять. Нет ни фотки, ни бабки.",
      "nodeNames": [
        "Anger_Photo_DontShoot"
      ]
