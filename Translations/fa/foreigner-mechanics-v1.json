  "entries": [
    {
      "key": "line:FEMA_GivingPostcard_Foreigner_0af7d0d",
      "parts": [
        {
          "kind": "opaque",
          "text": "Bashe, migiram..."
        }
      ]
    },
    {
      "key": "line:FEMA_GivingPostcard_Foreigner_0cc7047",
      "parts": [
        {
          "kind": "opaque",
          "text": "In chiye?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_1_0e957d2",
      "parts": [
        {
          "kind": "understood",
          "text": "موووفففق باشی!",
          "sourceCue": "Уууудаси!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_1_0c936e3",
      "parts": [
        {
          "kind": "opaque",
          "text": "Shayad baad az in hame vaght beresam khune…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_1_0905b5d",
      "parts": [
        {
          "kind": "opaque",
          "text": "Vali farda miram istgah va khodam mifahmam!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_1_0e19b62",
      "parts": [
        {
          "kind": "opaque",
          "text": "Nafahmidam, bebakhsh."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_0ee031f",
      "parts": [
        {
          "kind": "understood",
          "text": "خداحافففظ!",
          "sourceCue": "Пайкааа!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_02340b2",
      "parts": [
        {
          "kind": "opaque",
          "text": "Emshab miram. Khodahafez!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_04527f2",
      "parts": [
        {
          "kind": "opaque",
          "text": "Farda rah mioftam taraf khune! Hadaghal miram istgah."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_08b6c83",
      "parts": [
        {
          "kind": "opaque",
          "text": "Nemifahmam, rafigh."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_5_058e3f1",
      "parts": [
        {
          "kind": "opaque",
          "text": "Tunestan behem began ke ghatarha hanuz miran! Bavar mikoni?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_5_0a05381",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ah, manzuret une."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_2_043501e",
      "parts": [
        {
          "kind": "opaque",
          "text": "Hanuz harakat mikonan? Bayad ettelaat peyda konam, mamnun!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_2_020fa6b",
      "parts": [
        {
          "kind": "opaque",
          "text": "Yani ba keshti beram?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_1_0264fa8",
      "parts": [
        {
          "kind": "opaque",
          "text": "Shayad vaghean hanuz beshe ba havapeyma raft."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_1_03e6625",
      "parts": [
        {
          "kind": "opaque",
          "text": "Bayad az ye ja ettelaat begiram."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_1_06190d7",
      "parts": [
        {
          "kind": "opaque",
          "text": "Havapeyma? Fekr mikoni hanuz parvaz mikonan?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_0f3f5f9",
      "parts": [
        {
          "kind": "opaque",
          "text": "Vaziyat tokhmie, jure dige nemishe goft."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_00450ac",
      "parts": [
        {
          "kind": "opaque",
          "text": "Umadam didane dustam, hala in shod."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_04109c2",
      "parts": [
        {
          "kind": "opaque",
          "text": "Khune? Darbareye khune miporsi?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_0ba0261",
      "parts": [
        {
          "kind": "opaque",
          "text": "Che vahshati."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_084c32d",
      "parts": [
        {
          "kind": "opaque",
          "text": "Yani khune ye man ham hamin ettefagh miofte?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_05970a6",
      "parts": [
        {
          "kind": "opaque",
          "text": "Sakhte, vali shayad behem komak kone."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_0ef9d29",
      "parts": [
        {
          "kind": "understood",
          "text": "خووب.",
          "sourceCue": "Харасхо."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_0a6ab5a",
      "parts": [
        {
          "kind": "understood",
          "text": "خو…",
          "sourceCue": "Хара…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_041d9b1",
      "parts": [
        {
          "kind": "understood",
          "text": "خوبووو.",
          "sourceCue": "Харохооо."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_0a21905",
      "parts": [
        {
          "kind": "opaque",
          "text": "Say mikonam tekrar konam."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_2_04c6bc4",
      "parts": [
        {
          "kind": "opaque",
          "text": "Shayad kalameye soal bashe."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_2_090b6a7",
      "parts": [
        {
          "kind": "opaque",
          "text": "Vali ye chizi porsidi."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_1_01c288c",
      "parts": [
        {
          "kind": "opaque",
          "text": "Shayad kalameye soal bashe."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_1_01a5f8a",
      "parts": [
        {
          "kind": "opaque",
          "text": "Hanuz nemifahmam. Vali ye chizi porsidi."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_09e3b4a",
      "parts": [
        {
          "kind": "understood",
          "text": "چطور.",
          "sourceCue": "Как."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_0f0190b",
      "parts": [
        {
          "kind": "opaque",
          "text": "Shayad injuri hadaghal befahmam chi migam."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_075bcb9",
      "parts": [
        {
          "kind": "opaque",
          "text": "Mitunam kalamehat ro tekrar konam, to ham vakonesh neshun bedi."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_1_1_0ebd34d",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ye zabune moshtarak besazim?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_1_1_0cd4635",
      "parts": [
        {
          "kind": "opaque",
          "text": "Nemifahmamet. Chi mishe kard?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_1_0d71f9d",
      "parts": [
        {
          "kind": "opaque",
          "text": "DAHANAM RO DUKHTAN! Faghat chon harfam ro nemifahman."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_1_09c22e5",
      "parts": [
        {
          "kind": "opaque",
          "text": "In ye kabuse!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Death_0f116b2",
      "parts": [
        {
          "kind": "opaque",
          "text": "Kosh… tan…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Death_0b50221",
      "parts": [
        {
          "kind": "opaque",
          "text": "Hamin mishe. Nemifahmanet, azat mitarsan, va to…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Ears_DontShoot_00a90ca",
      "parts": [
        {
          "kind": "opaque",
          "text": "Hame chizam ro midam dobare bebinamesh. Kheyli delam barash tang shode. "
        },
        {
          "kind": "understood",
          "text": "نشوون",
          "sourceCue": "Пакаж"
        },
        {
          "kind": "opaque",
          "text": ", in yani chi?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Photo_DontShoot_0bf7704",
      "parts": [
        {
          "kind": "opaque",
          "text": "Aks dust daram. To engar ghadresh ro nemiduni…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Armpit_DontShoot_05058dc",
      "parts": [
        {
          "kind": "understood",
          "text": "بررسسی",
          "sourceCue": "Правирйат ба"
        },
        {
          "kind": "opaque",
          "text": " inja… Dorost be nazar nemiad…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Eyes_DontShoot_044b445",
      "parts": [
        {
          "kind": "opaque",
          "text": "Cheshme, mese hameye cheshmha. Chera mitarsuni?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Hands_DontShoot_062d5bf",
      "parts": [
        {
          "kind": "opaque",
          "text": "Bayad dastam ro beshuram…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Teeth_DontShoot_0f917b2",
      "parts": [
        {
          "kind": "opaque",
          "text": "Khodet miduni dahanam ro dukhtan. Hala aslahe migiri va "
        },
        {
          "kind": "understood",
          "text": "شلییک",
          "sourceCue": "расрел"
        },
        {
          "kind": "opaque",
          "text": " be hame…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Ears_Gun_022cef2",
      "parts": [
        {
          "kind": "opaque",
          "text": "Va baad chi?!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Armpit_Gun_0488113",
      "parts": [
        {
          "kind": "opaque",
          "text": "Mard! Bas kon! Che mozakhrafie!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Eyes_Gun_0bf3d2f",
      "parts": [
        {
          "kind": "opaque",
          "text": "Nakon! Man khubam! Faghat hamdige ro nemifahmim!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Hands_Gun_0b64782",
      "parts": [
        {
          "kind": "opaque",
          "text": "Aslahe ro kenar bezar! Hich badi behet nakardam!!!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Teeth_Gun_0a4207d",
      "parts": [
        {
          "kind": "opaque",
          "text": "Baraye chi, chet shode!? Kari ro kardam ke mikhasti!!!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Ears_0f4eb6c",
      "parts": [
        {
          "kind": "opaque",
          "text": "Gushvare az duste azizam."
        }
      ]
    },
    {
      "key": "line:Foreigner_Ears_076f3a7",
      "parts": [
        {
          "kind": "opaque",
          "text": "Gushe, mese hameye gushha."
        }
      ]
    },
    {
      "key": "line:Foreigner_Photo_002e8e0",
      "parts": [
        {
          "kind": "opaque",
          "text": "Neshun midi?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Photo_0c3c7aa",
      "parts": [
        {
          "kind": "opaque",
          "text": "Aks? Asheghesham!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Armpit_0d48250",
      "parts": [
        {
          "kind": "opaque",
          "text": "Razi shodi?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Armpit_090c5f5",
      "parts": [
        {
          "kind": "opaque",
          "text": "Az in hame chiz sar darnemiaram… Bashe dige…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Eyes_0b39cdc",
      "parts": [
        {
          "kind": "opaque",
          "text": "Hanuz nemifahmam in hame ro baraye chi mikhay… "
        },
        {
          "kind": "understood",
          "text": "خورشیید",
          "sourceCue": "Солце"
        },
        {
          "kind": "opaque",
          "text": " mitune shabakiye ro besuzune. Man "
        },
        {
          "kind": "understood",
          "text": "نگااه",
          "sourceCue": "смарет"
        },
        {
          "kind": "opaque",
          "text": " nemikonam be "
        },
        {
          "kind": "understood",
          "text": "خورشیید",
          "sourceCue": "солце"
        },
        {
          "kind": "opaque",
          "text": "."
        }
      ]
    },
    {
      "key": "line:Foreigner_Eyes_0aba9fb",
      "parts": [
        {
          "kind": "opaque",
          "text": "Cheshm?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Hands_0144f06",
      "parts": [
        {
          "kind": "opaque",
          "text": "Chera in karha ro mikoni? "
        },
        {
          "kind": "understood",
          "text": "کشتن",
          "sourceCue": "Убйивай"
        },
        {
          "kind": "opaque",
          "text": " baraye tafrih?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Hands_0654052",
      "parts": [
        {
          "kind": "opaque",
          "text": "Dast? Bashe."
        }
      ]
    },
    {
      "key": "line:Foreigner_Teeth_02674b3",
      "parts": [
        {
          "kind": "opaque",
          "text": "Hala chi?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Teeth_03ba689",
      "parts": [
        {
          "kind": "opaque",
          "text": "Chi? Be "
        },
        {
          "kind": "understood",
          "text": "دهاان",
          "sourceCue": "рхот"
        },
        {
          "kind": "opaque",
          "text": " eshare mikoni? Are, dukhtanesh. Hala chi? Labkhand bezanam?"
        }
      ]
    },
    {
      "key": "line:Foreigner_WannaCheck_0d955c8",
      "parts": [
        {
          "kind": "opaque",
          "text": "Hichi nemifahmam. Az man chi mikhay?"
        }
      ]
    }
