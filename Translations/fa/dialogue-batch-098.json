  "entries": [
    {"id": 110504456750178312, "target": "SuperFake: با من بیا."},
    {"id": 110504456750178311, "target": "SuperFake: خب، قانون تازهٔ ما هم کار خودش را کرد."},
    {"id": 110504456750178310, "target": "SuperFake: هوم…"},
    {"id": 110504456750178307, "target": "SuperFake: در خانه تنهایی؟"},
    {"id": 110504456750178306, "target": "SuperFake: اما اول قانون تازهٔ ما را امتحان می‌کنیم."},
    {"id": 110504456750178305, "target": "SuperFake: البته! همین حالا می‌روم."},
    {"id": 110504456745984010, "target": "SuperFake: در خانه تنهایی؟"},
    {"id": 110504456745984009, "target": "SuperFake: اما پیش از آن…"},
    {"id": 110504456745984008, "target": "SuperFake: حالا امتحانش می‌کنیم."},
    {"id": 110504456745984007, "target": "SuperFake: ساده است."},
    {"id": 110504456745984006, "target": "می‌توانی بعداً بیایی؟"},
    {"id": 110504456745984005, "target": "نمی‌فهمم"},
    {"id": 110504456745984004, "target": "SuperFake: در را برایم باز خواهی کرد."},
    {"id": 110504456745984003, "target": "SuperFake: اگر دست‌کم دو نفر از افراد من در خانه‌ات باشند…"},
    {"id": 110504456745984002, "target": "SuperFake: بیا این را عوض کنیم."},
    {"id": 110504456745984001, "target": "SuperFake: انگار خودت هم برایت مهم نیستی."},
    {"id": 110504456745984000, "target": "SuperFake: یک‌جورهایی بی‌تفاوتی."},
    {"id": 110504456741789707, "target": "می‌توانی بعداً بیایی؟"},
    {"id": 110504456741789706, "target": "نمی‌فهمم"},
    {"id": 110504456741789705, "target": "SuperFake: چون حالا سگ‌ها در بدن‌ها ساکن‌اند."},
    {"id": 110504456741789704, "target": "SuperFake: در را برایم باز خواهی کرد."},
    {"id": 110504456741789703, "target": "SuperFake: اگر دست‌کم دو نفر از افراد من در خانه‌ات باشند…"},
    {"id": 110504456741789702, "target": "SuperFake: من و تو قانون‌های تازه‌ای را امتحان می‌کنیم."},
    {"id": 110504456741789701, "target": "SuperFake: پیداست که باید کمکت کرد."},
    {"id": 110504456741789700, "target": "SuperFake: برایت سخت است."}
  ]
}
