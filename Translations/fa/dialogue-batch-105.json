  "entries": [
    {"id": 110504456678875142, "target": "صفحهٔ دهم؟"},
    {"id": 110504456678875141, "target": "بگذار وسط صفحهٔ 200 باشد"},
    {"id": 110504456678875140, "target": "نزدیک آخرش را باز کن"},
    {"id": 110504456678875139, "target": "Prophet: شاید تو بتوانی راهنمایی‌ام کنی."},
    {"id": 110504456678875138, "target": "Prophet: لطفاً یک بار دیگر با کتاب برایم فال بگیر."},
    {"id": 110504456678875137, "target": "Prophet: …"},
    {"id": 110504456678875136, "target": "Prophet: خودم هم دیگر گیج شده‌ام."},
    {"id": 110504456674680843, "target": "Prophet: نمی‌فهمم، این برای من است؟ یا پیامی برای توست؟"},
    {"id": 110504456674680842, "target": "Prophet: فقط یک فکر توی سرم است: «بپر»."},
    {"id": 110504456674680841, "target": "Prophet: من… دیگر حتی یادم نیست."},
    {"id": 110504456674680840, "target": "داری می‌میری؟"},
    {"id": 110504456674680839, "target": "از چه کسی حرف می‌زنی؟"},
    {"id": 110504456674680838, "target": "Prophet: پس چرا این کار را شروع کردی؟"},
    {"id": 110504456674680837, "target": "Prophet: حالا چه؟ قرار است همه‌چیز را پس بگیرد؟"},
    {"id": 110504456674680836, "target": "Prophet: او پشتیبانم بود."},
    {"id": 110504456674680835, "target": "داری می‌میری؟"},
    {"id": 110504456674680834, "target": "از چه کسی حرف می‌زنی؟"},
    {"id": 110504456674680833, "target": "Prophet: دیگر با من بازی نکن. رهایم کن."},
    {"id": 110504456674680832, "target": "Prophet: فهمیدم. خیلی وقت است که وقتش رسیده."},
    {"id": 110504456670486539, "target": "Prophet: فکرهایم کمتر شده‌اند."},
    {"id": 110504456670486538, "target": "Prophet: فکر می‌کنم برای این آرزو خیلی دیر کرده‌ای."},
    {"id": 110504456670486537, "target": "ظاهرت… خوب نیست"},
    {"id": 110504456670486536, "target": "فقط روی ایوان نمیر"},
    {"id": 110504456670486535, "target": "Prophet: او مرا ترک کرده؟"},
    {"id": 110504456670486534, "target": "Prophet: بینایی‌ام ضعیف شده. حالا حتی با چشم‌هایم هم درست نمی‌بینم."},
    {"id": 110504456670486533, "target": "Prophet: چهره‌ات را فراموش کرده‌ام."}
  ]
}
