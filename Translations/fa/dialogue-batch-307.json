    {
      "id": 110504453839331332,
      "target": "Rocker: وای."
    },
    {
      "id": 110504453839331331,
      "target": "Rocker: ..."
    },
    {
      "id": 110504453839331330,
      "target": "Rocker: بیا، لااقل با تو عکس بگیرم."
    },
    {
      "id": 110504453835137035,
      "target": "Rocker: چیز جالبی پیدا کردی؟"
    },
    {
      "id": 110504453835137034,
      "target": "Rocker: ..."
    },
    {
      "id": 110504453835137033,
      "target": "Rocker: حتماً، بفرما."
    },
    {
      "id": 110504453835137030,
      "target": "Rocker: کاش من هم چشم‌هایی مثل او داشتم…"
    },
    {
      "id": 110504453835137029,
      "target": "Rocker: یارو کاملاً نابینا شد. اما کاش چشم‌هایش را می‌دیدی."
    },
    {
      "id": 110504453835137028,
      "target": "Rocker: نه برای من."
    },
    {
      "id": 110504453835137027,
      "target": "Rocker: ..."
    },
    {
      "id": 110504453835137026,
      "target": "Unstable: هنوز آن ماجرای لرزیدن را به یاد می‌آورم."
    },
    {
      "id": 110504453835137025,
      "target": "Rocker: یک بار به سرمان زد جوهر را مستقیم توی چشم‌ها فرو کنیم."
    },
    {
      "id": 110504453830942730,
      "target": "Rocker: دیگر یادم نیست…"
    },
    {
      "id": 110504453830942729,
      "target": "Rocker: یا شاید اصلاً خال‌کوبی نیست."
    },
    {
      "id": 110504453830942728,
      "target": "Rocker: صبر کن."
    },
    {
      "id": 110504453830942727,
      "target": "Rocker: توی یک عرق‌خوری حسابی زدیمش. خال‌کوب از سر خوش‌گذرانی مست کرد، من هم برای پیدا کردن جرئت."
    },
    {
      "id": 110504453830942726,
      "target": "Rocker: ..."
    },
    {
      "id": 110504453830942725,
      "target": "Rocker: یک خال‌کوبی دارم."
    },
    {
      "id": 110504453830942722,
      "target": "Rocker: و این تنها چیزی است که از رفقایم برایم مانده. جرم روی دندان‌هایم."
    },
    {
      "id": 110504453830942721,
      "target": "Rocker: ..."
    },
    {
      "id": 110504453830942720,
      "target": "Rocker: فکرش را بکن…"
    },
    {
      "id": 110504453826748427,
      "target": "Rocker: آررره، این دندان‌ها چقدر دود غلیظ به خودشان گرفته‌اند."
    },
    {
      "id": 110504453826748420,
      "target": "Rocker: بزن بریم. شاید هنوز برای راه انداختن خفن‌ترین شور و حال دیر نشده باشد."
    }
  ]
