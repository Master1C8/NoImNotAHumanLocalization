  "entries": [
    {
      "id": 110504454455894021,
      "target": "Widow: امیدوارم آنچه را دنبالش هستید پیدا کنید."
    },
    {
      "id": 110504454455894020,
      "target": "Widow: کم حرف می‌زنید، اما… هم‌صحبت خوبی بودید."
    },
    {
      "id": 110504454455894019,
      "target": "Widow: ممنونم."
    },
    {
      "id": 110504454455894018,
      "target": "Widow: تا برنگردم، نمی‌خواهم دربارهٔ چیزی تصمیم بگیرم."
    },
    {
      "id": 110504454455894017,
      "target": "Widow: خیلی دلم می‌خواهد بروم خانه."
    },
    {
      "id": 110504454455894016,
      "target": "Widow: نسبت به تو حسی ندارم، ببخش."
    },
    {
      "id": 110504454451699715,
      "target": "Widow: حالم بهتر نمی‌شود."
    },
    {
      "id": 110504454451699714,
      "target": "Widow: برای چه؟"
    },
    {
      "id": 110504454451699713,
      "target": "موفق باشی"
    },
    {
      "id": 110504454451699712,
      "target": "می‌توانی بمانی"
    },
    {
      "id": 110504454447505416,
      "target": "Widow: دیگر هیچ‌چیز نمی‌خواهم."
    },
    {
      "id": 110504454447505415,
      "target": "Widow: برمی‌گردیم خانه."
    },
    {
      "id": 110504454447505414,
      "target": "Widow: دیگر کسی نمانده."
    },
    {
      "id": 110504454447505413,
      "target": "موفق باشی"
    },
    {
      "id": 110504454447505412,
      "target": "می‌توانی بمانی"
    },
    {
      "id": 110504454447505411,
      "target": "Widow: و آنجا…"
    },
    {
      "id": 110504454447505410,
      "target": "Widow: گیتار را درمی‌آورم."
    },
    {
      "id": 110504454447505409,
      "target": "Widow: برمی‌گردم خانه."
    },
    {
      "id": 110504454447505408,
      "target": "Widow: نمی‌خواهم به آن فکر کنم."
    },
    {
      "id": 110504454443311116,
      "target": "می‌روی پیش خویشاوندانت؟"
    },
    {
      "id": 110504454443311115,
      "target": "حالا چه می‌کنی؟"
    },
    {
      "id": 110504454443311114,
      "target": "Widow: فقط لازم بود کمی استراحت کنم."
    },
    {
      "id": 110504454443311113,
      "target": "Widow: از همان اول گفتم نمی‌خواهم زیاد بمانم."
    },
    {
      "id": 110504454443311112,
      "target": "Widow: امشب می‌روم."
    },
    {
      "id": 110504454443311110,
      "target": "چیزی شده؟"
    },
    {
      "id": 110504454443311109,
      "target": "Widow: کاش کمی استراحت کنم…"
    },
    {
      "id": 110504454443311108,
      "target": "Widow: زندگی بدون او حالا خیلی سخت است…"
    },
    {
      "id": 110504454443311107,
      "target": "Widow: بله. لطفاً."
    },
    {
      "id": 110504454443311106,
      "target": "Widow: می‌خواهم تنها باشم."
    },
    {
      "id": 110504454443311105,
      "target": "Widow: …"
    },
    {
      "id": 110504454443311104,
      "target": "Widow: شما کشتید؛ روحش برای شما می‌ماند. برای من فقط این می‌ماند که فریاد بزنم دلم برای هیچ‌کس نمی‌سوزد."
    },
    {
      "id": 110504454439116811,
      "target": "Widow: …"
    },
    {
      "id": 110504454439116810,
      "target": "Widow: واقعاً آنجا…"
    },
    {
      "id": 110504454439116809,
      "target": "Widow: و او…"
    },
    {
      "id": 110504454439116808,
      "target": "Widow: کار آن احمق‌های عوضی همیشه به‌هم‌ریخته است، برای همین کافی بود روپوش پزشکی بپوشم و وارد سردخانه شوم."
    },
    {
      "id": 110504454439116807,
      "target": "Widow: نمی‌شود او را به خانه برد."
    },
    {
      "id": 110504454439116806,
      "target": "Widow: نمی‌شود جسدش را دید."
    },
    {
      "id": 110504454439116805,
      "target": "Widow: همین."
    },
    {
      "id": 110504454439116804,
      "target": "Widow: گفتند: «او مرده است.»"
    },
    {
      "id": 110504454439116803,
      "target": "Widow: …"
    },
    {
      "id": 110504454439116802,
      "target": "Widow: یک لحظه، ببخشید."
    },
    {
      "id": 110504454439116801,
      "target": "Widow: …"
    },
    {
      "id": 110504454439116800,
      "target": "Widow: فقط خشک و بی‌احساس به من گفتند…"
    },
    {
      "id": 110504454434922503,
      "target": "Widow: زودتر رفتم آنجا، فقط برای اینکه سری به او بزنم."
    },
    {
      "id": 110504454434922502,
      "target": "Widow: …"
    }
  ]
}
