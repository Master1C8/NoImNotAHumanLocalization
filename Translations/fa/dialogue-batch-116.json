  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {"id": 110504456574017540, "target": "Ballerina: این هم هدیهٔ من به تو."},
    {"id": 110504456574017539, "target": "Ballerina: گربه را زیر خانه پیدا می‌کنی."},
    {"id": 110504456574017538, "target": "Ballerina: …"},
    {"id": 110504456574017537, "target": "Ballerina: بیا برویم، پیشی؛ اینجا سرگرمم می‌کنی، نه؟"},
    {"id": 110504456574017536, "target": "Ballerina: مثل خانهٔ خودت راحت باش."},
    {"id": 110504456569823243, "target": "دیگر گورت را گم کن"},
    {"id": 110504456569823242, "target": "…بیا تو"},
    {"id": 110504456569823241, "target": "Ballerina: یک بار دیگر فکر کن."},
    {"id": 110504456569823240, "target": "Ballerina: گربه را می‌بینی؟"},
    {"id": 110504456569823239, "target": "Ballerina: گربه را هم اذیت نکن."},
    {"id": 110504456569823238, "target": "Ballerina: نباید زن را بیرون در سرما نگه داری، آقای جوان."},
    {"id": 110504456569823237, "target": "Ballerina: …"},
    {"id": 110504456569823234, "target": "Ballerina: در را باز می‌کنی؟ نه؟"},
    {"id": 110504456569823233, "target": "Ballerina: از تمام آزمونت گذشتم؟"},
    {"id": 110504456569823232, "target": "Ballerina: این کافی نیست؟"},
    {"id": 110504456565628939, "target": "Ballerina: دو دست دارم، دو پا و یک سر."}
  ]
}
