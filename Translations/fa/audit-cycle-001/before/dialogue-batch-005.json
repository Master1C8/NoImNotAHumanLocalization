  "entries": [
    {"id": 110504457886834696, "target": "Phone: الو؟"},
    {"id": 110504457886834695, "target": "Phone: …"},
    {"id": 110504457886834693, "target": "سلام"},
    {"id": 110504457886834692, "target": "Phone: الو، سلام."},
    {"id": 110504457886834691, "target": "Phone: …"},
    {"id": 110504457886834690, "target": "Phone: …"},
    {"id": 110504457886834689, "target": "Phone: سلام، با رولت تلفنی تماس گرفته‌اید. حالا هم‌صحبت ایدئالتان را پیدا می‌کنیم. لطفاً منتظر بمانید."},
    {"id": 110504457886834688, "target": "Phone: …"},
    {"id": 110504457882640396, "target": "Phone: …"},
    {"id": 110504457882640395, "target": "Phone: خب، پس سؤال آخر: بگویید، در خانه‌تان خونی ریخته شده؟"},
    {"id": 110504457882640394, "target": "Phone: …"},
    {"id": 110504457882640393, "target": "Phone: خوب، پس بگویید قارچ می‌خورید؟"},
    {"id": 110504457882640392, "target": "Phone: …"},
    {"id": 110504457882640391, "target": "Phone: …"},
    {"id": 110504457882640390, "target": "Phone: با مسئولانمان مشورت می‌کنیم و بعداً خبر می‌دهیم."},
    {"id": 110504457882640389, "target": "Phone: گوش‌ها؟ صبر کنید..."},
    {"id": 110504457882640388, "target": "Phone: …"},
    {"id": 110504457882640387, "target": "Phone: …"},
    {"id": 110504457882640386, "target": "Phone: از دوش گرفتن و شستن دست‌ها خودداری کنید."},
    {"id": 110504457882640385, "target": "Phone: برای اینکه نتیجهٔ آزمایش‌های زیربغل درست باشد، باید از هرگونه تماس با آب دوری کنید."},
    {"id": 110504457882640384, "target": "Phone: …"},
    {"id": 110504457878446091, "target": "Phone: …"},
    {"id": 110504457878446090, "target": "Phone: …"},
    {"id": 110504457878446089, "target": "با گوش‌هایم چه کار کنم؟"},
    {"id": 110504457878446088, "target": "با زیربغلم چه کار کنم؟"},
    {"id": 110504457878446087, "target": "Phone: مگه تو کلاً خنگی؟! زود گوشی رو بذار!"},
    {"id": 110504457878446086, "target": "Phone: (زن هنوز فرصت نکرده بود جواب بدهد که فریاد بلند مردی برخاست)"},
    {"id": 110504457878446085, "target": "منظورتان چیست؟"},
    {"id": 110504457878446084, "target": "چی؟ کمیتهٔ وضعیت‌های اضطراری؟ این دیگر چیست؟"},
    {"id": 110504457878446083, "target": "Phone: سلام، با خط ویژهٔ کمیتهٔ وضعیت‌های اضطراری تماس گرفته‌اید. چطور می‌توانیم کمکتان کنیم؟"},
    {"id": 110504457878446082, "target": "مراقب خودت باش (قطع تماس)"},
    {"id": 110504457878446081, "target": "کمیتهٔ وضعیت‌های اضطراری چیست؟"},
    {"id": 110504457878446080, "target": "خوب شد دخترت را نبردند"},
    {"id": 110504457874251787, "target": "ساکنت را کجا بردند؟"},
    {"id": 110504457874251786, "target": "مراقب خودت باش (قطع تماس)"},
    {"id": 110504457874251785, "target": "کمیتهٔ وضعیت‌های اضطراری چیست؟"},
    {"id": 110504457874251784, "target": "خوب شد دخترت را نبردند"},
    {"id": 110504457874251783, "target": "ساکنت را کجا بردند؟"},
    {"id": 110504457874251782, "target": "مراقب خودت باش (قطع تماس)"},
    {"id": 110504457874251781, "target": "کمیتهٔ وضعیت‌های اضطراری چیست؟"},
    {"id": 110504457874251780, "target": "خوب شد دخترت را نبردند"},
    {"id": 110504457874251779, "target": "ساکنت را کجا بردند؟"},
    {"id": 110504457874251778, "target": "مواظب خودت باش (قطع تماس)"},
    {"id": 110504457874251777, "target": "چه کسی آن‌ها را کشت؟"},
    {"id": 110504457874251776, "target": "دخترت حالش خوب است؟"},
    {"id": 110504457870057483, "target": "مواظب خودت باش (قطع تماس)"},
    {"id": 110504457870057482, "target": "چه کسی آن‌ها را کشت؟"},
    {"id": 110504457870057481, "target": "دخترت حالش خوب است؟"},
    {"id": 110504457870057480, "target": "همین حالا با شمارهٔ 891-533 تماس بگیرید تا هم‌صحبت ایدئالتان را برایتان پیدا کنیم."},
    {"id": 110504457870057479, "target": "پس رولت تلفنی درست همان چیزی است که نیاز دارید."},
    {"id": 110504457870057478, "target": "کسی را ندارید که با او حرف بزنید و مضطربید؟"},
    {"id": 110504457870057477, "target": "احساس تنهایی می‌کنید؟"},
    {"id": 110504457870057476, "target": "پانزده سال است دارم درباره‌اش تصمیم می‌گیرم، ولی انگار تصمیم گرفتن سخت است."},
    {"id": 110504457870057475, "target": "آن موقع گفت: «وقتی دیگر نبودم، خودت تصمیم بگیر این جعبه را ببینی یا نه»."},
    {"id": 110504457870057474, "target": "آخه چرا باید دنبال کسی بگردم؟ کاش یکی هم دست از سر من بردارد..."}
  ]
}
