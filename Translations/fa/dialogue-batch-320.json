  "entries": [
    {
      "id": 110504453386346501,
      "target": "Cultist2: لعنتی، می‌ترسم!"
    },
    {
      "id": 110504453386346500,
      "target": "Cultist2: همه‌چیز خوب می‌شود، از ما محافظت می‌کنند، به زندگی بهتری می‌روم، همه‌چیز خوب می‌شود، نباید بترسم."
    },
    {
      "id": 110504453386346499,
      "target": "Cultist2: پس چرا همه‌شان را نگرفته‌اند؟"
    },
    {
      "id": 110504453386346498,
      "target": "Cultist2: چه‌قدر راه برای شناختن مهمان هست…"
    },
    {
      "id": 110504453386346497,
      "target": "Cultist2: ممنون که نشانم دادید."
    },
    {
      "id": 110504453386346496,
      "target": "Cultist2: من از این چیزها سر درنمی‌آورم. ولی زیبا به نظر می‌رسد."
    },
    {
      "id": 110504453382152200,
      "target": "Cultist2: آها، پس این یک عکس معمولی نیست."
    },
    {
      "id": 110504453382152199,
      "target": "Cultist2: حتی گفتن این کلمه هم یک‌جوری خجالت‌آور است."
    },
    {
      "id": 110504453382152198,
      "target": "Cultist2: نمی‌دانم چرا این‌قدر خجالت می‌کشم. با اینکه زیر بغل‌هایم چیز خاصی ندارند."
    },
    {
      "id": 110504453382152197,
      "target": "Cultist2: ولی کاش می‌دانستید دانستن اینکه به‌زودی می‌میری چقدر ترسناک است."
    },
    {
      "id": 110504453382152196,
      "target": "Cultist2: بله، به ما یاد می‌دهند که بعد از آن فقط زندگی آرامی در پیش است."
    },
    {
      "id": 110504453382152195,
      "target": "Cultist2: خیلی امیدوارم همین‌طور باشد. آن‌قدر رنج کشیده‌ام که دیگر وقت استراحت است."
    },
    {
      "id": 110504453382152194,
      "target": "Cultist2: به ما می‌گویند با آمدن مرگ، همهٔ رنج‌ها تمام می‌شوند."
    },
    {
      "id": 110504453382152193,
      "target": "Cultist2: ممنون."
    },
    {
      "id": 110504453377957896,
      "target": "Cultist2: این کار را نکنید."
    },
    {
      "id": 110504453377957895,
      "target": "Cultist2: به ما نگفته بودند که وقتش رسیده."
    },
    {
      "id": 110504453377957892,
      "target": "Cultist2: تازه چیزی نو را امتحان کرده بودم…"
    },
    {
      "id": 110504453377957889,
      "target": "Cultist2: آه…"
    },
    {
      "id": 110504453373763591,
      "target": "Cultist2: بگذارید کمی بیشتر زندگی کنم."
    },
    {
      "id": 110504453373763588,
      "target": "Cultist2: هنوز زود است…"
    },
    {
      "id": 110504453373763585,
      "target": "Cultist2: آه. فکر نمی‌کردم این‌قدر بترسم."
    },
    {
      "id": 110504453369569287,
      "target": "Cultist2: …"
    },
    {
      "id": 110504453369569286,
      "target": "Cultist2: ..."
    },
    {
      "id": 110504453369569285,
      "target": "Cultist2: …"
    },
    {
      "id": 110504453369569282,
      "target": "Cultist2: چه… جالب."
    },
    {
      "id": 110504453369569281,
      "target": "Cultist2: ..."
    },
    {
      "id": 110504453369569280,
      "target": "Cultist2: کمی عصبی‌ام."
    },
    {
      "id": 110504453365374983,
      "target": "Cultist2: هیچ‌وقت از من عکس نگرفته بودند."
    },
    {
      "id": 110504453365374980,
      "target": "Cultist2: …"
    },
    {
      "id": 110504453365374979,
      "target": "Cultist2: ..."
    },
    {
      "id": 110504453365374978,
      "target": "Cultist2: …"
    },
    {
      "id": 110504453361180680,
      "target": "Cultist2: می‌گویند این هم آمدن او را نزدیک‌تر می‌کند."
    },
    {
      "id": 110504453361180679,
      "target": "Cultist2: ..."
    },
    {
      "id": 110504453361180678,
      "target": "Cultist2: ما کم می‌خوابیم."
    },
    {
      "id": 110504453361180675,
      "target": "Cultist2: بله، زندگی آسانی نداریم."
    },
    {
      "id": 110504453361180674,
      "target": "Cultist2: ..."
    },
    {
      "id": 110504453361180673,
      "target": "Cultist2: …"
    },
    {
      "id": 110504453356986374,
      "target": "Cultist2: …"
    },
    {
      "id": 110504453356986373,
      "target": "Cultist2: ..."
    },
    {
      "id": 110504453356986372,
      "target": "Cultist2: کمی کج‌اند و از دندان‌های بقیه بزرگ‌ترند."
    },
    {
      "id": 110504453356986371,
      "target": "Cultist2: بله، البته."
    },
    {
      "id": 110504453352792069,
      "target": "Cultist2: نباید ترسید؛ همهٔ ما به زندگی بهتری می‌رویم. نجاتمان می‌دهند."
    }
  ]
}
