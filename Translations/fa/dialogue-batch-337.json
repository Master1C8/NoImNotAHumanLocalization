  "entries": [
    {
      "id": 110504453013053443,
      "target": "Foreigner: Kosh… tan…"
    },
    {
      "id": 110504453013053442,
      "target": "Foreigner: Hamin mishe. Nemifahmanet, azat mitarsan, va to…"
    },
    {
      "id": 110504453013053441,
      "target": "Foreigner: Hame chizam ro midam dobare bebinamesh. Kheyli delam barash tang shode. نشوون, in yani chi?"
    },
    {
      "id": 110504453013053440,
      "target": "Foreigner: Aks dust daram. To engar ghadresh ro nemiduni…"
    },
    {
      "id": 110504453008859144,
      "target": "Foreigner: بررسسی inja… Dorost be nazar nemiad…"
    },
    {
      "id": 110504453008859143,
      "target": "Foreigner: Cheshme, mese hameye cheshmha. Chera mitarsuni?"
    },
    {
      "id": 110504453008859142,
      "target": "Foreigner: Bayad dastam ro beshuram…"
    },
    {
      "id": 110504453008859141,
      "target": "Foreigner: Khodet miduni dahanam ro dukhtan. Hala aslahe migiri va شلییک be hame…"
    },
    {
      "id": 110504453008859138,
      "target": "Foreigner: Va baad chi?!"
    },
    {
      "id": 110504453004664841,
      "target": "Foreigner: Ha-ha…"
    },
    {
      "id": 110504453004664838,
      "target": "Foreigner: Mard! Bas kon! Che mozakhrafie!"
    },
    {
      "id": 110504453004664835,
      "target": "Foreigner: Nakon! Man khubam! Faghat hamdige ro nemifahmim!"
    },
    {
      "id": 110504453004664832,
      "target": "Foreigner: Aslahe ro kenar bezar! Hich badi behet nakardam!!!"
    },
    {
      "id": 110504453000470535,
      "target": "Foreigner: Baraye chi, chet shode!? Kari ro kardam ke mikhasti!!!"
    },
    {
      "id": 110504453000470532,
      "target": "Foreigner:"
    },
    {
      "id": 110504453000470531,
      "target": "Foreigner: Gushvare az duste azizam."
    },
    {
      "id": 110504453000470530,
      "target": "Foreigner: ..."
    },
    {
      "id": 110504453000470529,
      "target": "Foreigner: Gushe, mese hameye gushha."
    },
    {
      "id": 110504452996276229,
      "target": "Foreigner: Neshun midi?"
    },
    {
      "id": 110504452996276228,
      "target": "Foreigner: ..."
    },
    {
      "id": 110504452996276227,
      "target": "Foreigner: Aks? Asheghesham!"
    },
    {
      "id": 110504452996276224,
      "target": "Foreigner: Razi shodi?"
    },
    {
      "id": 110504452992081926,
      "target": "Foreigner: ..."
    },
    {
      "id": 110504452992081925,
      "target": "Foreigner: Az in hame chiz sar darnemiaram… Bashe dige…"
    },
    {
      "id": 110504452992081922,
      "target": "Foreigner: Hanuz nemifahmam in hame ro baraye chi mikhay… خورشیید mitune shabakiye ro besuzune. Man نگااه nemikonam be خورشیید."
    },
    {
      "id": 110504452992081921,
      "target": "Foreigner: ..."
    },
    {
      "id": 110504452992081920,
      "target": "Foreigner: Cheshm?"
    },
    {
      "id": 110504452987887623,
      "target": "Foreigner: Chera in karha ro mikoni? کشتن baraye tafrih?"
    },
    {
      "id": 110504452987887622,
      "target": "Foreigner: ..."
    },
    {
      "id": 110504452987887621,
      "target": "Foreigner: Dast? Bashe."
    },
    {
      "id": 110504452987887618,
      "target": "Foreigner: Hala chi?"
    },
    {
      "id": 110504452987887617,
      "target": "Foreigner: ..."
    },
    {
      "id": 110504452987887616,
      "target": "Foreigner: Chi? Be دهاان eshare mikoni? Are, dukhtanesh. Hala chi? Labkhand bezanam?"
    },
    {
      "id": 110504452983693315,
      "target": "Foreigner: Hichi nemifahmam. Az man chi mikhay?"
    }
  ]
}
