    {
      "id": 110504455248617476,
      "target": "Foreigner: Che vahshati."
    },
    {
      "id": 110504455248617475,
      "target": "Foreigner: Yani khune ye man ham hamin ettefagh miofte?"
    },
    {
      "id": 110504455248617474,
      "target": "Foreigner: Sakhte, vali shayad behem komak kone."
    },
    {
      "id": 110504455248617473,
      "target": "Foreigner: خووب."
    },
    {
      "id": 110504455248617472,
      "target": "Foreigner: خو…"
    },
    {
      "id": 110504455244423178,
      "target": "Foreigner: خوبووو."
    },
    {
      "id": 110504455244423177,
      "target": "Foreigner: Say mikonam tekrar konam."
    },
    {
      "id": 110504455244423176,
      "target": "درد نمی‌کند؟"
    },
    {
      "id": 110504455244423175,
      "target": "حالت خوب است؟"
    },
    {
      "id": 110504455244423174,
      "target": "Foreigner: (به شانه‌اش می‌زنید و به زخم‌های اطراف دهانش اشاره می‌کنید)"
    },
    {
      "id": 110504455244423172,
      "target": "هی، حالت چطور است؟"
    },
    {
      "id": 110504455244423171,
      "target": "Foreigner: …"
    },
    {
      "id": 110504455244423170,
      "target": "Foreigner: Shayad kalameye soal bashe."
    },
    {
      "id": 110504455244423169,
      "target": "Foreigner: Vali ye chizi porsidi."
    },
    {
      "id": 110504455244423168,
      "target": "Foreigner: Shayad kalameye soal bashe."
    },
    {
      "id": 110504455240228876,
      "target": "Foreigner: Hanuz nemifahmam. Vali ye chizi porsidi."
    },
    {
      "id": 110504455240228875,
      "target": "می‌خواهی چیزی بپرسی؟"
    },
    {
      "id": 110504455240228874,
      "target": "چی چطور؟"
    },
    {
      "id": 110504455240228873,
      "target": "Foreigner: چطور."
    },
    {
      "id": 110504455240228872,
      "target": "Foreigner: Shayad injuri hadaghal befahmam chi migam."
    },
    {
      "id": 110504455240228871,
      "target": "Foreigner: Mitunam kalamehat ro tekrar konam, to ham vakonesh neshun bedi."
    },
    {
      "id": 110504455240228869,
      "target": "چطور با هم حرف بزنیم؟"
    },
    {
      "id": 110504455240228868,
      "target": "Foreigner: …"
    },
    {
      "id": 110504455240228867,
      "target": "Foreigner: Ye zabune moshtarak besazim?"
    },
    {
      "id": 110504455240228866,
      "target": "Foreigner: Nemifahmamet. Chi mishe kard?"
    },
    {
      "id": 110504455240228865,
      "target": "چیزی می‌فهمی؟"
    },
    {
      "id": 110504455240228864,
      "target": "من حرفت را نمی‌فهمم."
    },
    {
      "id": 110504455236034568,
      "target": "Foreigner: DAHANAM RO DUKHTAN! Faghat chon harfam ro nemifahman."
    },
    {
      "id": 110504455236034567,
      "target": "Foreigner: In ye kabuse!"
    },
    {
      "id": 110504455236034565,
      "target": "خب، نخ‌های دهانت را بریدی؟"
    },
    {
      "id": 110504455236034564,
