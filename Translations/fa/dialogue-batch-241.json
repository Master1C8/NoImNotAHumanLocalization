  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504454816604163,
      "target": "Fatman: باشه، فراموشش کن."
    },
    {
      "id": 110504454816604162,
      "target": "Fatman: ..."
    },
    {
      "id": 110504454816604161,
      "target": "Fatman: یعنی سیگار نداری؟"
    },
    {
      "id": 110504454816604160,
      "target": "بله، بردار (سیگارها را بده)"
    },
    {
      "id": 110504454812409867,
      "target": "Fatman: اوه، خوشحالم پرسیدی! دلم یه سیگار می‌خواد. یکی اضافه داری؟"
    },
    {
      "id": 110504454812409865,
      "target": "دیگر چه می‌خواهی؟"
    },
    {
      "id": 110504454812409864,
      "target": "Fatman: آب… حمامت جای خوبیه"
    },
    {
      "id": 110504454812409863,
      "target": "Fatman: باشه، فراموشش کن. نمی‌خوای کمک کنی، نکن!"
    },
    {
      "id": 110504454812409862,
      "target": "Fatman: …"
    },
    {
      "id": 110504454812409861,
      "target": "Fatman: پول دنیاست که می‌چرخونه، پسر! تازه من آدم خیلی مهمی‌ام؛ وزیرم!"
    },
    {
      "id": 110504454812409860,
      "target": "Fatman: یعنی چی «نه»؟ فکر می‌کنی نمی‌شه خریدت؟ با پول هر چیزی رو می‌شه خرید: عشق، وسایل، آدم‌ها…"
    },
    {
      "id": 110504454812409859,
      "target": "Fatman: نمی‌دونم کی این مایع لزج رو می‌خوره، ولی بگیر. شاید به دردت بخوره."
    },
    {
      "id": 110504454812409858,
      "target": "Fatman: (کامبوچا دریافت می‌کنید)"
    },
    {
      "id": 110504454812409857,
      "target": "Fatman: بگیر، مال تو!"
    },
    {
      "id": 110504454812409856,
      "target": "Fatman: همه پول لازم دارن! دنیا روی پول می‌چرخه. می‌گه اسکناس نمی‌خواد…"
    },
    {
      "id": 110504454808215562,
      "target": "Fatman: …"
    },
    {
      "id": 110504454808215561,
      "target": "Fatman: یعنی چی به کارت نمی‌آد؟ تو مگه چه فرقی با بقیه داری!؟"
    },
    {
      "id": 110504454808215560,
      "target": "Fatman: نمی‌دونم کی این مایع لزج رو می‌خوره، ولی بگیر. شاید به دردت بخوره."
    },
    {
      "id": 110504454808215559,
      "target": "Fatman: (کامبوچا دریافت می‌کنید)"
    },
    {
      "id": 110504454808215558,
      "target": "Fatman: راستی، این رو هم بگیر."
    },
    {
      "id": 110504454808215557,
      "target": "Fatman: برای کسی که کمکم کنه پول کم نمی‌ذارم."
    },
    {
      "id": 110504454808215556,
      "target": "Fatman: هرچی خواستم بهم بده، مثل مدیر کارخانه پول می‌گیری."
    },
    {
      "id": 110504454808215555,
      "target": "Fatman: آفرین، همین خوبه!"
    },
    {
      "id": 110504454808215554,
      "target": "پولت به کارم نمی‌آید"
    },
    {
      "id": 110504454808215553,
      "target": "خب… ممنون"
    },
    {
      "id": 110504454808215552,
      "target": "Fatman: (اسکناس‌های مچاله‌ای دریافت می‌کنید که در این شرایط به کارتان نمی‌آیند)"
    },
    {
      "id": 110504454804021259,
      "target": "Fatman: بگیر، یه کم پول."
    },
    {
      "id": 110504454804021258,
      "target": "Fatman: ممم، چه خوشمزه. موردعلاقه‌مه."
    },
    {
      "id": 110504454804021257,
      "target": "Fatman: …"
    },
    {
      "id": 110504454804021256,
      "target": "Fatman: اوووه، این رو لازم داریم!"
    },
    {
      "id": 110504454804021254,
      "target": "Fatman: چی بلغور می‌کنی؟ دیدم که یخچالت پر از آبجو بود. چطور تونستی این‌قدر زود همه‌ش رو بخوری؟"
    },
    {
      "id": 110504454804021253,
      "target": "Fatman: ..."
    },
    {
      "id": 110504454804021252,
      "target": "Fatman: یعنی آبجو نداری؟"
    },
    {
      "id": 110504454804021251,
      "target": "می‌توانم آبجو بدهم (یک قوطی آبجو بده)"
    },
    {
      "id": 110504454804021250,
      "target": "Fatman: می‌دونی، یه کم گرسنه‌ام شده. یه چیزی برای خوردن بهم می‌دی؟"
    },
    {
      "id": 110504454804021249,
      "target": "Fatman: البته…"
    },
    {
      "id": 110504454804021248,
      "target": "Fatman: …"
    },
    {
      "id": 110504454799826954,
      "target": "Fatman: آره، آره، بهترم."
    },
    {
      "id": 110504454799826952,
      "target": "حالت بهتر است؟"
    },
    {
      "id": 110504454799826951,
      "target": "Fatman: آب… حمامت جای خوبیه"
    }
  ]
}
