      "id": 110504452803338242,
      "target": "Daughter: حتماً به‌زودی می‌آید."
    },
    {
      "id": 110504452803338241,
      "target": "Daughter: وقتی دنبالم بیاید، حتماً بهش می‌گویم که شما اصلاً مهمان نیستید."
    },
    {
      "id": 110504452803338240,
      "target": "Daughter: ممنون که مثل بابای من رفتار می‌کنید."
    },
    {
      "id": 110504452799143942,
      "target": "Daughter: ..."
    },
    {
      "id": 110504452799143941,
      "target": "Daughter: بابا می‌گفت باید از انگل‌ها، کنه‌ها و سوسک‌ها ترسید. دنبال آن‌ها می‌گردید؟"
    },
    {
      "id": 110504452799143940,
      "target": "Daughter: خوشم نیامد. دیگر از من نخواهید عکس بگیرم."
    },
    {
      "id": 110504452799143939,
      "target": "Daughter: ممنون."
    },
    {
      "id": 110504452799143938,
      "target": "Daughter: مممم."
    },
    {
      "id": 110504452799143937,
      "target": "Daughter: ..."
    },
    {
      "id": 110504452799143936,
      "target": "Daughter: بعداً عکس را نشانم می‌دهید؟"
    },
    {
      "id": 110504452794949639,
      "target": "Daughter: از من خیلی کم عکس گرفته‌اند."
    },
    {
      "id": 110504452794949638,
      "target": "Daughter: عکس؟"
    }
  ]
