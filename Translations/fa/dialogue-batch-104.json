  "entries": [
    {"id": 110504456687263749, "target": "Prophet: خداحافظ."},
    {"id": 110504456687263748, "target": "Prophet: ببخش. فکر کنم بروم."},
    {"id": 110504456687263747, "target": "Prophet: دیگر جانِ خواندن ندارم."},
    {"id": 110504456687263746, "target": "Prophet: «جوانی ما همچون آتشِ روآن فریاد می‌کشید»."},
    {"id": 110504456687263745, "target": "Prophet: خداحافظ."},
    {"id": 110504456687263744, "target": "Prophet: ممنون، البته. ولی حالم بهتر نشد."},
    {"id": 110504456683069451, "target": "Prophet: حیف شد."},
    {"id": 110504456683069450, "target": "Prophet: …"},
    {"id": 110504456683069449, "target": "Prophet: «کسی میان دو جهان می‌خواند: ای آتش، با من بیا»."},
    {"id": 110504456683069448, "target": "Prophet: می‌روم. خداحافظ."},
    {"id": 110504456683069447, "target": "Prophet: کمی یادم آمد. ممنون."},
    {"id": 110504456683069446, "target": "Prophet: آهان، پس این‌طور."},
    {"id": 110504456683069445, "target": "Prophet: «قطار ما مدت‌هاست جایی نمی‌رود؛ این جاده است که درست زیر آن با غرش می‌شتابد»."},
    {"id": 110504456683069444, "target": "صفحهٔ دهم؟"},
    {"id": 110504456683069443, "target": "بگذار وسط صفحهٔ 200 باشد"},
    {"id": 110504456683069442, "target": "نزدیک آخرش را باز کن"},
    {"id": 110504456683069441, "target": "Prophet: یک‌کم می‌ترسم. شاید بتوانی کمکم کنی."},
    {"id": 110504456683069440, "target": "Prophet: یادت هست با کتاب برایم فال گرفتی؟ می‌خواهی یک بار دیگر امتحان کنیم؟"},
    {"id": 110504456678875147, "target": "Prophet: …"},
    {"id": 110504456678875146, "target": "Prophet: این کلمه برای توست؟"},
    {"id": 110504456678875145, "target": "Prophet: یک کلمهٔ دیگر هم یادم است: «بپر». معنایی دارد؟"},
    {"id": 110504456678875144, "target": "Prophet: قبلاً می‌فهمیدم. این را خوب یادم است."},
    {"id": 110504456678875143, "target": "Prophet: سؤال عجیبی است. خودم هم دیگر نمی‌فهمم چه خبر است."}
  ]
}
