  "entries": [
    {"id": 110504457945554944, "target": "TV: حالا در فهرست تحویل غذای For Rest هم موجود است. با شمارهٔ {0} تماس بگیرید."},
    {"id": 110504457941360652, "target": "1 کامبوچا، لطفاً"},
    {"id": 110504457941360651, "target": "1 بسته سیگار، لطفاً"},
    {"id": 110504457941360650, "target": "2 قوطی غذای گربه، لطفاً"},
    {"id": 110504457941360649, "target": "TV: در ادامه، گزارشی دربارهٔ توقف موقت دفع اجساد."},
    {"id": 110504457941360648, "target": "TV: …"},
    {"id": 110504457941360647, "target": "TV: …"},
    {"id": 110504457941360646, "target": "TV: …"},
    {"id": 110504457941360645, "target": "Phone: …"},
    {"id": 110504457941360644, "target": "Phone: ولی هنوز دلم برایش تنگ می‌شود..."},
    {"id": 110504457941360643, "target": "Phone: ..."},
    {"id": 110504457941360642, "target": "Phone: بروید به جهنم!"},
    {"id": 110504457941360641, "target": "Phone: اصلاً چرا دارم خودم را برای شما توجیه می‌کنم؟"},
    {"id": 110504457941360640, "target": "Phone: خواهش می‌کنم..."},
    {"id": 110504457937166346, "target": "Phone: دیگر به اینجا زنگ نزنید..."},
    {"id": 110504457937166345, "target": "Phone: ببخشید."},
    {"id": 110504457937166344, "target": "Phone: ..."},
    {"id": 110504457937166343, "target": "Phone: حالا فقط حسرت می‌خورم که از آن دخترِ بدلی نپرسیدیم با دختر کوچولوی ما چه کرده بود..."},
    {"id": 110504457937166342, "target": "Phone: شوهرم کمک کرد این را بفهمم."},
    {"id": 110504457937166341, "target": "Phone: اما بعد فهمیدم که او اصلاً دختر ما نبود."},
    {"id": 110504457937166340, "target": "Phone: اول می‌خواستم خودِ شوهرم را بکشم."},
    {"id": 110504457937166339, "target": "Phone: ..."},
    {"id": 110504457937166338, "target": "Phone: او فوراً کار آن مهمان را یکسره کرد."},
    {"id": 110504457937166337, "target": "Phone: همین که این را به شوهرم گفتم، او..."},
    {"id": 110504457937166336, "target": "Phone: ..."},
    {"id": 110504457932972044, "target": "Phone: همه‌چیز با هم جور درمی‌آمد."},
    {"id": 110504457932972043, "target": "Phone: برای همین، به‌محض ظاهر شدن آن نشانه‌ها متوجهشان شدم."},
    {"id": 110504457932972042, "target": "Phone: آخر من او را مثل کف دستم می‌شناختم."},
    {"id": 110504457932972041, "target": "Phone: از همهٔ نشانه‌ها پیدا بود."},
    {"id": 110504457932972040, "target": "Phone: او مهمان بود."},
    {"id": 110504457932972039, "target": "می‌فهمم"},
    {"id": 110504457932972038, "target": "وای، گندش بزنن..."},
    {"id": 110504457932972037, "target": "Phone: او قطعاً مهمان بود! نشانه‌ها صددرصد مطابقت داشتند!"},
    {"id": 110504457932972036, "target": "Phone: شما حق ندارید مرا قضاوت کنید!"},
    {"id": 110504457932972034, "target": "و تصمیم گرفتید بچهٔ خودتان را بکشید؟"},
    {"id": 110504457932972033, "target": "Phone: همهٔ نشانه‌ها مطابقت داشتند و شوهرم اصرار کرد."},
    {"id": 110504457932972032, "target": "Phone: او را کشتیم. باور کنید، چاره‌ای نداشتیم."},
    {"id": 110504457928777740, "target": "(قطع تماس)"},
    {"id": 110504457928777739, "target": "چی؟"},
    {"id": 110504457928777738, "target": "Phone: مجبور شدیم او را بکشیم."},
    {"id": 110504457928777737, "target": "Phone: مجبور شدیم..."},
    {"id": 110504457928777736, "target": "Phone: ..."},
    {"id": 110504457928777735, "target": "Phone: او مرد..."},
    {"id": 110504457928777734, "target": "Phone: دختر کوچولوی ما... او..."},
    {"id": 110504457928777733, "target": "Phone: و خداحافظ."}
  ]
}
