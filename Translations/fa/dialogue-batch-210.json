  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504455261200389,
      "target": "Foreigner: موووفففق باشی!"
    },
    {
      "id": 110504455261200388,
      "target": "Foreigner: Shayad baad az in hame vaght beresam khune…"
    },
    {
      "id": 110504455261200387,
      "target": "Foreigner: Vali farda miram istgah va khodam mifahmam!"
    },
    {
      "id": 110504455261200386,
      "target": "Foreigner: Nafahmidam, bebakhsh."
    },
    {
      "id": 110504455261200385,
      "target": "می‌خواهی جایی بروی؟"
    },
    {
      "id": 110504455261200384,
      "target": "منظورت قطار است؟"
    },
    {
      "id": 110504455257006091,
      "target": "Foreigner: خداحافففظ!"
    },
    {
      "id": 110504455257006090,
      "target": "Foreigner: Emshab miram. Khodahafez!"
    },
    {
      "id": 110504455257006089,
      "target": "Foreigner: Farda rah mioftam taraf khune! Hadaghal miram istgah."
    },
    {
      "id": 110504455257006088,
      "target": "Foreigner: Nemifahmam, rafigh."
    },
    {
      "id": 110504455257006086,
      "target": "می‌توانند با ماشین ببرندت؟"
    },
    {
      "id": 110504455257006085,
      "target": "Foreigner: …"
    },
    {
      "id": 110504455257006084,
      "target": "Foreigner: (طرف مقابل دستش را جلو می‌آورد و با دست دیگر روی آن می‌کشد.)"
    },
    {
      "id": 110504455257006083,
      "target": "Foreigner: Tunestan behem began ke ghatarha hanuz miran! Bavar mikoni?"
    },
    {
      "id": 110504455257006082,
      "target": "Foreigner: Ah, manzuret une."
    },
    {
      "id": 110504455257006081,
      "target": "Foreigner: (لبخند می‌زنید و با انگشت به لبخندتان، بعد به طرف مقابل اشاره می‌کنید.)"
    },
    {
      "id": 110504455252811787,
      "target": "چرا این‌قدر خوشحالی؟"
    },
    {
      "id": 110504455252811786,
      "target": "Foreigner: …"
    },
    {
      "id": 110504455252811785,
      "target": "Foreigner: Hanuz harakat mikonan? Bayad ettelaat peyda konam, mamnun!"
    },
    {
      "id": 110504455252811784,
      "target": "Foreigner: Yani ba keshti beram?"
    },
    {
      "id": 110504455252811783,
      "target": "Foreigner: …"
    },
    {
      "id": 110504455252811782,
      "target": "Foreigner: (با دست حرکت کشتی روی امواج را نشان می‌دهید.)"
    },
    {
      "id": 110504455252811781,
      "target": "Foreigner: Shayad vaghean hanuz beshe ba havapeyma raft."
    },
    {
      "id": 110504455252811780,
      "target": "Foreigner: Bayad az ye ja ettelaat begiram."
    },
    {
      "id": 110504455252811779,
      "target": "Foreigner: Havapeyma? Fekr mikoni hanuz parvaz mikonan?"
    },
    {
      "id": 110504455252811778,
      "target": "Foreigner: …"
    },
    {
      "id": 110504455252811777,
      "target": "Foreigner: (با دست حرکت شیرجه‌رفتن را نشان می‌دهید.)"
    },
    {
      "id": 110504455252811776,
      "target": "بلیت کشتی را بررسی کرده‌ای؟"
    },
    {
      "id": 110504455248617484,
      "target": "چطور تو را به خانه بفرستیم؟ با هواپیما؟"
    },
    {
      "id": 110504455248617483,
      "target": "Foreigner: Vaziyat tokhmie, jure dige nemishe goft."
    },
    {
      "id": 110504455248617482,
      "target": "Foreigner: Umadam didane dustam, hala in shod."
    },
    {
      "id": 110504455248617481,
      "target": "Foreigner: Khune? Darbareye khune miporsi?"
    },
    {
      "id": 110504455248617480,
      "target": "Foreigner: (دو کف دستتان را بالای سر به هم می‌رسانید و شکل سقف را نشان می‌دهید.)"
    },
    {
      "id": 110504455248617478,
      "target": "چطور به خانه برمی‌گردی؟"
    },
    {
      "id": 110504455248617477,
      "target": "Foreigner: …"
    }
  ]
}
