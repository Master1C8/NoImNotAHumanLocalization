  "entries": [
    {
      "id": 110504452123860996,
      "target": "Sirin: چه‌قدر زیباست!"
    },
    {
      "id": 110504452123860995,
      "target": "Sirin: اما برای تو بود!"
    },
    {
      "id": 110504452123860994,
      "target": "Sirin: آواز من."
    },
    {
      "id": 110504452123860993,
      "target": "Sirin: پس منتظر نوبت خودم می‌مانم."
    },
    {
      "id": 110504452123860992,
      "target": "Sirin: مهم نیست."
    },
    {
      "id": 110504452119666698,
      "target": "Sirin: رنجی ابدی و انتظار مرگ."
    },
    {
      "id": 110504452119666697,
      "target": "Sirin: و ما هرگز پایان خودمان را نمی‌بینیم."
    },
    {
      "id": 110504452119666696,
      "target": "Sirin: ما برای مدتی بسیار طولانی به درون افق رویداد کشیده می‌شویم."
    },
    {
      "id": 110504452119666695,
      "target": "Sirin: اگر فقط داریم آماده می‌شویم که سیاه‌چاله‌ای ما را ببلعد، چه؟"
    },
    {
      "id": 110504452119666694,
      "target": "Sirin: شاید دفعهٔ بعد."
    },
    {
      "id": 110504452119666693,
      "target": "Sirin: با نشانه‌ها جور درنیامد."
    },
    {
      "id": 110504452119666692,
      "target": "Sirin: حیف شد."
    },
    {
      "id": 110504452119666691,
      "target": "Sirin: شاید دفعهٔ بعد."
    },
    {
      "id": 110504452119666690,
      "target": "Sirin: حیف شد."
    },
    {
      "id": 110504452119666689,
      "target": "Sirin: به‌هرحال می‌میری."
    },
    {
      "id": 110504452119666688,
      "target": "Sirin: ..."
    },
    {
      "id": 110504452115472395,
      "target": "Sirin: جرئتش را نداشتی؟"
    },
    {
      "id": 110504452115472392,
      "target": "Sirin: آن دکمهٔ دلخواهت را فشار می‌دهی؟"
    },
    {
      "id": 110504452115472391,
      "target": "Sirin: خب؟"
    },
    {
      "id": 110504452115472388,
      "target": "Sirin: خوشت می‌آید؟"
    },
    {
      "id": 110504452115472387,
      "target": "Sirin: فقط به تو منتقل می‌شود."
    },
    {
      "id": 110504452115472386,
      "target": "Sirin: وقتی چشم‌هایم را ببندم، آن خلأ ناپدید نمی‌شود."
    },
    {
      "id": 110504452111278091,
      "target": "Sirin: خودم همه‌چیز را انجام می‌دهم."
    },
    {
      "id": 110504452111278090,
      "target": "Sirin: تفنگ را بده به من."
    },
    {
      "id": 110504452111278089,
      "target": "Sirin: می‌توانی این کار را فقط به من بسپاری."
    },
    {
      "id": 110504452111278088,
      "target": "Sirin: مرگ که همین حالا هم نزدیک است."
    },
    {
      "id": 110504452111278087,
      "target": "Sirin: این کار را نکن."
    },
    {
      "id": 110504452111278084,
      "target": "Sirin: جانم را از تنم بیرون بزن."
    },
    {
      "id": 110504452111278083,
      "target": "Sirin: این‌طوری حتی بهتر است."
    },
    {
      "id": 110504452111278080,
      "target": "Sirin: انگار کارش بی‌فایده نبوده."
    },
    {
      "id": 110504452107083786,
      "target": "Sirin: خواهرم زیربغل‌هایم را می‌تراشد. از من مراقبت می‌کند."
    },
    {
      "id": 110504452107083783,
      "target": "Sirin: اما او خلأ در چشم‌ها را قبول ندارد."
    },
    {
      "id": 110504452107083782,
      "target": "Sirin: از این نظر من و خواهرم شبیه همیم."
    },
    {
      "id": 110504452107083779,
      "target": "Sirin: می‌گذاشت همان موقع بمیرم."
    },
    {
      "id": 110504452107083778,
      "target": "Sirin: کاش…"
    },
    {
      "id": 110504452107083777,
      "target": "Sirin: اما این بی‌معنی است."
    },
    {
      "id": 110504452107083776,
      "target": "Sirin: خواهرم کمکم می‌کند."
    },
    {
      "id": 110504452102889481,
      "target": "Sirin: آن‌ها را برایم از جا درمی‌آوری؟"
    },
    {
      "id": 110504452102889480,
      "target": "Sirin: نگاه کن."
    },
    {
      "id": 110504452102889473,
      "target": "Sirin: دیگر انجامش بده."
    }
  ]
}
