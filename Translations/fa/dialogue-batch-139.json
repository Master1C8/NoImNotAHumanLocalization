  "entries": [
    {"id": 110504456330747915, "target": "Daughter: خِیـیـیـیلی می‌ترسـسـسمممم."},
    {"id": 110504456330747914, "target": "Daughter: آآآآآآآآآآآآ."},
    {"id": 110504456330747913, "target": "Daughter: آآآآآآآآآ."},
    {"id": 110504456330747912, "target": "Daughter: کجا برووووم؟"},
    {"id": 110504456330747911, "target": "Daughter: می‌ترسـسـسم."},
    {"id": 110504456330747910, "target": "Daughter: ش-شما ک-کمکم می‌کنید؟"},
    {"id": 110504456330747907, "target": "Daughter: وقتی دا-داشتم فرار می‌کردم، اونا فقط می‌خندیدن."},
    {"id": 110504456330747906, "target": "Daughter: بعدش یه کاری کر-کر-کردن و بعد خ-خونه رو آتیش زدن."},
    {"id": 110504456330747905, "target": "Daughter: اونا خیلی آروم توی آشپزخونه پیش بابا نشـنشسته بودن."},
    {"id": 110504456330747904, "target": "Daughter: نـنمی‌دونم."},
    {"id": 110504456326553623, "target": "Daughter: خونه‌مون حـحالا داره می‌سـسـسوزه."},
    {"id": 110504456326553622, "target": "Daughter: آآآآآآآآ، هااااااا."},
    {"id": 110504456326553621, "target": "Daughter: بابا داشت باهاشون حـحرف می‌زد. بعدش کشتنش."},
    {"id": 110504456326553620, "target": "Daughter: مـمهمان‌ها اومدن خونمون. اونا پـپیش ما نشسته بودن."},
    {"id": 110504456326553619, "target": "چرا این کار را کردند؟"},
    {"id": 110504456326553618, "target": "چه کسانی این کار را کردند؟"},
    {"id": 110504456326553617, "target": "Daughter: بـبـبابا رو کشتن."},
    {"id": 110504456326553616, "target": "Daughter: آآآآ، هاااا، آه."},
    {"id": 110504456326553615, "target": "Daughter: بـبـبابای مـمنو…"},
    {"id": 110504456326553614, "target": "Daughter: آآآآآآآ."},
    {"id": 110504456326553613, "target": "چرا این کار را کردند؟"},
    {"id": 110504456326553612, "target": "چه کسانی این کار را کردند؟"},
    {"id": 110504456326553611, "target": "Daughter: بـبابا رو."},
    {"id": 110504456326553610, "target": "Daughter: آآآآ، هاااا."},
    {"id": 110504456326553609, "target": "Daughter: کُـکُـکشتن با-با…"},
    {"id": 110504456326553608, "target": "Daughter: آآآآآآآ."},
    {"id": 110504456326553607, "target": "Daughter: آدمااااا."},
    {"id": 110504456326553606, "target": "Daughter: نـنمی‌دونم چـچی کار کنم."},
    {"id": 110504456326553605, "target": "اتفاقی افتاده؟"},
    {"id": 110504456326553604, "target": "هیستریک شده‌ای؟"},
    {"id": 110504456326553603, "target": "Daughter: ر-راهم بدید."},
    {"id": 110504456326553602, "target": "Daughter: س-سـسلام."}
  ]
}
