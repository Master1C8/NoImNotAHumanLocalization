  "entries": [
    {"id": 110504456162975749, "target": "Wheelchair: اووووی، با همین چرخ‌ها از اینجا می‌رم. دیوونه."},
    {"id": 110504456162975748, "target": "Wheelchair: چطور می‌تونم برم؟"},
    {"id": 110504456162975747, "target": "Wheelchair: برم؟ خری مگه؟"},
    {"id": 110504456162975746, "target": "Wheelchair: توی خونه‌ات یک دور تند بزنیم، ها؟"},
    {"id": 110504456162975745, "target": "Wheelchair: این شد یه چیزی!"},
    {"id": 110504456158781450, "target": "Wheelchair: گوش کن، این همه راه اومدم؛ می‌شه خواهش کنم راهم بدی؟"},
    {"id": 110504456158781449, "target": "Wheelchair: ظاهراً واقعاً اشتباه کردم."},
    {"id": 110504456158781448, "target": "Wheelchair: لعنت…"},
    {"id": 110504456158781447, "target": "Wheelchair: …"},
    {"id": 110504456158781446, "target": "Wheelchair: …"},
    {"id": 110504456158781445, "target": "Wheelchair: نه‌ه‌ه…"},
    {"id": 110504456158781444, "target": "Wheelchair: …"},
    {"id": 110504456158781443, "target": "Wheelchair: نه، محاله من…"},
    {"id": 110504456158781440, "target": "Wheelchair: گوش کن، این همه راه اومدم؛ می‌شه خواهش کنم راهم بدی؟"},
    {"id": 110504456154587147, "target": "Wheelchair: …"},
    {"id": 110504456154587146, "target": "Wheelchair: رفیقم حتماً اینجا زندگی می‌کنه… یعنی، می‌کرد."},
    {"id": 110504456154587145, "target": "Wheelchair: امکان نداره اشتباه کرده باشم؛ حافظه‌ام هیچ‌وقت خطا نمی‌کنه."},
    {"id": 110504456154587144, "target": "Wheelchair: نه بابا، چی می‌گی؟"},
    {"id": 110504456154587143, "target": "فکر می‌کنم فقط آدرس را اشتباه گرفته‌ای"},
    {"id": 110504456154587142, "target": "این خانه همیشه مال خانوادهٔ ما بوده"},
    {"id": 110504456154587141, "target": "Wheelchair: شما چه مدت است اینجا زندگی می‌کنید؟"},
    {"id": 110504456154587140, "target": "Wheelchair: تو رفیق من نیستی."},
    {"id": 110504456154587139, "target": "Wheelchair: …"},
    {"id": 110504456154587138, "target": "Wheelchair: وای، تو که…"},
    {"id": 110504456154587137, "target": "فکر می‌کنم فقط آدرس را اشتباه گرفته‌ای"},
    {"id": 110504456154587136, "target": "این خانه همیشه مال خانوادهٔ من بوده"},
    {"id": 110504456150392842, "target": "Wheelchair: از کی صاحب اینجا عوض شده؟"},
    {"id": 110504456150392841, "target": "Wheelchair: …"},
    {"id": 110504456150392840, "target": "Wheelchair: صبر کن، صدای تو فرق می‌کنه…"},
    {"id": 110504456150392839, "target": "Wheelchair: …"},
    {"id": 110504456150392838, "target": "Wheelchair: ما که…"},
    {"id": 110504456150392837, "target": "Wheelchair: یعنی چی، تو… منو یادت نیست؟"},
    {"id": 110504456150392836, "target": "تو کی هستی؟"},
    {"id": 110504456150392835, "target": "همدیگر را می‌شناسیم؟"},
    {"id": 110504456150392834, "target": "WheelChair: خیلی وقته همدیگه رو ندیدیم. زندگی چطوره؟"},
    {"id": 110504456150392833, "target": "Wheelchair: هی‌هی، سلام!"}
  ]
}
