  "glossaryFingerprint": "1246ba4274e7fb3d999cdf3a0e97f358fefc717feb5c8a25ff0ecc11ebad44ca",
  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504452887224323,
      "target": "Sirin: چقدر زود این اتفاق می‌افتد؟"
    },
    {
      "id": 110504452887224322,
      "target": "Sirin: مهمان‌ها؟ بلایای طبیعی؟ یا خودمان همدیگر را؟"
    },
    {
      "id": 110504452887224321,
      "target": "Sirin: فکر می‌کنی چه چیزی ما را می‌کشد؟"
    },
    {
      "id": 110504452887224320,
      "target": "Sirin: همیشه می‌شود ساده‌ترش کرد…"
    },
    {
      "id": 110504452883030025,
      "target": "Sirin: مهمان‌ها که وقتی به طرفشان نشانه می‌گیری، ناگهان به تو نمی‌پرند. خودشان را لو نمی‌دهند."
    },
    {
      "id": 110504452883030024,
      "target": "Sirin: چرا بررسی می‌کنی و نشانه می‌گیری، اما شلیک نمی‌کنی؟"
    },
    {
      "id": 110504452883030021,
      "target": "Sirin: فقط کاری را که باید بکنی انجام بده."
    },
    {
      "id": 110504452883030020,
      "target": "Sirin: معطل نکن."
    },
    {
      "id": 110504452883030017,
      "target": "Sirin: این عکس را هم بسوزان."
    },
    {
      "id": 110504452878835719,
      "target": "Sirin: او هنوز از یادآوری آن‌ها ناراحت می‌شود."
    },
    {
      "id": 110504452878835718,
      "target": "Sirin: وقت آن رسیده که من هم از شرش خلاص شوم."
    },
    {
      "id": 110504452878835717,
      "target": "Sirin: خواهرم آن را درآورد."
    },
    {
      "id": 110504452878835716,
      "target": "Sirin: ..."
    },
    {
      "id": 110504452878835715,
      "target": "Sirin: یادگاریِ پدر و مادرم است."
    },
    {
      "id": 110504452878835714,
      "target": "Sirin: یک گوشواره برایم مانده."
    },
    {
      "id": 110504452874641412,
      "target": "Sirin: پس چطور باید باشد؟"
    },
    {
      "id": 110504452874641411,
      "target": "Sirin: ..."
    },
    {
      "id": 110504452874641410,
      "target": "Sirin: هرطور صلاح می‌دانی عمل کن."
    },
    {
      "id": 110504452874641409,
      "target": "Sirin: برایم مهم نیست بعدش چیزی باقی بماند یا نه."
    }
  ]
}
