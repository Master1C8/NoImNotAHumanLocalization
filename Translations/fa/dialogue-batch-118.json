  "entries": [
    {"id": 110504456561434625, "target": "Ballerina: شهر را می‌بینی؟ آنجا زندگی می‌کردم."},
    {"id": 110504456561434624, "target": "تو مرا یاد یک… آدم می‌اندازی"},
    {"id": 110504456557240330, "target": "کسی تو را اینجا فرستاده؟"},
    {"id": 110504456557240329, "target": "Ballerina: باله تمرین می‌کردم. معلوم است؟"},
    {"id": 110504456557240328, "target": "Ballerina: می‌رقصم."},
    {"id": 110504456557240327, "target": "چطور خانهٔ مرا پیدا کردی؟"},
    {"id": 110504456557240325, "target": "Ballerina: به من گفتند اینجا بیایم؛ آمدم."},
    {"id": 110504456557240324, "target": "Ballerina: در را باز می‌کنی یا نه؟"},
    {"id": 110504456557240323, "target": "Ballerina: …"},
    {"id": 110504456557240322, "target": "Ballerina: یک جعبه آبجو. یک پاتختی. یک ران گوشت. نمی‌دانم. هرچه خواستی بده."},
    {"id": 110504456557240321, "target": "چطور خانهٔ مرا پیدا کردی؟"},
    {"id": 110504456553046028, "target": "Ballerina: فقط همین چطور به تو کمک می‌کند؟"},
    {"id": 110504456553046027, "target": "Ballerina: سؤال‌ها زیادند. بله، می‌دانم."},
    {"id": 110504456553046026, "target": "Ballerina: …"},
    {"id": 110504456553046025, "target": "چه می‌خواهی؟"},
    {"id": 110504456553046024, "target": "مرد کچلی را… می‌شناسی؟"},
    {"id": 110504456553046023, "target": "Ballerina: در را باز می‌کنی؟"},
    {"id": 110504456553046022, "target": "Ballerina: …"},
    {"id": 110504456553046021, "target": "Ballerina: سلام."}
  ]
}
