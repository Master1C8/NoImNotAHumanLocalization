  "entries": [
    {
      "id": 110504451981254665,
      "target": "Widow: به‌نظرت این مسخره‌بازی نیست؟"
    },
    {
      "id": 110504451981254664,
      "target": "Widow: ولی من نتونستم نجاتت بدم، عزیزِ…"
    },
    {
      "id": 110504451981254663,
      "target": "Widow: دیگه هیچ رنجی نیست؟"
    },
    {
      "id": 110504451981254662,
      "target": "Widow: همه‌چیز به همین راحتی تموم می‌شه؟"
    },
    {
      "id": 110504451981254661,
      "target": "Widow: فقط می‌شه نشست و صورت رو با دست‌ها پوشوند."
    },
    {
      "id": 110504451981254660,
      "target": "Widow: همیشه نمی‌شه حرف زد."
    },
    {
      "id": 110504451981254659,
      "target": "Widow: شادی کردن نمی‌شه، گریه کردن هم ممنوعه."
    },
    {
      "id": 110504451981254658,
      "target": "Widow: حالا می‌تونیم با هم روراست باشیم؟"
    },
    {
      "id": 110504451977060360,
      "target": "Widow: اگه احساساتم رو نشون بدم، یعنی مهمانم؟"
    },
    {
      "id": 110504451977060359,
      "target": "Widow: ..."
    },
    {
      "id": 110504451977060358,
      "target": "Widow: امتحان کن."
    },
    {
      "id": 110504451977060357,
      "target": "Widow: می‌خوای چی رو بررسی کنی؟ قرمزی رو؟"
    },
    {
      "id": 110504451977060354,
      "target": "Widow: دیگه توانی برام نمونده…"
    },
    {
      "id": 110504451977060353,
      "target": "Widow: اگه می‌خوای بهم شلیک کنی، فقط شلیک کن."
    },
    {
      "id": 110504451977060352,
      "target": "Widow: راستی، می‌شه ازم نخوای به این مسخره‌بازیِ لعنتی تن بدم؟"
    },
    {
      "id": 110504451972866058,
      "target": "Widow: ..."
    },
    {
      "id": 110504451972866057,
      "target": "Widow: دست‌هام از حمل کسی که حاضر نشدن نجاتش بدن خسته شده."
    },
    {
      "id": 110504451972866056,
      "target": "Widow: دست‌هام… الان، صبر کن."
    },
    {
      "id": 110504451972866053,
      "target": "Widow: می‌شه یه‌کم، یه‌کم با خیال راحت تنها باشم؟"
    },
    {
      "id": 110504451972866052,
      "target": "Widow: تموم شد؟"
    },
    {
      "id": 110504451972866051,
      "target": "Widow: ..."
    },
    {
      "id": 110504451972866050,
      "target": "Widow: ... باشه."
    },
    {
      "id": 110504451972866049,
      "target": "Widow: چی؟"
    },
    {
      "id": 110504451968671747,
      "target": "Widow: فقط زودتر تمومش کن."
    }
  ]
}
