  "entries": [
    {"id": 110504456565628936, "target": "Ballerina: دیگر تصمیم بگیر؛ چه کار کنیم؟"},
    {"id": 110504456565628935, "target": "Ballerina: من باله‌کارم."},
    {"id": 110504456565628934, "target": "Ballerina: شاید برایت رقصیدم."},
    {"id": 110504456565628933, "target": "Ballerina: برایت برقصم؟"},
    {"id": 110504456565628932, "target": "Ballerina: خب که چه؟"},
    {"id": 110504456565628931, "target": "ثابت کن انسان هستی"},
    {"id": 110504456565628930, "target": "باور نمی‌کنم انسان باشی"},
    {"id": 110504456565628929, "target": "Ballerina: حرف عجیبی است."},
    {"id": 110504456565628928, "target": "Ballerina: بعدش چه؟ یاد او انداختمت؟ یا چی؟"},
    {"id": 110504456561434635, "target": "Ballerina: خب… باشد."},
    {"id": 110504456561434634, "target": "ثابت کن انسان هستی"},
    {"id": 110504456561434633, "target": "باور نمی‌کنم انسان باشی"},
    {"id": 110504456561434632, "target": "Ballerina: هه."},
    {"id": 110504456561434631, "target": "Ballerina: …"},
    {"id": 110504456561434630, "target": "Ballerina: نمی‌دانم. چه فرقی می‌کند؟"},
    {"id": 110504456561434629, "target": "تو مرا یاد یک… آدم می‌اندازی"},
    {"id": 110504456561434628, "target": "کسی تو را اینجا فرستاده؟"},
    {"id": 110504456561434627, "target": "Ballerina: اینجا گرم نیست."},
    {"id": 110504456561434626, "target": "Ballerina: خانه‌ات را دیدم و آمدم."}
  ]
}
