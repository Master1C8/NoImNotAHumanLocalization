  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504452518125571,
      "target": "Ballerina: چه کسی خوب است، چه کسی بد؟"
    },
    {
      "id": 110504452518125570,
      "target": "Ballerina: حکمت را بده."
    },
    {
      "id": 110504452518125569,
      "target": "Ballerina: ..."
    },
    {
      "id": 110504452518125568,
      "target": "Ballerina: آهااا. نشانهٔ خوبی است."
    },
    {
      "id": 110504452513931285,
      "target": "Ballerina: اگر جای تو بودم، این می‌ترساندم."
    },
    {
      "id": 110504452513931284,
      "target": "Ballerina: یعنی من این‌طوری رقصانده می‌شوم؟"
    },
    {
      "id": 110504452513931283,
      "target": "Ballerina: کسی چنین چیزی به من نگفته."
    },
    {
      "id": 110504452513931282,
      "target": "Ballerina: …"
    },
    {
      "id": 110504452513931281,
      "target": "Ballerina: اوه."
    },
    {
      "id": 110504452513931280,
      "target": "Ballerina: ..."
    },
    {
      "id": 110504452513931279,
      "target": "Ballerina: بیا نگاه کنیم."
    },
    {
      "id": 110504452513931278,
      "target": "Ballerina: این را خودم هم نمی‌دانم."
    },
    {
      "id": 110504452513931275,
      "target": "Ballerina: لااقل خوشت آمد؟"
    },
    {
      "id": 110504452513931274,
      "target": "Ballerina: ..."
    },
    {
      "id": 110504452513931273,
      "target": "Ballerina: آهاهاهاها! خب بیا، نگاه کن. بو کن. دیگر چه‌کار می‌کنی؟"
    },
    {
      "id": 110504452513931270,
      "target": "Ballerina: خب، چه حسی دارد؟"
    },
    {
      "id": 110504452513931269,
      "target": "Ballerina: و تو همین حالا در آن زندگی می‌کنی."
    },
    {
      "id": 110504452513931268,
      "target": "Ballerina: توی آن‌ها یک تراژدی ثبت شده."
    },
    {
      "id": 110504452513931267,
      "target": "Ballerina: ..."
    },
    {
      "id": 110504452513931266,
      "target": "Ballerina: می‌دانی توی مردمک‌ها چیست؟"
    },
    {
      "id": 110504452513931265,
      "target": "Ballerina: آاااه، بالاخره به بخش جالبش رسیدی."
    },
    {
      "id": 110504452509736970,
      "target": "Ballerina: عجب گه‌بازی‌ای."
    },
    {
      "id": 110504452509736969,
      "target": "Ballerina: اگر او نخواسته بود، خیلی وقت پیش گربه را چال کرده بودم."
    },
    {
      "id": 110504452509736968,
      "target": "Ballerina: این پشمالو چنگم زد."
    },
    {
      "id": 110504452509736967,
      "target": "Ballerina: ..."
    },
    {
      "id": 110504452509736966,
      "target": "Ballerina: من می‌رقصم؛ دیگر می‌خواهی در دست‌هایم چه پیدا کنی؟"
    },
    {
      "id": 110504452509736965,
      "target": "Ballerina: خب که چی؟"
    },
    {
      "id": 110504452509736962,
      "target": "Ballerina: اگر می‌دانستم وجدان چیست."
    },
    {
      "id": 110504452509736961,
      "target": "Ballerina: با این دندان‌ها همه‌چیز را می‌بلعیدم. از وجدان هم یک تکه با دندان می‌کندم."
    },
    {
      "id": 110504452509736960,
      "target": "Ballerina: ..."
    },
    {
      "id": 110504452505542667,
      "target": "Ballerina: تو با دندان‌هایت هرچه را وجدان باقی بگذارد می‌بلعی؟"
    },
    {
      "id": 110504452505542666,
      "target": "Ballerina: دندان‌ها؟"
    },
    {
      "id": 110504452505542659,
      "target": "Ballerina: بررسی می‌کنی؟ ها، خب ببین می‌توانی از چیزی مطمئن شوی."
    }
  ]
}
