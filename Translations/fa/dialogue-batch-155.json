  "entries": [
    {"id": 110504456121032707, "target": "Vigilante: ..."},
    {"id": 110504456121032706, "target": "Vigilante: ..."},
    {"id": 110504456121032705, "target": "Vigilante: ..."},
    {"id": 110504456121032704, "target": "Vigilante: ..."},
    {"id": 110504456116838411, "target": "Vigilante: ..."},
    {"id": 110504456116838410, "target": "Vigilante: ..."},
    {"id": 110504456116838409, "target": "نمی‌دانید چه بلایی سر خانه‌تان آمده است."},
    {"id": 110504456116838408, "target": "و حتی معلوم نیست سر کار چه باید کرد."},
    {"id": 110504456116838407, "target": "معلوم نیست کی می‌گذارند به خانه برگردید."},
    {"id": 110504456116838406, "target": "Gasmask: ..."},
    {"id": 110504456116838405, "target": "Gasmask: ..."},
    {"id": 110504456116838404, "target": "Gasmask: ..."},
    {"id": 110504456116838403, "target": "Gasmask: ..."},
    {"id": 110504456116838402, "target": "هر نتیجه‌ای هم که داشته باشد، آن‌ها یک کودک را کشتند."},
    {"id": 110504456116838401, "target": "از حرف‌های آن زن خشکتان زد."},
    {"id": 110504456116838400, "target": "اما تو… تو جهنم را دور می‌کنی."},
    {"id": 110504456112644107, "target": "آن کودک می‌توانست ما را به قلمرو چیزی هولناک ببرد."},
    {"id": 110504456112644106, "target": "تو جهان ما را به گناه متهم می‌کنی."},
    {"id": 110504456112644105, "target": "چه خبر است؟"},
    {"id": 110504456112644104, "target": "دیدن آن‌ها نشانهٔ خوبی است؟"},
    {"id": 110504456112644103, "target": "چیزی همیشه شما را زیر نظر دارد؟"},
    {"id": 110504456112644102, "target": "و کسی را نمی‌شود بابتش سرزنش کرد."},
    {"id": 110504456112644101, "target": "تو را به خیابان انداختند."},
    {"id": 110504456112644100, "target": "به‌هرحال این اتفاق می‌افتد."},
    {"id": 110504456112644099, "target": "می‌بینم چه نقشه‌هایی برایت کشیده بودند."},
    {"id": 110504456112644098, "target": "ترس می‌تواند آدم را به‌سادگی دیوانه کند."},
    {"id": 110504456112644097, "target": "مردن ترسناک است."},
    {"id": 110504456108449798, "target": "بیا دنبالم، بدو."},
    {"id": 110504456108449797, "target": "آن‌قدر زیاد شده‌اند که کلاهک قارچ تمام سطح زمین را می‌پوشاند."},
    {"id": 110504456108449796, "target": "و هرچه قارچ‌ها بیشتر..."},
    {"id": 110504456108449795, "target": "اگر اوضاع بد شود، می‌توانند خیلی سریع رشد کنند."},
    {"id": 110504456108449794, "target": "اما آن مربوط به بعد است."},
    {"id": 110504456108449793, "target": "دیگر کسی دست‌وپاگیر نیست."},
    {"id": 110504456108449792, "target": "خیلی آرام است."},
    {"id": 110504456104255499, "target": "او دیگر چند نفر را کشته؟ چند نفر را سوزانده؟"}
  ]
}
