  "entries": [
    {
      "id": 110504452597817353,
      "target": "BigLebowski: باشه، حالا چی؟"
    },
    {
      "id": 110504452597817350,
      "target": "BigLebowski: دیگر به درک."
    },
    {
      "id": 110504452597817349,
      "target": "BigLebowski: به‌اندازهٔ کافی تو را با اسلحه توی دستت دیده‌ام."
    },
    {
      "id": 110504452597817348,
      "target": "BigLebowski: خب؟"
    },
    {
      "id": 110504452597817345,
      "target": "BigLebowski: نکند ضعیفی؟؟؟"
    },
    {
      "id": 110504452597817344,
      "target": "BigLebowski: ماشه را بکش!"
    },
    {
      "id": 110504452593623050,
      "target": "BigLebowski: یالا، این کار را بکن!"
    },
    {
      "id": 110504452593623049,
      "target": "BigLebowski: می‌دانی چیست؟ به درک! شلیک کن! دیگر از همهٔ این چیزهایی که دوروبرم است خسته شده‌ام!"
    },
    {
      "id": 110504452593623048,
      "target": "BigLebowski: این دیگر چه وضع گهی‌ای است! اصلاً می‌فهمی داری چه‌کار می‌کنی؟"
    },
    {
      "id": 110504452593623045,
      "target": "BigLebowski: …"
    },
    {
      "id": 110504452593623044,
      "target": "BigLebowski: چشم‌هایم که عادی‌اند. چه‌ات شده؟"
    },
    {
      "id": 110504452593623041,
      "target": "BigLebowski: زودتر تصمیم بگیر: یا ماشه را بکش، یا دست از این اداها بردار."
    },
    {
      "id": 110504452593623040,
      "target": "BigLebowski: می‌دانی، عمو، دیگر به درک."
    },
    {
      "id": 110504452589428744,
      "target": "BigLebowski: نکند ضعیفی؟؟؟"
    },
    {
      "id": 110504452589428743,
