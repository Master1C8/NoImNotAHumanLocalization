    },
    {
      "id": 110504452589428737,
      "target": "BigLebowski: خب چطورند؟ تمیزند؟ به معیارهای تو می‌خورند؟"
    },
    {
      "id": 110504452589428736,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452585234440,
      "target": "BigLebowski: باشه، کلاً به درک."
    },
    {
      "id": 110504452585234437,
      "target": "BigLebowski: خب چی شد؟ نشانم بده!"
    },
    {
      "id": 110504452585234436,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452585234435,
      "target": "BigLebowski: اگر می‌خواهی این عکس را بفرستی تا پدر و مادرم پیدایم کنند، برو گمشو."
