    {
      "id": 110504453398929408,
      "target": "Cultist3: شاید زودتر از برادرانم بروم."
    },
    {
      "id": 110504453394735112,
      "target": "Cultist3: ..."
    },
    {
      "id": 110504453394735111,
      "target": "Cultist3: چشم‌هایم دیگر تقریباً چیزی نمی‌بینند."
    },
    {
      "id": 110504453394735108,
      "target": "Cultist3: این باید مرگ را جذب کند. ما را نجات بدهد."
    },
    {
      "id": 110504453394735107,
      "target": "Cultist3: ..."
    },
    {
      "id": 110504453394735106,
      "target": "Cultist3: این‌طوری شبیه خارجی‌ها می‌شویم."
    },
    {
      "id": 110504453390540806,
      "target": "Cultist3: …"
    },
