    {
      "id": 110504453419900932,
      "target": "Cultist3: تو را می‌سوزانند، اما نزد مرگ نمی‌روی."
    },
    {
      "id": 110504453419900931,
      "target": "Cultist3: بهتر است این کار را نکنی."
    },
    {
      "id": 110504453419900930,
      "target": "Cultist3: …"
    },
    {
      "id": 110504453419900929,
      "target": "Cultist3: هرچه مهم باشد در حافظه می‌ماند."
    },
    {
      "id": 110504453419900928,
      "target": "Cultist3: عکس‌ها هیچ فایده‌ای ندارند."
    },
    {
      "id": 110504453415706631,
      "target": "Cultist3: …"
    },
    {
      "id": 110504453415706630,
      "target": "Cultist3: …"
    },
    {
      "id": 110504453415706629,
      "target": "Cultist3: بگذار هرکس به کار خودش برسد."
    },
    {
      "id": 110504453415706628,
      "target": "Cultist3: همه‌چیز را نشان دادم. حالا می‌روم آماده شوم."
    },
    {
      "id": 110504453415706625,
      "target": "Cultist3: …"
    },
    {
      "id": 110504453411512326,
      "target": "Cultist3: چه چیزی تو را به این فکر انداخت که بهتر است مرا بکشی؟"
    },
    {
      "id": 110504453411512323,
      "target": "Cultist3: …"
    },
    {
      "id": 110504453411512320,
      "target": "Cultist3: اما تو در این کارها دخالت نکن."
    },
    {
      "id": 110504453407318022,
      "target": "Cultist3: سردرگم شده‌ای. بهتر است تفنگ را کنار بگذاری."
    },
    {
      "id": 110504453407318019,
      "target": "Cultist3: مزاحم نشو. لطفاً."
    },
    {
      "id": 110504453407318016,
      "target": "Cultist3: …"
    },
    {
      "id": 110504453403123719,
      "target": "Cultist3: ..."
