    {"id": 110504457282854923, "target": "StaticBoy: خانه را اشتباه گرفتم."},
    {"id": 110504457282854922, "target": "StaticBoy: ببخشید."},
    {"id": 110504457282854921, "target": "StaticBoy: بویش آن نیست. صدایش هم آن نیست."},
    {"id": 110504457282854920, "target": "StaticBoy: …"},
    {"id": 110504457282854919, "target": "StaticBoy: خانه را اشتباه گرفتم."},
    {"id": 110504457282854918, "target": "StaticBoy: ببخشید."},
    {"id": 110504457282854917, "target": "StaticBoy: بویش آن نیست. صدایش هم آن نیست."},
    {"id": 110504457282854916, "target": "StaticBoy: …"},
    {"id": 110504457282854915, "target": "کمکت کنم خانه را پیدا کنی؟"},
    {"id": 110504457282854914, "target": "اینجا دنبال چه می‌گردی؟"},
    {"id": 110504457282854913, "target": "StaticBoy: اصلاً مگر به آن‌ها نیازی هست؟.."},
    {"id": 110504457282854912, "target": "StaticBoy: من پدر و مادر ندارم. هیچ‌وقت هم نداشتم."},
    {"id": 110504457278660618, "target": "StaticBoy: پدر و مادر؟"},
    {"id": 110504457278660617, "target": "StaticBoy: …"},
    {"id": 110504457278660616, "target": "کمکت کنم خانه را پیدا کنی؟"},
    {"id": 110504457278660615, "target": "اینجا دنبال چه می‌گردی؟"},
    {"id": 110504457278660614, "target": "StaticBoy: شنیدم پله جیرجیر کرد؛ یعنی کسی منتظر است."},
    {"id": 110504457278660613, "target": "StaticBoy: نور آشپزخانه را می‌خواستم، اما اینجا… پژواک دیگری دارد."},
    {"id": 110504457278660612, "target": "StaticBoy: …"},
    {"id": 110504457278660611, "target": "StaticBoy: درها در تاریکی شبیه هم‌اند."},
    {"id": 110504457278660610, "target": "پدر و مادرت کجا هستند؟"},
    {"id": 110504457278660609, "target": "گم شده‌ای؟"},
    {"id": 110504457278660608, "target": "StaticBoy: باید که…"},
    {"id": 110504457274466315, "target": "StaticBoy: او نخوابیده؟"},
    {"id": 110504457274466314, "target": "StaticBoy: …"}
