    {
      "id": 110504454338453505,
      "target": "Anxiety: همه‌مان می‌میریم."
    },
    {
      "id": 110504454338453504,
      "target": "Anxiety: …"
    },
    {
      "id": 110504454334259214,
      "target": "Anxiety: نمی‌خواهم بمیرم! نمی‌خواهم!"
    },
    {
      "id": 110504454334259213,
      "target": "Anxiety: چرا چنین چیزی می‌گویید؟ حالا بیشتر هم می‌ترسم."
    },
    {
      "id": 110504454334259212,
      "target": "Anxiety: اوووف، بهتر است استراحت کنم. دوباره دلم به هم پیچیده."
    },
    {
      "id": 110504454334259211,
      "target": "Anxiety: …"
    },
    {
      "id": 110504454334259210,
      "target": "Anxiety: ممنونم، حالا خیالم راحت‌تر است."
    },
    {
      "id": 110504454334259209,
      "target": "Anxiety: باید استراحت کنم؛ دوباره دلم به هم پیچیده. اوووف…"
    },
    {
      "id": 110504454334259208,
      "target": "Anxiety: …"
    },
    {
      "id": 110504454334259207,
      "target": "Anxiety: چرا چنین چیزی می‌گویید؟ من که می‌ترسم."
    },
    {
      "id": 110504454334259206,
      "target": "انگار تو مهمانی"
    },
    {
      "id": 110504454334259205,
      "target": "تو مهمان نیستی"
    },
    {
      "id": 110504454334259204,
      "target": "نمی‌دانم"
    },
    {
      "id": 110504454334259203,
      "target": "Anxiety: من که مهمان نیستم، درست است؟ بگویید درست است!"
    },
    {
      "id": 110504454334259202,
      "target": "Anxiety: نه، نمی‌تواند حقیقت داشته باشد. زندگی‌ام یادم است. کودکی‌ام، مامان و بابایم را یادم است. نه!"
    },
    {
      "id": 110504454334259201,
      "target": "Anxiety: که ممکن است مهمان باشم."
    },
    {
      "id": 110504454334259200,
      "target": "Anxiety: …"
    },
    {
      "id": 110504454330064907,
      "target": "Anxiety: که من…"
    },
    {
      "id": 110504454330064906,
      "target": "Anxiety: صبر کنید، نمی‌خواهید بگویید که من…"
    },
    {
      "id": 110504454330064905,
      "target": "Anxiety: فکر می‌کردم دقیق یادم است چه اتفاقی افتاد."
    },
    {
      "id": 110504454330064904,
      "target": "Anxiety: …"
    },
    {
      "id": 110504454330064903,
      "target": "Anxiety: و بعد…"
    },
    {
      "id": 110504454330064902,
      "target": "Anxiety: روی زمین افتاده بودم و بعد…"
    },
    {
      "id": 110504454330064901,
      "target": "انگار تو مهمانی"
