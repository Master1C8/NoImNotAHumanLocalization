  "entries": [
    {
      "id": 110504454783049732,
      "target": "Buddy: …"
    },
    {
      "id": 110504454783049731,
      "target": "Buddy: نمی‌تونم… جور دیگه‌ای نگاهم می‌کنی."
    },
    {
      "id": 110504454783049730,
      "target": "باید تعریف کنی. وگرنه بدتر می‌شود"
    },
    {
      "id": 110504454783049729,
      "target": "فقط بگو چه شده"
    },
    {
      "id": 110504454783049728,
      "target": "Buddy: به تو ربطی نداره، رفیق! دست از سرم بردار!"
    },
    {
      "id": 110504454778855433,
      "target": "بگو چه شده؟"
    },
    {
      "id": 110504454778855432,
      "target": "Buddy: بپرس، رفیق."
    },
    {
      "id": 110504454778855431,
      "target": "Buddy: ممنون، واقعاً حالم خوش نیست."
    },
    {
      "id": 110504454778855430,
      "target": "Buddy: تنهام بذار."
    },
    {
      "id": 110504454778855429,
      "target": "Buddy: بهم فشار نیار! همین حالا هم دلم سنگینه."
    },
    {
      "id": 110504454778855428,
      "target": "باشه، دیگر دخالت نمی‌کنم"
    },
    {
      "id": 110504454778855427,
      "target": "باید بدانم"
    },
    {
      "id": 110504454778855426,
      "target": "Buddy: گوش کن، واقعاً نمی‌خوام درباره‌اش حرف بزنم."
    },
    {
      "id": 110504454778855425,
      "target": "باشه، دیگر دخالت نمی‌کنم"
    },
    {
      "id": 110504454778855424,
      "target": "باید بدانم"
    },
    {
      "id": 110504454774661130,
      "target": "Buddy: مهم نیست، تو که نمی‌فهمی."
    },
    {
      "id": 110504454774661129,
      "target": "دربارهٔ چه حرف می‌زنی؟"
    },
    {
      "id": 110504454774661128,
      "target": "کدام موضوع؟"
    },
    {
      "id": 110504454774661127,
      "target": "Buddy: نمی‌خوام این موضوع رو پیش بکشم."
    },
    {
      "id": 110504454774661126,
      "target": "Buddy: …"
    },
    {
      "id": 110504454774661125,
      "target": "Buddy: من…"
    },
    {
      "id": 110504454774661123,
      "target": "امروز چرا این‌قدر گرفته‌ای؟"
    },
    {
      "id": 110504454774661122,
      "target": "Buddy: بپرس، رفیق."
    },
    {
      "id": 110504454774661121,
      "target": "Buddy: مهم نیست، فقط تو فکر بودم."
    },
    {
      "id": 110504454774661120,
      "target": "Buddy: …"
    },
    {
      "id": 110504454770466825,
      "target": "Buddy: هوم…"
    },
    {
      "id": 110504454770466824,
      "target": "Buddy: نه بابا، فقط…"
    },
    {
      "id": 110504454770466823,
      "target": "Buddy: مهم نیست، فراموشش کن."
    },
    {
      "id": 110504454770466822,
      "target": "Buddy: …"
    },
    {
      "id": 110504454770466821,
      "target": "Buddy: ها؟ چی؟"
    },
    {
      "id": 110504454770466820,
      "target": "چرا خشکت زده؟"
    },
    {
      "id": 110504454770466819,
      "target": "همه‌چیز روبه‌راه است؟"
    },
    {
      "id": 110504454770466818,
      "target": "Buddy: …"
    },
    {
      "id": 110504454770466817,
      "target": "Buddy: …"
    },
    {
      "id": 110504454770466816,
      "target": "Buddy: لعنتی، اگه این همه آشوب نبود، رفیق، می‌تونستیم با هم آبجو بخوریم و فوتبال ببینیم. می‌خواستم تو رو با…"
    },
    {
      "id": 110504454766272519,
      "target": "Buddy: …"
    },
    {
      "id": 110504454766272518,
      "target": "Buddy: اه، باشه! رازت مال خودت!"
    },
    {
      "id": 110504454766272517,
      "target": "Buddy: از کجا گیر آوردی؟ لابد یکی از فامیل‌هات توی آبجوسازی کار می‌کنه، نه؟"
    },
    {
      "id": 110504454766272516,
      "target": "Buddy: یه نگاه به یخچالت انداختم. لعنتی، اگه می‌دونستم این‌همه آبجو داری…"
    },
    {
      "id": 110504454766272515,
      "target": "Buddy: محشره، رفیق!"
    },
    {
      "id": 110504454766272513,
      "target": "اوضاع چطور است؟"
    },
    {
      "id": 110504454766272512,
      "target": "Buddy: بپرس، رفیق."
    }
  ]
}
