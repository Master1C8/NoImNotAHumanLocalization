  "entries": [
    {
      "id": 110504454418145284,
      "target": "Widow: او هنوز صدایم را می‌شنود."
    },
    {
      "id": 110504454418145283,
      "target": "Widow: نه، این‌طور نیست."
    },
    {
      "id": 110504454418145282,
      "target": "Widow: نه."
    },
    {
      "id": 110504454418145281,
      "target": "Widow: …"
    },
    {
      "id": 110504454418145280,
      "target": "Widow: او را به خاک بی‌روح نمی‌سپارم."
    },
    {
      "id": 110504454413950982,
      "target": "Widow: نمی‌توانم این کار را بکنم."
    },
    {
      "id": 110504454413950981,
      "target": "Widow: و دوباره از او جدا شوم."
    },
    {
      "id": 110504454413950980,
      "target": "Widow: تازه همین اواخر او را به من برگرداندند."
    },
    {
      "id": 110504454413950979,
      "target": "Widow: آمادگی‌اش را ندارم."
    },
    {
      "id": 110504454413950978,
      "target": "Widow: نه، نه، نه، نه."
    },
    {
      "id": 110504454413950977,
      "target": "Widow: نَــه."
    },
    {
      "id": 110504454413950976,
      "target": "از او فقط جسمش مانده. باید این را بپذیری"
    },
    {
      "id": 110504454409756678,
      "target": "باید دفنش کنیم"
    },
    {
      "id": 110504454409756677,
      "target": "Widow: فقط گریه‌ام را بند بیاورم."
    },
    {
      "id": 110504454409756676,
      "target": "Widow: اما آیا این کار درست است؟"
    },
    {
      "id": 110504454409756675,
      "target": "Widow: انگار دیگر اشکی برای گریه نمانده."
    },
    {
      "id": 110504454409756674,
      "target": "Widow: تازه همین اواخر اشک‌هایم تمام شد."
    },
    {
      "id": 110504454409756673,
      "target": "Widow: دیگر خیلی زیاد است."
    },
    {
      "id": 110504454409756672,
      "target": "Widow: هنوز نمی‌توانم."
    },
    {
      "id": 110504454405562378,
      "target": "چطور مرد؟"
    },
    {
      "id": 110504454405562377,
      "target": "Widow: کاش کمی استراحت کنم…"
    },
    {
      "id": 110504454405562376,
      "target": "Widow: چه کار کنم؟"
    },
    {
      "id": 110504454405562375,
      "target": "Widow: نمی‌توانم تو را…"
    },
    {
      "id": 110504454405562374,
      "target": "Widow: …"
    },
    {
      "id": 110504454405562373,
      "target": "Widow: دفن کنم…"
    },
    {
      "id": 110504454405562372,
      "target": "Widow: من حتی…"
    },
    {
      "id": 110504454405562371,
      "target": "Widow: تو دیگر هیچ‌کس را به من برنمی‌گردانی."
    },
    {
      "id": 110504454405562370,
      "target": "Widow: می‌خواهم کمی کنارش بمانم."
    },
    {
      "id": 110504454405562369,
      "target": "Widow: چرا این کار را کردی؟"
    },
    {
      "id": 110504454405562368,
      "target": "Widow: آره، حالا من باید تنهایی زنده بمانم."
    },
    {
      "id": 110504454401368071,
      "target": "Widow: و مرد."
    },
    {
      "id": 110504454401368070,
      "target": "Widow: …"
    },
    {
      "id": 110504454401368069,
      "target": "Widow: گفت همه‌چیز خوب می‌شود."
    },
    {
      "id": 110504454401368068,
      "target": "Widow: آخر قول داده بود همه‌چیز خوب می‌شود."
    },
    {
      "id": 110504454401368067,
      "target": "Widow: چرا مردی؟"
    },
    {
      "id": 110504454401368066,
      "target": "Widow: …"
    },
    {
      "id": 110504454401368065,
      "target": "کنارت بنشینم؟"
    },
    {
      "id": 110504454401368064,
      "target": "فعلاً می‌گذارم اینجا بمانی"
    },
    {
      "id": 110504454397173767,
      "target": "Widow: می‌خواهم بنشینم."
    },
    {
      "id": 110504454397173766,
      "target": "Widow: من اینجا…"
    },
    {
      "id": 110504454397173765,
      "target": "Widow: گرسنه نیستم."
    },
    {
      "id": 110504454397173764,
      "target": "کنارت بنشینم؟"
    },
    {
      "id": 110504454397173763,
      "target": "فعلاً می‌گذارم اینجا بمانی"
    },
    {
      "id": 110504454397173762,
      "target": "Widow: اگر لازم شد آب می‌خورم."
    },
    {
      "id": 110504454397173761,
      "target": "Widow: کنار شیر آب نشسته‌ام."
    },
    {
      "id": 110504454397173760,
      "target": "Widow: من اینجا…"
    },
    {
      "id": 110504454392979464,
      "target": "چیزی برای خوردن به تو بدهم؟"
    },
    {
      "id": 110504454392979463,
      "target": "برای تو آب بیاورم؟"
    },
    {
      "id": 110504454392979462,
      "target": "Widow: دیگر هیچ‌چیز لازم ندارم."
    },
    {
      "id": 110504454392979461,
      "target": "Widow: من فقط…"
    },
    {
      "id": 110504454392979460,
      "target": "Widow: می‌خواهم او زنده باشد."
    },
    {
      "id": 110504454392979459,
      "target": "Widow: …"
    },
    {
      "id": 110504454392979457,
      "target": "چیزی لازم داری؟"
    },
    {
      "id": 110504454392979456,
      "target": "Widow: کاش کمی استراحت کنم…"
    }
  ]
