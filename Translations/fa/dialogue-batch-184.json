    {
      "id": 110504455663853570,
      "target": "Ballerina: دیگر بهتر است خودم بمیرم."
    },
    {
      "id": 110504455663853569,
      "target": "Ballerina: خب، خسته شدم."
    },
    {
      "id": 110504455663853568,
      "target": "Ballerina: هوووپ!"
    },
    {
      "id": 110504455659659269,
      "target": "Ballerina: موقع شلیک چشم‌هایت را می‌بندی؟"
    },
    {
      "id": 110504455659659268,
      "target": "Ballerina: بهم نخورد! با اینکه نزدیکت ایستاده‌ام."
    },
    {
      "id": 110504455659659267,
      "target": "Ballerina: هپ!"
    },
    {
      "id": 110504455655464971,
      "target": "Ballerina: یک بار دیگر امتحان می‌کنی؟"
    },
    {
      "id": 110504455655464970,
      "target": "Ballerina: هوپ!"
    },
    {
      "id": 110504455655464967,
      "target": "Ballerina: من عاشق رقصم! می‌خواهی یکی نشانت بدهم؟ فقط شلیک کن."
    },
    {
      "id": 110504455655464966,
      "target": "Ballerina: آهاهاهاهاها."
    },
    {
      "id": 110504455655464965,
      "target": "Ballerina: ولی او بالاخره می‌آید."
    },
    {
      "id": 110504455655464964,
      "target": "Ballerina: …"
    },
    {
      "id": 110504455655464963,
      "target": "Ballerina: آه، نه، گفته بودم که منتظرم."
    },
    {
      "id": 110504455655464962,
      "target": "Ballerina: هر طور تو بگویی. راستی من هم همین‌طور."
    },
    {
      "id": 110504455655464960,
      "target": "من. منتظرِ. هیچ‌چیز. نیستم."
    },
    {
      "id": 110504455651270667,
      "target": "Ballerina: تو منتظری. می‌خواهی بفهمی چه بر سر عزیزانت آمده."
    },
    {
      "id": 110504455651270666,
      "target": "Ballerina: خودت چه می‌کنی؟ اینجا میان چهار دیوار حبس شده‌ای."
    },
    {
      "id": 110504455651270665,
      "target": "Ballerina: آها."
    },
    {
      "id": 110504455651270663,
      "target": "من. منتظرِ. هیچ‌چیز. نیستم."
    },
    {
      "id": 110504455651270662,
      "target": "Ballerina: الان شبیه او شده‌ای."
    },
    {
      "id": 110504455651270661,
      "target": "Ballerina: بهتر بود جواب می‌دادی. یک نفر هم هست که عاشق بی‌جواب گذاشتن سؤال‌هاست."
    },
    {
      "id": 110504455651270660,
      "target": "Ballerina: داری از سؤالم تعریف می‌کنی؟ چرا؟"
    },
    {
      "id": 110504455651270659,
      "target": "منتظر نیستم"
    },
    {
      "id": 110504455651270658,
      "target": "سؤال خوبی است"
