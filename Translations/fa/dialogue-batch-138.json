  "entries": [
    {"id": 110504456343330824, "target": "SuperFake: خودم در را باز می‌کنم."},
    {"id": 110504456343330823, "target": "SuperFake: می‌خواستم ببینم دروغ می‌گویی یا نه."},
    {"id": 110504456343330822, "target": "SuperFake: برایم روشن است که تنهایی."},
    {"id": 110504456343330821, "target": "SuperFake: هاهاهاهاها."},
    {"id": 110504456343330820, "target": "SuperFake: اما چه کسی می‌داند چند روز دیگر چه می‌شود؟"},
    {"id": 110504456343330819, "target": "SuperFake: صدای کسی را می‌شنوم که در اتاق‌هایت پچ‌پچ می‌کند."},
    {"id": 110504456343330818, "target": "SuperFake: امروز شانس آورده‌ای."},
    {"id": 110504456339136523, "target": "SuperFake: در خانه تنهایی؟"},
    {"id": 110504456339136522, "target": "SuperFake: اما بگو…"},
    {"id": 110504456339136521, "target": "SuperFake: «هرچه وجدانم برایم باقی بگذارد، با دندان‌هایم هم می‌بلعم»، نه؟"},
    {"id": 110504456339136520, "target": "SuperFake: چه عالی!"},
    {"id": 110504456339136517, "target": "SuperFake: در خانه تنهایی؟"},
    {"id": 110504456339136516, "target": "SuperFake: گوووش کن…"},
    {"id": 110504456339136515, "target": "SuperFake: بله‌بله، می‌فهمم."},
    {"id": 110504456339136514, "target": "تفنگ دارم"},
    {"id": 110504456339136513, "target": "چیزی نمی‌خواهم"},
    {"id": 110504456339136512, "target": "SuperFake: خودت که می‌فهمی."},
    {"id": 110504456334942217, "target": "SuperFake: محض احتیاط."},
    {"id": 110504456334942216, "target": "SuperFake: درِ محکمی داری؟"},
    {"id": 110504456334942215, "target": "تفنگ دارم"},
    {"id": 110504456334942214, "target": "چیزی نمی‌خواهم"},
    {"id": 110504456334942213, "target": "SuperFake: خوشم آمد."},
    {"id": 110504456334942212, "target": "SuperFake: خانهٔ جاداری است."},
    {"id": 110504456334942211, "target": "SuperFake: …"},
    {"id": 110504456334942210, "target": "قصد ندارم راهت بدهم"},
    {"id": 110504456334942209, "target": "چه می‌خواهی؟"},
    {"id": 110504456334942208, "target": "SuperFake: سلام!"}
  ]
}
