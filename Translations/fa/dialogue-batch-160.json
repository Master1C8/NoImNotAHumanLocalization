  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {"id": 110504456066506756, "target": "مگر اینکه…"},
    {"id": 110504456066506755, "target": "کم‌کم زیر آفتاب می‌سوزی."},
    {"id": 110504456066506754, "target": "دیگر راهی نداری که با گرفتن جان خودت از رنج رها شوی."},
    {"id": 110504456066506753, "target": "دیگر توانی نداری که از زیر پرتوهای خورشید کنار بخزی."},
    {"id": 110504456066506752, "target": "بی‌تفنگ. کتک‌خورده."},
    {"id": 110504456062312457, "target": "واقعاً متأسفم."},
    {"id": 110504456062312456, "target": "فقط… تو آن را نزدیک‌تر کردی."},
    {"id": 110504456062312455, "target": "دیر یا زود."},
    {"id": 110504456062312454, "target": "از ناپدید شدن می‌ترسی؟"},
    {"id": 110504456062312453, "target": "از درد؟"},
    {"id": 110504456062312452, "target": "دقیقاً از چه ترسیدی؟"},
    {"id": 110504456062312451, "target": "دیدن آنچه در انتظارت است خیلی غم‌انگیز است."},
    {"id": 110504456062312450, "target": "گرفتن تصمیم‌های هولناک آسان است."},
    {"id": 110504456062312449, "target": "این را خوب می‌فهمم."},
    {"id": 110504456062312448, "target": "بعید است دیگر بتوانم مسیر اتفاق‌های بعدی را اصلاح کنم. ببخش."},
    {"id": 110504456058118155, "target": "ترس چشم‌هایت را بست."},
    {"id": 110504456058118154, "target": "خیلی ترسیدی. وای نه."},
    {"id": 110504456058118153, "target": "صبر کن، فکر کنم می‌بینم."},
    {"id": 110504456058118152, "target": "قطعاً داری یک کار را اشتباه انجام می‌دهی."},
    {"id": 110504456058118151, "target": "بعید است بتوانم درستش کنم. ببخش."},
    {"id": 110504456058118150, "target": "اما پیداست داری کاری را اشتباه انجام می‌دهی. فقط مرگ را نزدیک‌تر کرده‌ای."},
    {"id": 110504456058118149, "target": "از مردن می‌ترسی؟ طبیعی است."},
    {"id": 110504456058118148, "target": "چیزی پشت سرت هست؛ ردّی بلند از سایه‌ها. انگار قرار نبود این‌طوری شود."},
    {"id": 110504456058118147, "target": "فکر می‌کنم می‌فهمی."},
    {"id": 110504456058118146, "target": "مهمان‌ها را می‌کشم. مگر راه دیگری برای زنده ماندن هست؟"},
    {"id": 110504456058118145, "target": "نمی‌فهمم از چه حرف می‌زنی"},
    {"id": 110504456058118144, "target": "نکند کاری را… خراب کرده‌ای؟"},
    {"id": 110504456053923852, "target": "وقتی به چیزی می‌رسیم که دیگر هیچ نمی‌خواهیم، خاک نمناک ما را می‌کاود."},
    {"id": 110504456053923851, "target": "وقتی به خانه‌ات نگاه می‌کنم، یک جمله به ذهنم می‌آید."},
    {"id": 110504456053923850, "target": "سلام. قصد نداشتم امروز پیشت بیایم، اما به نظرم رسید اینجا چیزی… عجیب رخ می‌دهد."}
  ]
}
