  "entries": [
    {
      "id": 110504455097622528,
      "target": "Daughter: فکر کنم شمارهٔ تلفنش این باشد: {0}."
    },
    {
      "id": 110504455093428236,
      "target": "Daughter: وقتی بزرگ‌ترها صدایش می‌زنند، اجازه می‌دهند بیاید... ولی اگر خودم صدایش بزنم، همیشه دعوایم می‌کنند."
    },
    {
      "id": 110504455093428235,
      "target": "Daughter: تازه... می‌شود شما دوستم را دعوت کنید بیاید اینجا؟.."
    },
    {
      "id": 110504455093428234,
      "target": "Cold: ببخش. نمی‌خواستم این اتفاق بیفتد."
    },
    {
      "id": 110504455093428233,
      "target": "Cold: بااین‌حال."
    },
    {
      "id": 110504455093428232,
      "target": "Cold: می‌فهمم چقدر از من متنفری."
    },
    {
      "id": 110504455093428231,
      "target": "Cold: ممنون."
    },
    {
      "id": 110504455093428230,
      "target": "Cold: شاید دست‌کم زیر آفتاب گرم شوم. برای آخرین بار."
    },
    {
      "id": 110504455093428229,
      "target": "Cold: ببخشید."
    },
    {
      "id": 110504455093428228,
      "target": "Cold: فهمیدم."
    },
    {
      "id": 110504455093428227,
      "target": "فقط یک بهانه به من بده تا شلیک کنم"
    },
    {
      "id": 110504455093428226,
      "target": "همین حالا برو"
    },
    {
      "id": 110504455093428225,
      "target": "Cold: می‌توانم تا شب بمانم؟"
    },
    {
      "id": 110504455093428224,
      "target": "Cold: آفتاب به‌آرامی مرا می‌کشد."
    },
    {
      "id": 110504455089233931,
      "target": "Cold: انسانی‌تر این است که به من شلیک کنی. متأسفانه درد را حس می‌کنم."
    },
    {
      "id": 110504455089233930,
      "target": "Cold: همین حالا؟"
    },
    {
      "id": 110504455089233929,
      "target": "Cold: فکر نکن از قصد بود."
    },
    {
      "id": 110504455089233928,
      "target": "Cold: من فقط می‌خواستم…"
    },
    {
      "id": 110504455089233927,
      "target": "Cold: آن وقت دیگر مشکلی با سرما و تنهایی نخواهم داشت."
    },
    {
      "id": 110504455089233926,
      "target": "Cold: احتمالاً این‌طور امن‌تر است."
    },
    {
      "id": 110504455089233925,
      "target": "بیرونش کن"
    },
    {
      "id": 110504455089233923,
      "target": "Cold: منظورم این نبود…"
    },
    {
      "id": 110504455089233922,
      "target": "Cold: این کار را از روی بدخواهی نکردم."
    },
    {
      "id": 110504455089233921,
      "target": "Cold: عجولانه قضاوت نکن."
    },
    {
      "id": 110504455089233920,
      "target": "Cold: چرا فکر کردم این بار چیزی فرق می‌کند؟"
    },
    {
      "id": 110504455085039628,
      "target": "Cold: قبلاً هم همین‌طور بود."
    },
    {
      "id": 110504455085039627,
      "target": "بیرونش کن"
    },
    {
      "id": 110504455085039625,
      "target": "Cold: واقعاً نمی‌خواستم."
    },
    {
      "id": 110504455085039624,
      "target": "Cold: نمی‌خواستم."
    },
    {
      "id": 110504455085039623,
      "target": "Cold: چرا با من این‌طور رفتار می‌کنند؟"
    },
    {
      "id": 110504455085039622,
      "target": "Cold: امیدوار بودم اینجا چنین چیزی پیش نیاید."
    },
    {
      "id": 110504455085039621,
      "target": "Cold: عمدی نبود…"
    },
    {
      "id": 110504455085039620,
      "target": "دیگه کارت ساخته‌ست، لعنتی"
    },
    {
      "id": 110504455085039619,
      "target": "چه کار کردی؟"
    },
    {
      "id": 110504455085039618,
      "target": "Cold: وای نه. باز هم."
    },
    {
      "id": 110504455085039617,
      "target": "Cold: نگاه کن."
    },
    {
      "id": 110504455085039616,
      "target": "Cold: زیر لباسم واقعاً چیزی را پنهان کرده‌ام که فکر می‌کنم دلیل تنهایی و سرمای جان‌فرسایم است."
    },
    {
      "id": 110504455080845324,
      "target": "Cold: معمولاً آخر و عاقبت خوبی ندارد، ولی شاید این بار فرق کند."
    },
    {
      "id": 110504455080845323,
      "target": "Cold: گمانم آماده‌ام."
    },
    {
      "id": 110504455080845322,
      "target": "Cold: بله، می‌خواستم یکی از رازهایم را برایت فاش کنم."
    }
  ]
}
