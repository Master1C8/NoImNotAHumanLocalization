  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504452602011649,
      "target": "BigLebowski: Volgende keer schiet je meteen. Ik ga niet om genade smeken. Het kan me geen reet schelen."
    },
    {
      "id": 110504452597817353,
      "target": "BigLebowski: Oké, en wat nu?"
    },
    {
      "id": 110504452597817350,
      "target": "BigLebowski: Kan me niet schelen."
    },
    {
      "id": 110504452597817349,
      "target": "BigLebowski: Ik heb je vaak genoeg met een wapen in je handen gezien."
    },
    {
      "id": 110504452597817348,
      "target": "BigLebowski: En?"
    },
    {
      "id": 110504452597817345,
      "target": "BigLebowski: BEN JE SOMS EEN SLAPPELING???"
    },
    {
      "id": 110504452597817344,
      "target": "BigLebowski: HAAL DE TREKKER OVER!"
    },
    {
      "id": 110504452593623050,
      "target": "BigLebowski: KOM OP, DOE HET!"
    },
    {
      "id": 110504452593623049,
      "target": "BigLebowski: Weet je, het kan me niks schelen! Schiet! Ik ben alles om me heen zo zat!"
    },
    {
      "id": 110504452593623048,
      "target": "BigLebowski: Wat een kutzooi! Besef je eigenlijk wel wat je doet?"
    },
    {
      "id": 110504452593623045,
      "target": "BigLebowski: …"
    },
    {
      "id": 110504452593623044,
      "target": "BigLebowski: Mijn ogen zijn toch normaal. Wat is er?"
    },
    {
      "id": 110504452593623041,
      "target": "BigLebowski: Beslis snel: haal de trekker over of hou op met dit gedoe."
    },
    {
      "id": 110504452593623040,
      "target": "BigLebowski: Weet je, man, het kan me gewoon niet meer schelen."
    },
    {
      "id": 110504452589428744,
      "target": "BigLebowski: BEN JE SOMS EEN SLAPPELING???"
    },
    {
      "id": 110504452589428743,
      "target": "BigLebowski: HAAL DE TREKKER OVER!"
    },
    {
      "id": 110504452589428742,
      "target": "BigLebowski: KOM OP, DOE HET!"
    },
    {
      "id": 110504452589428741,
      "target": "BigLebowski: Weet je, het kan me niks schelen! Schiet! Ik ben alles om me heen zo zat!"
    },
    {
      "id": 110504452589428738,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452589428737,
      "target": "BigLebowski: En? Zijn ze schoon? Voldoen ze aan je normen?"
    },
    {
      "id": 110504452589428736,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452585234440,
      "target": "BigLebowski: Oké, kan me helemaal niet schelen."
    },
    {
      "id": 110504452585234437,
      "target": "BigLebowski: Nou? Laat zien!"
    },
    {
      "id": 110504452585234436,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452585234435,
      "target": "BigLebowski: Als je die foto wilt opsturen zodat mijn ouders me kunnen vinden, rot dan op."
    },
    {
      "id": 110504452585234434,
      "target": "BigLebowski: …"
    },
    {
      "id": 110504452581040138,
      "target": "BigLebowski: Nee. Wat een vreemde kutzooi. Dat ga ik niet doen."
    },
    {
      "id": 110504452581040135,
      "target": "BigLebowski: …"
    },
    {
      "id": 110504452581040134,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452581040133,
      "target": "BigLebowski: Ik zeg het nog maar eens: als je iets engs van plan bent, sla ik je zelf een oog uit!"
    },
    {
      "id": 110504452581040130,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452581040129,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452581040128,
      "target": "BigLebowski: Hier."
    },
    {
      "id": 110504452576845836,
      "target": "BigLebowski: Het is een allergie. Daardoor jeukt het. Ontzettend vervelend. Ik heb het al sinds ik klein was."
    },
    {
      "id": 110504452576845835,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452576845834,
      "target": "BigLebowski: Schrik alleen niet…"
    },
    {
      "id": 110504452576845833,
      "target": "BigLebowski: Hm…"
    },
    {
      "id": 110504452576845830,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452576845829,
      "target": "BigLebowski: Mijn ouders maakten zich veel meer zorgen om mijn tanden dan om mij…"
    },
    {
      "id": 110504452576845828,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452576845827,
      "target": "BigLebowski: Raar gedoe. Denk eraan: als je iets probeert, kan ik je ook in je gezicht slaan!"
    },
    {
      "id": 110504452572651529,
      "target": "BigLebowski: Oké, kom maar, man. Kan me niet schelen."
    }
  ]
}
