  "entries": [
    {"id": 110504456330747915, "target": "Daughter: IK BEN ZO-O-O BAAAAANG!"},
    {"id": 110504456330747914, "target": "Daughter: AAAAAAAAAAAA!"},
    {"id": 110504456330747913, "target": "Daughter: Aaaaaaaaaaa!"},
    {"id": 110504456330747912, "target": "Daughter: Waar moet ik hee-e-e-en?"},
    {"id": 110504456330747911, "target": "Daughter: Ik ben ba-a-a-ang."},
    {"id": 110504456330747910, "target": "Daughter: K-kunt u me h-helpen?"},
    {"id": 110504456330747907, "target": "Daughter: Terwijl ik we-weg-rende, lachten ze gewoon."},
    {"id": 110504456330747906, "target": "Daughter: En toen de-deden ze iets, en daarna st-staken ze het huis in brand."},
    {"id": 110504456330747905, "target": "Daughter: Ze za-zaten heel rustig met papa in de keuken."},
    {"id": 110504456330747904, "target": "Daughter: Ik w-weet het niet."},
    {"id": 110504456326553623, "target": "Daughter: Ons huis st-staat nu in bra-a-a-and!"},
    {"id": 110504456326553622, "target": "Daughter: Aaaaaaa-haaaaaa!"},
    {"id": 110504456326553621, "target": "Daughter: Papa pr-praatte ergens met ze over. En toen hebben ze hem vermoord."},
    {"id": 110504456326553620, "target": "Daughter: Er kwamen Ga-a-asten bij ons. Ze za-zaten bij ons binnen."},
    {"id": 110504456326553619, "target": "Waarom hebben ze dat gedaan?"},
    {"id": 110504456326553618, "target": "Wie heeft dat gedaan?"},
    {"id": 110504456326553617, "target": "Daughter: Ze hebben pa-papa vermoord."},
    {"id": 110504456326553616, "target": "Daughter: A-a-a-ha-a-a!"},
    {"id": 110504456326553615, "target": "Daughter: Mi-mijn pa-papa..."},
    {"id": 110504456326553614, "target": "Daughter: A-a-a-a-a-a!"},
    {"id": 110504456326553613, "target": "Waarom hebben ze dat gedaan?"},
    {"id": 110504456326553612, "target": "Wie heeft dat gedaan?"},
    {"id": 110504456326553611, "target": "Daughter: Pa-papa."},
    {"id": 110504456326553610, "target": "Daughter: A-a-a-aha-a-a!"},
    {"id": 110504456326553609, "target": "Daughter: Ze hebben pa-papa ver-vermoord..."},
    {"id": 110504456326553608, "target": "Daughter: A-a-a-a-a-a!"},
    {"id": 110504456326553607, "target": "Daughter: Me-e-e-ensen."},
    {"id": 110504456326553606, "target": "Daughter: Ik w-weet niet wa-at ik moet do-doen."}
