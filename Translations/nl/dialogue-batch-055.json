  "entries": [
    {"id": 110504456108449794, "target": "Maar dat komt later."},
    {"id": 110504456108449793, "target": "Niemand loopt in de weg."},
    {"id": 110504456108449792, "target": "Het is hier heel rustig."},
    {"id": 110504456037146633, "target": "Ik ga even slapen."},
    {"id": 110504456037146632, "target": "Ik ben een beetje moe."},
    {"id": 110504456037146630, "target": "Kon ik ze maar weer met het hele gezin ontmoeten."},
    {"id": 110504456037146629, "target": "Zal er nog iemand naar me toe komen?"},
    {"id": 110504456037146628, "target": "Waarom hebben ze me hier binnengelaten?"},
    {"id": 110504456037146627, "target": "Wat was dat eigenlijk, vraag ik me af?"},
    {"id": 110504456037146626, "target": "Als het maar zo blijft, nog een hele tijd…"},
    {"id": 110504456037146625, "target": "Maar ik was dat ook niet van plan."},
    {"id": 110504456037146624, "target": "Ik weet niet hoe ik eruit kom."},
    {"id": 110504456032952331, "target": "Ik weet niet meer hoe ik hier gekomen ben."},
    {"id": 110504456032952330, "target": "Niemand dringt zich op. Niemand raakt me aan."},
    {"id": 110504456032952329, "target": "Maar… nu ben ik rustig."},
    {"id": 110504456032952328, "target": "Ik weet niet hoelang ik hier al zit."},
    {"id": 110504456032952327, "target": "Hier wisselen dag en nacht elkaar niet af."},
    {"id": 110504456032952324, "target": "Ik ben bang"},
    {"id": 110504456032952323, "target": "Is hier iemand?"},
    {"id": 110504456032952321, "target": "Ik ben bang"},
    {"id": 110504456032952320, "target": "Is hier iemand?"},
    {"id": 110504456028758025, "target": "Kan ik een film kijken?"},
    {"id": 110504456028758024, "target": "Komt hier nog iemand anders?"},
    {"id": 110504456028758022, "target": "Kan ik een film kijken?"},
    {"id": 110504456028758021, "target": "Komt hier nog iemand anders?"},
    {"id": 110504456028758019, "target": "Blijf ik hier voor altijd?"},
    {"id": 110504456028758018, "target": "Ben ik dood?"},
    {"id": 110504456028758016, "target": "Geniet ervan."},
    {"id": 110504456024563722, "target": "Ze zullen je groot en stoffig lijken, bezaaid met compromissen."},
    {"id": 110504456024563721, "target": "Met haar korte wegen, die je later vreemd genoeg breed zullen lijken."},
    {"id": 110504456024563720, "target": "Dit is jouw plek."},
    {"id": 110504456024563719, "target": "Dit is toch wat je wilde?"}
  ]
}
