  "entries": [
    {
      "id": 110504451956088838,
      "target": "Esenin: Nou, ben ik een Gast?"
    },
    {
      "id": 110504451956088837,
      "target": "Esenin: ..."
    },
    {
      "id": 110504451956088836,
      "target": "Esenin: Bekijk mijn nagels maar."
    },
    {
      "id": 110504451956088835,
      "target": "Esenin: Wat een verdomde onzin."
    },
    {
      "id": 110504451956088834,
      "target": "Esenin: Dus elke tuinier wordt dan meteen een Gast?"
    },
    {
      "id": 110504451956088833,
      "target": "Esenin: Ze kunnen gewoon hun handen wassen! Klaar!"
    },
    {
      "id": 110504451956088832,
      "target": "Esenin: Nagels met aarde eronder? Is dat een teken?"
    },
    {
      "id": 110504451951894538,
      "target": "Esenin: Waar komen ze überhaupt vandaan?"
    },
    {
      "id": 110504451951894537,
      "target": "Esenin: Ik ben geen Gast."
    },
    {
      "id": 110504451951894536,
      "target": "Esenin: Val me dan niet lastig met je onderzoeken."
    },
    {
      "id": 110504451951894535,
      "target": "Esenin: Een beetje gelig, toch?"
    },
    {
      "id": 110504451951894534,
      "target": "Esenin: ..."
    },
    {
      "id": 110504451951894533,
      "target": "Esenin: Kijk dan maar. Er zit nog een zweem van ongeluk en rook aan."
    },
    {
      "id": 110504451951894532,
      "target": "Esenin: Zal ik je mijn tanden laten zien?"
    },
    {
      "id": 110504451947700232,
      "target": "Esenin: Wat wil je controleren?"
    }
  ]
}
