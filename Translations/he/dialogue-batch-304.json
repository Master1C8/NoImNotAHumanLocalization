  "entries": [
    {
      "id": 110504456632737798,
      "target": "איפה. האנשים. שלי?"
    },
    {
      "id": 110504456632737797,
      "target": "Gasmask: אחרת תהיה קטסטרופה."
    },
    {
      "id": 110504456632737796,
      "target": "Gasmask: אנחנו צריכים לקחת עוד אנשים."
    },
    {
      "id": 110504456615960584,
      "target": "תחזירו את האנשים שלקחתם קודם"
    },
    {
      "id": 110504456615960583,
      "target": "מה קורה בעיר?"
    },
    {
      "id": 110504456615960582,
      "target": "Gasmask: כמה שיותר מהר, יותר טוב."
    },
    {
      "id": 110504456615960581,
      "target": "Gasmask: אנחנו צריכים לקחת מכם עוד אנשים."
    },
    {
      "id": 110504456615960580,
      "target": "Gasmask: שלום."
    },
    {
      "id": 110504456611766272,
      "target": "ומה עם הבדיקה הקודמת?"
    },
    {
      "id": 110504456607571979,
      "target": "מתי תחזירו את האדם שלקחתם מאיתנו?"
    },
    {
      "id": 110504456607571978,
      "target": "Gasmask: אל תדאג, זה לא יימשך זמן רב."
    },
    {
      "id": 110504456607571977,
      "target": "Gasmask: אנחנו מצוות של הוועדה למצבי חירום. עורכים בדיקות בשכונה שלך."
    },
    {
      "id": 110504456607571976,
      "target": "Gasmask: לילה טוב."
    },
    {
      "id": 110504456599183361,
      "target": "מה קרה לפנים שלך?"
    },
    {
      "id": 110504456599183360,
      "target": "למה אתה כל כך שמח?"
    },
    {
      "id": 110504456594989066,
      "target": "Luka: אפשר להישאר אצלך ללילה?"
    },
    {
      "id": 110504456594989065,
      "target": "Luka: אתה כבר ליד הדלת, נכון? שמעתי צעדים."
    },
    {
      "id": 110504456586600454,
      "target": "כן, זה הבית שלי"
    },
    {
      "id": 110504456586600453,
      "target": "אתה מחפש מישהו מסוים?"
    },
    {
      "id": 110504456586600452,
      "target": "BigLebowski: זה הבית שלך, כלומר, הבית שלכם?"
    },
    {
      "id": 110504456586600451,
      "target": "BigLebowski: שלום. כלומר… היי, אם זה נוח יותר."
    },
    {
      "id": 110504456574017545,
      "target": "ומה אם תהיו לי לנטל?"
    },
    {
      "id": 110504456574017544,
      "target": "הבית שלי נראה כמו מקום בטוח?"
    },
    {
      "id": 110504456574017543,
      "target": "Couple: לא תתנגד אם נשב אצלך קצת? אם זה לא מכביד עליך, כמובן."
    },
    {
      "id": 110504456574017542,
      "target": "Couple: אוי, שלום! אשתי ואני מחפשים מקום בטוח."
    },
    {
      "id": 110504456574017541,
      "target": "Couple: … ככה כבר יותר טוב."
    },
    {
      "id": 110504456553046025,
      "target": "מה את צריכה?"
    },
    {
      "id": 110504456553046024,
      "target": "את מכירה… גבר קירח?"
    },
    {
      "id": 110504456553046023,
      "target": "Ballerina: אתה פותח את הדלת?"
    },
    {
      "id": 110504456553046021,
      "target": "Ballerina: שלום."
    },
    {
      "id": 110504456540463107,
      "target": "מה קרה?"
    },
    {
      "id": 110504456540463106,
      "target": "Teacher: אני יכולה לשפוך בפניך את לבי?"
    },
    {
      "id": 110504456540463105,
      "target": "Teacher: סלח לי שאני מטרידה אותך, קשה לי מאוד…"
    },
    {
      "id": 110504456523685896,
      "target": "יצורים דמויי אדם התחילו לצאת מהאדמה"
    },
    {
      "id": 110504456523685895,
      "target": "השמש מתחזקת ושורפת אנשים בשעות היום"
    },
    {
      "id": 110504456523685894,
      "target": "Dude: תסביר לי כמו לאח מה פספסתי."
    },
    {
      "id": 110504456523685893,
      "target": "Dude: מטורף, מה לעזאזל קורה פה?"
    },
    {
      "id": 110504456523685892,
      "target": "Dude: יו, אחי, מה קורה?"
    },
    {
      "id": 110504456511102986,
      "target": "מי עשה לך את זה?"
    },
    {
      "id": 110504456511102985,
      "target": "מה קרה לעיניים שלך?"
    },
    {
      "id": 110504456511102984,
      "target": "Blind: סוף סוף מצאתי איזה בית."
    },
    {
      "id": 110504456502714372,
      "target": "אתה בסדר?"
    },
    {
      "id": 110504456502714371,
      "target": "אבל עכשיו לילה"
    },
    {
      "id": 110504456502714370,
      "target": "Fatman: שלום… אני… לעזאזל, כמה חם לי."
    },
    {
      "id": 110504456490131458,
      "target": "איך אדע שאתה אדם ״טוב״?"
    },
    {
      "id": 110504456490131457,
      "target": "מה קרה לך?"
    },
    {
      "id": 110504456490131456,
      "target": "Buddy: שלום, חבר. תכניס בבקשה אדם טוב לבית שלך."
    },
    {
      "id": 110504456477548544,
      "target": "אתה בכלל רואה טלוויזיה?"
    },
    {
      "id": 110504456473354251,
      "target": "רגע, אתה בכלל לא יודע מה קורה?"
    }
  ]
}
