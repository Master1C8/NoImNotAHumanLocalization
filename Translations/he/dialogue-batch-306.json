  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504456272027658,
      "target": "ולאן תלכי אחר כך?"
    },
    {
      "id": 110504456272027657,
      "target": "מאיפה באת?"
    },
    {
      "id": 110504456272027656,
      "target": "Widow: אוכל לנוח אצלך?"
    },
    {
      "id": 110504456263639042,
      "target": "לא תעשה לי בעיות?"
    },
    {
      "id": 110504456263639041,
      "target": "אתה הרי לא אורח?"
    },
    {
      "id": 110504456263639040,
      "target": "Esenin: מה אתה אומר? תכניס אותי?"
    },
    {
      "id": 110504456259444747,
      "target": "Esenin: אבל אני לא פוגע באף אחד, שלא תחשוב ככה. פשוט… לפעמים אני מרגיש נורא. אתה מבין."
    },
    {
      "id": 110504456259444746,
      "target": "Esenin: בגלל מה? הממ. לא כולם מסוגלים לסבול את האופי שלי."
    },
    {
      "id": 110504456259444745,
      "target": "Esenin: פשוט גירשו אותי."
    },
    {
      "id": 110504456259444744,
      "target": "Esenin: מצאתי מחסה בפאב, אבל…"
    },
    {
      "id": 110504456259444743,
      "target": "Esenin: אפשר להיכנס אליכם?"
    },
    {
      "id": 110504456251056129,
      "target": "איך הגעת לכאן?"
    },
    {
      "id": 110504456246861835,
      "target": "Anxiety: יש אצלך אולי מקום בשבילי?"
    },
    {
      "id": 110504456246861834,
      "target": "Anxiety: סליחה שאני מגיעה מאוחר כל כך. ביום חם מדי, ובטלוויזיה אמרו שעדיף לא לצאת כשהשמש בחוץ."
    },
    {
      "id": 110504456246861833,
      "target": "Anxiety: שלום!"
    },
    {
      "id": 110504456234278923,
      "target": "אתה מפחיד אותי."
    },
    {
      "id": 110504456234278921,
      "target": "Fanatic: איזו פאקינג ברכה!"
    },
    {
      "id": 110504456234278920,
      "target": "Fanatic: ונלך לעולם חדש וטהור!"
    },
    {
      "id": 110504456234278919,
      "target": "Fanatic: האדמה תיטהר, השמש תעשה את מלאכתה."
    },
    {
      "id": 110504456234278918,
      "target": "Fanatic: איזה מזל יש לנו! ראינו במו עינינו את העונש על תשוקות בני האדם."
    },
    {
      "id": 110504456234278917,
      "target": "Fanatic: שלום, בן אדם."
    },
    {
      "id": 110504456221696002,
      "target": "פתח בסוף"
    },
    {
      "id": 110504456221696001,
      "target": "פתח באמצע"
    },
    {
      "id": 110504456221696000,
      "target": "בוא נפתח איפשהו בהתחלה"
    },
    {
      "id": 110504456217501707,
      "target": "Prophet: תפתח בשבילי את הספר ותגיד לי מה הגורל צופן? באיזה עמוד לפתוח?"
    },
    {
      "id": 110504456217501706,
      "target": "Prophet: הייתי רוצה לפתוח את השיחה שלנו ב… פעילות מסוימת."
    },
    {
      "id": 110504456217501705,
      "target": "Prophet: הממ, מוזר, לא יודע איך להסביר."
    },
    {
      "id": 110504456217501704,
      "target": "Prophet: אני זוכר שבפעם הקודמת זה היה אחרת. אבל אנחנו חיים…"
    },
    {
      "id": 110504456217501703,
      "target": "Prophet: נפגשנו שוב."
    },
    {
      "id": 110504456204918788,
      "target": "למה שאסמוך עליך?"
    },
    {
      "id": 110504456204918787,
      "target": "באת לבד?"
    },
    {
      "id": 110504456204918786,
      "target": "Gasmask: אני מצוות של הוועדה למצבי חירום. אנחנו עוברים בשכונה שלך."
    },
    {
      "id": 110504456204918785,
      "target": "Gasmask: לילה טוב."
    },
    {
      "id": 110504456192335874,
      "target": "מה?"
    },
    {
      "id": 110504456192335873,
      "target": "FortuneTeller: אתה אדם נחוש למדי, נכון?"
    },
    {
      "id": 110504456192335872,
      "target": "FortuneTeller: השמש, מזל אריה, הבית החמישי. הכול ברור."
    },
    {
      "id": 110504456188141579,
      "target": "FortuneTeller: משהו רע מאוד."
    },
    {
      "id": 110504456188141578,
      "target": "FortuneTeller: אני מרגישה שיש כאן קיפאון של איזו אנרגיה."
    },
    {
      "id": 110504456175558664,
      "target": "אתה לא אחד מהנבלות האלה?"
    },
    {
      "id": 110504456175558663,
      "target": "על מי אתה מדבר?"
    },
    {
      "id": 110504456175558662,
      "target": "Anger: כל כך הרבה נבלות סביבי. מקווה שאתה לא אחד מהם."
    },
    {
      "id": 110504456175558661,
      "target": "Anger: מצב הרוח שלי מחורבן. סליחה מראש."
    },
    {
      "id": 110504456175558660,
      "target": "Anger: שלום, דייר."
    },
    {
      "id": 110504456162975753,
      "target": "מה אתם רוצים ממני?"
    },
    {
      "id": 110504456162975752,
      "target": "קרה משהו?"
    },
    {
      "id": 110504456162975751,
      "target": "Mother: שלום. תעזור לנו, בבקשה."
    },
    {
      "id": 110504456162975750,
      "target": "Mother: זהו, תעמוד בשקט ואל תזוז."
    },
    {
      "id": 110504456150392835,
      "target": "אנחנו מכירים?"
    },
    {
      "id": 110504456150392834,
      "target": "WheelChair: מזמן לא התראינו. מה שלומך?"
    }
  ]
}
