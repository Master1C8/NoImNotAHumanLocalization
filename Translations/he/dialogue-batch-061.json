  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504456095866885,
      "target": "מדענים צופים שבעוד כמה ימים..."
    },
    {
      "id": 110504456095866884,
      "target": "״אנרגיית השמש הולכת ודועכת."
    },
    {
      "id": 110504455995203591,
      "target": "מי יודע… אולי עוד מחכות לנו עשר שנים?"
    },
    {
      "id": 110504455995203590,
      "target": "אבל טוב שלפחות אחד הדיירים שמח."
    },
    {
      "id": 110504455995203589,
      "target": "המחשבה על ההמתנה לסוף מכבידה עליך מאוד."
    },
    {
      "id": 110504455995203588,
      "target": "אבל מה אחר כך? הקיץ הבא יהיה האחרון? או שלא?"
    },
    {
      "id": 110504455995203587,
      "target": "אתה מבין שאת השנה הזאת עוד תחיה."
    },
    {
      "id": 110504455995203586,
      "target": "אכזבה?"
    },
    {
      "id": 110504455995203585,
      "target": "אוחזת בך…"
    },
    {
      "id": 110504455995203584,
      "target": "...יהיה אפשר לצאת בחופשיות החוצה ביום״."
    },
    {
      "id": 110504455991009290,
      "target": "יום אחד אתה שומע הודעה ברדיו."
    },
    {
      "id": 110504455991009289,
      "target": "ההמתנה הארוכה למוות מייסרת יותר ממוות ברגע אחד. איש לא מקנא באלה שעוד חיים."
    },
    {
      "id": 110504455991009288,
      "target": "יש מי שמקווים שהשמש תשרוף סוף סוף את כדור הארץ או תכבה לגמרי. אחרים חושבים איך לקרב את הקץ של עצמם."
    },
    {
      "id": 110504455991009287,
      "target": "כחודשיים נמשכת ההמתנה לסוף."
    },
    {
      "id": 110504455991009286,
      "target": "אתה מסמן את מניין הימים על קיר המרתף."
    },
    {
      "id": 110504455991009285,
      "target": "אתה סוגר את המרתף. עכשיו איש לא ייכנס לכאן."
    },
    {
      "id": 110504455991009284,
      "target": "אם תחסכו, האוכל אמור להספיק לחודש או חודשיים."
    },
    {
      "id": 110504455991009283,
      "target": "כאן קריר יותר מאשר בבית, אבל כולם עדיין חרדים."
    },
    {
      "id": 110504455991009282,
      "target": "אתה יורד למרתף עם השורדים."
    }
  ]
}
