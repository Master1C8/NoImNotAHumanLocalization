  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504456775344135,
      "target": "Wolfhound: איזה מין חברה זאת? החיות סביבנו חשפו את עצמן."
    },
    {
      "id": 110504456775344134,
      "target": "Wolfhound: מטורף מה שקורה. ראית?"
    },
    {
      "id": 110504456775344133,
      "target": "Wolfhound: שלום."
    },
    {
      "id": 110504456754372618,
      "target": "לאיזה סוף?"
    },
    {
      "id": 110504456754372617,
      "target": "על מה אתה מדבר?"
    },
    {
      "id": 110504456754372616,
      "target": "SuperFake: אם לא אנחנו, אתם תסתדרו הלאה בעצמכם."
    },
    {
      "id": 110504456754372615,
      "target": "SuperFake: כל הסיפור הזה מתקרב לסופו."
    },
    {
      "id": 110504456754372614,
      "target": "SuperFake: אמרו לי שזאת הפגישה האחרונה איתך."
    },
    {
      "id": 110504456741789699,
      "target": "לא אכפת לי"
    },
    {
      "id": 110504456741789698,
      "target": "אני לא מרגיש את זה"
    },
    {
      "id": 110504456741789697,
      "target": "SuperFake: דברים מעניינים מתרחשים סביבך."
    },
    {
      "id": 110504456741789696,
      "target": "SuperFake: אתה מבין על מי אני מדבר?"
    },
    {
      "id": 110504456737595403,
      "target": "SuperFake: הרי יש לו רק מילה, רק מילה, אבל איזו מילה!"
    },
    {
      "id": 110504456737595402,
      "target": "SuperFake: ואילו אדם מסוים הפסיק למות."
    },
    {
      "id": 110504456737595401,
      "target": "SuperFake: גם אני."
    },
    {
      "id": 110504456737595400,
      "target": "SuperFake: השינויים רודפים אותך."
    },
    {
      "id": 110504456737595399,
      "target": "SuperFake: אתה מרגיש את זה?"
    },
    {
      "id": 110504456725012480,
      "target": "אני לא יודע מה לחשוב עליו"
    },
    {
      "id": 110504456720818187,
      "target": "הוא עושה את העבודה שלו"
    },
    {
      "id": 110504456720818186,
      "target": "SuperFake: מה דעתך על האיש ההוא בחליפה?"
    },
    {
      "id": 110504456720818184,
      "target": "SuperFake: ואתה עדיין יושב בבית."
    },
    {
      "id": 110504456712429571,
      "target": "את מחפשת מישהו?"
    },
    {
      "id": 110504456712429570,
      "target": "ומי את?"
    },
    {
      "id": 110504456712429569,
      "target": "Greatmother: יש מישהו בבית או מה?"
    },
    {
      "id": 110504456712429568,
      "target": "Greatmother: היייי."
    },
    {
      "id": 110504456699846663,
      "target": "כמה זמן אתה כבר מחפש מקום שקט?"
    },
    {
      "id": 110504456699846661,
      "target": "Cold: אוכל למצוא אצלך שלווה?"
    },
    {
      "id": 110504456699846660,
      "target": "Cold: אומר מיד, חום לא מפחיד אותי. ובכל זאת אני מחפש מקום שקט."
    },
    {
      "id": 110504456699846659,
      "target": "Cold: שלום."
    },
    {
      "id": 110504456687263754,
      "target": "מה אתה מחפש כאן?"
    },
    {
      "id": 110504456687263753,
      "target": "למה אתה נודד?"
    },
    {
      "id": 110504456687263752,
      "target": "Hunter: עכשיו כבר לא אוכל ללכת הרבה — הגיל עושה את שלו."
    },
    {
      "id": 110504456687263751,
      "target": "Hunter: אני לא מכאן. אני לא אוהב להישאר במקום אחד יותר מדי."
    },
    {
      "id": 110504456687263750,
      "target": "Hunter: היי, מה המצב כאן?"
    },
    {
      "id": 110504456670486537,
      "target": "אתה נראה… רע"
    },
    {
      "id": 110504456670486536,
      "target": "רק אל תמות לי על מפתן הדלת"
    },
    {
      "id": 110504456670486535,
      "target": "Prophet: היא עזבה אותי?"
    },
    {
      "id": 110504456670486534,
      "target": "Prophet: הראייה שלי נחלשה. עכשיו אני רואה גרוע גם בעיניים ממש."
    },
    {
      "id": 110504456670486533,
      "target": "Prophet: שכחתי איך אתה נראה."
    },
    {
      "id": 110504456657903617,
      "target": "אתה מדבר אל עצמך?"
    },
    {
      "id": 110504456657903616,
      "target": "היי. אתה צריך… איזו עזרה?"
    },
    {
      "id": 110504456653709323,
      "target": "Prophet: זה בגלל ההרס?"
    },
    {
      "id": 110504456653709322,
      "target": "Prophet: אני מרגיש גרוע יותר. מוזר כל כך."
    },
    {
      "id": 110504456653709321,
      "target": "Prophet: אתה כאן, נכון? ליד הדלת?"
    },
    {
      "id": 110504456645320710,
      "target": "למה ביקשת שאכניס מישהו עם חתול?"
    },
    {
      "id": 110504456645320709,
      "target": "איך אתה יודע על החתול?"
    },
    {
      "id": 110504456645320708,
      "target": "Prophet: תחליט בעצמך מה לעשות עם מי שהביא לך אותו."
    },
    {
      "id": 110504456645320707,
      "target": "Prophet: מצוין. החתול אצלך."
    },
    {
      "id": 110504456632737799,
      "target": "איזו קטסטרופה?"
    }
  ]
}
