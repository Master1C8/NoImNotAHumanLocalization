  "entries": [
    {
      "id": 110504457148637184,
      "target": "Ballerina: אתה רואה את הפרוותי?"
    },
    {
      "id": 110504457144442890,
      "target": "Ballerina: דיברתי אל החתול, לא אליך."
    },
    {
      "id": 110504457144442889,
      "target": "Ballerina: בוא, חתולון, תשעשע אותי כאן, טוב?"
    },
    {
      "id": 110504457144442886,
      "target": "Ballerina: אה, אמרו לי שלא אמורים להיות כאן כאלה. קדימה, תגרש אותו."
    },
    {
      "id": 110504457144442885,
      "target": "Ballerina: יש אצלך את {0}?"
    },
    {
      "id": 110504456574017540,
      "target": "Ballerina: מתנה ממני בשבילך."
    },
    {
      "id": 110504456574017539,
      "target": "Ballerina: תמצא את החתול מתחת לבית."
    },
    {
      "id": 110504456574017537,
      "target": "Ballerina: בוא, חתולון, תשעשע אותי כאן, טוב?"
    },
    {
      "id": 110504456574017536,
      "target": "Ballerina: תרגיש בבית."
    },
    {
      "id": 110504456569823243,
      "target": "לכי לעזאזל כבר"
    },
    {
      "id": 110504456569823242,
      "target": "…תיכנסי"
    },
    {
      "id": 110504456569823241,
      "target": "Ballerina: תחשוב שוב."
    },
    {
      "id": 110504456569823240,
      "target": "Ballerina: אתה רואה את החתול?"
    },
    {
      "id": 110504456569823239,
      "target": "Ballerina: ואל תתעלל בחתול."
    },
    {
      "id": 110504456569823238,
      "target": "Ballerina: לא משאירים אישה לקפוא בחוץ, בחור צעיר."
    },
    {
      "id": 110504456569823234,
      "target": "Ballerina: אתה פותח? לא?"
    },
    {
      "id": 110504456569823233,
      "target": "Ballerina: עברתי את כל המבחן שלך?"
    },
    {
      "id": 110504456569823232,
      "target": "Ballerina: זה לא מספיק?"
    },
    {
      "id": 110504456565628939,
      "target": "Ballerina: יש לי שתי ידיים, שתי רגליים וראש אחד."
    },
    {
      "id": 110504456565628936,
      "target": "Ballerina: נו, תחליט כבר, מה עושים?"
    },
    {
      "id": 110504456565628935,
      "target": "Ballerina: אני רקדנית בלט."
    },
    {
      "id": 110504456565628934,
      "target": "Ballerina: אולי גם ארקוד."
    },
    {
      "id": 110504456565628933,
      "target": "Ballerina: שארקוד בשבילך?"
    },
    {
      "id": 110504456565628932,
      "target": "Ballerina: אז מה?"
    },
    {
      "id": 110504456565628931,
      "target": "תוכיחי שאת בת אדם"
    },
    {
      "id": 110504456565628930,
      "target": "אני לא מאמין שאת בת אדם"
    },
    {
      "id": 110504456565628929,
      "target": "Ballerina: משפט מוזר."
    },
    {
      "id": 110504456565628928,
      "target": "Ballerina: ומה הלאה? הזכרתי לך אותו? או מה?"
    },
    {
      "id": 110504456561434635,
      "target": "Ballerina: נו… בסדר."
    },
    {
      "id": 110504456561434634,
      "target": "תוכיחי שאת בת אדם"
    },
    {
      "id": 110504456561434633,
      "target": "אני לא מאמין שאת בת אדם"
    },
    {
      "id": 110504456561434632,
      "target": "Ballerina: הא."
    },
    {
      "id": 110504456561434630,
      "target": "Ballerina: לא יודעת. מה זה משנה?"
    },
    {
      "id": 110504456561434629,
      "target": "את מזכירה לי מישהו… אדם"
    },
    {
      "id": 110504456561434628,
      "target": "מישהו שלח אותך לכאן?"
    },
    {
      "id": 110504456561434627,
      "target": "Ballerina: לא חם אצלך."
    },
    {
      "id": 110504456561434626,
      "target": "Ballerina: ראיתי את הבית שלך ובאתי."
    },
    {
      "id": 110504456561434625,
      "target": "Ballerina: אתה רואה את העיר? גרתי שם."
    },
    {
      "id": 110504456561434624,
      "target": "את מזכירה לי מישהו… אדם"
    },
    {
      "id": 110504456557240330,
      "target": "מישהו שלח אותך לכאן?"
    },
    {
      "id": 110504456557240329,
      "target": "Ballerina: למדתי בלט. רואים?"
    },
    {
      "id": 110504456557240328,
      "target": "Ballerina: אני רוקדת."
    },
    {
      "id": 110504456557240327,
      "target": "איך מצאת את הבית שלי?"
    },
    {
      "id": 110504456557240325,
      "target": "Ballerina: אמרו לי לבוא לכאן, אז באתי."
    },
    {
      "id": 110504456557240324,
      "target": "Ballerina: אתה פותח את הדלת או לא?"
    }
  ]
}
