  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504457467404288,
      "target": "ואיך בכלל הגעת לכאן?"
    },
    {
      "id": 110504457463209994,
      "target": "מה העניין?"
    },
    {
      "id": 110504457463209993,
      "target": "Tourist: שלום. תוכל לעזור לי? אני לא מכאן."
    },
    {
      "id": 110504457450627081,
      "target": "את זריזה. לאן את נדחפת?"
    },
    {
      "id": 110504457450627080,
      "target": "למה לא אמור להיות כאן אף אחד?"
    },
    {
      "id": 110504457450627079,
      "target": "Alt: אה, בכל זאת יש פה מישהו. אפשר להיכנס?"
    },
    {
      "id": 110504457438044167,
      "target": "למה אתה שמח כל כך?"
    },
    {
      "id": 110504457438044166,
      "target": "השתגעת?"
    },
    {
      "id": 110504457438044165,
      "target": "FunnyGuy: איזה לילה, אה? אתה מרגיש? פשוט קסום!"
    },
    {
      "id": 110504457438044164,
      "target": "FunnyGuy: היייי, שלום!"
    },
    {
      "id": 110504457425461254,
      "target": "איך אדע שאתה לא אורח?"
    },
    {
      "id": 110504457425461253,
      "target": "מה הביא אותך לכאן?"
    },
    {
      "id": 110504457425461252,
      "target": "Fairytaller: ערב טוב. יש אצלך מקום לאדם אחד? אני לא צריך הרבה."
    },
    {
      "id": 110504457412878343,
      "target": "מאיפה זה על העור שלך?"
    },
    {
      "id": 110504457412878342,
      "target": "מה קרה לך?"
    },
    {
      "id": 110504457412878341,
      "target": "Leper: שלום. אני מקווה שהמראה שלי לא ימנע ממך להכניס אותי."
    },
    {
      "id": 110504457400295435,
      "target": "כאן טוב יותר מבמלון?"
    },
    {
      "id": 110504457400295434,
      "target": "למה? תחזור למלון"
    },
    {
      "id": 110504457400295433,
      "target": "Nervous: קצת מ־מפחיד לחזור. אפשר להישאר פה?"
    },
    {
      "id": 110504457400295432,
      "target": "Nervous: התאכסנתי במלון ״תקווה״, אבל החלטתי לצאת לטיול."
    },
    {
      "id": 110504457400295431,
      "target": "Nervous: סליחה, אני קצת לחוץ."
    },
    {
      "id": 110504457400295430,
      "target": "Nervous: שלום, חה חה."
    },
    {
      "id": 110504457396101120,
      "target": "כלומר גובי החובות רודפים אחריך?"
    },
    {
      "id": 110504457391906827,
      "target": "איזה חברים יש לך?"
    },
    {
      "id": 110504457391906826,
      "target": "Bald: גרתי פה קודם עם אמא וסבתא, אבל גובי החובות גירשו אותנו מהדירה. סיפור מחורבן לגמרי. אם תכניס אותי, אספר לך פעם."
    },
    {
      "id": 110504457391906825,
      "target": "Bald: חשבתי שיש לי המון חברים ושאיכשהו נסתדר ביחד, אבל כמו שאתה רואה, אני נאלץ לפנות לזרים."
    },
    {
      "id": 110504457391906824,
      "target": "Bald: תיתן לי מקום להישאר לזמן מה? כל חבר שניסיתי לבקר — או שלא היה בבית, או שהעיפו אותו קיבינימט, או שקרה משהו אחר."
    },
    {
      "id": 110504457391906823,
      "target": "Bald: שלום, אחי!"
    },
    {
      "id": 110504457379323914,
      "target": "מה מספרים על הבית שלי?"
    },
    {
      "id": 110504457379323913,
      "target": "תודה?"
    },
    {
      "id": 110504457379323912,
      "target": "Tough: אבל אני מכבדת אותך."
    },
    {
      "id": 110504457379323911,
      "target": "Tough: מגיעים הנה רק מי שנואשים, או מי שלא מבינים מה קורה כאן."
    },
    {
      "id": 110504457379323910,
      "target": "Tough: רבים משתדלים לעקוף את הבית שלך."
    },
    {
      "id": 110504457379323909,
      "target": "Tough: שמעתי עליך הרבה."
    },
    {
      "id": 110504457366741000,
      "target": "אתה מחפש מחסה?"
    },
    {
      "id": 110504457366740999,
      "target": "מה אתה צריך?"
    },
    {
      "id": 110504457366740998,
      "target": "Jacket: שלום. תוכל בבקשה להכניס אותי לבית?"
    },
    {
      "id": 110504457354158088,
      "target": "מאיפה צצת?"
    },
    {
      "id": 110504457354158087,
      "target": "למה אתה רק בתחתונים?"
    },
    {
      "id": 110504457354158086,
      "target": "Experienced: ערב טוב לתא. תכניס אותי, פראייר?"
    },
    {
      "id": 110504457345769478,
      "target": "למה אתה נראה כאילו לא ישנת שבוע?"
    },
    {
      "id": 110504457345769477,
      "target": "מה יש לך איתך?"
    },
    {
      "id": 110504457345769476,
      "target": "Rocker: כי בחוץ יש עכשיו בלגן מחורבן, כאילו דחסו המון אנשים לאולם הופעות קטנטן בלי מאוורר מזוין!"
    },
    {
      "id": 110504457345769475,
      "target": "Rocker: אה, אני לא איזה נטל."
    },
    {
      "id": 110504457345769474,
      "target": "Rocker: תן לי להסתתר לכמה לילות, לא אתקע פה לנצח. אני לא איזה… אהה, איך קוראים לזה?"
    },
    {
      "id": 110504457345769473,
      "target": "Rocker: אחי, תפתח. השמש קופחת כמו זרקור בחזרה, עוד מעט אתעוור פה, לעזאזל."
    },
    {
      "id": 110504457320603656,
      "target": "אין לי מטען בשבילך"
    },
    {
      "id": 110504457320603655,
      "target": "לאן אתה הולך טעון כל כך?"
    },
    {
      "id": 110504457320603654,
      "target": "Unstable: אני טעון באנרגיה בטירוף, אבל אפילו אנרז׳קה כבר לא עוזרת. אני צריך לנוח."
    },
    {
      "id": 110504457320603653,
      "target": "Unstable: היי, שלום! טוב שיש פה מישהו."
    }
  ]
}
