  "entries": [
    {
      "id": 110504453788999687,
      "target": "לשטוף את הפנים"
    },
    {
      "id": 110504453788999684,
      "target": "שילך לעזאזל"
    },
    {
      "id": 110504453747056646,
      "target": "מה היה הדיווח הזה בכלל?"
    },
    {
      "id": 110504453747056644,
      "target": "האוזניים בסדר."
    },
    {
      "id": 110504453747056641,
      "target": "צריך לשטוף את הפנים. מקווה שזה יעזור."
    },
    {
      "id": 110504453742862345,
      "target": "זה נראה כמו גירוי, או גרוע מכך, פטרייה."
    },
    {
      "id": 110504453742862344,
      "target": "לעזאזל, מה זה החרא הזה!?"
    },
    {
      "id": 110504453742862343,
      "target": "כמו שצריך להיות."
    },
    {
      "id": 110504453742862342,
      "target": "יש שיער בבתי השחי."
    },
    {
      "id": 110504453742862339,
      "target": "הן לא אדומות, אז אין על מה להיטפל."
    },
    {
      "id": 110504453742862338,
      "target": "עיניים רגילות לגמרי."
    },
    {
      "id": 110504453742862337,
      "target": "לא הייתי צריך לשתות את הזבל הזה עם קפאין."
    },
    {
      "id": 110504453742862336,
      "target": "לעזאזל. הן אדומות…"
    },
    {
      "id": 110504453591867396,
      "target": "יש עקבות אבק שרפה על טביעות האצבע. אבל זה עניין קטן."
    },
    {
      "id": 110504453591867395,
      "target": "ידיים נקיות…"
    },
    {
      "id": 110504453591867394,
      "target": "הכול בגלל המערה שאני חופר."
    },
    {
      "id": 110504453591867393,
      "target": "ציפורניים מלוכלכות…"
    },
    {
      "id": 110504453587673094,
      "target": "זה דווקא לטובה. ככה לא יחשבו שאני אורח."
    },
    {
      "id": 110504453587673093,
      "target": "שיניים צהובות…"
    },
    {
      "id": 110504453587673092,
      "target": "מעשנים היו מוכרים כליה בשביל שיניים כאלה."
    },
    {
      "id": 110504453587673091,
      "target": "לעזאזל, הן לבנות…"
    },
    {
      "id": 110504453587673088,
      "target": "לשטוף את הפנים"
    },
    {
      "id": 110504453583478786,
      "target": "אני צריך לבדוק את עצמי."
    }
  ]
}
