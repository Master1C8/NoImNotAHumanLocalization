  "entries": [
    {
      "id": 110504457823920137,
      "target": "Phone: להתראות."
    },
    {
      "id": 110504457823920136,
      "target": "Phone: ו… תודה לך שעזרת לו."
    },
    {
      "id": 110504457823920135,
      "target": "Phone: אני מוכנה לתת מחסה לאחי. תמסור לו את זה. הוא יודע מה הכתובת שלי."
    },
    {
      "id": 110504457823920133,
      "target": "Phone: אלוהים… איך זה קרה?…"
    },
    {
      "id": 110504457823920130,
      "target": "כנראה"
    },
    {
      "id": 110504457823920128,
      "target": "Phone: לעזאזל… זה לא ייתכן… הם מתים?"
    },
    {
      "id": 110504457819725834,
      "target": "Phone: יכול להיות שהם…"
    },
    {
      "id": 110504457819725833,
      "target": "Phone: הוא חיפש מחסה? אבל הוא הרי גר עם ההורים שלו?"
    },
    {
      "id": 110504457819725831,
      "target": "כנראה"
    },
    {
      "id": 110504457819725829,
      "target": "Phone: לעזאזל… זה לא ייתכן… הם מתים?"
    },
    {
      "id": 110504457819725827,
      "target": "Phone: אתה לא מתכוון לומר ש…"
    },
    {
      "id": 110504457819725826,
      "target": "Phone: נעלמו? איך זה קרה?"
    },
    {
      "id": 110504457819725825,
      "target": "הוא בא אליי לחפש מחסה"
    },
    {
      "id": 110504457819725824,
      "target": "ההורים שלו נעלמו"
    },
    {
      "id": 110504457815531532,
      "target": "Phone: אבל רגע… מי אתה? ולמה הוא אצלך?"
    },
    {
      "id": 110504457815531531,
      "target": "Phone: אה, אתה מדבר על אחי הביולוגי, נכון?"
    },
    {
      "id": 110504457815531529,
      "target": "Phone: איזה אח? אין לי…"
    },
    {
      "id": 110504457815531528,
      "target": "את יכולה לעזור לאח שלך?"
    },
    {
      "id": 110504457815531527,
      "target": "שלום. אחיך נתן לי את המספר שלך"
    },
    {
      "id": 110504457815531526,
      "target": "Phone: הלו, מי זה?"
    }
  ]
}
