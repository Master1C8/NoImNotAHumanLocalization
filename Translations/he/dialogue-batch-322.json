  "entries": [
    {
      "id": 110504454824992774,
      "target": "שוב אתה צריך משהו?"
    },
    {
      "id": 110504454812409865,
      "target": "מה עוד אתה צריך?"
    },
    {
      "id": 110504454799826952,
      "target": "אתה מרגיש טוב יותר?"
    },
    {
      "id": 110504454778855433,
      "target": "נו, ספר לי מה קרה לך."
    },
    {
      "id": 110504454778855432,
      "target": "Buddy: תשאל, חבר'מן."
    },
    {
      "id": 110504454774661123,
      "target": "אתה נראה קודר היום"
    },
    {
      "id": 110504454774661122,
      "target": "Buddy: תשאל, חבר'מן."
    },
    {
      "id": 110504454766272513,
      "target": "מה נשמע?"
    },
    {
      "id": 110504454766272512,
      "target": "Buddy: תשאל, חבר'מן."
    },
    {
      "id": 110504454749495296,
      "target": "למה אתה לא רוצה לנסוע לאחותך?"
    },
    {
      "id": 110504454741106695,
      "target": "נרגעת? איזו אחות?"
    },
    {
      "id": 110504454736912392,
      "target": "יש לך עוד קרובי משפחה?"
    },
    {
      "id": 110504454736912386,
      "target": "מה שלומך?"
    },
    {
      "id": 110504454728523778,
      "target": "אז מה הסיפור עם המטורף ההוא והנשק האוטומטי?"
    },
    {
      "id": 110504454728523777,
      "target": "Fugitive: הפצע המחורבן הזה…"
    },
    {
      "id": 110504454711746567,
      "target": "מה שלום הפצע שלך?"
    },
    {
      "id": 110504454711746566,
      "target": "Fugitive: הפצע המחורבן הזה…"
    },
    {
      "id": 110504454707552267,
      "target": "למה הוועדה למצבי חירום בכלל באה לקחת אותך?"
    },
    {
      "id": 110504454707552266,
      "target": "Fugitive: הפצע המחורבן הזה…"
    },
    {
      "id": 110504454694969355,
      "target": "מה רצו ה״מחללי שם שמיים״ האלה?"
    },
    {
      "id": 110504454690775051,
      "target": "למה לא נשארת במנזר שלך?"
    },
    {
      "id": 110504454690775041,
      "target": "אם הבית לא מוצא חן בעינייך, למה שלא תעופי מפה?"
    },
    {
      "id": 110504454686580738,
      "target": "איך הבית בעינייך?"
    },
    {
      "id": 110504454682386437,
      "target": "לא חייבים להפוך לרוצח צמא דם כדי לשרוד"
    },
    {
      "id": 110504454678192132,
      "target": "מי היה האיש שעמד בקצה הסמטה?"
    },
    {
      "id": 110504454673997830,
      "target": "ספר לי מה קרה בסמטה"
    },
    {
      "id": 110504454669803531,
      "target": "אני צריך לבדוק אותך"
    },
    {
      "id": 110504454669803530,
      "target": "אתה עדיין רוצה לראות אותי הורג אורחים?"
    },
    {
      "id": 110504454665609227,
      "target": "העבודה במכס הייתה טובה יותר? שם לפחות הייתה לכם סמכות"
    },
    {
      "id": 110504454661414921,
      "target": "את לא באמת צריכה בעל, אלא את הוועדה למצבי חירום, נכון?"
    },
    {
      "id": 110504454661414913,
      "target": "למה הסגרת את השכן שלך?"
    }
  ]
}
