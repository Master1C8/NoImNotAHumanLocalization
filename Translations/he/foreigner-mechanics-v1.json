{
  "schemaVersion": 1,
  "locale": "he",
  "sourceSpecSha256": "13a6edc02ab914becdd86af5e8829299c7a7b11ff3c300e61b3aed023b441368",
  "editorialStatus": "development draft; independent mechanics review pending",
  "sourceInterpretationNotes": {
    "line:Foreigner_Death_0f116b2": "Damaged Russian keyboard-layout fragment interpreted as killing, not a person named Ivan.",
    "line:Foreigner_Photo_0c3c7aa": "Damaged photo/adoration wording interpreted using neighboring Photo_DontShoot preference for photos; exact damaged syntax unresolved."
  },
  "entries": [
    {
      "key": "line:FEMA_GivingPostcard_Foreigner_0af7d0d",
      "parts": [
        {
          "kind": "opaque",
          "text": "Beseder, ekakh..."
        }
      ]
    },
    {
      "key": "line:FEMA_GivingPostcard_Foreigner_0cc7047",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ma ze?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_1_0e957d2",
      "parts": [
        {
          "kind": "understood",
          "text": "בהצלחחחה!",
          "sourceCue": "Уууудаси!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_1_0c936e3",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ulai agia habayta akharei kol hazman haze…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_1_0905b5d",
      "parts": [
        {
          "kind": "opaque",
          "text": "Aval makhar elekh latakhana ve egale be atzmi!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_1_0e19b62",
      "parts": [
        {
          "kind": "opaque",
          "text": "Lo hevanti, slikha."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_0ee031f",
      "parts": [
        {
          "kind": "understood",
          "text": "ביייי!",
          "sourceCue": "Пайкааа!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_02340b2",
      "parts": [
        {
          "kind": "opaque",
          "text": "Halayla ani ozev. Lehitraot!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_04527f2",
      "parts": [
        {
          "kind": "opaque",
          "text": "Makhar etze habayta! Lefakhot elekh latakhana."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_08b6c83",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ani lo mevin, khaver."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_5_058e3f1",
      "parts": [
        {
          "kind": "opaque",
          "text": "Hitslikhu lehasbir li she harakavot adayin nosot! Ma ata omer?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_5_0a05381",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ah, leze hitkavanta."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_2_043501e",
      "parts": [
        {
          "kind": "opaque",
          "text": "Hen adayin mafligot? Tsarikh lekhapes meida, toda!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_2_020fa6b",
      "parts": [
        {
          "kind": "opaque",
          "text": "Klomar lashut be oniya?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_1_0264fa8",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ulai be emet efshar adayin latos mipo."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_1_03e6625",
      "parts": [
        {
          "kind": "opaque",
          "text": "Tsarikh limtso meida be eize makom."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_1_06190d7",
      "parts": [
        {
          "kind": "opaque",
          "text": "Matos? Ata khoshev she hem adayin tasim?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_0f3f5f9",
      "parts": [
        {
          "kind": "opaque",
          "text": "Hamatsav hara legamrei, ein mila akheret."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_00450ac",
      "parts": [
        {
          "kind": "opaque",
          "text": "Bati levaker khaver, ve az ze kara."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_04109c2",
      "parts": [
        {
          "kind": "opaque",
          "text": "Bayit? Ata shoel al habayit?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_0ba0261",
      "parts": [
        {
          "kind": "opaque",
          "text": "Eize zvaa."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_084c32d",
      "parts": [
        {
          "kind": "opaque",
          "text": "Meanyen im gam etzli babayit ze kore."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_05970a6",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ze kashe, aval ulai yaazor li."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_0ef9d29",
      "parts": [
        {
          "kind": "understood",
          "text": "טווב.",
          "sourceCue": "Харасхо."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_0a6ab5a",
      "parts": [
        {
          "kind": "understood",
          "text": "טו…",
          "sourceCue": "Хара…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_041d9b1",
      "parts": [
        {
          "kind": "understood",
          "text": "טווווב.",
          "sourceCue": "Харохооо."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_0a21905",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ani anase lakhzor al ze."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_2_04c6bc4",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ulai zot milat she ela."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_2_090b6a7",
      "parts": [
        {
          "kind": "opaque",
          "text": "Aval shaalta mashehu."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_1_01c288c",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ulai zot milat she ela."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_1_01a5f8a",
      "parts": [
        {
          "kind": "opaque",
          "text": "Adayin lo mevin. Aval shaalta mashehu."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_09e3b4a",
      "parts": [
        {
          "kind": "understood",
          "text": "איך.",
          "sourceCue": "Как."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_0f0190b",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ulai kakh lefakhot avin ma ani omer."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_075bcb9",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ani yakhol lakhzor al hamilim shelkha, ve ata tagiv."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_1_1_0ebd34d",
      "parts": [
        {
          "kind": "opaque",
          "text": "Namtzi eizo safa meshutefet?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_1_1_0cd4635",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ani lo mevin otkha. Ma efshar laasot?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_1_0d71f9d",
      "parts": [
        {
          "kind": "opaque",
          "text": "TAFRU LI ET HAPE! Rak ki lo mevinim oti."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_1_09c22e5",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ze siyut!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Death_0f116b2",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ha… riga…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Death_0b50221",
      "parts": [
        {
          "kind": "opaque",
          "text": "Kakh ze kore. Lo mevinim otkha, pokhadim mimkha, ve ata…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Ears_DontShoot_00a90ca",
      "parts": [
        {
          "kind": "opaque",
          "text": "Hayiti noten hakol kedei lirot oto shuv. Ani kol kakh mitgaagea. "
        },
        {
          "kind": "understood",
          "text": "תראאה",
          "sourceCue": "Пакаж"
        },
        {
          "kind": "opaque",
          "text": ", ma ze omer?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Photo_DontShoot_0bf7704",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ani ohev tmunot. Ata kanire lo maarikh otan…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Armpit_DontShoot_05058dc",
      "parts": [
        {
          "kind": "understood",
          "text": "בודקק",
          "sourceCue": "Правирйат ба"
        },
        {
          "kind": "opaque",
          "text": " kan… Ze lo nire nakhon…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Eyes_DontShoot_044b445",
      "parts": [
        {
          "kind": "opaque",
          "text": "Einayim kmo einayim. Lama lehafkhid?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Hands_DontShoot_062d5bf",
      "parts": [
        {
          "kind": "opaque",
          "text": "Tsarikh lishtof et hayadayim…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Teeth_DontShoot_0f917b2",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ata yodea she tafru li et hape. Akhshav ata gam mekaven rove ve "
        },
        {
          "kind": "understood",
          "text": "יוורה",
          "sourceCue": "расрел"
        },
        {
          "kind": "opaque",
          "text": " be kulam…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Ears_Gun_022cef2",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ve ma akhshav?!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Armpit_Gun_0488113",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ben adam! Tafsik! Eize shtuyot!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Eyes_Gun_0bf3d2f",
      "parts": [
        {
          "kind": "opaque",
          "text": "Al! Ani tov! Anakhnu pashut lo mevinim ze et ze!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Hands_Gun_0b64782",
      "parts": [
        {
          "kind": "opaque",
          "text": "Taziz et harove! Lo asiti lekha shum davar ra!!!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Teeth_Gun_0a4207d",
      "parts": [
        {
          "kind": "opaque",
          "text": "Lama, ma yesh lekha!? Asiti ma sheratsita!!!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Ears_0f4eb6c",
      "parts": [
        {
          "kind": "opaque",
          "text": "Agil me hakhaver hayakar sheli."
        }
      ]
    },
    {
      "key": "line:Foreigner_Ears_076f3a7",
      "parts": [
        {
          "kind": "opaque",
          "text": "Oznayim kmo oznayim."
        }
      ]
    },
    {
      "key": "line:Foreigner_Photo_002e8e0",
      "parts": [
        {
          "kind": "opaque",
          "text": "Tare li?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Photo_0c3c7aa",
      "parts": [
        {
          "kind": "opaque",
          "text": "Tmuna? Ani mamash ohev et ze!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Armpit_0d48250",
      "parts": [
        {
          "kind": "opaque",
          "text": "Merutse?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Armpit_090c5f5",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ani lo mevin et kol ze… Nu, beseder…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Eyes_0b39cdc",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ani adayin lo mevin lama ata tsarikh et kol ze… "
        },
        {
          "kind": "understood",
          "text": "שמשש",
          "sourceCue": "Солце"
        },
        {
          "kind": "opaque",
          "text": " yekhola lisrof et hareshetit. Ani lo "
        },
        {
          "kind": "understood",
          "text": "מסתכלל",
          "sourceCue": "смарет"
        },
        {
          "kind": "opaque",
          "text": " al "
        },
        {
          "kind": "understood",
          "text": "שמשש",
          "sourceCue": "солце"
        },
        {
          "kind": "opaque",
          "text": "."
        }
      ]
    },
    {
      "key": "line:Foreigner_Eyes_0aba9fb",
      "parts": [
        {
          "kind": "opaque",
          "text": "Einayim?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Hands_0144f06",
      "parts": [
        {
          "kind": "opaque",
          "text": "Lama ata ose et kol ze? "
        },
        {
          "kind": "understood",
          "text": "הורגג",
          "sourceCue": "Убйивай"
        },
        {
          "kind": "opaque",
          "text": " bishvil hakeyf?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Hands_0654052",
      "parts": [
        {
          "kind": "opaque",
          "text": "Yadayim? Beseder."
        }
      ]
    },
    {
      "key": "line:Foreigner_Teeth_02674b3",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ve ma akhshav?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Teeth_03ba689",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ma? Ata matzbia al "
        },
        {
          "kind": "understood",
          "text": "פהה",
          "sourceCue": "рхот"
        },
        {
          "kind": "opaque",
          "text": "? Ken, tafru oto. Ve ma akhshav? Lekhayekh?"
        }
      ]
    },
    {
      "key": "line:Foreigner_WannaCheck_0d955c8",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ani lo mevin shum davar. Ma ata rotse mimeni?"
        }
      ]
    }
  ]
}
