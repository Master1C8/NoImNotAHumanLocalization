  "entries": [
    {
      "id": 110504456108449794,
      "target": "אבל זה אחר כך."
    },
    {
      "id": 110504456108449793,
      "target": "אף אחד לא מסתובב לי בין הרגליים."
    },
    {
      "id": 110504456108449792,
      "target": "שקט מאוד."
    },
    {
      "id": 110504456037146633,
      "target": "אישן קצת."
    },
    {
      "id": 110504456037146632,
      "target": "אני קצת עייף."
    },
    {
      "id": 110504456037146630,
      "target": "הלוואי שאפגוש את כולם שוב, כמשפחה שלמה."
    },
    {
      "id": 110504456037146629,
      "target": "מישהו יבוא אליי?"
    },
    {
      "id": 110504456037146628,
      "target": "למה נתנו לי להיכנס לכאן?"
    },
    {
      "id": 110504456037146627,
      "target": "מעניין מה זה בכלל היה?"
    },
    {
      "id": 110504456037146626,
      "target": "הלוואי שזה יימשך עוד הרבה זמן…"
    },
    {
      "id": 110504456037146625,
      "target": "אבל גם אין לי כוונה."
    },
    {
      "id": 110504456037146624,
      "target": "אני לא יודע איך לצאת."
    },
    {
      "id": 110504456032952331,
      "target": "אני לא זוכר איך הגעתי לכאן."
    },
    {
      "id": 110504456032952330,
      "target": "אף אחד לא נדחף. אף אחד לא נוגע בי."
    },
    {
      "id": 110504456032952329,
      "target": "אבל… עכשיו אני רגוע."
    },
    {
      "id": 110504456032952328,
      "target": "אני לא יודע כמה זמן אני כבר יושב כאן."
    },
    {
      "id": 110504456032952327,
      "target": "אין כאן חילופי יום ולילה."
    },
    {
      "id": 110504456032952324,
      "target": "אני מפחד"
    },
    {
      "id": 110504456032952323,
      "target": "יש כאן מישהו?"
    },
    {
      "id": 110504456032952321,
      "target": "אני מפחד"
    },
    {
      "id": 110504456032952320,
      "target": "יש כאן מישהו?"
    },
    {
      "id": 110504456028758025,
      "target": "אני יכול לצפות בסרט?"
    },
    {
      "id": 110504456028758024,
      "target": "יהיה כאן עוד מישהו?"
    },
    {
      "id": 110504456028758022,
      "target": "אני יכול לצפות בסרט?"
    },
    {
      "id": 110504456028758021,
      "target": "יהיה כאן עוד מישהו?"
    },
    {
      "id": 110504456028758019,
      "target": "אני כאן לנצח?"
    },
    {
      "id": 110504456028758018,
      "target": "מתתי?"
    },
    {
      "id": 110504456028758016,
      "target": "תהנה."
    },
    {
      "id": 110504456024563722,
      "target": "הם ייראו גדולים, מאובקים, זרועים פשרות."
    },
    {
      "id": 110504456024563721,
      "target": "עם דרכיה הקצרות, שאחר כך ייראו לך רחבות באופן משונה."
    },
    {
      "id": 110504456024563720,
      "target": "זה המקום שלך."
    },
    {
      "id": 110504456024563719,
      "target": "זה מה שרצית, נכון?"
    }
  ]
}
