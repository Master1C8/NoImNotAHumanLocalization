  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504456121032710,
      "target": "לא נשאר ממך דבר."
    },
    {
      "id": 110504456121032709,
      "target": "חפצים, יצירות, עבודה, מחשבות, רגשות."
    },
    {
      "id": 110504456007786501,
      "target": "כאילו מעולם לא היית קיים ביקום הזה."
    },
    {
      "id": 110504456007786500,
      "target": "אחרי המוות כל זה נעלם."
    },
    {
      "id": 110504456007786499,
      "target": "די שאדם ימות, וכמעט מיד לא נותר ממנו זכר."
    },
    {
      "id": 110504456007786498,
      "target": "למה אדם נעלם לנצח?"
    },
    {
      "id": 110504456007786497,
      "target": "כל מה שהיה שלו אבד, נשחק או נשכח."
    },
    {
      "id": 110504456007786496,
      "target": "אדם נעלם. כאילו לא היה קיים מעולם."
    },
    {
      "id": 110504456003592204,
      "target": "קרובי המשפחה לא באו לראות מה נותר מאהובם."
    },
    {
      "id": 110504456003592203,
      "target": "הדבר האחרון שהיה לדייר – הבית – נהרס עם הזמן."
    },
    {
      "id": 110504456003592202,
      "target": "יש על הבית הזה יותר שמועות ממספר האנשים שגרו בו אי פעם."
    },
    {
      "id": 110504456003592201,
      "target": "כל אדם עוקף אותו כאילו היה אות מבשר רעות."
    },
    {
      "id": 110504456003592200,
      "target": "גם כעבור כמה ימים הבית נשאר ריק."
    },
    {
      "id": 110504456003592199,
      "target": "הגיע הזמן ללכת."
    },
    {
      "id": 110504456003592198,
      "target": "אחריך המבול, אה?"
    },
    {
      "id": 110504456003592197,
      "target": "אני רואה שכבר השלמת עם זה."
    },
    {
      "id": 110504456003592195,
      "target": "אני מתכוון, כשכבר לא תהיה כאן. מה אחר כך?"
    },
    {
      "id": 110504456003592194,
      "target": "דמיינת מה יהיה אחר כך?"
    },
    {
      "id": 110504456003592192,
      "target": "אני מקווה שאינך מתחרט על דבר."
    }
  ]
}
