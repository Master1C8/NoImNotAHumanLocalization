  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504456112644102,
      "target": "ואין את מי להאשים בזה."
    },
    {
      "id": 110504456112644101,
      "target": "זרקו אותך לרחוב."
    },
    {
      "id": 110504456112644100,
      "target": "זה יקרה בכל מקרה."
    },
    {
      "id": 110504456112644099,
      "target": "אני רואה אילו תוכניות היו לגביך."
    },
    {
      "id": 110504456112644098,
      "target": "מפחד קל להשתגע."
    },
    {
      "id": 110504456112644097,
      "target": "מפחיד למות."
    },
    {
      "id": 110504456066506756,
      "target": "אלא אם כן…"
    },
    {
      "id": 110504456066506755,
      "target": "תישרף לאט."
    },
    {
      "id": 110504456066506754,
      "target": "כבר אין לך אפשרות לשים קץ לחייך כדי לא לסבול."
    },
    {
      "id": 110504456066506753,
      "target": "לא נשאר לך כוח לזחול הרחק מקרני השמש."
    },
    {
      "id": 110504456066506752,
      "target": "בלי רובה. חבול."
    },
    {
      "id": 110504456062312457,
      "target": "אני מצטער מאוד."
    },
    {
      "id": 110504456062312456,
      "target": "פשוט… קירבת את זה."
    },
    {
      "id": 110504456062312455,
      "target": "במוקדם או במאוחר."
    },
    {
      "id": 110504456062312454,
      "target": "אתה מפחד להיעלם?"
    },
    {
      "id": 110504456062312453,
      "target": "מהכאב?"
    },
    {
      "id": 110504456062312452,
      "target": "וממה בדיוק נבהלת?"
    },
    {
      "id": 110504456062312451,
      "target": "עצוב מאוד לראות מה מחכה לך."
    },
    {
      "id": 110504456062312450,
      "target": "קל לקבל החלטות נוראיות."
    },
    {
      "id": 110504456062312449,
      "target": "אני מבין את זה היטב."
    }
  ]
}
