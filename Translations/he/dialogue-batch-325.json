  "entries": [
    {
      "id": 110504454258761731,
      "target": "איך את יודעת עליי את כל זה?"
    },
    {
      "id": 110504454250373129,
      "target": "מה קרה בינך לבין אשתך?"
    },
    {
      "id": 110504454246178826,
      "target": "אנשי הכת לקחו ממך מישהו?"
    },
    {
      "id": 110504454241984522,
      "target": "מאיפה כל הכעס הזה שלך?"
    },
    {
      "id": 110504454237790218,
      "target": "נו, נרגעת?"
    },
    {
      "id": 110504454237790212,
      "target": "מה היה נורא כל כך?"
    },
    {
      "id": 110504454233595913,
      "target": "את לא דואגת לילדים?"
    },
    {
      "id": 110504454233595906,
      "target": "אז מה הוא עשה?"
    },
    {
      "id": 110504454229401608,
      "target": "הלכת לבקר את בעלך?"
    },
    {
      "id": 110504454229401601,
      "target": "נו, התקשרת לבעלך?"
    },
    {
      "id": 110504454225207303,
      "target": "אבל באת עם ילד"
    },
    {
      "id": 110504454221012998,
      "target": "ומה קרה לרגליים שלך?"
    },
    {
      "id": 110504454221012997,
      "target": "WheelChair: אוי, החיים שלי — קופסת פח…"
    },
    {
      "id": 110504454216818695,
      "target": "איך איבדת את הרגליים?"
    },
    {
      "id": 110504454216818694,
      "target": "WheelChair: אוי, החיים שלי — קופסת פח…"
    },
    {
      "id": 110504454208430087,
      "target": "השמש טיגנה לך את המוח?"
    },
    {
      "id": 110504454208430086,
      "target": "WheelChair: אוי, החיים שלי — קופסת פח…"
    },
    {
      "id": 110504454195847177,
      "target": "אתה… בסדר?"
    },
    {
      "id": 110504454195847176,
      "target": "WheelChair: אוי, החיים שלי — קופסת פח…"
    },
    {
      "id": 110504454191652868,
      "target": "את מי חיפשת?"
    },
    {
      "id": 110504454191652867,
      "target": "WheelChair: אוי, החיים שלי — קופסת פח…"
    },
    {
      "id": 110504454183264256,
      "target": "אתה נראה ממש רע"
    },
    {
      "id": 110504454179069954,
      "target": "ממה התחילו שרפות היער?"
    },
    {
      "id": 110504454174875654,
      "target": "איפה המדים שלך?"
    },
    {
      "id": 110504454170681352,
      "target": "למה לא חזרת הביתה?"
    },
    {
      "id": 110504454170681344,
      "target": "איך אתה מרגיש?"
    }
  ]
}
