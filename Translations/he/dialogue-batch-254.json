  "entries": [
    {
      "id": 110504451956088838,
      "target": "Esenin: נו, אז אני אורח?"
    },
    {
      "id": 110504451956088836,
      "target": "Esenin: תסתכל על הציפורניים."
    },
    {
      "id": 110504451956088835,
      "target": "Esenin: שטויות מזוינות."
    },
    {
      "id": 110504451956088834,
      "target": "Esenin: אז כל גנן הופך מיד לאורח?"
    },
    {
      "id": 110504451956088833,
      "target": "Esenin: הם הרי יכולים פשוט לשטוף ידיים! וזהו!"
    },
    {
      "id": 110504451956088832,
      "target": "Esenin: ציפורניים מלוכלכות באדמה? זה סימן?"
    },
    {
      "id": 110504451951894538,
      "target": "Esenin: מאיפה הם בכלל יצאו?"
    },
    {
      "id": 110504451951894537,
      "target": "Esenin: אני לא אורח."
    },
    {
      "id": 110504451951894536,
      "target": "Esenin: אז תפסיק לזיין לי את השכל עם הבדיקות שלך."
    },
    {
      "id": 110504451951894535,
      "target": "Esenin: צהבהבות, נכון?"
    },
    {
      "id": 110504451951894533,
      "target": "Esenin: טוב, תסתכל. עוד נשאר עליהן טעם של אומללות ועשן."
    },
    {
      "id": 110504451951894532,
      "target": "Esenin: להראות לך את השיניים שלי?"
    },
    {
      "id": 110504451947700232,
      "target": "Esenin: מה אתה רוצה לבדוק?"
    }
  ]
}
