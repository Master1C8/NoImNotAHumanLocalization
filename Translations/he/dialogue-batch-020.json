  "entries": [
    {"id": 110504452799143941, "target": "Daughter: אבא אמר שצריך לפחד מטפילים, מקרציות ומחיפושיות. אתה מחפש אותם?"},
    {"id": 110504452799143940, "target": "Daughter: לא אהבתי את זה. אל תבקש ממני שוב להצטלם."},
    {"id": 110504452799143939, "target": "Daughter: תודה."},
    {"id": 110504452799143938, "target": "Daughter: מממ."},
    {"id": 110504452799143936, "target": "Daughter: תראה לי אחר כך את התמונה?"},
    {"id": 110504452794949639, "target": "Daughter: לא צילמו אותי הרבה."},
    {"id": 110504452794949638, "target": "Daughter: תמונה?"},
    {"id": 110504452052557829, "target": "Daughter: לא אהבתי את זה. אל תבקש ממני שוב להצטלם."},
    {"id": 110504452052557828, "target": "Daughter: תודה."},
    {"id": 110504452052557827, "target": "Daughter: מממ."},
    {"id": 110504452052557826, "target": "Daughter: (הילדה רצה אליך לפני שסיימת לצלם)"},
    {"id": 110504452052557825, "target": "Daughter: (התמונה יצאה מעט מטושטשת)"},
    {"id": 110504452052557824, "target": "Daughter: (אתה מצלם את הילדה)"},
    {"id": 110504452048363530, "target": "Daughter: תראה לי אחר כך את התמונה?"},
    {"id": 110504452048363529, "target": "Daughter: לא צילמו אותי הרבה."},
    {"id": 110504452048363528, "target": "Daughter: תמונה?"},
    {"id": 110504452048363523, "target": "Daughter: א־אני רו־רוצה לשתותתת."},
    {"id": 110504452048363522, "target": "Daughter: אתה… וואאאא."},
    {"id": 110504452048363521, "target": "Daughter: אתה ר־ראית שם…"},
    {"id": 110504452048363520, "target": "Daughter: למה הסתכלת ככה?"},
    {"id": 110504452044169226, "target": "Daughter: אז אחשוב בזהירות, אל תדאג."},
    {"id": 110504452044169225, "target": "Daughter: אתה תראה שם את כל מה שאני חושבת עליו?"},
    {"id": 110504452044169224, "target": "Daughter: אתה יכול להסתכל לתוך העין?"},
    {"id": 110504452044169223, "target": "Daughter: אני אלך, רוצה לשבת לבד."},
    {"id": 110504452044169222, "target": "Daughter: גזרתי אותן בעצמי. הצלחתי. לבד."},
    {"id": 110504452044169221, "target": "Daughter: תראה איזה ציפורניים קטנות."},
    {"id": 110504452044169219, "target": "Daughter: תראה."},
    {"id": 110504452044169218, "target": "Daughter: אני עוד לא ממש יודעת, אני…"},
    {"id": 110504452044169217, "target": "Daughter: ואני כבר יודעת לגזור לעצמי ציפורניים."},
    {"id": 110504452044169216, "target": "Daughter: הכול בסדר, נכון?"},
    {"id": 110504452039974921, "target": "Daughter: מה זה אומר?"},
    {"id": 110504452039974920, "target": "Daughter: תראה איזה יש לי."},
    {"id": 110504452039974918, "target": "Daughter: אני כבר לא אבכה."},
    {"id": 110504452039974917, "target": "Daughter: למה? עדיין יש לי שיני חלב. אבא אמר…"},
    {"id": 110504452039974916, "target": "Daughter: שיניים? להראות לך את השיניים שלי?"}
  ]
}
