  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504456108449798,
      "target": "קדימה, אחריי, מהר."
    },
    {
      "id": 110504456108449797,
      "target": "הצטברו כל כך הרבה מהם שכובע הפטרייה יכסה את כל פני כדור הארץ."
    },
    {
      "id": 110504456108449796,
      "target": "וככל שהפטריות גדולות יותר..."
    },
    {
      "id": 110504456108449795,
      "target": "הן יכולות לצמוח מהר מאוד כשהכול רע."
    },
    {
      "id": 110504456045535232,
      "target": "תגיד, זה… נשארה לך פטריית תה?"
    },
    {
      "id": 110504456041340939,
      "target": "טוב… בסדר."
    },
    {
      "id": 110504456041340938,
      "target": "אוי, איחרנו, חבר."
    },
    {
      "id": 110504456041340937,
      "target": "ממש מתחת לאדמה."
    },
    {
      "id": 110504456041340936,
      "target": "צריך לעצור את התפטיר לפני שהפטרייה תגדל לגמרי!"
    },
    {
      "id": 110504456041340935,
      "target": "ארץ הפטריות נמצאת איפשהו שם!"
    },
    {
      "id": 110504456041340934,
      "target": "אבל נראה שהתפטיר יצא מדעתו בגלל הרוע שהצטבר בתוכו."
    },
    {
      "id": 110504456041340933,
      "target": "זרעי התפוח היו אמורים להזכיר לו את הקרבה בין בני אדם לפטריות."
    },
    {
      "id": 110504456041340932,
      "target": "הטקס שלנו היה אמור להחזיר את התפטיר לעשתונותיו."
    },
    {
      "id": 110504456041340931,
      "target": "עכשיו התפטיר צריך להיפטר מהרוע הזה איכשהו..."
    },
    {
      "id": 110504456041340930,
      "target": "ולא יישאר דבר."
    },
    {
      "id": 110504456041340929,
      "target": "כך גדל מספר גושי הרוע בתפטיר."
    },
    {
      "id": 110504456041340928,
      "target": "מפחיד לדמיין מה יקרה להן אחרי חצות..."
    },
    {
      "id": 110504456037146635,
      "target": "לא מיום ליום, אלא משעה לשעה."
    },
    {
      "id": 110504456037146634,
      "target": "פטריות הן יצורים מדהימים!.."
    }
  ]
}
