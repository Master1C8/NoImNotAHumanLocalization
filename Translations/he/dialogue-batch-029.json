    {"id": 110504457941360652, "target": "1 פטריית תה, בבקשה"},
    {"id": 110504457941360651, "target": "1 חפיסת סיגריות, בבקשה"},
    {"id": 110504457941360650, "target": "2 קופסאות שימורים לחתולים, בבקשה"},
    {"id": 110504457752616961, "target": "Phone: טוב, ההזמנה התקבלה. השליח יגיע בלילה הבא."},
    {"id": 110504457752616960, "target": "Phone: כל טוב, להתראות."},
    {"id": 110504457748422667, "target": "Phone: אם תרצה להזמין, נסה להתקשר ביום אחר."},
    {"id": 110504457748422666, "target": "Phone: בגלל עומס רב אנחנו נאלצים לקבל הזמנות במרווחים."},
    {"id": 110504457748422665, "target": "Phone: לצערנו, לא נוכל לקבל את ההזמנה שלך כי הזמנת אצלנו לאחרונה."},
    {"id": 110504457748422664, "target": "התחרטתי, אני לא רוצה להזמין"},
    {"id": 110504457748422663, "target": "1 פחית קפה, בבקשה."},
    {"id": 110504457748422662, "target": "2 פחיות אנרז׳קה, בבקשה."},
    {"id": 110504457748422661, "target": "Phone: מה תרצה להזמין?"},
    {"id": 110504457748422660, "target": "Phone: שלום, זו חברת משלוחי המזון For Rest."}
  ]
