  "sourceInventorySha256": "ecd96645c2ca6f23f8bf3ab2fcf65709e961478ae15a38e83d94cc335a408bf0",
  "glossaryFingerprint": "2842f9f75fc312fee81aa15c8753ac8c3926064b6cd79cbf6b1035786d6de886",
  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504453751250949,
      "target": "Sirin: אני מוכנה..."
    },
    {
      "id": 110504453751250948,
      "target": "Sirin: איך אני… בלעדיה…"
    },
    {
      "id": 110504453751250947,
      "target": "Sirin: המוות לקח את אחותי..."
    },
    {
      "id": 110504452887224323,
      "target": "Sirin: תוך כמה זמן זה יקרה?"
    },
    {
      "id": 110504452887224322,
      "target": "Sirin: האורחים? האסונות? אנחנו זה את זה?"
    },
    {
      "id": 110504452887224321,
      "target": "Sirin: מה לדעתך יהרוג אותנו?"
    },
    {
      "id": 110504452887224320,
      "target": "Sirin: תמיד אפשר לעשות את זה בדרך פשוטה יותר…"
    },
    {
      "id": 110504452883030025,
      "target": "Sirin: האורחים הרי לא יקפצו עליך אם תכוון אליהם. הם לא יחשפו את עצמם."
    },
    {
      "id": 110504452883030024,
      "target": "Sirin: למה אתה בודק, מכוון, אבל לא יורה?"
    },
    {
      "id": 110504452883030021,
      "target": "Sirin: פשוט תעשה מה שאתה צריך לעשות."
    },
    {
      "id": 110504452883030020,
      "target": "Sirin: אל תתמהמה."
    },
    {
      "id": 110504452883030017,
      "target": "Sirin: ותשרוף גם את התמונה הזאת."
    },
    {
      "id": 110504452878835719,
      "target": "Sirin: עדיין לא נעים לה להיזכר בהם."
    },
    {
      "id": 110504452878835718,
      "target": "Sirin: הגיע הזמן שגם אני איפטר ממנה."
    },
    {
      "id": 110504452878835717,
      "target": "Sirin: ואחותי הסירה את שלה."
    },
    {
      "id": 110504452878835715,
      "target": "Sirin: מזכרת מההורים."
    },
    {
      "id": 110504452878835714,
      "target": "Sirin: נשאר לי עגיל."
    },
    {
      "id": 110504452874641412,
      "target": "Sirin: ומה צריך לעשות?"
    },
    {
      "id": 110504452874641410,
      "target": "Sirin: תעשה מה שאתה חושב לנכון."
    },
    {
      "id": 110504452874641409,
      "target": "Sirin: לא אכפת לי אם משהו יישאר אחר כך."
    },
    {
      "id": 110504452123860996,
      "target": "Sirin: כמה יפה היא!"
    },
    {
      "id": 110504452123860995,
      "target": "Sirin: אבל הוא נועד לך!"
    },
    {
      "id": 110504452123860994,
      "target": "Sirin: השיר שלי."
    },
    {
      "id": 110504452123860993,
      "target": "Sirin: אז אחכה לשעה שלי."
    },
    {
      "id": 110504452123860992,
      "target": "Sirin: לא משנה."
    },
    {
      "id": 110504452119666698,
      "target": "Sirin: ייסורים נצחיים וציפייה למוות."
    },
    {
      "id": 110504452119666697,
      "target": "Sirin: ולעולם לא נראה את סוף חיינו."
    },
    {
      "id": 110504452119666696,
      "target": "Sirin: נישאב אל אופק האירועים במשך זמן רב מאוד."
    },
    {
      "id": 110504452119666695,
      "target": "Sirin: ומה אם אנחנו רק מתכוננים להיבלע בחור שחור?"
    },
    {
      "id": 110504452119666694,
      "target": "Sirin: אולי בפעם הבאה."
    },
    {
      "id": 110504452119666693,
      "target": "Sirin: לא התאמתי לסימנים."
    },
    {
      "id": 110504452119666692,
      "target": "Sirin: חבל."
    },
    {
      "id": 110504452119666691,
      "target": "Sirin: אולי בפעם הבאה."
    },
    {
      "id": 110504452119666690,
      "target": "Sirin: חבל."
    },
    {
      "id": 110504452119666689,
      "target": "Sirin: ממילא תמות."
    },
    {
      "id": 110504452115472395,
      "target": "Sirin: לא היה לך אומץ?"
    },
    {
      "id": 110504452115472392,
      "target": "Sirin: תלחץ על הכפתור הנכסף?"
    },
    {
      "id": 110504452115472391,
      "target": "Sirin: אז מה?"
    },
    {
      "id": 110504452115472388,
      "target": "Sirin: מוצא חן בעיניך?"
    },
    {
      "id": 110504452115472387,
      "target": "Sirin: הוא פשוט יעבור אליך."
    },
    {
      "id": 110504452115472386,
      "target": "Sirin: כשאעצום את עיניי, הריק לא ייעלם."
    },
    {
      "id": 110504452111278091,
      "target": "Sirin: אעשה הכול בעצמי."
    },
    {
      "id": 110504452111278090,
      "target": "Sirin: תן לי את הרובה."
    },
    {
      "id": 110504452111278089,
      "target": "Sirin: אתה יכול פשוט להשאיר את זה לי."
    },
    {
      "id": 110504452111278088,
      "target": "Sirin: המוות ממילא כבר קרוב."
    },
    {
      "id": 110504452111278087,
      "target": "Sirin: אל תעשה את זה."
    },
    {
      "id": 110504452111278084,
      "target": "Sirin: תוציא ממני את הנשמה."
    },
    {
      "id": 110504452111278083,
      "target": "Sirin: ככה אפילו טוב יותר."
    },
    {
      "id": 110504452111278080,
      "target": "Sirin: נראה שלא עשיתי את זה לשווא."
    },
    {
      "id": 110504452107083786,
      "target": "Sirin: אחותי מגלחת לי את בתי השחי. היא מטפלת בי."
    },
    {
      "id": 110504452107083783,
      "target": "Sirin: אבל היא לא מכירה בריק שבעיניים."
    },
    {
      "id": 110504452107083782,
      "target": "Sirin: בזה אני ואחותי דומות."
    },
    {
      "id": 110504452107083779,
      "target": "Sirin: נתנה לי למות כבר אז."
    },
    {
      "id": 110504452107083778,
      "target": "Sirin: הלוואי ש…"
    },
    {
      "id": 110504452107083777,
      "target": "Sirin: אבל זה חסר טעם."
    },
    {
      "id": 110504452107083776,
      "target": "Sirin: אחותי עוזרת לי."
    },
    {
      "id": 110504452102889481,
      "target": "Sirin: תוציא לי את העיניים?"
    },
    {
      "id": 110504452102889480,
      "target": "Sirin: תסתכל."
    },
    {
      "id": 110504452102889473,
      "target": "Sirin: תעשה את זה כבר."
    }
  ]
}
