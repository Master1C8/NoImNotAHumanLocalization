  "entries": [
    {
      "id": 110504454963404807,
      "target": "אשתך לא רוצה לעזוב. מה קורה כאן?"
    },
    {
      "id": 110504454959210497,
      "target": "גברתי, הכול בסדר איתך?"
    },
    {
      "id": 110504454955016197,
      "target": "חשבתי שתלכו הלילה אחרי אמא שלכם"
    },
    {
      "id": 110504454950821888,
      "target": "כמה רחוק צריך ללכת?"
    },
    {
      "id": 110504454946627589,
      "target": "איך הגעתם לרחוב?"
    },
    {
      "id": 110504454942433290,
      "target": "מה שלומכם? הילד בסדר?"
    },
    {
      "id": 110504454942433283,
      "target": "למה לא הרגת אותי?"
    },
    {
      "id": 110504454938238981,
      "target": "כמה זמן תשבי פה?"
    },
    {
      "id": 110504454934044681,
      "target": "מי אמר לך לבוא לכאן?"
    },
    {
      "id": 110504454934044675,
      "target": "את בכלל בת אדם?"
    },
    {
      "id": 110504454929850373,
      "target": "למה את כאן?"
    },
    {
      "id": 110504454917267466,
      "target": "היו לך ילדים?"
    },
    {
      "id": 110504454913073161,
      "target": "סליחה על אתמול, לא התכוונתי לגרום לך לבכות"
    },
    {
      "id": 110504454908878852,
      "target": "מתי התחלת לעבוד כגננת?"
    },
    {
      "id": 110504454900490250,
      "target": "הכול בסדר איתך?"
    },
    {
      "id": 110504454887907332,
      "target": "משהו לא בסדר?"
    },
    {
      "id": 110504454887907331,
      "target": "Dude: יו, אחי"
    },
    {
      "id": 110504454879518729,
      "target": "במה עבדת?"
    },
    {
      "id": 110504454879518728,
      "target": "Dude: יו, אחי"
    },
    {
      "id": 110504454879518721,
      "target": "מה עשית לפני האסון?"
    },
    {
      "id": 110504454879518720,
      "target": "Dude: יו, אחי"
    },
    {
      "id": 110504454875324420,
      "target": "חלמת משהו הלילה?"
    },
    {
      "id": 110504454871130113,
      "target": "הכול בסדר איתך?"
    },
    {
      "id": 110504454866935809,
      "target": "אתה נראה מרוט"
    },
    {
      "id": 110504454862741508,
      "target": "נו, יותר טוב לך בלי עיניים?"
    },
    {
      "id": 110504454858547206,
      "target": "אז ספר לי מה ראית."
    },
    {
      "id": 110504454850158594,
      "target": "אז למה אני עדיין לא מאחורי סורג ובריח?"
    },
    {
      "id": 110504454841769984,
      "target": "מה? שוב אתה צריך משהו?"
    }
