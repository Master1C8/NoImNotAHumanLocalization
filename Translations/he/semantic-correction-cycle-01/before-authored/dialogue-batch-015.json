  "entries": [
    {"id": 110504457182191624, "target": "Daughter: אההההההה…"},
    {"id": 110504457182191623, "target": "Daughter: אני כל כך מ־מ־מ־מפחדת…"},
    {"id": 110504457182191622, "target": "Daughter: אני לא מ־מכירה יותר אף־אף אחדדד…"},
    {"id": 110504457182191621, "target": "Daughter: לאאאאן?"},
    {"id": 110504457182191620, "target": "Daughter: אבאאאא, אבאל׳ההה!"},
    {"id": 110504457182191617, "target": "Daughter: אני רוצה ללכת לאבאאאא…"},
    {"id": 110504457182191616, "target": "Daughter: ואני… אני רוצה רק שם. נו. רוצההה! שם… שם אבא כנראה ישב… הוא סיפר לי."},
    {"id": 110504457177997323, "target": "Daughter: אוי, {0} כאן."},
    {"id": 110504457177997322, "target": "Daughter: אני… אין לי… אין לי מקום!"},
    {"id": 110504453583478784, "target": "אמא..."},
    {"id": 110504453579284487, "target": "Daughter: אבא..."},
    {"id": 110504452048363527, "target": "Daughter: אני ממש עייפה, אפשר לעמוד פה לבד?"},
    {"id": 110504452048363526, "target": "Daughter: אתה רק רוצה לדעת מה שלומי?"},
    {"id": 110504452048363525, "target": "Daughter: (אתה מביט בה ומבין שזה יותר מדי בשבילך.)"},
    {"id": 110504452048363524, "target": "Daughter: מה צריך לעשות?"},
    {"id": 110504452035780615, "target": "Daughter: מה אתה רוצה לבדוק?"}
  ]
}
