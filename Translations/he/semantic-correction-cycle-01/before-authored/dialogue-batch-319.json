  "entries": [
    {
      "id": 110504455370252289,
      "target": "מה מצאת מתחת לגופה?"
    },
    {
      "id": 110504455366057988,
      "target": "הפסקת לבזוז?"
    },
    {
      "id": 110504455361863680,
      "target": "ספר לי מה ראית בזמן שבזזת."
    },
    {
      "id": 110504455357669381,
      "target": "למה החלטת להיות בוזז?"
    },
    {
      "id": 110504455353475078,
      "target": "איך מתקדמת קריירת הביזה שלך?"
    },
    {
      "id": 110504455340892163,
      "target": "אתם עדיין כאן?"
    },
    {
      "id": 110504455328309254,
      "target": "מה עוד?"
    },
    {
      "id": 110504455319920649,
      "target": "אתה עדיין לא נרגע?"
    },
    {
      "id": 110504455311532038,
      "target": "מה העניין?"
    },
    {
      "id": 110504455303143428,
      "target": "מה קרה לאבא שלך?"
    },
    {
      "id": 110504455298949121,
      "target": "אתה נראה קודר היום"
    },
    {
      "id": 110504455294754816,
      "target": "אתה עובד הרבה זמן כנהג מונית?"
    },
    {
      "id": 110504455286366212,
      "target": "אתה עדיין חושב שהוועדה למצבי חירום תבוא לקחת אותך?"
    },
    {
      "id": 110504455273783297,
      "target": "ולאן נעלמה החברה שלך?"
    },
    {
      "id": 110504455269588993,
      "target": "איך הכרת אותה?"
    },
    {
      "id": 110504455265394693,
      "target": "ספר לי על החברה שלך"
    },
    {
      "id": 110504455261200391,
      "target": "מה שלום היד?"
    },
    {
      "id": 110504455257006086,
      "target": "מישהו יכול להסיע אותך במכונית?"
    },
    {
      "id": 110504455252811787,
      "target": "למה אתה כל כך מרוצה?"
    },
    {
      "id": 110504455248617478,
      "target": "איך תחזור הביתה?"
    },
    {
      "id": 110504455244423172,
      "target": "היי, איך אתה מרגיש?"
    },
    {
      "id": 110504455240228869,
      "target": "איך נדבר איתך?"
    },
    {
      "id": 110504455236034565,
      "target": "נו, הסרת את התפרים מהפה?"
    },
    {
      "id": 110504455206674441,
      "target": "למה אתה עדיין לא באזור ההסגר?"
    },
    {
      "id": 110504455206674440,
      "target": "Doctor: כן, כן?"
    },
    {
      "id": 110504455198285830,
      "target": "אז מה רצית לומר לי?"
    }
  ]
}
