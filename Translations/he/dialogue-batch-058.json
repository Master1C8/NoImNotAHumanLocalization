  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504456121032708,
      "target": "אני כבר איבדתי הכול. אבל לכם עוד יש מה להפסיד."
    },
    {
      "id": 110504456104255499,
      "target": "וכמה אנשים עוד הוא הרג? כמה שרף?"
    },
    {
      "id": 110504456095866883,
      "target": "כל אחד ואחד."
    },
    {
      "id": 110504456095866882,
      "target": "כל בן זונה שמחזיק היום נשק ביד ימות."
    },
    {
      "id": 110504456095866881,
      "target": "אציף את הכול בדם שלכם."
    },
    {
      "id": 110504456095866880,
      "target": "אדחוף אתכם עמוק אל תוך האדמה."
    },
    {
      "id": 110504456091672587,
      "target": "ראשים מקוללים בטירוף."
    },
    {
      "id": 110504456091672586,
      "target": "אני ארסק אתכם!"
    },
    {
      "id": 110504456091672585,
      "target": "אתה חושב שאף אחד לא ישיב מלחמה?"
    },
    {
      "id": 110504456091672584,
      "target": "ואנשים כמוך לא יתנו לאף אחד מנוחה."
    },
    {
      "id": 110504456091672583,
      "target": "אנשים כמוך הרגו את החבר שלי."
    },
    {
      "id": 110504456091672582,
      "target": "בגלל בני זונות כאלה יש כל כך הרבה הרוגים."
    },
    {
      "id": 110504456091672581,
      "target": "הוא השתתק. צריך לבדוק."
    },
    {
      "id": 110504456091672580,
      "target": "איתי הוא התעסק כי אני לא נותן לפגוע בי. אבל מה עם האחרים?"
    },
    {
      "id": 110504456091672579,
      "target": "איזו חלאה. הוא פגע בי."
    },
    {
      "id": 110504456091672578,
      "target": "אני שומע את החרחורים שלו."
    },
    {
      "id": 110504456091672577,
      "target": "מעטה הזעם בעיניו של אדם חמוש מפחיד יותר מאורח."
    },
    {
      "id": 110504456091672576,
      "target": "אבל אתם רק מחכים ומקווים ששום דבר לא יקרה."
    },
    {
      "id": 110504456087478283,
      "target": "אתה שומע איך המטורף יורק מילים בזעם מאחורי הדלת."
    }
  ]
}
