  "entries": [
    {
      "id": 110504456938921994,
      "target": "CultistPriest: המוות הפסיק לדבר איתי."
    },
    {
      "id": 110504456934727690,
      "target": "לא אכפת לי. יש לי מספיק עניינים משלי"
    },
    {
      "id": 110504456934727689,
      "target": "הם חיים, חיים"
    },
    {
      "id": 110504456934727688,
      "target": "CultistPriest: לא אלך סחור סחור. מה שלום האנשים שלי?"
    },
    {
      "id": 110504456913756166,
      "target": "הבית שלי מתאים רק לי"
    },
    {
      "id": 110504456913756165,
      "target": "מה הרגשת?"
    },
    {
      "id": 110504456913756164,
      "target": "CultistPriest: אני ממש מרגיש את זה."
    },
    {
      "id": 110504456913756163,
      "target": "CultistPriest: כןןןן. הבית שלך מתאים."
    },
    {
      "id": 110504456892784646,
      "target": "לא משהו מיוחד"
    },
    {
      "id": 110504456892784645,
      "target": "מה?"
    },
    {
      "id": 110504456892784644,
      "target": "Intruder: אתה חולם על משהו?"
    },
    {
      "id": 110504456880201729,
      "target": "הפעם באו לקחת אותי?"
    },
    {
      "id": 110504456880201728,
      "target": "תחזיר קודם את מי שלקחו."
    },
    {
      "id": 110504456876007435,
      "target": "FormerFema: אתה… תפתח?"
    },
    {
      "id": 110504456876007434,
      "target": "FormerFema: שמעתי צעדים, אז הגעת לדלת."
    },
    {
      "id": 110504456876007433,
      "target": "FormerFema: יש כאן מישהו?"
    },
    {
      "id": 110504456863424519,
      "target": "תדפוק לעצמך על הראש"
    },
    {
      "id": 110504456863424518,
      "target": "אל תתפרץ לכאן"
    },
    {
      "id": 110504456863424517,
      "target": "GraveDigger: תכניס אותי כבר!"
    },
    {
      "id": 110504456863424516,
      "target": "GraveDigger: יש פה אנשים חיים בכלל? הלו!"
    },
    {
      "id": 110504456850841602,
      "target": "למה אתה חושב שזה רעיון טוב?"
    },
    {
      "id": 110504456850841601,
      "target": "למה אתה מסתובב לבד?"
    },
    {
      "id": 110504456850841600,
      "target": "Marauder: תקשיב, אפשר להישאר אצלך? מזמן לא הייתי בחברת אנשים."
    },
    {
      "id": 110504456846647306,
      "target": "Marauder: אם כי…"
    },
    {
      "id": 110504456846647305,
      "target": "Marauder: שלום. חשבתי שכבר אין כאן אף אחד. טוב, אני הולך."
    },
    {
      "id": 110504456846647304,
      "target": "Marauder: אה, אופס, מישהו גר פה."
    },
    {
      "id": 110504456838258690,
      "target": "אני פשוט מכניס אליי אנשים"
    },
    {
      "id": 110504456838258689,
      "target": "משהו כזה"
    },
    {
      "id": 110504456838258688,
      "target": "Provocateur: שלום, בעל הבית. אתה משכיר כאן מקום?"
    },
    {
      "id": 110504456825675777,
      "target": "במה אוכל לעזור לך?"
    },
    {
      "id": 110504456825675776,
      "target": "מה קרה?"
    },
    {
      "id": 110504456821481483,
      "target": "TaxiDriver: תקשיב, אני שקוע עד הצוואר בחרא. אפשר להתחבא אצלך?"
    },
    {
      "id": 110504456821481482,
      "target": "TaxiDriver: שלום, גבר."
    },
    {
      "id": 110504456808898566,
      "target": "מה יפה פה?"
    },
    {
      "id": 110504456808898565,
      "target": "למה אתה לא נשאר בבית?"
    },
    {
      "id": 110504456808898564,
      "target": "Edgar: אני מקווה שאוכל להישאר אצלך."
    },
    {
      "id": 110504456808898563,
      "target": "Edgar: אפילו שקט יותר מאשר בעיר. שם כל כך רועש והומה."
    },
    {
      "id": 110504456808898562,
      "target": "Edgar: שלום. יפה פה אצלכם."
    },
    {
      "id": 110504456800509956,
      "target": "מה?"
    },
    {
      "id": 110504456800509955,
      "target": "מה קרה לך?"
    },
    {
      "id": 110504456800509954,
      "target": "Foreigner: פפפיייי."
    },
    {
      "id": 110504456800509953,
      "target": "Foreigner: פפפיוו."
    },
    {
      "id": 110504456787927044,
      "target": "אתה מחפש משהו?"
    },
    {
      "id": 110504456787927043,
      "target": "עקבת אחרי הבית?"
    },
    {
      "id": 110504456787927042,
      "target": "Doctor: שלום! אפשר להיכנס?"
    },
    {
      "id": 110504456787927041,
      "target": "Doctor: כל כך שקט אצלך בלילה."
    },
    {
      "id": 110504456787927040,
      "target": "Doctor: אוי, כבר חשבתי שאין אף אחד בבית."
    },
    {
      "id": 110504456775344138,
      "target": "ואתה אחד מהחיות האלה?"
    },
    {
      "id": 110504456775344137,
      "target": "על מה אתה מדבר?"
    },
    {
      "id": 110504456775344136,
      "target": "Wolfhound: סוף סוף אף אחד לא מעמיד פנים."
    }
  ]
}
