  "entries": [
    {
      "id": 110504455940677643,
      "target": "WheelChair: טוב, אני זז. אבל את כיסא הגלגלים אני לוקח איתי."
    },
    {
      "id": 110504455940677641,
      "target": "WheelChair: פאק, מה נסגר איתך?"
    },
    {
      "id": 110504455940677640,
      "target": "WheelChair: לי דווקא כיף. צריך לקחת מהחיים כל מה שאפשר."
    },
    {
      "id": 110504455940677639,
      "target": "WheelChair: שיהיה."
    },
    {
      "id": 110504455940677638,
      "target": "תעוף מפה בטוב"
    },
    {
      "id": 110504455940677637,
      "target": "פאק, אתה מוזר"
    },
    {
      "id": 110504455940677636,
      "target": "WheelChair: רק אל תגיד לי שאף פעם לא ניסית. זה כיף בטירוף!"
    },
    {
      "id": 110504455940677635,
      "target": "WheelChair: מה, זה לא מגניב לעשות איתו דריפטים ולהשתולל?"
    },
    {
      "id": 110504455940677634,
      "target": "תעוף מפה בטוב"
    },
    {
      "id": 110504455940677633,
      "target": "פאק, אתה מוזר"
    },
    {
      "id": 110504455940677632,
      "target": "WheelChair: ואם אתה מדבר על הכיסא, פשוט כיף לי להסתובב עליו."
    },
    {
      "id": 110504455936483340,
      "target": "WheelChair: לא העמדתי פנים. פשוט ככה היה לי חם יותר ברגליים."
    },
    {
      "id": 110504455936483339,
      "target": "אז בשביל מה לעזאזל היית צריך כיסא גלגלים?"
    },
    {
      "id": 110504455936483338,
      "target": "למה העמדת פנים שאתה נכה?"
    },
    {
      "id": 110504455936483337,
      "target": "WheelChair: נו באמת, הרגליים שלי נרדמו. מה הבעיה בזה?"
    },
    {
      "id": 110504455936483336,
      "target": "מה לעזאזל?"
    },
    {
      "id": 110504455936483335,
      "target": "WheelChair: פיו, ככה הרבה יותר קל."
    },
    {
      "id": 110504455936483334,
      "target": "WheelChair: שנייה."
    },
    {
      "id": 110504455936483333,
      "target": "WheelChair: פאק, כואבות לי הרגליים."
    }
  ]
}
