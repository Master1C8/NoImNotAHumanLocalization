    {"id": 110504456326553608, "target": "Daughter: א־א־א־א־א־א."},
    {"id": 110504456326553607, "target": "Daughter: א־אנשים."},
    {"id": 110504456326553606, "target": "Daughter: אני ל־לא יודעתתת מה ל־לעשות."}
