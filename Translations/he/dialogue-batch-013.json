  "entries": [
    {"id": 110504456330747915, "target": "Daughter: אני כל כך מפחדתתתת."},
    {"id": 110504456330747914, "target": "Daughter: אהההההההההה."},
    {"id": 110504456330747913, "target": "Daughter: אההההההה."},
    {"id": 110504456330747912, "target": "Daughter: ל־לאן אני אלךךךך?"},
    {"id": 110504456330747911, "target": "Daughter: אני מ־מפחדת."},
    {"id": 110504456330747910, "target": "Daughter: ת־תעזור לי?"},
    {"id": 110504456330747907, "target": "Daughter: כש־כשברחתי, הם פשוט צחקו."},
    {"id": 110504456330747906, "target": "Daughter: ואחר כך הם ע־עשו משהו, ואז ה־הציתו את הבית."},
    {"id": 110504456330747905, "target": "Daughter: הם י־ישבו בשקט עם אבא במטבח."},
    {"id": 110504456330747904, "target": "Daughter: אני ל־לא יודעת."},
    {"id": 110504456326553623, "target": "Daughter: הבית שלנו ע־עכשיו בו־בוערררר."},
    {"id": 110504456326553622, "target": "Daughter: אההההה־האאאאא."},
    {"id": 110504456326553621, "target": "Daughter: אבא ד־דיבר איתם על משהו. ואז הם הרגו אותו."},
    {"id": 110504456326553620, "target": "Daughter: באו אלינו א־אורחים. הם י־ישבו אצלנו."},
    {"id": 110504456326553619, "target": "למה הם עשו את זה?"},
    {"id": 110504456326553618, "target": "מי עשה את זה?"},
    {"id": 110504456326553617, "target": "Daughter: הרגו את א־א־אבא."},
    {"id": 110504456326553616, "target": "Daughter: א־א־א־הא־א־א."},
    {"id": 110504456326553615, "target": "Daughter: את א־אבא ש־שלי…"},
    {"id": 110504456326553614, "target": "Daughter: א־א־א־א־א־א."},
    {"id": 110504456326553613, "target": "למה הם עשו את זה?"},
