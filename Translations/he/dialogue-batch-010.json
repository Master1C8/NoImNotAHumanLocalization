  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {"id": 110504457941360644, "target": "Phone: אבל אני עדיין מתגעגעת אליה..."},
    {"id": 110504457941360642, "target": "Phone: לך מפה, לעזאזל!"},
    {"id": 110504457941360641, "target": "Phone: רגע, למה אני בכלל מצטדקת בפניך?"},
    {"id": 110504457941360640, "target": "Phone: בבקשה..."},
    {"id": 110504457937166346, "target": "Phone: אל תתקשר לכאן שוב..."},
    {"id": 110504457937166345, "target": "Phone: סליחה."},
    {"id": 110504457937166343, "target": "Phone: עכשיו אני רק מצטערת שלא שאלנו את זו שתפסה את מקומה של בתנו מה הדבר הזה עשה לקטנה שלנו..."},
    {"id": 110504457937166342, "target": "Phone: בעלי עזר לי להבין את זה."},
    {"id": 110504457937166341, "target": "Phone: אבל אחר כך הבנתי שזו בכלל לא הייתה הבת שלנו."},
    {"id": 110504457937166340, "target": "Phone: בהתחלה רציתי להרוג דווקא אותו."},
    {"id": 110504457937166338, "target": "Phone: הוא טיפל באורח הזה מיד."},
    {"id": 110504457937166337, "target": "Phone: ברגע שסיפרתי על זה לבעלי, הוא..."},
    {"id": 110504457932972044, "target": "Phone: הכול התאים."},
    {"id": 110504457932972043, "target": "Phone: לכן הבחנתי מיד כשהסימנים האלה הופיעו."},
    {"id": 110504457932972042, "target": "Phone: הרי הכרתי אותה כמו את כף ידי."},
    {"id": 110504457932972041, "target": "Phone: לפי כל הסימנים."},
    {"id": 110504457932972040, "target": "Phone: היא הייתה אורחת."},
    {"id": 110504457932972039, "target": "אני מבין"},
    {"id": 110504457932972038, "target": "פאק..."},
    {"id": 110504457932972037, "target": "Phone: היא בהחלט הייתה אורחת! כל הסימנים התאימו במאה אחוז!"},
    {"id": 110504457932972036, "target": "Phone: אין לך זכות לשפוט אותי!"},
    {"id": 110504457932972034, "target": "והחלטתם להרוג את הילדה שלכם?"},
    {"id": 110504457932972033, "target": "Phone: כל הסימנים התאימו, ובעלי התעקש."},
    {"id": 110504457932972032, "target": "Phone: הרגנו אותה. תבין, היינו חייבים."},
    {"id": 110504457928777740, "target": "(לנתק את השיחה)"},
    {"id": 110504457928777739, "target": "מה?"},
    {"id": 110504457928777738, "target": "Phone: נאלצנו להרוג אותה."},
    {"id": 110504457928777737, "target": "Phone: היינו חייבים..."},
    {"id": 110504457928777735, "target": "Phone: היא מתה..."},
    {"id": 110504457928777734, "target": "Phone: הילדה שלנו... היא..."}
  ]
}
