  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504456100061186,
      "target": "קשה מאוד להתמקד בו."
    },
    {
      "id": 110504456100061185,
      "target": "בית קטן ובודד עולה לנגד עיניך."
    },
    {
      "id": 110504456100061184,
      "target": "מחשיך לך מול העיניים."
    },
    {
      "id": 110504456095866891,
      "target": "קורעים אותך לגזרים."
    },
    {
      "id": 110504456095866890,
      "target": "האימה עיוורה אותך."
    },
    {
      "id": 110504456095866889,
      "target": "אתה אפילו לא חושב להציל את עצמך."
    },
    {
      "id": 110504456095866888,
      "target": "הפחד למות שיתק אותך."
    },
    {
      "id": 110504456095866887,
      "target": "אתה מרגיש מבטים מופנים אליך."
    },
    {
      "id": 110504456095866886,
      "target": "אנשים אינם בוטחים זה בזה."
    },
    {
      "id": 110504455999397900,
      "target": "קבל את פניי…"
    },
    {
      "id": 110504455999397898,
      "target": "הכאב מתרחק לאנשהו."
    },
    {
      "id": 110504455999397897,
      "target": "אתה מקווה שבקרוב תגיע לשם."
    },
    {
      "id": 110504455999397896,
      "target": "כאב חד מתפשט בגופך."
    },
    {
      "id": 110504455999397895,
      "target": "לא רק בני אדם הכנסת לביתך."
    },
    {
      "id": 110504455999397894,
      "target": "אין לאן לברוח."
    },
    {
      "id": 110504455999397893,
      "target": "עכשיו הכול יסתיים."
    },
    {
      "id": 110504455999397892,
      "target": "בוחנים, קרים, זרים."
    },
    {
      "id": 110504455999397891,
      "target": "הפרנויה רק מתגברת."
    },
    {
      "id": 110504455999397890,
      "target": "השמש אינה הסכנה היחידה המרחפת מעליך."
    },
    {
      "id": 110504455999397889,
      "target": "כבר כחודשיים כולם מחכים לסוף."
    },
    {
      "id": 110504455999397888,
      "target": "אתה מסמן את מניין הימים על קיר המרתף."
    },
    {
      "id": 110504455995203595,
      "target": "אתה סוגר את המרתף. עכשיו איש לא ייכנס לכאן."
    },
    {
      "id": 110504455995203594,
      "target": "אם תחסכו, האוכל אמור להספיק לחודש או חודשיים."
    },
    {
      "id": 110504455995203593,
      "target": "כאן קריר יותר מאשר בבית, אבל כולם עדיין חרדים."
    },
    {
      "id": 110504455995203592,
      "target": "אתה יורד למרתף עם השורדים."
    }
  ]
}
