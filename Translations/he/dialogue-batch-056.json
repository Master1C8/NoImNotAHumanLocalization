  "sourceInventorySha256": "ecd96645c2ca6f23f8bf3ab2fcf65709e961478ae15a38e83d94cc335a408bf0",
  "glossaryFingerprint": "2842f9f75fc312fee81aa15c8753ac8c3926064b6cd79cbf6b1035786d6de886",
  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504456024563718,
      "target": "אוביל אותך אל הלילה, שבו האורן מגיע עד הכוכב."
    },
    {
      "id": 110504456024563717,
      "target": "אני מבין שאתה מוכן."
    },
    {
      "id": 110504456024563716,
      "target": "טוב שעכשיו לא נשארים בחשכה לא האדם בתחפושת ולא שום דבר אחר. רק צל על הלבנה שלי."
    },
    {
      "id": 110504456024563715,
      "target": "אין צורך לפחד. הזמן נברא בידי. כאן אין לך ממה לפחד."
    },
    {
      "id": 110504456024563714,
      "target": "אל מחוזות עצובים, שהמוטו שלהם הוא מראות היוצרות אשליה של שפע."
    },
    {
      "id": 110504456024563713,
      "target": "לשם אתה צריך ללכת."
    },
    {
      "id": 110504456024563712,
      "target": "אתה עייף."
    },
    {
      "id": 110504456020369419,
      "target": "לא, אתה לא רוצה להגיע אליהם."
    },
    {
      "id": 110504456020369418,
      "target": "אל אלה שעיניהם חרטו סימן על הלב?"
    },
    {
      "id": 110504456020369417,
      "target": "לאן אתה רוצה ללכת?"
    },
    {
      "id": 110504456020369416,
      "target": "ממלכה קטנה כל כך בלעה שינה רבה כל כך."
    },
    {
      "id": 110504456020369415,
      "target": "כמובן."
    },
    {
      "id": 110504456020369414,
      "target": "אני מפחד להמשיך"
    },
    {
      "id": 110504456020369413,
      "target": "יש כאן… לאן להמשיך?"
    },
    {
      "id": 110504456020369412,
      "target": "אני האח שלא זכה להכרה, מנודה במשפחת העם."
    },
    {
      "id": 110504456020369411,
      "target": "אתה ואני דומים במשהו."
    },
    {
      "id": 110504456020369410,
      "target": "אולי שנינו התעייפנו ושכבנו לישון."
    },
    {
      "id": 110504456020369409,
      "target": "מה פירוש ״למות״?"
    },
    {
      "id": 110504456020369408,
      "target": "מתתי?"
    },
    {
      "id": 110504456016175115,
      "target": "אני מפחד להמשיך"
    },
    {
      "id": 110504456016175114,
      "target": "יש כאן… לאן להמשיך?"
    },
    {
      "id": 110504456016175113,
      "target": "״מפחיד״."
    },
    {
      "id": 110504456016175112,
      "target": "רק מתוך הרגל תמשיך לחזור כמו בטקס:"
    },
    {
      "id": 110504456016175111,
      "target": "אבל לא תהיה מאושר."
    },
    {
      "id": 110504456016175110,
      "target": "תגלה את מה שרצית."
    },
    {
      "id": 110504456016175109,
      "target": "כמה טוב שכל הסבל מאחורינו."
    },
    {
      "id": 110504456016175108,
      "target": "מעתה חיים ארוכים ומאושרים."
    },
    {
      "id": 110504456016175107,
      "target": "מתתי? זה הסוף?"
    },
    {
      "id": 110504456016175106,
      "target": "ומה עכשיו?"
    },
    {
      "id": 110504456016175105,
      "target": "עכשיו הדרך התהדקה לקשר חלקלק, ונקרעה."
    },
    {
      "id": 110504456016175104,
      "target": "כבר אין שום דבר מפחיד."
    },
    {
      "id": 110504456011980810,
      "target": "אין לך סיבה לפחד."
    },
    {
      "id": 110504456011980809,
      "target": "אני רואה שתגיד ״כן״."
    },
    {
      "id": 110504456011980808,
      "target": "כמה טוב שהלילה מסתיים. היום מתקרב. לשמור את הצל שלך?"
    },
    {
      "id": 110504456011980807,
      "target": "במחוזות העצובים האלה הכול תוכנן לחורף: החלומות, קירות הבית, המתלה."
    },
    {
      "id": 110504456011980806,
      "target": "מתתי? זה הסוף?"
    },
    {
      "id": 110504456011980805,
      "target": "ומה עכשיו?"
    },
    {
      "id": 110504456011980804,
      "target": "כנראה שכן. לא נורא, עכשיו הכול בסדר."
    },
    {
      "id": 110504456011980803,
      "target": "השתוקקת לפגוש אותי?"
    },
    {
      "id": 110504456011980802,
      "target": "אבל אין צורך לפחד. אין כאן שום דבר מפחיד."
    },
    {
      "id": 110504456011980801,
      "target": "מהמפחדים ממני אפשר לבנות עיר."
    },
    {
      "id": 110504456011980800,
      "target": "אני... איפה?"
    },
    {
      "id": 110504456007786507,
      "target": "אתה... מה?"
    },
    {
      "id": 110504456007786506,
      "target": "יצאת מן המרחב שעשוי ממסדרון ומסתיים במונה."
    },
    {
      "id": 110504456007786505,
      "target": "מזל טוב!"
    },
    {
      "id": 110504456007786503,
      "target": "הצלחת להגיע לזה?"
    },
    {
      "id": 110504456007786502,
      "target": "הלוואי שרק הידיים הקפואות האלה יאהבו אותי."
    }
  ]
}
