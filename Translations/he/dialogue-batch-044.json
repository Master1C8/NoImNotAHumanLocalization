    {
      "id": 110504457316409347,
      "target": "SuperFake: אתה לבד בבית?"
    },
    {
      "id": 110504457316409346,
      "target": "SuperFake: טוב..."
    },
    {
      "id": 110504457316409345,
      "target": "SuperFake: ומה נשאר בחיים האלה שחשוב לך? הרי נשארת לבד. בלי משפחה."
    },
    {
      "id": 110504457316409344,
      "target": "SuperFake: למה אתה מתוח כל כך? אתה ממש נאחז בחיים."
    },
    {
      "id": 110504456775344132,
      "target": "SuperFake: אז למה להתנגד?"
    },
    {
      "id": 110504456775344131,
      "target": "SuperFake: אני יודע שבקרוב הכול יוכרע."
    },
    {
      "id": 110504456775344130,
      "target": "SuperFake: במה אתה נאחז?"
    },
    {
      "id": 110504456775344129,
      "target": "SuperFake: למה?"
    },
    {
      "id": 110504456775344128,
      "target": "SuperFake: אתה כל הזמן בורח. מהאנשים שלי, מהבעיות."
    },
    {
      "id": 110504456771149835,
      "target": "SuperFake: בשביל זה אני כאן."
    },
    {
      "id": 110504456771149834,
      "target": "SuperFake: אתה לא מוכן לקחת את העניינים לידיים שלך."
    },
    {
      "id": 110504456771149833,
      "target": "SuperFake: כככן."
    },
    {
      "id": 110504456771149832,
      "target": "SuperFake: אתה מפחד?"
    },
    {
      "id": 110504456771149830,
      "target": "SuperFake: בכל זאת אתה מוכן."
    },
    {
      "id": 110504456771149829,
      "target": "סילקתי מהבית כמה אנשים מיותרים"
    },
    {
      "id": 110504456771149828,
      "target": "סילקתי מהבית את כל האנשים המיותרים"
    },
    {
      "id": 110504456771149827,
      "target": "הכנסתי רק את מי שצריך"
    },
    {
      "id": 110504456771149826,
      "target": "יש בבית הרבה אנשים שאינם בני אדם"
    },
    {
      "id": 110504456771149825,
      "target": "לא הכנסתי אף אחד"
    },
    {
      "id": 110504456771149824,
      "target": "יש בבית הרבה אנשים"
    },
    {
      "id": 110504456766955531,
      "target": "SuperFake: יש עכשיו בבית שלך אנשים משלי?"
