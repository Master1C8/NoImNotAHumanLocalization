  "entries": [
    {
      "id": 110504456473354250,
      "target": "Bestson: יורים, מכים זה את זה, אני לא מבין…"
    },
    {
      "id": 110504456473354249,
      "target": "Bestson: חום מטורף, וגם משהו לא בסדר עם האנשים."
    },
    {
      "id": 110504456473354248,
      "target": "Bestson: אתה יכול לומר לי מה קורה?"
    },
    {
      "id": 110504456460771331,
      "target": "מה קרה?"
    },
    {
      "id": 110504456460771330,
      "target": "מי עשה לך את זה?"
    },
    {
      "id": 110504456460771329,
      "target": "Fugitive: ירו בי. לא אשרוד עוד הרבה זמן."
    },
    {
      "id": 110504456460771328,
      "target": "Fugitive: תעזור לי."
    },
    {
      "id": 110504456448188418,
      "target": "מה את צריכה?"
    },
    {
      "id": 110504456448188417,
      "target": "יתאים למה?"
    },
    {
      "id": 110504456448188416,
      "target": "Nun: אני חושבת שהבית הזה יתאים לי."
    },
    {
      "id": 110504456443994123,
      "target": "Nun: אני רואה שהבית הקטן שלך עומד הכי רחוק מכולם."
    },
    {
      "id": 110504456431411208,
      "target": "כן, יש לי רובה"
    },
    {
      "id": 110504456431411207,
      "target": "למה אתה צריך לדעת?"
    },
    {
      "id": 110504456431411206,
      "target": "Raskolnikov: תגיד, אתה חמוש?"
    },
    {
      "id": 110504456431411205,
      "target": "Raskolnikov: שלום, חבר."
    },
    {
      "id": 110504456418828294,
      "target": "במה בעלך עובד?"
    },
    {
      "id": 110504456418828293,
      "target": "איך הגעת לכאן?"
    },
    {
      "id": 110504456418828292,
      "target": "Wifefema: אבל לצערי, מקום העבודה שלו לא יכול לספק לי מגורים."
    },
    {
      "id": 110504456418828291,
      "target": "Wifefema: רציתי להפתיע אותו ולראות אותו."
    },
    {
      "id": 110504456418828290,
      "target": "Wifefema: הגעתי לכאן כדי לראות את בעלי. העבירו אותו לכאן מטעם העבודה."
    },
    {
      "id": 110504456418828289,
      "target": "Wifefema: שלום, אוכל לגור אצלך קצת?"
    },
    {
      "id": 110504456406245378,
      "target": "לא, אני לא מהוועדה למצבי חירום"
    },
    {
      "id": 110504456406245377,
      "target": "לסמוך עליי בקשר למה?"
    },
    {
      "id": 110504456406245376,
      "target": "Theorist: אין לך שום קשר לוועדה למצבי חירום, נכון?"
    },
    {
      "id": 110504456402051082,
      "target": "Theorist: שלום, תגיד, אני יכול לסמוך עליך?"
    },
    {
      "id": 110504456360108036,
      "target": "שתיכן חולות? או רק אחת מכן?"
    },
    {
      "id": 110504456360108035,
      "target": "מישהו שקרוב אליכן לא מרגיש טוב?"
    },
    {
      "id": 110504456360108034,
      "target": "Twins: זה בסדר שבאנו לכאן?"
    },
    {
      "id": 110504456360108033,
      "target": "Twins: שלום. אוי, תישעני עליי בינתיים."
    },
    {
      "id": 110504456347525120,
      "target": "הלכתן הרבה זמן?"
    },
    {
      "id": 110504456343330827,
      "target": "באתן ישר לכאן?"
    },
    {
      "id": 110504456343330826,
      "target": "NotTrue: אפשר לנוח אצלך?"
    },
    {
      "id": 110504456343330825,
      "target": "NotTrue: שלום, חמוד! קצת התעייפתי בדרך לכאן."
    },
    {
      "id": 110504456334942210,
      "target": "אני לא מתכוון להכניס אותך"
    },
    {
      "id": 110504456334942209,
      "target": "מה אתה רוצה?"
    },
    {
      "id": 110504456334942208,
      "target": "SuperFake: שלום!"
    },
    {
      "id": 110504456326553605,
      "target": "קרה משהו?"
    },
    {
      "id": 110504456326553604,
      "target": "את בהתקף היסטריה?"
    },
    {
      "id": 110504456326553603,
      "target": "Daughter: ת־תכניס אותי."
    },
    {
      "id": 110504456326553602,
      "target": "Daughter: ש־ש־שלום."
    },
    {
      "id": 110504456313970692,
      "target": "ספרי לי משהו על אבא שלך."
    },
    {
      "id": 110504456313970691,
      "target": "איך קוראים לאבא שלך?"
    },
    {
      "id": 110504456313970690,
      "target": "Daughter: ביום לא פחדתי, אבל עכשיו אני מפחדת — המון אנשים יצאו להסתובב בלילה…"
    },
    {
      "id": 110504456313970689,
      "target": "Daughter: אבא שלי אצלך? תקרא לו?"
    },
    {
      "id": 110504456313970688,
      "target": "Daughter: שלום!"
    },
    {
      "id": 110504456284610565,
      "target": "אז מה קורה?"
    },
    {
      "id": 110504456284610564,
      "target": "מה אתה צריך?"
    },
    {
      "id": 110504456284610563,
      "target": "Scammer: איך העניינים אצלך?"
    },
    {
      "id": 110504456284610562,
      "target": "Scammer: ראית מה קורה? פאקינג מטורף."
    },
    {
      "id": 110504456284610561,
      "target": "Scammer: אה, שלום."
    }
