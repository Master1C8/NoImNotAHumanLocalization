    {
      "id": 110504456754372613,
      "target": "SuperFake: נתראה?"
    },
    {
      "id": 110504456754372612,
      "target": "SuperFake: טוב…"
    },
    {
      "id": 110504456754372611,
      "target": "SuperFake: אני רק ממלא את הרצון הזה."
    },
    {
      "id": 110504456754372610,
      "target": "SuperFake: יש כוחות גדולים ממני."
    },
    {
      "id": 110504456754372609,
      "target": "SuperFake: אתה לא חושב שאני פה… איזה מין מנהיג, נכון?"
    },
    {
      "id": 110504456754372608,
      "target": "SuperFake: השינויים הם עוד לא הדבר המפחיד ביותר שמחכה לך."
    },
    {
      "id": 110504456750178314,
      "target": "SuperFake: אפילו האנשים שלי מעטים למדי. שלא לדבר עליכם, הסגורים בבתים שלכם."
    },
    {
      "id": 110504456750178313,
      "target": "SuperFake: מעניין."
    },
    {
      "id": 110504456750178312,
      "target": "SuperFake: בוא איתי."
    },
    {
      "id": 110504456750178311,
      "target": "SuperFake: הנה, הכלל החדש שלנו כבר נכנס לפעולה."
    },
    {
      "id": 110504456750178310,
      "target": "SuperFake: הממ…"
    },
    {
      "id": 110504456750178307,
      "target": "SuperFake: אתה לבד בבית?"
    },
    {
      "id": 110504456750178306,
      "target": "SuperFake: אבל קודם נבדוק את הכלל החדש שלנו."
    },
    {
      "id": 110504456750178305,
      "target": "SuperFake: כמובן! אני כבר הולך."
    },
    {
      "id": 110504456745984010,
      "target": "SuperFake: אתה לבד בבית?"
    },
    {
      "id": 110504456745984009,
      "target": "SuperFake: אבל קודם כול…"
    },
    {
      "id": 110504456745984008,
      "target": "SuperFake: ננסה את זה עכשיו."
    },
    {
      "id": 110504456745984007,
      "target": "SuperFake: זה פשוט."
    },
    {
      "id": 110504456745984006,
      "target": "אתה יכול לבוא אחר כך?"
    },
    {
      "id": 110504456745984004,
      "target": "SuperFake: אתה תפתח לי את הדלת."
    },
    {
      "id": 110504456745984003,
      "target": "SuperFake: אם יהיו בבית שלך לפחות שניים מהאנשים שלי…"
    },
    {
      "id": 110504456745984002,
      "target": "SuperFake: בוא נשנה את זה."
    },
    {
      "id": 110504456745984001,
      "target": "SuperFake: כאילו לא אכפת לך אפילו מעצמך."
    },
    {
      "id": 110504456745984000,
      "target": "SuperFake: אתה קצת אדיש."
    },
    {
      "id": 110504456741789707,
      "target": "אתה יכול לבוא אחר כך?"
