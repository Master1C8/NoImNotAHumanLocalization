  "entries": [
    {
      "id": 110504452899807232,
      "target": "Wolfhound: יש אנשים שקופאים במקום מול סכנה, ויש כאלה שבורחים."
    },
    {
      "id": 110504452895612933,
      "target": "Wolfhound: ניסו להרוג אותי. לעולם לא אעמוד ואחכה שיהרגו אותי."
    },
    {
      "id": 110504452895612932,
      "target": "Wolfhound: כן, הרגתי. לא מזמן."
    },
    {
      "id": 110504452895612931,
      "target": "Wolfhound: רוצה לשמוע על הידיים שלי?"
    },
    {
      "id": 110504452895612928,
      "target": "Wolfhound: אז שיחזיקו אותן חזק בקבר, בני הזונות ההם."
    },
    {
      "id": 110504452891418633,
      "target": "Wolfhound: ואת אלה שחסרות…"
    },
    {
      "id": 110504452891418632,
      "target": "Wolfhound: אני מטפל בשיניים שלי."
    },
    {
      "id": 110504452891418630,
      "target": "Wolfhound: אם תתקוף אותי, אנשך לך את הצוואר עם השיניים האלה."
    },
    {
      "id": 110504452891418629,
      "target": "Wolfhound: תיזהר ממני."
    },
    {
      "id": 110504452887224326,
      "target": "Wolfhound: מה אתה רוצה לבדוק?"
    }
  ]
}
