    {
      "id": 110504457849085955,
      "target": "Phone: (האדם בצד השני מנתק. זה היה… לא בדיוק מה שציפית לו.)"
    },
    {
      "id": 110504457849085954,
      "target": "Phone: למה אתה לא עונה? אני רוצה למות."
    },
    {
      "id": 110504457849085953,
      "target": "Phone: בדוק אם היא נושמת."
    },
    {
      "id": 110504457844891658,
      "target": "Phone: מלבד בכי ופרידה."
    },
    {
      "id": 110504457844891657,
      "target": "Phone: ניפ… לא משנה"
    },
    {
      "id": 110504457844891656,
      "target": "Phone: אף שמושכים אותה צלי…,"
    },
    {
      "id": 110504457844891655,
      "target": "Phone: פחד מ… ג…"
    },
    {
      "id": 110504457844891654,
      "target": "Phone: מבנה התפוח: מעל־תפוחון, ארץ הפטריות והנייר."
    }
  ]
}
