  "sourceInventorySha256": "ecd96645c2ca6f23f8bf3ab2fcf65709e961478ae15a38e83d94cc335a408bf0",
  "glossaryFingerprint": "15387d7d390dd7fde7556b067854fbb08139b46e2831cca0357f5f6b32521d24",
  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504454439116806,
      "target": "Widow: Tělo si prohlédnout nesmím."
    },
    {
      "id": 110504454439116805,
      "target": "Widow: To je všechno."
    },
    {
      "id": 110504454439116804,
      "target": "Widow: Řekli mi: „Zemřel.“"
    },
    {
      "id": 110504454439116803,
      "target": "Widow: …"
    },
    {
      "id": 110504454439116802,
      "target": "Widow: Moment, promiňte."
    },
    {
      "id": 110504454439116801,
      "target": "Widow: …"
    },
    {
      "id": 110504454439116800,
      "target": "Widow: Jen mi suše řekli…"
    },
    {
      "id": 110504454434922503,
      "target": "Widow: Přišla jsem dřív, jen se na něj podívat."
    },
    {
      "id": 110504454434922502,
      "target": "Widow: …"
    },
    {
      "id": 110504454434922501,
      "target": "Widow: KČS ho prostě zavřel do karantény. Nesměla jsem s ním být ve spojení. Řekli, že ho pustí za tři týdny."
    },
    {
      "id": 110504454434922500,
      "target": "Widow: Přišli jsme do centra, které otevřel KČS."
    },
    {
      "id": 110504454434922499,
      "target": "Widow: Manželovi bylo špatně. Šli jsme do nemocnice, ale poslali ho na vyšetření k těm parchantům."
    },
    {
      "id": 110504454434922498,
      "target": "Už se na to nemusím ptát"
    },
    {
      "id": 110504454434922497,
      "target": "Tak co se stalo?"
    },
    {
      "id": 110504454434922496,
      "target": "Widow: A někdo je zabije."
    },
    {
      "id": 110504454430728198,
      "target": "Widow: Doufám, že ti parchanti dostanou, co si zaslouží."
    },
    {
      "id": 110504454430728197,
      "target": "Widow: Bylo to hrubé. Ale nedokážu o něm mluvit klidně."
    },
    {
      "id": 110504454430728196,
      "target": "Widow: Ano. Ano, chápu."
    },
    {
      "id": 110504454430728195,
      "target": "Widow: …"
    },
    {
      "id": 110504454430728194,
      "target": "Už se na to nemusím ptát"
    },
    {
      "id": 110504454430728193,
      "target": "Tak co se stalo?"
    },
    {
      "id": 110504454430728192,
      "target": "Widow: Ale nejvíc chci, aby pod sluncem shořeli ti, kvůli kterým… se to všechno stalo."
    },
    {
      "id": 110504454426533897,
      "target": "Widow: Každou noc nedokážu zadržet slzy."
    },
    {
      "id": 110504454426533896,
      "target": "Widow: Promiňte, já prostě nemůžu…"
    },
    {
      "id": 110504454426533895,
      "target": "Widow: …"
    },
    {
      "id": 110504454426533894,
      "target": "Já za jeho smrt nemůžu"
    },
    {
      "id": 110504454426533893,
      "target": "Chápu. Promiň, jestli jsem se tě dotkl"
    },
    {
      "id": 110504454426533892,
      "target": "Widow: Kurva, on zemřel."
    },
    {
      "id": 110504454426533890,
      "target": "Co se mu tedy stalo?"
    },
    {
      "id": 110504454426533889,
      "target": "Widow: Chtěla bych si trochu odpočinout…"
    },
    {
      "id": 110504454426533888,
      "target": "Widow: Už mi nikdy nezahraješ. Zazpíval jsi mi svou poslední píseň."
    },
    {
      "id": 110504454422339595,
      "target": "Widow: Trochu se potrhala…"
    },
    {
      "id": 110504454422339594,
      "target": "Widow: Zůstala mi i fotografie z toho večera."
    },
    {
      "id": 110504454422339593,
      "target": "Widow: …"
    },
    {
      "id": 110504454422339592,
      "target": "Widow: Později jsem zjistila, že se naučil jednu píseň schválně, aby na mě zapůsobil."
    },
    {
      "id": 110504454422339591,
      "target": "Widow: Pak vstane, řekne, že už je třeba jít, zavadí o sklenici, snaží se ji chytit a upustí kytaru…"
    },
    {
      "id": 110504454422339590,
      "target": "Widow: Kamarádi si u něj začali objednávat různé písničky. On pořád sedí a sedí, a pak…"
    },
    {
      "id": 110504454422339589,
      "target": "Widow: A zahrál tak skvěle, moc se mi to líbilo."
    },
    {
      "id": 110504454422339588,
      "target": "Widow: „Dejte kytaru, teď si zazpíváme.“"
    }
  ]
}
