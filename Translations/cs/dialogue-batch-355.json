  "entries": [
    {
      "id": 110504452593623045,
      "target": "BigLebowski: …"
    },
    {
      "id": 110504452593623044,
      "target": "BigLebowski: Vždyť mám normální oči. Co blázníš?"
    },
    {
      "id": 110504452593623041,
      "target": "BigLebowski: Rozhodni se rychle: buď zmáčkni spoušť, nebo s tímhle přestaň."
    },
    {
      "id": 110504452593623040,
      "target": "BigLebowski: Víš co, strejdo, už je mi to nějak fuk."
    },
    {
      "id": 110504452589428744,
      "target": "BigLebowski: JSI SNAD SRAB???"
    },
    {
      "id": 110504452589428743,
      "target": "BigLebowski: ZMÁČKNI SPOUŠŤ!"
    },
    {
      "id": 110504452589428742,
      "target": "BigLebowski: TAK DĚLEJ, UDĚLEJ TO!"
    },
    {
      "id": 110504452589428741,
      "target": "BigLebowski: Víš co, seru na to! Střílej! Už mě to všechno kolem tak unavilo!"
    },
    {
      "id": 110504452589428738,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452589428737,
      "target": "BigLebowski: Tak co? Jsou čisté? Splňují tvoje nároky?"
    },
    {
      "id": 110504452589428736,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452585234440,
      "target": "BigLebowski: Dobře, je mi to úplně fuk."
    },
    {
      "id": 110504452585234437,
      "target": "BigLebowski: Tak co? Ukaž!"
    },
    {
      "id": 110504452585234436,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452585234435,
      "target": "BigLebowski: Jestli chceš tu fotku poslat rodičům, aby mě podle ní našli, tak jdi do prdele."
    },
    {
      "id": 110504452585234434,
      "target": "BigLebowski: …"
    },
    {
      "id": 110504452581040138,
      "target": "BigLebowski: Ne. To je nějaká divná sračka. Tohle dělat nebudu."
    },
    {
      "id": 110504452581040135,
      "target": "BigLebowski: …"
    },
    {
      "id": 110504452581040134,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452581040133,
      "target": "BigLebowski: Připomínám ti: jestli máš za lubem něco divného, sama ti vyrazím oko!"
    },
    {
      "id": 110504452581040130,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452581040129,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452581040128,
      "target": "BigLebowski: Tady."
    },
    {
      "id": 110504452576845836,
      "target": "BigLebowski: To je alergie. Proto to svědí. Dost nepříjemná věc. Mám to prostě od dětství."
    },
    {
      "id": 110504452576845835,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452576845834,
      "target": "BigLebowski: Jen se nelekni…"
    },
    {
      "id": 110504452576845833,
      "target": "BigLebowski: Hm…"
    },
    {
      "id": 110504452576845830,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452576845829,
      "target": "BigLebowski: Rodiče měli o moje zuby mnohem větší starost než o mě…"
    },
    {
      "id": 110504452576845828,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452576845827,
      "target": "BigLebowski: Divná věc. Pamatuj si, že jestli něco vymyslíš, můžu tě praštit i do ksichtu!"
    },
    {
      "id": 110504452572651529,
      "target": "BigLebowski: Dobře, tak do toho, strejdo. Je mi to fuk."
    }
  ]
}
