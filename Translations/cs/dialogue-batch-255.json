  "entries": [
    {
      "id": 110504454455894023,
      "target": "Čím ses živil před katastrofou?"
    },
    {
      "id": 110504454455894022,
      "target": "Scammer: He-he. No co je, kurva?"
    },
    {
      "id": 110504454455894021,
      "target": "Widow: Doufám, že najdete, co hledáte."
    },
    {
      "id": 110504454455894020,
      "target": "Widow: Moc nemluvíte, ale… ukázal jste se jako příjemný společník k rozhovoru."
    },
    {
      "id": 110504454455894019,
      "target": "Widow: Děkuji."
    },
    {
      "id": 110504454455894018,
      "target": "Widow: Dokud se nevrátím, nechci o ničem rozhodovat."
    },
    {
      "id": 110504454455894017,
      "target": "Widow: Moc se chci vrátit domů."
    },
    {
      "id": 110504454455894016,
      "target": "Widow: Jsi mi lhostejný, promiň."
    },
    {
      "id": 110504454451699715,
      "target": "Widow: Mně se neuleví."
    },
    {
      "id": 110504454451699714,
      "target": "Widow: Proč?"
    },
    {
      "id": 110504454451699713,
      "target": "Hodně štěstí"
    },
    {
      "id": 110504454451699712,
      "target": "Můžeš zůstat"
    },
    {
      "id": 110504454447505416,
      "target": "Widow: Už nic jiného nechci."
    },
    {
      "id": 110504454447505415,
      "target": "Widow: Vrátíme se domů."
    },
    {
      "id": 110504454447505414,
      "target": "Widow: Nikdo nezbyl."
    },
    {
      "id": 110504454447505413,
      "target": "Hodně štěstí"
    },
    {
      "id": 110504454447505412,
      "target": "Můžeš zůstat"
    },
    {
      "id": 110504454447505411,
      "target": "Widow: A tam…"
    },
    {
      "id": 110504454447505410,
      "target": "Widow: Vezmu si kytaru."
    },
    {
      "id": 110504454447505409,
      "target": "Widow: Vrátím se domů."
    },
    {
      "id": 110504454447505408,
      "target": "Widow: Nechci na to myslet."
    },
    {
      "id": 110504454443311116,
      "target": "Jedeš za příbuznými?"
    },
    {
      "id": 110504454443311115,
      "target": "Co teď?"
    },
    {
      "id": 110504454443311114,
      "target": "Widow: Potřebovala jsem si jen odpočinout."
    },
    {
      "id": 110504454443311113,
      "target": "Widow: Hned jsem říkala, že nehodlám zůstat dlouho."
    },
    {
      "id": 110504454443311112,
      "target": "Widow: Odcházím dnes v noci."
    },
    {
      "id": 110504454443311110,
      "target": "Je něco v nepořádku?"
    },
    {
      "id": 110504454443311109,
      "target": "Widow: Chtěla bych si trochu odpočinout…"
    },
    {
      "id": 110504454443311108,
      "target": "Widow: Bez něj je teď život strašně těžký…"
    },
    {
      "id": 110504454443311107,
      "target": "Widow: Ano. Prosím."
    },
    {
      "id": 110504454443311106,
      "target": "Widow: Chci být sama."
    },
    {
      "id": 110504454443311105,
      "target": "Widow: …"
    },
    {
      "id": 110504454443311104,
      "target": "Widow: Vy jste zabil – vám zůstane jeho duše. A mně zbude jen křičet, že mi nikoho není líto."
    },
    {
      "id": 110504454439116811,
      "target": "Widow: …"
    },
    {
      "id": 110504454439116810,
      "target": "Widow: Opravdu tam…"
    },
    {
      "id": 110504454439116809,
      "target": "Widow: A on…"
    },
    {
      "id": 110504454439116808,
      "target": "Widow: U takových debilů je věčně bordel, takže mi stačilo navléct lékařský plášť a projít do márnice."
    },
    {
      "id": 110504454439116807,
      "target": "Widow: Domů ho vzít nemůžu."
    }
  ]
}
