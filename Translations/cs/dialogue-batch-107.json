  "entries": [
    {
      "id": 110504456574017540,
      "target": "Ballerina: To je můj dáreček pro tebe."
    },
    {
      "id": 110504456574017539,
      "target": "Ballerina: Kocoura najdeš pod domem."
    },
    {
      "id": 110504456574017538,
      "target": "Ballerina: …"
    },
    {
      "id": 110504456574017537,
      "target": "Ballerina: Pojď, kocourku, budeš mě tu bavit, viď?"
    },
    {
      "id": 110504456574017536,
      "target": "Ballerina: Buď jako doma."
    },
    {
      "id": 110504456569823243,
      "target": "Jdi už do prdele"
    },
    {
      "id": 110504456569823242,
      "target": "…Pojď dál"
    },
    {
      "id": 110504456569823241,
      "target": "Ballerina: Ještě si to rozmysli."
    },
    {
      "id": 110504456569823240,
      "target": "Ballerina: Vidíš toho kocoura?"
    },
    {
      "id": 110504456569823239,
      "target": "Ballerina: A kocoura netrap."
    },
    {
      "id": 110504456569823238,
      "target": "Ballerina: Nenechávejte ženu mrznout venku, mladý muži."
    },
    {
      "id": 110504456569823237,
      "target": "Ballerina: …"
    },
    {
      "id": 110504456569823234,
      "target": "Ballerina: Otevřeš? Ne?"
    },
    {
      "id": 110504456569823233,
      "target": "Ballerina: Prošla jsem celým tvým testem?"
    },
    {
      "id": 110504456569823232,
      "target": "Ballerina: To nestačí?"
    },
    {
      "id": 110504456565628939,
      "target": "Ballerina: Mám dvě ruce, dvě nohy a jednu hlavu."
    },
    {
      "id": 110504456565628936,
      "target": "Ballerina: Tak už se rozhodni, co uděláme?"
    },
    {
      "id": 110504456565628935,
      "target": "Ballerina: Jsem baletka."
    },
    {
      "id": 110504456565628934,
      "target": "Ballerina: Možná si i zatancuju."
    },
    {
      "id": 110504456565628933,
      "target": "Ballerina: Mám ti zatancovat?"
    },
    {
      "id": 110504456565628932,
      "target": "Ballerina: No a co?"
    },
    {
      "id": 110504456565628931,
      "target": "Dokaž, že jsi člověk"
    },
    {
      "id": 110504456565628930,
      "target": "Nevěřím, že jsi člověk"
    },
    {
      "id": 110504456565628929,
      "target": "Ballerina: Zvláštní věta."
    },
    {
      "id": 110504456565628928,
      "target": "Ballerina: Co dál? Připomněla jsem ti ho? Nebo co?"
    },
    {
      "id": 110504456561434635,
      "target": "Ballerina: No… dobře."
    },
    {
      "id": 110504456561434634,
      "target": "Dokaž, že jsi člověk"
    },
    {
      "id": 110504456561434633,
      "target": "Nevěřím, že jsi člověk"
    },
    {
      "id": 110504456561434632,
      "target": "Ballerina: Heh."
    },
    {
      "id": 110504456561434631,
      "target": "Ballerina: …"
    },
    {
      "id": 110504456561434630,
      "target": "Ballerina: Nevím. Jaký je v tom rozdíl?"
    },
    {
      "id": 110504456561434629,
      "target": "Připomínáš mi jednoho… člověka"
    },
    {
      "id": 110504456561434628,
      "target": "Někdo tě sem poslal?"
    },
    {
      "id": 110504456561434627,
      "target": "Ballerina: A u tebe není horko."
    },
    {
      "id": 110504456561434626,
      "target": "Ballerina: Uviděla jsem tvůj dům a přišla jsem."
    },
    {
      "id": 110504456561434625,
      "target": "Ballerina: Vidíš město? Tam jsem žila."
    },
    {
      "id": 110504456561434624,
      "target": "Připomínáš mi jednoho… člověka"
    },
    {
      "id": 110504456557240330,
      "target": "Někdo tě sem poslal?"
    },
    {
      "id": 110504456557240329,
      "target": "Ballerina: Věnovala jsem se baletu. Je to vidět?"
    },
    {
      "id": 110504456557240328,
      "target": "Ballerina: Tančím."
    },
    {
      "id": 110504456557240327,
      "target": "Jak jsi našla můj dům?"
    },
    {
      "id": 110504456557240326,
      "target": "Kdo jsi?"
    },
    {
      "id": 110504456557240325,
      "target": "Ballerina: Řekli mi, ať sem jdu, tak jdu."
    },
    {
      "id": 110504456557240324,
      "target": "Ballerina: Otevřeš ty dveře, nebo ne?"
    },
    {
      "id": 110504456557240323,
      "target": "Ballerina: …"
    },
    {
      "id": 110504456557240322,
      "target": "Ballerina: Bednu piva. Noční stolek. Kýtu. Nevím. Dej mi, co chceš."
    },
    {
      "id": 110504456557240321,
      "target": "Jak jsi našla můj dům?"
    },
    {
      "id": 110504456557240320,
      "target": "Kdo jsi?"
    },
    {
      "id": 110504456553046028,
      "target": "Ballerina: A k čemu ti to pomůže?"
    },
    {
      "id": 110504456553046027,
      "target": "Ballerina: Spousta otázek. Ano, já vím."
    },
    {
      "id": 110504456553046026,
      "target": "Ballerina: …"
    },
    {
      "id": 110504456553046025,
      "target": "Co chceš?"
    },
    {
      "id": 110504456553046024,
      "target": "Znáš… toho plešatého chlapa?"
    },
    {
      "id": 110504456553046023,
      "target": "Ballerina: Otevřeš ty dveře?"
    },
    {
      "id": 110504456553046022,
      "target": "Ballerina: …"
    },
    {
      "id": 110504456553046021,
      "target": "Ballerina: Ahoj."
    }
  ]
}
