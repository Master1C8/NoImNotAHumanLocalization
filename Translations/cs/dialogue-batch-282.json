  "entries": [
    {
      "id": 110504454057435146,
      "target": "Fairytaller: Hm… Zajímavý výsledek."
    },
    {
      "id": 110504454057435145,
      "target": "Fairytaller: ..."
    },
    {
      "id": 110504454057435144,
      "target": "Fairytaller: To zní zajímavě."
    },
    {
      "id": 110504454057435141,
      "target": "Fairytaller: Já vím. Nepříjemný zápach."
    },
    {
      "id": 110504454057435140,
      "target": "Fairytaller: ..."
    },
    {
      "id": 110504454057435139,
      "target": "Fairytaller: Tady."
    },
    {
      "id": 110504454057435138,
      "target": "Fairytaller: Ehm… Dobře…"
    },
    {
      "id": 110504454053240841,
      "target": "Fairytaller: K čemu všemu už lidé přirovnávali barvu mých očí. Slyšel jsem hodně pochval, ale i pravý opak."
    },
    {
      "id": 110504454053240840,
      "target": "Fairytaller: V horku mi oči často zčervenají. Mám rozšířené cévky. Obvykle jsem si dával studené obklady, ale teď je to těžké."
    },
    {
      "id": 110504454053240839,
      "target": "Fairytaller: ..."
    },
    {
      "id": 110504454053240838,
      "target": "Fairytaller: Tady."
    },
    {
      "id": 110504454053240835,
      "target": "Fairytaller: A teď jsem si to jen trochu rozškrábal z nervozity."
    },
    {
      "id": 110504454053240834,
      "target": "Fairytaller: Jeden náš kamarád se ale pověsil na skříň, ta mi spadla na ruce a otiskla mi vzor do ruky. Možná už napořád."
    },
    {
      "id": 110504454053240833,
      "target": "Fairytaller: To mám z dětství. Lezli jsme po opuštěných budovách. Na zemi leželo pletivo a já po něm lezl jako pavouk."
    },
    {
      "id": 110504454053240832,
      "target": "Fairytaller: ..."
    },
    {
      "id": 110504454049046537,
      "target": "Fairytaller: Tady."
    },
    {
      "id": 110504454049046534,
      "target": "Fairytaller: Zuby a dásně nemám celý život moc dobré. A od konce univerzity jsem se nedostal k zubaři. Celé léto jsem měl jiné starosti."
    },
    {
      "id": 110504454049046533,
      "target": "Fairytaller: ..."
    },
    {
      "id": 110504454049046532,
      "target": "Fairytaller: Tady."
    },
    {
      "id": 110504454044852233,
      "target": "Fairytaller: Dobře. Co chcete zkontrolovat?"
    },
    {
      "id": 110504454044852232,
      "target": "Leper: Umřít…"
    },
    {
      "id": 110504454044852231,
      "target": "Leper: Sakra, já nechci…"
    },
    {
      "id": 110504454044852230,
      "target": "Leper: KČS nikdy neříkal, že existuje takový příznak."
    },
    {
      "id": 110504454044852229,
      "target": "Leper: Takhle mi přivodíš infarkt. Odkud vůbec víš o těch uších?"
    },
    {
      "id": 110504454044852228,
      "target": "Leper: Zasraný světlo…"
    }
  ]
}
