  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504456217501702,
      "target": "Gasmask: Na shledanou."
    },
    {
      "id": 110504456217501701,
      "target": "Gasmask: Odvádíme jednoho člověka, pokusíme se ho co nejdříve vrátit."
    },
    {
      "id": 110504456217501700,
      "target": "Gasmask: Teď se nemusíte znepokojovat."
    },
    {
      "id": 110504456217501699,
      "target": "Gasmask: Ano. Až budeme mít všechny informace, vydáme pokyny."
    },
    {
      "id": 110504456217501698,
      "target": "Gasmask: Mějte se dobře."
    },
    {
      "id": 110504456217501697,
      "target": "Gasmask: Teď odvedeme jednoho člověka a odejdeme."
    },
    {
      "id": 110504456217501696,
      "target": "Gasmask: V tom případě není třeba, zůstaňte s ostatními obyvateli. Kdyby byla nutná evakuace, dáme vám vědět."
    },
    {
      "id": 110504456213307403,
      "target": "Gasmask: Je to váš dům?"
    },
    {
      "id": 110504456213307402,
      "target": "Mám jen na něco čekat?"
    },
    {
      "id": 110504456213307401,
      "target": "Mám si sbalit věci?"
    },
    {
      "id": 110504456213307400,
      "target": "Gasmask: Jen podstoupí testy, ujistíme se, že je všechno v pořádku, a vrátíme ho."
    },
    {
      "id": 110504456213307399,
      "target": "Gasmask: Jednoho člověka z vašeho domu odvezeme do naší laboratoře."
    },
    {
      "id": 110504456213307398,
      "target": "Gasmask: Samozřejmě. Nemůžeme přece jednat nahodile."
    },
    {
      "id": 110504456213307397,
      "target": "Mám jen na něco čekat?"
    },
    {
      "id": 110504456213307396,
      "target": "Mám si sbalit věci?"
    },
    {
      "id": 110504456213307395,
      "target": "Gasmask: A samozřejmě ověříme, zda je člověk."
    },
    {
      "id": 110504456213307394,
      "target": "Gasmask: Odebereme vzorky, abychom se ujistili, že člověk, který v této oblasti žil, je v pořádku."
    },
    {
      "id": 110504456213307393,
      "target": "Gasmask: Odvedu jednoho člověka."
    },
    {
      "id": 110504456213307392,
      "target": "Máte nějaký plán?"
    },
    {
      "id": 110504456209113098,
      "target": "A co dál?"
    },
    {
      "id": 110504456209113097,
      "target": "Gasmask: Teď musíte především zachovat klid."
    },
    {
      "id": 110504456209113096,
      "target": "Gasmask: Potom vypracují další postup."
    },
    {
      "id": 110504456209113095,
      "target": "Gasmask: Nejdřív shromáždíme údaje a pošleme je vedení."
    },
    {
      "id": 110504456209113094,
      "target": "Máte nějaký plán?"
    },
    {
      "id": 110504456209113093,
      "target": "A co dál?"
    },
    {
      "id": 110504456209113092,
      "target": "Gasmask: Protože býváme často venku, musíme být ve střehu."
    },
    {
      "id": 110504456209113091,
      "target": "Gasmask: Zatím zkoumáme vliv slunce na okolí."
    },
    {
      "id": 110504456209113090,
      "target": "Gasmask: Ne. Ale pokud to považujete za nutné, můžete si ho koupit."
    },
    {
      "id": 110504456209113089,
      "target": "Jak nám budeš pomáhat?"
    },
    {
      "id": 110504456209113088,
      "target": "Proč máš ochranný oblek? Potřebujeme ho taky?"
    },
    {
      "id": 110504456204918795,
      "target": "Gasmask: Navíc Hosté málokdy chodí ve skupinách, skoro nikdy."
    },
    {
      "id": 110504456204918794,
      "target": "Gasmask: Můžu vám ukázat průkaz."
    },
    {
      "id": 110504456204918793,
      "target": "Jak nám budeš pomáhat?"
    },
    {
      "id": 110504456204918792,
      "target": "Proč máš ochranný oblek? Potřebujeme ho taky?"
    },
    {
      "id": 110504456204918791,
      "target": "Gasmask: Myslím, že náš rozhovor dlouho nepotrvá."
    },
    {
      "id": 110504456204918790,
      "target": "Gasmask: Náš tým se rozdělil do několika menších skupin, abychom obešli více domů."
    },
    {
      "id": 110504456204918789,
      "target": "Gasmask: Ne, samozřejmě."
    },
    {
      "id": 110504456204918788,
      "target": "Proč bych ti měl věřit?"
    },
    {
      "id": 110504456204918787,
      "target": "Přišel jsi sám?"
    },
    {
      "id": 110504456204918786,
      "target": "Gasmask: Jsem z týmu KČS, obcházíme vaši čtvrť."
    },
    {
      "id": 110504456204918785,
      "target": "Gasmask: Dobrý večer."
    }
  ]
}
