  "entries": [
    {
      "id": 110504455961649157,
      "target": "Intruder: Tak a teď si lámej hlavu, jestli jsem ti řekl pravdu, nebo ti jen kecám sračky."
    },
    {
      "id": 110504455961649156,
      "target": "Intruder: Takže se můžeš uklidnit."
    },
    {
      "id": 110504455961649155,
      "target": "Intruder: Ostatně z tvých očí už vidím, že žádné sny nemáš."
    },
    {
      "id": 110504455961649154,
      "target": "Intruder: Pochop, já ty sny OPRAVDU potřebuju."
    },
    {
      "id": 110504455961649153,
      "target": "Táhni mi od ksichtu."
    },
    {
      "id": 110504455961649152,
      "target": "Žádné sny nemám"
    },
    {
      "id": 110504455957454859,
      "target": "Jestli neuhneš, jednu ti vrazím."
    },
    {
      "id": 110504455957454858,
      "target": "Intruder: Kde je schováváš? Mluv!"
    },
    {
      "id": 110504455957454857,
      "target": "Intruder: Chci najít klid. Alespoň trochu."
    },
    {
      "id": 110504455957454856,
      "target": "Intruder: Hledám u tebe sny."
    },
    {
      "id": 110504455957454855,
      "target": "Co to děláš?"
    },
    {
      "id": 110504455957454854,
      "target": "Intruder: …"
    },
    {
      "id": 110504455957454853,
      "target": "FortuneTeller: Obávám se, že je to ztracený případ. Je mi líto. Nepomohly ani afirmace…"
    },
    {
      "id": 110504455957454852,
      "target": "FortuneTeller: …"
    },
    {
      "id": 110504455957454851,
      "target": "FortuneTeller: A bez vlastní snahy se nedostaví ani výsledek — vesmír tě prostě neuslyší a nic nezhmotní."
    },
    {
      "id": 110504455957454850,
      "target": "FortuneTeller: Ve tvé auře… Ty nechceš být šťastný. Máš v sobě jen prázdnotu."
    },
    {
      "id": 110504455957454849,
      "target": "FortuneTeller: Počkej… Jak jsem si toho mohla nevšimnout dřív…"
    },
    {
      "id": 110504455957454848,
      "target": "FortuneTeller: Ty se vůbec nesnažíš!"
    },
    {
      "id": 110504455953260555,
      "target": "To jsou nějaké kraviny"
    },
    {
      "id": 110504455953260553,
      "target": "Jsem šťastný člověk!"
    },
    {
      "id": 110504455953260552,
      "target": "FortuneTeller: Pokračuj."
    },
    {
      "id": 110504455953260551,
      "target": "To jsou nějaké kraviny"
    },
    {
      "id": 110504455953260549,
      "target": "Jsem šťastný člověk!"
    },
    {
      "id": 110504455953260548,
      "target": "FortuneTeller: Opakuj po mně: jsem šťastný člověk!"
    },
    {
      "id": 110504455953260547,
      "target": "FortuneTeller: Ale dost slov, přejděme k praxi."
    },
    {
      "id": 110504455953260546,
      "target": "FortuneTeller: No dobrá, nepodléhej sklíčenosti. Pravidelné afirmace štěstí ti pomohou."
    },
    {
      "id": 110504455953260545,
      "target": "FortuneTeller: Zvláštní, mělo to zabrat."
    },
    {
      "id": 110504455953260544,
      "target": "FortuneTeller: …"
    },
    {
      "id": 110504455949066252,
      "target": "FortuneTeller: Cože, nepomohlo to?"
    },
    {
      "id": 110504455949066251,
      "target": "Co to kurva?"
    },
    {
      "id": 110504455949066250,
      "target": "A mělo by?"
    },
    {
      "id": 110504455949066249,
      "target": "FortuneTeller: Tak co, pomohlo to? Už cítíš příval štěstí?"
    },
    {
      "id": 110504455949066248,
      "target": "FortuneTeller: …"
    },
    {
      "id": 110504455949066247,
      "target": "FortuneTeller: PŘEDVÉST TANEC KOZOROHA!"
    },
    {
      "id": 110504455949066246,
      "target": "FortuneTeller: Jen je potřeba…"
    },
    {
      "id": 110504455949066245,
      "target": "FortuneTeller: Víš, myslím, že vím, co by ti mohlo pomoci rozhýbat energii."
    },
    {
      "id": 110504455949066244,
      "target": "FortuneTeller: …"
    },
    {
      "id": 110504455949066243,
      "target": "Esenin: Dobře, jak chceš."
    }
  ]
}
