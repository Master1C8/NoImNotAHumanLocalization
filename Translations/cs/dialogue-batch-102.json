  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504456645320706,
      "target": "Gasmask: A odejdeme."
    },
    {
      "id": 110504456645320705,
      "target": "Gasmask: Takže SI ODVEDEME DVA LIDI."
    },
    {
      "id": 110504456645320704,
      "target": "Gasmask: Vy tu zůstanete umřít."
    },
    {
      "id": 110504456641126412,
      "target": "Gasmask: Odvedeme všechny."
    },
    {
      "id": 110504456641126411,
      "target": "Gasmask: Vyrazíme dveře."
    },
    {
      "id": 110504456641126410,
      "target": "Gasmask: Jako bych mluvil do zdi. Jestli teď odejdeme bez lidí, začneme střílet."
    },
    {
      "id": 110504456641126409,
      "target": "Gasmask: Tak si tu hezky zůstaňte."
    },
    {
      "id": 110504456641126408,
      "target": "Gasmask: …"
    },
    {
      "id": 110504456641126407,
      "target": "Gasmask: Já taky."
    },
    {
      "id": 110504456641126406,
      "target": "Už vám nikoho dalšího nedám"
    },
    {
      "id": 110504456641126405,
      "target": "Doufám, že se už neuvidíme"
    },
    {
      "id": 110504456641126404,
      "target": "Gasmask: S vámi si taky poradíme."
    },
    {
      "id": 110504456641126403,
      "target": "Gasmask: Nejste první, kdo se brání. S takovými už jsme si poradili."
    },
    {
      "id": 110504456641126402,
      "target": "Gasmask: Buď teď vyrazíme dveře a odvedeme celý ten váš zasraný brloh, nebo nám dobrovolně vydáte dva lidi."
    },
    {
      "id": 110504456641126401,
      "target": "Gasmask: Nemám v úmyslu se s vámi dohadovat."
    },
    {
      "id": 110504456641126400,
      "target": "Gasmask: Nemám slov."
    },
    {
      "id": 110504456636932107,
      "target": "Gasmask: …"
    },
    {
      "id": 110504456636932106,
      "target": "Už vám nikoho dalšího nedám"
    },
    {
      "id": 110504456636932105,
      "target": "Doufám, že se už neuvidíme"
    },
    {
      "id": 110504456636932104,
      "target": "Gasmask: A pak buď najdeme způsob, jak působit na Hosty, nebo se už neuvidíme."
    },
    {
      "id": 110504456636932103,
      "target": "Gasmask: Vždyť ani neodvádíme všechny. Potřebujeme jen dva."
    },
    {
      "id": 110504456636932102,
      "target": "Gasmask: Ještě dva lidi."
    },
    {
      "id": 110504456636932101,
      "target": "K čemu jste kurva dobří, když vám stejně nic nevychází?"
    },
    {
      "id": 110504456636932100,
      "target": "A co je potřeba k záchraně?"
    },
    {
      "id": 110504456636932099,
      "target": "Gasmask: Jestli teď nevymyslíme, jak se účinně zachránit, vymyslí to za nás někdo jiný."
    },
    {
      "id": 110504456636932098,
      "target": "Gasmask: Dávají nám nesplnitelné úkoly."
    },
    {
      "id": 110504456636932097,
      "target": "Gasmask: Úřady chtějí vyhodit do povětří celé město, protože situaci nejde zvládnout."
    },
    {
      "id": 110504456636932096,
      "target": "Gasmask: Je to v prdeli."
    },
    {
      "id": 110504456632737804,
      "target": "K čemu jste kurva dobří, když vám stejně nic nevychází?"
    },
    {
      "id": 110504456632737803,
      "target": "A co je potřeba k záchraně?"
    },
    {
      "id": 110504456632737802,
      "target": "Gasmask: Jestli budete dělat problémy, odvezeme prostě všechny z tohohle domu."
    },
    {
      "id": 110504456632737801,
      "target": "Gasmask: SVĚT STOJÍ NA POKRAJI ZÁNIKU."
    },
    {
      "id": 110504456632737800,
      "target": "Gasmask: TAK UŽ PŘESTAŇTE DĚLAT PÍČOVINY!"
    },
    {
      "id": 110504456632737799,
      "target": "Jaká katastrofa?"
    },
    {
      "id": 110504456632737798,
      "target": "Kde. Jsou. Moji. Lidé?"
    },
    {
      "id": 110504456632737797,
      "target": "Gasmask: Jinak dojde ke katastrofě."
    },
    {
      "id": 110504456632737796,
      "target": "Gasmask: Musíme odvést další lidi."
    },
    {
      "id": 110504456632737795,
      "target": "Gasmask: Brzy je přivedeme zpátky. Děkuji."
    },
    {
      "id": 110504456632737794,
      "target": "Gasmask: Prostě. Nám. Dejte. Lidi."
    },
    {
      "id": 110504456632737793,
      "target": "Gasmask: Záleží nám na tomhle městě."
    },
    {
      "id": 110504456632737792,
      "target": "Gasmask: Jestli budete klást odpor, výbuchy budou pokračovat."
    },
    {
      "id": 110504456628543499,
      "target": "Gasmask: Protože nám v práci brání tvrdohlaví zmrdi."
    },
    {
      "id": 110504456628543498,
      "target": "Gasmask: Líbí se vám ta podívaná za mnou?"
    },
    {
      "id": 110504456628543497,
      "target": "Gasmask: Dobře."
    },
    {
      "id": 110504456628543496,
      "target": "Gasmask: Do prdele…"
    },
    {
      "id": 110504456628543495,
      "target": "Gasmask: A vypořádáme se s Hosty."
    },
    {
      "id": 110504456628543494,
      "target": "Gasmask: Teď si odvedeme dva, ale brzy všechny přivedeme zpátky."
    },
    {
      "id": 110504456628543493,
      "target": "Gasmask: Děkuji, že jste mě vyslechli."
    },
    {
      "id": 110504456628543492,
      "target": "Gasmask: Ano, to pomůže."
    },
    {
      "id": 110504456628543491,
      "target": "Ne. Už toho mám dost"
    },
    {
      "id": 110504456628543490,
      "target": "Dobře. Jestli to pomůže…"
    },
    {
      "id": 110504456628543489,
      "target": "Gasmask: Brzy se všechno spraví."
    },
    {
      "id": 110504456628543488,
      "target": "Gasmask: Je jedno koho, jen nám rychle někoho dejte."
    },
    {
      "id": 110504456624349196,
      "target": "Gasmask: Ale tentokrát potřebujeme dva."
    },
    {
      "id": 110504456624349195,
      "target": "Gasmask: Ano."
    },
    {
      "id": 110504456624349194,
      "target": "Ne. Už toho mám dost"
    },
    {
      "id": 110504456624349193,
      "target": "Dobře. Jestli to pomůže…"
    },
    {
      "id": 110504456624349192,
      "target": "Gasmask: Urychlí to naši práci. Tak to bude lepší."
    }
  ]
}
