      "target": "Daughter: JÁ SE HRO-O-O-OZNĚ BOJÍÍÍÍÍM."
    },
    {
      "id": 110504456330747914,
      "target": "Daughter: ÁÁÁÁÁÁÁÁÁÁÁÁ."
    },
    {
      "id": 110504456330747913,
      "target": "Daughter: Áááááááááá."
    },
    {
      "id": 110504456330747912,
      "target": "Daughter: Kam já půjdu-u-u-uuuu?"
    },
    {
      "id": 110504456330747911,
      "target": "Daughter: Já se bo-o-ojím."
    },
    {
      "id": 110504456330747910,
      "target": "Daughter: Po-pomůžete mi?"
    },
    {
      "id": 110504456330747907,
      "target": "Daughter: Když jsem u-u-utíkala, oni se jen smáli."
    },
    {
      "id": 110504456330747906,
      "target": "Daughter: A pak něco u-udělali a potom za-zapálili dům."
    },
    {
      "id": 110504456330747905,
      "target": "Daughter: Oni si klidně se-seděli s tátou v kuchyni."
    },
    {
      "id": 110504456330747904,
      "target": "Daughter: Já ne-nevím."
    },
    {
      "id": 110504456326553623,
      "target": "Daughter: Náš dům te-teď ho-hoříííí!"
    },
    {
      "id": 110504456326553622,
      "target": "Daughter: Áááááááááá-cháááááá."
    },
    {
      "id": 110504456326553621,
      "target": "Daughter: Táta s nimi o něčem m-m-mluvil. A pak ho zabili."
    },
    {
      "id": 110504456326553620,
      "target": "Daughter: Přišli k nám Ho-o-osté. Se-seděli u nás."
    },
    {
      "id": 110504456326553619,
      "target": "Proč to udělali?"
    },
    {
      "id": 110504456326553618,
      "target": "Kdo to udělal?"
    },
    {
      "id": 110504456326553617,
      "target": "Daughter: Zabili ta-ta-tátu."
    },
    {
      "id": 110504456326553616,
      "target": "Daughter: Á-á-á-á-chá-á-á-á-ach."
    },
    {
      "id": 110504456326553615,
      "target": "Daughter: Mo-mojeho tá-tá…"
