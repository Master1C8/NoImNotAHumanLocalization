    {
      "id": 110504456280416266,
      "target": "Widow: Potřebuju si jen odpočinout."
    },
    {
      "id": 110504456280416265,
      "target": "Widow: Nemyslím, že zůstanu dlouho."
    },
    {
      "id": 110504456280416262,
      "target": "Widow: Všem to přece nebylo jedno."
    },
    {
      "id": 110504456280416261,
      "target": "Widow: Mohl být naživu, kdyby…"
    },
    {
      "id": 110504456280416260,
      "target": "Widow: Teď je mrtvý."
    },
    {
      "id": 110504456280416259,
      "target": "Widow: Teď už ne. Když bylo třeba, nikdo nepomohl."
    },
    {
      "id": 110504456280416256,
      "target": "Widow: Teď ho nemůžu pořádně pohřbít. Pouštět ho teď nemá smysl."
    },
    {
      "id": 110504456276221961,
      "target": "Widow: Zemřel."
    },
    {
      "id": 110504456276221960,
      "target": "Widow: To je můj muž."
    },
    {
      "id": 110504456276221959,
      "target": "Potřebuje tvůj přítel pomoc?"
    },
    {
      "id": 110504456276221958,
      "target": "Je tvému parťákovi špatně?"
    },
    {
      "id": 110504456276221957,
      "target": "Widow: Už je mi jedno, kde skončím."
    },
    {
      "id": 110504456276221956,
      "target": "Widow: Já… já chci jen někde padnout a už nevstát."
    },
    {
      "id": 110504456276221955,
      "target": "Potřebuje tvůj přítel pomoc?"
    },
    {
      "id": 110504456276221954,
      "target": "Je tvému parťákovi špatně?"
    },
    {
      "id": 110504456276221953,
      "target": "Widow: Jsem strašně unavená. Jestli si neodpočinu, prostě padnu pod tvými okny."
    },
    {
      "id": 110504456276221952,
      "target": "Widow: Už si nevzpomínám. Stejně je jedno, odkud."
    },
    {
      "id": 110504456272027658,
      "target": "A kam půjdeš dál?"
    },
    {
      "id": 110504456272027657,
      "target": "Odkud jsi přišla?"
    },
    {
      "id": 110504456272027656,
      "target": "Widow: Můžu si u tebe odpočinout?"
