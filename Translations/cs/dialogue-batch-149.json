  "entries": [
    {
      "id": 110504456032952322,
      "target": "..."
    },
    {
      "id": 110504456032952321,
      "target": "Mám strach"
    },
    {
      "id": 110504456032952320,
      "target": "Je tu někdo?"
    },
    {
      "id": 110504456028758026,
      "target": "..."
    },
    {
      "id": 110504456028758025,
      "target": "Můžu se podívat na film?"
    },
    {
      "id": 110504456028758024,
      "target": "Bude tu ještě někdo?"
    },
    {
      "id": 110504456028758023,
      "target": "..."
    },
    {
      "id": 110504456028758022,
      "target": "Můžu se podívat na film?"
    },
    {
      "id": 110504456028758021,
      "target": "Bude tu ještě někdo?"
    },
    {
      "id": 110504456028758020,
      "target": "..."
    },
    {
      "id": 110504456028758019,
      "target": "Budu tu navždy?"
    },
    {
      "id": 110504456028758018,
      "target": "Zemřel jsem?"
    },
    {
      "id": 110504456028758017,
      "target": "..."
    },
    {
      "id": 110504456028758016,
      "target": "Užívej si to."
    },
    {
      "id": 110504456024563722,
      "target": "Budou se zdát velké, zaprášené a poseté kompromisy."
    },
    {
      "id": 110504456024563721,
      "target": "S jejími krátkými cestami, které se ti pak budou zdát podivně široké."
    },
    {
      "id": 110504456024563720,
      "target": "Tohle je tvé místo."
    },
    {
      "id": 110504456024563719,
      "target": "Tohle jsi přece chtěl, ne?"
    },
    {
      "id": 110504456024563718,
      "target": "Odvedu tě do noci, kde borovice dosáhne až ke hvězdě."
    },
    {
      "id": 110504456024563717,
      "target": "Vím, že jsi připravený."
    },
    {
      "id": 110504456024563716,
      "target": "Je dobře, že teď už ve tmě nezůstává převlečený člověk ani nic jiného. Jen stín na mé cihle."
    },
    {
      "id": 110504456024563715,
      "target": "Nemusíš se bát. Čas je mým dílem. Tady se nemáš čeho bát."
    },
    {
      "id": 110504456024563714,
      "target": "Do smutných končin, jejichž epigrafem jsou zrcadla vytvářející zdání hojnosti."
    },
    {
      "id": 110504456024563713,
      "target": "Tam musíš jít."
    },
    {
      "id": 110504456024563712,
      "target": "Jsi unavený."
    },
    {
      "id": 110504456020369419,
      "target": "Ne, k nim nechceš."
    },
    {
      "id": 110504456020369418,
      "target": "K těm, jejichž oči vyryly stopu do srdce?"
    },
    {
      "id": 110504456020369417,
      "target": "Kam chceš jít?"
    },
    {
      "id": 110504456020369416,
      "target": "Tak maličké království pohltilo tolik spánku."
    },
    {
      "id": 110504456020369415,
      "target": "Samozřejmě."
    },
    {
      "id": 110504456020369414,
      "target": "Bojím se pokračovat"
    },
    {
      "id": 110504456020369413,
      "target": "Dá se odtud… jít dál?"
    },
    {
      "id": 110504456020369412,
      "target": "Jsem neuznaný bratr, vyvrhel z rodiny lidí."
    },
    {
      "id": 110504456020369411,
      "target": "V něčem jsme si podobní."
    },
    {
      "id": 110504456020369410,
      "target": "Možná jsme se oba unavili a ulehli ke spánku."
    },
    {
      "id": 110504456020369409,
      "target": "Co znamená „zemřít“?"
    },
    {
      "id": 110504456020369408,
      "target": "Zemřel jsem?"
    },
    {
      "id": 110504456016175115,
      "target": "Bojím se pokračovat"
    },
    {
      "id": 110504456016175114,
      "target": "Dá se odtud… jít dál?"
    },
    {
      "id": 110504456016175113,
      "target": "„Bojím se.“"
    }
  ]
}
