  "entries": [
    {
      "id": 110504454405562369,
      "target": "Widow: Proč tohle děláš?"
    },
    {
      "id": 110504454405562368,
      "target": "Widow: Jasně, a já teď mám přežívat sama."
    },
    {
      "id": 110504454401368071,
      "target": "Widow: A zemřel."
    },
    {
      "id": 110504454401368070,
      "target": "Widow: …"
    },
    {
      "id": 110504454401368069,
      "target": "Widow: Říkal, že všechno bude v pořádku."
    },
    {
      "id": 110504454401368068,
      "target": "Widow: Vždyť slíbil, že všechno bude v pořádku."
    },
    {
      "id": 110504454401368067,
      "target": "Widow: Proč jsi zemřel?"
    },
    {
      "id": 110504454401368066,
      "target": "Widow: …"
    },
    {
      "id": 110504454401368065,
      "target": "Mám tu s tebou posedět?"
    },
    {
      "id": 110504454401368064,
      "target": "Teď tě tu nechám"
    },
    {
      "id": 110504454397173767,
      "target": "Widow: Chci tu posedět."
    },
    {
      "id": 110504454397173766,
      "target": "Widow: Já tady…"
    },
    {
      "id": 110504454397173765,
      "target": "Widow: Nemám hlad."
    },
    {
      "id": 110504454397173764,
      "target": "Mám tu s tebou posedět?"
    },
    {
      "id": 110504454397173763,
      "target": "Teď tě tu nechám"
    },
    {
      "id": 110504454397173762,
      "target": "Widow: Napiju se, když budu potřebovat."
    },
    {
      "id": 110504454397173761,
      "target": "Widow: Sedím u kohoutku."
    },
    {
      "id": 110504454397173760,
      "target": "Widow: Já tady…"
    },
    {
      "id": 110504454392979464,
      "target": "Mám ti dát něco k jídlu?"
    },
    {
      "id": 110504454392979463,
      "target": "Mám ti přinést vodu?"
    },
    {
      "id": 110504454392979462,
      "target": "Widow: Už nic nepotřebuju."
    },
    {
      "id": 110504454392979461,
      "target": "Widow: Já vlastně…"
    },
    {
      "id": 110504454392979460,
      "target": "Widow: Aby byl naživu."
    },
    {
      "id": 110504454392979459,
      "target": "Widow: …"
    },
    {
      "id": 110504454392979457,
      "target": "Potřebuješ něco?"
    },
    {
      "id": 110504454392979456,
      "target": "Widow: Chtěla bych si trochu odpočinout…"
    },
    {
      "id": 110504454388785163,
      "target": "Esenin: Proč jsem sem přišel?.."
    },
    {
      "id": 110504454388785162,
      "target": "Esenin: Prostě to nezvládám."
    },
    {
      "id": 110504454388785161,
      "target": "Esenin: To je celý v prdeli. Všechno mě děsí k posrání."
    },
    {
      "id": 110504454388785160,
      "target": "Esenin: Domácí, já chci jen, aby to všechno skončilo."
    },
    {
      "id": 110504454388785159,
      "target": "Esenin: Je mi u tebe těsno. Vlastně je mi těsno na celé téhle planetě."
    },
    {
      "id": 110504454388785158,
      "target": "Esenin: Tam bych se mohl oběsit."
    },
    {
      "id": 110504454388785157,
      "target": "Esenin: V hospodě byl aspoň vysoký strop."
    },
    {
      "id": 110504454388785155,
      "target": "Jsi… v pořádku?"
    },
    {
      "id": 110504454388785154,
      "target": "Esenin: Ano? Něco jsi chtěl?"
    },
    {
      "id": 110504454388785153,
      "target": "Esenin: Já… chci být sám."
    },
    {
      "id": 110504454388785152,
      "target": "Esenin: Prázdný prostor nekonečné temnoty. Pokud se tam po smrti dostaneme, je to totéž jako zmizet…"
    },
    {
      "id": 110504454384590859,
      "target": "Esenin: Asi kdyby tam něco bylo, zachytili bychom už nějaký signál nebo něco takového. Nevím."
    }
  ]
}
