  "entries": [
    {
      "id": 110504457425461251,
      "target": "Leper: Dobře, jak chceš. Já jdu."
    },
    {
      "id": 110504457425461250,
      "target": "Leper: Díky, že jsi mě pustil dovnitř a nesoudil podle vzhledu."
    },
    {
      "id": 110504457421266954,
      "target": "Leper: Tak mě teda nakonec pustíš, nebo ne?"
    },
    {
      "id": 110504457421266953,
      "target": "Leper: …"
    },
    {
      "id": 110504457421266952,
      "target": "Leper: Protože vím, že je to pravda. Nejsem přece Host."
    },
    {
      "id": 110504457421266949,
      "target": "Leper: Tak mě teda nakonec pustíš, nebo ne?"
    },
    {
      "id": 110504457421266948,
      "target": "Leper: …"
    },
    {
      "id": 110504457421266947,
      "target": "Leper: Jak chceš."
    },
    {
      "id": 110504457421266946,
      "target": "Odkud bereš tu jistotu?"
    },
    {
      "id": 110504457421266945,
      "target": "To ještě prověříme"
    },
    {
      "id": 110504457421266944,
      "target": "Leper: Já nejsem Host, víš."
    },
    {
      "id": 110504457417072650,
      "target": "Leper: Co znamená „co jsem čekal“? Myslíš, že jsem si vybral, že se takhle narodím?"
    },
    {
      "id": 110504457417072649,
      "target": "Odkud bereš tu jistotu?"
    },
    {
      "id": 110504457417072648,
      "target": "To ještě prověříme"
    },
    {
      "id": 110504457417072647,
      "target": "Leper: Chápu, ale nejsem Host."
    },
    {
      "id": 110504457417072646,
      "target": "A co jsi s takovým vzhledem čekal?"
    },
    {
      "id": 110504457417072645,
      "target": "Teď jsou všichni paranoidní"
    },
    {
      "id": 110504457417072644,
      "target": "Leper: Mám to od narození a nic s tím nenadělám. A všichni si z nějakého důvodu myslí, že jsem Host. To je přece nesmysl."
    },
    {
      "id": 110504457417072643,
      "target": "Leper: Přesně o tom mluvím."
    },
    {
      "id": 110504457417072641,
      "target": "A co jsi s takovým vzhledem čekal?"
    },
    {
      "id": 110504457417072640,
      "target": "Teď jsou všichni paranoidní"
    },
    {
      "id": 110504457412878346,
      "target": "Leper: Teď mě mají za nějakého malomocného. Prý jsem Host."
    },
    {
      "id": 110504457412878345,
      "target": "Leper: Stačilo se narodit s kožními vadami a už je to tady…"
    },
    {
      "id": 110504457412878344,
      "target": "Leper: Právě že nic."
    },
    {
      "id": 110504457412878343,
      "target": "Odkud to máš na kůži?"
    },
    {
      "id": 110504457412878342,
      "target": "A co je s tebou?"
    },
    {
      "id": 110504457412878341,
      "target": "Leper: Ahoj. Doufám, že ti můj vzhled nebude vadit a pustíš mě dovnitř?"
    }
  ]
}
