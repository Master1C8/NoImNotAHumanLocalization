    },
    {
      "id": 110504454766272518,
      "target": "Buddy: No jo, jak chceš! Nech si svá tajemství!"
    },
    {
      "id": 110504454766272517,
      "target": "Buddy: Kde jsi ho sehnal? Určitě máš někoho z rodiny v pivovaru, co?"
    },
    {
      "id": 110504454766272516,
      "target": "Buddy: Podíval jsem se ti do ledničky. Sakra, kdybych věděl, že máš TOLIK PIVA…"
    },
    {
      "id": 110504454766272515,
      "target": "Buddy: Paráda, kámo!"
    },
