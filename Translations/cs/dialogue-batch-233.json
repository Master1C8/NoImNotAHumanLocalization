    },
    {
      "id": 110504454762078219,
      "target": "Bestson: Díky, žes mě přivedl k rozumu. Musím jít."
    },
    {
      "id": 110504454762078218,
      "target": "Bestson: Asi bych to měl zkusit."
    },
    {
      "id": 110504454762078217,
      "target": "Bestson: Možná tam opravdu jsou."
