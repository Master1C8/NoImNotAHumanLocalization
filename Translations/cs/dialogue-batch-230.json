  "entries": [
    {
      "id": 110504454816604163,
      "target": "Fatman: Dobře, zapomeň na to."
    },
    {
      "id": 110504454816604162,
      "target": "Fatman: …"
    },
    {
      "id": 110504454816604161,
      "target": "Fatman: Ty nemáš cigarety?"
    },
    {
      "id": 110504454816604160,
      "target": "Ano, vezmi si je (dát cigarety)"
    },
    {
      "id": 110504454812409867,
      "target": "Fatman: Jsem rád, že se ptáš! Rád bych si zakouřil. Nemáš jednu cigaretu navíc?"
    },
    {
      "id": 110504454812409865,
      "target": "Co ještě potřebuješ?"
    },
    {
      "id": 110504454812409864,
      "target": "Fatman: Vodička… V koupelně to máš pěkné"
    },
    {
      "id": 110504454812409863,
      "target": "Fatman: Dobře, zapomeň na to. Když nechceš pomoct, tak nepomáhej!"
    },
    {
      "id": 110504454812409862,
      "target": "Fatman: …"
    },
    {
      "id": 110504454812409861,
      "target": "Fatman: Peníze vládnou světu, synku! A já jsem navíc velmi důležitý člověk – ministr!"
    },
    {
      "id": 110504454812409860,
      "target": "Fatman: Jak to myslíš, že ne? Myslíš, že tě nejde uplatit? Koupit se dá všechno: láska, věci, lidé…"
    },
    {
      "id": 110504454812409859,
      "target": "Fatman: Nevím, kdo tuhle břečku vůbec pije, ale vezmi si ji. Třeba se ti bude hodit."
    },
    {
      "id": 110504454812409858,
      "target": "Fatman: (Dostanete Kombuchu.)"
    },
    {
      "id": 110504454812409857,
      "target": "Fatman: Tady, vezmi si!"
    },
    {
      "id": 110504454812409856,
      "target": "Fatman: Vždyť každý potřebuje peníze! Na penězích stojí celý svět. Že prý bankovky nechce…"
    },
    {
      "id": 110504454808215562,
      "target": "Fatman: …"
    },
    {
      "id": 110504454808215561,
      "target": "Fatman: Jak to myslíš, že je nepotřebuješ? Ty jsi snad nějaký zvláštní!?"
    },
    {
      "id": 110504454808215560,
      "target": "Fatman: Nevím, kdo tuhle břečku vůbec pije, ale vezmi si ji. Třeba se ti bude hodit."
    },
    {
      "id": 110504454808215559,
      "target": "Fatman: (Dostanete Kombuchu.)"
    },
    {
      "id": 110504454808215558,
      "target": "Fatman: A mimochodem. Tady máš."
    },
    {
      "id": 110504454808215557,
      "target": "Fatman: Na lidech, kteří mi pomáhají, peníze šetřit nebudu."
    },
    {
      "id": 110504454808215556,
      "target": "Fatman: Dávej mi všechno, o co požádám, a vyděláš si jako ředitel továrny."
    },
    {
      "id": 110504454808215555,
      "target": "Fatman: Tak je to správně!"
    },
    {
      "id": 110504454808215554,
      "target": "Tvoje peníze nepotřebuju"
    },
    {
      "id": 110504454808215553,
      "target": "No… Díky"
    },
    {
      "id": 110504454808215552,
      "target": "Fatman: (Dostanete pomačkané bankovky, které jsou vám v této situaci k ničemu.)"
    },
    {
      "id": 110504454804021259,
      "target": "Fatman: Tady máš trochu peněz."
    },
    {
      "id": 110504454804021258,
      "target": "Fatman: Mmm, to je dobrota. Moje oblíbené."
    },
    {
      "id": 110504454804021257,
      "target": "Fatman: …"
    },
    {
      "id": 110504454804021256,
      "target": "Fatman: Óóó, to je přesně ono!"
    },
    {
      "id": 110504454804021254,
      "target": "Fatman: Co to meleš? Viděl jsem, že jsi měl v lednici spoustu piva. Jak jsi ho mohl tak rychle vypít?"
    },
    {
      "id": 110504454804021253,
      "target": "Fatman: …"
    },
    {
      "id": 110504454804021252,
      "target": "Fatman: Ty nemáš pivo?"
    },
    {
      "id": 110504454804021251,
      "target": "Můžu ti dát pivo (dát plechovku piva)"
    },
    {
      "id": 110504454804021250,
      "target": "Fatman: Víš, nějak jsem vyhládl. Nedal bys mi něco k zakousnutí?"
    },
    {
      "id": 110504454804021249,
      "target": "Fatman: Ačkoli…"
    },
    {
      "id": 110504454804021248,
      "target": "Fatman: …"
    }
  ]
}
