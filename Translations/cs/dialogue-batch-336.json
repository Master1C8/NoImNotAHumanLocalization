  "entries": [
    {
      "id": 110504452887224323,
      "target": "Sirin: Jak brzy se to stane?"
    },
    {
      "id": 110504452887224322,
      "target": "Sirin: Hosti? Kataklyzmata? My navzájem?"
    },
    {
      "id": 110504452887224321,
      "target": "Sirin: Co myslíš, co nás zabije?"
    },
    {
      "id": 110504452887224320,
      "target": "Sirin: Vždycky to jde udělat jednodušeji…"
    },
    {
      "id": 110504452883030025,
      "target": "Sirin: Hosti na tebe přece neskočí, když na ně zamíříš. Neprozradí se."
    },
    {
      "id": 110504452883030024,
      "target": "Sirin: Proč kontroluješ, míříš, ale nestřílíš?"
    },
    {
      "id": 110504452883030021,
      "target": "Sirin: Prostě udělej, co musíš."
    },
    {
      "id": 110504452883030020,
      "target": "Sirin: Neotálej."
    },
    {
      "id": 110504452883030017,
      "target": "Sirin: A ten obrázek taky spal."
    },
    {
      "id": 110504452878835719,
      "target": "Sirin: Pořád je jí nepříjemné na ně vzpomínat."
    },
    {
      "id": 110504452878835718,
      "target": "Sirin: I já bych se jí měla zbavit."
    },
    {
      "id": 110504452878835717,
      "target": "Sirin: A sestra si tu svou sundala."
    },
    {
      "id": 110504452878835716,
      "target": "Sirin: ..."
    },
    {
      "id": 110504452878835715,
      "target": "Sirin: Připomínka rodičů."
    },
    {
      "id": 110504452878835714,
      "target": "Sirin: Zůstala mi jedna náušnice."
    },
    {
      "id": 110504452874641412,
      "target": "Sirin: A jak by se mělo?"
    },
    {
      "id": 110504452874641411,
      "target": "Sirin: ..."
    },
    {
      "id": 110504452874641410,
      "target": "Sirin: Dělej, co pokládáš za správné."
    },
    {
      "id": 110504452874641409,
      "target": "Sirin: Je mi jedno, jestli potom něco zůstane."
    }
  ]
}
