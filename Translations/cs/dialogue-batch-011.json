  "entries": [
    {
      "id": 110504457828114432,
      "target": "Toto číslo mi dala vaše žena"
    },
    {
      "id": 110504457823920139,
      "target": "Vaše žena a její sestra jsou u mě doma"
    },
    {
      "id": 110504457823920138,
      "target": "Phone: Ano? Kdo volá?"
    },
    {
      "id": 110504457823920137,
      "target": "Phone: Na shledanou."
    },
    {
      "id": 110504457823920136,
      "target": "Phone: A… děkuju vám, že jste mu pomohl."
    },
    {
      "id": 110504457823920135,
      "target": "Phone: Ráda se bratra ujmu. Vyřiďte mu to. Zná mou adresu."
    },
    {
      "id": 110504457823920134,
      "target": "Phone: …"
    },
    {
      "id": 110504457823920133,
      "target": "Phone: Bože… jak se to stalo?…"
    },
    {
      "id": 110504457823920132,
      "target": "Phone: …"
    },
    {
      "id": 110504457823920130,
      "target": "Nejspíš"
    },
    {
      "id": 110504457823920129,
      "target": "Nevím"
    },
    {
      "id": 110504457823920128,
      "target": "Phone: Sakra… to není možné… Jsou mrtví?"
    },
    {
      "id": 110504457819725835,
      "target": "Phone: …"
    },
    {
      "id": 110504457819725834,
      "target": "Phone: Snad nejsou…"
    },
    {
      "id": 110504457819725833,
      "target": "Phone: Hledal útočiště? Ale vždyť bydlí s rodiči, ne?"
    },
    {
      "id": 110504457819725831,
      "target": "Nejspíš"
    },
    {
      "id": 110504457819725830,
      "target": "Nevím"
    },
    {
      "id": 110504457819725829,
      "target": "Phone: Sakra… to není možné… Jsou mrtví?"
    },
    {
      "id": 110504457819725828,
      "target": "Phone: …"
    },
    {
      "id": 110504457819725827,
      "target": "Phone: To mi přece nechcete říct, že…"
    },
    {
      "id": 110504457819725826,
      "target": "Phone: Zmizeli? Jak se to stalo?"
    },
    {
      "id": 110504457819725825,
      "target": "Přišel ke mně hledat útočiště"
    },
    {
      "id": 110504457819725824,
      "target": "Jeho rodiče zmizeli"
    },
    {
      "id": 110504457815531532,
      "target": "Phone: Ale počkejte… kdo vlastně jste? A proč je u vás?"
    },
    {
      "id": 110504457815531531,
      "target": "Phone: Ach, mluvíte o pokrevním bratrovi, že?"
    },
    {
      "id": 110504457815531530,
      "target": "Phone: …"
    },
    {
      "id": 110504457815531529,
      "target": "Phone: Jaký bratr? Já žádného…"
    },
    {
      "id": 110504457815531528,
      "target": "Můžete svému bratrovi pomoct?"
    }
  ]
}
