  "entries": [
    {
      "id": 110504452123860996,
      "target": "Sirin: Jak je krásná!"
    },
    {
      "id": 110504452123860995,
      "target": "Sirin: Ale byla určena tobě!"
    },
    {
      "id": 110504452123860994,
      "target": "Sirin: Má píseň."
    },
    {
      "id": 110504452123860993,
      "target": "Sirin: Tak tedy počkám, až přijde má chvíle."
    },
    {
      "id": 110504452123860992,
      "target": "Sirin: Na tom nezáleží."
    },
    {
      "id": 110504452119666698,
      "target": "Sirin: Věčná agonie a očekávání smrti."
    },
    {
      "id": 110504452119666697,
      "target": "Sirin: A nikdy se nedočkáme svého konce."
    },
    {
      "id": 110504452119666696,
      "target": "Sirin: Horizont událostí nás bude pohlcovat velmi dlouho."
    },
    {
      "id": 110504452119666695,
      "target": "Sirin: Co když se jen připravujeme na to, že nás pohltí černá díra?"
    },
    {
      "id": 110504452119666694,
      "target": "Sirin: Možná příště."
    },
    {
      "id": 110504452119666693,
      "target": "Sirin: Nesplňovala ty znaky."
    },
    {
      "id": 110504452119666692,
      "target": "Sirin: Škoda."
    },
    {
      "id": 110504452119666691,
      "target": "Sirin: Možná příště."
    },
    {
      "id": 110504452119666690,
      "target": "Sirin: Škoda."
    },
    {
      "id": 110504452119666689,
      "target": "Sirin: Stejně zemřeš."
    },
    {
      "id": 110504452119666688,
      "target": "Sirin: ..."
    },
    {
      "id": 110504452115472395,
      "target": "Sirin: Nenašel jsi odvahu?"
    },
    {
      "id": 110504452115472392,
      "target": "Sirin: Stiskneš to vytoužené tlačítko?"
    },
    {
      "id": 110504452115472391,
      "target": "Sirin: Tak co?"
    },
    {
      "id": 110504452115472388,
      "target": "Sirin: Líbí se ti to?"
    },
    {
      "id": 110504452115472387,
      "target": "Sirin: Jen přejde na tebe."
    },
    {
      "id": 110504452115472386,
      "target": "Sirin: Až zavřu oči, prázdnota nezmizí."
    },
    {
      "id": 110504452111278091,
      "target": "Sirin: Udělám to sama."
    },
    {
      "id": 110504452111278090,
      "target": "Sirin: Dej mi pušku."
    },
    {
      "id": 110504452111278089,
      "target": "Sirin: Můžeš to prostě nechat na mně."
    },
    {
      "id": 110504452111278088,
      "target": "Sirin: Smrt už je stejně blízko."
    },
    {
      "id": 110504452111278087,
      "target": "Sirin: Nedělej to."
    },
    {
      "id": 110504452111278084,
      "target": "Sirin: Vyraž ze mě duši."
    },
    {
      "id": 110504452111278083,
      "target": "Sirin: Takhle to bude dokonce lepší."
    },
    {
      "id": 110504452111278080,
      "target": "Sirin: Zřejmě jsem to nedělala zbytečně."
    },
    {
      "id": 110504452107083786,
      "target": "Sirin: Podpaží mi holí sestra. Stará se o mě."
    },
    {
      "id": 110504452107083783,
      "target": "Sirin: Ale ona si nepřipouští prázdnotu v očích."
    },
    {
      "id": 110504452107083782,
      "target": "Sirin: V tom jsme si se sestrou podobné."
    },
    {
      "id": 110504452107083779,
      "target": "Sirin: Nechala mě zemřít už tehdy."
    },
    {
      "id": 110504452107083778,
      "target": "Sirin: Kéž by…"
    },
    {
      "id": 110504452107083777,
      "target": "Sirin: Ale nemá to smysl."
    },
    {
      "id": 110504452107083776,
      "target": "Sirin: Sestra mi pomáhá."
    },
    {
      "id": 110504452102889481,
      "target": "Sirin: Vyrazíš mi je?"
    },
    {
      "id": 110504452102889480,
      "target": "Sirin: Podívej se."
    },
    {
      "id": 110504452102889473,
      "target": "Sirin: Tak už to udělej."
    }
  ]
}
