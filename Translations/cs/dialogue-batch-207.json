  "entries": [
    {
      "id": 110504455139565576,
      "target": "Greatmother: Chceš, aby shořel."
    },
    {
      "id": 110504455139565575,
      "target": "Greatmother: Ne, přenech tenhle dům nám. Vždyť ho sám nenávidíš."
    },
    {
      "id": 110504455139565568,
      "target": "Greatmother: Je prostorný a pěkný. Místa je tu pro všechny dost."
    },
    {
      "id": 110504455135371276,
      "target": "Greatmother: Dětičky, plazte se sem, jsem tady. Plazte se sem, našla jsem nový domov."
    },
    {
      "id": 110504455135371269,
      "target": "Greatmother: Pojďte sem, tenhle dům se nám hodí."
    },
    {
      "id": 110504455135371268,
      "target": "Greatmother: Matka chce vidět své dětičky."
    },
    {
      "id": 110504455131176970,
      "target": "Greatmother: Plazte se sem, jemu už tenhle dům nebude k ničemu."
    },
    {
      "id": 110504455131176969,
      "target": "Greatmother: Dětičky, našel se nový domov. Konečně si pořádně odpočineme."
    },
    {
      "id": 110504455131176968,
      "target": "Greatmother: Přijdou si pro tebe!"
    },
    {
      "id": 110504455131176967,
      "target": "Greatmother: Ubohý spratku…"
    },
    {
      "id": 110504455131176966,
      "target": "(Zabít ji)"
    },
    {
      "id": 110504455131176965,
      "target": "Jsi Host?"
    },
    {
      "id": 110504455131176964,
      "target": "Kdo jsi?"
    },
    {
      "id": 110504455131176963,
      "target": "Co to má všechno znamenat?"
    },
    {
      "id": 110504455131176962,
      "target": "Greatmother: Slyším je, plazí se. Už jen chvilku."
    },
    {
      "id": 110504455131176961,
      "target": "Greatmother: …"
    },
    {
      "id": 110504455131176960,
      "target": "Greatmother: Dům je velký a lidí málo. Bude tu místo pro všechny."
    },
    {
      "id": 110504455126982668,
      "target": "Greatmother: Tvůj dům je dobré místo. Výjimečné."
    },
    {
      "id": 110504455126982667,
      "target": "(Zabít ji)"
    },
    {
      "id": 110504455126982666,
      "target": "Jsi Host?"
    },
    {
      "id": 110504455126982665,
      "target": "Kdo jsi?"
    },
    {
      "id": 110504455126982664,
      "target": "Co to má všechno znamenat?"
    }
  ]
