  "entries": [
    {
      "id": 110504456708235275,
      "target": "Cold: No jo. Náboje potřebuješ sám. Měj se."
    },
    {
      "id": 110504456708235274,
      "target": "Cold: …"
    },
    {
      "id": 110504456708235273,
      "target": "Cold: Mohl bys na mě vystřelit?"
    },
    {
      "id": 110504456708235272,
      "target": "Cold: Vidím, že máš na rukou spoustu stop po střelném prachu."
    },
    {
      "id": 110504456708235271,
      "target": "Cold: Dobře, měj se."
    },
    {
      "id": 110504456708235270,
      "target": "Cold: Chápu."
    },
    {
      "id": 110504456708235269,
      "target": "Cold: Máte to tu trochu nízké. Ale mně to bude stačit."
    },
    {
      "id": 110504456708235268,
      "target": "Cold: Děkuju."
    },
    {
      "id": 110504456708235265,
      "target": "Cold: Prostě půjdu dál. Nebudu žebrat ani obtěžovat."
    },
    {
      "id": 110504456708235264,
      "target": "Cold: Nemusíš mě pouštět dovnitř."
    },
    {
      "id": 110504456704040971,
      "target": "Cold: Ne."
    },
    {
      "id": 110504456704040968,
      "target": "Cold: Co když budu trpět ještě víc? A ani na to nedokážu umřít?"
    },
    {
      "id": 110504456704040967,
      "target": "Cold: Bojím se svléknout."
    },
    {
      "id": 110504456704040966,
      "target": "Cold: Zatímco někteří venku hoří, já se balím do bund a pořád je mi zima."
    },
    {
      "id": 110504456704040965,
      "target": "Cold: Je mi zima pořád."
    },
    {
      "id": 110504456704040964,
      "target": "Sundej si bundu."
    },
    {
      "id": 110504456704040963,
      "target": "Nebojíš se horka?"
    },
    {
      "id": 110504456704040962,
      "target": "Cold: Proto… dlouho."
    },
    {
      "id": 110504456704040961,
      "target": "Cold: Mně se nic takového nikdy nestalo."
    },
    {
      "id": 110504456704040960,
      "target": "Cold: …"
    },
    {
      "id": 110504456699846668,
      "target": "Sundej si bundu."
    },
    {
      "id": 110504456699846667,
      "target": "Nebojíš se horka?"
    },
    {
      "id": 110504456699846666,
      "target": "Cold: Později. Zatím si nejsem jistý."
    },
    {
      "id": 110504456699846665,
      "target": "Cold: Ne, nejsem Host. Ale o něco bych tě chtěl poprosit."
    },
    {
      "id": 110504456699846664,
      "target": "Cold: Na tom už nezáleží. Ptáš se přece, jestli jsem Host?"
    },
    {
      "id": 110504456699846663,
      "target": "Jak dlouho už hledáš klidné místo?"
    },
    {
      "id": 110504456699846662,
      "target": "Kdo jsi?"
    },
    {
      "id": 110504456699846661,
      "target": "Cold: Najdu u tebe klid?"
    },
    {
      "id": 110504456699846660,
      "target": "Cold: Rovnou říkám, že horka se nebojím. Přesto hledám klidné místo."
    },
    {
      "id": 110504456699846659,
      "target": "Cold: Ahoj."
    }
  ]
}
