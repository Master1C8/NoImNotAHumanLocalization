  "entries": [
    {
      "id": 110504455659659269,
      "target": "Ballerina: Ty při výstřelu zavíráš oči, nebo co?"
    },
    {
      "id": 110504455659659268,
      "target": "Ballerina: Minul jsi! Vždyť stojím blízko."
    },
    {
      "id": 110504455659659267,
      "target": "Ballerina: Hop!"
    },
    {
      "id": 110504455655464971,
      "target": "Ballerina: Zkusíš to ještě jednou?"
    },
    {
      "id": 110504455655464970,
      "target": "Ballerina: Hop!"
    },
    {
      "id": 110504455655464967,
      "target": "Ballerina: MILUJU TANEC. Chceš, abych ti jeden předvedla? Jen vystřel."
    },
    {
      "id": 110504455655464966,
      "target": "Ballerina: AHAHAHAHAHA."
    },
    {
      "id": 110504455655464965,
      "target": "Ballerina: Ale ona stejně přijde."
    },
    {
      "id": 110504455655464964,
      "target": "Ballerina: …"
    },
    {
      "id": 110504455655464963,
      "target": "Ballerina: Aha, ne, vždyť jsem řekla, že čekám."
    },
    {
      "id": 110504455655464962,
      "target": "Ballerina: Jak myslíš. Mimochodem, já taky."
    },
    {
      "id": 110504455655464960,
      "target": "Já. Na nic. Nečekám."
    },
    {
      "id": 110504455651270667,
      "target": "Ballerina: Ty čekáš. Chceš přece vědět, co se stalo s tvými blízkými."
    },
    {
      "id": 110504455651270666,
      "target": "Ballerina: A co děláš ty? Sedíš tady zavřený mezi čtyřmi stěnami."
    },
    {
      "id": 110504455651270665,
      "target": "Ballerina: Aha."
    },
    {
      "id": 110504455651270663,
      "target": "Já. Na nic. Nečekám."
    },
    {
      "id": 110504455651270662,
      "target": "Ballerina: Teď jsi jako on."
    },
    {
      "id": 110504455651270661,
      "target": "Ballerina: Radši mi odpověz. Znám totiž jednoho, který rád ignoruje otázky."
    },
    {
      "id": 110504455651270660,
      "target": "Ballerina: Chválíš moji otázku? Proč?"
    },
    {
      "id": 110504455651270659,
      "target": "Na nic nečekám"
    },
    {
      "id": 110504455651270658,
      "target": "Dobrá otázka"
    },
    {
      "id": 110504455651270657,
      "target": "Player: Teď si pro mě přijdou..."
    },
    {
      "id": 110504455651270656,
      "target": "Player: ..."
    },
    {
      "id": 110504455647076364,
      "target": "Player: Ty ses rozhodl jim ji vrátit?"
    },
    {
      "id": 110504455647076363,
      "target": "Player: Dobře, vezmu si to..."
    },
    {
      "id": 110504455647076362,
      "target": "Player: ..."
    },
    {
      "id": 110504455647076361,
      "target": "Player: Co je to?"
    },
    {
      "id": 110504455647076360,
      "target": "Wolfhound: Jistě, jistě..."
    }
