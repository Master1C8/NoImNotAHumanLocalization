    {
      "id": 110504456762761222,
      "target": "SuperFake: A zatím…"
    },
    {
      "id": 110504456762761221,
      "target": "SuperFake: Ale určitě zmizíš."
    },
    {
      "id": 110504456762761220,
      "target": "SuperFake: Když ne dnes, tak zítra. Když ne zítra, tak později."
    },
    {
      "id": 110504456762761219,
      "target": "SuperFake: Zemřeš."
    },
    {
      "id": 110504456762761218,
      "target": "SuperFake: A výsledek je vždy stejný."
    },
    {
      "id": 110504456762761217,
      "target": "SuperFake: Něco změnit?"
    },
    {
      "id": 110504456762761216,
      "target": "SuperFake: Posílají mě jen za tebou, abych…"
    },
    {
      "id": 110504456758566923,
      "target": "SuperFake: Napadlo tě, že jsi byl vyvolen? Haha."
    },
    {
      "id": 110504456758566922,
      "target": "SuperFake: Ptáš se na to až teď?"
    },
    {
      "id": 110504456758566921,
      "target": "Proč hned nevykopneš dveře?"
    },
    {
      "id": 110504456758566920,
      "target": "Proč sem chodíš?"
    },
    {
      "id": 110504456758566919,
      "target": "SuperFake: Neboj se, pomůžeme."
    },
    {
      "id": 110504456758566918,
      "target": "SuperFake: Je legrační, že sám nic necítíš."
    },
    {
      "id": 110504456758566917,
      "target": "SuperFake: To ti neřeknu."
    },
    {
      "id": 110504456758566916,
      "target": "Proč hned nevykopneš dveře?"
    },
    {
      "id": 110504456758566915,
      "target": "Proč sem chodíš?"
    },
    {
      "id": 110504456758566914,
      "target": "SuperFake: Už vám šlape na paty."
    },
    {
      "id": 110504456758566913,
      "target": "SuperFake: A cítíš, jak se Smrt přibližuje čím dál víc?"
    },
    {
      "id": 110504456758566912,
      "target": "SuperFake: To je celé."
    },
    {
      "id": 110504456754372619,
      "target": "SuperFake: Jen se s tebou dělím o to, co mi řekli."
    },
    {
      "id": 110504456754372618,
      "target": "K jakému konci?"
    },
    {
      "id": 110504456754372617,
      "target": "O čem to mluvíš?"
    },
    {
      "id": 110504456754372616,
      "target": "SuperFake: Když ne my, poradíte si dál sami."
    },
    {
      "id": 110504456754372615,
      "target": "SuperFake: Celý tenhle příběh se chýlí ke konci."
    },
    {
      "id": 110504456754372614,
      "target": "SuperFake: Řekli mi, že se s tebou vidím naposledy."
    },
    {
      "id": 110504456754372613,
      "target": "SuperFake: Uvidíme se?"
    },
    {
      "id": 110504456754372612,
      "target": "SuperFake: No…"
    },
    {
      "id": 110504456754372611,
      "target": "SuperFake: Já tu vůli jen vykonávám."
    },
    {
      "id": 110504456754372610,
      "target": "SuperFake: Existují síly, které stojí nade mnou."
    },
    {
      "id": 110504456754372609,
      "target": "SuperFake: Přece si nemyslíš, že já jsem tady… nějaký šéf?"
    },
    {
      "id": 110504456754372608,
      "target": "SuperFake: Změny nejsou to nejděsivější, co tě čeká."
    },
    {
      "id": 110504456750178314,
      "target": "SuperFake: Ani mých lidí není tolik. Natož vás, zavřených ve vlastních domech."
    },
    {
      "id": 110504456750178313,
      "target": "SuperFake: No tohle."
    },
    {
      "id": 110504456750178312,
      "target": "SuperFake: Pojď se mnou."
    },
    {
      "id": 110504456750178311,
      "target": "SuperFake: Tak vidíš, naše nové pravidlo zabralo."
    },
    {
      "id": 110504456750178310,
      "target": "SuperFake: Hmm…"
    },
    {
      "id": 110504456750178309,
      "target": "Nejsem sám"
    },
    {
      "id": 110504456750178308,
      "target": "Jsem sám"
    },
    {
      "id": 110504456750178307,
      "target": "SuperFake: Jsi doma sám?"
    }
  ]
