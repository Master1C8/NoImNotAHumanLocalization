  "entries": [
    {
      "id": 110504455126982663,
      "target": "Greatmother: Slyším je: plazí se. Už jen chvilku."
    },
    {
      "id": 110504455126982662,
      "target": "Greatmother: …"
    },
    {
      "id": 110504455126982661,
      "target": "Greatmother: Máš spoustu těl. Spoustu chutného jídla. Mně a mé rodině se tu bude dobře žít."
    },
    {
      "id": 110504455126982660,
      "target": "Greatmother: Ti v kombinézách umějí docela dobře vařit. Jen to trochu přeženou s ohněm. Opravdu jen maličko."
    },
    {
      "id": 110504455126982659,
      "target": "Greatmother: Připálené maso je tak dobré…"
    },
    {
      "id": 110504455126982658,
      "target": "(Zabít ji)"
    },
    {
      "id": 110504455126982657,
      "target": "Jsi Host?"
    },
    {
      "id": 110504455126982656,
      "target": "Kdo jsi?"
    },
    {
      "id": 110504455122788364,
      "target": "Co to má všechno znamenat?"
    },
    {
      "id": 110504455122788363,
      "target": "Greatmother: Slyším je: plazí se. Už jen chvilku."
    },
    {
      "id": 110504455122788362,
      "target": "Greatmother: …"
    },
    {
      "id": 110504455122788361,
      "target": "Greatmother: Ve zdech se objeví praskliny a ulice zaplaví moře krve… a hory těl…"
    },
    {
      "id": 110504455122788360,
      "target": "Greatmother: Rozdupeme mraveniště, která jste si postavili…"
    },
    {
      "id": 110504455122788359,
      "target": "(Zabít ji)"
    },
    {
      "id": 110504455122788358,
      "target": "O čem to mluvíš?"
    },
    {
      "id": 110504455122788357,
      "target": "Jsi při smyslech?"
    },
    {
      "id": 110504455122788356,
      "target": "Co to plácáš za blbosti?"
    },
    {
      "id": 110504455122788355,
      "target": "Greatmother: Brzy přijdou. Slyším je."
    },
    {
      "id": 110504455122788354,
      "target": "Greatmother: …"
    },
    {
      "id": 110504455122788353,
      "target": "Greatmother: Pak už se ti v kombinézách nebudou starat o moje příbuzné. Budou mít jiné starosti."
    },
    {
      "id": 110504455122788352,
      "target": "Greatmother: Bude mnoho úmrtí a on kvůli nim přijde hodovat."
    },
    {
      "id": 110504455118594056,
      "target": "Greatmother: Přijde čas, kdy padnou zdi karanténních zón."
    },
    {
      "id": 110504455118594055,
      "target": "(Zabít ji)"
    },
    {
      "id": 110504455118594054,
      "target": "O čem to mluvíš?"
    },
    {
      "id": 110504455118594053,
      "target": "Jsi při smyslech?"
    },
    {
      "id": 110504455118594052,
      "target": "Co to plácáš za blbosti?"
    },
    {
      "id": 110504455118594051,
      "target": "Greatmother: Brzy přijdou. Slyším je."
    },
    {
      "id": 110504455118594050,
      "target": "Greatmother: …"
    },
    {
      "id": 110504455118594049,
      "target": "Greatmother: A jestli se jim to nepodaří pod zemí, obrátí karanténní zónu vzhůru nohama. Nikoho nenechají."
    },
    {
      "id": 110504455118594048,
      "target": "Greatmother: Pitomé ploty a ostnatý drát je nezastaví."
    },
    {
      "id": 110504455114399756,
      "target": "Greatmother: Zalezou zpátky pod zem a znovu vylezou, ale už venku."
    },
    {
      "id": 110504455114399755,
      "target": "Jak to myslíš, sami?"
    },
    {
      "id": 110504455114399754,
      "target": "Co tím myslíš?"
    },
    {
      "id": 110504455114399753,
      "target": "Greatmother: Synku, já jim pomáhat nebudu. Dostanou se ven sami."
    },
    {
      "id": 110504455114399751,
      "target": "Jak chcete dostat svou rodinu ven?"
    },
    {
      "id": 110504455114399750,
      "target": "Greatmother: Ach, synku, prosím tě, nikoho nepouštěj dovnitř."
    },
    {
      "id": 110504455114399749,
      "target": "Greatmother: Kéž bych své blízké dostala zpátky z karanténních zón…"
    },
    {
      "id": 110504455114399748,
      "target": "Greatmother: Dobrá, nebudu se vnucovat."
    },
    {
      "id": 110504455114399747,
      "target": "Greatmother: …"
    }
  ]
}
