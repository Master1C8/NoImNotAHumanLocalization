  "entries": [
    {
      "id": 110504457945554944,
      "target": "TV: Nyní také v nabídce rozvozu jídla For Rest. Volejte na číslo: {0}."
    },
    {
      "id": 110504457941360652,
      "target": "1 kombuchu, prosím"
    },
    {
      "id": 110504457941360651,
      "target": "1 krabičku cigaret, prosím"
    },
    {
      "id": 110504457941360650,
      "target": "2 konzervy pro kocoura, prosím"
    },
    {
      "id": 110504457941360649,
      "target": "TV: Následuje reportáž o dočasném pozastavení likvidace těl."
    },
    {
      "id": 110504457941360648,
      "target": "TV: …"
    },
    {
      "id": 110504457941360647,
      "target": "TV: …"
    },
    {
      "id": 110504457941360646,
      "target": "TV: …"
    },
    {
      "id": 110504457941360645,
      "target": "Phone: …"
    },
    {
      "id": 110504457941360644,
      "target": "Phone: Ale pořád se mi po ní stýská…"
    },
    {
      "id": 110504457941360643,
      "target": "Phone: ..."
    },
    {
      "id": 110504457941360642,
      "target": "Phone: Jděte k čertu!"
    },
    {
      "id": 110504457941360641,
      "target": "Phone: Proč se vám vlastně vůbec ospravedlňuju?"
    },
    {
      "id": 110504457941360640,
      "target": "Phone: Prosím…"
    },
    {
      "id": 110504457937166346,
      "target": "Phone: Už sem nevolejte…"
    },
    {
      "id": 110504457937166345,
      "target": "Phone: Promiňte."
    },
    {
      "id": 110504457937166344,
      "target": "Phone: ..."
    },
    {
      "id": 110504457937166343,
      "target": "Phone: Teď už mě jen mrzí, že jsme se té falešné dcery nezeptali, co to udělalo s naší holčičkou…"
    },
    {
      "id": 110504457937166342,
      "target": "Phone: Manžel mi to pomohl pochopit."
    },
    {
      "id": 110504457937166341,
      "target": "Phone: Ale pak jsem pochopila, že to ani nebyla naše dcera."
    },
    {
      "id": 110504457937166340,
      "target": "Phone: Nejdřív jsem chtěla zabít jeho samotného."
    },
    {
      "id": 110504457937166339,
      "target": "Phone: ..."
    },
    {
      "id": 110504457937166338,
      "target": "Phone: S tím Hostem si hned poradil."
    },
    {
      "id": 110504457937166337,
      "target": "Phone: Jakmile jsem o tom řekla manželovi, on…"
    },
    {
      "id": 110504457937166336,
      "target": "Phone: ..."
    },
    {
      "id": 110504457932972044,
      "target": "Phone: Všechno sedělo."
    },
    {
      "id": 110504457932972043,
      "target": "Phone: Proto jsem si hned všimla, když se ty příznaky objevily."
    },
    {
      "id": 110504457932972042,
      "target": "Phone: Vždyť jsem ji znala skrz naskrz."
    },
    {
      "id": 110504457932972041,
      "target": "Phone: Podle všech příznaků."
    },
    {
      "id": 110504457932972040,
      "target": "Phone: Byla Hostem."
    },
    {
      "id": 110504457932972039,
      "target": "Chápu"
    },
    {
      "id": 110504457932972038,
      "target": "To je v prdeli…"
    },
    {
      "id": 110504457932972037,
      "target": "Phone: Určitě byla Hostem! Příznaky seděly na sto procent!"
    },
    {
      "id": 110504457932972036,
      "target": "Phone: Nemáte právo mě soudit!"
    },
    {
      "id": 110504457932972035,
      "target": "..."
    },
    {
      "id": 110504457932972034,
      "target": "A vy jste se rozhodli zabít vlastní dítě?"
    },
    {
      "id": 110504457932972033,
      "target": "Phone: Všechny příznaky seděly a manžel na tom trval."
    },
    {
      "id": 110504457932972032,
      "target": "Phone: Zabili jsme ji. Pochopte, museli jsme."
    },
    {
      "id": 110504457928777740,
      "target": "(Zavěsit)"
    },
    {
      "id": 110504457928777739,
      "target": "Cože?"
    },
    {
      "id": 110504457928777738,
      "target": "Phone: Museli jsme ji zabít."
    },
    {
      "id": 110504457928777737,
      "target": "Phone: Museli jsme…"
    },
    {
      "id": 110504457928777736,
      "target": "Phone: ..."
    },
    {
      "id": 110504457928777735,
      "target": "Phone: Zemřela…"
    },
    {
      "id": 110504457928777734,
      "target": "Phone: Naše dceruška… ona…"
    },
    {
      "id": 110504457928777733,
      "target": "Phone: A sbohem."
    },
    {
      "id": 110504457928777732,
      "target": "Phone: Prosím, vyřiďte ta slova té holčičce."
    },
    {
      "id": 110504457928777731,
      "target": "Phone: A slzy už vůbec ničemu nepomůžou."
    },
    {
      "id": 110504457928777730,
      "target": "Phone: Jestli jejího otce upálili, pak to tak mělo být."
    },
    {
      "id": 110504457928777729,
      "target": "Phone: Nic se neděje jen tak."
    }
  ]
}
