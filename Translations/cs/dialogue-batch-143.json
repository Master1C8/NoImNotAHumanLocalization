    {
      "id": 110504456116838403,
      "target": "Gasmask: ..."
    },
    {
      "id": 110504456116838402,
      "target": "Ať to vede k čemukoli, zabili dítě."
    },
    {
      "id": 110504456116838401,
      "target": "Po slovech té dámy jste ztuhl."
    },
    {
      "id": 110504456116838400,
      "target": "Ale ty… ty odvedeš peklo jinam."
    },
    {
      "id": 110504456112644107,
      "target": "To dítě by nás přivedlo do říše něčeho strašného."
    },
    {
      "id": 110504456112644106,
      "target": "Usvědčuješ náš svět z hříchů."
    },
    {
      "id": 110504456112644105,
      "target": "Co se děje?"
    },
    {
      "id": 110504456112644104,
      "target": "Je setkání s nimi dobré znamení?"
    },
    {
      "id": 110504456112644103,
      "target": "Dívá se na vás pořád něco?"
    },
    {
      "id": 110504456112644102,
      "target": "A není za to koho vinit."
    },
    {
      "id": 110504456112644101,
      "target": "Vyhodili tě na ulici."
    },
    {
      "id": 110504456112644100,
      "target": "Stejně se to stane."
    },
    {
      "id": 110504456112644099,
      "target": "Vidím, co s tebou měli v plánu."
    },
    {
      "id": 110504456112644098,
      "target": "Ze strachu se člověk snadno zblázní."
    },
    {
      "id": 110504456112644097,
      "target": "Umírat je děsivé."
    },
    {
      "id": 110504456112644096,
      "target": "..."
    },
    {
      "id": 110504456108449803,
      "target": "..."
    },
    {
      "id": 110504456108449802,
      "target": "..."
    },
    {
      "id": 110504456108449801,
      "target": "..."
    },
    {
      "id": 110504456108449800,
      "target": "..."
    },
    {
      "id": 110504456108449799,
      "target": "..."
    },
    {
      "id": 110504456108449798,
      "target": "Poběž za mnou, rychle."
    },
    {
      "id": 110504456108449797,
      "target": "Nahromadilo se jich tolik, že klobouk houby pokryje celý povrch Země."
    },
    {
      "id": 110504456108449796,
      "target": "A čím víc hub..."
    },
    {
      "id": 110504456108449795,
      "target": "Když je zle, dokážou růst velice rychle."
    },
    {
      "id": 110504456108449794,
      "target": "Ale to až potom."
    },
    {
      "id": 110504456108449793,
      "target": "Nikdo se tu neplete pod nohy."
    },
    {
      "id": 110504456108449792,
      "target": "Je tu takový klid."
    },
    {
      "id": 110504456104255499,
      "target": "A kolik dalších ještě zabil? Kolik jich upálil?"
    },
    {
      "id": 110504456104255498,
      "target": "Vigilante: Máš to spočítaný, ty zasranej chytráku!"
    },
    {
      "id": 110504456104255497,
      "target": "Vigilante: Ty mě kurva máš za idiota? Myslíš, že ti na to skočím?"
    },
    {
      "id": 110504456104255496,
      "target": "Vigilante: Tak sis dohrál, hajzlíku…"
    },
    {
      "id": 110504456104255495,
      "target": "Vigilante: Kurva, ty jsi zasranej Host!"
    },
    {
      "id": 110504456104255494,
      "target": "Vigilante: Je čas chcípnout, parchante."
    },
    {
      "id": 110504456104255493,
      "target": "Vigilante: Ty hajzle! Zasranej Host, myslel sis, že mě oblafneš?"
    },
    {
      "id": 110504456104255492,
      "target": "Uchovám si na vás vzpomínku."
    },
    {
      "id": 110504456104255491,
      "target": "V šíleném živlu Kosmu se nedokážete udržet naživu."
    }
  ]
}
