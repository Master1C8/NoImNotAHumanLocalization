  "entries": [
    {
      "id": 110504454032269319,
      "target": "Leper: Poslyš, v čem spočívá ten příznak na fotce?"
    },
    {
      "id": 110504454032269318,
      "target": "Leper: Asi jsem mrknul. Ale v čem spočívá ten příznak na fotce?"
    },
    {
      "id": 110504454032269317,
      "target": "Leper: ..."
    },
    {
      "id": 110504454032269316,
      "target": "Leper: Dobře, foť."
    },
    {
      "id": 110504454032269315,
      "target": "Leper: …"
    },
    {
      "id": 110504454032269314,
      "target": "Leper: Fotka je příznak?"
    },
    {
      "id": 110504454028075016,
      "target": "Leper: Vidíš, i tady se projevuje moje kožní nemoc."
    },
    {
      "id": 110504454028075015,
      "target": "Leper: Vidíš, všechno je v pořádku. Kupodivu tady kožní nemoc nemám."
    },
    {
      "id": 110504454028075014,
      "target": "Leper: ..."
    },
    {
      "id": 110504454028075013,
      "target": "Leper: Dobře, jak chceš."
    },
    {
      "id": 110504454028075012,
      "target": "Leper: …"
    },
    {
      "id": 110504454028075011,
      "target": "Leper: Co? A to proč?"
    },
    {
      "id": 110504454028075008,
      "target": "Leper: Zapomněl jsem říct, že mi někdy cuká oko. To je taky následek vrozené nemoci."
    },
    {
      "id": 110504454023880716,
      "target": "Leper: Vím, že červené oko je příznak. Ale u mě je to kvůli té samé kožní nemoci."
    },
    {
      "id": 110504454023880715,
      "target": "Leper: ..."
    },
    {
      "id": 110504454023880714,
      "target": "Leper: Dobře, podívej se."
    },
    {
      "id": 110504454023880711,
      "target": "Leper: Doufám, že to nebudeš považovat za příznak Hosta?"
    },
    {
      "id": 110504454023880710,
      "target": "Leper: ..."
    },
    {
      "id": 110504454023880709,
      "target": "Leper: No, tady bohužel uvidíš tu kožní vadu."
    },
    {
      "id": 110504454023880706,
      "target": "Leper: No, mám křivé zuby. To není důvod považovat mě za Hosta."
    },
    {
      "id": 110504454023880705,
      "target": "Leper: Doufám, že mě nezabiješ jen kvůli rovným zubům, že ne?"
    },
    {
      "id": 110504454023880704,
      "target": "Leper: No, jsou rovné, jak vidíš. Kůži mám sice poškozenou, ale zuby mám od narození dobré."
    },
    {
      "id": 110504454019686410,
      "target": "Leper: ..."
    },
    {
      "id": 110504454019686409,
      "target": "Leper: Podívej, obyčejné zuby."
    },
    {
      "id": 110504454019686402,
      "target": "Leper: No, jestli tolik chceš, tak mě prohlédni."
    },
    {
      "id": 110504454019686401,
      "target": "Nervous: Kurva…"
    }
  ]
}
