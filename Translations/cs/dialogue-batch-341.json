  "entries": [
    {
      "id": 110504452803338242,
      "target": "Daughter: Nejspíš brzy přijde."
    },
    {
      "id": 110504452803338241,
      "target": "Daughter: Až si pro mě přijde, určitě mu řeknu, že vůbec nejste Host."
    },
    {
      "id": 110504452803338240,
      "target": "Daughter: Děkuju, že to děláte jako můj táta."
    },
    {
      "id": 110504452799143942,
      "target": "Daughter: ..."
    },
    {
      "id": 110504452799143941,
      "target": "Daughter: Táta říkal, že se máme bát parazitů, klíšťat a brouků. Hledáte je?"
    },
    {
      "id": 110504452799143940,
      "target": "Daughter: Nelíbilo se mi to. Už mě prosím nežádejte, abych se fotila."
    },
    {
      "id": 110504452799143939,
      "target": "Daughter: Děkuju."
    },
    {
      "id": 110504452799143938,
      "target": "Daughter: Mmmm."
    },
    {
      "id": 110504452799143937,
      "target": "Daughter: ..."
    },
    {
      "id": 110504452799143936,
      "target": "Daughter: Ukážete mi pak tu fotku?"
    },
    {
      "id": 110504452794949639,
      "target": "Daughter: Mě moc nefotili."
    },
    {
      "id": 110504452794949638,
      "target": "Daughter: Fotku?"
    }
  ]
}
