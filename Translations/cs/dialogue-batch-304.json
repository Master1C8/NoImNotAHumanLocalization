  "entries": [
    {
      "id": 110504453591867397,
      "target": "..."
    },
    {
      "id": 110504453591867396,
      "target": "Na otiscích prstů jsou stopy střelného prachu. Ale to je maličkost."
    },
    {
      "id": 110504453591867395,
      "target": "Čisté ruce…"
    },
    {
      "id": 110504453591867394,
      "target": "To všechno kvůli té jeskyni, kterou kopu."
    },
    {
      "id": 110504453591867393,
      "target": "Špinavé nehty…"
    },
    {
      "id": 110504453591867392,
      "target": "..."
    },
    {
      "id": 110504453587673095,
      "target": "..."
    },
    {
      "id": 110504453587673094,
      "target": "Tím líp. Aspoň mě nebudou považovat za Hosta."
    },
    {
      "id": 110504453587673093,
      "target": "Žluté zuby…"
    },
    {
      "id": 110504453587673092,
      "target": "Kuřáci by za takové prodali ledvinu."
    },
    {
      "id": 110504453587673091,
      "target": "Sakra, bílé…"
    },
    {
      "id": 110504453587673090,
      "target": "..."
    },
    {
      "id": 110504453587673089,
      "target": "..."
    },
    {
      "id": 110504453587673088,
      "target": "Opláchnout si obličej"
    },
    {
      "id": 110504453583478786,
      "target": "Musím se prohlédnout."
    },
    {
      "id": 110504453583478785,
      "target": "FatalDame: ..."
    },
    {
      "id": 110504453583478784,
      "target": "Maminko..."
    },
    {
      "id": 110504453579284487,
      "target": "Daughter: Tatínku..."
    },
    {
      "id": 110504453579284486,
      "target": "Daughter: Měla bych jít za kamarádkou, až si pro mě táta přijde..."
    },
    {
      "id": 110504453579284485,
      "target": "Daughter: Mně taky táta něco zakazuje, ale přece ne všechno!"
    },
    {
      "id": 110504453579284484,
      "target": "Daughter: Možná je její máma Host?"
    },
    {
      "id": 110504453579284483,
      "target": "Daughter: Spoustu věcí jí zakazuje."
    },
    {
      "id": 110504453579284482,
      "target": "Daughter: Jen to má doma těžké. Má moc přísnou mámu."
    },
    {
      "id": 110504453579284481,
      "target": "Daughter: Ale jinak je hodná."
    },
    {
      "id": 110504453579284480,
      "target": "Daughter: A pak najednou — bác! — provede nějakou lumpárnu!"
    },
    {
      "id": 110504453575090183,
      "target": "Daughter: Hrajeme si spolu a hrajeme."
    },
    {
      "id": 110504453575090180,
      "target": "Daughter: Někdy jste úplně jako moje nejlepší kamarádka..."
    },
    {
      "id": 110504453575090179,
      "target": "Daughter: Chcete mi ublížit?"
    },
    {
      "id": 110504453575090178,
      "target": "Daughter: A tohle taky řeknu!"
    },
    {
      "id": 110504453575090177,
      "target": "Daughter: Jé..."
    },
    {
      "id": 110504453570895879,
      "target": "Daughter: Nepamatuju si-i-i-i-i..."
    }
  ]
}
