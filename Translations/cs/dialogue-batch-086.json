  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504456846647303,
      "target": "Provocateur: Mějte se dobře…"
    },
    {
      "id": 110504456846647302,
      "target": "Provocateur: …"
    },
    {
      "id": 110504456846647301,
      "target": "Provocateur: A to by pro vás, věřte mi, nedopadlo dobře."
    },
    {
      "id": 110504456846647300,
      "target": "Provocateur: To mějte na paměti VY! Mohl bych to považovat za ohrožení svého života! A to už spadá pod článek 119 ústavy."
    },
    {
      "id": 110504456846647299,
      "target": "Provocateur: …"
    },
    {
      "id": 110504456846647298,
      "target": "Provocateur: Co znamená, že JÁ mám radši odejít!? To je výhrůžka?"
    },
    {
      "id": 110504456846647297,
      "target": "Provocateur: Podrobnosti nájmu pak probereme."
    },
    {
      "id": 110504456846647296,
      "target": "Provocateur: Děkuji vám, pane majiteli."
    },
    {
      "id": 110504456842453002,
      "target": "Provocateur: Buď vám budu platit, nebo do vašeho domu ani nevkročím."
    },
    {
      "id": 110504456842453001,
      "target": "Provocateur: To není správné, není to podle zákona…"
    },
    {
      "id": 110504456842453000,
      "target": "Provocateur: Promiňte, ale nemůžu u vás bydlet, aniž bych platil nájem."
    },
    {
      "id": 110504456842452997,
      "target": "Provocateur: Dobře, smlouvu pak prostě sepíšeme, jak ukládá zákon, a hotovo."
    },
    {
      "id": 110504456842452996,
      "target": "Provocateur: To jsme to dopracovali, majitel ohrnuje nos nad penězi…"
    },
    {
      "id": 110504456842452995,
      "target": "Provocateur: …"
    },
    {
      "id": 110504456842452994,
      "target": "Provocateur: Děláte mi snad laskavost?"
    },
    {
      "id": 110504456842452993,
      "target": "Tvoje peníze nepotřebuju."
    },
    {
      "id": 110504456842452992,
      "target": "Tak plať, jestli chceš."
    },
    {
      "id": 110504456838258699,
      "target": "Provocateur: Dovolte, ale nehodlám zabírat cenné metry čtvereční obytné plochy, aniž bych za sebe platil."
    },
    {
      "id": 110504456838258698,
      "target": "Provocateur: …"
    },
    {
      "id": 110504456838258697,
      "target": "Provocateur: Co tím myslíte, že mě prostě pustíte? Jste dobrovolník? Poskytujete bydlení bezdomovcům?"
    },
    {
      "id": 110504456838258696,
      "target": "Tvoje peníze nepotřebuju."
    },
    {
      "id": 110504456838258695,
      "target": "Tak plať, jestli chceš."
    },
    {
      "id": 110504456838258694,
      "target": "Provocateur: Ačkoli… pro jistotu se zeptám: kolik si účtujete za den?"
    },
    {
      "id": 110504456838258693,
      "target": "Provocateur: Nu dobrá. Smlouvu tedy uzavřeme o něco později."
    },
    {
      "id": 110504456838258692,
      "target": "Provocateur: …"
    },
    {
      "id": 110504456838258691,
      "target": "Provocateur: Odpověděl jste nějak nejistě…"
    },
    {
      "id": 110504456838258690,
      "target": "Prostě k sobě pouštím lidi."
    },
    {
      "id": 110504456838258689,
      "target": "Něco takového."
    },
    {
      "id": 110504456838258688,
      "target": "Provocateur: Dobrý den, pane majiteli. Pronajímáte tady ubytování?"
    }
  ]
}
