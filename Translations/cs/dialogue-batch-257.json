  "entries": [
    {
      "id": 110504454422339587,
      "target": "Widow: Pořád mlčí a mlčí, a najednou povídá:"
    },
    {
      "id": 110504454422339586,
      "target": "Widow: V tu chvíli už jsme měli dost vypito."
    },
    {
      "id": 110504454422339585,
      "target": "Widow: Tak sedíme a popíjíme. Obvykle býval dost zachmuřený a při podobných setkáních moc nemluvil."
    },
    {
      "id": 110504454422339584,
      "target": "Widow: Tehdy jsme byli mnohem mladší."
    },
    {
      "id": 110504454418145291,
      "target": "Widow: Jednou jsme šli navštívit přátele."
    },
    {
      "id": 110504454418145290,
      "target": "Widow: …"
    },
    {
      "id": 110504454418145288,
      "target": "Vyprávěj mi, co si o něm pamatuješ"
    },
    {
      "id": 110504454418145287,
      "target": "Widow: Chtěla bych si trochu odpočinout…"
    },
    {
      "id": 110504454418145286,
      "target": "Widow: Tak moc tomu chci věřit."
    },
    {
      "id": 110504454418145285,
      "target": "Widow: Tak moc chci…"
    },
    {
      "id": 110504454418145284,
      "target": "Widow: Pořád mě slyší."
    },
    {
      "id": 110504454418145283,
      "target": "Widow: Ne, tak to není."
    },
    {
      "id": 110504454418145282,
      "target": "Widow: Ne."
    },
    {
      "id": 110504454418145281,
      "target": "Widow: …"
    },
    {
      "id": 110504454418145280,
      "target": "Widow: Nevydám ho bezcitné zemi."
    },
    {
      "id": 110504454413950982,
      "target": "Widow: Tohle nedokážu."
    },
    {
      "id": 110504454413950981,
      "target": "Widow: A znovu se s ním rozloučit."
    },
    {
      "id": 110504454413950980,
      "target": "Widow: Teprve nedávno mi ho vrátili."
    },
    {
      "id": 110504454413950979,
      "target": "Widow: Nejsem připravená."
    },
    {
      "id": 110504454413950978,
      "target": "Widow: Ne-ne-ne-ne."
    },
    {
      "id": 110504454413950977,
      "target": "Widow: Ne-e-e."
    },
    {
      "id": 110504454413950976,
      "target": "Zbylo z něj jen tělo. Musíš to přijmout"
    },
    {
      "id": 110504454409756678,
      "target": "Je třeba ho pohřbít"
    },
    {
      "id": 110504454409756677,
      "target": "Widow: Prostě přestat plakat."
    },
    {
      "id": 110504454409756676,
      "target": "Widow: Ale je to správné?"
    },
    {
      "id": 110504454409756675,
      "target": "Widow: Jako bych už neměla čím plakat."
    },
    {
      "id": 110504454409756674,
      "target": "Widow: Teprve nedávno mi došly všechny slzy."
    },
    {
      "id": 110504454409756673,
      "target": "Widow: To je příliš."
    },
    {
      "id": 110504454409756672,
      "target": "Widow: Ještě to nedokážu."
    },
    {
      "id": 110504454405562378,
      "target": "Jak zemřel?"
    },
    {
      "id": 110504454405562377,
      "target": "Widow: Chtěla bych si trochu odpočinout…"
    },
    {
      "id": 110504454405562376,
      "target": "Widow: Co mám dělat?"
    },
    {
      "id": 110504454405562375,
      "target": "Widow: Nemůžu tě…"
    },
    {
      "id": 110504454405562374,
      "target": "Widow: …"
    },
    {
      "id": 110504454405562373,
      "target": "Widow: Pohřbít…"
    },
    {
      "id": 110504454405562372,
      "target": "Widow: Já dokonce…"
    },
    {
      "id": 110504454405562371,
      "target": "Widow: Ty mi nikoho nevrátíš."
    },
    {
      "id": 110504454405562370,
      "target": "Widow: Chci s ním být."
    }
  ]
}
