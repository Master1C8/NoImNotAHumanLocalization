  "entries": [
    {
      "id": 110504453843525637,
      "target": "Rocker: Už se vlastně nemám čeho bát."
    },
    {
      "id": 110504453843525634,
      "target": "Rocker: Upřímně, je mi to u prdele."
    },
    {
      "id": 110504453839331339,
      "target": "Rocker: Ale je to styl. Mně se to líbí."
    },
    {
      "id": 110504453839331338,
      "target": "Rocker: Teď mám jen potrhaný uši."
    },
    {
      "id": 110504453839331337,
      "target": "Rocker: ..."
    },
    {
      "id": 110504453839331336,
      "target": "Rocker: Nechal jsem si udělat tunely. A pak… mě to nějak přestalo bavit."
    },
    {
      "id": 110504453839331333,
      "target": "Rocker: Aspoň bys mohl sundat krytku z foťáku."
    },
    {
      "id": 110504453839331332,
      "target": "Rocker: Páni."
    },
    {
      "id": 110504453839331331,
      "target": "Rocker: ..."
    },
    {
      "id": 110504453839331330,
      "target": "Rocker: Tak se vyfotím aspoň s tebou, pojď."
    },
    {
      "id": 110504453835137035,
      "target": "Rocker: Je tam něco zajímavýho?"
    },
    {
      "id": 110504453835137034,
      "target": "Rocker: ..."
    },
    {
      "id": 110504453835137033,
      "target": "Rocker: Jak chceš."
    },
    {
      "id": 110504453835137030,
      "target": "Rocker: Takový bych chtěl…"
    },
    {
      "id": 110504453835137029,
      "target": "Rocker: Ten týpek úplně oslepl. Ale kdybys viděl jeho oči."
    },
    {
      "id": 110504453835137028,
      "target": "Rocker: Mně ne."
    },
    {
      "id": 110504453835137027,
      "target": "Rocker: ..."
    },
    {
      "id": 110504453835137026,
      "target": "Unstable: Dodnes si vybavuju tu akci s třesením."
    },
    {
      "id": 110504453835137025,
      "target": "Rocker: Jednou nás napadlo napustit inkoust přímo do očí."
    },
    {
      "id": 110504453830942730,
      "target": "Rocker: Už si nevzpomínám…"
    },
    {
      "id": 110504453830942729,
      "target": "Rocker: Nebo to není kérka."
    },
    {
      "id": 110504453830942728,
      "target": "Rocker: Počkej."
    },
    {
      "id": 110504453830942727,
      "target": "Rocker: Nechal jsem si ji udělat při pořádný kalbě. Tatér se ožral z legrace, já kvůli odvaze."
    },
    {
      "id": 110504453830942726,
      "target": "Rocker: ..."
    },
    {
      "id": 110504453830942725,
      "target": "Rocker: Jednu kérku mám."
    }
  ]
}
