  "glossaryFingerprint": "15387d7d390dd7fde7556b067854fbb08139b46e2831cca0357f5f6b32521d24",
  "status": "authored-draft; full editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504456104255490,
      "target": "Přesně jak si to lidé přáli."
    },
    {
      "id": 110504456104255489,
      "target": "Daruji vám pokoj."
    },
    {
      "id": 110504456104255488,
      "target": "Vrátím vás tam, kde jste měli být od samého začátku."
    },
    {
      "id": 110504456100061195,
      "target": "Ukryji vás."
    },
    {
      "id": 110504456100061194,
      "target": "Teď musím zasáhnout."
    },
    {
      "id": 110504456100061193,
      "target": "Cítíš to? To je ona."
    },
    {
      "id": 110504456100061192,
      "target": "Možná k nám sestoupí i sama Smrt a..."
    },
    {
      "id": 110504456100061191,
      "target": "Nikdo neodejde zklamaný."
    },
    {
      "id": 110504456100061190,
      "target": "Všichni naleznou pokoj."
    },
    {
      "id": 110504456100061189,
      "target": "Teď už děláme všechno správně."
    },
    {
      "id": 110504456100061188,
      "target": "Zastaralý pohled na Smrt nám bránil správně zemřít."
    },
    {
      "id": 110504456100061187,
      "target": "Jsem rád, že ses k nám přidal. Smrt si tě opravdu nevybrala nadarmo."
    },
    {
      "id": 110504456100061186,
      "target": "Je velmi těžké se na něj soustředit."
    },
    {
      "id": 110504456100061185,
      "target": "Před očima se vám vynoří malý osamělý domek."
    },
    {
      "id": 110504456100061184,
      "target": "Před očima se vám zatmí."
    },
    {
      "id": 110504456095866891,
      "target": "Trhají vás na kusy."
    },
    {
      "id": 110504456095866890,
      "target": "Hrůza vás oslepila."
    },
    {
      "id": 110504456095866889,
      "target": "Ani vás nenapadne pokusit se zachránit."
    },
    {
      "id": 110504456095866888,
      "target": "Strach ze smrti vás ochromil."
    },
    {
      "id": 110504456095866887,
      "target": "Cítíte na sobě pohledy."
    },
    {
      "id": 110504456095866886,
      "target": "Lidé si navzájem nedůvěřují."
    },
    {
      "id": 110504456095866885,
      "target": "Vědci předpovídají, že za pár dní..."
    },
    {
      "id": 110504456095866884,
      "target": "„Sluneční energie postupně slábne."
    },
    {
      "id": 110504456095866883,
      "target": "KAŽDÝ."
    },
    {
      "id": 110504456095866882,
      "target": "Každý parchant se zbraní v ruce dnes zemře."
    },
    {
      "id": 110504456095866881,
      "target": "VŠECHNO zaliju vaší krví."
    },
    {
      "id": 110504456095866880,
      "target": "Zaženu vás hluboko pod zem."
    },
    {
      "id": 110504456091672587,
      "target": "Hlavy prokleté šílenstvím."
    },
    {
      "id": 110504456091672586,
      "target": "Vždyť já vás rozdrtím!"
    },
    {
      "id": 110504456091672585,
      "target": "To si myslíš, že se nikdo nebude bránit?"
    },
    {
      "id": 110504456091672584,
      "target": "A takoví jako ty nenechají nikoho na pokoji."
    },
    {
      "id": 110504456091672583,
      "target": "Takoví jako ty zabili mého přítele."
    },
    {
      "id": 110504456091672582,
      "target": "Kvůli takovým zmrdům je tolik mrtvých."
    },
    {
      "id": 110504456091672581,
      "target": "Utichl. Musím se podívat."
    },
    {
      "id": 110504456091672580,
      "target": "Se mnou si zahrával, protože se nenechám jen tak mlátit. Ale co ostatní?"
    },
    {
      "id": 110504456091672579,
      "target": "Ten hajzl. Zasáhl mě."
    },
    {
      "id": 110504456091672578,
      "target": "Slyším, jak sípe."
    },
    {
      "id": 110504456091672577,
      "target": "Závoj vzteku v očích člověka se zbraní děsí víc než Host."
    },
    {
      "id": 110504456091672576,
      "target": "Ale vy jen vyčkáváte a doufáte, že se nic nestane."
    },
    {
      "id": 110504456087478283,
      "target": "Slyšíte, jak šílenec za dveřmi vztekle cedí slova."
    }
  ]
}
