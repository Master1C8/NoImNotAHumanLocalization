  "entries": [
    {
      "id": 110504453755445253,
      "target": "Jacob: Naštěstí pro mě."
    },
    {
      "id": 110504453755445252,
      "target": "Jacob: V posledních týdnech jsem neměl možnost si vyčistit zuby."
    },
    {
      "id": 110504453755445251,
      "target": "Jacob: ..."
    },
    {
      "id": 110504453755445250,
      "target": "Jacob: Dobře."
    },
    {
      "id": 110504453751250950,
      "target": "Jacob: Věděl jsem, že to řekneš."
    },
    {
      "id": 110504453751250949,
      "target": "Sirin: Jsem připravená..."
    },
    {
      "id": 110504453751250948,
      "target": "Sirin: Jak mám... bez ní..."
    },
    {
      "id": 110504453751250947,
      "target": "Sirin: Smrt mi vzala sestru..."
    },
    {
      "id": 110504453751250946,
      "target": "Alkonost: Prostě střílej."
    },
    {
      "id": 110504453751250945,
      "target": "Alkonost: Jaký má teď smysl cokoli dělat... nebo se snažit..."
    },
    {
      "id": 110504453751250944,
      "target": "Alkonost: ..."
    },
    {
      "id": 110504453747056650,
      "target": "Alkonost: Moje sestra... Proč?"
    },
    {
      "id": 110504453747056649,
      "target": "Anger: Strašně mě to sere. Ale vždycky si to uvědomím až moc pozdě."
    },
    {
      "id": 110504453747056648,
      "target": "Anger: Někdy zatínám čelisti tak, až slyším křupnutí."
    },
    {
      "id": 110504453747056647,
      "target": "..."
    },
    {
      "id": 110504453747056646,
      "target": "Co to vůbec bylo za reportáž?"
    },
    {
      "id": 110504453747056644,
      "target": "S ušima je všechno v pořádku."
    },
    {
      "id": 110504453747056643,
      "target": "..."
    },
    {
      "id": 110504453747056642,
      "target": "..."
    },
    {
      "id": 110504453747056641,
      "target": "Musím si opláchnout obličej. Snad to pomůže."
    },
    {
      "id": 110504453742862345,
      "target": "Vypadá to na podráždění, nebo ještě hůř na plíseň."
    },
    {
      "id": 110504453742862344,
      "target": "Kurva, co je to za svinstvo!?"
    },
    {
      "id": 110504453742862343,
      "target": "Tak, jak to má být."
    },
    {
      "id": 110504453742862342,
      "target": "Podpaží s chlupy."
    },
    {
      "id": 110504453742862341,
      "target": "..."
    },
    {
      "id": 110504453742862340,
      "target": "..."
    },
    {
      "id": 110504453742862339,
      "target": "Nejsou červené, takže není do čeho rejpat."
    },
    {
      "id": 110504453742862338,
      "target": "Oči jako oči."
    },
    {
      "id": 110504453742862337,
      "target": "Neměl jsem pít ten kofeinovej sajrajt."
    },
    {
      "id": 110504453742862336,
      "target": "Do prdele. Jsou červené…"
    },
    {
      "id": 110504453738668032,
      "target": "..."
    }
  ]
}
