  "entries": [
    {
      "id": 110504457891029001,
      "target": "Phone: Nevadilo by vám mě vyslechnout?"
    },
    {
      "id": 110504457891029000,
      "target": "Phone: Ani si nedovedete představit, jak moc mi pomůžete obyčejným rozhovorem. Hned se budu cítit mnohem klidněji."
    },
    {
      "id": 110504457891028999,
      "target": "Phone: Chápu, že není správné zatěžovat cizího člověka svými problémy, ale…"
    },
    {
      "id": 110504457891028998,
      "target": "Phone: Možná to není nejlepší místo, kde si vylít srdce, ale pořád je to lepší než nic."
    },
    {
      "id": 110504457891028997,
      "target": "Phone: A pak jsem se dozvěděla o telefonní ruletě."
    },
    {
      "id": 110504457891028996,
      "target": "Phone: Snažila jsem se dovolat přátelům a známým, ale nikdo neodpovídá…"
    },
    {
      "id": 110504457891028995,
      "target": "Phone: Já… potřebuju si s někým promluvit. Poslední dobou se toho stalo tolik…"
    },
    {
      "id": 110504457891028994,
      "target": "Phone: …"
    },
    {
      "id": 110504457891028993,
      "target": "Phone: Zřejmě tu nikdo není…"
    },
    {
      "id": 110504457891028992,
      "target": "Phone: …"
    },
    {
      "id": 110504457886834699,
      "target": "Phone: …"
    },
    {
      "id": 110504457886834697,
      "target": "Dobrý den"
    },
    {
      "id": 110504457886834696,
      "target": "Phone: Haló?"
    },
    {
      "id": 110504457886834695,
      "target": "Phone: …"
    },
    {
      "id": 110504457886834693,
      "target": "Dobrý den"
    },
    {
      "id": 110504457886834692,
      "target": "Phone: Haló, dobrý den."
    },
    {
      "id": 110504457886834691,
      "target": "Phone: …"
    },
    {
      "id": 110504457886834690,
      "target": "Phone: …"
    },
    {
      "id": 110504457886834689,
      "target": "Phone: Dobrý den, dovolali jste se do telefonní rulety. Teď vám vybereme ideálního společníka k rozhovoru. Vyčkejte, prosím."
    },
    {
      "id": 110504457886834688,
      "target": "Phone: …"
    },
    {
      "id": 110504457882640396,
      "target": "Phone: …"
    },
    {
      "id": 110504457882640395,
      "target": "Phone: Dobře, tak poslední otázka: tekla u vás doma krev?"
    },
    {
      "id": 110504457882640394,
      "target": "Phone: …"
    },
    {
      "id": 110504457882640393,
      "target": "Phone: Dobře, tak mi řekněte, jíte houby?"
    },
    {
      "id": 110504457882640392,
      "target": "Phone: …"
    },
    {
      "id": 110504457882640391,
      "target": "Phone: …"
    },
    {
      "id": 110504457882640390,
      "target": "Phone: Poradíme se s vedením a dáme vám později vědět."
    },
    {
      "id": 110504457882640389,
      "target": "Phone: Uši? Počkejte…"
    },
    {
      "id": 110504457882640388,
      "target": "Phone: …"
    },
    {
      "id": 110504457882640387,
      "target": "Phone: …"
    },
    {
      "id": 110504457882640386,
      "target": "Phone: Vyhněte se sprchování a mytí rukou."
    },
    {
      "id": 110504457882640385,
      "target": "Phone: Aby byly výsledky vyšetření podpaží správné, nesmíte přijít do styku s vodou."
    },
    {
      "id": 110504457882640384,
      "target": "Phone: …"
    },
    {
      "id": 110504457878446091,
      "target": "Phone: …"
    },
    {
      "id": 110504457878446090,
      "target": "Phone: …"
    },
    {
      "id": 110504457878446089,
      "target": "Co mám dělat s ušima?"
    },
    {
      "id": 110504457878446088,
      "target": "Co mám dělat s podpažím?"
    },
    {
      "id": 110504457878446087,
      "target": "Phone: TY JSI ÚPLNĚ BLBÁ?! OKAMŽITĚ ZAVĚS!"
    },
    {
      "id": 110504457878446086,
      "target": "Phone: (Než žena stačila odpovědět, ozval se hlasitý mužský řev)"
    },
    {
      "id": 110504457878446085,
      "target": "O čem to mluvíte?"
    },
    {
      "id": 110504457878446084,
      "target": "Cože? KČS? Co to má být?"
    },
    {
      "id": 110504457878446083,
      "target": "Phone: Dobrý den, dovolali jste se na horkou linku KČS. Jak vám můžeme pomoci?"
    }
  ]
}
