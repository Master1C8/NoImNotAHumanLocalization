  "entries": [
    {
      "id": 110504452052557829,
      "target": "Daughter: Nelíbilo se mi to. Už mě nepros, abych se fotila."
    },
    {
      "id": 110504452052557828,
      "target": "Daughter: Děkuju."
    },
    {
      "id": 110504452052557827,
      "target": "Daughter: Mmmm."
    },
    {
      "id": 110504452052557826,
      "target": "Daughter: (Holčička k vám přiběhla, ještě než fotografování skončilo)"
    },
    {
      "id": 110504452052557825,
      "target": "Daughter: (Fotografie vyšla trochu rozmazaná)"
    },
    {
      "id": 110504452052557824,
      "target": "Daughter: (Fotografujete holčičku)"
    },
    {
      "id": 110504452048363530,
      "target": "Daughter: Ukážeš mi pak tu fotku?"
    },
    {
      "id": 110504452048363529,
      "target": "Daughter: Mě moc nefotili."
    },
    {
      "id": 110504452048363528,
      "target": "Daughter: Fotku?"
    },
    {
      "id": 110504452048363527,
      "target": "Daughter: Jsem moc unavená, můžu tu chvíli stát sama?"
    },
    {
      "id": 110504452048363526,
      "target": "Daughter: Chcete jen vědět, jak se mám?"
    },
    {
      "id": 110504452048363525,
      "target": "Daughter: (Podíváte se na ni a uvědomíte si, že je toho na vás příliš.)"
    },
    {
      "id": 110504452048363524,
      "target": "Daughter: Co mám udělat?"
    },
    {
      "id": 110504452048363523,
      "target": "Daughter: Já-já-já pííít chciii."
    },
    {
      "id": 110504452048363522,
      "target": "Daughter: Vy… uááááá."
    },
    {
      "id": 110504452048363521,
      "target": "Daughter: Vy jste tam vi-vi-viděl…"
    },
    {
      "id": 110504452048363520,
      "target": "Daughter: Proč jste se tak podíval?"
    },
    {
      "id": 110504452044169227,
      "target": "Daughter: ..."
    },
    {
      "id": 110504452044169226,
      "target": "Daughter: Tak budu myslet opatrně, nebojte se."
    },
    {
      "id": 110504452044169225,
      "target": "Daughter: Uvidíte tam všechno, na co myslím?"
    },
    {
      "id": 110504452044169224,
      "target": "Daughter: A můžete se podívat dovnitř oka?"
    },
    {
      "id": 110504452044169223,
      "target": "Daughter: Já půjdu, chci si posedět sama."
    },
    {
      "id": 110504452044169222,
      "target": "Daughter: Ostříhala jsem si je sama. Dokázala jsem to. Sama."
    },
    {
      "id": 110504452044169221,
      "target": "Daughter: Podívejte, jaké mám nehtíky."
    },
    {
      "id": 110504452044169220,
      "target": "Daughter: ..."
    },
    {
      "id": 110504452044169219,
      "target": "Daughter: Podívejte se."
    },
    {
      "id": 110504452044169218,
      "target": "Daughter: Zatím to moc neumím, já…"
    },
    {
      "id": 110504452044169217,
      "target": "Daughter: Ale už si umím sama stříhat nehty."
    },
    {
      "id": 110504452044169216,
      "target": "Daughter: Všechno je přece v pořádku, že?"
    },
    {
      "id": 110504452039974921,
      "target": "Daughter: Co to znamená?"
    },
    {
      "id": 110504452039974920,
      "target": "Daughter: Podívejte, jaké mám."
    },
    {
      "id": 110504452039974919,
      "target": "Daughter: ..."
    },
    {
      "id": 110504452039974918,
      "target": "Daughter: Už nebudu brečet."
    },
    {
      "id": 110504452039974917,
      "target": "Daughter: Proč? Vždyť mám ještě mléčné zoubky. Táta říkal…"
    },
    {
      "id": 110504452039974916,
      "target": "Daughter: Zuby? Mám vám ukázat zuby?"
    },
    {
      "id": 110504452035780615,
      "target": "Daughter: Co chceš zkontrolovat?"
    }
  ]
}
