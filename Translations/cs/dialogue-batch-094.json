  "entries": [
    {
      "id": 110504456750178306,
      "target": "SuperFake: Ale nejdřív vyzkoušíme naše nové pravidlo."
    },
    {
      "id": 110504456750178305,
      "target": "SuperFake: Samozřejmě! Už odcházím."
    },
    {
      "id": 110504456750178304,
      "target": "Nejsem sám"
    },
    {
      "id": 110504456745984011,
      "target": "Jsem sám"
    },
    {
      "id": 110504456745984010,
      "target": "SuperFake: Jsi doma sám?"
    },
    {
      "id": 110504456745984009,
      "target": "SuperFake: Ale nejdřív…"
    },
    {
      "id": 110504456745984008,
      "target": "SuperFake: Teď to vyzkoušíme."
    },
    {
      "id": 110504456745984007,
      "target": "SuperFake: Je to prosté."
    },
    {
      "id": 110504456745984006,
      "target": "Můžeš přijít později?"
    },
    {
      "id": 110504456745984005,
      "target": "Nerozumím."
    },
    {
      "id": 110504456745984004,
      "target": "SuperFake: Otevřeš mi dveře."
    },
    {
      "id": 110504456745984003,
      "target": "SuperFake: Jestli budeš mít doma alespoň dva z mých lidí…"
    },
    {
      "id": 110504456745984002,
      "target": "SuperFake: Pojďme to změnit."
    },
    {
      "id": 110504456745984001,
      "target": "SuperFake: Jako by ti na sobě vůbec nezáleželo."
    },
    {
      "id": 110504456745984000,
      "target": "SuperFake: Působíš nějak netečně."
    },
    {
      "id": 110504456741789707,
      "target": "Můžeš přijít později?"
    },
    {
      "id": 110504456741789706,
      "target": "Nerozumím."
    },
    {
      "id": 110504456741789705,
      "target": "SuperFake: Protože v tělech teď přebývají psi."
    },
    {
      "id": 110504456741789704,
      "target": "SuperFake: Otevřeš mi dveře."
    },
    {
      "id": 110504456741789703,
      "target": "SuperFake: Jestli budeš mít doma alespoň dva z mých lidí…"
    },
    {
      "id": 110504456741789702,
      "target": "SuperFake: Ty a já vyzkoušíme nová pravidla."
    },
    {
      "id": 110504456741789701,
      "target": "SuperFake: Zjevně potřebuješ pomoc."
    },
    {
      "id": 110504456741789700,
      "target": "SuperFake: Máš to těžké."
    },
    {
      "id": 110504456741789699,
      "target": "Je mi to jedno."
    },
    {
      "id": 110504456741789698,
      "target": "Necítím to."
    },
    {
      "id": 110504456741789697,
      "target": "SuperFake: Kolem tebe se dějí zajímavé věci."
    },
    {
      "id": 110504456741789696,
      "target": "SuperFake: Víš, o kom mluvím?"
    },
    {
      "id": 110504456737595403,
      "target": "SuperFake: Má totiž jen slovo, jediné slovo, ale jaké!"
    },
    {
      "id": 110504456737595402,
      "target": "SuperFake: Jednotlivý člověk však přestal umírat."
    },
    {
      "id": 110504456737595401,
      "target": "SuperFake: Já také."
    },
    {
      "id": 110504456737595400,
      "target": "SuperFake: Změny tě pronásledují."
    },
    {
      "id": 110504456737595399,
      "target": "SuperFake: Cítíš to?"
    },
    {
      "id": 110504456737595398,
      "target": "SuperFake: Naše příští setkání bude zajímavější."
    },
    {
      "id": 110504456737595397,
      "target": "SuperFake: A ty nestíháš držet krok s novým rytmem."
    },
    {
      "id": 110504456737595396,
      "target": "SuperFake: Život se změnil."
    },
    {
      "id": 110504456737595395,
      "target": "SuperFake: Chápeš přece, že už nikdy nebude jako dřív."
    },
    {
      "id": 110504456737595394,
      "target": "SuperFake: …"
    },
    {
      "id": 110504456737595393,
      "target": "SuperFake: Světu vládnou psi. A zůstanou tu jen psi."
    }
  ]
