  "entries": [
    {
      "id": 110504454787244041,
      "target": "Cos to udělal!?"
    },
    {
      "id": 110504454787244040,
      "target": "Buddy: Zabil jsem ji…"
    },
    {
      "id": 110504454787244039,
      "target": "Buddy: …"
    },
    {
      "id": 110504454787244038,
      "target": "Buddy: Já…"
    },
    {
      "id": 110504454787244037,
      "target": "Buddy: Ona nezemřela…"
    },
    {
      "id": 110504454787244036,
      "target": "Buddy: Právě v tom to je. Byla sice stará a nemocná, ale…"
    },
    {
      "id": 110504454787244035,
      "target": "A co?"
    },
    {
      "id": 110504454787244034,
      "target": "A co je na tom?"
    },
    {
      "id": 110504454787244033,
      "target": "Buddy: Měl jsem fenku a před pár dny… zemřela."
    },
    {
      "id": 110504454787244032,
      "target": "Buddy: Dobře, když už ti to musím říct…"
    },
    {
      "id": 110504454783049738,
      "target": "Buddy: …"
    },
    {
      "id": 110504454783049737,
      "target": "Buddy: Chceš mě odprásknout, kámo?"
    },
    {
      "id": 110504454783049736,
      "target": "A co?"
    },
    {
      "id": 110504454783049735,
      "target": "A co je na tom?"
    },
    {
      "id": 110504454783049734,
      "target": "Buddy: Měl jsem fenku a před pár dny… zemřela."
    },
    {
      "id": 110504454783049733,
      "target": "Buddy: Jenže… Už to dál nezvládnu."
    },
    {
      "id": 110504454783049732,
      "target": "Buddy: …"
    },
    {
      "id": 110504454783049731,
      "target": "Buddy: Já nemůžu… Budeš se na mě dívat skrz prsty."
    },
    {
      "id": 110504454783049730,
      "target": "Budeš mi to muset říct. Jinak to bude horší"
    },
    {
      "id": 110504454783049729,
      "target": "Prostě mi řekni, co se s tebou děje"
    },
    {
      "id": 110504454783049728,
      "target": "Buddy: Do toho ti nic není, kámo! Dej mi pokoj!"
    },
    {
      "id": 110504454778855433,
      "target": "Tak povídej, co se s tebou děje?"
    },
    {
      "id": 110504454778855432,
      "target": "Buddy: Ptej se, kámo."
    },
    {
      "id": 110504454778855431,
      "target": "Buddy: Díky, vážně mi není dobře."
    },
    {
      "id": 110504454778855430,
      "target": "Buddy: Nech mě být."
    },
    {
      "id": 110504454778855429,
      "target": "Buddy: Netlač na mě! Už tak mě to tíží."
    },
    {
      "id": 110504454778855428,
      "target": "Dobře, nebudu do toho rýpat"
    },
    {
      "id": 110504454778855427,
      "target": "Potřebuju to vědět"
    },
    {
      "id": 110504454778855426,
      "target": "Buddy: Poslouchej, vážně o tom nechci mluvit."
    },
    {
      "id": 110504454778855425,
      "target": "Dobře, nebudu do toho rýpat"
    },
    {
      "id": 110504454778855424,
      "target": "Potřebuju to vědět"
    },
    {
      "id": 110504454774661130,
      "target": "Buddy: To je jedno, stejně bys to nepochopil."
    },
    {
      "id": 110504454774661129,
      "target": "O čem to mluvíš?"
    },
    {
      "id": 110504454774661128,
      "target": "Jaké téma?"
    },
    {
      "id": 110504454774661127,
      "target": "Buddy: Nechci to téma otevírat."
    },
    {
      "id": 110504454774661126,
      "target": "Buddy: …"
    },
    {
      "id": 110504454774661125,
      "target": "Buddy: Já…"
    },
    {
      "id": 110504454774661123,
      "target": "Dneska jsi nějaký zachmuřený"
    }
  ]
