  "entries": [
    {
      "id": 110504457207357440,
      "target": "GraveDigger: Och, díky, chlape!"
    },
    {
      "id": 110504457203163142,
      "target": "GraveDigger: Rád bych k tobě šel, ale víš…"
    },
    {
      "id": 110504457203163141,
      "target": "GraveDigger: Do háje, ty už tu máš {0}."
    },
    {
      "id": 110504457203163140,
      "target": "No nic. Za pokus to stálo."
    },
    {
      "id": 110504457203163139,
      "target": "Ech, myslel jsem, že si trochu odpočinu."
    },
    {
      "id": 110504457203163138,
      "target": "Tak platí!"
    },
    {
      "id": 110504457198968842,
      "target": "Kým? Podívej se, tamta {0}."
    },
    {
      "id": 110504457198968841,
      "target": "Jejda, ty už tu máš útulný koutek obsazený."
    },
    {
      "id": 110504457198968840,
      "target": "Provocateur: Podrobnosti nájmu pak probereme."
    },
    {
      "id": 110504457198968839,
      "target": "Provocateur: Děkuji vám, pane majiteli."
    },
    {
      "id": 110504457198968836,
      "target": "Provocateur: Říkají vám něco články 28, 48 a 7.3 ústavy?"
    },
    {
      "id": 110504457198968835,
      "target": "Provocateur: Věděl jste, že tenhle člověk je zarytý porušovatel zákona?"
    },
    {
      "id": 110504457198968834,
      "target": "Provocateur: Hm… vidím, že doma už máte {0}."
    },
    {
      "id": 110504457198968833,
      "target": "TaxiDriver: Vlastně to chápu. Ale je to teda pěkně v prdeli…"
    },
    {
      "id": 110504457198968832,
      "target": "TaxiDriver: Zastav se někdy za mnou, pokecáme."
    },
    {
      "id": 110504457194774539,
      "target": "TaxiDriver: Uf, díky, chlape. Zachraňuješ mě!"
    },
    {
      "id": 110504457194774536,
      "target": "TaxiDriver: Tak se rozhodni: buď on, nebo já."
    }
  ]
}
