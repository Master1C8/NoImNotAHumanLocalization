  "entries": [
    {
      "id": 110504454342647818,
      "target": "Anxiety: Co když…"
    },
    {
      "id": 110504454342647817,
      "target": "Anxiety: Už vůbec nevím, komu můžu věřit."
    },
    {
      "id": 110504454342647816,
      "target": "Anxiety: Promiňte, jsem jako na trní."
    },
    {
      "id": 110504454342647815,
      "target": "Nehodlám tě zabít"
    },
    {
      "id": 110504454342647814,
      "target": "Uklidni se, nejsem Host"
    },
    {
      "id": 110504454342647813,
      "target": "Anxiety: NECHCI UMÍRAT V MUKÁCH. PROSÍM, NEDĚLEJTE TO."
    },
    {
      "id": 110504454342647812,
      "target": "Anxiety: PROSÍM, NEDĚLEJTE TO! RADŠI MĚ ZABIJTE RYCHLE A BEZ BOLESTI."
    },
    {
      "id": 110504454342647811,
      "target": "Anxiety: Zabijete mě? Stáhnete ze mě kůži?"
    },
    {
      "id": 110504454342647810,
      "target": "Anxiety: Co když jste Host?"
    },
    {
      "id": 110504454342647809,
      "target": "Anxiety: …"
    },
    {
      "id": 110504454342647808,
      "target": "Anxiety: Už vůbec nevím, kdo je Host a kdo ne. Co když…"
    },
    {
      "id": 110504454338453515,
      "target": "Anxiety: …"
    },
    {
      "id": 110504454338453514,
      "target": "Anxiety: Já…"
    },
    {
      "id": 110504454338453513,
      "target": "Kdybych chtěl, už bych tě dávno zabil"
    },
    {
      "id": 110504454338453512,
      "target": "Jak tě to napadlo?"
    },
    {
      "id": 110504454338453511,
      "target": "Anxiety: Promiňte, já… myslela jsem, že mě chcete zabít."
    },
    {
      "id": 110504454338453510,
      "target": "Anxiety: …"
    },
    {
      "id": 110504454338453509,
      "target": "Anxiety: NEPŘIBLIŽUJTE SE KE MNĚ!!!"
    },
    {
      "id": 110504454338453507,
      "target": "Jsi v pořádku?"
    },
    {
      "id": 110504454338453506,
      "target": "Anxiety: E-e-ech. Doufám, že to všechno brzy skončí."
    },
    {
      "id": 110504454338453505,
      "target": "Anxiety: Všichni zemřeme."
    },
    {
      "id": 110504454338453504,
      "target": "Anxiety: …"
    },
    {
      "id": 110504454334259214,
      "target": "Anxiety: NECHCI UMÍRAT! NECHCI!"
    },
    {
      "id": 110504454334259213,
      "target": "Anxiety: PROČ TO ŘÍKÁTE? TEĎ SE BOJÍM JEŠTĚ VÍC."
    },
    {
      "id": 110504454334259212,
      "target": "Anxiety: Ach, radši si odpočinu. Zase mě kroutí v břiše."
    },
    {
      "id": 110504454334259211,
      "target": "Anxiety: …"
    },
    {
      "id": 110504454334259210,
      "target": "Anxiety: Děkuju, je mi klidněji."
    },
    {
      "id": 110504454334259209,
      "target": "Anxiety: Musím si odpočinout, zase mě kroutí v břiše. Ach…"
    },
    {
      "id": 110504454334259208,
      "target": "Anxiety: …"
    },
    {
      "id": 110504454334259207,
      "target": "Anxiety: PROČ TO ŘÍKÁTE? VŽDYŤ SE BOJÍM."
    },
    {
      "id": 110504454334259206,
      "target": "Vypadá to, že jsi Host"
    },
    {
      "id": 110504454334259205,
      "target": "Nejsi Host"
    },
    {
      "id": 110504454334259204,
      "target": "Nevím"
    },
    {
      "id": 110504454334259203,
      "target": "Anxiety: Vždyť nejsem Host, že ne? Řekněte, že je to pravda!"
    },
    {
      "id": 110504454334259202,
      "target": "Anxiety: Ne, to nemůže být pravda. Pamatuju si svůj život. Svoje dětství, mámu, tátu. Ne!"
    },
    {
      "id": 110504454334259201,
      "target": "Anxiety: Že můžu být Hostem."
    },
    {
      "id": 110504454334259200,
      "target": "Anxiety: …"
    },
    {
      "id": 110504454330064907,
      "target": "Anxiety: Že já…"
    },
    {
      "id": 110504454330064906,
      "target": "Anxiety: Počkejte, snad nechcete říct, že já…"
    }
  ]
}
