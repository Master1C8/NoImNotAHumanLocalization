  "entries": [
    {
      "id": 110504452409073673,
      "target": "Blind: Tiše…"
    },
    {
      "id": 110504452409073672,
      "target": "Blind: ..."
    },
    {
      "id": 110504452409073671,
      "target": "Blind: Slyšel jsi to?"
    },
    {
      "id": 110504452409073668,
      "target": "Blind: Ani mi neukážeš výsledek."
    },
    {
      "id": 110504452409073667,
      "target": "Blind: ..."
    },
    {
      "id": 110504452409073666,
      "target": "Blind: Hehe, klidně použij blesk. Mně je to jedno."
    },
    {
      "id": 110504452404879370,
      "target": "Blind: Teď už vím."
    },
    {
      "id": 110504452404879369,
      "target": "Blind: Ne?"
    },
    {
      "id": 110504452404879368,
      "target": "Blind: Víš, co lepkavý stín pokryje jako první?"
    },
    {
      "id": 110504452404879367,
      "target": "Blind: ..."
    },
    {
      "id": 110504452404879366,
      "target": "Blind: Ha… to je vtipné."
    },
    {
      "id": 110504452404879363,
      "target": "Blind: ONO se rádo nechává pozorovat. Netroufám si HO popsat – hrůzy jeho velkoleposti jsou pro smrtelnou mysl příliš obludné."
    },
    {
      "id": 110504452404879362,
      "target": "Blind: ..."
    },
    {
      "id": 110504452404879361,
      "target": "Blind: Hahahahaha… Dobře, na tom není nic neobvyklého. Tady jsou!"
    },
    {
      "id": 110504452396490766,
      "target": "Blind: Stěny, stěny, dveře, okna, a ONO bylo blízko…"
    },
    {
      "id": 110504452396490765,
      "target": "Blind: Lebka na kusy rozervaná a mozek tekl skrz stěny"
    },
    {
      "id": 110504452396490764,
      "target": "Blind: Žral jsem, řval, blil a trhal se na kusy"
    },
    {
      "id": 110504452396490763,
      "target": "Blind: Ale tehdy… Tehdy…"
    },
    {
      "id": 110504452396490762,
      "target": "Blind: Ha. Dobře. Takže ze mě ještě nevytáhlo všechno."
    },
    {
      "id": 110504452396490761,
      "target": "Blind: ..."
    },
    {
      "id": 110504452396490760,
      "target": "Blind: Hýbou se?"
    },
    {
      "id": 110504452396490757,
      "target": "Blind: Teď se mé ruce chytají prázdna. Čekají, až mi smrt dovolí na všechno zapomenout."
    },
    {
      "id": 110504452396490756,
      "target": "Blind: Prsty se mi bolestivě sevřely, když jsem pohledem přejel po TOM."
    },
    {
      "id": 110504452396490755,
      "target": "Blind: Žvýkal jsem pravdu, dusil se jí, až se mi patro sevřelo v hrdle."
    },
    {
      "id": 110504452396490754,
      "target": "Blind: ..."
    },
    {
      "id": 110504452396490753,
      "target": "Blind: Oni jsou mimochodem poslední svědci."
    },
    {
      "id": 110504452392296453,
      "target": "Blind: Můžeš mě prohlížet, jak dlouho chceš. Ale víš… nic se nezmění. Všechno je to jen dočasné."
    }
  ]
}
