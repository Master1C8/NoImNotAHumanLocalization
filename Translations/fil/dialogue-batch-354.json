    {"id": 110504453369569285, "target": "Cultist2: …"},
    {"id": 110504453369569282, "target": "Cultist2: Ang… kawili-wili."},
    {"id": 110504453369569281, "target": "Cultist2: ..."},
    {"id": 110504453369569280, "target": "Cultist2: Medyo kinakabahan ako."},
    {"id": 110504453365374983, "target": "Cultist2: Hindi pa ako nakukunan ng litrato kahit kailan."},
    {"id": 110504453365374980, "target": "Cultist2: …"},
    {"id": 110504453365374979, "target": "Cultist2: ..."},
    {"id": 110504453365374978, "target": "Cultist2: …"},
    {"id": 110504453361180680, "target": "Cultist2: Sabi nila, pinabibilis din nito ang Kaniyang pagdating."},
    {"id": 110504453361180679, "target": "Cultist2: ..."},
    {"id": 110504453361180678, "target": "Cultist2: Kaunti lang ang tulog namin."},
    {"id": 110504453361180675, "target": "Cultist2: Oo, hindi madali ang buhay namin."},
    {"id": 110504453361180674, "target": "Cultist2: ..."},
    {"id": 110504453361180673, "target": "Cultist2: …"},
    {"id": 110504453356986374, "target": "Cultist2: …"},
    {"id": 110504453356986373, "target": "Cultist2: ..."},
    {"id": 110504453356986372, "target": "Cultist2: Medyo baluktot at mas malaki nang kaunti kaysa sa iba."},
    {"id": 110504453356986371, "target": "Cultist2: Oo, siyempre."},
    {"id": 110504453352792069, "target": "Cultist2: Hindi dapat matakot. Magtutungo tayong lahat sa mas mabuting buhay. Ililigtas nila tayo."}
  ]
}
