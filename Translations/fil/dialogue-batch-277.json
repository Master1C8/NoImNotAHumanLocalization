  "entries": [
    {
      "id": 110504454418145286,
      "target": "Widow: Gusto kong maniwala roon."
    },
    {
      "id": 110504454418145285,
      "target": "Widow: Gustong-gusto kong…"
    },
    {
      "id": 110504454418145284,
      "target": "Widow: Naririnig pa rin niya ako."
    },
    {
      "id": 110504454418145283,
      "target": "Widow: Hindi, hindi iyon totoo."
    },
    {
      "id": 110504454418145282,
      "target": "Widow: Hindi."
    },
    {
      "id": 110504454418145281,
      "target": "Widow: …"
    },
    {
      "id": 110504454418145280,
      "target": "Widow: Hindi ko siya ibibigay sa lupang walang kaluluwa."
    },
    {
      "id": 110504454413950982,
      "target": "Widow: Hindi ko kaya iyon."
    },
    {
      "id": 110504454413950981,
      "target": "Widow: At muli na namang mahiwalay sa kaniya."
    },
    {
      "id": 110504454413950980,
      "target": "Widow: Kamakailan lang nila siya ibinalik sa akin."
    },
    {
      "id": 110504454413950979,
      "target": "Widow: Hindi pa ako handa."
    },
    {
      "id": 110504454413950978,
      "target": "Widow: Hindi-hindi-hindi-hindi."
    },
    {
      "id": 110504454413950977,
      "target": "Widow: Hiiiiindi."
    },
    {
      "id": 110504454413950976,
      "target": "Katawan na lang ang natira sa kaniya. Kailangan mong tanggapin iyon"
    },
    {
      "id": 110504454409756678,
      "target": "Kailangan siyang ilibing"
    },
    {
      "id": 110504454409756677,
      "target": "Widow: Tumigil na lang sa pag-iyak."
    },
    {
      "id": 110504454409756676,
      "target": "Widow: Pero tama ba iyon?"
    },
    {
      "id": 110504454409756675,
      "target": "Widow: Para bang wala na akong mailuha."
    },
    {
      "id": 110504454409756674,
      "target": "Widow: Kamakailan lang, naubos ang lahat ng luha ko."
    },
    {
      "id": 110504454409756673,
      "target": "Widow: Sobra na ito."
    },
    {
      "id": 110504454409756672,
      "target": "Widow: Hindi ko pa kaya."
    },
    {
      "id": 110504454405562378,
      "target": "Paano siya namatay?"
    },
    {
      "id": 110504454405562377,
      "target": "Widow: Makapagpahinga lang sana ako nang kaunti…"
    }
  ]
}
