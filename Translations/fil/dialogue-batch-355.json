  "entries": [
    {"id": 110504453352792068, "target": "Cultist1: Pagkakamali iyon."},
    {"id": 110504453352792067, "target": "Cultist1: Haharapin mo ang mga bunga ng pinili mo."},
    {"id": 110504453352792066, "target": "Cultist1: …"},
    {"id": 110504453352792065, "target": "Cultist1: Matagal na akong hindi nakukunan ng litrato."},
    {"id": 110504453352792064, "target": "Cultist1: …"},
    {"id": 110504453348597768, "target": "Cultist1: …"},
    {"id": 110504453348597767, "target": "Cultist1: Wala akong masabi."},
    {"id": 110504453348597766, "target": "Cultist1: Hindi ko alam kung ano ang hinihintay mo."},
    {"id": 110504453348597765, "target": "Cultist1: Basta maging handa kang umalis pagdating ng oras."},
    {"id": 110504453348597764, "target": "Cultist1: Para saan pa ang mga pagsusuring iyan?"},
    {"id": 110504453348597761, "target": "Cultist1: …"},
    {"id": 110504453344403462, "target": "Cultist1: Huwag na."},
    {"id": 110504453344403459, "target": "Cultist1: …"},
    {"id": 110504453344403456, "target": "Cultist1: Hindi mo dapat gawin iyan."},
    {"id": 110504453340209158, "target": "Cultist1: …"},
    {"id": 110504453340209155, "target": "Cultist1: Masyado pang maaga."},
    {"id": 110504453340209152, "target": "Cultist1: …"},
    {"id": 110504453336014855, "target": "Cultist1: ..."},
    {"id": 110504453336014854, "target": "Cultist1: …"},
    {"id": 110504453336014851, "target": "Cultist1: …"},
    {"id": 110504453336014850, "target": "Cultist1: ..."},
    {"id": 110504453336014849, "target": "Cultist1: Sige, bakit hindi?"},
    {"id": 110504453336014848, "target": "Cultist1: …"},
    {"id": 110504453331820549, "target": "Cultist1: …"},
    {"id": 110504453331820548, "target": "Cultist1: ..."},
    {"id": 110504453331820547, "target": "Cultist1: …"},
    {"id": 110504453331820544, "target": "Cultist1: Pagod na akong maghanda."},
    {"id": 110504453327626247, "target": "Cultist1: ..."},
    {"id": 110504453327626246, "target": "Cultist1: …"},
    {"id": 110504453327626243, "target": "Cultist1: …"},
