    {
      "id": 110504456037146633,
      "target": "Matutulog muna ako nang kaunti."
    },
    {
      "id": 110504456037146632,
      "target": "Napagod yata ako."
    },
    {
      "id": 110504456037146631,
      "target": "…"
    },
    {
      "id": 110504456037146630,
      "target": "Sana makatagpo ko silang muli kasama ang buong pamilya."
    },
    {
      "id": 110504456037146629,
      "target": "May darating kaya sa akin?"
    },
    {
      "id": 110504456037146628,
      "target": "Bakit nila ako pinapasok dito?"
    },
    {
