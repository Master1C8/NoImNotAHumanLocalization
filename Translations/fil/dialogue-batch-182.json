    },
    {
      "id": 110504455659659269,
      "target": "Ballerina: Ipinipikit mo ba ang mga mata mo kapag nagpapaputok ka?"
    },
    {
      "id": 110504455659659268,
      "target": "Ballerina: Hindi mo ako tinamaan! Ang lapit-lapit ko lang."
