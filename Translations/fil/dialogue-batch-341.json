  "entries": [
    {"id": 110504453747056647, "target": "..."},
    {"id": 110504453747056646, "target": "Ano ba ang ulat na iyon?"},
    {"id": 110504453747056645, "target": "…"},
    {"id": 110504453747056644, "target": "Ayos naman ang mga tainga."},
    {"id": 110504453747056643, "target": "..."},
    {"id": 110504453747056642, "target": "..."},
    {"id": 110504453747056641, "target": "Kailangan kong maghilamos. Sana makatulong."},
    {"id": 110504453747056640, "target": "…"},
    {"id": 110504453742862345, "target": "Mukhang iritasyon ito o, mas malala, halamang-singaw."},
    {"id": 110504453742862344, "target": "Putangina, ano'ng impiyernong bagay ito!?"},
    {"id": 110504453742862343, "target": "Gaya ng nararapat."},
    {"id": 110504453742862342, "target": "May buhok sa mga kilikili."},
    {"id": 110504453742862341, "target": "..."},
    {"id": 110504453742862340, "target": "..."},
    {"id": 110504453742862339, "target": "Hindi pula, kaya walang maipipintas."},
    {"id": 110504453742862338, "target": "Karaniwang mga mata lang."},
    {"id": 110504453742862337, "target": "Hindi sana ako uminom ng putanginang inuming may caffeine."},
    {"id": 110504453742862336, "target": "Putangina. Pula ang mga mata ko…"},
    {"id": 110504453738668032, "target": "..."},
    {"id": 110504453591867397, "target": "..."},
    {"id": 110504453591867396, "target": "May bakas ng pulbura sa mga fingerprint ko. Pero maliit na bagay iyon."},
    {"id": 110504453591867395, "target": "Malinis ang mga kamay…"},
    {"id": 110504453591867394, "target": "Dahil lahat ito sa kuwebang hinuhukay ko."},
    {"id": 110504453591867393, "target": "Maruruming kuko…"},
    {"id": 110504453591867392, "target": "..."},
    {"id": 110504453587673095, "target": "..."},
    {"id": 110504453587673094, "target": "Mabuti na rin iyon. Hindi nila ako mapagkakamalang Panauhin."},
    {"id": 110504453587673093, "target": "Dilaw na mga ngipin…"},
    {"id": 110504453587673092, "target": "Ipagbibili ng mga naninigarilyo ang isang bato para magkaroon ng ganito."},
    {"id": 110504453587673091, "target": "Lintik, mapuputi…"},
    {"id": 110504453587673090, "target": "..."},
    {"id": 110504453587673089, "target": "..."},
    {"id": 110504453587673088, "target": "Maghilamos"},
    {"id": 110504453583478786, "target": "Kailangan kong suriin ang sarili ko."}
  ]
}
