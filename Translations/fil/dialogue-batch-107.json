  "entries": [
    {
      "id": 110504456574017540,
      "target": "Ballerina: May regalo ako sa iyo."
    },
    {
      "id": 110504456574017539,
      "target": "Ballerina: Makikita mo ang pusa sa ilalim ng bahay."
    },
    {
      "id": 110504456574017538,
      "target": "Ballerina: …"
    },
    {
      "id": 110504456574017537,
      "target": "Ballerina: Halika, mingming, aliwin mo ako rito, ha?"
    },
    {
      "id": 110504456574017536,
      "target": "Ballerina: Parang nasa bahay ka lang."
    },
    {
      "id": 110504456569823243,
      "target": "Lumayas ka na, putangina"
    },
    {
      "id": 110504456569823242,
      "target": "…Pasok ka"
    },
    {
      "id": 110504456569823241,
      "target": "Ballerina: Pag-isipan mo ulit."
    },
    {
      "id": 110504456569823240,
      "target": "Ballerina: Nakikita mo ba ang pusa?"
    },
    {
      "id": 110504456569823239,
      "target": "Ballerina: At huwag mo ring pahirapan ang pusa."
    },
    {
      "id": 110504456569823238,
      "target": "Ballerina: Hindi dapat hayaang ginawin ang isang babae sa labas, binata."
    },
    {
      "id": 110504456569823237,
      "target": "Ballerina: …"
    },
    {
      "id": 110504456569823234,
      "target": "Ballerina: Bubuksan mo ba? Hindi?"
    },
    {
      "id": 110504456569823233,
      "target": "Ballerina: Nakapasa ba ako sa lahat ng pagsubok mo?"
    },
    {
      "id": 110504456569823232,
      "target": "Ballerina: Hindi pa sapat iyon?"
    },
    {
      "id": 110504456565628939,
      "target": "Ballerina: May dalawa akong braso, dalawang binti, at isang ulo."
    },
    {
      "id": 110504456565628936,
      "target": "Ballerina: Sige na, magpasya ka. Ano ang gagawin natin?"
    },
    {
      "id": 110504456565628935,
      "target": "Ballerina: Isa akong sapatos pambalete."
    },
    {
      "id": 110504456565628934,
      "target": "Ballerina: Baka sumayaw pa ako."
    },
    {
      "id": 110504456565628933,
      "target": "Ballerina: Sasayaw ba ako para sa iyo?"
    },
    {
      "id": 110504456565628932,
      "target": "Ballerina: E ano naman?"
    },
    {
      "id": 110504456565628931,
      "target": "Patunayan mong tao ka"
    },
    {
      "id": 110504456565628930,
      "target": "Hindi ako naniniwalang tao ka"
    },
    {
      "id": 110504456565628929,
      "target": "Ballerina: Kakaibang pangungusap."
    },
    {
      "id": 110504456565628928,
      "target": "Ballerina: Ano ang susunod? Naipaalala ko ba siya sa iyo? O ano?"
    },
    {
      "id": 110504456561434635,
      "target": "Ballerina: Eh… sige."
    },
    {
      "id": 110504456561434634,
      "target": "Patunayan mong tao ka"
    },
    {
      "id": 110504456561434633,
      "target": "Hindi ako naniniwalang tao ka"
    }
  ]
}
