  "entries": [
    {
      "id": 110504454455894021,
      "target": "Widow: Sana matagpuan ninyo ang hinahanap ninyo."
    },
    {
      "id": 110504454455894020,
      "target": "Widow: Kaunti lang kayong magsalita, pero… mabuti pala kayong kausap."
    },
    {
      "id": 110504454455894019,
      "target": "Widow: Salamat."
    },
    {
      "id": 110504454455894018,
      "target": "Widow: Ayaw kong magpasya sa anuman hangga’t hindi ako nakakabalik."
    },
    {
      "id": 110504454455894017,
      "target": "Widow: Gustong-gusto ko nang umuwi."
    },
    {
      "id": 110504454455894016,
      "target": "Widow: Wala akong nadarama sa iyo, patawad."
    },
    {
      "id": 110504454451699715,
      "target": "Widow: Hindi naman gagaan ang pakiramdam ko."
    },
    {
      "id": 110504454451699714,
      "target": "Widow: Bakit?"
    },
    {
      "id": 110504454451699713,
      "target": "Sana suwertehin ka"
    },
    {
      "id": 110504454451699712,
      "target": "Puwede kang manatili"
    },
    {
      "id": 110504454447505416,
      "target": "Widow: Wala na akong ibang gusto."
    },
    {
      "id": 110504454447505415,
      "target": "Widow: Uuwi kami."
    },
    {
      "id": 110504454447505414,
      "target": "Widow: Wala nang natira."
    },
    {
      "id": 110504454447505413,
      "target": "Sana suwertehin ka"
    },
    {
      "id": 110504454447505412,
      "target": "Puwede kang manatili"
    },
    {
      "id": 110504454447505411,
      "target": "Widow: At pagdating doon…"
    },
    {
      "id": 110504454447505410,
      "target": "Widow: Kukunin ko ang gitara."
    },
    {
      "id": 110504454447505409,
      "target": "Widow: Uuwi ako."
    },
    {
      "id": 110504454447505408,
      "target": "Widow: Ayaw kong isipin iyon."
    },
    {
      "id": 110504454443311116,
      "target": "Pupunta ka ba sa mga kamag-anak mo?"
    },
    {
      "id": 110504454443311115,
      "target": "Ano na ngayon?"
    },
    {
      "id": 110504454443311114,
      "target": "Widow: Kailangan ko lang magpahinga."
    },
    {
      "id": 110504454443311113,
      "target": "Widow: Sinabi ko na agad na hindi ako magtatagal dito."
    },
    {
      "id": 110504454443311112,
      "target": "Widow: Aalis ako ngayong gabi."
    },
    {
      "id": 110504454443311110,
      "target": "May mali ba?"
    },
    {
      "id": 110504454443311109,
      "target": "Widow: Makapagpahinga lang sana ako nang kaunti…"
    },
    {
      "id": 110504454443311108,
      "target": "Widow: Napakahirap mabuhay ngayon nang wala siya…"
    },
    {
      "id": 110504454443311107,
      "target": "Widow: Oo. Pakiusap."
    },
    {
      "id": 110504454443311106,
      "target": "Widow: Gusto kong mapag-isa."
    }
  ]
}
