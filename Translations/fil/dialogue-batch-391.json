  "entries": [
    {
      "id": 110504452622983176,
      "target": "Luka: Lagi akong handang makinig sa iyo."
    },
    {
      "id": 110504452622983175,
      "target": "Luka: ..."
    },
    {
      "id": 110504452622983174,
      "target": "Luka: Sige."
    },
    {
      "id": 110504452622983173,
      "target": "Luka: Pero lagi akong handang makinig sa iyo."
    },
    {
      "id": 110504452622983172,
      "target": "Luka: ..."
    },
    {
      "id": 110504452622983171,
      "target": "Luka: Hindi naririnig sa Sansinukob ang mga tinig natin."
    },
    {
      "id": 110504452622983168,
      "target": "Luka: Isa pang bagay na mananatili kapag wala na ako."
    },
    {
      "id": 110504452618788874,
      "target": "Luka: Isa pang bagay na mananatili kapag wala na ako. Kung may matitira pa sanang tao pagkatapos natin."
    },
    {
      "id": 110504452618788873,
      "target": "Luka: ..."
    },
    {
      "id": 110504452618788872,
      "target": "Luka: Sige."
    },
    {
      "id": 110504452618788869,
      "target": "Luka: Mukhang wala namang kakaiba, di ba?"
    },
    {
      "id": 110504452618788868,
      "target": "Luka: ..."
    },
    {
      "id": 110504452618788867,
      "target": "Luka: Hindi ko alam na mahalaga rin pala ito."
    },
    {
      "id": 110504452618788864,
      "target": "Luka: Maraming natatandaan ang mga mata."
    },
    {
      "id": 110504452614594570,
      "target": "Luka: ..."
    },
    {
      "id": 110504452614594569,
      "target": "Luka: Siyempre."
    },
    {
      "id": 110504452614594566,
      "target": "Luka: Lahat ng natira matapos ang mga pagkawala."
    },
    {
      "id": 110504452614594565,
      "target": "Luka: ..."
    },
    {
      "id": 110504452614594564,
      "target": "Luka: Heto ang mga iyon."
    },
    {
      "id": 110504452614594561,
      "target": "Luka: Interesante, marami kayang nasasabi ang mga ngipin tungkol sa isang tao?.."
    },
    {
      "id": 110504452614594560,
      "target": "Luka: ..."
    },
    {
      "id": 110504452610400266,
      "target": "Luka: Heto, tingnan mo."
    },
    {
      "id": 110504452610400259,
      "target": "Luka: Suriin mo ako kung makatutulong iyon sa iyo."
    }
  ]
}
