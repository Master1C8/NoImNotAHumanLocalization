{
  "schemaVersion": 1,
  "locale": "fil",
  "sourceSpecSha256": "13a6edc02ab914becdd86af5e8829299c7a7b11ff3c300e61b3aed023b441368",
  "editorialStatus": "development draft; independent mechanics review pending",
  "sourceInterpretationNotes": {
    "line:Foreigner_Death_0f116b2": "Damaged Russian keyboard-layout fragment interpreted as killing, not a person named Ivan.",
    "line:Foreigner_Photo_0c3c7aa": "Damaged photo/adoration wording interpreted using neighboring Photo_DontShoot preference for photos; exact damaged syntax unresolved."
  },
  "entries": [
    {
      "key": "line:FEMA_GivingPostcard_Foreigner_0af7d0d",
      "parts": [
        {
          "kind": "opaque",
          "text": "Sige, kukunin ko..."
        }
      ]
    },
    {
      "key": "line:FEMA_GivingPostcard_Foreigner_0cc7047",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ano ito?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_1_0e957d2",
      "parts": [
        {
          "kind": "understood",
          "text": "Suwerrtehin ka!",
          "sourceCue": "Уууудаси!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_1_0c936e3",
      "parts": [
        {
          "kind": "opaque",
          "text": "Baka makauwi na ako pagkatapos ng napakatagal…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_1_0905b5d",
      "parts": [
        {
          "kind": "opaque",
          "text": "Pero bukas pupunta ako sa istasyon at aalamin ko mismo!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_1_0e19b62",
      "parts": [
        {
          "kind": "opaque",
          "text": "Hindi ko naintindihan, pasensiya."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_0ee031f",
      "parts": [
        {
          "kind": "understood",
          "text": "Paaalaam!",
          "sourceCue": "Пайкааа!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_02340b2",
      "parts": [
        {
          "kind": "opaque",
          "text": "Aalis ako ngayong gabi. Paalam!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_04527f2",
      "parts": [
        {
          "kind": "opaque",
          "text": "Bukas uuwi ako! Kahit makapunta man lang sa istasyon."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_08b6c83",
      "parts": [
        {
          "kind": "opaque",
          "text": "Hindi ko maintindihan, kaibigan."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_5_058e3f1",
      "parts": [
        {
          "kind": "opaque",
          "text": "Naipaliwanag nila sa akin na umaandar pa ang mga tren! Isipin mo iyon!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_5_0a05381",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ah, iyon pala ang sinasabi mo."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_2_043501e",
      "parts": [
        {
          "kind": "opaque",
          "text": "Naglalayag pa ba sila? Kailangan kong maghanap ng impormasyon, salamat!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_2_020fa6b",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ibig mong sabihin, sumakay sa barko?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_1_0264fa8",
      "parts": [
        {
          "kind": "opaque",
          "text": "Baka puwede pa talagang lumipad palayo."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_1_03e6625",
      "parts": [
        {
          "kind": "opaque",
          "text": "Kailangan kong maghanap ng impormasyon kung saan man."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_1_06190d7",
      "parts": [
        {
          "kind": "opaque",
          "text": "Eroplano? Sa tingin mo lumilipad pa sila?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_0f3f5f9",
      "parts": [
        {
          "kind": "opaque",
          "text": "Putanginang sitwasyon ito, wala akong ibang masabi."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_00450ac",
      "parts": [
        {
          "kind": "opaque",
          "text": "Dumalaw lang ako sa kaibigan ko, tapos ganito."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_04109c2",
      "parts": [
        {
          "kind": "opaque",
          "text": "Bahay? Tungkol sa bahay ang tanong mo?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_0ba0261",
      "parts": [
        {
          "kind": "opaque",
          "text": "Nakakakilabot."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_084c32d",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ganito rin kaya ang nangyayari sa amin?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_05970a6",
      "parts": [
        {
          "kind": "opaque",
          "text": "Mahirap nga, pero baka makatulong sa akin."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_0ef9d29",
      "parts": [
        {
          "kind": "understood",
          "text": "Mabutii.",
          "sourceCue": "Харасхо."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_0a6ab5a",
      "parts": [
        {
          "kind": "understood",
          "text": "Mabu…",
          "sourceCue": "Хара…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_041d9b1",
      "parts": [
        {
          "kind": "understood",
          "text": "Mabutiii.",
          "sourceCue": "Харохооо."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_0a21905",
      "parts": [
        {
          "kind": "opaque",
          "text": "Susubukan kong ulitin."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_2_04c6bc4",
      "parts": [
        {
          "kind": "opaque",
          "text": "Baka salitang pantanong iyon."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_2_090b6a7",
      "parts": [
        {
          "kind": "opaque",
          "text": "Pero may itinanong ka."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_1_01c288c",
      "parts": [
        {
          "kind": "opaque",
          "text": "Baka salitang pantanong iyon."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_1_01a5f8a",
      "parts": [
        {
          "kind": "opaque",
          "text": "Hindi ko pa rin maintindihan. Pero may itinanong ka."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_09e3b4a",
      "parts": [
        {
          "kind": "understood",
          "text": "Paano.",
          "sourceCue": "Как."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_0f0190b",
      "parts": [
        {
          "kind": "opaque",
          "text": "Baka sa ganitong paraan maintindihan ko man lang ang sinasabi ko."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_075bcb9",
      "parts": [
        {
          "kind": "opaque",
          "text": "Puwede kong ulitin ang mga salita mo, saka ka tumugon."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_1_1_0ebd34d",
      "parts": [
        {
          "kind": "opaque",
          "text": "Gumawa kaya tayo ng wikang pareho nating alam?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_1_1_0cd4635",
      "parts": [
        {
          "kind": "opaque",
          "text": "Hindi kita maintindihan. Ano ang puwedeng gawin?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_1_0d71f9d",
      "parts": [
        {
          "kind": "opaque",
          "text": "TINAHI NILA ANG BIBIG KO! Dahil lang hindi nila ako maintindihan."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_1_09c22e5",
      "parts": [
        {
          "kind": "opaque",
          "text": "Para itong bangungot!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Death_0f116b2",
      "parts": [
        {
          "kind": "opaque",
          "text": "Pag… patay…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Death_0b50221",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ganiyan ang nangyayari. Hindi ka nila maintindihan, takot sila sa iyo, at ikaw…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Ears_DontShoot_00a90ca",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ibibigay ko ang lahat makita lang siyang muli. Miss na miss ko siya. "
        },
        {
          "kind": "understood",
          "text": "Pakiita",
          "sourceCue": "Пакаж"
        },
        {
          "kind": "opaque",
          "text": ", ano ang ibig sabihin niyon?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Photo_DontShoot_0bf7704",
      "parts": [
        {
          "kind": "opaque",
          "text": "Mahilig ako sa litrato. Mukhang hindi mo sila pinahahalagahan…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Armpit_DontShoot_05058dc",
      "parts": [
        {
          "kind": "understood",
          "text": "Suruin",
          "sourceCue": "Правирйат ба"
        },
        {
          "kind": "opaque",
          "text": " dito… Mukhang mali ito…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Eyes_DontShoot_044b445",
      "parts": [
        {
          "kind": "opaque",
          "text": "Mata lang naman. Bakit mo ako tinatakot?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Hands_DontShoot_062d5bf",
      "parts": [
        {
          "kind": "opaque",
          "text": "Dapat akong maghugas ng kamay…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Teeth_DontShoot_0f917b2",
      "parts": [
        {
          "kind": "opaque",
          "text": "Alam mong tinahi ang bibig ko. Ngayon tinututok mo pa ang baril at "
        },
        {
          "kind": "understood",
          "text": "bariil",
          "sourceCue": "расрел"
        },
        {
          "kind": "opaque",
          "text": " ang lahat…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Ears_Gun_022cef2",
      "parts": [
        {
          "kind": "opaque",
          "text": "At ano na?!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Armpit_Gun_0488113",
      "parts": [
        {
          "kind": "opaque",
          "text": "Pare! Tama na! Kalokohan ito!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Eyes_Gun_0bf3d2f",
      "parts": [
        {
          "kind": "opaque",
          "text": "Huwag! Mabuti ako! Hindi lang tayo nagkakaintindihan!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Hands_Gun_0b64782",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ilayo mo ang baril! Wala akong ginawang masama sa iyo!!!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Teeth_Gun_0a4207d",
      "parts": [
        {
          "kind": "opaque",
          "text": "Bakit, ano ba!? Ginawa ko ang gusto mo!!!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Ears_0f4eb6c",
      "parts": [
        {
          "kind": "opaque",
          "text": "Hikaw mula sa mahal kong kaibigan."
        }
      ]
    },
    {
      "key": "line:Foreigner_Ears_076f3a7",
      "parts": [
        {
          "kind": "opaque",
          "text": "Tainga lang naman."
        }
      ]
    },
    {
      "key": "line:Foreigner_Photo_002e8e0",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ipapakita mo?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Photo_0c3c7aa",
      "parts": [
        {
          "kind": "opaque",
          "text": "Litrato? Gustong-gusto ko iyan!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Armpit_0d48250",
      "parts": [
        {
          "kind": "opaque",
          "text": "Nasiyahan ka na?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Armpit_090c5f5",
      "parts": [
        {
          "kind": "opaque",
          "text": "Hindi ko maintindihan ang lahat ng ito… Sige na nga…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Eyes_0b39cdc",
      "parts": [
        {
          "kind": "opaque",
          "text": "Hindi ko maintindihan bakit mo ginagawa ito… Kayang sunugin ng "
        },
        {
          "kind": "understood",
          "text": "araaw",
          "sourceCue": "Солце"
        },
        {
          "kind": "opaque",
          "text": " ang retina. Hindi ako "
        },
        {
          "kind": "understood",
          "text": "tingiin",
          "sourceCue": "смарет"
        },
        {
          "kind": "opaque",
          "text": " sa "
        },
        {
          "kind": "understood",
          "text": "araaw",
          "sourceCue": "солце"
        },
        {
          "kind": "opaque",
          "text": "."
        }
      ]
    },
    {
      "key": "line:Foreigner_Eyes_0aba9fb",
      "parts": [
        {
          "kind": "opaque",
          "text": "Mata?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Hands_0144f06",
      "parts": [
        {
          "kind": "opaque",
          "text": "Bakit mo ginagawa ito? "
        },
        {
          "kind": "understood",
          "text": "Pataay",
          "sourceCue": "Убйивай"
        },
        {
          "kind": "opaque",
          "text": " para sa saya?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Hands_0654052",
      "parts": [
        {
          "kind": "opaque",
          "text": "Kamay? Sige."
        }
      ]
    },
    {
      "key": "line:Foreigner_Teeth_02674b3",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ano na ngayon?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Teeth_03ba689",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ano? Itinuturo mo ang "
        },
        {
          "kind": "understood",
          "text": "bibiig",
          "sourceCue": "рхот"
        },
        {
          "kind": "opaque",
          "text": "? Oo, tinahi iyon. Ano ngayon? Ngumiti?"
        }
      ]
    },
    {
      "key": "line:Foreigner_WannaCheck_0d955c8",
      "parts": [
        {
          "kind": "opaque",
          "text": "Wala akong maintindihan. Ano ang gusto mo sa akin?"
        }
      ]
    }
  ]
}
