    {"id": 110504453403123714, "target": "Cultist3: ..."},
    {"id": 110504453403123713, "target": "Cultist3: Sandali, nakasasagabal ang mga damit."},
    {"id": 110504453398929413, "target": "Cultist3: …"},
    {"id": 110504453398929412, "target": "Cultist3: ..."},
    {"id": 110504453398929411, "target": "Cultist3: …"},
    {"id": 110504453398929408, "target": "Cultist3: Maaaring mauna akong umalis kaysa sa mga kapatid ko."},
    {"id": 110504453394735112, "target": "Cultist3: ..."},
    {"id": 110504453394735111, "target": "Cultist3: Halos hindi na nakakakita ang mga mata ko."},
    {"id": 110504453394735108, "target": "Cultist3: Dapat nitong maakit ang Kamatayan. Mailigtas tayo."},
    {"id": 110504453394735107, "target": "Cultist3: ..."},
    {"id": 110504453394735106, "target": "Cultist3: Sa ganito, nagmumukha tayong mga dayuhan."},
    {"id": 110504453390540806, "target": "Cultist3: …"},
    {"id": 110504453390540805, "target": "Cultist3: ..."},
    {"id": 110504453390540804, "target": "Cultist3: Nakakatuwa rin sa akin kung paanong magkaiba ang pang-ibaba at pang-itaas na panga."},
    {"id": 110504453386346502, "target": "Cultist3: Gawin mo ang gusto mo. Huwag ka lang manggulo."}
  ]
}
