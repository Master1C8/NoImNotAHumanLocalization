  "entries": [
    {
      "id": 110504454460088327,
      "target": "Trabaho ba ang tingin mo riyan?"
    },
    {
      "id": 110504454460088326,
      "target": "At magkano ang kinita mo?"
    },
    {
      "id": 110504454460088325,
      "target": "Scammer: Dinadala sa akin ng mga tao ang pera nila at binabalik ko nang lima… hindi, sampung ulit ang laki."
    },
    {
      "id": 110504454460088324,
      "target": "Scammer: Propesyonal ako sa ginagawa ko, putangina."
    },
    {
      "id": 110504454460088323,
      "target": "Scammer: Kung alam mo lang ang dami ng perang dumaan sa mga kamay ko, maglalaway ka."
    },
    {
      "id": 110504454460088322,
      "target": "Scammer: E, ano ba, punyeta. Sports analyst ako, putangina."
    },
    {
      "id": 110504454460088321,
      "target": "Narinig ko na"
    },
    {
      "id": 110504454460088320,
      "target": "Adik ka ba sa sugal?"
    },
    {
      "id": 110504454455894027,
      "target": "Scammer: Sa pustahan sa sports?"
    },
    {
      "id": 110504454455894026,
      "target": "Scammer: May narinig ka na ba tungkol sa…"
    },
    {
      "id": 110504454455894025,
      "target": "Scammer: Ooo, natutuwa akong nagtanong ka."
    },
    {
      "id": 110504454455894023,
      "target": "Ano ang trabaho mo bago ang sakuna?"
    },
    {
      "id": 110504454455894022,
      "target": "Scammer: He-he. Ano, punyeta?"
    }
  ]
}
