  "entries": [
    {
      "id": 110504455991009281,
      "target": "Oo, sige, paalam."
    },
    {
      "id": 110504455991009280,
      "target": "Sige, dadalaw ako sa iyo mamayang halos gabi na."
    },
    {
      "id": 110504455986814985,
      "target": "Ayaw niya, pero ano bang magagawa?"
    },
    {
      "id": 110504455986814984,
      "target": "Oo, inihahanda na namin siya para sa pagpasok sa paaralan."
    },
    {
      "id": 110504455986814983,
      "target": "Pero sobrang init kahapon, kaya maaga kaming umalis."
    },
    {
      "id": 110504455986814982,
      "target": "Pumunta kami sa dalampasigan."
    },
    {
      "id": 110504455986814981,
      "target": "Oo, naaalala ko, oo."
    },
    {
      "id": 110504455986814980,
      "target": "Hindi ka ba nagsasawang manatili sa bahay?"
    },
    {
      "id": 110504455986814979,
      "target": "Kararating lang namin mula sa bakasyon."
    }
  ]
}
