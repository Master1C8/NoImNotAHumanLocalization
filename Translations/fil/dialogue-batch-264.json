  "entries": [
    {
      "id": 110504454535585797,
      "target": "Mamaya pa. Kinukumpuni pa iyon"
    },
    {
      "id": 110504454535585796,
      "target": "Daughter: Kailan po ako makakauwi?"
    },
    {
      "id": 110504454535585795,
      "target": "Daughter: Gusto ko na pong umuwi…"
    },
    {
      "id": 110504454535585794,
      "target": "Daughter: Ayos naman dito."
    },
    {
      "id": 110504454535585792,
      "target": "Kumusta ka? Gusto mo ba rito?"
    },
    {
      "id": 110504454531391500,
      "target": "Daughter: A... A-gusto kong pumunta kay Ma-mama."
    },
    {
      "id": 110504454531391499,
      "target": "Daughter: (Ni hindi ka naririnig ng batang babae. Nag-iisa siya sa kaniyang pagdadalamhati)"
    },
    {
      "id": 110504454531391498,
      "target": "Daughter: (Walang tigil sa pagtawag sa ama ang batang babae. Matatagalan pa bago humupa ang kaniyang pagwawala)"
    },
    {
      "id": 110504454531391497,
      "target": "Kakausapin pa kita bukas, okay?"
    },
    {
      "id": 110504454531391496,
      "target": "Ikaw… magpahinga ka muna"
    },
    {
      "id": 110504454531391495,
      "target": "Daughter: PA-A-A-PA-A-A!"
    },
    {
      "id": 110504454531391494,
      "target": "Daughter: PAPA, PAPA KO!"
    },
    {
      "id": 110504454531391493,
      "target": "Daughter: Pumasok sila at nag-usap. Sabi ni Papa, hindi puwedeng ganoon, pero sabi nila… sabi nila…"
    },
    {
      "id": 110504454531391492,
      "target": "Daughter: Hindi ko alaaaam."
    },
    {
      "id": 110504454531391490,
      "target": "Ikuwento mo ang nangyari"
    },
    {
      "id": 110504454531391489,
      "target": "Daughter: A... A-gusto kong pumunta kay Ma-mama."
    }
  ]
}
