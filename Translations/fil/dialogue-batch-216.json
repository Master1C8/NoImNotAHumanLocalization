    {
      "id": 110504455131176970,
      "target": "Greatmother: Gumapang kayo rito, hindi na niya kailangan ang bahay na ito."
    },
    {
      "id": 110504455131176969,
      "target": "Greatmother: Mga anak ko, nakahanap tayo ng bagong bahay. Sa wakas, makapagpapahinga na tayo nang husto."
    },
    {
      "id": 110504455131176968,
      "target": "Greatmother: Darating sila para sa iyo!"
    },
    {
      "id": 110504455131176967,
      "target": "Greatmother: Kaawa-awang gago…"
    },
    {
      "id": 110504455131176966,
      "target": "(Patayin siya)"
    },
    {
      "id": 110504455131176965,
      "target": "Panauhin ka ba?"
    },
    {
      "id": 110504455131176964,
      "target": "Sino ka?"
    },
    {
      "id": 110504455131176963,
      "target": "Ano ang ibig sabihin ng lahat ng ito?"
    },
    {
      "id": 110504455131176962,
      "target": "Greatmother: Naririnig ko silang gumagapang. Kaunti na lang."
    },
    {
      "id": 110504455131176961,
      "target": "Greatmother: …"
    },
    {
      "id": 110504455131176960,
      "target": "Greatmother: Malaki ang bahay, kaunti ang tao. Magkakasya ang lahat."
    },
    {
      "id": 110504455126982668,
      "target": "Greatmother: Magandang lugar ang bahay mo, natatangi."
