      "target": "Greatmother: Kamatayan…"
    },
    {
      "id": 110504455139565578,
      "target": "Greatmother: Bakit ka lumalaban? Alam ko naman ang gusto mo…"
    },
    {
      "id": 110504455139565577,
      "target": "IBIGAY MO ITO SA AMIN!"
    },
    {
      "id": 110504455139565576,
      "target": "Greatmother: Gusto mong masunog ito."
    },
    {
      "id": 110504455139565575,
      "target": "Greatmother: Hindi, ibigay mo sa amin ang bahay na ito. Kinamumuhian mo naman ito."
    },
    {
      "id": 110504455139565574,
      "target": "(PATAYIN SIYA)"
    },
