  "entries": [
    {
      "id": 110504454778855429,
      "target": "Buddy: Huwag mo akong pilitin! Mabigat na nga ang loob ko."
    },
    {
      "id": 110504454778855428,
      "target": "Sige, hindi na ako manghihimasok"
    },
    {
      "id": 110504454778855427,
      "target": "Kailangan kong malaman"
    },
    {
      "id": 110504454778855426,
      "target": "Buddy: Makinig ka, ayaw ko talagang pag-usapan iyon."
    },
    {
      "id": 110504454778855425,
      "target": "Sige, hindi na ako manghihimasok"
    },
    {
      "id": 110504454778855424,
      "target": "Kailangan kong malaman"
    },
    {
      "id": 110504454774661130,
      "target": "Buddy: Hindi mahalaga. Hindi mo rin maiintindihan."
    },
    {
      "id": 110504454774661129,
      "target": "Ano ang sinasabi mo?"
    },
    {
      "id": 110504454774661128,
      "target": "Anong paksa?"
    },
    {
      "id": 110504454774661127,
      "target": "Buddy: Ayaw kong buksan ang usaping iyan."
    },
    {
      "id": 110504454774661126,
      "target": "Buddy: …"
    },
    {
      "id": 110504454774661125,
      "target": "Buddy: Ako…"
    },
    {
      "id": 110504454774661123,
      "target": "Ang lungkot mo yata ngayon"
    },
    {
      "id": 110504454774661122,
      "target": "Buddy: Magtanong ka, pare."
    },
    {
      "id": 110504454774661121,
      "target": "Buddy: Wala iyon, may iniisip lang ako."
    },
    {
      "id": 110504454774661120,
      "target": "Buddy: …"
    },
    {
      "id": 110504454770466825,
      "target": "Buddy: Hmm…"
    },
    {
      "id": 110504454770466824,
      "target": "Buddy: Hindi naman, ako lang…"
    },
    {
      "id": 110504454770466823,
      "target": "Buddy: Wala iyon, kalimutan mo na."
    },
    {
      "id": 110504454770466822,
      "target": "Buddy: …"
    },
    {
      "id": 110504454770466821,
      "target": "Buddy: Ha? Ano?"
    },
    {
      "id": 110504454770466820,
      "target": "Bakit ka natigilan?"
    },
    {
      "id": 110504454770466819,
      "target": "Ayos ka lang ba?"
    },
    {
      "id": 110504454770466818,
      "target": "Buddy: …"
    },
    {
      "id": 110504454770466817,
      "target": "Buddy: …"
    },
    {
      "id": 110504454770466816,
      "target": "Buddy: Hay, kung wala lang ang lahat ng kalokohang ito, pare, puwede sana tayong uminom ng beer at manood ng football. Ipapakilala pa sana kita kay…"
    },
    {
      "id": 110504454766272519,
      "target": "Buddy: …"
    },
    {
      "id": 110504454766272518,
      "target": "Buddy: Hay, bahala ka! Itago mo ang mga sikreto mo!"
    },
    {
      "id": 110504454766272517,
      "target": "Buddy: Saan mo nakuha? May kamag-anak ka sigurong nagtatrabaho sa serbeserya, ano?"
    },
    {
      "id": 110504454766272516,
      "target": "Buddy: Sinilip ko ang ref mo. Pucha, kung alam ko lang na GANIYAN KARAMI ANG BEER MO…"
    },
    {
      "id": 110504454766272515,
      "target": "Buddy: Ayos na ayos, pare!"
    },
    {
      "id": 110504454766272513,
      "target": "Kumusta ka?"
    },
    {
      "id": 110504454766272512,
      "target": "Buddy: Magtanong ka, pare."
    }
  ]
