  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504452593623045,
      "target": "BigLebowski: …"
    },
    {
      "id": 110504452593623044,
      "target": "BigLebowski: Karaniwan naman ang mga mata ko. Ano ba?"
    },
    {
      "id": 110504452593623041,
      "target": "BigLebowski: Magpasya ka na agad: kalabitin mo ang gatilyo o tigilan mo na iyan."
    },
    {
      "id": 110504452593623040,
      "target": "BigLebowski: Alam mo, manong, wala na talaga akong pakialam."
    },
    {
      "id": 110504452589428744,
      "target": "BigLebowski: DUWAG KA BA???"
    },
    {
      "id": 110504452589428743,
      "target": "BigLebowski: KALABITIN MO ANG GATILYO!"
    },
    {
      "id": 110504452589428742,
      "target": "BigLebowski: SIGE, GAWIN MO NA!"
    },
    {
      "id": 110504452589428741,
      "target": "BigLebowski: Alam mo, putangina, wala na akong pakialam! Bumaril ka! Pagod na pagod na ako sa lahat ng ito!"
    },
    {
      "id": 110504452589428738,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452589428737,
      "target": "BigLebowski: Kumusta? Malinis ba? Pasado ba sa mga pamantayan mo?"
    },
    {
      "id": 110504452589428736,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452585234440,
      "target": "BigLebowski: Okey, wala talaga akong pakialam."
    },
    {
      "id": 110504452585234437,
      "target": "BigLebowski: Ano? Ipakita mo!"
    },
    {
      "id": 110504452585234436,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452585234435,
      "target": "BigLebowski: Kung ipapadala mo ang litratong iyan para mahanap ako ng mga magulang ko, lumayas ka, putangina mo."
    },
    {
      "id": 110504452585234434,
      "target": "BigLebowski: …"
    },
    {
      "id": 110504452581040138,
      "target": "BigLebowski: Hindi. Kakaibang kagaguhan iyan. Hindi ko gagawin."
    },
    {
      "id": 110504452581040135,
      "target": "BigLebowski: …"
    },
    {
      "id": 110504452581040134,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452581040133,
      "target": "BigLebowski: Paalala lang: kung may masama kang balak, ako mismo ang susuntok sa mata mo hanggang matanggal iyon!"
    },
    {
      "id": 110504452581040130,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452581040129,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452581040128,
      "target": "BigLebowski: Heto."
    },
    {
      "id": 110504452576845836,
      "target": "BigLebowski: Alerdyi iyan. Kaya nangangati. Sobrang hindi kaaya-aya. Mula pagkabata, ganiyan na ako."
    },
    {
      "id": 110504452576845835,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452576845834,
      "target": "BigLebowski: Huwag ka lang matakot…"
    },
    {
      "id": 110504452576845833,
      "target": "BigLebowski: Hm…"
    },
    {
      "id": 110504452576845830,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452576845829,
      "target": "BigLebowski: Mas inaalala ng mga magulang ko ang mga ngipin ko kaysa sa akin…"
    },
    {
      "id": 110504452576845828,
      "target": "BigLebowski: ..."
    },
    {
      "id": 110504452576845827,
      "target": "BigLebowski: Kakaibang kalokohan. Tandaan mo, kung may maisip ka pang kung ano, kaya kitang sapakin sa mukha!"
    },
    {
      "id": 110504452572651529,
      "target": "BigLebowski: Okey, sige, manong. Wala akong pakialam."
    }
  ]
}
