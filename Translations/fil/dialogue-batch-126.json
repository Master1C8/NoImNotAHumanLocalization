      "id": 110504456330747915,
      "target": "Daughter: TAKOT NA TAKO-O-O-O-OT AKO."
    },
    {
      "id": 110504456330747914,
      "target": "Daughter: AAAAAAAAAAAA."
    },
    {
      "id": 110504456330747913,
      "target": "Daughter: Aaaaaaaaaaa."
    },
    {
      "id": 110504456330747912,
      "target": "Daughter: Saan ako pupunta-a-a-a-a?"
    },
    {
      "id": 110504456330747911,
      "target": "Daughter: Takot na tako-o-ot ako."
    },
    {
      "id": 110504456330747910,
      "target": "Daughter: Tu-tulungan po ba ninyo ako?"
    },
    {
      "id": 110504456330747907,
      "target": "Daughter: Habang tu-tumatakbo ako, tumatawa lang sila."
    },
    {
      "id": 110504456330747906,
      "target": "Daughter: Pagkatapos, may gi-ginawa silang kung ano, tapos si-sinunog nila ang bahay."
    },
    {
      "id": 110504456330747905,
      "target": "Daughter: Mahinahon lang silang na-nakaupo kasama si Papa sa kusina."
    },
    {
      "id": 110504456330747904,
      "target": "Daughter: Hi-hindi ko alam."
    },
    {
      "id": 110504456326553623,
      "target": "Daughter: Ng-ngayon, nasu-sunoooog ang bahay namin."
    },
    {
      "id": 110504456326553622,
      "target": "Daughter: Aaaaaaaa-haaaaaaa."
    },
    {
      "id": 110504456326553621,
      "target": "Daughter: May pi-pinag-uusapan si Papa kasama nila. Pagkatapos, pinatay nila siya."
    },
    {
      "id": 110504456326553620,
      "target": "Daughter: Dumating sa amin ang mga Pana-auhin. Na-nakaupo sila sa bahay namin."
    },
    {
      "id": 110504456326553619,
      "target": "Bakit nila ginawa iyon?"
    },
    {
      "id": 110504456326553618,
      "target": "Sino ang gumawa nito?"
    },
    {
      "id": 110504456326553617,
      "target": "Daughter: Pinatay nila si Pa-pa-Papa."
    },
    {
      "id": 110504456326553616,
      "target": "Daughter: A-a-a-a-ha-a-a-a-ah."
    },
    {
