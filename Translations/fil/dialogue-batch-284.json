    {
      "id": 110504454334259211,
      "target": "Anxiety: …"
    },
    {
      "id": 110504454334259210,
      "target": "Anxiety: Salamat, mas panatag na ako."
    },
    {
      "id": 110504454334259209,
      "target": "Anxiety: Kailangan kong magpahinga. Kumukulo na naman ang sikmura ko. Ooh…"
