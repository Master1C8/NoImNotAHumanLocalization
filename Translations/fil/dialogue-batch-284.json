    },
    {
      "id": 110504454334259214,
      "target": "Anxiety: AYOKONG MAMATAY! AYOKO!"
    },
    {
      "id": 110504454334259213,
      "target": "Anxiety: BAKIT NINYO SINASABI IYAN? LALO TULOY AKONG NATATAKOT."
    },
    {
      "id": 110504454334259212,
      "target": "Anxiety: Ooh, mas mabuting magpahinga ako. Kumukulo na naman ang sikmura ko."
