      "target": "Ayos ka lang ba?"
    },
    {
      "id": 110504454338453506,
      "target": "Anxiety: E-e-eh. Sana matapos na ito sa lalong madaling panahon."
    },
    {
      "id": 110504454338453505,
      "target": "Anxiety: Mamamatay tayong lahat."
