    "window_12_1": {
      "labels": {
        "L69": 0
      },
      "instructions": [
        {
          "index": 0,
          "opcode": 2,
          "op": "RunLine",
          "operands": [
            "line:window_12_1_05c9b1d",
            0.0
          ],
          "source": "Window: Все дома поблизости уничтожены.",
          "sourceStableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504457706479624",
          "target": "Window: Nawasak ang lahat ng kalapit na bahay."
        },
        {
          "index": 1,
          "opcode": 2,
          "op": "RunLine",
          "operands": [
            "line:window_12_1_07f4bb0",
            0.0
          ],
          "source": "Window: Теперь ваш дом – единственный уцелевший во всей округе.",
          "sourceStableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504457706479625",
          "target": "Window: Ang bahay mo na lang ang natitirang nakatayo sa buong paligid."
        },
        {
          "index": 2,
          "opcode": 2,
          "op": "RunLine",
          "operands": [
            "line:window_12_1_0577fde",
            0.0
          ],
          "source": "Window: Больше некому принять удар безумцев на себя.",
          "sourceStableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504457706479626",
          "target": "Window: Wala nang ibang sasalo sa pag-atake ng mga baliw."
        },
        {
          "index": 3,
          "opcode": 2,
          "op": "RunLine",
          "operands": [
            "line:window_12_1_05c8b18",
            0.0
          ],
          "source": "Window: Что бы ни случилось, это наверняка произойдёт теперь с вами.",
          "sourceStableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504457710673920",
          "target": "Window: Anuman ang mangyari, tiyak na sa iyo na iyon mangyayari ngayon."
        },
        {
          "index": 4,
