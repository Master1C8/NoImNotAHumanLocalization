    {
      "id": 110504455949066243,
      "target": "Esenin: Εντάξει, όπως θέλεις."
    },
    {
      "id": 110504455949066241,
      "target": "Esenin: Ευχαριστώ που με άκουσες, σπιτονοικοκύρη."
    },
    {
      "id": 110504455949066240,
      "target": "Esenin: Ξέρεις, μάλιστα νιώθω λίγο καλύτερα."
    },
    {
      "id": 110504455944871944,
      "target": "Ποίημα σαν ποίημα"
    },
    {
      "id": 110504455944871943,
      "target": "Ωραίο"
    },
    {
      "id": 110504455944871942,
      "target": "Esenin: Να λοιπόν το ποίημα. Πώς σου φάνηκε;"
    },
    {
      "id": 110504455944871941,
      "target": "Όχι, ευχαριστώ"
    },
    {
      "id": 110504455944871940,
      "target": "Φυσικά"
    },
    {
      "id": 110504455944871939,
      "target": "Esenin: Σπιτονοικοκύρη, σε πειράζει να σου απαγγείλω ένα ποίημα;"
    },
    {
      "id": 110504455944871938,
      "target": "Esenin: Βρήκα στο σπίτι σου ένα βιβλίο με ποιήματα."
    },
    {
      "id": 110504455944871936,
      "target": ">>"
    }
  ]
