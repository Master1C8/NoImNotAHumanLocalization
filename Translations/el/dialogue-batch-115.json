  "entries": [
    {
      "id": 110504455991009281,
      "target": "Ναι, άντε, τα λέμε."
    },
    {
      "id": 110504455991009280,
      "target": "Εντάξει, θα περάσω από σένα σήμερα αργά το βράδυ."
    },
    {
      "id": 110504455986814985,
      "target": "Δεν θέλει, αλλά τι να κάνουμε;"
    },
    {
      "id": 110504455986814984,
      "target": "Ναι, την ετοιμάζουμε για το σχολείο."
    },
    {
      "id": 110504455986814983,
      "target": "Αλλά χθες έκανε τρομερή ζέστη, φύγαμε νωρίτερα."
    },
    {
      "id": 110504455986814982,
      "target": "Πήγαμε στην παραλία."
    },
    {
      "id": 110504455986814981,
      "target": "Ναι, θυμάμαι, ναι."
    },
    {
      "id": 110504455986814980,
      "target": "Δεν κουράστηκες να κάθεσαι σπίτι;"
    },
    {
      "id": 110504455986814979,
      "target": "Κι εμείς μόλις γυρίσαμε από διακοπές."
    }
  ]
}
