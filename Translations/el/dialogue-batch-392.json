  "entries": [
    {
      "id": 110504452052557829,
      "target": "Daughter: Δεν μου άρεσε. Μη μου ζητήσεις ξανά να βγάλω φωτογραφία."
    },
    {
      "id": 110504452052557828,
      "target": "Daughter: Ευχαριστώ."
    },
    {
      "id": 110504452052557827,
      "target": "Daughter: Μμμμ."
    },
    {
      "id": 110504452052557826,
      "target": "Daughter: (Το κορίτσι έτρεξε κοντά σας πριν τελειώσει η φωτογράφιση)"
    },
    {
      "id": 110504452052557825,
      "target": "Daughter: (Η φωτογραφία βγήκε λίγο θολή)"
    },
    {
      "id": 110504452052557824,
      "target": "Daughter: (Φωτογραφίζετε το κορίτσι)"
    },
    {
      "id": 110504452048363530,
      "target": "Daughter: Θα μου δείξεις μετά τη φωτογραφία;"
    },
    {
      "id": 110504452048363529,
      "target": "Daughter: Δεν με έχουν φωτογραφίσει και πολύ."
    },
    {
      "id": 110504452048363528,
      "target": "Daughter: Φωτογραφία;"
    },
    {
      "id": 110504452048363527,
      "target": "Daughter: Είμαι πολύ κουρασμένη. Μπορώ να σταθώ λίγο εδώ μόνη μου;"
    },
    {
      "id": 110504452048363526,
      "target": "Daughter: Θέλετε απλώς να μάθετε πώς είμαι;"
    },
    {
      "id": 110504452048363525,
      "target": "Daughter: (Την κοιτάζετε και καταλαβαίνετε πως αυτό είναι υπερβολικό για εσάς.)"
    },
    {
      "id": 110504452048363524,
      "target": "Daughter: Τι πρέπει να κάνω;"
    },
    {
      "id": 110504452048363523,
      "target": "Daughter: Ε-ε-εγώ θέ-έλω να πι-ι-ιωωω."
    },
    {
      "id": 110504452048363522,
      "target": "Daughter: Εσείς … ουάααα."
    },
    {
      "id": 110504452048363521,
      "target": "Daughter: Εσείς εκεί ε-ε-είδατε…"
    },
    {
      "id": 110504452048363520,
      "target": "Daughter: Γιατί με κοιτάξατε έτσι;"
    },
    {
      "id": 110504452044169226,
      "target": "Daughter: Τότε θα σκέφτομαι προσεκτικά, μην ανησυχείτε."
    },
    {
      "id": 110504452044169225,
      "target": "Daughter: Θα δείτε εκεί όλα όσα σκέφτομαι;"
    },
    {
      "id": 110504452044169224,
      "target": "Daughter: Μπορείτε να κοιτάξετε μέσα στο μάτι;"
    },
    {
      "id": 110504452044169223,
      "target": "Daughter: Θα φύγω, θέλω να καθίσω μόνη μου."
    },
    {
      "id": 110504452044169222,
      "target": "Daughter: Αυτό το έκοψα μόνη μου. Τα κατάφερα. Μόνη μου."
    },
    {
      "id": 110504452044169221,
      "target": "Daughter: Να τι νυχάκια έχω."
    },
    {
      "id": 110504452044169219,
      "target": "Daughter: Κοιτάξτε."
    },
    {
      "id": 110504452044169218,
      "target": "Daughter: Δεν τα καταφέρνω ακόμα πολύ καλά, εγώ…"
    },
    {
      "id": 110504452044169217,
      "target": "Daughter: Εγώ όμως ξέρω ήδη να κόβω μόνη μου τα νύχια μου."
    },
    {
      "id": 110504452044169216,
      "target": "Daughter: Όλα καλά, έτσι;"
    },
    {
      "id": 110504452039974921,
      "target": "Daughter: Τι σημαίνει αυτό;"
    },
    {
      "id": 110504452039974920,
      "target": "Daughter: Δείτε τα δικά μου."
    },
    {
      "id": 110504452039974918,
      "target": "Daughter: Δεν θα κλάψω άλλο."
    },
    {
      "id": 110504452039974917,
      "target": "Daughter: Γιατί; Έχω ακόμα τα παιδικά μου δοντάκια. Ο μπαμπάς έλεγε…"
    },
    {
      "id": 110504452039974916,
      "target": "Daughter: Τα δόντια; Να σας δείξω τα δόντια μου;"
    },
    {
      "id": 110504452035780615,
      "target": "Daughter: Τι θέλεις να ελέγξεις;"
    }
  ]
}
