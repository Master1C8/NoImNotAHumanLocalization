  "entries": [
    {
      "id": 110504452144832513,
      "target": "Sirin: Αυτό ήταν το τέλος."
    },
    {
      "id": 110504452140638209,
      "target": "Alkonost: Αυτό ήταν το τέλος."
    },
    {
      "id": 110504452123860996,
      "target": "Sirin: Πόσο όμορφη είναι!"
    },
    {
      "id": 110504452123860995,
      "target": "Sirin: Μα προοριζόταν για σένα!"
    },
    {
      "id": 110504452123860994,
      "target": "Sirin: Το τραγούδι μου."
    },
    {
      "id": 110504452123860993,
      "target": "Sirin: Θα περιμένω λοιπόν να έρθει η ώρα μου."
    },
    {
      "id": 110504452123860992,
      "target": "Sirin: Δεν έχει σημασία."
    },
    {
      "id": 110504452119666698,
      "target": "Sirin: Αιώνια αγωνία και αναμονή του θανάτου."
    },
    {
      "id": 110504452119666697,
      "target": "Sirin: Και δεν θα δούμε ποτέ το τέλος μας."
    },
    {
      "id": 110504452119666696,
      "target": "Sirin: Θα μας τραβάει για πάρα πολύ καιρό προς τον ορίζοντα γεγονότων."
    },
    {
      "id": 110504452119666695,
      "target": "Sirin: Κι αν απλώς ετοιμαζόμαστε να μας καταπιεί μια μαύρη τρύπα;"
    },
    {
      "id": 110504452119666694,
      "target": "Sirin: Ίσως την επόμενη φορά."
    },
    {
      "id": 110504452119666693,
      "target": "Sirin: Δεν ταίριαζε στα σημάδια."
    },
    {
      "id": 110504452119666692,
      "target": "Sirin: Κρίμα."
    },
    {
      "id": 110504452119666691,
      "target": "Sirin: Ίσως την επόμενη φορά."
    },
    {
      "id": 110504452119666690,
      "target": "Sirin: Κρίμα."
    },
    {
      "id": 110504452119666689,
      "target": "Sirin: Έτσι κι αλλιώς θα πεθάνεις."
    },
    {
      "id": 110504452115472395,
      "target": "Sirin: Δεν είχες το κουράγιο;"
    },
    {
      "id": 110504452115472392,
      "target": "Sirin: Θα πατήσεις το πολυπόθητο κουμπί;"
    },
    {
      "id": 110504452115472391,
      "target": "Sirin: Λοιπόν;"
    },
    {
      "id": 110504452115472388,
      "target": "Sirin: Σου αρέσει;"
    },
    {
      "id": 110504452115472387,
      "target": "Sirin: Απλώς θα περάσει σε σένα."
    },
    {
      "id": 110504452115472386,
      "target": "Sirin: Όταν κλείσω τα μάτια μου, το κενό δεν θα εξαφανιστεί."
    },
    {
      "id": 110504452111278091,
      "target": "Sirin: Θα το κάνω μόνη μου."
    },
    {
      "id": 110504452111278090,
      "target": "Sirin: Δώσε μου την καραμπίνα."
    },
    {
      "id": 110504452111278089,
      "target": "Sirin: Μπορείς απλώς να το αφήσεις σε μένα."
    },
    {
      "id": 110504452111278088,
      "target": "Sirin: Ο θάνατος είναι ήδη κοντά, έτσι κι αλλιώς."
    },
    {
      "id": 110504452111278087,
      "target": "Sirin: Μην το κάνεις αυτό."
    },
    {
      "id": 110504452111278084,
      "target": "Sirin: Βγάλε μου την ψυχή."
    },
    {
      "id": 110504452111278083,
      "target": "Sirin: Έτσι είναι ακόμα καλύτερα."
    },
    {
      "id": 110504452111278080,
      "target": "Sirin: Φαίνεται πως δεν το έκανα άδικα."
    },
    {
      "id": 110504452107083786,
      "target": "Sirin: Η αδελφή μου μου ξυρίζει τις μασχάλες. Με φροντίζει."
    },
    {
      "id": 110504452107083783,
      "target": "Sirin: Εκείνη όμως δεν παραδέχεται το κενό στα μάτια."
    },
    {
      "id": 110504452107083782,
      "target": "Sirin: Σ' αυτό μοιάζουμε με την αδελφή μου."
    },
    {
      "id": 110504452107083779,
      "target": "Sirin: Με άφησε να πεθάνω ήδη από τότε."
    },
    {
      "id": 110504452107083778,
      "target": "Sirin: Καλύτερα να…"
    },
    {
      "id": 110504452107083777,
      "target": "Sirin: Μα δεν έχει νόημα."
    },
    {
      "id": 110504452107083776,
      "target": "Sirin: Η αδελφή μου με βοηθάει."
    },
    {
      "id": 110504452102889481,
      "target": "Sirin: Θα μου βγάλεις τα δόντια;"
    },
    {
      "id": 110504452102889480,
      "target": "Sirin: Κοίτα."
    },
    {
      "id": 110504452102889473,
      "target": "Sirin: Κάν' το πια."
    }
  ]
}
