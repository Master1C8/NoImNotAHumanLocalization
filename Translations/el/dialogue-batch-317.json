  "entries": [
    {
      "id": 110504453352792068,
      "target": "Cultist1: Ήταν λάθος."
    },
    {
      "id": 110504453352792067,
      "target": "Cultist1: Θα αντιμετωπίσεις τις συνέπειες της επιλογής σου."
    },
    {
      "id": 110504453352792065,
      "target": "Cultist1: Έχω καιρό να φωτογραφηθώ."
    },
    {
      "id": 110504453348597767,
      "target": "Cultist1: Δεν έχω τίποτα να πω."
    },
    {
      "id": 110504453348597766,
      "target": "Cultist1: Δεν ξέρω τι περιμένεις."
    },
    {
      "id": 110504453348597765,
      "target": "Cultist1: Απλώς να είσαι έτοιμος να φύγεις όταν έρθει η ώρα."
    },
    {
      "id": 110504453348597764,
      "target": "Cultist1: Τι τους θέλεις αυτούς τους ελέγχους;"
    },
    {
      "id": 110504453344403462,
      "target": "Cultist1: Δεν αξίζει."
    },
    {
      "id": 110504453344403456,
      "target": "Cultist1: Καλύτερα να μην το κάνεις."
    },
    {
      "id": 110504453340209155,
      "target": "Cultist1: Είναι νωρίς ακόμα."
    },
    {
      "id": 110504453336014849,
      "target": "Cultist1: Ε, γιατί όχι."
    },
    {
      "id": 110504453331820544,
      "target": "Cultist1: Κουράστηκα να ετοιμάζομαι."
    },
    {
      "id": 110504453319237639,
      "target": "Cultist1: Ο Θάνατος θα μας ζεστάνει στα κρύα του χέρια."
    }
  ]
}
