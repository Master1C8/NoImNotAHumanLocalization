    [12245, "Cultist1: Δεν έχω τίποτα να πω."],
    [12246, "Cultist1: Δεν ξέρω τι περιμένεις."],
    [12247, "Cultist1: Απλώς να είσαι έτοιμος να φύγεις όταν έρθει η ώρα."],
