  "glossaryFingerprint": "8bae2efffa702fcac1be38f7149d1e74393aa84a858d8f7d2ee4c052ee11d4e5",
  "authoredMapSha256": "925f2669e3acf583ebc300631632bd608faa9636c8b588577e6e0429f1b04d8c",
  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504457828114433,
      "target": "Phone: Ακούγεστε σαν να ζητάτε λύτρα γι' αυτούς."
    },
    {
      "id": 110504457828114432,
      "target": "Η γυναίκα σας μου έδωσε αυτόν τον αριθμό"
    },
    {
      "id": 110504457823920139,
      "target": "Η γυναίκα σας κι η αδελφή της είναι στο σπίτι μου"
    },
    {
      "id": 110504457823920138,
      "target": "Phone: Ναι; Ποιος τηλεφωνεί;"
    },
    {
      "id": 110504457823920137,
      "target": "Phone: Αντίο σας."
    },
    {
      "id": 110504457823920136,
      "target": "Phone: Και… σας ευχαριστώ που τον βοηθήσατε."
    },
    {
      "id": 110504457823920135,
      "target": "Phone: Είμαι έτοιμη να φιλοξενήσω τον αδελφό μου. Πείτε του το. Ξέρει τη διεύθυνσή μου."
    },
    {
      "id": 110504457823920134,
      "target": "Phone: …"
    },
    {
      "id": 110504457823920133,
      "target": "Phone: Θεέ μου… Πώς συνέβη αυτό;…"
    },
    {
      "id": 110504457823920132,
      "target": "Phone: …"
    },
    {
      "id": 110504457823920130,
      "target": "Πιθανότατα"
    },
    {
      "id": 110504457823920129,
      "target": "Δεν ξέρω"
    },
    {
      "id": 110504457823920128,
      "target": "Phone: Γαμώτο… Αδύνατον… Είναι νεκροί;"
    },
    {
      "id": 110504457819725835,
      "target": "Phone: …"
    },
    {
      "id": 110504457819725834,
      "target": "Phone: Μήπως εκείνοι…"
    },
    {
      "id": 110504457819725833,
      "target": "Phone: Ψάχνει καταφύγιο; Μα δεν ζει με τους γονείς του;"
    },
    {
      "id": 110504457819725831,
      "target": "Πιθανότατα"
    },
    {
      "id": 110504457819725830,
      "target": "Δεν ξέρω"
    },
    {
      "id": 110504457819725829,
      "target": "Phone: Γαμώτο… Αδύνατον… Είναι νεκροί;"
    },
    {
      "id": 110504457819725828,
      "target": "Phone: …"
    },
    {
      "id": 110504457819725827,
      "target": "Phone: Δεν θέλετε να πείτε πως…"
    },
    {
      "id": 110504457819725826,
      "target": "Phone: Εξαφανίστηκαν; Πώς έγινε αυτό;"
    },
    {
      "id": 110504457819725825,
      "target": "Ήρθε σ' εμένα αναζητώντας καταφύγιο"
    },
    {
      "id": 110504457819725824,
      "target": "Οι γονείς του εξαφανίστηκαν"
    },
    {
      "id": 110504457815531532,
      "target": "Phone: Μα περιμένετε… Ποιος είστε εσείς; Και γιατί είναι μαζί σας;"
    },
    {
      "id": 110504457815531531,
      "target": "Phone: Α, μιλάτε για τον αδελφό μου εξ αίματος, σωστά;"
    },
    {
      "id": 110504457815531530,
      "target": "Phone: …"
    },
    {
      "id": 110504457815531529,
      "target": "Phone: Ποιον αδελφό; Δεν έχω…"
    },
    {
      "id": 110504457815531528,
      "target": "Μπορείτε να βοηθήσετε τον αδελφό σας;"
    },
    {
      "id": 110504457815531527,
      "target": "Γεια σας. Ο αδελφός σας μου έδωσε τον αριθμό σας"
    },
    {
      "id": 110504457815531526,
      "target": "Phone: Εμπρός, ποιος είναι;"
    },
    {
      "id": 110504457815531525,
      "target": "Phone: Να είστε καλά."
    },
    {
      "id": 110504457815531524,
      "target": "Phone: …"
    },
    {
      "id": 110504457815531523,
      "target": "Phone: Σας ευχαριστώ για την κατανόηση."
    },
    {
      "id": 110504457815531522,
      "target": "Phone: Να είστε καλά."
    },
    {
      "id": 110504457815531521,
      "target": "Phone: …"
    },
    {
      "id": 110504457815531520,
      "target": "Phone: Ίσως κάποτε καταλάβετε κι εσείς τα πάντα και συμφωνήσετε με τον τρόπο που ερμηνεύουμε όσα συμβαίνουν."
    },
    {
      "id": 110504457811337226,
      "target": "Phone: Η ευτυχία βρίσκεται στην ηρεμία και στην απουσία πόνου. Σίγουρα κι εσείς περάσατε δυσκολίες στη ζωή σας."
    },
    {
      "id": 110504457811337225,
      "target": "Phone: Ίσως σας ακουστεί παράξενο, αλλά ο ερχομός του Θανάτου δεν φέρνει θλίψη, φέρνει ευτυχία."
    },
    {
      "id": 110504457811337224,
      "target": "Phone: Γιατί έχουμε τις ίδιες απόψεις για όσα θα συμβούν έπειτα: τον ερχομό του Θανάτου."
    },
    {
      "id": 110504457811337223,
      "target": "Phone: Να είστε καλά."
    },
    {
      "id": 110504457811337222,
      "target": "Phone: …"
    },
    {
      "id": 110504457811337221,
      "target": "Phone: Και ότι δεν θα φέρει πόνο, αλλά ειρήνη και γαλήνη."
    },
    {
      "id": 110504457811337220,
      "target": "Phone: Πιστεύουμε πως ο Θάνατος θα έρθει στον κόσμο μας από στιγμή σε στιγμή."
    },
    {
      "id": 110504457811337219,
      "target": "Phone: Πείτε τους όπως θέλετε, αλλά είναι η οικογένειά μου."
    },
    {
      "id": 110504457811337218,
      "target": "Όπως λέτε"
    },
    {
      "id": 110504457811337217,
      "target": "Γιατί μπήκατε εξαρχής στην αίρεση;"
    },
    {
      "id": 110504457811337216,
      "target": "Πιστεύετε πως μια χούφτα φανατικοί σάς καταλαβαίνουν;"
    },
    {
      "id": 110504457807142923,
      "target": "Phone: Πάντως τώρα νιώθω πολύ καλύτερα, μαζί με όσους με καταλαβαίνουν."
    },
    {
      "id": 110504457807142922,
      "target": "Phone: …"
    },
    {
      "id": 110504457807142921,
      "target": "Phone: Ελπίζει να τα διορθώσει όλα, να τα κάνει όπως ήταν παλιά. Μα αυτό δεν γίνεται: κανείς δεν μπορεί να γυρίσει τον χρόνο πίσω."
    },
    {
      "id": 110504457807142920,
      "target": "Phone: Δεν έχει το θάρρος να παραδεχτεί τα λάθη του. Να αποδεχτεί όσα έγιναν."
    },
    {
      "id": 110504457807142919,
      "target": "Phone: Μόνο που υπάρχει ένα πρόβλημα: δεν μπορεί να μου τηλεφωνήσει ο ίδιος. Ξέρετε γιατί;"
    },
    {
      "id": 110504457807142918,
      "target": "Phone: Ίσως δεν ξέρετε ότι έχει ήδη ζητήσει από άλλους να απολογηθούν αντί γι' αυτόν."
    },
    {
      "id": 110504457807142917,
      "target": "Phone: Τι, πάλι;"
    },
    {
      "id": 110504457807142916,
      "target": "Phone: Χα, μετάνιωσε;!"
    },
    {
      "id": 110504457807142915,
      "target": "Ήθελε να σας πει να πάτε στον διάολο"
    },
    {
      "id": 110504457807142914,
      "target": "Ήθελε να σας πει πως λυπάται για όσα έκανε"
    }
  ]
}
