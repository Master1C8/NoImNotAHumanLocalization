  "authoredMapSha256": "63efa45ead9465a1296a7454fa6f714185ac2cba324ac2a0673a4137b2482b40",
  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504456108449798,
      "target": "Έλα πίσω μου, γρήγορα."
    },
    {
      "id": 110504456108449797,
      "target": "Έχουν μαζευτεί τόσα πολλά, που το καπέλο του μανιταριού θα καλύψει ολόκληρη την επιφάνεια της Γης."
    },
    {
      "id": 110504456108449796,
      "target": "Και όσο μεγαλύτερα γίνονται τα μανιτάρια..."
    },
    {
      "id": 110504456108449795,
      "target": "Μπορούν να μεγαλώσουν πολύ γρήγορα, αν τα πράγματα πάνε στραβά."
    },
    {
      "id": 110504456108449794,
      "target": "Αλλά αυτό αργότερα."
    },
    {
      "id": 110504456108449793,
      "target": "Κανείς δεν μπλέκεται στα πόδια σου."
    },
    {
      "id": 110504456108449792,
      "target": "Επικρατεί πολλή ησυχία."
    },
    {
      "id": 110504456104255499,
      "target": "Και πόσους ακόμη σκότωσε; Πόσους έκαψε;"
    },
    {
      "id": 110504456104255498,
      "target": "Vigilante: Την έβαψες, γαμημένε εξυπνάκια!"
    },
    {
      "id": 110504456104255497,
      "target": "Vigilante: Με περνάς, γαμώτο, για ηλίθιο; Νομίζεις πως θα την πατήσω έτσι;"
    },
    {
      "id": 110504456104255496,
      "target": "Vigilante: Τώρα την πάτησες, παλιοκάθαρμα…"
    },
    {
      "id": 110504456104255495,
      "target": "Vigilante: Γαμημένε, είσαι ένας Επισκέπτης!"
    },
    {
      "id": 110504456104255494,
      "target": "Vigilante: Ώρα να ψοφήσεις, μπάσταρδε."
    },
    {
      "id": 110504456104255493,
      "target": "Vigilante: Παλιοκάθαρμα! Γαμημένε Επισκέπτη, νόμιζες πως θα με ξεγελούσες;"
    },
    {
      "id": 110504456104255492,
      "target": "Θα κρατήσω ζωντανή τη μνήμη σας."
    },
    {
      "id": 110504456104255491,
      "target": "Δεν μπορείτε να αντέξετε τις παράλογες δυνάμεις του Σύμπαντος."
    },
    {
      "id": 110504456104255490,
      "target": "Όπως ακριβώς ήθελαν οι άνθρωποι."
    },
    {
      "id": 110504456104255489,
      "target": "Θα σας χαρίσω γαλήνη."
    },
    {
      "id": 110504456104255488,
      "target": "Θα σας επιστρέψω εκεί όπου θα έπρεπε να βρίσκεστε από την αρχή."
    },
    {
      "id": 110504456100061195,
      "target": "Θα σας κρύψω."
    },
    {
      "id": 110504456100061194,
      "target": "Τώρα χρειάζεται η παρέμβασή μου."
    },
    {
      "id": 110504456100061193,
      "target": "Τη νιώθεις; Είναι εκείνη."
    },
    {
      "id": 110504456100061192,
      "target": "Ίσως φανερωθεί μπροστά μας ακόμη και ο Θάνατος και..."
    },
    {
      "id": 110504456100061191,
      "target": "Κανείς δεν θα φύγει δυσαρεστημένος."
    },
    {
      "id": 110504456100061190,
      "target": "Όλοι θα βρουν γαλήνη."
    },
    {
      "id": 110504456100061189,
      "target": "Τώρα τα κάνουμε όλα σωστά."
    },
    {
      "id": 110504456100061188,
      "target": "Η παρωχημένη αντίληψη για τον Θάνατο μας εμπόδιζε να πεθάνουμε όπως πρέπει."
    },
    {
      "id": 110504456100061187,
      "target": "Χαίρομαι που ήρθες μαζί μας. Ο Θάνατος πράγματι σε επέλεξε για κάποιο λόγο."
    }
  ]
}
