  "authoredMapSha256": "944b2a9e46a1792278b506f53202599c5fa3d09a5b87a1b9d63d36cdba3fa95a",
  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504454455894021,
      "target": "Widow: Ελπίζω να βρείτε αυτό που ψάχνετε."
    },
    {
      "id": 110504454455894020,
      "target": "Widow: Δεν μιλάτε πολύ, αλλά… αποδειχτήκατε καλή συντροφιά για κουβέντα."
    },
    {
      "id": 110504454455894019,
      "target": "Widow: Ευχαριστώ."
    },
    {
      "id": 110504454455894018,
      "target": "Widow: Ώσπου να γυρίσω, δεν θέλω να αποφασίσω τίποτα."
    },
    {
      "id": 110504454455894017,
      "target": "Widow: Θέλω πολύ να πάω σπίτι."
    },
    {
      "id": 110504454455894016,
      "target": "Widow: Για σένα δεν νιώθω τίποτα, συγγνώμη."
    },
    {
      "id": 110504454451699715,
      "target": "Widow: Δεν θα νιώσω καλύτερα."
    },
    {
      "id": 110504454451699714,
      "target": "Widow: Γιατί;"
    },
    {
      "id": 110504454451699713,
      "target": "Καλή τύχη"
    },
    {
      "id": 110504454451699712,
      "target": "Μπορείς να μείνεις"
    },
    {
      "id": 110504454447505416,
      "target": "Widow: Δεν θέλω πια τίποτα."
    },
    {
      "id": 110504454447505415,
      "target": "Widow: Θα γυρίσουμε σπίτι."
    },
    {
      "id": 110504454447505414,
      "target": "Widow: Δεν έμεινε κανείς."
    },
    {
      "id": 110504454447505413,
      "target": "Καλή τύχη"
    },
    {
      "id": 110504454447505412,
      "target": "Μπορείς να μείνεις"
    },
    {
      "id": 110504454447505411,
      "target": "Widow: Κι εκεί…"
    },
    {
      "id": 110504454447505410,
      "target": "Widow: Θα βγάλω την κιθάρα."
    },
    {
      "id": 110504454447505409,
      "target": "Widow: Θα γυρίσω σπίτι."
    },
    {
      "id": 110504454447505408,
      "target": "Widow: Δεν θέλω να το σκέφτομαι."
    },
    {
      "id": 110504454443311116,
      "target": "Πας στους συγγενείς σου;"
    },
    {
      "id": 110504454443311115,
      "target": "Και τώρα τι;"
    },
    {
      "id": 110504454443311114,
      "target": "Widow: Χρειαζόμουν μόνο λίγη ξεκούραση."
    },
    {
      "id": 110504454443311113,
      "target": "Widow: Σου είπα από την αρχή πως δεν σκόπευα να μείνω πολύ."
    },
    {
      "id": 110504454443311112,
      "target": "Widow: Φεύγω απόψε."
    },
    {
      "id": 110504454443311110,
      "target": "Συμβαίνει κάτι;"
    },
    {
      "id": 110504454443311109,
      "target": "Widow: Να ξεκουραζόμουν λίγο…"
    },
    {
      "id": 110504454443311108,
      "target": "Widow: Είναι πολύ δύσκολο να ζω χωρίς εκείνον τώρα…"
    },
    {
      "id": 110504454443311107,
      "target": "Widow: Ναι. Σε παρακαλώ."
    },
    {
      "id": 110504454443311106,
      "target": "Widow: Θέλω να μείνω μόνη."
    },
    {
      "id": 110504454443311104,
      "target": "Widow: Εσείς σκοτώσατε — σ' εσάς θα μείνει η ψυχή του. Κι εμένα θα μου μείνει να φωνάζω πως δεν λυπάμαι κανέναν."
    },
    {
      "id": 110504454439116810,
      "target": "Widow: Πράγματι, εκεί…"
    },
    {
      "id": 110504454439116809,
      "target": "Widow: Κι εκείνος…"
    },
    {
      "id": 110504454439116808,
      "target": "Widow: Αυτοί οι μαλάκες τα έχουν πάντα όλα άνω κάτω, οπότε μου έφτασε να φορέσω μια ιατρική ρόμπα και να μπω στο νεκροτομείο."
    },
    {
      "id": 110504454439116807,
      "target": "Widow: Δεν επιτρέπεται να τον πάρω σπίτι."
    },
    {
      "id": 110504454439116806,
      "target": "Widow: Δεν μου επιτρέπουν ούτε να δω από κοντά το σώμα."
    },
    {
      "id": 110504454439116805,
      "target": "Widow: Αυτό ήταν όλο."
    },
    {
      "id": 110504454439116804,
      "target": "Widow: Μου είπαν: «Πέθανε»."
    },
    {
      "id": 110504454439116802,
      "target": "Widow: Μια στιγμή, συγχωρήστε με."
    },
    {
      "id": 110504454439116800,
      "target": "Widow: Μου είπαν απλώς, ξερά…"
    },
    {
      "id": 110504454434922503,
      "target": "Widow: Είχα πάει νωρίτερα, μόνο για να τον δω."
    },
    {
      "id": 110504454434922501,
      "target": "Widow: Η ΕΕΑ απλώς τον έβαλε σε καραντίνα. Δεν με άφησαν να επικοινωνήσω μαζί του. Είπαν πως θα τον άφηναν ελεύθερο σε τρεις εβδομάδες."
    },
    {
      "id": 110504454434922500,
      "target": "Widow: Πήγαμε στο κέντρο που άνοιξε η ΕΕΑ."
    },
    {
      "id": 110504454434922499,
      "target": "Widow: Ο άντρας μου δεν ένιωθε καλά. Πήγαμε στο νοσοκομείο, αλλά τον έστειλαν για εξετάσεις σ' εκείνα τα καθάρματα."
    }
  ]
}
