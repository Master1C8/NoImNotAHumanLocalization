  "entries": [
    {
      "id": 110504454418145287,
      "target": "Widow: Να ξεκουραζόμουν λίγο…"
    },
    {
      "id": 110504454418145286,
      "target": "Widow: Θέλω τόσο πολύ να το πιστέψω."
    },
    {
      "id": 110504454418145285,
      "target": "Widow: Το θέλω τόσο πολύ…"
    },
    {
      "id": 110504454418145284,
      "target": "Widow: Με ακούει ακόμη."
    },
    {
      "id": 110504454418145283,
      "target": "Widow: Όχι, δεν είναι έτσι."
    },
    {
      "id": 110504454418145282,
      "target": "Widow: Όχι."
    },
    {
      "id": 110504454418145280,
      "target": "Widow: Δεν θα τον παραδώσω στην άψυχη γη."
    },
    {
      "id": 110504454413950982,
      "target": "Widow: Δεν μπορώ να το κάνω."
    },
    {
      "id": 110504454413950981,
      "target": "Widow: Και να τον αποχωριστώ ξανά."
    },
    {
      "id": 110504454413950980,
      "target": "Widow: Μόλις πρόσφατα μου τον επέστρεψαν."
    },
    {
      "id": 110504454413950979,
      "target": "Widow: Δεν είμαι έτοιμη."
    },
    {
      "id": 110504454413950978,
      "target": "Widow: Όχι-όχι-όχι-όχι."
    },
    {
      "id": 110504454413950977,
      "target": "Widow: Όοοχι."
    },
    {
      "id": 110504454413950976,
      "target": "Έχει απομείνει μόνο το σώμα του. Πρέπει να το δεχτείς"
    },
    {
      "id": 110504454409756678,
      "target": "Πρέπει να τον θάψεις"
    },
    {
      "id": 110504454409756677,
      "target": "Widow: Απλώς να σταματήσω να κλαίω."
    },
    {
      "id": 110504454409756676,
      "target": "Widow: Μα είναι σωστό αυτό;"
    },
    {
      "id": 110504454409756675,
      "target": "Widow: Λες και δεν έχω πια με τι να κλάψω."
    },
    {
      "id": 110504454409756674,
      "target": "Widow: Μόλις πρόσφατα μου τελείωσαν όλα τα δάκρυα."
    },
    {
      "id": 110504454409756673,
      "target": "Widow: Είναι υπερβολικό."
    },
    {
      "id": 110504454409756672,
      "target": "Widow: Δεν μπορώ ακόμη."
    },
    {
      "id": 110504454405562378,
      "target": "Πώς πέθανε;"
    },
    {
      "id": 110504454405562377,
      "target": "Widow: Να ξεκουραζόμουν λίγο…"
    },
    {
      "id": 110504454405562376,
      "target": "Widow: Τι να κάνω;"
    },
    {
      "id": 110504454405562375,
      "target": "Widow: Δεν μπορώ… εσένα…"
    },
    {
      "id": 110504454405562373,
      "target": "Widow: Να τον θάψω…"
    },
    {
      "id": 110504454405562372,
      "target": "Widow: Δεν μπορώ ούτε…"
    },
    {
      "id": 110504454405562371,
      "target": "Widow: Δεν μπορείς να μου φέρεις κανέναν πίσω."
    },
    {
      "id": 110504454405562370,
      "target": "Widow: Θέλω να μείνω μαζί του λίγο."
    },
    {
      "id": 110504454405562369,
      "target": "Widow: Γιατί το κάνεις αυτό;"
    },
    {
      "id": 110504454405562368,
      "target": "Widow: Ωραία, τώρα να παλεύω εγώ μόνη μου να επιζήσω."
    },
    {
      "id": 110504454401368071,
      "target": "Widow: Και πέθανε."
    },
    {
      "id": 110504454401368069,
      "target": "Widow: Είπε πως όλα θα πάνε καλά."
    },
    {
      "id": 110504454401368068,
      "target": "Widow: Αφού είχε υποσχεθεί πως όλα θα πάνε καλά."
    },
    {
      "id": 110504454401368067,
      "target": "Widow: Γιατί πέθανες;"
    },
    {
      "id": 110504454401368065,
      "target": "Να καθίσω μαζί σου;"
    },
    {
      "id": 110504454401368064,
      "target": "Θα σε αφήσω εδώ προς το παρόν"
    },
    {
