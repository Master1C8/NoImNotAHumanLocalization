  "entries": [
    {
      "id": 110504454787244035,
      "target": "Και λοιπόν;"
    },
    {
      "id": 110504454787244034,
      "target": "Και τι το κακό;"
    },
    {
      "id": 110504454787244033,
      "target": "Buddy: Είχα έναν σκύλο και πριν από λίγες μέρες… πέθανε."
    },
    {
      "id": 110504454787244032,
      "target": "Buddy: Εντάξει, αφού πρέπει να σου πω…"
    },
    {
      "id": 110504454783049737,
      "target": "Buddy: Σκέφτηκες να με καθαρίσεις, φιλαράκι;"
    },
    {
      "id": 110504454783049736,
      "target": "Και λοιπόν;"
    },
    {
      "id": 110504454783049735,
      "target": "Και τι το κακό;"
    },
    {
      "id": 110504454783049734,
      "target": "Buddy: Είχα έναν σκύλο και πριν από λίγες μέρες… πέθανε."
    },
    {
      "id": 110504454783049733,
      "target": "Buddy: Αλλά… Δεν το αντέχω άλλο."
    },
    {
      "id": 110504454783049731,
      "target": "Buddy: Δεν μπορώ… Θα με κοιτάς στραβά."
    },
    {
      "id": 110504454783049730,
      "target": "Θα πρέπει να μου πεις. Αλλιώς θα γίνει χειρότερα"
    },
    {
      "id": 110504454783049729,
      "target": "Πες μου απλώς τι σου συμβαίνει"
    },
    {
      "id": 110504454783049728,
      "target": "Buddy: Δεν είναι δική σου δουλειά, φιλαράκι! Άσε με ήσυχο!"
    },
    {
      "id": 110504454778855433,
      "target": "Πες μου, τι έχεις;"
    },
    {
      "id": 110504454778855432,
      "target": "Buddy: Ρώτα με, φιλαράκι."
    },
    {
      "id": 110504454778855431,
      "target": "Buddy: Ευχαριστώ, στ' αλήθεια δεν νιώθω καθόλου καλά."
    },
    {
      "id": 110504454778855430,
      "target": "Buddy: Άσε με."
    },
    {
      "id": 110504454778855429,
      "target": "Buddy: Μη με πιέζεις! Ήδη μου είναι πολύ δύσκολο."
    },
    {
      "id": 110504454778855428,
      "target": "Εντάξει, δεν θα επιμείνω"
    },
    {
      "id": 110504454778855427,
      "target": "Πρέπει να ξέρω"
    },
    {
      "id": 110504454778855426,
      "target": "Buddy: Άκου, στ' αλήθεια δεν θέλω να μιλήσω γι' αυτό."
    },
    {
      "id": 110504454778855425,
      "target": "Εντάξει, δεν θα επιμείνω"
    },
    {
      "id": 110504454778855424,
      "target": "Πρέπει να ξέρω"
    },
    {
      "id": 110504454774661130,
      "target": "Buddy: Δεν έχει σημασία. Έτσι κι αλλιώς δεν θα καταλάβεις."
    },
    {
      "id": 110504454774661129,
      "target": "Για τι πράγμα μιλάς;"
    },
    {
      "id": 110504454774661128,
      "target": "Ποιο θέμα;"
    },
    {
      "id": 110504454774661127,
      "target": "Buddy: Δεν θέλω να ανοίξω αυτό το θέμα."
    },
    {
      "id": 110504454774661125,
      "target": "Buddy: Εγώ…"
    },
    {
      "id": 110504454774661123,
      "target": "Κάπως σκυθρωπός είσαι σήμερα"
    },
    {
      "id": 110504454774661122,
      "target": "Buddy: Ρώτα με, φιλαράκι."
    },
    {
      "id": 110504454774661121,
      "target": "Buddy: Δεν έχει σημασία, απλώς σκεφτόμουν."
    },
    {
      "id": 110504454770466825,
      "target": "Buddy: Χμ…"
    },
    {
      "id": 110504454770466824,
      "target": "Buddy: Όχι, απλώς…"
    },
    {
      "id": 110504454770466823,
      "target": "Buddy: Δεν έχει σημασία, ξέχνα το."
    },
    {
      "id": 110504454770466821,
      "target": "Buddy: Ε; Τι;"
    },
    {
      "id": 110504454770466820,
      "target": "Γιατί κόλλησες έτσι;"
    },
    {
      "id": 110504454770466819,
      "target": "Είσαι καλά;"
    },
    {
      "id": 110504454770466816,
      "target": "Buddy: Γαμώτο, αν δεν είχε γίνει όλο αυτό το χάλι, φιλαράκι, θα πίναμε μπίρα και θα βλέπαμε ποδόσφαιρο. Θα σου γνώριζα…"
    },
    {
      "id": 110504454766272518,
      "target": "Buddy: Άντε, καλά! Κράτα τα μυστικά σου!"
    },
    {
      "id": 110504454766272517,
      "target": "Buddy: Από πού την ξετρύπωσες; Μήπως δουλεύει κανένας συγγενής σου σε ζυθοποιείο;"
    },
    {
      "id": 110504454766272516,
      "target": "Buddy: Κοίταξα στο ψυγείο σου. Γαμώτο, αν ήξερα πως είχες ΤΟΣΗ ΜΠΙΡΑ…"
    },
    {
      "id": 110504454766272515,
      "target": "Buddy: Γαμάτα, φιλαράκι!"
    },
    {
      "id": 110504454766272513,
      "target": "Πώς πάει;"
    },
    {
      "id": 110504454766272512,
      "target": "Buddy: Ρώτα με, φιλαράκι."
    }
  ]
}
