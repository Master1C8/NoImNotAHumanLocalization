  "authoredMapSha256": "c5f2a631fcba4801331f9cfe65d6c69b21695295fa0f3385a5a3e14d722a1a26",
  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504456578211842,
      "target": "Από τι κουραστήκατε τόσο;"
    },
    {
      "id": 110504456578211841,
      "target": "Η γυναίκα σου μπορεί να μιλήσει μόνη της;"
    },
    {
      "id": 110504456578211840,
      "target": "Couple: Μεγάλο σπίτι στην άκρη, οι γείτονες μακριά. Λίγες πιθανότητες να εμφανιστεί κανένα φρικιό."
    },
    {
      "id": 110504456574017547,
      "target": "Couple: Δεν ξέρω, δεν μπορώ να το εξηγήσω, χα."
    },
    {
      "id": 110504456574017546,
      "target": "Couple: Για να είμαι ειλικρινής, το σπίτι σας μοιάζει περισσότερο με καταφύγιο από τα άλλα."
    },
    {
      "id": 110504456574017545,
      "target": "Κι αν μου γίνετε βάρος;"
    },
    {
      "id": 110504456574017544,
      "target": "Το σπίτι μου μοιάζει ασφαλές;"
    },
    {
      "id": 110504456574017543,
      "target": "Couple: Θα σας πείραζε να καθίσουμε λίγο εδώ; Αν δεν σας γίνουμε βάρος, φυσικά."
    },
    {
      "id": 110504456574017542,
      "target": "Couple: Α, καλησπέρα! Η γυναίκα μου κι εγώ ψάχνουμε ένα ασφαλές μέρος."
    },
    {
      "id": 110504456574017541,
      "target": "Couple: … Τώρα είναι καλύτερα."
    },
    {
      "id": 110504456574017540,
      "target": "Ballerina: Ένα δωράκι από μένα για σένα."
    },
    {
      "id": 110504456574017539,
      "target": "Ballerina: Θα βρεις τον γάτο κάτω από το σπίτι."
    },
    {
      "id": 110504456574017537,
      "target": "Ballerina: Έλα, γατούλη, θα με διασκεδάζεις εδώ, έτσι;"
    },
    {
      "id": 110504456574017536,
      "target": "Ballerina: Νιώσε σαν στο σπίτι σου."
    },
    {
      "id": 110504456569823243,
      "target": "Άντε γαμήσου, φύγε επιτέλους"
    },
    {
      "id": 110504456569823242,
      "target": "…Πέρνα μέσα"
    },
    {
      "id": 110504456569823241,
      "target": "Ballerina: Ξανασκέψου το."
    },
    {
      "id": 110504456569823240,
      "target": "Ballerina: Βλέπεις τον γάτο;"
    },
    {
      "id": 110504456569823239,
      "target": "Ballerina: Και μην βασανίσεις τον γάτο."
    },
    {
      "id": 110504456569823238,
      "target": "Ballerina: Δεν είναι σωστό να αφήνεις μια γυναίκα να ξεπαγιάζει έξω, νεαρέ μου."
    },
    {
      "id": 110504456569823234,
      "target": "Ballerina: Θα ανοίξεις; Όχι;"
    },
    {
      "id": 110504456569823233,
      "target": "Ballerina: Πέρασα όλες σου τις δοκιμασίες;"
    },
    {
      "id": 110504456569823232,
      "target": "Ballerina: Δεν αρκεί αυτό;"
    },
    {
      "id": 110504456565628939,
      "target": "Ballerina: Έχω δύο χέρια, δύο πόδια, ένα κεφάλι."
    },
    {
      "id": 110504456565628936,
      "target": "Ballerina: Έλα, αποφάσισε επιτέλους τι θα κάνουμε."
    },
    {
      "id": 110504456565628935,
      "target": "Ballerina: Είμαι μπαλαρίνα."
    },
    {
      "id": 110504456565628934,
      "target": "Ballerina: Ίσως και να χορέψω."
    },
    {
      "id": 110504456565628933,
      "target": "Ballerina: Να σου χορέψω;"
    },
    {
      "id": 110504456565628932,
      "target": "Ballerina: Ε, και;"
    },
    {
      "id": 110504456565628931,
      "target": "Απόδειξε ότι είσαι άνθρωπος"
    },
    {
      "id": 110504456565628930,
      "target": "Δεν πιστεύω ότι είσαι άνθρωπος"
    },
    {
      "id": 110504456565628929,
      "target": "Ballerina: Παράξενη φράση."
    },
    {
      "id": 110504456565628928,
      "target": "Ballerina: Και μετά; Σου τον θύμισα; Ή τι;"
    },
    {
      "id": 110504456561434635,
      "target": "Ballerina: Ε… καλά."
    },
    {
      "id": 110504456561434634,
      "target": "Απόδειξε ότι είσαι άνθρωπος"
    },
    {
      "id": 110504456561434633,
      "target": "Δεν πιστεύω ότι είσαι άνθρωπος"
    },
    {
      "id": 110504456561434632,
      "target": "Ballerina: Χε."
    },
    {
      "id": 110504456561434630,
      "target": "Ballerina: Δεν ξέρω. Τι σημασία έχει;"
    },
    {
      "id": 110504456561434629,
      "target": "Μου θυμίζεις έναν… άνθρωπο"
    },
    {
      "id": 110504456561434628,
      "target": "Σε έστειλε κανείς εδώ;"
    },
    {
      "id": 110504456561434627,
      "target": "Ballerina: Δεν κάνει ζέστη εδώ μέσα."
    },
    {
      "id": 110504456561434626,
      "target": "Ballerina: Είδα το σπίτι σου και ήρθα."
    },
    {
      "id": 110504456561434625,
      "target": "Ballerina: Βλέπεις την πόλη; Εκεί έμενα."
    },
    {
      "id": 110504456561434624,
      "target": "Μου θυμίζεις έναν… άνθρωπο"
    },
    {
      "id": 110504456557240330,
      "target": "Σε έστειλε κανείς εδώ;"
    },
    {
      "id": 110504456557240329,
      "target": "Ballerina: Έκανα μπαλέτο. Φαίνεται;"
    },
    {
      "id": 110504456557240328,
      "target": "Ballerina: Χορεύω."
    },
    {
      "id": 110504456557240327,
      "target": "Πώς βρήκες το σπίτι μου;"
    },
    {
      "id": 110504456557240326,
      "target": "Ποια είσαι;"
    },
    {
      "id": 110504456557240325,
      "target": "Ballerina: Μου είπαν να έρθω εδώ, κι ήρθα."
    },
    {
      "id": 110504456557240324,
      "target": "Ballerina: Θα ανοίξεις την πόρτα ή όχι;"
    },
    {
      "id": 110504456557240322,
      "target": "Ballerina: Ένα καφάσι μπίρες. Ένα κομοδίνο. Ένα μπούτι κρέας. Δεν ξέρω. Δώσε μου ό,τι θέλεις."
    },
    {
      "id": 110504456557240321,
      "target": "Πώς βρήκες το σπίτι μου;"
    },
    {
      "id": 110504456557240320,
      "target": "Ποια είσαι;"
    },
    {
      "id": 110504456553046028,
      "target": "Ballerina: Και σε τι θα σε βοηθήσει αυτό;"
    },
    {
      "id": 110504456553046027,
      "target": "Ballerina: Πολλές ερωτήσεις. Ναι, το ξέρω."
    },
    {
      "id": 110504456553046025,
      "target": "Τι θέλεις;"
    },
    {
      "id": 110504456553046024,
      "target": "Ξέρεις… έναν φαλακρό άντρα;"
    },
    {
      "id": 110504456553046023,
      "target": "Ballerina: Θα ανοίξεις την πόρτα;"
    },
    {
      "id": 110504456553046021,
      "target": "Ballerina: Γεια."
    }
  ]
}
