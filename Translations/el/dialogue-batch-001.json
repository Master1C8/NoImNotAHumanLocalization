  "entries": [
    {"id": 110504457945554944, "target": "TV: Τώρα διατίθεται και από την υπηρεσία παράδοσης φαγητού For Rest. Καλέστε στο: {0}."},
    {"id": 110504457941360652, "target": "1 κομπούχα, παρακαλώ"},
    {"id": 110504457941360651, "target": "1 πακέτο τσιγάρα, παρακαλώ"},
    {"id": 110504457941360650, "target": "2 κονσέρβες γατοτροφής, παρακαλώ"},
    {"id": 110504457941360649, "target": "TV: Ακολουθεί ρεπορτάζ για την προσωρινή αναστολή της διάθεσης των σορών."},
    {"id": 110504457941360648, "target": "TV: …"},
    {"id": 110504457941360647, "target": "TV: …"},
    {"id": 110504457941360646, "target": "TV: …"},
    {"id": 110504457941360645, "target": "Phone: …"},
    {"id": 110504457941360644, "target": "Phone: Αλλά μου λείπει ακόμα..."},
    {"id": 110504457941360643, "target": "Phone: ..."},
    {"id": 110504457941360642, "target": "Phone: Άντε στο διάολο!"},
    {"id": 110504457941360641, "target": "Phone: Αχ, γιατί απολογούμαι καν σ' εσάς;"},
    {"id": 110504457941360640, "target": "Phone: Σας παρακαλώ..."},
    {"id": 110504457937166346, "target": "Phone: Μην ξαναπάρετε εδώ..."},
    {"id": 110504457937166345, "target": "Phone: Συγγνώμη."},
    {"id": 110504457937166344, "target": "Phone: ..."},
    {"id": 110504457937166343, "target": "Phone: Τώρα λυπάμαι μόνο που δεν ρωτήσαμε εκείνο το πλάσμα που πήρε τη θέση της κόρης μας τι έκανε στη μικρούλα μας..."},
    {"id": 110504457937166342, "target": "Phone: Ο άντρας μου με βοήθησε να το καταλάβω."},
    {"id": 110504457937166341, "target": "Phone: Μετά όμως κατάλαβα ότι δεν ήταν η κόρη μας."},
    {"id": 110504457937166340, "target": "Phone: Στην αρχή ήθελα να σκοτώσω τον ίδιο."},
    {"id": 110504457937166339, "target": "Phone: ..."},
    {"id": 110504457937166338, "target": "Phone: Εκείνος ξεμπέρδεψε αμέσως με αυτόν τον Επισκέπτη."},
    {"id": 110504457937166337, "target": "Phone: Μόλις το είπα στον άντρα μου, εκείνος..."},
    {"id": 110504457937166336, "target": "Phone: ..."},
    {"id": 110504457932972044, "target": "Phone: Όλα ταίριαζαν."},
    {"id": 110504457932972043, "target": "Phone: Γι' αυτό πρόσεξα αμέσως μόλις εμφανίστηκαν αυτά τα σημάδια."},
    {"id": 110504457932972042, "target": "Phone: Την ήξερα σαν την παλάμη του χεριού μου."},
    {"id": 110504457932972041, "target": "Phone: Από κάθε σημάδι."},
    {"id": 110504457932972040, "target": "Phone: Ήταν Επισκέπτης."},
    {"id": 110504457932972039, "target": "Καταλαβαίνω"},
    {"id": 110504457932972038, "target": "Γαμώτο..."},
    {"id": 110504457932972037, "target": "Phone: Ήταν σίγουρα Επισκέπτης! Τα σημάδια ταίριαζαν εκατό τοις εκατό!"},
    {"id": 110504457932972036, "target": "Phone: Δεν έχετε δικαίωμα να με κρίνετε!"},
    {"id": 110504457932972035, "target": "..."}
  ]
}
