  "entries": [
    {
      "id": 110504456343330824,
      "target": "SuperFake: Θα ανοίξω."
    },
    {
      "id": 110504456343330823,
      "target": "SuperFake: Ήθελα να δω αν θα έλεγες ψέματα."
    },
    {
      "id": 110504456343330822,
      "target": "SuperFake: Είναι φανερό πως είσαι μόνος."
    },
    {
      "id": 110504456343330821,
      "target": "SuperFake: Χαχαχαχαχα."
    },
    {
      "id": 110504456343330820,
      "target": "SuperFake: Αλλά ποιος ξέρει τι θα γίνει σε λίγες μέρες;"
    },
    {
      "id": 110504456343330819,
      "target": "SuperFake: Ακούω κάποιον να ψιθυρίζει στα δωμάτιά σου."
    },
    {
      "id": 110504456343330818,
      "target": "SuperFake: Σήμερα στάθηκες τυχερός."
    },
    {
      "id": 110504456339136523,
      "target": "SuperFake: Είσαι μόνος στο σπίτι;"
    },
    {
      "id": 110504456339136522,
      "target": "SuperFake: Αλλά πες μου…"
    },
    {
      "id": 110504456339136521,
      "target": "SuperFake: «Ό,τι μου αφήσει η συνείδησή μου, θα το καταβρόχθιζα και με τα δόντια», έτσι;"
    },
    {
      "id": 110504456339136520,
      "target": "SuperFake: Υπέροχα!"
    },
    {
      "id": 110504456339136517,
      "target": "SuperFake: Είσαι μόνος στο σπίτι;"
    },
    {
      "id": 110504456339136516,
      "target": "SuperFake: Άκουυυ…"
    },
    {
      "id": 110504456339136515,
      "target": "SuperFake: Ναι, ναι, καταλαβαίνω."
    },
    {
      "id": 110504456339136514,
      "target": "Έχω καραμπίνα"
    },
    {
      "id": 110504456339136513,
      "target": "Δεν χρειάζομαι τίποτα"
    },
    {
      "id": 110504456339136512,
      "target": "SuperFake: Καταλαβαίνεις κι εσύ."
    },
    {
      "id": 110504456334942217,
      "target": "SuperFake: Ποτέ δεν ξέρεις."
    },
    {
      "id": 110504456334942216,
      "target": "SuperFake: Έχεις γερή πόρτα;"
    },
    {
      "id": 110504456334942215,
      "target": "Έχω καραμπίνα"
    },
    {
      "id": 110504456334942214,
      "target": "Δεν χρειάζομαι τίποτα"
    },
    {
      "id": 110504456334942213,
      "target": "SuperFake: Μου αρέσει."
    },
    {
      "id": 110504456334942212,
      "target": "SuperFake: Ευρύχωρο σπίτι."
    },
    {
      "id": 110504456334942210,
      "target": "Δεν πρόκειται να σε αφήσω να μπεις"
    },
    {
      "id": 110504456334942209,
      "target": "Τι θέλεις;"
    },
    {
