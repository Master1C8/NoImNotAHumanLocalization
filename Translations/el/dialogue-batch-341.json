  "authoredMapSha256": "818b29d33b8990fd7025fd94e33d19a43b778b9f353c7bec8fdba20a01d8fbc2",
  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504452887224323,
      "target": "Sirin: Πόσο σύντομα θα συμβεί;"
    },
    {
      "id": 110504452887224322,
      "target": "Sirin: Οι Επισκέπτες; Οι καταστροφές; Εμείς ο ένας τον άλλον;"
    },
    {
      "id": 110504452887224321,
      "target": "Sirin: Τι λες ότι θα μας σκοτώσει;"
    },
    {
      "id": 110504452887224320,
      "target": "Sirin: Πάντα μπορείς να το κάνεις πιο απλά…"
    },
    {
      "id": 110504452883030025,
      "target": "Sirin: Οι Επισκέπτες δεν θα σου ορμήσουν αν τους σημαδέψεις. Δεν θα προδοθούν."
    },
    {
      "id": 110504452883030024,
      "target": "Sirin: Γιατί ελέγχεις, σημαδεύεις, αλλά δεν πυροβολείς;"
    },
    {
      "id": 110504452883030021,
      "target": "Sirin: Απλώς κάνε αυτό που πρέπει."
    },
    {
      "id": 110504452883030020,
      "target": "Sirin: Μην καθυστερείς."
    },
    {
      "id": 110504452883030017,
      "target": "Sirin: Κάψε κι αυτή την εικόνα."
    },
    {
      "id": 110504452878835719,
      "target": "Sirin: Εκείνη ακόμα στενοχωριέται όταν τους θυμάται."
    },
    {
      "id": 110504452878835718,
      "target": "Sirin: Ήρθε η ώρα να το αποχωριστώ κι εγώ."
    },
    {
      "id": 110504452878835717,
      "target": "Sirin: Η αδελφή μου το έβγαλε."
    },
    {
      "id": 110504452878835715,
      "target": "Sirin: Μια ανάμνηση από τους γονείς μας."
    },
    {
      "id": 110504452878835714,
      "target": "Sirin: Μου έχει μείνει ένα σκουλαρίκι."
    },
    {
      "id": 110504452874641412,
      "target": "Sirin: Και πώς πρέπει;"
    },
    {
      "id": 110504452874641410,
      "target": "Sirin: Κάνε ό,τι θεωρείς σωστό."
    },
    {
      "id": 110504452874641409,
      "target": "Sirin: Δεν με νοιάζει αν θα μείνει κάτι μετά."
    }
  ]
}
