  "entries": [
    {
      "id": 110504457891028996,
      "target": "Phone: Προσπάθησα να επικοινωνήσω με τους φίλους και τους γνωστούς μου, αλλά κανείς δεν απαντά…"
    },
    {
      "id": 110504457891028995,
      "target": "Phone: Εγώ… έχω ανάγκη να μιλήσω σε κάποιον. Έχουν συμβεί τόσα πολλά τελευταία…"
    },
    {
      "id": 110504457891028994,
      "target": "Phone: …"
    },
    {
      "id": 110504457891028993,
      "target": "Phone: Μάλλον δεν είναι κανείς εκεί…"
    },
    {
      "id": 110504457891028992,
      "target": "Phone: …"
    },
    {
      "id": 110504457886834699,
      "target": "Phone: …"
    },
    {
      "id": 110504457886834698,
      "target": "…"
    },
    {
      "id": 110504457886834697,
      "target": "Γεια σας"
    },
    {
      "id": 110504457886834696,
      "target": "Phone: Εμπρός;"
    },
    {
      "id": 110504457886834695,
      "target": "Phone: …"
    },
    {
      "id": 110504457886834694,
      "target": "…"
    },
    {
      "id": 110504457886834693,
      "target": "Γεια σας"
    },
    {
      "id": 110504457886834692,
      "target": "Phone: Εμπρός, γεια σας."
    },
    {
      "id": 110504457886834691,
      "target": "Phone: …"
    },
    {
      "id": 110504457886834690,
      "target": "Phone: …"
    },
    {
      "id": 110504457886834689,
      "target": "Phone: Γεια σας, καλέσατε την Τηλεφωνική ρουλέτα. Θα σας βρούμε αμέσως το ιδανικό άτομο για κουβέντα. Παρακαλώ περιμένετε."
    },
    {
      "id": 110504457886834688,
      "target": "Phone: …"
    },
    {
      "id": 110504457882640396,
      "target": "Phone: …"
    },
    {
      "id": 110504457882640395,
      "target": "Phone: Λοιπόν, τελευταία ερώτηση: έχει χυθεί αίμα μέσα στο σπίτι σας;"
    },
    {
      "id": 110504457882640394,
      "target": "Phone: …"
    },
    {
      "id": 110504457882640393,
      "target": "Phone: Ωραία, τότε πείτε μου: τρώτε μανιτάρια;"
    },
    {
      "id": 110504457882640392,
      "target": "Phone: …"
    },
    {
      "id": 110504457882640391,
      "target": "Phone: …"
    },
    {
      "id": 110504457882640390,
      "target": "Phone: Θα συμβουλευτούμε τους προϊσταμένους μας και θα σας ενημερώσουμε αργότερα."
    },
    {
      "id": 110504457882640389,
      "target": "Phone: Τα αυτιά; Περιμένετε..."
    },
    {
      "id": 110504457882640388,
      "target": "Phone: …"
    },
    {
      "id": 110504457882640387,
      "target": "Phone: …"
    },
    {
      "id": 110504457882640386,
      "target": "Phone: Αποφύγετε το ντους και το πλύσιμο των χεριών."
    },
    {
      "id": 110504457882640385,
      "target": "Phone: Για να είναι σωστές οι εξετάσεις στις μασχάλες, πρέπει να αποφύγετε κάθε επαφή με νερό."
    },
    {
      "id": 110504457882640384,
      "target": "Phone: …"
    },
    {
      "id": 110504457878446091,
      "target": "Phone: …"
    },
    {
      "id": 110504457878446090,
      "target": "Phone: …"
    },
    {
      "id": 110504457878446089,
      "target": "Τι να κάνω με τα αυτιά μου;"
    },
    {
      "id": 110504457878446088,
      "target": "Τι να κάνω με τις μασχάλες μου;"
    },
    {
      "id": 110504457878446087,
      "target": "Phone: ΕΙΣΑΙ ΤΕΛΕΙΩΣ ΗΛΙΘΙΑ; ΚΛΕΙΣΕ ΑΜΕΣΩΣ ΤΟ ΤΗΛΕΦΩΝΟ!"
    },
    {
      "id": 110504457878446086,
      "target": "Phone: (Πριν προλάβει η γυναίκα να απαντήσει, ακούστηκε μια δυνατή αντρική κραυγή)"
    },
    {
      "id": 110504457878446085,
      "target": "Τι εννοείτε;"
    },
    {
      "id": 110504457878446084,
      "target": "Τι; ΕΕΑ; Τι είναι πάλι αυτό;"
    },
    {
      "id": 110504457878446083,
      "target": "Phone: Γεια σας, καλέσατε τη γραμμή βοήθειας της ΕΕΑ. Πώς μπορώ να σας βοηθήσω;"
    },
    {
      "id": 110504457878446082,
      "target": "Πρόσεχε τον εαυτό σου (Κλείσε το τηλέφωνο)"
    },
    {
      "id": 110504457878446081,
      "target": "Ποιοι είναι αυτοί της ΕΕΑ;"
    },
    {
      "id": 110504457878446080,
      "target": "Ευτυχώς δεν πήραν την κόρη σου"
    },
    {
      "id": 110504457874251787,
      "target": "Πού πήραν τον ένοικό σου;"
    },
    {
      "id": 110504457874251786,
      "target": "Πρόσεχε τον εαυτό σου (Κλείσε το τηλέφωνο)"
    },
    {
