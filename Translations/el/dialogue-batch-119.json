  "entries": [
    {
      "id": 110504455940677643,
      "target": "WheelChair: Εντάξει, την κάνω. Αλλά το αμαξίδιο θα το πάρω μαζί μου."
    },
    {
      "id": 110504455940677641,
      "target": "WheelChair: Γαμώτο, τι σου 'ρθε;"
    },
    {
      "id": 110504455940677640,
      "target": "WheelChair: Εμένα πάντως μ' αρέσει. Πρέπει να αρπάζεις ό,τι σου δίνει η ζωή."
    },
    {
      "id": 110504455940677639,
      "target": "WheelChair: Ε, καλά λοιπόν."
    },
    {
      "id": 110504455940677638,
      "target": "Άντε ξεκουμπίσου όσο είναι καιρός"
    },
    {
      "id": 110504455940677637,
      "target": "Είσαι απίστευτα παράξενος, γαμώτο"
    },
    {
      "id": 110504455940677636,
      "target": "WheelChair: Μη μου πεις ότι δεν το δοκίμασες ποτέ. Είναι φοβερό!"
    },
    {
      "id": 110504455940677635,
      "target": "WheelChair: Και δεν είναι φοβερό να κάνεις ντριφτ και να τρέχεις μ' αυτό;"
    },
    {
      "id": 110504455940677634,
      "target": "Άντε ξεκουμπίσου όσο είναι καιρός"
    },
    {
      "id": 110504455940677633,
      "target": "Είσαι απίστευτα παράξενος, γαμώτο"
    },
    {
      "id": 110504455940677632,
      "target": "WheelChair: Κι αν εννοείς το αμαξίδιο, απλώς μ' αρέσει να κυκλοφορώ μ' αυτό."
    },
    {
      "id": 110504455936483340,
      "target": "WheelChair: Δεν προσποιούμουν. Απλώς έτσι ζεσταίνονταν καλύτερα τα πόδια μου."
    },
    {
      "id": 110504455936483339,
      "target": "Για ποιον γαμημένο λόγο χρειαζόσουν τότε το αμαξίδιο;"
    },
    {
      "id": 110504455936483338,
      "target": "Γιατί παρίστανες τον ανάπηρο;"
    },
    {
      "id": 110504455936483337,
      "target": "WheelChair: Έλα τώρα, μουδιάσαν τα πόδια μου. Τι το παράξενο σ' αυτό;"
    },
    {
      "id": 110504455936483336,
      "target": "Τι στον πούτσο;"
    },
    {
      "id": 110504455936483335,
      "target": "WheelChair: Ουφ, έτσι είναι πολύ καλύτερα."
    },
    {
      "id": 110504455936483334,
      "target": "WheelChair: Μισό."
    },
    {
      "id": 110504455936483333,
      "target": "WheelChair: Γαμώτο, με πονάνε κάπως τα πόδια μου."
    }
  ]
}
