  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504455097622528,
      "target": "Daughter: Μάλλον αυτός είναι ο αριθμός της: {0}."
    },
    {
      "id": 110504455093428236,
      "target": "Daughter: Όταν τη φωνάζουν οι μεγάλοι, την αφήνουν να έρθει... Αν όμως τη φωνάξω εγώ, πάντα με μαλώνουν."
    },
    {
      "id": 110504455093428235,
      "target": "Daughter: Και κάτι ακόμη... μήπως μπορείτε να καλέσετε τη φίλη μου εδώ;.."
    },
    {
      "id": 110504455093428234,
      "target": "Cold: Συγχώρεσέ με. Δεν το ήθελα."
    },
    {
      "id": 110504455093428233,
      "target": "Cold: Κι όμως."
    },
    {
      "id": 110504455093428232,
      "target": "Cold: Καταλαβαίνω πόσο με μισείς."
    },
    {
      "id": 110504455093428231,
      "target": "Cold: Ευχαριστώ."
    },
    {
      "id": 110504455093428230,
      "target": "Cold: Ίσως καταφέρω να ζεσταθώ τουλάχιστον στον ήλιο. Για τελευταία φορά."
    },
    {
      "id": 110504455093428229,
      "target": "Cold: Συγγνώμη."
    },
    {
      "id": 110504455093428228,
      "target": "Cold: Κατάλαβα."
    },
    {
      "id": 110504455093428227,
      "target": "Δώσε μου μόνο μια αφορμή να πυροβολήσω"
    },
    {
      "id": 110504455093428226,
      "target": "Φύγε τώρα"
    },
    {
      "id": 110504455093428225,
      "target": "Cold: Μπορώ να μείνω ως τη νύχτα;"
    },
    {
      "id": 110504455093428224,
      "target": "Cold: Ο ήλιος θα με σκοτώσει αργά."
    },
    {
      "id": 110504455089233931,
      "target": "Cold: Πιο ηθικό θα ήταν να με πυροβολήσεις. Δυστυχώς νιώθω πόνο."
    },
    {
      "id": 110504455089233930,
      "target": "Cold: Αυτή τη στιγμή;"
    },
    {
      "id": 110504455089233929,
      "target": "Cold: Μη νομίζεις πως το έκανα επίτηδες."
    },
    {
      "id": 110504455089233928,
      "target": "Cold: Ήθελα μόνο να…"
    },
    {
      "id": 110504455089233927,
      "target": "Cold: Τότε θα τελειώσουν τα προβλήματα με το κρύο και τη μοναξιά."
    },
    {
      "id": 110504455089233926,
      "target": "Cold: Μάλλον έτσι είναι πιο ασφαλές."
    },
    {
      "id": 110504455089233925,
      "target": "Διώξ' τον"
    },
    {
      "id": 110504455089233923,
      "target": "Cold: Δεν ήθελα να συμβεί αυτό…"
    },
    {
      "id": 110504455089233922,
      "target": "Cold: Δεν το έκανα από κακία."
    },
    {
      "id": 110504455089233921,
      "target": "Cold: Μη βγάζεις βιαστικά συμπεράσματα."
    },
    {
      "id": 110504455089233920,
      "target": "Cold: Γιατί νόμιζα πως αυτή τη φορά κάτι θα άλλαζε;"
    },
    {
      "id": 110504455085039628,
      "target": "Cold: Έτσι ήταν και παλιά."
    },
    {
      "id": 110504455085039627,
      "target": "Διώξ' τον"
    },
    {
      "id": 110504455085039625,
      "target": "Cold: Αλήθεια, δεν το ήθελα."
    },
    {
      "id": 110504455085039624,
      "target": "Cold: Δεν το ήθελα."
    },
    {
      "id": 110504455085039623,
      "target": "Cold: Γιατί μου συμβαίνει αυτό;"
    },
    {
      "id": 110504455085039622,
      "target": "Cold: Ήλπιζα πως εδώ δεν θα γινόταν κάτι τέτοιο."
    },
    {
      "id": 110504455085039621,
      "target": "Cold: Δεν το έκανα επίτηδες…"
    },
    {
      "id": 110504455085039620,
      "target": "Τη γάμησες"
    },
    {
      "id": 110504455085039619,
      "target": "Τι έκανες;"
    },
    {
      "id": 110504455085039618,
      "target": "Cold: Ωχ, όχι. Πάλι."
    },
    {
      "id": 110504455085039617,
      "target": "Cold: Κοίτα."
    },
    {
      "id": 110504455085039616,
      "target": "Cold: Κάτω από τα ρούχα μου κρύβω αυτό που, νομίζω, προκαλεί τη μοναξιά και το κρύο που με κατατρώνε."
    },
    {
      "id": 110504455080845324,
      "target": "Cold: Συνήθως αυτό δεν καταλήγει καλά, αλλά ίσως τώρα να είναι αλλιώς."
    },
    {
      "id": 110504455080845323,
      "target": "Cold: Νομίζω πως είμαι έτοιμος."
    },
    {
      "id": 110504455080845322,
      "target": "Cold: Ναι, ήθελα να σου αποκαλύψω ένα μυστικό μου."
    },
    {
      "id": 110504455080845320,
      "target": "Τι είναι λοιπόν αυτό που κρύβεις;"
    }
  ]
}
