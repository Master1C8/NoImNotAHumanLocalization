  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504456104255492,
      "target": "Megőrzöm az emléket magukról."
    },
    {
      "id": 110504456104255491,
      "target": "Nem tudnának megmaradni a Kozmosz őrült sodrásában."
    },
    {
      "id": 110504456104255490,
      "target": "Éppen úgy, ahogy az emberek akarták."
    },
    {
      "id": 110504456104255489,
      "target": "Nyugalmat adok maguknak."
    },
    {
      "id": 110504456104255488,
      "target": "Visszaviszem magukat oda, ahol eredetileg lenniük kellett volna."
    },
    {
      "id": 110504456100061195,
      "target": "Elrejtem magukat."
    },
    {
      "id": 110504456100061194,
      "target": "Most közbe kell lépnem."
    },
    {
      "id": 110504456100061193,
      "target": "Érzed? Ő az."
    },
    {
      "id": 110504456100061192,
      "target": "Talán maga a Halál is leereszkedik hozzánk, és…"
    },
    {
      "id": 110504456100061191,
      "target": "Senki sem távozik sértődötten."
    },
    {
      "id": 110504456100061190,
      "target": "Mindenki békére lel."
    },
    {
      "id": 110504456100061189,
      "target": "Most már mindent helyesen teszünk."
    },
    {
      "id": 110504456100061188,
      "target": "A Halálról alkotott elavult képünk akadályozott meg abban, hogy helyesen haljunk meg."
    },
    {
      "id": 110504456100061187,
      "target": "Örülök, hogy csatlakoztál hozzánk. A Halál valóban nem hiába választott ki téged."
    }
  ]
}
