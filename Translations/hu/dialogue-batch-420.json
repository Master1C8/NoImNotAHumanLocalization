  "entries": [
    {
      "id": 110504452622983176,
      "target": "Luka: Mindig kész vagyok meghallgatni téged."
    },
    {
      "id": 110504452622983174,
      "target": "Luka: Rendben."
    },
    {
      "id": 110504452622983173,
      "target": "Luka: De én mindig kész vagyok meghallgatni téged."
    },
    {
      "id": 110504452622983171,
      "target": "Luka: A hangunk nem hallatszik el a Világegyetemben."
    },
    {
      "id": 110504452622983168,
      "target": "Luka: Még valami, ami megmarad utánam."
    },
    {
      "id": 110504452618788874,
      "target": "Luka: Még valami, ami megmarad utánam. Bárcsak maradna is valaki utánunk."
    },
    {
      "id": 110504452618788872,
      "target": "Luka: Rendben."
    },
    {
      "id": 110504452618788869,
      "target": "Luka: Nem látszik rajta semmi különös, ugye?"
    },
    {
      "id": 110504452618788867,
      "target": "Luka: Nem tudtam, hogy ez is fontos."
    },
    {
      "id": 110504452618788864,
      "target": "Luka: A szem sok mindenre emlékszik."
    },
    {
      "id": 110504452614594569,
      "target": "Luka: Persze."
    },
    {
      "id": 110504452614594566,
      "target": "Luka: Minden, ami a veszteségek után megmaradt."
    },
    {
      "id": 110504452614594564,
      "target": "Luka: Tessék, itt vannak."
    },
    {
      "id": 110504452614594561,
      "target": "Luka: Vajon a fogak sokat elárulnak az emberről?.."
    },
    {
      "id": 110504452610400266,
      "target": "Luka: Tessék, nézd meg."
    },
    {
      "id": 110504452610400259,
      "target": "Luka: Vizsgálj meg, ha ez segít neked."
    }
  ]
}
