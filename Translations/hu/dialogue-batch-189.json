  "sourceInventorySha256": "ecd96645c2ca6f23f8bf3ab2fcf65709e961478ae15a38e83d94cc335a408bf0",
  "glossaryFingerprint": "8386700825df9e4bdf0b57482c1971b93cf495d18ce1232c2b5a3e281a186cea",
  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504456116838409,
      "target": "Nem tudja, mi lett a házával."
    },
    {
      "id": 110504456116838408,
      "target": "Még az sem világos, mit kellene csinálni a munkában."
    },
    {
      "id": 110504456116838407,
      "target": "Azt sem tudni, mikor engedik haza."
    },
    {
      "id": 110504456116838402,
      "target": "Bármi legyen is a következménye, megölték a gyermeket."
    },
    {
      "id": 110504456116838401,
      "target": "A hölgy szavaitól megbénul."
    },
    {
      "id": 110504456116838400,
      "target": "De te… te messzire viszed a poklot."
    },
    {
      "id": 110504456112644107,
      "target": "A gyermek valami szörnyűség birodalmába vezetett volna minket."
    },
    {
      "id": 110504456112644106,
      "target": "Bűnei miatt vádolod a világunkat."
    },
    {
      "id": 110504456112644105,
      "target": "Mi történik?"
    },
    {
      "id": 110504456112644104,
      "target": "Jó jel velük találkozni?"
    },
    {
      "id": 110504456112644103,
      "target": "Valami állandóan figyeli magát?"
    },
    {
      "id": 110504456112644102,
      "target": "És ezért nincs kit hibáztatni."
    },
    {
      "id": 110504456112644101,
      "target": "Kidobtak az utcára."
    },
    {
      "id": 110504456112644100,
      "target": "Ez úgyis megtörténik."
    },
    {
      "id": 110504456112644099,
      "target": "Látom, milyen terveik voltak veled."
    },
    {
      "id": 110504456112644098,
      "target": "A félelemtől könnyen meg lehet őrülni."
    },
    {
      "id": 110504456112644097,
      "target": "Félelmetes meghalni."
    },
    {
      "id": 110504456108449798,
      "target": "Gyere utánam, futás!"
    },
    {
      "id": 110504456108449797,
      "target": "Annyi gyűlt össze belőlük, hogy a gomba kalapja az egész Föld felszínét beborítja."
    },
    {
      "id": 110504456108449796,
      "target": "És minél több a gomba…"
    },
    {
      "id": 110504456108449795,
      "target": "Nagyon gyorsan tudnak nőni, ha rosszra fordulnak a dolgok."
    },
    {
      "id": 110504456108449794,
      "target": "De ez később lesz."
    },
    {
      "id": 110504456108449793,
      "target": "Senki sem lábatlankodik."
    },
    {
      "id": 110504456108449792,
      "target": "Nagyon nyugodt minden."
    },
    {
      "id": 110504456104255499,
      "target": "És hányat ölt meg még? Hányat égetett el?"
    },
    {
      "id": 110504456104255498,
      "target": "Vigilante: Véged van, te kibaszott okostojás!"
    },
    {
      "id": 110504456104255497,
      "target": "Vigilante: Hülyének nézel, bazdmeg? Azt hiszed, ezt beveszem?"
    },
    {
      "id": 110504456104255496,
      "target": "Vigilante: Na, most rábasztál, te kis rohadék…"
    },
    {
      "id": 110504456104255495,
      "target": "Vigilante: Kurva élet, te kibaszott Vendég vagy!"
    },
    {
      "id": 110504456104255494,
      "target": "Vigilante: Ideje megdögölnöd, rohadék."
    },
    {
      "id": 110504456104255493,
      "target": "Vigilante: Te rohadék! Kibaszott Vendég, azt hitted, átverhetsz?"
    }
  ]
}
