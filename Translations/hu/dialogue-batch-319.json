  "entries": [
    {
      "id": 110504454455894021,
      "target": "Widow: Remélem, megtalálja, amit keres."
    },
    {
      "id": 110504454455894020,
      "target": "Widow: Keveset beszél, de… jó beszélgetőtársnak bizonyult."
    },
    {
      "id": 110504454455894019,
      "target": "Widow: Köszönöm."
    },
    {
      "id": 110504454455894018,
      "target": "Widow: Amíg haza nem érek, nem akarok semmiről dönteni."
    },
    {
      "id": 110504454455894017,
      "target": "Widow: Nagyon szeretnék hazamenni."
    },
    {
      "id": 110504454455894016,
      "target": "Widow: Közömbös vagy számomra, bocsáss meg."
    },
    {
      "id": 110504454451699715,
      "target": "Widow: Attól nem lesz könnyebb."
    },
    {
      "id": 110504454451699714,
      "target": "Widow: Miért?"
    },
    {
      "id": 110504454451699713,
      "target": "Sok szerencsét"
    },
    {
      "id": 110504454451699712,
      "target": "Maradhatsz"
    },
    {
      "id": 110504454447505416,
      "target": "Widow: Már nem akarok semmi mást."
    },
    {
      "id": 110504454447505415,
      "target": "Widow: Hazamegyünk."
    },
    {
      "id": 110504454447505414,
      "target": "Widow: Senki sem maradt."
    },
    {
      "id": 110504454447505413,
      "target": "Sok szerencsét"
    },
    {
      "id": 110504454447505412,
      "target": "Maradhatsz"
    },
    {
      "id": 110504454447505411,
      "target": "Widow: És ott…"
    },
    {
      "id": 110504454447505410,
      "target": "Widow: Előveszem a gitárt."
    },
    {
      "id": 110504454447505409,
      "target": "Widow: Hazamegyek."
    },
    {
      "id": 110504454447505408,
      "target": "Widow: Nem akarok erre gondolni."
    },
    {
      "id": 110504454443311116,
      "target": "A rokonaidhoz mész?"
    },
    {
      "id": 110504454443311115,
      "target": "És most mi lesz?"
    },
    {
      "id": 110504454443311114,
      "target": "Widow: Csak pihenésre volt szükségem."
    },
    {
      "id": 110504454443311113,
      "target": "Widow: Már az elején mondtam, hogy nem maradok sokáig."
    },
    {
      "id": 110504454443311112,
      "target": "Widow: Ma éjjel elmegyek."
    },
    {
      "id": 110504454443311110,
      "target": "Valami baj van?"
    },
    {
      "id": 110504454443311109,
      "target": "Widow: Jó lenne egy kicsit pihenni…"
    },
    {
      "id": 110504454443311108,
      "target": "Widow: Most nagyon nehéz nélküle élni…"
    },
    {
      "id": 110504454443311107,
      "target": "Widow: Igen. Kérem."
    },
    {
      "id": 110504454443311106,
      "target": "Widow: Szeretnék egyedül lenni."
    }
  ]
}
