  "entries": [
    {
      "id": 110504456745984004,
      "target": "SuperFake: Ki fogod nyitni nekem az ajtót."
    },
    {
      "id": 110504456745984003,
      "target": "SuperFake: Ha legalább két emberem lesz a házadban…"
    },
    {
      "id": 110504456745984002,
      "target": "SuperFake: Változtassunk ezen."
    },
    {
      "id": 110504456745984001,
      "target": "SuperFake: Mintha nem is törődnél magaddal."
    },
    {
      "id": 110504456745984000,
      "target": "SuperFake: Elég közönyösnek tűnsz."
    },
    {
      "id": 110504456741789707,
      "target": "Tudnál később visszajönni?"
    },
    {
      "id": 110504456741789705,
      "target": "SuperFake: Mert most kutyák lakják a testeket."
    },
    {
      "id": 110504456741789704,
      "target": "SuperFake: Ki fogod nyitni nekem az ajtót."
    },
    {
      "id": 110504456741789703,
      "target": "SuperFake: Ha legalább két emberem lesz a házadban…"
    },
    {
      "id": 110504456741789702,
      "target": "SuperFake: Kipróbáljuk az új szabályokat."
    },
    {
      "id": 110504456741789701,
      "target": "SuperFake: Úgy látszik, segíteni kell."
    },
    {
      "id": 110504456741789700,
      "target": "SuperFake: Nehéz neked."
    },
    {
      "id": 110504456741789699,
      "target": "Nem érdekel"
    },
    {
      "id": 110504456741789698,
      "target": "Nem érzem ezt"
    },
    {
      "id": 110504456741789697,
      "target": "SuperFake: Érdekes dolgok történnek körülötted."
    },
    {
      "id": 110504456741789696,
      "target": "SuperFake: Érted, kiről beszélek?"
    },
    {
      "id": 110504456737595403,
      "target": "SuperFake: Hiszen neki csak egy szava van, egyetlen szó, de micsoda szó!"
    },
    {
      "id": 110504456737595402,
      "target": "SuperFake: Az egyes ember pedig már nem hal meg."
    },
    {
      "id": 110504456737595401,
      "target": "SuperFake: Én is."
    },
    {
      "id": 110504456737595400,
      "target": "SuperFake: A változások üldöznek."
    },
    {
      "id": 110504456737595399,
      "target": "SuperFake: Érzed?"
    },
    {
      "id": 110504456737595398,
      "target": "SuperFake: A következő találkozásunk érdekesebb lesz."
    },
    {
      "id": 110504456737595397,
      "target": "SuperFake: Te pedig nem bírsz lépést tartani az új ritmussal."
    },
    {
      "id": 110504456737595396,
      "target": "SuperFake: Megváltozott az élet."
    },
    {
      "id": 110504456737595395,
      "target": "SuperFake: Ugye érted, hogy már semmi sem lesz olyan, mint régen?"
    },
    {
      "id": 110504456737595393,
      "target": "SuperFake: Kutyák uralják a világot. És itt csak kutyák maradnak."
    }
  ]
}
