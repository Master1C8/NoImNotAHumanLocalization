  "entries": [
    {
      "id": 110504452803338242,
      "target": "Daughter: Szerintem hamarosan eljön."
    },
    {
      "id": 110504452803338241,
      "target": "Daughter: Amikor értem jön, biztos elmondom neki, hogy ön egyáltalán nem Vendég."
    },
    {
      "id": 110504452803338240,
      "target": "Daughter: Köszönöm, hogy úgy csinálja, mint apukám."
    },
    {
      "id": 110504452799143941,
      "target": "Daughter: Apa azt mondta, félni kell az élősködőktől, a kullancsoktól meg a bogaraktól. Azokat keresi?"
    },
    {
      "id": 110504452799143940,
      "target": "Daughter: Nekem ez nem tetszett. Ne kérjen többé fényképet rólam."
    },
    {
      "id": 110504452799143939,
      "target": "Daughter: Köszönöm."
    },
    {
      "id": 110504452799143938,
      "target": "Daughter: Hmmm."
    },
    {
      "id": 110504452799143936,
      "target": "Daughter: Utána megmutatja a fényképet?"
    },
    {
      "id": 110504452794949639,
      "target": "Daughter: Rólam ritkán készítettek fényképet."
    },
    {
      "id": 110504452794949638,
      "target": "Daughter: Fénykép?"
    }
  ]
}
