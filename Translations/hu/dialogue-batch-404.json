  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504452887224323,
      "target": "Sirin: Milyen hamar fog ez megtörténni?"
    },
    {
      "id": 110504452887224322,
      "target": "Sirin: A Vendégek? A katasztrófák? Vagy mi öljük meg egymást?"
    },
    {
      "id": 110504452887224321,
      "target": "Sirin: Szerinted mi fog végezni velünk?"
    },
    {
      "id": 110504452887224320,
      "target": "Sirin: Mindig lehet egyszerűbben is…"
    },
    {
      "id": 110504452883030025,
      "target": "Sirin: A Vendégek sem fognak rád ugrani, ha rájuk célzol. Nem fogják elárulni magukat."
    },
    {
      "id": 110504452883030024,
      "target": "Sirin: Miért vizsgálódsz, célzol, de nem lősz?"
    },
    {
      "id": 110504452883030021,
      "target": "Sirin: Csak tedd meg, amit meg kell tenned."
    },
    {
      "id": 110504452883030020,
      "target": "Sirin: Ne késlekedj."
    },
    {
      "id": 110504452883030017,
      "target": "Sirin: És azt a képet is égesd el."
    },
    {
      "id": 110504452878835719,
      "target": "Sirin: Neki még mindig rossz visszagondolni rájuk."
    },
    {
      "id": 110504452878835718,
      "target": "Sirin: Nekem is ideje megszabadulnom tőle."
    },
    {
      "id": 110504452878835717,
      "target": "Sirin: A testvérem viszont levette."
    },
    {
      "id": 110504452878835715,
      "target": "Sirin: A szüleinkre emlékeztet."
    },
    {
      "id": 110504452878835714,
      "target": "Sirin: Nekem megmaradt egy fülbevalóm."
    },
    {
      "id": 110504452874641412,
      "target": "Sirin: És hogyan kellene?"
    },
    {
      "id": 110504452874641410,
      "target": "Sirin: Tedd, amit helyesnek gondolsz."
    },
    {
      "id": 110504452874641409,
      "target": "Sirin: Nem érdekel, marad-e valami utánam."
    }
  ]
}
