  "entries": [
    {
      "id": 110504455529635844,
      "target": "Cat: (Ki tudja, talán ma éjjel a halál elkerüli a házát?)"
    },
    {
      "id": 110504455529635843,
      "target": "Cat: (Mintha a szőrös kedvenc hálából megosztotta volna önnel az egyik életét.)"
    },
    {
      "id": 110504455529635842,
      "target": "Cat: (Furcsa érzése támad: ma éjjel nyugodtan alhat.)"
    },
    {
      "id": 110504455529635841,
      "target": "Cat: (Bár a macska pofájáról nehéz leolvasni az érzelmeit, biztosan örül.)"
    },
    {
      "id": 110504455525441548,
      "target": "Cat: Miau! MIAU! Miau!"
    },
    {
      "id": 110504455525441547,
      "target": "Cat: (De hát ki tudna ellenállni egy ilyen cukiságnak?)"
    },
    {
      "id": 110504455525441546,
      "target": "Cat: (Úgy érzi, most már magától bújik oda a simogatásért)"
    },
    {
      "id": 110504455525441545,
      "target": "Cat: (A macskának nagyon tetszik, hogy ilyen gyakran simogatja)"
    },
    {
      "id": 110504455525441544,
      "target": "Konzervvel megetetni a macskát"
    },
    {
      "id": 110504455525441543,
      "target": "Felvenni az ölébe"
    },
    {
      "id": 110504455525441542,
      "target": "Megsimogatni"
    },
    {
      "id": 110504455525441541,
      "target": "Cat: Miau!"
    },
    {
      "id": 110504455525441540,
      "target": "Cat: (Úgy tűnik, lassan hozzászokik önhöz)"
    },
    {
      "id": 110504455525441539,
      "target": "Cat: (Nem is olyan mogorva, mint elsőre gondolta.)"
    },
    {
      "id": 110504455525441538,
      "target": "Cat: (Úgy tűnik, mégis nagyon tetszik neki)"
    },
    {
      "id": 110504455525441537,
      "target": "Cat: (Rászánja magát, hogy megsimogassa a macskát)"
    },
    {
      "id": 110504455525441536,
      "target": "Konzervvel megetetni a macskát"
    },
    {
      "id": 110504455521247243,
      "target": "Felvenni az ölébe"
    },
    {
      "id": 110504455521247242,
      "target": "Megsimogatni"
    },
    {
      "id": 110504455521247241,
      "target": "Cat: Miau!"
    },
    {
      "id": 110504455521247240,
      "target": "Cat: (Nehéz eldönteni, tetszik-e neki vagy sem.)"
    },
    {
      "id": 110504455521247239,
      "target": "Cat: (Kinyújtja a kezét, és megsimogatja a macskát.)"
    },
