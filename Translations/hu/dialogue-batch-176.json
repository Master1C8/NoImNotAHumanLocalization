  "entries": [
    {
      "id": 110504456284610560,
      "target": "Widow: Te…"
    },
    {
      "id": 110504456280416266,
      "target": "Widow: Csak pihennem kell egy kicsit."
    },
    {
      "id": 110504456280416265,
      "target": "Widow: Nem hiszem, hogy sokáig maradok."
    },
    {
      "id": 110504456280416262,
      "target": "Widow: Mindenki törődött volna vele."
    },
    {
      "id": 110504456280416261,
      "target": "Widow: Még élhetne, ha…"
    },
    {
      "id": 110504456280416260,
      "target": "Widow: Most meghalt."
    },
    {
      "id": 110504456280416259,
      "target": "Widow: Már nem. Amikor kellett volna, senki sem segített."
    },
    {
      "id": 110504456280416256,
      "target": "Widow: Most már rendesen el sem tudom temetni. Elengednem őt most már értelmetlen."
    },
    {
      "id": 110504456276221961,
      "target": "Widow: Meghalt."
    },
    {
      "id": 110504456276221960,
      "target": "Widow: Ő a férjem."
    },
    {
      "id": 110504456276221959,
      "target": "Segítségre van szüksége a barátodnak?"
    },
    {
      "id": 110504456276221958,
      "target": "Rosszul van a társad?"
    },
    {
      "id": 110504456276221957,
      "target": "Widow: Már mindegy, hová kerülök."
    },
    {
      "id": 110504456276221956,
      "target": "Widow: Én… én csak szeretnék valahol összeesni, és többé fel sem kelni."
    },
    {
      "id": 110504456276221955,
      "target": "Segítségre van szüksége a barátodnak?"
    },
    {
      "id": 110504456276221954,
      "target": "Rosszul van a társad?"
    },
    {
      "id": 110504456276221953,
      "target": "Widow: Nagyon elfáradtam. Ha nem pihenek, egyszerűen összeesem az ablakod alatt."
    },
    {
      "id": 110504456276221952,
      "target": "Widow: Már nem emlékszem. Úgyis mindegy, honnan."
    },
    {
      "id": 110504456272027658,
      "target": "És utána hová mész?"
    },
    {
      "id": 110504456272027657,
      "target": "Honnan jöttél?"
    },
    {
      "id": 110504456272027656,
      "target": "Widow: Pihenhetek nálad?"
    }
  ]
}
