  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504456708235275,
      "target": "Cold: Hát igen. Neked magadnak kellenek a golyók. Viszlát."
    },
    {
      "id": 110504456708235273,
      "target": "Cold: Rám tudnál lőni?"
    },
    {
      "id": 110504456708235272,
      "target": "Cold: Sok lőpormaradványt látok a kezeden."
    },
    {
      "id": 110504456708235271,
      "target": "Cold: Rendben, viszlát."
    },
    {
      "id": 110504456708235270,
      "target": "Cold: Értem."
    },
    {
      "id": 110504456708235269,
      "target": "Cold: Kicsit alacsony itt a mennyezet. De nekem megfelel."
    },
    {
      "id": 110504456708235268,
      "target": "Cold: Köszönöm."
    },
    {
      "id": 110504456708235265,
      "target": "Cold: Egyszerűen továbbmegyek. Nem fogok könyörögni vagy a terhedre lenni."
    },
    {
      "id": 110504456708235264,
      "target": "Cold: Nem muszáj beengedned."
    },
    {
      "id": 110504456704040971,
      "target": "Cold: Nem."
    },
    {
      "id": 110504456704040968,
      "target": "Cold: Mi van, ha még többet szenvedek? És abba sem tudok belehalni?"
    },
    {
      "id": 110504456704040967,
      "target": "Cold: Félek levenni a ruhámat."
    },
    {
      "id": 110504456704040966,
      "target": "Cold: Miközben mások elégnek az utcán, én kabátokba burkolózom, és még mindig fázom."
    },
    {
      "id": 110504456704040965,
      "target": "Cold: Mindig fázom."
    },
    {
      "id": 110504456704040964,
      "target": "Vedd le a kabátodat"
    },
    {
      "id": 110504456704040963,
      "target": "Nem félsz a hőségtől?"
    },
    {
      "id": 110504456704040962,
      "target": "Cold: Ezért… sokáig."
    },
    {
      "id": 110504456704040961,
      "target": "Cold: Velem ilyen még soha nem történt."
    },
    {
      "id": 110504456699846668,
      "target": "Vedd le a kabátodat"
    },
    {
      "id": 110504456699846667,
      "target": "Nem félsz a hőségtől?"
    },
    {
      "id": 110504456699846666,
      "target": "Cold: Később. Egyelőre nem vagyok biztos benne."
    },
    {
      "id": 110504456699846665,
      "target": "Cold: Nem, nem vagyok Vendég. De szeretnék kérni tőled valamit."
    },
    {
      "id": 110504456699846664,
      "target": "Cold: Ez már nem számít. Azt kérdezed, Vendég vagyok-e, igaz?"
    },
    {
      "id": 110504456699846663,
      "target": "Mióta keresel egy nyugodt helyet?"
    },
    {
      "id": 110504456699846661,
      "target": "Cold: Találhatok nálad nyugalmat?"
    },
    {
      "id": 110504456699846660,
      "target": "Cold: Előre szólok: nem félek a hőségtől. Mégis nyugodt helyet keresek."
    },
    {
      "id": 110504456699846659,
      "target": "Cold: Szia."
    }
  ]
}
