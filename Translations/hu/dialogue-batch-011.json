  "entries": [
    {
      "id": 110504457823920137,
      "target": "Phone: Viszonthallásra."
    },
    {
      "id": 110504457823920136,
      "target": "Phone: És… köszönöm, hogy segített neki."
    },
    {
      "id": 110504457823920135,
      "target": "Phone: Kész vagyok befogadni a fiútestvéremet. Mondja meg neki. Tudja a címemet."
    },
    {
      "id": 110504457823920134,
      "target": "Phone: …"
    },
    {
      "id": 110504457823920133,
      "target": "Phone: Istenem… Hogy történt ez?…"
    },
    {
      "id": 110504457823920132,
      "target": "Phone: …"
    },
    {
      "id": 110504457823920130,
      "target": "Valószínűleg"
    },
    {
      "id": 110504457823920128,
      "target": "Phone: A francba… Ez lehetetlen… Meghaltak?"
    },
    {
      "id": 110504457819725835,
      "target": "Phone: …"
    },
    {
      "id": 110504457819725834,
      "target": "Phone: Csak nem ők…"
    },
    {
      "id": 110504457819725833,
      "target": "Phone: Menedéket keresve? De hiszen a szüleivel lakik, nem?"
    },
    {
      "id": 110504457819725831,
      "target": "Valószínűleg"
    },
    {
      "id": 110504457819725829,
      "target": "Phone: A francba… Ez lehetetlen… Meghaltak?"
    },
    {
      "id": 110504457819725828,
      "target": "Phone: …"
    },
    {
      "id": 110504457819725827,
      "target": "Phone: Ugye nem azt akarja mondani, hogy…"
    },
    {
      "id": 110504457819725826,
      "target": "Phone: Eltűntek? Hogy történhetett ez?"
    },
    {
      "id": 110504457819725825,
      "target": "Menedéket keresve jött hozzám"
    },
    {
      "id": 110504457819725824,
      "target": "Eltűntek a szülei"
    },
    {
      "id": 110504457815531532,
      "target": "Phone: De várjon… Maga kicsoda? És miért van ő magánál?"
    },
    {
      "id": 110504457815531531,
      "target": "Phone: Á, a vér szerinti fiútestvéremről beszél, igaz?"
    },
    {
      "id": 110504457815531530,
      "target": "Phone: …"
    },
    {
      "id": 110504457815531529,
      "target": "Phone: Miféle testvér? Nekem nincs…"
    },
    {
      "id": 110504457815531528,
      "target": "Tudna segíteni a fiútestvérének?"
    },
    {
      "id": 110504457815531527,
      "target": "Jó napot. A fiútestvére adta meg a számát"
    },
    {
      "id": 110504457815531526,
      "target": "Phone: Halló, ki beszél?"
    }
  ]
}
