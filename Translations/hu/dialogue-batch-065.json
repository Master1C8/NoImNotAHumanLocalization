    },
    {
      "id": 110504457282854915,
      "target": "Segítsek megtalálni a házadat?"
    },
    {
      "id": 110504457282854914,
      "target": "Mit keresel itt?"
    },
    {
      "id": 110504457282854913,
      "target": "StaticBoy: De kellenek egyáltalán?.."
    },
    {
      "id": 110504457282854912,
      "target": "StaticBoy: Nekem nincsenek. Soha nem is voltak."
    },
    {
      "id": 110504457278660618,
      "target": "StaticBoy: A szüleim?"
    },
    {
      "id": 110504457278660616,
      "target": "Segítsek megtalálni a házadat?"
    },
    {
      "id": 110504457278660615,
      "target": "Mit keresel itt?"
    },
    {
      "id": 110504457278660614,
      "target": "StaticBoy: Hallottam, ahogy megnyikordult egy lépcsőfok – tehát valaki vár."
    },
    {
      "id": 110504457278660613,
      "target": "StaticBoy: A konyha fénye kellett volna, de itt… más a visszhang."
    },
    {
      "id": 110504457278660611,
      "target": "StaticBoy: Sötétben hasonlítanak az ajtók."
    },
    {
      "id": 110504457278660610,
      "target": "Hol vannak a szüleid?"
    },
    {
      "id": 110504457278660609,
      "target": "Eltévedtél?"
    },
    {
      "id": 110504457278660608,
      "target": "StaticBoy: Kellene…"
    },
    {
