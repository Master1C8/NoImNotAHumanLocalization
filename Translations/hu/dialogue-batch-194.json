  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504456066506756,
      "target": "Hacsak…"
    },
    {
      "id": 110504456066506755,
      "target": "Lassan elégsz."
    },
    {
      "id": 110504456066506754,
      "target": "Már arra sincs lehetőséged, hogy véget vess az életednek, és ne kelljen szenvedned."
    },
    {
      "id": 110504456066506753,
      "target": "Már annyi erőd sincs, hogy elmássz a napsugarak elől."
    },
    {
      "id": 110504456066506752,
      "target": "Puska nélkül. Összeverten."
    },
    {
      "id": 110504456062312457,
      "target": "Nagyon sajnálom."
    },
    {
      "id": 110504456062312456,
      "target": "Csak… te hoztad közelebb."
    },
    {
      "id": 110504456062312455,
      "target": "Előbb vagy utóbb."
    },
    {
      "id": 110504456062312454,
      "target": "Félsz attól, hogy eltűnsz?"
    },
    {
      "id": 110504456062312453,
      "target": "A fájdalomtól?"
    },
    {
      "id": 110504456062312452,
      "target": "És pontosan mitől ijedtél meg?"
    },
    {
      "id": 110504456062312451,
      "target": "Nagyon szomorú látni, mi vár rád."
    },
    {
      "id": 110504456062312450,
      "target": "Könnyű meghozni a szörnyű döntéseket."
    },
    {
      "id": 110504456062312449,
      "target": "Ezt nagyon jól megértem."
    },
    {
      "id": 110504456062312448,
      "target": "Aligha tudok már változtatni azon, ami ezután történik. Bocsáss meg."
    },
    {
      "id": 110504456058118155,
      "target": "A félelem elhomályosította a szemed."
    },
    {
      "id": 110504456058118154,
      "target": "Túlságosan megrémültél. Ó, ne."
    },
    {
      "id": 110504456058118153,
      "target": "Várj, azt hiszem, látok valamit."
    },
    {
      "id": 110504456058118152,
      "target": "Biztosan rosszul csinálsz valamit."
    },
    {
      "id": 110504456058118151,
      "target": "Aligha tudom ezt helyrehozni. Bocsáss meg."
    },
    {
      "id": 110504456058118150,
      "target": "De nyilvánvalóan rosszul csinálsz valamit. Csak közelebb hoztad a halált."
    },
    {
      "id": 110504456058118149,
      "target": "Félsz meghalni? Ez természetes."
    },
    {
      "id": 110504456058118148,
      "target": "Van valami mögötted, egész árnyékcsóva. Mintha nem így lett volna eltervezve."
    },
    {
      "id": 110504456058118147,
      "target": "Szerintem érted."
    },
    {
      "id": 110504456058118146,
      "target": "Vendégeket ölök. Másképp hogy élném túl?"
    },
    {
      "id": 110504456058118145,
      "target": "Nem értem, miről beszélsz"
    },
    {
      "id": 110504456058118144,
      "target": "Te… elkövettél valamit?"
    },
    {
      "id": 110504456053923852,
      "target": "Olyasmit megismerve, amitől már semmit sem akarunk, a nyirkos föld vizsgál bennünket."
    },
    {
      "id": 110504456053923851,
      "target": "A házadat látva eszembe jut egy mondat."
    },
    {
      "id": 110504456053923850,
      "target": "Szia. Ma nem terveztem hozzád jönni, de azt láttam, hogy itt valami… furcsa történik."
    }
  ]
}
