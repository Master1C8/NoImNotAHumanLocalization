  "entries": [
    {
      "id": 110504455663853573,
      "target": "Foreigner: Kflyj, qf djpmve..."
    },
    {
      "id": 110504455663853571,
      "target": "Foreigner: Xnj 'nj?"
    },
    {
      "id": 110504455663853570,
      "target": "Ballerina: Egyszerűbb lenne nekem magamnak feldobni a talpam."
    },
    {
      "id": 110504455663853569,
      "target": "Ballerina: Jó, elfáradtam."
    },
    {
      "id": 110504455663853568,
      "target": "Ballerina: HOPPÁÁÁ."
    },
    {
      "id": 110504455659659269,
      "target": "Ballerina: Behunyod a szemed, amikor lősz, vagy mi?"
    },
    {
      "id": 110504455659659268,
      "target": "Ballerina: Nem találtál el! Pedig közel állok."
    },
    {
      "id": 110504455659659267,
      "target": "Ballerina: Hopp!"
    },
    {
      "id": 110504455655464971,
      "target": "Ballerina: Megpróbálod még egyszer?"
    },
    {
      "id": 110504455655464970,
      "target": "Ballerina: Hopp!"
    },
    {
      "id": 110504455655464967,
      "target": "Ballerina: IMÁDOK TÁNCOLNI. Mutassak egy táncot? Csak lőj."
    },
    {
      "id": 110504455655464966,
      "target": "Ballerina: AHAHAHAHAHAHA."
    },
    {
      "id": 110504455655464965,
      "target": "Ballerina: De ő úgyis eljön."
    },
    {
      "id": 110504455655464963,
      "target": "Ballerina: Á, nem, hiszen azt mondtam, hogy várok."
    },
    {
      "id": 110504455655464962,
      "target": "Ballerina: Ahogy akarod. Egyébként én is."
    },
    {
      "id": 110504455655464960,
      "target": "Én. Semmire. Nem várok."
    },
    {
      "id": 110504455651270667,
      "target": "Ballerina: Te vársz. Tudni akarod, mi történt a tieiddel."
    },
    {
      "id": 110504455651270666,
      "target": "Ballerina: És te mit csinálsz? Itt ülsz bezárva a négy fal közé."
    },
    {
      "id": 110504455651270665,
      "target": "Ballerina: Aha."
    },
    {
      "id": 110504455651270663,
      "target": "Én. Semmire. Nem várok."
    },
    {
      "id": 110504455651270662,
      "target": "Ballerina: Most pont olyan vagy, mint ő."
    },
    {
      "id": 110504455651270661,
      "target": "Ballerina: Jobb lett volna válaszolnod. Van itt valaki, aki szívesen figyelmen kívül hagyja a kérdéseket."
    },
    {
      "id": 110504455651270660,
      "target": "Ballerina: Megdicséred a kérdésemet? Miért?"
    },
    {
      "id": 110504455651270659,
      "target": "Nem várok"
    },
    {
      "id": 110504455651270658,
      "target": "Jó kérdés"
    }
  ]
}
