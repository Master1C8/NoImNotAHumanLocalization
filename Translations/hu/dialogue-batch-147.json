  "entries": [
    {
      "id": 110504456574017540,
      "target": "Ballerina: Kis ajándék tőlem neked."
    },
    {
      "id": 110504456574017539,
      "target": "Ballerina: A ház alatt találod majd a macskát."
    },
    {
      "id": 110504456574017537,
      "target": "Ballerina: Gyere, cicám, majd elszórakoztatsz itt, ugye?"
    },
    {
      "id": 110504456574017536,
      "target": "Ballerina: Érezd magad otthon."
    },
    {
      "id": 110504456569823243,
      "target": "Menj már a faszba"
    },
    {
      "id": 110504456569823242,
      "target": "…Gyere be"
    },
    {
      "id": 110504456569823241,
      "target": "Ballerina: Gondold át még egyszer."
    },
    {
      "id": 110504456569823240,
      "target": "Ballerina: Látod a macskát?"
    },
    {
      "id": 110504456569823239,
      "target": "Ballerina: És ne kínozd a macskát."
    },
    {
      "id": 110504456569823238,
      "target": "Ballerina: Nem illik egy nőt kint hagyni fázni, fiatalember."
    },
    {
      "id": 110504456569823234,
      "target": "Ballerina: Kinyitod? Nem?"
    },
    {
      "id": 110504456569823233,
      "target": "Ballerina: Kiálltam minden próbádat?"
    },
    {
      "id": 110504456569823232,
      "target": "Ballerina: Ez sem elég?"
    },
    {
      "id": 110504456565628939,
      "target": "Ballerina: Két kezem van, két lábam, egy fejem."
    },
    {
      "id": 110504456565628936,
      "target": "Ballerina: Na, döntsd már el, mi legyen."
    },
    {
      "id": 110504456565628935,
      "target": "Ballerina: Balettos vagyok."
    },
    {
      "id": 110504456565628934,
      "target": "Ballerina: Talán táncolok is."
    },
    {
      "id": 110504456565628933,
      "target": "Ballerina: Táncoljak neked?"
    },
    {
      "id": 110504456565628932,
      "target": "Ballerina: És akkor mi van?"
    },
    {
      "id": 110504456565628931,
      "target": "Bizonyítsd be, hogy ember vagy"
    },
    {
      "id": 110504456565628930,
      "target": "Nem hiszem el, hogy ember vagy"
    },
    {
      "id": 110504456565628929,
      "target": "Ballerina: Furcsa mondat."
    },
    {
      "id": 110504456565628928,
      "target": "Ballerina: És most? Rá emlékeztettelek? Vagy mi?"
    },
    {
      "id": 110504456561434635,
      "target": "Ballerina: Hát… jó."
    },
    {
      "id": 110504456561434634,
      "target": "Bizonyítsd be, hogy ember vagy"
    },
    {
      "id": 110504456561434633,
      "target": "Nem hiszem el, hogy ember vagy"
    },
    {
      "id": 110504456561434632,
      "target": "Ballerina: Heh."
    }
  ]
}
