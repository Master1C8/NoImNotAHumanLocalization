  "entries": [
    {
      "id": 110504454405562378,
      "target": "Hogyan halt meg?"
    },
    {
      "id": 110504454405562377,
      "target": "Widow: Jó lenne egy kicsit pihenni…"
    },
    {
      "id": 110504454405562376,
      "target": "Widow: Mit tegyek?"
    },
    {
      "id": 110504454405562375,
      "target": "Widow: Nem tudlak…"
    },
    {
      "id": 110504454405562373,
      "target": "Widow: Eltemetni…"
    },
    {
      "id": 110504454405562372,
      "target": "Widow: Én még…"
    },
    {
      "id": 110504454405562371,
      "target": "Widow: Te senkit sem tudsz visszahozni nekem."
    },
    {
      "id": 110504454405562370,
      "target": "Widow: Vele akarok maradni egy kicsit."
    },
    {
      "id": 110504454405562369,
      "target": "Widow: Miért csinálod ezt?"
    },
    {
      "id": 110504454405562368,
      "target": "Widow: Persze, én meg most boldoguljak egyedül."
    },
    {
      "id": 110504454401368071,
      "target": "Widow: Aztán meghalt."
    },
    {
      "id": 110504454401368069,
      "target": "Widow: Azt mondta, minden rendben lesz."
    },
    {
      "id": 110504454401368068,
      "target": "Widow: Hiszen megígérted, hogy minden rendben lesz."
    },
    {
      "id": 110504454401368067,
      "target": "Widow: Miért haltál meg?"
    },
    {
      "id": 110504454401368065,
      "target": "Üljek itt veled?"
    },
    {
      "id": 110504454401368064,
      "target": "Most itt hagylak egy kicsit"
    },
    {
      "id": 110504454397173767,
      "target": "Widow: Szeretnék itt ülni."
    },
    {
      "id": 110504454397173766,
      "target": "Widow: Én itt…"
    },
    {
      "id": 110504454397173765,
      "target": "Widow: Nem vagyok éhes."
    },
    {
      "id": 110504454397173764,
      "target": "Üljek itt veled?"
    },
    {
      "id": 110504454397173763,
      "target": "Most itt hagylak egy kicsit"
    },
    {
      "id": 110504454397173762,
      "target": "Widow: Iszom, ha szükségem lesz rá."
    },
    {
      "id": 110504454397173761,
      "target": "Widow: Itt ülök a csap mellett."
    },
    {
      "id": 110504454397173760,
      "target": "Widow: Én itt…"
    },
    {
      "id": 110504454392979464,
      "target": "Hozzak neked enni?"
    },
    {
      "id": 110504454392979463,
      "target": "Hozzak neked vizet?"
    },
    {
      "id": 110504454392979462,
      "target": "Widow: Már semmi másra nincs szükségem."
    },
    {
      "id": 110504454392979461,
      "target": "Widow: Én csak…"
    },
    {
      "id": 110504454392979460,
      "target": "Widow: Hogy életben legyen."
    },
    {
      "id": 110504454392979457,
      "target": "Szükséged van valamire?"
    },
    {
      "id": 110504454392979456,
      "target": "Widow: Jó lenne egy kicsit pihenni…"
    }
  ]
}
