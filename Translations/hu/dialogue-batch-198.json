  "glossaryFingerprint": "8386700825df9e4bdf0b57482c1971b93cf495d18ce1232c2b5a3e281a186cea",
  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504456024563718,
      "target": "Elvezetlek az éjszakába, ahol a fenyő a csillagig ér."
    },
    {
      "id": 110504456024563717,
      "target": "Értem, hogy készen állsz."
    },
    {
      "id": 110504456024563716,
      "target": "Jó, hogy most már sem a beöltözött ember, sem más nem marad a sötétben. Csak az árnyék a téglámon."
    },
    {
      "id": 110504456024563715,
      "target": "Nem kell félned. Az időt én teremtettem. Itt nincs mitől félned."
    },
    {
      "id": 110504456024563714,
      "target": "Szomorú tájakra, amelyek mottója: a bőség látszatát keltő tükrök."
    },
    {
      "id": 110504456024563713,
      "target": "Oda kell menned."
    },
    {
      "id": 110504456024563712,
      "target": "Elfáradtál."
    },
    {
      "id": 110504456020369419,
      "target": "Nem, nem akarsz hozzájuk menni."
    },
    {
      "id": 110504456020369418,
      "target": "Azokhoz, akiknek a szeme nyomot vésett a szívbe?"
    },
    {
      "id": 110504456020369417,
      "target": "Hová akarsz menni?"
    },
    {
      "id": 110504456020369416,
      "target": "Egy ilyen apró birodalom oly sok álmot nyelt el."
    },
    {
      "id": 110504456020369415,
      "target": "Persze."
    },
    {
      "id": 110504456020369414,
      "target": "Félek továbbmenni"
    },
    {
      "id": 110504456020369413,
      "target": "Van még… merre továbbmenni innen?"
    },
    {
      "id": 110504456020369412,
      "target": "El nem ismert fiútestvér vagyok, kitaszított a nép családjában."
    },
    {
      "id": 110504456020369411,
      "target": "Bizonyos szempontból hasonlítunk egymásra."
    },
    {
      "id": 110504456020369410,
      "target": "Talán mindketten elfáradtunk, és lefeküdtünk aludni."
    },
    {
      "id": 110504456020369409,
      "target": "Mit jelent az, hogy „meghalni”?"
    },
    {
      "id": 110504456020369408,
      "target": "Meghaltam?"
    },
    {
      "id": 110504456016175115,
      "target": "Félek továbbmenni"
    },
    {
      "id": 110504456016175114,
      "target": "Van még… merre továbbmenni innen?"
    },
    {
      "id": 110504456016175113,
      "target": "„Félelmetes.”"
    },
    {
      "id": 110504456016175112,
      "target": "Csak megszokásból ismételgeted majd rituálisan:"
    },
    {
      "id": 110504456016175111,
      "target": "De boldog nem leszel."
    },
    {
      "id": 110504456016175110,
      "target": "Megtudod, amit tudni akartál."
    },
    {
      "id": 110504456016175109,
      "target": "Milyen jó, hogy minden szenvedés mögöttünk van."
    },
    {
      "id": 110504456016175108,
      "target": "Mostantól hosszú, boldog élet következik."
    },
    {
      "id": 110504456016175107,
      "target": "Meghaltam? Ez a vég?"
    },
    {
      "id": 110504456016175106,
      "target": "És most mi lesz?"
    },
    {
      "id": 110504456016175105,
      "target": "Most az út csúszós kis csomóvá húzódott, majd szétszakadt."
    },
    {
      "id": 110504456016175104,
      "target": "Már nincs semmi félelmetes."
    },
    {
      "id": 110504456011980810,
      "target": "Nincs okod félni."
    },
    {
      "id": 110504456011980809,
      "target": "Látom, hogy igent mondasz majd."
    }
  ]
}
