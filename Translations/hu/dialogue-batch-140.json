  "entries": [
    {
      "id": 110504456645320710,
      "target": "Miért kérted, hogy engedjem be azt, aki a macskát hozza?"
    },
    {
      "id": 110504456645320709,
      "target": "Honnan tudsz a macskáról?"
    },
    {
      "id": 110504456645320708,
      "target": "Prophet: Azzal, aki elhozta neked, te döntsd el, mit teszel."
    },
    {
      "id": 110504456645320707,
      "target": "Prophet: Kitűnő. Nálad van a macska."
    },
    {
      "id": 110504456645320706,
      "target": "Gasmask: És elmegyünk."
    },
    {
      "id": 110504456645320705,
      "target": "Gasmask: TEHÁT KÉT EMBERT VISZÜNK EL."
    },
    {
      "id": 110504456645320704,
      "target": "Gasmask: Maguk pedig itt maradnak meghalni."
    },
    {
      "id": 110504456641126412,
      "target": "Gasmask: Mindenkit elviszünk."
    },
    {
      "id": 110504456641126411,
      "target": "Gasmask: Betörjük az ajtót."
    },
    {
      "id": 110504456641126410,
      "target": "Gasmask: Mintha a falnak beszélnék. Ha most emberek nélkül távozunk, lövünk."
    },
    {
      "id": 110504456641126409,
      "target": "Gasmask: Nos, jó itt maradást."
    },
    {
      "id": 110504456641126407,
      "target": "Gasmask: Én is."
    },
    {
      "id": 110504456641126406,
      "target": "Nem adok oda több embert"
    },
    {
      "id": 110504456641126405,
      "target": "Remélem, többé nem találkozunk"
    },
    {
      "id": 110504456641126404,
      "target": "Gasmask: Magukon is átgázolunk."
    },
    {
      "id": 110504456641126403,
      "target": "Gasmask: Nem maga az első, aki ellenáll. Voltak már ilyenek."
    },
    {
      "id": 110504456641126402,
      "target": "Gasmask: Most vagy betörjük az ajtót, és mindenkit elviszünk ebből a rohadt odúból, vagy önként átad nekünk két embert."
    },
    {
      "id": 110504456641126401,
      "target": "Gasmask: Nem áll szándékomban vitatkozni magával."
    },
    {
      "id": 110504456641126400,
      "target": "Gasmask: Erre nincsenek szavaim."
    },
    {
      "id": 110504456636932106,
      "target": "Nem adok oda több embert"
    },
    {
      "id": 110504456636932105,
      "target": "Remélem, többé nem találkozunk"
    },
    {
      "id": 110504456636932104,
      "target": "Gasmask: Akkor vagy rájövünk, hogyan hassunk a Vendégekre, vagy magával többé nem találkozunk."
    },
    {
      "id": 110504456636932103,
      "target": "Gasmask: Így sem viszünk el mindenkit. Csak kettőre van szükségünk."
    },
    {
      "id": 110504456636932102,
      "target": "Gasmask: Még két embert."
    },
    {
      "id": 110504456636932101,
      "target": "Mire a faszra vagytok jók, ha úgysem sikerül semmi?"
    },
    {
      "id": 110504456636932100,
      "target": "És mi kell a megmeneküléshez?"
    },
    {
      "id": 110504456636932099,
      "target": "Gasmask: Ha most nem találunk hatékony kiutat, mások találják ki helyettünk."
    },
    {
      "id": 110504456636932098,
      "target": "Gasmask: Teljesíthetetlen célokat tűznek ki."
    },
    {
      "id": 110504456636932097,
      "target": "Gasmask: A hatóságok az egész várost fel akarják robbantani, mert ezt nem lehet kézben tartani."
    },
    {
      "id": 110504456636932096,
      "target": "Gasmask: Ez kurva nagy szar."
    },
    {
      "id": 110504456632737804,
      "target": "Mire a faszra vagytok jók, ha úgysem sikerül semmi?"
    },
    {
      "id": 110504456632737803,
      "target": "És mi kell a megmeneküléshez?"
    }
  ]
}
