    {
      "id": 110504457723256836,
      "target": "Szia (Hívás befejezése)"
    },
    {
      "id": 110504457723256835,
      "target": "Hogyan oldottad meg az étkezést?"
    },
    {
      "id": 110504457723256834,
      "target": "Hány jel kell ahhoz, hogy felismerjünk egy Vendéget?"
    },
    {
      "id": 110504457723256833,
      "target": "Te is beengedsz embereket magadhoz?"
    },
    {
      "id": 110504457723256832,
      "target": "Phone: Van kérdésed?"
    },
    {
      "id": 110504457719062539,
      "target": "Phone: …"
    },
    {
      "id": 110504457719062538,
      "target": "Phone: Ha nem, jobb, ha nem halogatod."
    },
    {
      "id": 110504457719062537,
      "target": "Phone: Na, beengedtél már magadhoz néhány vendéget?"
    },
    {
      "id": 110504457719062536,
      "target": "Phone: Szia, szomszéd. Örülök, hogy felhívtál."
    }
  ]
}
