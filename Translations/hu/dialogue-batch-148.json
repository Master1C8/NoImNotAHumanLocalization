  "entries": [
    {
      "id": 110504456561434630,
      "target": "Ballerina: Nem tudom. Mit számít?"
    },
    {
      "id": 110504456561434629,
      "target": "Emlékeztetsz valakire… egy emberre"
    },
    {
      "id": 110504456561434628,
      "target": "Valaki ideküldött?"
    },
    {
      "id": 110504456561434627,
      "target": "Ballerina: Nálad nincs meleg."
    },
    {
      "id": 110504456561434626,
      "target": "Ballerina: Megláttam a házadat, és idejöttem."
    },
    {
      "id": 110504456561434625,
      "target": "Ballerina: Látod a várost? Ott laktam."
    },
    {
      "id": 110504456561434624,
      "target": "Emlékeztetsz valakire… egy emberre"
    },
    {
      "id": 110504456557240330,
      "target": "Valaki ideküldött?"
    },
    {
      "id": 110504456557240329,
      "target": "Ballerina: Balettoztam. Látszik?"
    },
    {
      "id": 110504456557240328,
      "target": "Ballerina: Táncolok."
    },
    {
      "id": 110504456557240327,
      "target": "Hogy találtad meg a házamat?"
    },
    {
      "id": 110504456557240325,
      "target": "Ballerina: Azt mondták, ide jöjjek, hát jöttem."
    },
    {
      "id": 110504456557240324,
      "target": "Ballerina: Kinyitod az ajtót, vagy nem?"
    },
    {
      "id": 110504456557240322,
      "target": "Ballerina: Egy láda sör. Egy éjjeliszekrény. Egy sonka. Nem tudom. Adj, amit akarsz."
    },
    {
      "id": 110504456557240321,
      "target": "Hogy találtad meg a házamat?"
    },
    {
      "id": 110504456553046028,
      "target": "Ballerina: De ez miben segít neked?"
    },
    {
      "id": 110504456553046027,
      "target": "Ballerina: Sok a kérdés. Igen, tudom."
    },
    {
      "id": 110504456553046025,
      "target": "Mit akarsz?"
    },
    {
      "id": 110504456553046024,
      "target": "Ismersz… egy kopasz férfit?"
    },
    {
      "id": 110504456553046023,
      "target": "Ballerina: Kinyitod az ajtót?"
    },
    {
      "id": 110504456553046021,
      "target": "Ballerina: Szia."
    }
  ]
}
