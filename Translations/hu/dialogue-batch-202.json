  "entries": [
    {
      "id": 110504455957454853,
      "target": "FortuneTeller: Attól tartok, ez reménytelen ügy. Sajnálom. Még az affirmációk sem segítettek…"
    },
    {
      "id": 110504455957454851,
      "target": "FortuneTeller: Törekvés nélkül eredmény sem lesz: az univerzum egyszerűen nem hallja meg, és nem valósítja meg."
    },
    {
      "id": 110504455957454850,
      "target": "FortuneTeller: Az aurádban… Nem akarsz boldog lenni. Csak üresség van benned."
    },
    {
      "id": 110504455957454849,
      "target": "FortuneTeller: Várj… Hogyhogy ezt eddig nem láttam…"
    },
    {
      "id": 110504455957454848,
      "target": "FortuneTeller: Te egyáltalán nem is próbálkozol!"
    },
    {
      "id": 110504455953260555,
      "target": "Ez valami baromság"
    },
    {
      "id": 110504455953260553,
      "target": "Boldog ember vagyok!"
    },
    {
      "id": 110504455953260552,
      "target": "FortuneTeller: Folytasd."
    },
    {
      "id": 110504455953260551,
      "target": "Ez valami baromság"
    },
    {
      "id": 110504455953260549,
      "target": "Boldog ember vagyok!"
    },
    {
      "id": 110504455953260548,
      "target": "FortuneTeller: Ismételd utánam: boldog ember vagyok!"
    },
    {
      "id": 110504455953260547,
      "target": "FortuneTeller: De elég a beszédből, térjünk át a gyakorlatra."
    },
    {
      "id": 110504455953260546,
      "target": "FortuneTeller: Jó, ne csüggedj. A rendszeres boldogságaffirmációk segítenek majd."
    },
    {
      "id": 110504455953260545,
      "target": "FortuneTeller: Furcsa, működnie kellett volna."
    },
    {
      "id": 110504455949066252,
      "target": "FortuneTeller: Mi az, nem segített?"
    },
    {
      "id": 110504455949066251,
      "target": "Mi a fasz?"
    },
    {
      "id": 110504455949066250,
      "target": "Kellett volna?"
    },
    {
      "id": 110504455949066249,
      "target": "FortuneTeller: Na, segített? Már érzed, ahogy elönt a boldogság?"
    },
    {
      "id": 110504455949066247,
      "target": "FortuneTeller: JÁRD EL A BAK TÁNCÁT!"
    },
    {
      "id": 110504455949066246,
      "target": "FortuneTeller: Csak annyit kell…"
    },
    {
      "id": 110504455949066245,
      "target": "FortuneTeller: Tudod, azt hiszem, tudom, mi lendítheti mozgásba az energiádat."
    },
    {
      "id": 110504455949066243,
      "target": "Esenin: Rendben, ahogy akarod."
    },
    {
      "id": 110504455949066241,
      "target": "Esenin: Köszönöm, hogy meghallgattál, háztulajdonos."
    },
    {
      "id": 110504455949066240,
      "target": "Esenin: Tudod, ettől még egy kicsit jobban is érzem magam."
    },
    {
      "id": 110504455944871944,
      "target": "Vers, mint a többi"
    },
    {
      "id": 110504455944871943,
      "target": "Szép"
    },
    {
      "id": 110504455944871942,
      "target": "Esenin: Hát ilyen vers ez. Hogy tetszik?"
    },
    {
      "id": 110504455944871941,
      "target": "Nem, köszönöm"
    },
    {
      "id": 110504455944871940,
      "target": "Persze"
    },
    {
      "id": 110504455944871939,
      "target": "Esenin: Háztulajdonos, nem bánod, ha felolvasok egy verset?"
    },
    {
      "id": 110504455944871938,
      "target": "Esenin: Találtam nálad egy verseskötetet."
    }
  ]
}
