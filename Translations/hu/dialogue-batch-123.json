  "entries": [
    {
      "id": 110504456829870081,
      "target": "TaxiDriver: A kibaszott KCsSz-esek lenyúlták a kocsimat."
    },
    {
      "id": 110504456829870080,
      "target": "Mi lett az utasoddal?"
    },
    {
      "id": 110504456825675787,
      "target": "Mi történt a kocsiddal?"
    },
    {
      "id": 110504456825675786,
      "target": "TaxiDriver: Nem vagyok azért teljesen hülye, csak rossz emberben bíztam meg."
    },
    {
      "id": 110504456825675785,
      "target": "TaxiDriver: A saját hülyeségem miatt vették el a kocsimat."
    },
    {
      "id": 110504456825675784,
      "target": "TaxiDriver: Volt egy kocsim, tudod, de már nincs."
    },
    {
      "id": 110504456825675783,
      "target": "Mi lett az utasoddal?"
    },
    {
      "id": 110504456825675782,
      "target": "Mi történt a kocsiddal?"
    },
    {
      "id": 110504456825675781,
      "target": "TaxiDriver: Most már se ő, se a kocsi nincs meg, tudod."
    },
    {
      "id": 110504456825675780,
      "target": "TaxiDriver: Az ügyfél nem az volt, akinek kiadta magát."
    },
    {
      "id": 110504456825675779,
      "target": "TaxiDriver: Vittem egy utast, de aztán…"
    },
    {
      "id": 110504456825675778,
      "target": "TaxiDriver: Hogy is kezdjem? Taxis vagyok, tudod."
    },
    {
      "id": 110504456825675777,
      "target": "Miben segíthetek?"
    },
    {
      "id": 110504456825675776,
      "target": "Mi történt?"
    },
    {
      "id": 110504456821481483,
      "target": "TaxiDriver: Figyelj, nyakig vagyok a szarban, elbújhatok nálad?"
    },
    {
      "id": 110504456821481482,
      "target": "TaxiDriver: Szia, haver."
    }
  ]
}
