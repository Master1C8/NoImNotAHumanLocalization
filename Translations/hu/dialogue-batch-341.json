  "entries": [
    {
      "id": 110504454200041474,
      "target": "A fejedben lévő hangokról beszélek"
    },
    {
      "id": 110504454200041473,
      "target": "WheelChair: Szóval maradok itt nálad egy kicsit."
    },
    {
      "id": 110504454200041472,
      "target": "WheelChair: A jobb lábam már lassan vissza is kezd nőni."
    },
    {
      "id": 110504454195847179,
      "target": "WheelChair: Igen. Csak várom, hogy visszanőjenek a lábaim."
    },
    {
      "id": 110504454195847177,
      "target": "Te… jól vagy?"
    },
    {
      "id": 110504454195847176,
      "target": "WheelChair: Ej, bádogdoboz az életem…"
    },
    {
      "id": 110504454195847175,
      "target": "WheelChair: Nagyon vicces anekdotát meséltek."
    },
    {
      "id": 110504454195847174,
      "target": "WheelChair: Bocs, csak a fejemben lévő hangok azok."
    },
    {
      "id": 110504454195847172,
      "target": "WheelChair: AHAHAHAHAHAHAHA."
    },
    {
      "id": 110504454195847170,
      "target": "WheelChair: A seggét, na. A sirályok a seggét nézték fészeknek."
    },
    {
      "id": 110504454195847169,
      "target": "WheelChair: Hogy a sirályok az ő… há… hát…"
    },
    {
      "id": 110504454195847168,
      "target": "WheelChair: Olyan keményen dolgozott fenn a hegyen…"
    },
    {
      "id": 110504454191652874,
      "target": "WheelChair: DE AKKOR MEGHÚZTA A HÁTÁT."
    },
    {
      "id": 110504454191652873,
      "target": "WheelChair: Én nem értek hozzá. És leszarom."
    },
    {
      "id": 110504454191652872,
      "target": "WheelChair: Felbérelték, hogy bányásszon valamit a hegyekben."
    },
    {
      "id": 110504454191652871,
      "target": "WheelChair: Megsérült."
    },
    {
      "id": 110504454191652870,
      "target": "WheelChair: Hát a barátomat. Gyerekkorunk óta ismerjük egymást."
    },
    {
      "id": 110504454191652868,
      "target": "Kit kerestél?"
    },
    {
      "id": 110504454191652867,
      "target": "WheelChair: Ej, bádogdoboz az életem…"
    }
  ]
}
