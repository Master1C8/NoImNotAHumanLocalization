  "entries": [
    {
      "id": 110504457945554944,
      "target": "TV: Mostantól a For Rest ételkiszállításának kínálatában is. Hívják a {0} számot."
    },
    {
      "id": 110504457941360652,
      "target": "1 kombucsát kérek"
    },
    {
      "id": 110504457941360651,
      "target": "1 csomag cigarettát kérek"
    },
    {
      "id": 110504457941360650,
      "target": "2 doboz macskaeledelt kérek"
    },
    {
      "id": 110504457941360649,
      "target": "TV: Most következik tudósítás a holttestek ártalmatlanításának ideiglenes felfüggesztéséről."
    },
    {
      "id": 110504457941360648,
      "target": "TV: …"
    },
    {
      "id": 110504457941360647,
      "target": "TV: …"
    },
    {
      "id": 110504457941360646,
      "target": "TV: …"
    },
    {
      "id": 110504457941360645,
      "target": "Phone: …"
    },
    {
      "id": 110504457941360644,
      "target": "Phone: De még mindig hiányzik nekem..."
    },
    {
      "id": 110504457941360643,
      "target": "Phone: ..."
    },
    {
      "id": 110504457941360642,
      "target": "Phone: Menjen a fenébe!"
    },
    {
      "id": 110504457941360641,
      "target": "Phone: Jaj, miért is mentegetőzöm önnek egyáltalán?"
    },
    {
      "id": 110504457941360640,
      "target": "Phone: Kérem..."
    },
    {
      "id": 110504457937166346,
      "target": "Phone: Ne hívjon ide többet..."
    },
    {
      "id": 110504457937166345,
      "target": "Phone: Bocsásson meg."
    },
    {
      "id": 110504457937166344,
      "target": "Phone: ..."
    },
    {
      "id": 110504457937166343,
      "target": "Phone: Most már csak azt sajnálom, hogy nem kérdeztük meg a lányunk helyébe lépett lánytól, mit tett a kicsinkkel..."
    },
    {
      "id": 110504457937166342,
      "target": "Phone: A férjem segített megérteni ezt."
    },
    {
      "id": 110504457937166341,
      "target": "Phone: De aztán rájöttem, hogy nem is a mi lányunk volt."
    },
    {
      "id": 110504457937166340,
      "target": "Phone: Eleinte magát a férjemet akartam megölni."
    },
    {
      "id": 110504457937166339,
      "target": "Phone: ..."
    },
    {
      "id": 110504457937166338,
      "target": "Phone: Azonnal elintézte azt a Vendéget."
    },
    {
      "id": 110504457937166337,
      "target": "Phone: Amint elmondtam a férjemnek, ő..."
    },
    {
      "id": 110504457937166336,
      "target": "Phone: ..."
    },
    {
      "id": 110504457932972044,
      "target": "Phone: Minden egyezett."
    },
    {
      "id": 110504457932972043,
      "target": "Phone: Ezért azonnal észrevettem, amikor megjelentek ezek a jelek."
    },
    {
      "id": 110504457932972042,
      "target": "Phone: Hiszen úgy ismertem őt, mint a tenyeremet."
    },
    {
      "id": 110504457932972041,
      "target": "Phone: Minden jel szerint."
    },
    {
      "id": 110504457932972040,
      "target": "Phone: Vendég volt."
    },
    {
      "id": 110504457932972039,
      "target": "Értem"
    },
    {
      "id": 110504457932972038,
      "target": "A kurva életbe..."
    },
    {
      "id": 110504457932972037,
      "target": "Phone: Biztosan Vendég volt! A jelek száz százalékig egyeztek!"
    },
    {
      "id": 110504457932972036,
      "target": "Phone: Nem magának kell ítélkeznie felettem!"
    },
    {
      "id": 110504457932972035,
      "target": "..."
    },
    {
      "id": 110504457932972034,
      "target": "És úgy döntött, megöli a saját gyerekét?"
    },
    {
      "id": 110504457932972033,
      "target": "Phone: Minden jel egyezett, és a férjem ragaszkodott hozzá."
    },
    {
      "id": 110504457932972032,
      "target": "Phone: Megöltük. Értse meg, muszáj volt."
    },
    {
      "id": 110504457928777740,
      "target": "(Letenni a kagylót)"
    },
    {
      "id": 110504457928777739,
      "target": "Mi?"
    },
    {
      "id": 110504457928777738,
      "target": "Phone: Meg kellett ölnünk."
    },
    {
      "id": 110504457928777737,
      "target": "Phone: Kénytelenek voltunk..."
    },
    {
      "id": 110504457928777736,
      "target": "Phone: ..."
    },
    {
      "id": 110504457928777735,
      "target": "Phone: Meghalt..."
    },
    {
      "id": 110504457928777734,
      "target": "Phone: A kislányunk... ő..."
    },
    {
      "id": 110504457928777733,
      "target": "Phone: És viszontlátásra."
    },
    {
      "id": 110504457928777732,
      "target": "Phone: Kérem, mondja el ezt a kislánynak."
    },
    {
      "id": 110504457928777731,
      "target": "Phone: A sírás pedig végképp nem segít."
    },
    {
      "id": 110504457928777730,
      "target": "Phone: Ha elégették az apját, annak így kellett lennie."
    },
    {
      "id": 110504457928777729,
      "target": "Phone: Semmi sem történik ok nélkül."
    },
    {
      "id": 110504457928777728,
      "target": "Phone: Érti..."
    },
    {
      "id": 110504457924583435,
      "target": "Phone: Ön is túl lesz rajta. És az a kislány is."
    },
    {
      "id": 110504457924583434,
      "target": "Phone: De a férjem segített ezt feldolgozni."
    },
    {
      "id": 110504457924583433,
      "target": "Phone: Eleinte zokogtam. Meg akartam ölni magam. Nem tudtam nélküle élni."
    },
    {
      "id": 110504457924583432,
      "target": "Phone: ..."
    },
    {
      "id": 110504457924583431,
      "target": "Phone: Egyenesen az óvodájában."
    },
    {
      "id": 110504457924583430,
      "target": "Phone: Őt is elégették."
    },
    {
      "id": 110504457924583429,
      "target": "Phone: Akkor ezek szerint Vendég volt. Akárcsak a kislányunk."
    },
    {
      "id": 110504457924583428,
      "target": "Phone: Senkit sem égetnének el csak úgy."
    },
    {
      "id": 110504457924583427,
      "target": "Nem, valami kibaszott őrültek ok nélkül elégették"
    },
    {
      "id": 110504457924583426,
      "target": "Hogyhogy őt is?"
    },
    {
      "id": 110504457924583425,
      "target": "Phone: Ő... ő is Vendég volt?"
    },
    {
      "id": 110504457924583424,
      "target": "Itt van nálam egy kislány, akinek meghalt az apja"
    },
    {
      "id": 110504457920389132,
      "target": "Szeretném meghívni a lányát hozzánk vendégségbe. A barátnője kéri"
    },
    {
      "id": 110504457920389131,
      "target": "Phone: Mi? Miért akar vele beszélni?"
    },
    {
      "id": 110504457920389130,
      "target": "Jó napot, átengedné a lányát hozzánk játszani a barátnőjével?"
    },
    {
      "id": 110504457920389129,
      "target": "Jó napot, beszélhetnék a lányával?"
    },
    {
      "id": 110504457920389128,
      "target": "Phone: Halló?"
    }
  ]
}
