  "entries": [
    {
      "id": 110504457509347338,
      "target": "Tourist: Nos hát… Nagyon sajnálom."
    },
    {
      "id": 110504457509347337,
      "target": "Tourist: Hálásan köszönöm önnek."
    },
    {
      "id": 110504457509347334,
      "target": "Tourist: {0} itt van. Nem vagyok biztos benne, hogy kijönnénk egymással."
    },
    {
      "id": 110504457509347333,
      "target": "Tourist: Bocsásson meg, tisztelt uram, de attól tartok, egyelőre nem mehetek be."
    },
    {
      "id": 110504457509347330,
      "target": "Alt: Akkor megegyeztünk?"
    },
    {
      "id": 110504457509347329,
      "target": "Alt: Rendben. {0} megfelel?"
    },
    {
      "id": 110504457509347328,
      "target": "Alt: Hozzászoktam az ilyen megoldásokhoz. És értem, mire célzol."
    },
    {
      "id": 110504457505153033,
      "target": "Alt: Kár, hogy a seggfejeknek van szerencséjük."
    },
    {
      "id": 110504457505153032,
      "target": "Alt: Van még időm, majd találok más megoldást."
    },
    {
      "id": 110504457505153031,
      "target": "Alt: Hát jó."
    },
    {
      "id": 110504457505153030,
      "target": "Alt: Köszönöm. Nem számítottam rá, de nagyon reméltem."
    },
    {
      "id": 110504457505153027,
      "target": "Alt: De együtt nem fogsz minket látni."
    },
    {
      "id": 110504457505153026,
      "target": "Alt: Hosszú történet, és biztosan nem állok készen rá, hogy itt mindent kitálaljak."
    },
    {
      "id": 110504457505153025,
      "target": "Alt: Hoppá, {0} itt van."
    }
  ]
}
