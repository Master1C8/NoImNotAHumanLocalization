  "entries": [
    {
      "id": 110504453369569282,
      "target": "Cultist2: Milyen… érdekes."
    },
    {
      "id": 110504453369569280,
      "target": "Cultist2: Kicsit ideges vagyok."
    },
    {
      "id": 110504453365374983,
      "target": "Cultist2: Még sosem fényképeztek le."
    },
    {
      "id": 110504453361180680,
      "target": "Cultist2: Azt mondják, ez is közelebb hozza az Ő eljövetelét."
    },
    {
      "id": 110504453361180678,
      "target": "Cultist2: Keveset alszunk."
    },
    {
      "id": 110504453361180675,
      "target": "Cultist2: Igen, nem könnyű az életünk."
    },
    {
      "id": 110504453356986372,
      "target": "Cultist2: Kissé görbék, és valamivel nagyobbak másokénál."
    },
    {
      "id": 110504453356986371,
      "target": "Cultist2: Igen, persze."
    },
    {
      "id": 110504453352792069,
      "target": "Cultist2: Nem kell félni, mindannyian jobb életbe távozunk. Megmentenek minket."
    }
  ]
}
