  "sourceInventorySha256": "ecd96645c2ca6f23f8bf3ab2fcf65709e961478ae15a38e83d94cc335a408bf0",
  "glossaryFingerprint": "8386700825df9e4bdf0b57482c1971b93cf495d18ce1232c2b5a3e281a186cea",
  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504454426533888,
      "target": "Widow: Most már nem játszol nekem többé. Elénekelted nekem az utolsó dalodat."
    },
    {
      "id": 110504454422339595,
      "target": "Widow: Egy kicsit elszakadt…"
    },
    {
      "id": 110504454422339594,
      "target": "Widow: Még egy fényképem is van arról az estéről."
    },
    {
      "id": 110504454422339592,
      "target": "Widow: Később megtudtam, hogy direkt megtanult egy dalt, hogy lenyűgözzön."
    },
    {
      "id": 110504454422339591,
      "target": "Widow: Aztán feláll, azt mondja, indulnunk kell, meglök egy poharat, megpróbálja elkapni, és elejti a gitárt…"
    },
    {
      "id": 110504454422339590,
      "target": "Widow: A barátaink mindenféle dalokat kértek tőle. Csak üldögélt, aztán egyszer…"
    },
    {
      "id": 110504454422339589,
      "target": "Widow: És olyan szépen játszott, nagyon tetszett."
    },
    {
      "id": 110504454422339588,
      "target": "Widow: „Adjátok ide a gitárt, mindjárt énekelünk.”"
    },
    {
      "id": 110504454422339587,
      "target": "Widow: Csak hallgatott és hallgatott, aztán egyszer csak megszólalt:"
    },
    {
      "id": 110504454422339586,
      "target": "Widow: Addigra már jócskán ittunk."
    },
    {
      "id": 110504454422339585,
      "target": "Widow: Ültünk és iszogattunk. Általában elég mogorva volt, és az ilyen összejöveteleken ritkán szólalt meg."
    },
    {
      "id": 110504454422339584,
      "target": "Widow: Akkor még jóval fiatalabbak voltunk."
    },
    {
      "id": 110504454418145291,
      "target": "Widow: Egyszer elmentünk a barátainkhoz."
    },
    {
      "id": 110504454418145288,
      "target": "Mesélj, mire emlékszel róla?"
    },
    {
      "id": 110504454418145287,
      "target": "Widow: Jó lenne egy kicsit pihenni…"
    },
    {
      "id": 110504454418145286,
      "target": "Widow: Annyira szeretném elhinni."
    },
    {
      "id": 110504454418145285,
      "target": "Widow: Annyira szeretném…"
    },
    {
      "id": 110504454418145284,
      "target": "Widow: Még mindig hall engem."
    },
    {
      "id": 110504454418145283,
      "target": "Widow: Nem, ez nincs így."
    },
    {
      "id": 110504454418145282,
      "target": "Widow: Nem."
    },
    {
      "id": 110504454418145280,
      "target": "Widow: Nem adom őt a lelketlen földnek."
    },
    {
      "id": 110504454413950982,
      "target": "Widow: Ezt nem bírom."
    },
    {
      "id": 110504454413950981,
      "target": "Widow: És megint el kell válnom tőle."
    },
    {
      "id": 110504454413950980,
      "target": "Widow: Pedig csak nemrég kaptam vissza."
    },
    {
      "id": 110504454413950979,
      "target": "Widow: Nem állok készen."
    },
    {
      "id": 110504454413950978,
      "target": "Widow: Nem-nem-nem-nem."
    },
    {
      "id": 110504454413950977,
      "target": "Widow: Ne-e-e-em."
    },
    {
      "id": 110504454413950976,
      "target": "Csak a teste maradt meg. Ezt el kell fogadni"
    },
    {
      "id": 110504454409756678,
      "target": "El kell temetni"
    },
    {
      "id": 110504454409756677,
      "target": "Widow: Csak abbahagyni a sírást."
    },
    {
      "id": 110504454409756676,
      "target": "Widow: De vajon helyes lenne?"
    },
    {
      "id": 110504454409756675,
      "target": "Widow: Mintha már nem is lenne mivel sírnom."
    },
    {
      "id": 110504454409756674,
      "target": "Widow: Csak nemrég fogytak el a könnyeim."
    },
    {
      "id": 110504454409756673,
      "target": "Widow: Ez túl sok."
    },
    {
      "id": 110504454409756672,
      "target": "Widow: Még nem tudom megtenni."
    }
  ]
}
