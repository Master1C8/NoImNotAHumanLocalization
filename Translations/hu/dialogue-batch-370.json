  "entries": [
    {
      "id": 110504453751250949,
      "target": "Sirin: Készen állok..."
    },
    {
      "id": 110504453751250948,
      "target": "Sirin: Hogy fogok én... nélküle..."
    },
    {
      "id": 110504453751250947,
      "target": "Sirin: A halál elvette a lánytestvéremet..."
    },
    {
      "id": 110504453751250946,
      "target": "Alkonost: Csak lőj."
    },
    {
      "id": 110504453751250945,
      "target": "Alkonost: Mi értelme most bármit is tenni... vagy igyekezni..."
    },
    {
      "id": 110504453747056650,
      "target": "Alkonost: A lánytestvérem... Miért?"
    },
    {
      "id": 110504453747056649,
      "target": "Anger: Ez rohadtul nyomaszt. De mindig túl későn veszem észre, hogy megint csinálom."
    },
    {
      "id": 110504453747056648,
      "target": "Anger: Néha annyira összeszorítom az állkapcsom, hogy hallom, ahogy roppan."
    },
    {
      "id": 110504453747056646,
      "target": "Egyáltalán miféle tudósítás volt ez?"
    },
    {
      "id": 110504453747056644,
      "target": "A fülemmel minden rendben."
    },
    {
      "id": 110504453747056641,
      "target": "Meg kell mosakodnom. Remélem, segít."
    },
    {
      "id": 110504453742862345,
      "target": "Bőrirritációnak tűnik, vagy ami még rosszabb: gombásodásnak."
    },
    {
      "id": 110504453742862344,
      "target": "Mi a fasz ez a szarság!?"
    },
    {
      "id": 110504453742862343,
      "target": "Ahogy lennie kell."
    },
    {
      "id": 110504453742862342,
      "target": "Szőrös hónalj."
    },
    {
      "id": 110504453742862339,
      "target": "Nem vörösek, úgyhogy nincs mibe belekötni."
    },
    {
      "id": 110504453742862338,
      "target": "A szemem olyan, mint bárki másé."
    },
    {
      "id": 110504453742862337,
      "target": "Nem kellett volna meginnom azt a koffeines szart."
    },
    {
      "id": 110504453742862336,
      "target": "A kurva életbe. Vörösek…"
    },
    {
      "id": 110504453591867396,
      "target": "Lőpornyomok vannak az ujjlenyomataimon. De ez apróság."
    },
    {
      "id": 110504453591867395,
      "target": "Tiszta kezek…"
    },
    {
      "id": 110504453591867394,
      "target": "Minden amiatt a barlang miatt van, amit ások."
    },
    {
      "id": 110504453591867393,
      "target": "Piszkos körmök…"
    },
    {
      "id": 110504453587673094,
      "target": "Ez még jobb is így. Nem néznek majd Vendégnek."
    },
    {
      "id": 110504453587673093,
      "target": "Sárga fogak…"
    },
    {
      "id": 110504453587673092,
      "target": "A dohányosok a veséjüket odaadnák ilyenekért."
    },
    {
      "id": 110504453587673091,
      "target": "A fenébe, fehérek…"
    },
    {
      "id": 110504453587673088,
      "target": "Megmosakodni"
    },
    {
      "id": 110504453583478786,
      "target": "Meg kell vizsgálnom magam."
    }
  ]
}
