  "entries": [
    {
      "id": 110504456037146633,
      "target": "Alszom egy kicsit."
    },
    {
      "id": 110504456037146632,
      "target": "Valahogy elfáradtam."
    },
    {
      "id": 110504456037146630,
      "target": "Bárcsak újra találkozhatnék velük, az egész családdal."
    },
    {
      "id": 110504456037146629,
      "target": "Vajon eljön hozzám valaki?"
    },
    {
      "id": 110504456037146628,
      "target": "Miért engedtek be ide?"
    },
    {
      "id": 110504456037146627,
      "target": "Vajon mi volt ez az egész?"
    },
    {
      "id": 110504456037146626,
      "target": "Bárcsak még sokáig így maradna…"
    },
    {
      "id": 110504456037146625,
      "target": "De nem is akarok."
    },
    {
      "id": 110504456037146624,
      "target": "Nem tudom, hogyan juthatnék ki."
    },
    {
      "id": 110504456032952331,
      "target": "Nem emlékszem, hogyan kerültem ide."
    },
    {
      "id": 110504456032952330,
      "target": "Senki sem zaklat. Senki sem ér hozzám."
    },
    {
      "id": 110504456032952329,
      "target": "De… most nyugodt vagyok."
    },
    {
      "id": 110504456032952328,
      "target": "Nem tudom, mióta ülök itt."
    },
    {
      "id": 110504456032952327,
      "target": "Itt nem váltja egymást a nappal és az éjszaka."
    },
    {
      "id": 110504456032952324,
      "target": "Félek"
    },
    {
      "id": 110504456032952323,
      "target": "Van itt valaki?"
    },
    {
      "id": 110504456032952321,
      "target": "Félek"
    },
    {
      "id": 110504456032952320,
      "target": "Van itt valaki?"
    },
    {
      "id": 110504456028758025,
      "target": "Nézhetek egy filmet?"
    },
    {
      "id": 110504456028758024,
      "target": "Lesz még itt valaki?"
    },
    {
      "id": 110504456028758022,
      "target": "Nézhetek egy filmet?"
    },
    {
      "id": 110504456028758021,
      "target": "Lesz még itt valaki?"
    },
    {
      "id": 110504456028758019,
      "target": "Örökre itt maradok?"
    },
    {
      "id": 110504456028758018,
      "target": "Meghaltam?"
    },
    {
      "id": 110504456028758016,
      "target": "Élvezd."
    },
    {
      "id": 110504456024563722,
      "target": "Nagynak, porosnak, kompromisszumokkal telinek tűnnek majd."
    },
    {
      "id": 110504456024563721,
      "target": "Rövid útjaival, amelyek később furcsa módon szélesnek tűnnek majd neked."
    },
    {
      "id": 110504456024563720,
      "target": "Ez a te helyed."
    },
    {
      "id": 110504456024563719,
      "target": "Erre vágytál, nem?"
    }
  ]
}
