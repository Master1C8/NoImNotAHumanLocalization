  "entries": [
    {
      "id": 110504456615960579,
      "target": "Gasmask: Meg kell tennünk, amit kell. Így hamarabb elmegyünk, és vége lesz az egésznek."
    },
    {
      "id": 110504456615960578,
      "target": "Gasmask: Nem adunk választási lehetőséget."
    },
    {
      "id": 110504456615960577,
      "target": "Gasmask: Nem értette meg."
    },
    {
      "id": 110504456615960576,
      "target": "Gasmask: Amint véget érnek a vizsgálatok, elmondjuk, mi a további teendő, és segítünk."
    },
    {
      "id": 110504456611766283,
      "target": "Gasmask: Ne aggódjon. A vizsgálatok persze kimerítőek, de adunk időt a pihenésre."
    },
    {
      "id": 110504456611766282,
      "target": "Nem érdekelnek ezek a vizsgálatok."
    },
    {
      "id": 110504456611766281,
      "target": "Rendben. Ha nincs más lehetőség."
    },
    {
      "id": 110504456611766280,
      "target": "Gasmask: A nap hatásának alaposabb vizsgálatához még valakit el kell vinnünk a házából."
    },
    {
      "id": 110504456611766279,
      "target": "Gasmask: Az eredmények túlságosan ellentmondásosak."
    },
    {
      "id": 110504456611766278,
      "target": "Nem érdekelnek ezek a vizsgálatok."
    },
    {
      "id": 110504456611766277,
      "target": "Rendben. Ha nincs más lehetőség."
    },
    {
      "id": 110504456611766276,
      "target": "Gasmask: Ezután visszaküldik őt a karanténzónából."
    },
    {
      "id": 110504456611766275,
      "target": "Gasmask: A vizsgálatok után karanténra van szükség. Az ön embere egy ideig nálunk marad."
    },
    {
      "id": 110504456611766274,
      "target": "Gasmask: Á, úgy látszik, a képviselőink már jártak önnél."
    },
    {
      "id": 110504456611766273,
      "target": "Gasmask: Visszahozzák?"
    },
    {
      "id": 110504456611766272,
      "target": "És az előző vizsgálat?"
    },
    {
      "id": 110504456607571979,
      "target": "Mikor hozzák vissza az emberünket?"
    },
    {
      "id": 110504456607571978,
      "target": "Gasmask: Ne aggódjon, nem tart sokáig."
    },
    {
      "id": 110504456607571977,
      "target": "Gasmask: A KCsSz egyik egységétől jöttünk. Megvizsgáljuk a környékét."
    },
    {
      "id": 110504456607571976,
      "target": "Gasmask: Jó éjszakát."
    }
  ]
}
