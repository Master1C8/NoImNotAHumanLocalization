  "entries": [
    {
      "id": 110504452144832513,
      "target": "Sirin: Hát itt a vég."
    },
    {
      "id": 110504452140638209,
      "target": "Alkonost: Hát itt a vég."
    },
    {
      "id": 110504452123860996,
      "target": "Sirin: Milyen gyönyörű!"
    },
    {
      "id": 110504452123860995,
      "target": "Sirin: Pedig neked volt szánva!"
    },
    {
      "id": 110504452123860994,
      "target": "Sirin: Az én dalom."
    },
    {
      "id": 110504452123860993,
      "target": "Sirin: Akkor kivárom az én időmet."
    },
    {
      "id": 110504452123860992,
      "target": "Sirin: Mindegy."
    },
    {
      "id": 110504452119666698,
      "target": "Sirin: Örök agónia és a halál várása."
    },
    {
      "id": 110504452119666697,
      "target": "Sirin: És soha nem látjuk eljönni a végünket."
    },
    {
      "id": 110504452119666696,
      "target": "Sirin: Nagyon sokáig fog beszippantani minket az eseményhorizont."
    },
    {
      "id": 110504452119666695,
      "target": "Sirin: Mi van, ha csak arra készülünk, hogy elnyeljen minket egy fekete lyuk?"
    },
    {
      "id": 110504452119666694,
      "target": "Sirin: Talán legközelebb."
    },
    {
      "id": 110504452119666693,
      "target": "Sirin: Nem feleltem meg a jeleknek."
    },
    {
      "id": 110504452119666692,
      "target": "Sirin: Kár."
    },
    {
      "id": 110504452119666691,
      "target": "Sirin: Talán legközelebb."
    },
    {
      "id": 110504452119666690,
      "target": "Sirin: Kár."
    },
    {
      "id": 110504452119666689,
      "target": "Sirin: Úgyis meghalsz."
    },
    {
      "id": 110504452115472395,
      "target": "Sirin: Nem volt hozzá bátorságod?"
    },
    {
      "id": 110504452115472392,
      "target": "Sirin: Megnyomod azt a bizonyos gombot?"
    },
    {
      "id": 110504452115472391,
      "target": "Sirin: Na?"
    },
    {
      "id": 110504452115472388,
      "target": "Sirin: Tetszik?"
    },
    {
      "id": 110504452115472387,
      "target": "Sirin: Az üresség egyszerűen átszáll rád."
    },
    {
      "id": 110504452115472386,
      "target": "Sirin: Ha lehunyom a szemem, az üresség nem tűnik el."
    },
    {
      "id": 110504452111278091,
      "target": "Sirin: Én magam megteszem."
    },
    {
      "id": 110504452111278090,
      "target": "Sirin: Add ide a puskát."
    },
    {
      "id": 110504452111278089,
      "target": "Sirin: Ezt egyszerűen rám bízhatod."
    },
    {
      "id": 110504452111278088,
      "target": "Sirin: A halál már úgyis közel van."
    },
    {
      "id": 110504452111278087,
      "target": "Sirin: Ne tedd ezt."
    },
    {
      "id": 110504452111278084,
      "target": "Sirin: Üsd ki belőlem a lelket."
    },
    {
      "id": 110504452111278083,
      "target": "Sirin: Így még jobb."
    },
    {
      "id": 110504452111278080,
      "target": "Sirin: Úgy látszik, nem hiába csinálta."
    },
    {
      "id": 110504452107083786,
      "target": "Sirin: A testvérem borotválja a hónaljamat. Gondoskodik rólam."
    },
    {
      "id": 110504452107083783,
      "target": "Sirin: De nem ismeri el az ürességet a szemekben."
    },
    {
      "id": 110504452107083782,
      "target": "Sirin: Ebben hasonlítunk a testvéremmel."
    },
    {
      "id": 110504452107083779,
      "target": "Sirin: Hagyott volna már akkor meghalni."
    },
    {
      "id": 110504452107083778,
      "target": "Sirin: Jobb lett volna…"
    },
    {
      "id": 110504452107083777,
      "target": "Sirin: De ennek nincs értelme."
    },
    {
      "id": 110504452107083776,
      "target": "Sirin: A testvérem segít nekem."
    },
    {
      "id": 110504452102889481,
      "target": "Sirin: Kivered őket nekem?"
    },
    {
      "id": 110504452102889480,
      "target": "Sirin: Nézd."
    },
    {
      "id": 110504452102889473,
      "target": "Sirin: Tedd már meg."
    }
  ]
}
