  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504456100061186,
      "target": "Nagyon nehéz rá összpontosítani."
    },
    {
      "id": 110504456100061185,
      "target": "Egy kis magányos ház képe jelenik meg a szeme előtt."
    },
    {
      "id": 110504456100061184,
      "target": "Elsötétül a világ a szeme előtt."
    },
    {
      "id": 110504456095866891,
      "target": "Darabokra tépik."
    },
    {
      "id": 110504456095866890,
      "target": "A rémület megvakítja."
    },
    {
      "id": 110504456095866889,
      "target": "Arra sem gondol, hogy megmeneküljön."
    },
    {
      "id": 110504456095866888,
      "target": "A halálfélelem megbénítja."
    },
    {
      "id": 110504456095866887,
      "target": "Érzi, hogy tekintetek szegeződnek önre."
    },
    {
      "id": 110504456095866886,
      "target": "Az emberek nem bíznak egymásban."
    },
    {
      "id": 110504456095866885,
      "target": "A tudósok azt jósolják, hogy pár napon belül…"
    },
    {
      "id": 110504456095866884,
      "target": "„A Nap energiája fokozatosan csillapodik."
    },
    {
      "id": 110504456095866883,
      "target": "MINDENKI."
    },
    {
      "id": 110504456095866882,
      "target": "Ma meghal minden rohadék, aki fegyvert tart a kezében."
    },
    {
      "id": 110504456095866881,
      "target": "MINDENT elárasztok a véretekkel."
    },
    {
      "id": 110504456095866880,
      "target": "A föld mélyére hajszollak benneteket."
    },
    {
      "id": 110504456091672587,
      "target": "Őrülettel megátkozott fejek."
    },
    {
      "id": 110504456091672586,
      "target": "Összezúzlak benneteket!"
    },
    {
      "id": 110504456091672585,
      "target": "Azt hiszed, senki sem fog visszavágni?"
    },
    {
      "id": 110504456091672584,
      "target": "A hozzád hasonlók senkit sem hagynak békén."
    },
    {
      "id": 110504456091672583,
      "target": "A hozzád hasonlók ölték meg a barátomat."
    },
    {
      "id": 110504456091672582,
      "target": "Az ilyen kibaszott férgek miatt haltak meg annyian."
    },
    {
      "id": 110504456091672581,
      "target": "Elcsendesedett. Meg kell néznem."
    },
    {
      "id": 110504456091672580,
      "target": "Velem azért küszködött, mert nem hagyom magam. De a többiekkel mi lesz?"
    },
    {
      "id": 110504456091672579,
      "target": "A rohadék. Megsebzett."
    },
    {
      "id": 110504456091672578,
      "target": "Hallom a hörgését."
    },
    {
      "id": 110504456091672577,
      "target": "A fegyveres ember szemét elborító düh ijesztőbb, mint egy Vendég."
    },
    {
      "id": 110504456091672576,
      "target": "Ön csak vár, és reméli, hogy semmi sem történik."
    },
    {
      "id": 110504456087478283,
      "target": "Hallja, ahogy az őrült agresszívan köpi a szavakat az ajtó mögött."
    }
  ]
}
