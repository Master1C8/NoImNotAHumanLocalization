{
  "schemaVersion": 1,
  "locale": "hu",
  "sourceSpecSha256": "13a6edc02ab914becdd86af5e8829299c7a7b11ff3c300e61b3aed023b441368",
  "editorialStatus": "development draft; independent mechanics review pending",
  "sourceInterpretationNotes": {
    "line:Foreigner_Death_0f116b2": "Damaged Russian keyboard-layout fragment interpreted as killing, not a person named Ivan.",
    "line:Foreigner_Photo_0c3c7aa": "Damaged photo/adoration wording interpreted using neighboring Photo_DontShoot preference for photos; exact damaged syntax unresolved."
  },
  "entries": [
    {
      "key": "line:FEMA_GivingPostcard_Foreigner_0af7d0d",
      "parts": [
        {
          "kind": "opaque",
          "text": "Rendben, elveszem..."
        }
      ]
    },
    {
      "key": "line:FEMA_GivingPostcard_Foreigner_0cc7047",
      "parts": [
        {
          "kind": "opaque",
          "text": "Mi ez?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_1_0e957d2",
      "parts": [
        {
          "kind": "understood",
          "text": "Sok szerrencsét!",
          "sourceCue": "Уууудаси!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_1_0c936e3",
      "parts": [
        {
          "kind": "opaque",
          "text": "Talán ennyi idő után végre hazajutok…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_1_0905b5d",
      "parts": [
        {
          "kind": "opaque",
          "text": "De holnap kimegyek az állomásra, és magam derítem ki!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_1_0e19b62",
      "parts": [
        {
          "kind": "opaque",
          "text": "Nem értettem, bocsánat."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_0ee031f",
      "parts": [
        {
          "kind": "understood",
          "text": "Sziááá!",
          "sourceCue": "Пайкааа!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_02340b2",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ma éjjel elmegyek. Szia!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_04527f2",
      "parts": [
        {
          "kind": "opaque",
          "text": "Holnap hazaindulok! Legalábbis kimegyek az állomásra."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_6_08b6c83",
      "parts": [
        {
          "kind": "opaque",
          "text": "Nem értem, barátom."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_5_058e3f1",
      "parts": [
        {
          "kind": "opaque",
          "text": "El tudták magyarázni, hogy még járnak a vonatok! Ezt képzeld el!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_5_0a05381",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ja, arra gondolsz."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_2_043501e",
      "parts": [
        {
          "kind": "opaque",
          "text": "Még járnak a hajók? Utána kell néznem, köszönöm!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_2_020fa6b",
      "parts": [
        {
          "kind": "opaque",
          "text": "Úgy érted, hajóval menjek?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_1_0264fa8",
      "parts": [
        {
          "kind": "opaque",
          "text": "Hátha tényleg el lehet még repülni."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_1_03e6625",
      "parts": [
        {
          "kind": "opaque",
          "text": "Valahonnan információt kell szereznem."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_1_06190d7",
      "parts": [
        {
          "kind": "opaque",
          "text": "Repülő? Szerinted még repülnek?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_0f3f5f9",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ez az egész helyzet kibaszottul szar, máshogy nem lehet mondani."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_00450ac",
      "parts": [
        {
          "kind": "opaque",
          "text": "A barátomat jöttem meglátogatni, erre ez fogad."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_4_04109c2",
      "parts": [
        {
          "kind": "opaque",
          "text": "Otthon? Az otthonomról kérdezel?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_0ba0261",
      "parts": [
        {
          "kind": "opaque",
          "text": "Micsoda borzalom."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_084c32d",
      "parts": [
        {
          "kind": "opaque",
          "text": "Vajon otthon is ugyanez történik?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_05970a6",
      "parts": [
        {
          "kind": "opaque",
          "text": "Nehéz, persze, de talán segít rajtam."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_0ef9d29",
      "parts": [
        {
          "kind": "understood",
          "text": "Jólvan.",
          "sourceCue": "Харасхо."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_0a6ab5a",
      "parts": [
        {
          "kind": "understood",
          "text": "Jó…",
          "sourceCue": "Хара…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_041d9b1",
      "parts": [
        {
          "kind": "understood",
          "text": "Jóóól.",
          "sourceCue": "Харохооо."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_3_1_0a21905",
      "parts": [
        {
          "kind": "opaque",
          "text": "Megpróbálom elismételni."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_2_04c6bc4",
      "parts": [
        {
          "kind": "opaque",
          "text": "Talán kérdőszó."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_2_090b6a7",
      "parts": [
        {
          "kind": "opaque",
          "text": "De kérdeztél valamit."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_1_01c288c",
      "parts": [
        {
          "kind": "opaque",
          "text": "Talán kérdőszó."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_1_01a5f8a",
      "parts": [
        {
          "kind": "opaque",
          "text": "Még mindig nem értem. De kérdeztél valamit."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_09e3b4a",
      "parts": [
        {
          "kind": "understood",
          "text": "Hogy.",
          "sourceCue": "Как."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_0f0190b",
      "parts": [
        {
          "kind": "opaque",
          "text": "Talán így legalább megértem, mit mondok."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_2_075bcb9",
      "parts": [
        {
          "kind": "opaque",
          "text": "Elismételhetem a szavaidat, te pedig reagálhatsz rájuk."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_1_1_0ebd34d",
      "parts": [
        {
          "kind": "opaque",
          "text": "Találjunk ki valami közös nyelvet?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_1_1_0cd4635",
      "parts": [
        {
          "kind": "opaque",
          "text": "Nem értelek. Mit lehet tenni?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_1_0d71f9d",
      "parts": [
        {
          "kind": "opaque",
          "text": "BEVARRTÁK A SZÁMAT! Csak mert nem értenek meg."
        }
      ]
    },
    {
      "key": "line:Foreigner_Asking_1_09c22e5",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ez valami rémálom!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Death_0f116b2",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ö… lés…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Death_0b50221",
      "parts": [
        {
          "kind": "opaque",
          "text": "Így megy ez. Nem értenek meg, félnek tőled, és te…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Ears_DontShoot_00a90ca",
      "parts": [
        {
          "kind": "opaque",
          "text": "Bármit odaadnék, hogy újra lássam. Nagyon hiányzik. "
        },
        {
          "kind": "understood",
          "text": "Mutat",
          "sourceCue": "Пакаж"
        },
        {
          "kind": "opaque",
          "text": ", az mit jelent?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Photo_DontShoot_0bf7704",
      "parts": [
        {
          "kind": "opaque",
          "text": "Szeretem a fényképeket. Te láthatóan nem vagy értőjük…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Armpit_DontShoot_05058dc",
      "parts": [
        {
          "kind": "understood",
          "text": "Elenőriz",
          "sourceCue": "Правирйат ба"
        },
        {
          "kind": "opaque",
          "text": " itt… Ez nem tűnik helyesnek…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Eyes_DontShoot_044b445",
      "parts": [
        {
          "kind": "opaque",
          "text": "Szem, mint bármelyik. Minek ijesztgetsz?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Hands_DontShoot_062d5bf",
      "parts": [
        {
          "kind": "opaque",
          "text": "Kezet kéne mosnom…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Teeth_DontShoot_0f917b2",
      "parts": [
        {
          "kind": "opaque",
          "text": "Tudod, hogy bevarrták a számat. Most meg fegyvert fogsz rám, és "
        },
        {
          "kind": "understood",
          "text": "lövö",
          "sourceCue": "расрел"
        },
        {
          "kind": "opaque",
          "text": " mindenkit…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Ears_Gun_022cef2",
      "parts": [
        {
          "kind": "opaque",
          "text": "És most mi lesz?!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Armpit_Gun_0488113",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ember! Hagyd abba! Ez valami baromság!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Eyes_Gun_0bf3d2f",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ne! Jó vagyok! Csak nem értjük egymást!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Hands_Gun_0b64782",
      "parts": [
        {
          "kind": "opaque",
          "text": "Tedd el a fegyvert! Nem tettem veled semmi rosszat!!!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Teeth_Gun_0a4207d",
      "parts": [
        {
          "kind": "opaque",
          "text": "Miért, mi van!? Megtettem, amit akartál!!!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Ears_0f4eb6c",
      "parts": [
        {
          "kind": "opaque",
          "text": "A drága barátomtól kapott fülbevaló."
        }
      ]
    },
    {
      "key": "line:Foreigner_Ears_076f3a7",
      "parts": [
        {
          "kind": "opaque",
          "text": "Fül, mint bármelyik."
        }
      ]
    },
    {
      "key": "line:Foreigner_Photo_002e8e0",
      "parts": [
        {
          "kind": "opaque",
          "text": "Megmutatod?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Photo_0c3c7aa",
      "parts": [
        {
          "kind": "opaque",
          "text": "Fénykép? Azt nagyon szeretem!"
        }
      ]
    },
    {
      "key": "line:Foreigner_Armpit_0d48250",
      "parts": [
        {
          "kind": "opaque",
          "text": "Elégedett vagy?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Armpit_090c5f5",
      "parts": [
        {
          "kind": "opaque",
          "text": "Ezt az egészet nem értem… Na mindegy…"
        }
      ]
    },
    {
      "key": "line:Foreigner_Eyes_0b39cdc",
      "parts": [
        {
          "kind": "opaque",
          "text": "Még mindig nem értem, minek ez neked… A "
        },
        {
          "kind": "understood",
          "text": "Nap",
          "sourceCue": "Солце"
        },
        {
          "kind": "opaque",
          "text": " kiégetheti a retinát. Én nem "
        },
        {
          "kind": "understood",
          "text": "néz",
          "sourceCue": "смарет"
        },
        {
          "kind": "opaque",
          "text": " a "
        },
        {
          "kind": "understood",
          "text": "nap",
          "sourceCue": "солце"
        },
        {
          "kind": "opaque",
          "text": " felé."
        }
      ]
    },
    {
      "key": "line:Foreigner_Eyes_0aba9fb",
      "parts": [
        {
          "kind": "opaque",
          "text": "Szem?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Hands_0144f06",
      "parts": [
        {
          "kind": "opaque",
          "text": "Miért csinálod ezt az egészet? "
        },
        {
          "kind": "understood",
          "text": "Ölni",
          "sourceCue": "Убйивай"
        },
        {
          "kind": "opaque",
          "text": " szórakozásból?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Hands_0654052",
      "parts": [
        {
          "kind": "opaque",
          "text": "Kéz? Rendben."
        }
      ]
    },
    {
      "key": "line:Foreigner_Teeth_02674b3",
      "parts": [
        {
          "kind": "opaque",
          "text": "És most?"
        }
      ]
    },
    {
      "key": "line:Foreigner_Teeth_03ba689",
      "parts": [
        {
          "kind": "opaque",
          "text": "Mi? A "
        },
        {
          "kind": "understood",
          "text": "száj",
          "sourceCue": "рхот"
        },
        {
          "kind": "opaque",
          "text": " felé mutatsz? Igen, bevarrták. És most? Mosolyogjak?"
        }
      ]
    },
    {
      "key": "line:Foreigner_WannaCheck_0d955c8",
      "parts": [
        {
          "kind": "opaque",
          "text": "Semmit sem értek. Mit akarsz tőlem?"
        }
      ]
    }
  ]
}
