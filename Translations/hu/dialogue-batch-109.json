  "entries": [
    {
      "id": 110504456947310594,
      "target": "Ez itt nem óvoda"
    },
    {
      "id": 110504456947310593,
      "target": "Hagyjatok békén"
    },
    {
      "id": 110504456947310592,
      "target": "CultistPriest: Miért?"
    },
    {
      "id": 110504456943116300,
      "target": "Na, mi van ezzel a Halálotokkal?"
    },
    {
      "id": 110504456943116299,
      "target": "Vidd magaddal a söpredékedet"
    },
    {
      "id": 110504456943116298,
      "target": "CultistPriest: Jó éjszakát."
    },
    {
      "id": 110504456943116297,
      "target": "CultistPriest: Tudod… ha a Halál téged választott, segítek neki, hogy közelebbről szemügyre vegyen."
    },
    {
      "id": 110504456943116296,
      "target": "CultistPriest: Ezért…"
    },
    {
      "id": 110504456943116295,
      "target": "CultistPriest: Végül mégsem élték meg…"
    },
    {
      "id": 110504456943116294,
      "target": "Na, mi van ezzel a Halálotokkal?"
    },
    {
      "id": 110504456943116293,
      "target": "Vidd magaddal a söpredékedet"
    },
    {
      "id": 110504456943116292,
      "target": "CultistPriest: Akkor nem tartóztatlak. Azt hiszem, továbbmegyek."
    },
    {
      "id": 110504456943116291,
      "target": "CultistPriest: Jól van. Nem is lehetett volna másképp, a tekintete még mindig ránk szegeződik."
    },
    {
      "id": 110504456943116290,
      "target": "Tűnj el, most nincs rád időm"
    },
    {
      "id": 110504456943116289,
      "target": "A tieid jól vannak"
    },
    {
      "id": 110504456943116288,
      "target": "CultistPriest: Nálad minden rendben?"
    },
    {
      "id": 110504456938921995,
      "target": "CultistPriest: Így ér véget a világ. Nem robbanással, hanem nyöszörgéssel…"
    },
    {
      "id": 110504456938921994,
      "target": "CultistPriest: A Halál már nem beszél hozzám."
    }
  ]
}
