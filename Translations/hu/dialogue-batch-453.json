  "entries": [
    {
      "id": 110504452052557829,
      "target": "Daughter: Nem tetszett. Ne kérj meg még egyszer, hogy fényképezkedjek."
    },
    {
      "id": 110504452052557828,
      "target": "Daughter: Köszönöm."
    },
    {
      "id": 110504452052557827,
      "target": "Daughter: Mmmmm."
    },
    {
      "id": 110504452052557826,
      "target": "Daughter: (A kislány a fényképezés vége előtt odaszalad önhöz)"
    },
    {
      "id": 110504452052557825,
      "target": "Daughter: (A fénykép kissé elmosódott lett)"
    },
    {
      "id": 110504452052557824,
      "target": "Daughter: (Lefényképezi a kislányt)"
    },
    {
      "id": 110504452048363530,
      "target": "Daughter: Megmutatod majd a képet?"
    },
    {
      "id": 110504452048363529,
      "target": "Daughter: Engem ritkán fényképeztek."
    },
    {
      "id": 110504452048363528,
      "target": "Daughter: Fénykép?"
    },
    {
      "id": 110504452048363527,
      "target": "Daughter: Nagyon elfáradtam, állhatok itt egyedül?"
    },
    {
      "id": 110504452048363526,
      "target": "Daughter: Csak azt szeretné tudni, hogy vagyok?"
    },
    {
      "id": 110504452048363525,
      "target": "Daughter: (Ránéz a kislányra, és rájön, hogy ez önnek már túl sok.)"
    },
    {
      "id": 110504452048363524,
      "target": "Daughter: Mit kell csinálnom?"
    },
    {
      "id": 110504452048363523,
      "target": "Daughter: É-é-én i-inni a-akarooook."
    },
    {
      "id": 110504452048363522,
      "target": "Daughter: Ön… uááááá."
    },
    {
      "id": 110504452048363521,
      "target": "Daughter: Ön ott lá-látott…"
    },
    {
      "id": 110504452048363520,
      "target": "Daughter: Miért nézett rám így?"
    },
    {
      "id": 110504452044169226,
      "target": "Daughter: Akkor óvatosan fogok gondolkodni, ne aggódjon."
    },
    {
      "id": 110504452044169225,
      "target": "Daughter: Ott mindent lát, amire gondolok?"
    },
    {
      "id": 110504452044169224,
      "target": "Daughter: És be tud nézni a szemem belsejébe?"
    },
    {
      "id": 110504452044169223,
      "target": "Daughter: Elmegyek, egyedül szeretnék ülni."
    },
    {
      "id": 110504452044169222,
      "target": "Daughter: Én magam vágtam le őket. Sikerült. Egyedül."
    },
    {
      "id": 110504452044169221,
      "target": "Daughter: Ilyenek a körmöcskéim."
    },
    {
      "id": 110504452044169219,
      "target": "Daughter: Nézze."
    },
    {
      "id": 110504452044169218,
      "target": "Daughter: Még nem nagyon tudom, nekem…"
    },
    {
      "id": 110504452044169217,
      "target": "Daughter: De én már egyedül is le tudom vágni a körmömet."
    },
    {
      "id": 110504452044169216,
      "target": "Daughter: Minden rendben van, ugye?"
    },
    {
      "id": 110504452039974921,
      "target": "Daughter: Ez mit jelent?"
    },
    {
      "id": 110504452039974920,
      "target": "Daughter: Ilyenek az enyémek."
    },
    {
      "id": 110504452039974918,
      "target": "Daughter: Nem sírok többet."
    },
    {
      "id": 110504452039974917,
      "target": "Daughter: Miért? Nekem még tejfogaim vannak. Apa azt mondta…"
    },
    {
      "id": 110504452039974916,
      "target": "Daughter: A fogaim? Mutassam meg a fogaimat?"
    },
    {
      "id": 110504452035780615,
      "target": "Daughter: Mit akarsz megvizsgálni?"
    }
  ]
}
