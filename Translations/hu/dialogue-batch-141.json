  "entries": [
    {
      "id": 110504456632737802,
      "target": "Gasmask: Ha tovább baszakodnak, egyszerűen elvisszük az összes embert ebből a házból."
    },
    {
      "id": 110504456632737801,
      "target": "Gasmask: A VILÁG A VÉG SZÉLÉN ÁLL."
    },
    {
      "id": 110504456632737800,
      "target": "Gasmask: FEJEZZÉK MÁR BE EZT A FASZSÁGOT!"
    },
    {
      "id": 110504456632737799,
      "target": "Miféle katasztrófa?"
    },
    {
      "id": 110504456632737798,
      "target": "Hol. Vannak. Az embereim?"
    },
    {
      "id": 110504456632737797,
      "target": "Gasmask: Különben katasztrófa lesz."
    },
    {
      "id": 110504456632737796,
      "target": "Gasmask: Még embereket kell elvinnünk."
    },
    {
      "id": 110504456632737795,
      "target": "Gasmask: Hamarosan visszahozzuk őket. Köszönöm."
    },
    {
      "id": 110504456632737794,
      "target": "Gasmask: Csak. Adjanak. Embereket."
    },
    {
      "id": 110504456632737793,
      "target": "Gasmask: Fontos nekünk ez a város."
    },
    {
      "id": 110504456632737792,
      "target": "Gasmask: Ha ellenállnak, folytatódnak a robbantások."
    },
    {
      "id": 110504456628543499,
      "target": "Gasmask: Mert makacs faszfejek akadályozzák a munkánkat."
    },
    {
      "id": 110504456628543498,
      "target": "Gasmask: Tetszik a látvány mögöttem?"
    },
    {
      "id": 110504456628543497,
      "target": "Gasmask: Rendben."
    },
    {
      "id": 110504456628543496,
      "target": "Gasmask: A kurva életbe…"
    },
    {
      "id": 110504456628543495,
      "target": "Gasmask: És elbánunk a Vendégekkel."
    },
    {
      "id": 110504456628543494,
      "target": "Gasmask: Most elviszünk kettőt, de hamarosan mindenkit visszahozunk."
    },
    {
      "id": 110504456628543493,
      "target": "Gasmask: Köszönöm, hogy meghallgatott."
    },
    {
      "id": 110504456628543492,
      "target": "Gasmask: Igen, ez segíteni fog."
    },
    {
      "id": 110504456628543491,
      "target": "Nem. Elegem van"
    },
    {
      "id": 110504456628543490,
      "target": "Rendben. Ha ez segít…"
    },
    {
      "id": 110504456628543489,
      "target": "Gasmask: Hamarosan minden rendbe jön."
    },
    {
      "id": 110504456628543488,
      "target": "Gasmask: Mindegy, ki, csak gyorsan adjanak valakit."
    },
    {
      "id": 110504456624349196,
      "target": "Gasmask: De ezúttal kettő kell."
    },
    {
      "id": 110504456624349195,
      "target": "Gasmask: Igen."
    },
    {
      "id": 110504456624349194,
      "target": "Nem. Elegem van"
    },
    {
      "id": 110504456624349193,
      "target": "Rendben. Ha ez segít…"
    },
    {
      "id": 110504456624349192,
      "target": "Gasmask: Ez felgyorsítja a munkánkat. Így jobb lesz."
    },
    {
      "id": 110504456624349191,
      "target": "Gasmask: Egyszerre kettőre van szükségünk."
    },
    {
      "id": 110504456624349190,
      "target": "Gasmask: Embereket kell elvinnünk maguktól."
    }
  ]
}
