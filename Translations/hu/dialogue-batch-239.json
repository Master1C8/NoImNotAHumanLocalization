  "entries": [
    {
      "id": 110504455533830156,
      "target": "Nem mindenkinek ez az első sötét időszak"
    },
    {
      "id": 110504455533830155,
      "target": "És ön mit javasol?"
    },
    {
      "id": 110504455533830154,
      "target": "Akkor most feküdjünk le és haljunk meg?"
    },
    {
      "id": 110504455533830153,
      "target": "Teacher: A gyilkosságok nem érnek véget körülöttünk. Az erőszak nem tűnik el."
    },
    {
      "id": 110504455533830152,
      "target": "Teacher: Én ezt nem akarom. Akkor sem, ha valaki megvéd…"
    },
    {
      "id": 110504455533830151,
      "target": "Nem mindenkinek ez az első sötét időszak"
    },
    {
      "id": 110504455533830150,
      "target": "És ön mit javasol?"
    },
    {
      "id": 110504455533830149,
      "target": "Akkor most feküdjünk le és haljunk meg?"
    },
    {
      "id": 110504455533830148,
      "target": "Teacher: Nem értem, hol a helyem ebben az… ahogy ön mondta… „új világban”."
    },
    {
      "id": 110504455533830147,
      "target": "Teacher: Nem tudok erőszakkal élni."
    },
    {
      "id": 110504455533830146,
      "target": "Teacher: Senkinek, aki lágyszívű."
    },
    {
      "id": 110504455533830145,
      "target": "Aki lágyszívű, most nem éli túl. Maradjon valaki mellett"
    },
    {
      "id": 110504455533830144,
      "target": "Attól tart, hogy nem lesz helye az új világban?"
    },
    {
      "id": 110504455529635851,
      "target": "Teacher: Milyen jövő vár ránk?"
    },
    {
      "id": 110504455529635850,
      "target": "Teacher: Ha ez nem tömeges kihalás, ha túléljük, akkor mi vár ránk?"
    },
    {
      "id": 110504455529635849,
      "target": "Teacher: Csak elgondolkodtam…"
    },
    {
      "id": 110504455529635848,
      "target": "Teacher: Mi?"
    },
    {
      "id": 110504455529635846,
      "target": "Van valami baj?"
    },
    {
      "id": 110504455529635845,
      "target": "Teacher: Szegény gyerekek…"
    }
  ]
}
