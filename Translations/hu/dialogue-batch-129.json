    {
      "id": 110504456775344132,
      "target": "SuperFake: Miért állnál ellen?"
    },
    {
      "id": 110504456775344131,
      "target": "SuperFake: TUDOM, hogy hamarosan minden eldől."
    },
    {
      "id": 110504456775344130,
      "target": "SuperFake: Mibe kapaszkodsz?"
    },
    {
      "id": 110504456775344129,
      "target": "SuperFake: Miért?"
    },
    {
      "id": 110504456775344128,
      "target": "SuperFake: Csak menekülsz. Az embereim elől, a problémák elől."
    },
    {
      "id": 110504456771149835,
      "target": "SuperFake: Ezért vagyok itt."
    },
    {
      "id": 110504456771149834,
      "target": "SuperFake: Nem állsz készen arra, hogy a kezedbe vedd az ügyet."
    },
    {
      "id": 110504456771149833,
      "target": "SuperFake: Igeeeen."
    },
    {
      "id": 110504456771149832,
      "target": "SuperFake: Érzel félelmet?"
    },
    {
      "id": 110504456771149830,
      "target": "SuperFake: Mégis készen állsz."
    },
    {
      "id": 110504456771149829,
      "target": "Eltávolítottam néhány oda nem illőt a házból"
    },
    {
      "id": 110504456771149828,
      "target": "Minden oda nem illőt eltávolítottam a házból"
    },
    {
      "id": 110504456771149827,
      "target": "Csak azt engedtem be, akit kellett"
    },
    {
      "id": 110504456771149826,
      "target": "Sok nem ember van a házban"
    },
    {
      "id": 110504456771149825,
      "target": "Senkit sem engedtem be"
    },
    {
      "id": 110504456771149824,
      "target": "Sok ember van a házban"
    },
    {
      "id": 110504456766955531,
      "target": "SuperFake: Vannak most az embereim a házadban?"
    },
    {
      "id": 110504456766955530,
      "target": "SuperFake: Engem valami más érdekel."
    },
    {
      "id": 110504456766955528,
      "target": "SuperFake: Érezni fogsz valamit?"
    },
    {
      "id": 110504456766955527,
      "target": "SuperFake: Csak eltűnsz? Örökre?"
    },
    {
      "id": 110504456766955526,
      "target": "SuperFake: Majd meghalsz. És utána?"
    },
    {
      "id": 110504456766955525,
      "target": "SuperFake: Úgy tűnik, gyakrabban gondolsz arra, mi lesz azután."
    },
    {
      "id": 110504456766955523,
      "target": "SuperFake: Gyakran eltűnődsz azon, miért vagy még életben?"
    },
    {
      "id": 110504456766955522,
      "target": "SuperFake: Megrémít az ismeretlen?"
    },
    {
