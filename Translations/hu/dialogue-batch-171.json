      "target": "Daughter: Fé-é-élek."
    },
    {
      "id": 110504456330747910,
      "target": "Daughter: Tudna se-segíteni nekem?"
    },
    {
      "id": 110504456330747907,
      "target": "Daughter: Amíg fu-futottam, ők csak nevettek."
    },
    {
      "id": 110504456330747906,
      "target": "Daughter: Aztán va-valamit csináltak, aztán fe-felgyújtották a házat."
    },
    {
      "id": 110504456330747905,
      "target": "Daughter: Ők nyu-nyugodtan ültek apával a konyhában."
    },
    {
      "id": 110504456330747904,
      "target": "Daughter: Én ne-nem tudom."
    },
    {
      "id": 110504456326553623,
      "target": "Daughter: A házunk mo-most é-é-é-ég."
    },
    {
      "id": 110504456326553622,
      "target": "Daughter: Áááááááááá-hááááááá."
    },
    {
      "id": 110504456326553621,
      "target": "Daughter: Apa be-beszélt velük valamiről. Aztán megölték."
    },
    {
      "id": 110504456326553620,
      "target": "Daughter: Ve-e-endégek jöttek hozzánk. Ná-nálunk ültek."
    },
    {
      "id": 110504456326553619,
      "target": "Miért tették ezt?"
    },
    {
      "id": 110504456326553618,
      "target": "Ki tette ezt?"
    },
    {
