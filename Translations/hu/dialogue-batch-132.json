  "entries": [
    {
      "id": 110504456737595392,
      "target": "SuperFake: Miért?"
    },
    {
      "id": 110504456733401099,
      "target": "SuperFake: Még mindig próbálod rendbe hozni az életedet."
    },
    {
      "id": 110504456733401098,
      "target": "SuperFake: Most kinyitom az ajtót, és átadom az ajándékokat."
    },
    {
      "id": 110504456733401097,
      "target": "SuperFake: Nem tudtál senkivel kijönni?"
    },
    {
      "id": 110504456733401096,
      "target": "SuperFake: Mégiscsak egyedül vagy."
    },
    {
      "id": 110504456733401093,
      "target": "SuperFake: Egyedül vagy otthon?"
    },
    {
      "id": 110504456733401092,
      "target": "SuperFake: Figyeeeelj."
    },
    {
      "id": 110504456733401090,
      "target": "SuperFake: Csak a szívet tudod megállítani."
    },
    {
      "id": 110504456733401089,
      "target": "SuperFake: Meg tudod állítani az árvizeket, a tüzeket, az öregedést?"
    },
    {
      "id": 110504456733401088,
      "target": "SuperFake: Meg tudod állítani a halált?"
    },
    {
      "id": 110504456729206794,
      "target": "SuperFake: És mit tudsz te tenni?"
    },
    {
      "id": 110504456729206791,
      "target": "SuperFake: Egyedül vagy otthon?"
    },
    {
      "id": 110504456729206790,
      "target": "SuperFake: Figyeeeelj."
    },
    {
      "id": 110504456729206788,
      "target": "SuperFake: A halál ellen?"
    },
    {
      "id": 110504456729206787,
      "target": "SuperFake: Az űrből érkező Vész ellen?"
    },
    {
      "id": 110504456729206786,
      "target": "SuperFake: És mit teszel a természeti katasztrófák ellen?"
    },
    {
      "id": 110504456729206785,
      "target": "SuperFake: Ezt éppenséggel tudom!"
    },
    {
      "id": 110504456729206784,
      "target": "Megteszem, amit tudok"
    },
    {
      "id": 110504456725012491,
      "target": "Semmit sem tehetek"
    },
    {
      "id": 110504456725012490,
      "target": "SuperFake: Vagy inkább mindent magad akarsz helyrehozni?"
    },
    {
      "id": 110504456725012489,
      "target": "SuperFake: Tiszta áldás, mi más."
    },
    {
      "id": 110504456725012488,
      "target": "SuperFake: Mindent eldöntöttek helyettünk."
    },
    {
      "id": 110504456725012487,
      "target": "SuperFake: Nincs min gondolkodni."
    },
    {
      "id": 110504456725012486,
      "target": "Megteszem, amit tudok"
    },
    {
      "id": 110504456725012485,
      "target": "Semmit sem tehetek"
    },
    {
      "id": 110504456725012484,
      "target": "SuperFake: Vagy jobb, ha mi magunk vesszük a kezünkbe a dolgokat?"
    },
    {
      "id": 110504456725012483,
      "target": "SuperFake: Talán legalább ők rendet tesznek?"
    },
    {
      "id": 110504456725012482,
      "target": "SuperFake: Hol ez, hol az, igaz?"
    },
    {
      "id": 110504456725012481,
      "target": "SuperFake: Nehéz idők járnak."
    },
    {
      "id": 110504456725012480,
      "target": "Nem tudom, mit gondoljak róla"
    },
    {
      "id": 110504456720818187,
      "target": "A dolgát végzi"
    },
    {
      "id": 110504456720818186,
      "target": "SuperFake: Mi a véleményed arról az öltönyösről?"
    },
    {
      "id": 110504456720818184,
      "target": "SuperFake: Te meg csak otthon ülsz."
    }
  ]
}
