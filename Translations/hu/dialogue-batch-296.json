  "entries": [
    {
      "id": 110504454787244038,
      "target": "Buddy: Én…"
    },
    {
      "id": 110504454787244037,
      "target": "Buddy: Nem magától halt meg…"
    },
    {
      "id": 110504454787244036,
      "target": "Buddy: Éppen ez az. Öreg és beteg volt, de…"
    },
    {
      "id": 110504454787244035,
      "target": "És?"
    },
    {
      "id": 110504454787244034,
      "target": "És mi olyan különös ebben?"
    },
    {
      "id": 110504454787244033,
      "target": "Buddy: Volt egy kutyám, és pár napja… meghalt."
    },
    {
      "id": 110504454787244032,
      "target": "Buddy: Rendben, ha már el kell mondanom…"
    },
    {
      "id": 110504454783049737,
      "target": "Buddy: Ki akarsz nyírni, haver?"
    },
    {
      "id": 110504454783049736,
      "target": "És?"
    },
    {
      "id": 110504454783049735,
      "target": "És mi olyan különös ebben?"
    },
    {
      "id": 110504454783049734,
      "target": "Buddy: Volt egy kutyám, és pár napja… meghalt."
    },
    {
      "id": 110504454783049733,
      "target": "Buddy: Bár… ezt már nem bírom tovább."
    },
    {
      "id": 110504454783049731,
      "target": "Buddy: Nem tudom… Más szemmel fogsz nézni rám."
    },
    {
      "id": 110504454783049730,
      "target": "El kell mondanod. Különben rosszabb lesz."
    },
    {
      "id": 110504454783049729,
      "target": "Csak mondd el, mi történt veled."
    },
    {
      "id": 110504454783049728,
      "target": "Buddy: Semmi közöd hozzá, haver! Szállj le rólam!"
    },
    {
      "id": 110504454778855433,
      "target": "Mondd el, mi történt veled."
    },
    {
      "id": 110504454778855432,
      "target": "Buddy: Kérdezz, haverkám."
    },
    {
      "id": 110504454778855431,
      "target": "Buddy: Köszönöm, tényleg nem vagyok jól."
    },
    {
      "id": 110504454778855430,
      "target": "Buddy: Hagyj békén."
    },
    {
      "id": 110504454778855429,
      "target": "Buddy: Ne erőltess! Így is nehéz a szívem."
    },
    {
      "id": 110504454778855428,
      "target": "Jól van, nem faggatlak."
    },
    {
      "id": 110504454778855427,
      "target": "Tudnom kell."
    },
    {
      "id": 110504454778855426,
      "target": "Buddy: Figyelj, én tényleg nem akarok erről beszélni."
    },
    {
      "id": 110504454778855425,
      "target": "Jól van, nem faggatlak."
    },
    {
      "id": 110504454778855424,
      "target": "Tudnom kell."
    },
    {
      "id": 110504454774661130,
      "target": "Buddy: Mindegy, úgysem értenéd meg."
    },
    {
      "id": 110504454774661128,
      "target": "Milyen témát?"
    },
    {
      "id": 110504454774661127,
      "target": "Buddy: Nem akarom szóba hozni ezt."
    },
    {
      "id": 110504454774661125,
      "target": "Buddy: Én…"
    },
    {
      "id": 110504454774661123,
      "target": "Elég borús vagy ma."
    },
    {
      "id": 110504454774661122,
      "target": "Buddy: Kérdezz, haverkám."
    },
    {
      "id": 110504454774661121,
      "target": "Buddy: Semmi, csak elgondolkodtam."
    },
    {
      "id": 110504454770466825,
      "target": "Buddy: Hm…"
    },
    {
      "id": 110504454770466824,
      "target": "Buddy: Nem, csak…"
    },
    {
      "id": 110504454770466823,
      "target": "Buddy: Mindegy, felejtsd el."
    },
    {
      "id": 110504454770466821,
      "target": "Buddy: Mi? Tessék?"
    },
    {
      "id": 110504454770466820,
      "target": "Miért dermedtél le?"
    },
    {
      "id": 110504454770466819,
      "target": "Minden rendben?"
    }
  ]
}
