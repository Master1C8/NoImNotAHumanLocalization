  "entries": [
    {
      "id": 110504456762761223,
      "target": "SuperFake: Beengedted az embereimet?"
    },
    {
      "id": 110504456762761222,
      "target": "SuperFake: Addig is…"
    },
    {
      "id": 110504456762761221,
      "target": "SuperFake: De te biztosan el fogsz tűnni."
    },
    {
      "id": 110504456762761220,
      "target": "SuperFake: Ha nem ma, akkor holnap. Ha nem holnap, akkor később."
    },
    {
      "id": 110504456762761219,
      "target": "SuperFake: Meg fogsz halni."
    },
    {
      "id": 110504456762761218,
      "target": "SuperFake: A vége ugyanaz."
    },
    {
      "id": 110504456762761217,
      "target": "SuperFake: Megváltoztatni valamit?"
    },
    {
      "id": 110504456762761216,
      "target": "SuperFake: Engem csak hozzád küldenek, hogy…"
    },
    {
      "id": 110504456758566923,
      "target": "SuperFake: Csak nem azt gondoltad, hogy téged választottak ki? Haha."
    },
    {
      "id": 110504456758566922,
      "target": "SuperFake: Csak most kérdezed meg ezt?"
    },
    {
      "id": 110504456758566921,
      "target": "Miért nem töröd be rögtön az ajtót?"
    },
    {
      "id": 110504456758566920,
      "target": "Miért jössz ide?"
    },
    {
      "id": 110504456758566919,
      "target": "SuperFake: Ne aggódj, segítünk."
    },
    {
      "id": 110504456758566918,
      "target": "SuperFake: Mulatságos, hogy te magad semmit sem érzel."
    },
    {
      "id": 110504456758566917,
      "target": "SuperFake: Ezt nem árulom el."
    },
    {
      "id": 110504456758566916,
      "target": "Miért nem töröd be rögtön az ajtót?"
    },
    {
      "id": 110504456758566915,
      "target": "Miért jössz ide?"
    },
    {
      "id": 110504456758566914,
      "target": "SuperFake: Már a sarkatokban jár."
    },
    {
      "id": 110504456758566913,
      "target": "SuperFake: Érzed, hogy a Halál egyre közelebb jön?"
    },
    {
      "id": 110504456758566912,
      "target": "SuperFake: Ennyi az egész."
    },
    {
      "id": 110504456754372619,
      "target": "SuperFake: Azt mondom el neked, amit nekem mondtak."
    },
    {
      "id": 110504456754372618,
      "target": "Miféle véghez?"
    },
    {
      "id": 110504456754372617,
      "target": "Miről beszélsz?"
    },
    {
      "id": 110504456754372616,
      "target": "SuperFake: Ha nem mi, akkor ti magatok is elboldogultok majd."
    },
    {
      "id": 110504456754372615,
      "target": "SuperFake: Ez az egész történet a végéhez közeledik."
    },
    {
      "id": 110504456754372614,
      "target": "SuperFake: Azt mondták, ez az utolsó találkozásom veled."
    },
    {
      "id": 110504456754372613,
      "target": "SuperFake: Viszlát?"
    },
    {
      "id": 110504456754372612,
      "target": "SuperFake: Hát…"
    },
    {
      "id": 110504456754372611,
      "target": "SuperFake: Én csak végrehajtom ezt az akaratot."
    },
    {
      "id": 110504456754372610,
      "target": "SuperFake: Vannak nálam hatalmasabb erők is."
    },
    {
      "id": 110504456754372609,
      "target": "SuperFake: Ugye nem gondolod, hogy én vagyok itt… valamiféle főnök?"
    },
    {
      "id": 110504456754372608,
      "target": "SuperFake: A változás még nem a legszörnyűbb dolog, ami rád vár."
    },
    {
      "id": 110504456750178314,
      "target": "SuperFake: Még az embereimből sincs túl sok. Hát még belőletek, akik a házatokba zárkóztatok."
    },
    {
      "id": 110504456750178313,
      "target": "SuperFake: Nahát."
    },
    {
      "id": 110504456750178312,
      "target": "SuperFake: Gyere velem."
    },
    {
      "id": 110504456750178311,
      "target": "SuperFake: Nos, be is vált az új szabályunk."
    },
    {
      "id": 110504456750178310,
      "target": "SuperFake: Hmm…"
    },
    {
      "id": 110504456750178307,
      "target": "SuperFake: Egyedül vagy otthon?"
    },
    {
      "id": 110504456750178306,
      "target": "SuperFake: De előbb kipróbáljuk az új szabályunkat."
    },
    {
      "id": 110504456750178305,
      "target": "SuperFake: Persze! Már megyek is."
    },
    {
      "id": 110504456745984010,
      "target": "SuperFake: Egyedül vagy otthon?"
    },
    {
      "id": 110504456745984009,
      "target": "SuperFake: De először…"
    },
    {
      "id": 110504456745984008,
      "target": "SuperFake: Most kipróbáljuk."
    },
    {
      "id": 110504456745984007,
      "target": "SuperFake: Egyszerű az egész."
    },
    {
      "id": 110504456745984006,
      "target": "Tudnál később visszajönni?"
    }
  ]
}
