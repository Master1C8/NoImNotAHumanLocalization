  "entries": [
    {"id": 110504457886834699, "target": "Phone: …"},
    {"id": 110504457886834697, "target": "Jó napot"},
    {"id": 110504457886834696, "target": "Phone: Halló?"},
    {"id": 110504457886834695, "target": "Phone: …"},
    {"id": 110504457886834693, "target": "Jó napot"},
    {"id": 110504457886834692, "target": "Phone: Halló, jó napot."},
    {"id": 110504457886834691, "target": "Phone: …"},
    {"id": 110504457886834690, "target": "Phone: …"},
    {"id": 110504457886834689, "target": "Phone: Jó napot, ön a telefonos rulettet hívta. Most kiválasztjuk önnek az ideális beszélgetőpartnert. Kérjük, várjon."},
    {"id": 110504457886834688, "target": "Phone: …"},
    {"id": 110504457882640396, "target": "Phone: …"},
    {"id": 110504457882640395, "target": "Phone: Nos, akkor az utolsó kérdés: mondja, folyt vér az otthonában?"},
    {"id": 110504457882640394, "target": "Phone: …"},
    {"id": 110504457882640393, "target": "Phone: Rendben, akkor mondja meg, eszik gombát?"},
    {"id": 110504457882640392, "target": "Phone: …"},
    {"id": 110504457882640391, "target": "Phone: …"},
    {"id": 110504457882640390, "target": "Phone: Egyeztetünk a vezetőséggel, és később értesítjük."},
    {"id": 110504457882640389, "target": "Phone: Fülek? Várjon..."},
    {"id": 110504457882640388, "target": "Phone: …"},
    {"id": 110504457882640387, "target": "Phone: …"},
    {"id": 110504457882640386, "target": "Phone: Tartózkodjon a zuhanyzástól és a kézmosástól."},
    {"id": 110504457882640385, "target": "Phone: Hogy a hónaljvizsgálat eredménye megfelelő legyen, kerülnie kell minden érintkezést a vízzel."},
    {"id": 110504457882640384, "target": "Phone: …"},
    {"id": 110504457878446091, "target": "Phone: …"},
    {"id": 110504457878446090, "target": "Phone: …"},
    {"id": 110504457878446089, "target": "Mit tegyek a fülemmel?"},
    {"id": 110504457878446088, "target": "Mit tegyek a hónaljammal?"},
    {"id": 110504457878446087, "target": "Phone: TE TELJESEN HÜLYE VAGY?! AZONNAL TEDD LE A TELEFONT!"},
    {"id": 110504457878446086, "target": "Phone: (Mielőtt a nő válaszolhatott volna, hangos férfiüvöltés hallatszott)"},
    {"id": 110504457878446085, "target": "Miről beszél?"},
    {"id": 110504457878446084, "target": "Mi? KCsSz? Az meg mi?"},
    {"id": 110504457878446083, "target": "Phone: Jó napot, ön a KCsSz segélyvonalát hívta. Miben segíthetek?"}
  ]
}
