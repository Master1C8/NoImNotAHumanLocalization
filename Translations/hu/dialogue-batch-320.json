  "status": "authored-draft; editorial and runtime acceptance pending",
  "entries": [
    {
      "id": 110504454443311104,
      "target": "Widow: Ön ölte meg – öné marad a lelke. Nekem pedig csak az marad, hogy azt kiáltsam: senkit sem sajnálok."
    },
    {
      "id": 110504454439116810,
      "target": "Widow: Tényleg ott volt…"
    },
    {
      "id": 110504454439116809,
      "target": "Widow: És ő…"
    },
    {
      "id": 110504454439116808,
      "target": "Widow: Az ilyen faszfejeknél mindig rendetlenség van, úgyhogy elég volt felvennem egy orvosi köpenyt, és bemehettem a hullaházba."
    },
    {
      "id": 110504454439116807,
      "target": "Widow: Nem vihetem őt haza."
    },
    {
      "id": 110504454439116806,
      "target": "Widow: A testét sem nézhetem meg."
    },
    {
      "id": 110504454439116805,
      "target": "Widow: Ennyi."
    },
    {
      "id": 110504454439116804,
      "target": "Widow: Azt mondták: „Meghalt.”"
    },
    {
      "id": 110504454439116802,
      "target": "Widow: Egy pillanat, elnézést."
    },
    {
      "id": 110504454439116800,
      "target": "Widow: Csak úgy, szárazon közölték velem…"
    },
    {
      "id": 110504454434922503,
      "target": "Widow: Korábban érkeztem, csak látni akartam."
    },
    {
      "id": 110504454434922501,
      "target": "Widow: A KCsSz egyszerűen karanténba zárta. Nem engedték, hogy kapcsolatba lépjek vele. Azt mondták, három hét múlva kiengedik."
    },
    {
      "id": 110504454434922500,
      "target": "Widow: Elmentünk a KCsSz által megnyitott központba."
    },
    {
      "id": 110504454434922499,
      "target": "Widow: A férjem rosszul volt. Kórházba mentünk, de elküldték kivizsgálásra azokhoz a rohadékokhoz."
    },
    {
      "id": 110504454434922498,
      "target": "Nem kell erről többet kérdeznem"
    },
    {
      "id": 110504454434922497,
      "target": "Szóval mi történt?"
    },
    {
      "id": 110504454434922496,
      "target": "Widow: És valaki megöli őket."
    },
    {
      "id": 110504454430728198,
      "target": "Widow: Remélem, azok a rohadékok megkapják, ami jár nekik."
    },
    {
      "id": 110504454430728197,
      "target": "Widow: Ez durva volt. De nem tudok nyugodtan beszélni róla."
    },
    {
      "id": 110504454430728196,
      "target": "Widow: Igen. Igen, értem."
    },
    {
      "id": 110504454430728194,
      "target": "Nem kell erről többet kérdeznem"
    },
    {
      "id": 110504454430728193,
      "target": "Szóval mi történt?"
    },
    {
      "id": 110504454430728192,
      "target": "Widow: De leginkább azt akarom, hogy égjenek el a napon azok, akiknek a hibájából… mindez megtörtént."
    },
    {
      "id": 110504454426533897,
      "target": "Widow: Minden éjjel megállíthatatlanul sírok."
    },
    {
      "id": 110504454426533896,
      "target": "Widow: Elnézést, én egyszerűen nem tudok…"
    },
    {
      "id": 110504454426533894,
      "target": "Nem én vagyok a felelős a haláláért"
    },
    {
      "id": 110504454426533893,
      "target": "Megértem. Bocsáss meg, ha megbántottalak"
    },
    {
      "id": 110504454426533892,
      "target": "Widow: Bazmeg, meghalt."
    },
    {
      "id": 110504454426533890,
      "target": "Szóval mi történt vele?"
    },
    {
      "id": 110504454426533889,
      "target": "Widow: Jó lenne egy kicsit pihenni…"
    }
  ]
}
