  "rows": [
    {
      "ordinal": 14769,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452329381894",
      "collection": "Dialogs",
      "key": "line:Bestson_Death_05ede5a",
      "source": "Bestson: Прости, мама…",
      "target": "Bestson: Bocsáss meg, anya…",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14770,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452329381893",
      "collection": "Dialogs",
      "key": "line:Bestson_Death_0a4ccf3",
      "source": "Bestson: Кажется, я всё испортил. Опять.",
      "target": "Bestson: Azt hiszem, mindent elrontottam. Megint.",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14771,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452329381892",
      "collection": "Dialogs",
      "key": "line:Bestson_Ears_DontShoot_0e129e3",
      "source": "Bestson: Как будто меня даже не существует.",
      "target": "Bestson: Mintha nem is léteznék.",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14772,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452329381891",
      "collection": "Dialogs",
      "key": "line:Bestson_Ears_DontShoot_0af09b0",
      "source": "Bestson: Время проходит мимо, и я себя ощущаю так…",
      "target": "Bestson: Az idő elsuhan mellettem, én meg úgy érzem magam, mintha…",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14773,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452329381890",
      "collection": "Dialogs",
      "key": "line:Bestson_Ears_DontShoot_0998fcf",
      "source": "Bestson: Но ничего.",
      "target": "Bestson: De semmi baj.",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14774,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452329381889",
      "collection": "Dialogs",
      "key": "line:Bestson_Ears_DontShoot_05ba5bb",
      "source": "Bestson: Что я услышу их голоса, шаги в коридоре…",
      "target": "Bestson: Hogy hallom majd a hangjukat, a lépteiket a folyosón…",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14775,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452329381888",
      "collection": "Dialogs",
      "key": "line:Bestson_Ears_DontShoot_0e7bed1",
      "source": "Bestson: Я долго ждал, что они постучат в дверь…",
      "target": "Bestson: Sokáig vártam, hogy bekopogjanak az ajtón…",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14776,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452325187594",
      "collection": "Dialogs",
      "key": "line:Bestson_Photo_DontShoot_0422606",
      "source": "Bestson: Может, я изменился, а они бы меня даже не узнали…",
      "target": "Bestson: Lehet, hogy megváltoztam, és fel sem ismernének…",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14777,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452325187593",
      "collection": "Dialogs",
      "key": "line:Bestson_Photo_DontShoot_07eb704",
      "source": "Bestson: Но если моя аура отличается от родительской… может, я уже не такой, каким был?",
      "target": "Bestson: De ha az aurám más, mint a szüleimé… lehet, hogy már nem az vagyok, aki régen voltam?",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14778,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452325187592",
      "collection": "Dialogs",
      "key": "line:Bestson_Photo_DontShoot_0929bf4",
      "source": "Bestson: Я не знаю, честно… Я никогда не видел таких вещей.",
      "target": "Bestson: Őszintén szólva nem tudom… Sosem láttam ilyesmit.",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14779,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452325187591",
      "collection": "Dialogs",
      "key": "line:Bestson_Photo_DontShoot_0b52978",
      "source": "Bestson: Аура правда что-то значит?",
      "target": "Bestson: Az aura tényleg jelent valamit?",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14780,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452325187590",
      "collection": "Dialogs",
      "key": "line:Bestson_Photo_DontShoot_047cfd0",
      "source": "Bestson: Начинаю чувствовать, как будто меня очень сильно сдавливают. Это вообще нормально?",
      "target": "Bestson: Kezdem úgy érezni, mintha nagyon erősen összenyomnának. Ez egyáltalán normális?",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14781,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452325187589",
      "collection": "Dialogs",
      "key": "line:Bestson_Photo_DontShoot_0aed892",
      "source": "Bestson: Мне не нравится это фото. Я не знаю, что с ним не так, но когда смотрю…",
      "target": "Bestson: Nem tetszik ez a kép. Nem tudom, mi a baj vele, de amikor ránézek…",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14782,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452325187588",
      "collection": "Dialogs",
      "key": "line:Bestson_Armpit_DontShoot_0336210",
      "source": "Bestson: Без них… мне просто всё равно.",
      "target": "Bestson: Nélkülük… egyszerűen már nem érdekel.",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14783,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452325187587",
      "collection": "Dialogs",
      "key": "line:Bestson_Armpit_DontShoot_019d1af",
      "source": "Bestson: Родители говорили, что я хороший, и мне этого хватало.",
      "target": "Bestson: A szüleim azt mondták, jó vagyok, és nekem ez elég volt.",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14784,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452325187586",
      "collection": "Dialogs",
      "key": "line:Bestson_Armpit_DontShoot_04ab037",
      "source": "Bestson: Я знаю, что многим это кажется странным, но… Меня просто никогда не беспокоило, как я выгляжу.",
      "target": "Bestson: Tudom, sokaknak ez furcsának tűnik, de… egyszerűen sosem zavart, hogy nézek ki.",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14785,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452325187585",
      "collection": "Dialogs",
      "key": "line:Bestson_Armpit_DontShoot_0aa8ca2",
      "source": "Bestson: Но если не сказали, значит, мне решать? А если я решу неправильно?..",
      "target": "Bestson: De ha nem mondták meg, akkor nekem kell döntenem? És ha rosszul döntök?..",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14786,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452325187584",
      "collection": "Dialogs",
      "key": "line:Bestson_Armpit_DontShoot_033f177",
      "source": "Bestson: А вот тут… Сейчас… Ничего об этом мне не говорили.",
      "target": "Bestson: És itt… Egy pillanat… Erről nem mondtak nekem semmit.",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14787,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452320993291",
      "collection": "Dialogs",
      "key": "line:Bestson_Armpit_DontShoot_0b6d9f7",
      "source": "Bestson: Если говорят, что надо умываться – значит, надо. Если говорят, что нельзя перебивать – значит, нельзя. Так ведь правильно?",
      "target": "Bestson: Ha azt mondják, mosakodni kell, akkor kell. Ha azt mondják, nem szabad félbeszakítani másokat, akkor nem szabad. Így helyes, ugye?",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14788,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452320993290",
      "collection": "Dialogs",
      "key": "line:Bestson_Armpit_DontShoot_005586b",
      "source": "Bestson: Я всегда верил, что, если делать всё, как учили, всё будет хорошо.",
      "target": "Bestson: Mindig hittem benne, hogy ha mindent úgy csinálok, ahogy tanították, akkor minden rendben lesz.",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14789,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452320993289",
      "collection": "Dialogs",
      "key": "line:Bestson_Eyes_DontShoot_0d2096f",
      "source": "Bestson: Просто… я не умею быть один.",
      "target": "Bestson: Csak… nem tudok egyedül lenni.",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14790,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452320993288",
      "collection": "Dialogs",
      "key": "line:Bestson_Eyes_DontShoot_0aff210",
      "source": "Bestson: Я не хочу плакать, правда…",
      "target": "Bestson: Nem akarok sírni, tényleg…",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14791,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452320993287",
      "collection": "Dialogs",
      "key": "line:Bestson_Eyes_DontShoot_085b420",
      "source": "Bestson: Как не плакать, когда ты один, когда никто не отвечает на звонки, когда родители просто исчезли?",
      "target": "Bestson: Hogy ne sírnék, amikor egyedül vagyok, senki sem veszi fel a telefont, és a szüleim egyszerűen eltűntek?",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14792,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452320993286",
      "collection": "Dialogs",
      "key": "line:Bestson_Eyes_DontShoot_0146cf8",
      "source": "Bestson: Нет, ты прав… Я много плакал.",
      "target": "Bestson: Nem, igazad van… Sokat sírtam.",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14793,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452320993285",
      "collection": "Dialogs",
      "key": "line:Bestson_Eyes_DontShoot_0880498",
      "source": "Bestson: А папа… папа выбирал один. Смотрел прямо, не отводя. Интересно, какой бы он выбрал сейчас?..",
      "target": "Bestson: Apa meg… apa mindig egy szemet választott. Egyenesen abba nézett, nem fordította el a tekintetét. Vajon most melyiket választaná?..",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14794,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452320993284",
      "collection": "Dialogs",
      "key": "line:Bestson_Eyes_DontShoot_0dd2089",
      "source": "Bestson: Мама, когда разговаривала со мной, то в один глаз смотрела, то в другой. Быстро-быстро! Туда-сюда!",
      "target": "Bestson: Anya, amikor beszélt velem, hol az egyik szemembe nézett, hol a másikba. Villámgyorsan! Ide-oda!",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14795,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452320993283",
      "collection": "Dialogs",
      "key": "line:Bestson_Hands_DontShoot_0dc58b8",
      "source": "Bestson: Ты ведь не осудишь меня за это?",
      "target": "Bestson: Ugye nem ítélsz el ezért?",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14796,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452320993282",
      "collection": "Dialogs",
      "key": "line:Bestson_Hands_DontShoot_0cbd302",
      "source": "Bestson: Иногда просто сжимаю кулаки, бью по стене. Всё лучше, чем просто сидеть.",
      "target": "Bestson: Néha csak ökölbe szorítom a kezem, és a falat verem. Még mindig jobb, mint csak ülni.",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14797,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452320993281",
      "collection": "Dialogs",
      "key": "line:Bestson_Hands_DontShoot_0024990",
      "source": "Bestson: Но когда я один, когда жду их возвращения, но никто так и не приходит… не знаю, что делать.",
      "target": "Bestson: De amikor egyedül vagyok, várom, hogy visszajöjjenek, és senki sem érkezik… nem tudom, mit tegyek.",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14798,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452320993280",
      "collection": "Dialogs",
      "key": "line:Bestson_Hands_DontShoot_0ab06b4",
      "source": "Bestson: Костяшки болят, когда я прикасаюсь к ним. Я знаю, что это неправильно.",
      "target": "Bestson: Fájnak az ujjperceim, ha hozzájuk érek. Tudom, hogy ez nem helyes.",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14799,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452316798986",
      "collection": "Dialogs",
      "key": "line:Bestson_Hands_DontShoot_065d52f",
      "source": "Bestson: Но я смотрю… и не понимаю... Не могу вспомнить, какими были их руки.",
      "target": "Bestson: De nézem őket… és nem értem… Nem tudom felidézni, milyen volt a kezük.",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14800,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452316798985",
      "collection": "Dialogs",
      "key": "line:Bestson_Hands_DontShoot_0d194f0",
      "source": "Bestson: А папа смеялся, что у меня его кулачища – крепкие, как у него в молодости.",
      "target": "Bestson: Apa nevetve mondta, hogy tőle örököltem ezeket a nagy öklöket – olyan erősek, mint az övéi fiatalon.",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14801,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452316798984",
      "collection": "Dialogs",
      "key": "line:Bestson_Hands_DontShoot_0763e4d",
      "source": "Bestson: Иногда я смотрю на них и думаю… а ведь мама говорила, что у меня её пальцы. Длинные, аккуратные.",
      "target": "Bestson: Néha rájuk nézek, és arra gondolok… anya azt mondta, tőle vannak az ujjaim. Hosszúak és finomak.",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14802,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452316798983",
      "collection": "Dialogs",
      "key": "line:Bestson_Teeth_DontShoot_0833542",
      "source": "Bestson: А я так и остался… таким.",
      "target": "Bestson: Én meg ilyen… ilyen maradtam.",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14803,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452316798982",
      "collection": "Dialogs",
      "key": "line:Bestson_Teeth_DontShoot_0187c54",
      "source": "Bestson: Но их нет.",
      "target": "Bestson: De ők nincsenek itt.",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14804,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452316798981",
      "collection": "Dialogs",
      "key": "line:Bestson_Teeth_DontShoot_0bee8f5",
      "source": "Bestson: Они напомнили бы мне, заставили бы… Не дали бы мне так запустить себя…",
      "target": "Bestson: Emlékeztettek volna, rávettek volna… Nem hagyták volna, hogy így elhanyagoljam magam…",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14805,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452316798980",
      "collection": "Dialogs",
      "key": "line:Bestson_Teeth_DontShoot_0b0f5a1",
      "source": "Bestson: Может, если бы родители были рядом, всё было бы по-другому?",
      "target": "Bestson: Lehet, hogy ha a szüleim mellettem lennének, minden másképp alakult volna?",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14806,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452316798979",
      "collection": "Dialogs",
      "key": "line:Bestson_Teeth_DontShoot_04e0a97",
      "source": "Bestson: Поэтому у неё зубы испортились после меня, а у меня, наоборот, они стали вот такими вот хорошенькими! Только эти дёсны…",
      "target": "Bestson: Ezért romlottak el anya fogai, miután megszülettem, az enyémek pedig épp ellenkezőleg, ilyen szépek lettek! Csak ez az ínyem…",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14807,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452316798978",
      "collection": "Dialogs",
      "key": "line:Bestson_Teeth_DontShoot_077d7a2",
      "source": "Bestson: Мама даже шутила, что я, пока она меня кормила грудью, весь её кальций высосал.",
      "target": "Bestson: Anya még viccelődött is, hogy amikor szoptatott, az összes kalciumot kiszívtam belőle.",
      "authoredFile": "Translations/hu/dialogue-batch-438.json",
      "reviewResult": "pass"
    },
