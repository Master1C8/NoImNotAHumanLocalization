      "target": "Bestson: Szerintem minden rendben… Bár… mostanában kicsit csípnek, de biztos csak… por… vagy allergia…",
      "authoredFile": "Translations/hu/dialogue-batch-439.json",
      "reviewResult": "pass"
    },
