      "collection": "Dialogs",
      "key": "line:Alkonost_Ears_Gun_01ac422",
      "source": "Alkonost: Как ты определил, что я Гость?",
      "target": "Alkonost: Miből állapítottad meg, hogy Vendég vagyok?",
      "authoredFile": "Translations/hu/dialogue-batch-405.json",
