      "collection": "Dialogs",
      "key": "line:Alkonost_Ears_Gun_0239831",
      "source": "Alkonost: Что именно вызвало у тебя опасения, твою мать?",
      "target": "Alkonost: Mi a franc keltett benned gyanút?",
      "authoredFile": "Translations/hu/dialogue-batch-405.json",
