  "rows": [
    {
      "ordinal": 11686,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453889662980",
      "collection": "Dialogs",
      "key": "line:Experienced_Death_00f458a",
      "source": "Experienced: Редиска паршивая!",
      "target": "Experienced: Rohadt retek!",
      "authoredFile": "Translations/hu/dialogue-batch-362.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11687,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453889662979",
      "collection": "Dialogs",
      "key": "line:Experienced_Death_05b5a72",
      "source": "Experienced: Ну ты и сука тупая. Я думал, ты нормальный мужик. А ты…",
      "target": "Experienced: Te ostoba rohadék. Azt hittem, rendes fickó vagy. Erre te…",
      "authoredFile": "Translations/hu/dialogue-batch-362.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11688,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453889662978",
      "collection": "Dialogs",
      "key": "line:Experienced_Ears_DontShoot_04edde3",
      "source": "Experienced: Я на секунду подумал, что ты и взаправду застрелишь меня из-за туфты, о которой даже в телике не говорили.",
      "target": "Experienced: Egy pillanatra azt hittem, tényleg lelősz valami baromság miatt, amiről még a tévében sem beszéltek.",
      "authoredFile": "Translations/hu/dialogue-batch-362.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11689,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453889662977",
      "collection": "Dialogs",
      "key": "line:Experienced_Ears_DontShoot_0d4d6fa",
      "source": "Experienced: Надо же, одумался.",
      "target": "Experienced: Nahát, mégis észhez tértél.",
      "authoredFile": "Translations/hu/dialogue-batch-362.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11690,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453889662976",
      "collection": "Dialogs",
      "key": "line:Experienced_Photo_DontShoot_08e13dc",
      "source": "Experienced: Меня даже вертухаи так не кошмарили, как ты…",
      "target": "Experienced: Még a smasszerek sem szívattak így, mint te…",
      "authoredFile": "Translations/hu/dialogue-batch-362.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11691,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453885468682",
      "collection": "Dialogs",
      "key": "line:Experienced_Photo_DontShoot_01da939",
      "source": "Experienced: Ты совсем, что ли, из ума вышел, фраер? За простую фотку убить хотел?",
      "target": "Experienced: Teljesen elment az eszed, öcskös? Egy nyavalyás fénykép miatt akartál kinyírni?",
      "authoredFile": "Translations/hu/dialogue-batch-362.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11692,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453885468681",
      "collection": "Dialogs",
      "key": "line:Experienced_Armpit_DontShoot_015432c",
      "source": "Experienced: Чё их переводить понапрасну.",
      "target": "Experienced: Minek pazarolnád el őket hiába?",
      "authoredFile": "Translations/hu/dialogue-batch-362.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11693,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453885468680",
      "collection": "Dialogs",
      "key": "line:Experienced_Armpit_DontShoot_057681b",
      "source": "Experienced: Поверь, я правильной масти. Зуб даю!",
      "target": "Experienced: Hidd el, a jó fajtából való vagyok. Esküszöm!",
      "authoredFile": "Translations/hu/dialogue-batch-362.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11694,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453885468679",
      "collection": "Dialogs",
      "key": "line:Experienced_Armpit_DontShoot_082ee13",
      "source": "Experienced: Ты лучше, фраер, прибереги бананчики… То есть патроны свои.",
      "target": "Experienced: Inkább tartalékold a banánjaidat, öcskös… Mármint a töltényeidet.",
      "authoredFile": "Translations/hu/dialogue-batch-362.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11695,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453885468678",
      "collection": "Dialogs",
      "key": "line:Experienced_Eyes_DontShoot_00e42dc",
      "source": "Experienced: Ты же не бугор отряда на зоне, чтобы всю дурь вышибать из пришедших?",
      "target": "Experienced: Nem vagy te körletparancsnok a sitten, hogy minden érkezőből kiverd a szart.",
      "authoredFile": "Translations/hu/dialogue-batch-362.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11696,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453885468677",
      "collection": "Dialogs",
      "key": "line:Experienced_Eyes_DontShoot_06886f7",
      "source": "Experienced: Хата-то твоя, базару ноль. Но ты порядки такие лютые не делай.",
      "target": "Experienced: A ház a tiéd, ezt nem vitatom. De ne vezess be ilyen kibaszott szigorú szabályokat.",
      "authoredFile": "Translations/hu/dialogue-batch-362.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11697,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453885468676",
      "collection": "Dialogs",
      "key": "line:Experienced_Hands_DontShoot_080b653",
      "source": "Experienced: Мне хватило вертухаев на одной из ходок.",
      "target": "Experienced: Elég volt a smasszerekből az egyik börtönbüntetésem alatt.",
      "authoredFile": "Translations/hu/dialogue-batch-362.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11698,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453885468675",
      "collection": "Dialogs",
      "key": "line:Experienced_Hands_DontShoot_04b185d",
      "source": "Experienced: Всё-таки не надо чуть что брать на мушку, лады, фраер?",
      "target": "Experienced: Azért ne fogj rám fegyvert minden apróságért, rendben, öcskös?",
      "authoredFile": "Translations/hu/dialogue-batch-362.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11699,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453885468674",
      "collection": "Dialogs",
      "key": "line:Experienced_Hands_DontShoot_09171b8",
      "source": "Experienced: Я знал, конечно, что ты мужик беспардонный, но…",
      "target": "Experienced: Tudtam, hogy tapintatlan fickó vagy, de…",
      "authoredFile": "Translations/hu/dialogue-batch-362.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11700,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453885468673",
      "collection": "Dialogs",
      "key": "line:Experienced_Teeth_DontShoot_0125ea1",
      "source": "Experienced: Глядишь, палец дёрнется, и всё — кабзда.",
      "target": "Experienced: Még a végén megrándul az ujjad, és kész, annyi.",
      "authoredFile": "Translations/hu/dialogue-batch-362.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11701,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453885468672",
      "collection": "Dialogs",
      "key": "line:Experienced_Teeth_DontShoot_06dea16",
      "source": "Experienced: Вот и правильно — нечего доставать чуть что ствол.",
      "target": "Experienced: Így van, nem kell minden apróságért előkapni a fegyvert.",
      "authoredFile": "Translations/hu/dialogue-batch-362.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11702,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453881274379",
      "collection": "Dialogs",
      "key": "line:Experienced_Ears_Gun_0c634b2",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11703,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453881274378",
      "collection": "Dialogs",
      "key": "line:Experienced_Ears_Gun_039e3c8",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11704,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453881274377",
      "collection": "Dialogs",
      "key": "line:Experienced_Ears_Gun_0d97090",
      "source": "Experienced: Ладно ещё зубы там, или грязь, но про уши вообще нигде не говорили.",
      "target": "Experienced: Még a fogak vagy a piszok hagyján, de a fülekről sehol sem beszéltek.",
      "authoredFile": "Translations/hu/dialogue-batch-362.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11705,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453881274376",
      "collection": "Dialogs",
      "key": "line:Experienced_Ears_Gun_067542c",
      "source": "Experienced: Фраер, ты серьёзно? Это уже лютый перебор.",
      "target": "Experienced: Öcskös, ezt komolyan gondolod? Ez már durva túlzás.",
      "authoredFile": "Translations/hu/dialogue-batch-362.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11706,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453881274375",
      "collection": "Dialogs",
      "key": "line:Experienced_Photo_Gun_05bdfff",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11707,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453881274374",
      "collection": "Dialogs",
      "key": "line:Experienced_Photo_Gun_0543855",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11708,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453881274373",
      "collection": "Dialogs",
      "key": "line:Experienced_Photo_Gun_0b93be7",
      "source": "Experienced: Я ж просто грабил, да и отсидел уже своё — вышел недавно.",
      "target": "Experienced: Én csak raboltam, le is ültem érte a magamét. Nemrég szabadultam.",
      "authoredFile": "Translations/hu/dialogue-batch-362.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11709,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453881274372",
      "collection": "Dialogs",
      "key": "line:Experienced_Photo_Gun_0874a9b",
      "source": "Experienced: Фраер, ты меня попутал с кем из розыска?",
      "target": "Experienced: Öcskös, összekevertél valami körözött fickóval?",
      "authoredFile": "Translations/hu/dialogue-batch-362.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11710,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453881274371",
      "collection": "Dialogs",
      "key": "line:Experienced_Armpit_Gun_000d6b8",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11711,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453881274370",
      "collection": "Dialogs",
      "key": "line:Experienced_Armpit_Gun_0c5996f",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11712,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453881274369",
      "collection": "Dialogs",
      "key": "line:Experienced_Armpit_Gun_07772d6",
      "source": "Experienced: Но зачем так? Нормально же базарили.",
      "target": "Experienced: De minek ez? Olyan jól elbeszélgettünk.",
      "authoredFile": "Translations/hu/dialogue-batch-362.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11713,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453881274368",
      "collection": "Dialogs",
      "key": "line:Experienced_Armpit_Gun_0e35fbd",
      "source": "Experienced: Я, конечно, понимаю, что зрелище не из приятных — подмышки мои увидеть…",
      "target": "Experienced: Értem én, hogy a hónaljam látványa nem valami kellemes…",
      "authoredFile": "Translations/hu/dialogue-batch-362.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11714,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453877080075",
      "collection": "Dialogs",
      "key": "line:Experienced_Eyes_Gun_023cb73",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11715,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453877080074",
      "collection": "Dialogs",
      "key": "line:Experienced_Eyes_Gun_0b51e1c",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11716,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453877080073",
      "collection": "Dialogs",
      "key": "line:Experienced_Eyes_Gun_00d565c",
      "source": "Experienced: Сам попробуй — тёмные очки не помогут избежать солнечного света.",
      "target": "Experienced: Próbáld ki te is: a sötét szemüveg sem véd meg a napfénytől.",
      "authoredFile": "Translations/hu/dialogue-batch-362.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11717,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453877080072",
      "collection": "Dialogs",
      "key": "line:Experienced_Eyes_Gun_09d258c",
      "source": "Experienced: Ты меня что, за кидалу считаешь? Я тебе отвечаю!",
      "target": "Experienced: Valami szélhámosnak nézel? Kezeskedem érte!",
      "authoredFile": "Translations/hu/dialogue-batch-362.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11718,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453877080071",
      "collection": "Dialogs",
      "key": "line:Experienced_Hands_Gun_0f0badb",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11719,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453877080070",
      "collection": "Dialogs",
      "key": "line:Experienced_Hands_Gun_03997e6",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11720,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453877080069",
      "collection": "Dialogs",
      "key": "line:Experienced_Hands_Gun_0b7d180",
      "source": "Experienced: Фраер, с хера ли ты волыну достал? Убери её.",
      "target": "Experienced: Öcskös, mi a faszért kaptad elő a puskát? Tedd el.",
      "authoredFile": "Translations/hu/dialogue-batch-362.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11721,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453877080068",
      "collection": "Dialogs",
      "key": "line:Experienced_Teeth_Gun_03ac53e",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11722,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453877080067",
      "collection": "Dialogs",
      "key": "line:Experienced_Teeth_Gun_0382bb1",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11723,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453877080066",
      "collection": "Dialogs",
      "key": "line:Experienced_Teeth_Gun_04b0389",
      "source": "Experienced: Или ты за кровь на дёснах решил меня вальнуть?",
      "target": "Experienced: Vagy az ínyemen lévő vér miatt akarsz kinyírni?",
      "authoredFile": "Translations/hu/dialogue-batch-362.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11724,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453877080065",
      "collection": "Dialogs",
      "key": "line:Experienced_Teeth_Gun_0ebc8b4",
      "source": "Experienced: Зубы же жёлтые, чё ты волыну достал?",
      "target": "Experienced: Hiszen sárgák a fogaim. Minek kaptad elő a puskát?",
      "authoredFile": "Translations/hu/dialogue-batch-362.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11725,
