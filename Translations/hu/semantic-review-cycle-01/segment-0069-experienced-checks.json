      "collection": "Dialogs",
      "key": "line:Experienced_Eyes_09755f0",
      "source": "Experienced: Ну, как видишь, они сделали только хуже.",
      "target": "Experienced: Hát látod, csak rontottak a helyzeten.",
      "authoredFile": "Translations/hu/dialogue-batch-363.json",
