      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454153904136",
      "collection": "Dialogs",
      "key": "line:Tourist_Armpit_Gun_0cd492b",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
