      "collection": "Dialogs",
      "key": "line:Tourist_Armpit_Gun_0b329a0",
      "source": "Tourist: Вы что, хотите сказать, что раздражение на коже — это симптом?",
      "target": "Tourist: Azt akarja mondani, hogy a bőrirritáció tünet?",
      "authoredFile": "Translations/hu/dialogue-batch-344.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10945,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454153904134",
