      "collection": "Dialogs",
      "key": "line:Tourist_Hands_Gun_0a78276",
      "source": "Tourist: Загар что — признак заражения?",
      "target": "Tourist: A napbarnulás a fertőzés jele lenne?",
      "authoredFile": "Translations/hu/dialogue-batch-344.json",
      "reviewResult": "pass"
    },
    {
