      "collection": "Dialogs",
      "key": "line:Tourist_Eyes_Gun_07510bb",
      "source": "Tourist: У меня же абсолютно нормальные глаза.",
      "target": "Tourist: Teljesen normális a szemem.",
      "authoredFile": "Translations/hu/dialogue-batch-344.json",
