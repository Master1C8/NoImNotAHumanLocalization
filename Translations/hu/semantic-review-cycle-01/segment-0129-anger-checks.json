  "rows": [
    {
      "ordinal": 16034,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451851231239",
      "collection": "Dialogs",
      "key": "line:Anger_Ears_DontShoot_005829b",
      "source": "Anger: Верно???",
      "target": "Anger: Ugye???",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16035,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451851231238",
      "collection": "Dialogs",
      "key": "line:Anger_Ears_DontShoot_00e2df5",
      "source": "Anger: …",
      "target": "Anger: …",
      "authoredFile": "Translations/hu/dialogue-batch-040.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16036,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451851231237",
      "collection": "Dialogs",
      "key": "line:Anger_Ears_DontShoot_04d598b",
      "source": "Anger: Но я же не долбанутый, чтобы себя резать, верно?",
      "target": "Anger: De azért nem vagyok olyan elcseszett, hogy megvágjam magam, ugye?",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16037,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451851231236",
      "collection": "Dialogs",
      "key": "line:Anger_Ears_DontShoot_002a716",
      "source": "Anger: А потом понял, что я просто хочу оторвать эту часть себя, будто она мне мешает.",
      "target": "Anger: Aztán rájöttem, hogy csak le akarom tépni magamról ezt a részt, mintha útban lenne.",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16038,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451851231235",
      "collection": "Dialogs",
      "key": "line:Anger_Ears_DontShoot_0a8f53c",
      "source": "Anger: Раньше думал, что это нервная херня.",
      "target": "Anger: Régebben azt hittem, valami ideges szarság.",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16039,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451851231234",
      "collection": "Dialogs",
      "key": "line:Anger_Ears_DontShoot_0298079",
      "source": "Anger: Бывает, замечаю, что дёргаю мочку уха, но только когда она уже горит как пиздец.",
      "target": "Anger: Néha észreveszem, hogy rángatom a fülcimpámat, de csak akkor, amikor már kurvára ég.",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16040,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451851231233",
      "collection": "Dialogs",
      "key": "line:Anger_Photo_DontShoot_0d1b77b",
      "source": "Anger: Ну и вот, блять. Нет ни фотки, ни бабки.",
      "target": "Anger: És most tessék, bazdmeg. Se fénykép, se nagyanyám.",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16041,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451851231232",
      "collection": "Dialogs",
      "key": "line:Anger_Photo_DontShoot_03e8015",
      "source": "Anger: А она мне: «Вот когда помру, ты посмотришь на мою фотокарточку и подумаешь, на небесах ли я».",
      "target": "Anger: Erre ő: „Ha majd meghalok, ránézel a fényképemre, és azon gondolkodsz, vajon a mennyben vagyok-e.”",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16042,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451847036936",
      "collection": "Dialogs",
      "key": "line:Anger_Photo_DontShoot_0590dc4",
      "source": "Anger: Я тогда ржал, говорил ей: «Ну бабуль, ну хуйня же это».",
      "target": "Anger: Akkor csak röhögtem, azt mondtam neki: „Jaj, nagyi, mekkora baromság ez.”",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16043,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451847036935",
      "collection": "Dialogs",
      "key": "line:Anger_Photo_DontShoot_0498dbc",
      "source": "Anger: Говорила, что если сфоткают – душу в фотокарточке запечатают, и она уже не выберется.",
      "target": "Anger: Azt mondta, hogy ha lefényképezik, a lelke beleragad a képbe, és többé nem tud kiszabadulni.",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16044,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451847036934",
      "collection": "Dialogs",
      "key": "line:Anger_Photo_DontShoot_0dcc2f6",
      "source": "Anger: У меня даже фото бабушки не сохранилось. Она не любила эту херню.",
      "target": "Anger: Még egy fényképem sem maradt a nagyanyámról. Utálta ezt a szarságot.",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16045,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451847036933",
      "collection": "Dialogs",
      "key": "line:Anger_Armpit_DontShoot_0a54bb4",
      "source": "Anger: Но бреюсь всё равно. Потому что ненавижу, блять, этот кустарник.",
      "target": "Anger: De azért továbbra is borotválkozom. Mert kurvára gyűlölöm ezt a bozótot.",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16046,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451847036932",
      "collection": "Dialogs",
      "key": "line:Anger_Armpit_DontShoot_07a49df",
      "source": "Anger: Но в итоге только руку себе поцарапал. Теперь, когда бреюсь, кажется, будто нож режет не волосы, а меня самого.",
      "target": "Anger: De végül csak összekarcoltam a kezem. Most, amikor borotválkozom, olyan, mintha a penge nem a szőrt, hanem engem vágna.",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16047,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451847036931",
      "collection": "Dialogs",
      "key": "line:Anger_Armpit_DontShoot_0d1ae94",
      "source": "Anger: Знаешь, бритвы достаточно острые, чтобы… что-то сделать. Если бы это было так просто…",
      "target": "Anger: Tudod, a borotvapenge elég éles ahhoz, hogy… valamit csináljak vele. Ha ilyen egyszerű lenne…",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16048,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451847036930",
      "collection": "Dialogs",
      "key": "line:Anger_Eyes_DontShoot_08fbc15",
      "source": "Anger: Я так и вижу, как она на меня смотрит. И разочаровывается.",
      "target": "Anger: Magam előtt látom, ahogy rám néz. És csalódik bennem.",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16049,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451847036929",
      "collection": "Dialogs",
      "key": "line:Anger_Eyes_DontShoot_0257476",
      "source": "Anger: И вот теперь я стою, гляжу в эти зеркала души и думаю: ну какой из меня, нахуй, ангел?",
      "target": "Anger: Most meg itt állok, belenézek a lélek e tükreibe, és arra gondolok: milyen kibaszott angyal lennék én?",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16050,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451847036928",
      "collection": "Dialogs",
      "key": "line:Anger_Eyes_DontShoot_0eca704",
      "source": "Anger: Меня бабушка называла «ангельским дитём» из-за цвета глаз. Ага, ангел, блять.",
      "target": "Anger: A szemem színe miatt a nagyanyám „angyali gyereknek” hívott. Hát persze, bazdmeg, angyal.",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16051,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451842842634",
      "collection": "Dialogs",
      "key": "line:Anger_Hands_DontShoot_0b89c05",
      "source": "Anger: Наверное, если б я был другим человеком, мне бы стало страшно от того, что я с собой делаю. Но мне похую.",
      "target": "Anger: Talán ha más ember lennék, megrémítene, amit magammal művelek. De leszarom.",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16052,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451842842633",
      "collection": "Dialogs",
      "key": "line:Anger_Hands_DontShoot_08a6ac7",
      "source": "Anger: Руки иногда чешутся так, будто хочется разодрать всю кожу. Или уебать в стену. Или и то, и другое сразу.",
      "target": "Anger: Néha úgy viszket a kezem, hogy legszívesebben az egész bőrömet letépném. Vagy belebasznék a falba. Vagy mindkettőt egyszerre.",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16053,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451842842632",
      "collection": "Dialogs",
      "key": "line:Anger_Hands_DontShoot_035e8d1",
      "source": "Anger: Видишь ногти? Грязь, кровь — всё что хочешь. Но это не чужая. Своя.",
      "target": "Anger: Látod a körmömet? Kosz, vér, amit csak akarsz. De ez nem másé. Az enyém.",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16054,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451842842631",
      "collection": "Dialogs",
      "key": "line:Anger_Hands_DontShoot_03ea0af",
      "source": "Anger: Сдержаться у меня не получается. А других бить не хочу.",
      "target": "Anger: Nem tudom visszafogni magam. Másokat meg nem akarok megütni.",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16055,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451842842630",
      "collection": "Dialogs",
      "key": "line:Anger_Hands_DontShoot_0ddbbfa",
      "source": "Anger: Руки иногда чешутся так, будто хочется разодрать всю кожу. Или уебать в стену. Или и то, и другое сразу.",
      "target": "Anger: Néha úgy viszket a kezem, hogy legszívesebben az egész bőrömet letépném. Vagy belebasznék a falba. Vagy mindkettőt egyszerre.",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16056,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451842842629",
      "collection": "Dialogs",
      "key": "line:Anger_Hands_DontShoot_0417777",
      "source": "Anger: Видишь руки? Грязь, кровь — всё что хочешь. Но это не чужая. Своя.",
      "target": "Anger: Látod a kezemet? Kosz, vér, amit csak akarsz. De ez nem másé. Az enyém.",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16057,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451842842628",
      "collection": "Dialogs",
      "key": "line:Anger_Teeth_DontShoot_0ef93d6",
      "source": "Anger: И вот теперь у меня не солнце во рту, а просто обоссанные жёлтые зубы.",
      "target": "Anger: Most meg már nem nap van a számban, csak húgysárga fogak.",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16058,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451842842627",
      "collection": "Dialogs",
      "key": "line:Anger_Teeth_DontShoot_076da75",
      "source": "Anger: А потом… Ну, время-то пришло. Только никто мне ничего не поставил.",
      "target": "Anger: Aztán… hát eljött az ideje. Csak nekem senki sem tett be semmit.",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16059,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451842842626",
      "collection": "Dialogs",
      "key": "line:Anger_Teeth_DontShoot_0d7f53f",
      "source": "Anger: Я тогда даже радовался, думал: «Ну и круто, мне тоже такой сделают, когда время придёт».",
      "target": "Anger: Akkor még örültem is, azt gondoltam: „De király, nekem is csinálnak majd ilyet, ha eljön az ideje.”",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16060,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451842842625",
      "collection": "Dialogs",
      "key": "line:Anger_Teeth_DontShoot_05ff1f4",
      "source": "Anger: Бабушка говорила, что его поставили, когда старый сгнил.",
      "target": "Anger: A nagyanyám azt mondta, akkor kapta, amikor a régi foga elrohadt.",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16061,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451842842624",
      "collection": "Dialogs",
      "key": "line:Anger_Teeth_DontShoot_01aa845",
      "source": "Anger: Он блестел так, будто у неё во рту солнце застряло.",
      "target": "Anger: Úgy csillogott, mintha a nap a szájában ragadt volna.",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16062,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451838648329",
      "collection": "Dialogs",
      "key": "line:Anger_Teeth_DontShoot_0ee33c2",
      "source": "Anger: У моей бабушки был золотой зуб. Я ещё пацаном был, когда понял, что мне хочется такой же.",
      "target": "Anger: A nagyanyámnak volt egy aranyfoga. Még kölyök voltam, amikor rájöttem, hogy én is akarok egyet.",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16063,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451838648328",
      "collection": "Dialogs",
      "key": "line:Anger_Death_0c8784c",
      "source": "Anger: Ну и катись нахуй.",
      "target": "Anger: Akkor húzz a picsába.",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16064,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451838648327",
      "collection": "Dialogs",
      "key": "line:Anger_Death_0736f19",
      "source": "Anger: А ты, блять, вообще мудак бесчувственный.",
      "target": "Anger: Te meg, bazdmeg, egy érzéketlen seggfej vagy.",
      "authoredFile": "Translations/hu/dialogue-batch-465.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16065,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451838648326",
      "collection": "Dialogs",
      "key": "line:Anger_Ears_Gun_0bd1794",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16066,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451838648325",
      "collection": "Dialogs",
      "key": "line:Anger_Ears_Gun_0e62b5d",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16067,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451838648324",
      "collection": "Dialogs",
      "key": "line:Anger_Ears_Gun_0860814",
      "source": "Anger: Да ты, блять, больной на всю голову. А ну иди сюда, сука!",
      "target": "Anger: Te aztán kurvára beteg vagy agyilag. Gyere csak ide, te szemét!",
      "authoredFile": "Translations/hu/dialogue-batch-466.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16068,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451838648323",
      "collection": "Dialogs",
      "key": "line:Anger_Ears_Gun_00cc9d0",
      "source": "Anger: Ещё из-за ушей меня случайно застрелишь.",
      "target": "Anger: Még a fülem miatt is véletlenül lelősz.",
      "authoredFile": "Translations/hu/dialogue-batch-466.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16069,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451838648322",
      "collection": "Dialogs",
      "key": "line:Anger_Ears_Gun_099ea32",
      "source": "Anger: Ты осторожнее своей бум-палкой маши.",
      "target": "Anger: Óvatosabban hadonássz azzal a durranóbotoddal.",
      "authoredFile": "Translations/hu/dialogue-batch-466.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16070,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451838648321",
      "collection": "Dialogs",
      "key": "line:Anger_Photo_Gun_037de59",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16071,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451838648320",
      "collection": "Dialogs",
      "key": "line:Anger_Photo_Gun_0b6bae1",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16072,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451834454025",
      "collection": "Dialogs",
      "key": "line:Anger_Photo_Gun_07b678c",
      "source": "Anger: Ты, сука, хочешь в меня выстрелить из-за ёбаной фотки?",
      "target": "Anger: Te rohadék, egy kibaszott fénykép miatt akarsz rám lőni?",
      "authoredFile": "Translations/hu/dialogue-batch-466.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16073,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451834454024",
      "collection": "Dialogs",
      "key": "line:Anger_Armpit_Gun_0fbd3fb",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16074,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451834454023",
      "collection": "Dialogs",
      "key": "line:Anger_Armpit_Gun_0552a70",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16075,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451834454022",
      "collection": "Dialogs",
      "key": "line:Anger_Armpit_Gun_094b8a5",
      "source": "Anger: Поверить не могу. Да ты просто ебанутый!..",
      "target": "Anger: Nem hiszem el. Teljesen elment az eszed!..",
      "authoredFile": "Translations/hu/dialogue-batch-466.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16076,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451834454021",
      "collection": "Dialogs",
      "key": "line:Anger_Armpit_Gun_05f5608",
      "source": "Anger: Когда расчёсываю до крови – зуд успокаивается.",
      "target": "Anger: Ha véresre vakarom, elmúlik a viszketés.",
      "authoredFile": "Translations/hu/dialogue-batch-466.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16077,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451834454020",
      "collection": "Dialogs",
      "key": "line:Anger_Armpit_Gun_09cc3db",
      "source": "Anger: Оно чешется постоянно, будто провоцирует на что-то.",
      "target": "Anger: Állandóan viszket, mintha valamire ösztökélne.",
      "authoredFile": "Translations/hu/dialogue-batch-466.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16078,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451834454019",
      "collection": "Dialogs",
      "key": "line:Anger_Eyes_Gun_0ea053d",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16079,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451834454018",
      "collection": "Dialogs",
      "key": "line:Anger_Eyes_Gun_0a59473",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16080,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451834454017",
      "collection": "Dialogs",
      "key": "line:Anger_Eyes_Gun_0617781",
      "source": "Anger: Ты на что, блять, намекаешь? Завидуешь, что ли?",
      "target": "Anger: Mire célzol, bazdmeg? Irigy vagy, vagy mi?",
      "authoredFile": "Translations/hu/dialogue-batch-466.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16081,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451834454016",
      "collection": "Dialogs",
      "key": "line:Anger_Hands_Gun_0e1531f",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16082,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451830259720",
      "collection": "Dialogs",
      "key": "line:Anger_Hands_Gun_0473ab3",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16083,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451830259719",
      "collection": "Dialogs",
      "key": "line:Anger_Hands_Gun_0144646",
      "source": "Anger: Ты, сука, что, думаешь, я с такой лапой не смогу тебе в еблет прописать быстрее, чем ты нажмёшь на курок?",
      "target": "Anger: Azt hiszed, te szemét, hogy ekkora manccsal nem tudlak pofán vágni, mielőtt meghúznád a ravaszt?",
      "authoredFile": "Translations/hu/dialogue-batch-466.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16084,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451830259718",
      "collection": "Dialogs",
      "key": "line:Anger_Teeth_Gun_02bb325",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16085,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451830259717",
      "collection": "Dialogs",
      "key": "line:Anger_Teeth_Gun_0a5c4fe",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16086,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451830259716",
      "collection": "Dialogs",
      "key": "line:Anger_Teeth_Gun_09d62b8",
      "source": "Anger: Ты что, ёбнулся? Я тебе просто зубы показал.",
      "target": "Anger: Megőrültél? Csak megmutattam a fogaimat.",
      "authoredFile": "Translations/hu/dialogue-batch-466.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16087,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451830259715",
      "collection": "Dialogs",
      "key": "line:Anger_Ears_0b5083b",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16088,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451830259714",
      "collection": "Dialogs",
      "key": "line:Anger_Ears_0a1e883",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16089,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451830259713",
      "collection": "Dialogs",
      "key": "line:Anger_Ears_0047c92",
      "source": "Anger: Чего ты так уставился? Чего-то не хватает?",
      "target": "Anger: Mit bámulsz ennyire? Hiányzik valami?",
      "authoredFile": "Translations/hu/dialogue-batch-466.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16090,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451830259712",
      "collection": "Dialogs",
      "key": "line:Anger_Ears_06e1895",
      "source": "Anger: Блять…",
      "target": "Anger: Bazdmeg…",
      "authoredFile": "Translations/hu/dialogue-batch-466.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16091,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451826065417",
      "collection": "Dialogs",
      "key": "line:Anger_Photo_0638455",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16092,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451826065416",
      "collection": "Dialogs",
      "key": "line:Anger_Photo_0adcd6c",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16093,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451826065415",
      "collection": "Dialogs",
      "key": "line:Anger_Photo_0dfede7",
      "source": "Anger: Чё? Ты чё на меня так уставился? Чё ты там увидел?",
      "target": "Anger: Mi van? Mit bámulsz így? Mit láttál ott?",
      "authoredFile": "Translations/hu/dialogue-batch-466.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16094,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451826065414",
      "collection": "Dialogs",
      "key": "line:Anger_Photo_0566de4",
      "source": "Anger: Херачь.",
      "target": "Anger: Lőj már.",
      "authoredFile": "Translations/hu/dialogue-batch-466.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16095,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451826065413",
      "collection": "Dialogs",
      "key": "line:Anger_Armpit_0c83441",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16096,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451826065412",
      "collection": "Dialogs",
      "key": "line:Anger_Armpit_064e394",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16097,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451826065411",
      "collection": "Dialogs",
      "key": "line:Anger_Armpit_033d7d9",
      "source": "Anger: Меня бесит, когда волосню под мышками оставляют, как будто ебучий кустарник там растить собрались.",
      "target": "Anger: Felbasz, amikor valaki meghagyja a hónaljszőrét, mintha egy kibaszott bozótot akarna ott növeszteni.",
      "authoredFile": "Translations/hu/dialogue-batch-466.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16098,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451826065410",
      "collection": "Dialogs",
      "key": "line:Anger_Armpit_09a3b41",
      "source": "Anger: Да, брею.",
      "target": "Anger: Igen, borotválom.",
      "authoredFile": "Translations/hu/dialogue-batch-466.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16099,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451826065409",
      "collection": "Dialogs",
      "key": "line:Anger_Armpit_0f83332",
      "source": "Anger: Вообще похуй.",
      "target": "Anger: Teljesen leszarom.",
      "authoredFile": "Translations/hu/dialogue-batch-466.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16100,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451826065408",
      "collection": "Dialogs",
      "key": "line:Anger_Eyes_0f2edff",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16101,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451821871114",
      "collection": "Dialogs",
      "key": "line:Anger_Eyes_0641e97",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16102,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451821871113",
      "collection": "Dialogs",
      "key": "line:Anger_Eyes_08a485b",
      "source": "Anger: Что, цвет нравится? Голубые. Всегда такие были. Мне кроме них ничего и не надо было, чтобы девчонку склеить.",
      "target": "Anger: Mi van, tetszik a színe? Kék. Mindig ilyen volt. Több nem is kellett ahhoz, hogy felszedjek egy csajt.",
      "authoredFile": "Translations/hu/dialogue-batch-466.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16103,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451821871112",
      "collection": "Dialogs",
      "key": "line:Anger_Eyes_070bb2c",
      "source": "Anger: Твои дела, но мне плевать.",
      "target": "Anger: A te dolgod, de nekem mindegy.",
      "authoredFile": "Translations/hu/dialogue-batch-466.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16104,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451821871111",
      "collection": "Dialogs",
      "key": "line:Anger_Hands_0e5fdc2",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16105,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451821871110",
      "collection": "Dialogs",
      "key": "line:Anger_Hands_06a333b",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16106,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451821871109",
      "collection": "Dialogs",
      "key": "line:Anger_Hands_0261833",
      "source": "Anger: Но тут нечего колоть, а злобу куда-то выплеснуть надо.",
      "target": "Anger: De itt nincs mit hasogatni, a dühömet meg valahol ki kell engednem.",
      "authoredFile": "Translations/hu/dialogue-batch-466.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16107,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451821871108",
      "collection": "Dialogs",
      "key": "line:Anger_Hands_0fed2c2",
      "source": "Anger: Ха. Бабушка в детстве говорила, что с такими руками мне дрова колоть, а не… заниматься тем, чем я занимался...",
      "target": "Anger: Ha. Gyerekkoromban a nagyanyám azt mondta, ilyen kézzel fát kellene hasogatnom, nem… azt csinálnom, amit csináltam...",
      "authoredFile": "Translations/hu/dialogue-batch-466.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16108,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451821871107",
      "collection": "Dialogs",
      "key": "line:Anger_Hands_0e6f074",
      "source": "Anger: О, да, смотри, какие лапищи.",
      "target": "Anger: Ó, igen, nézd, mekkora lapátkezeim vannak.",
      "authoredFile": "Translations/hu/dialogue-batch-466.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16109,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451821871106",
      "collection": "Dialogs",
      "key": "line:Anger_Hands_091cb31",
      "source": "Anger: Да не вопрос.",
      "target": "Anger: Persze, simán.",
      "authoredFile": "Translations/hu/dialogue-batch-466.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16110,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451821871105",
      "collection": "Dialogs",
      "key": "line:Anger_Teeth_0473437",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16111,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451821871104",
      "collection": "Dialogs",
      "key": "line:Anger_Teeth_07ec672",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16112,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451817676809",
      "collection": "Dialogs",
      "key": "line:Anger_Teeth_03fc72a",
      "source": "Anger: Я как-то давно думал, что если уж мои зубы такие, то пусть хоть один будет золотым. Типа, знаешь, как в кино у крутых мужиков.",
      "target": "Anger: Régen arra gondoltam, hogy ha már ilyenek a fogaim, legalább az egyik legyen aranyból. Tudod, mint a menő fickóknak a filmekben.",
      "authoredFile": "Translations/hu/dialogue-batch-466.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16113,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451817676808",
      "collection": "Dialogs",
      "key": "line:Anger_Teeth_0860678",
      "source": "Anger: Белые? Ну какими им быть, если я просто ухаживаю за собой?",
      "target": "Anger: Fehérek? Milyenek lennének, ha rendesen ápolom magam?",
      "authoredFile": "Translations/hu/dialogue-batch-466.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16114,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451817676807",
      "collection": "Dialogs",
      "key": "line:Anger_Teeth_0f3406b",
