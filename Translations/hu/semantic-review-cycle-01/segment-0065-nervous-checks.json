  "rows": [
    {
      "ordinal": 11328,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454019686401",
      "collection": "Dialogs",
      "key": "line:Nervous_Death_0fbf1b8",
      "source": "Nervous: Да твою…",
      "target": "Nervous: A kurva…",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11329,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454019686400",
      "collection": "Dialogs",
      "key": "line:Nervous_Death_0041bc9",
      "source": "Nervous: Может, и стоило остаться в том отеле.",
      "target": "Nervous: Talán jobb lett volna abban a szállodában maradnom.",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11330,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454015492107",
      "collection": "Dialogs",
      "key": "line:Nervous_Ears_DontShoot_0e8bb7d",
      "source": "Nervous: Ничего, забей.",
      "target": "Nervous: Semmi, hagyd.",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11331,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454015492106",
      "collection": "Dialogs",
      "key": "line:Nervous_Ears_DontShoot_04166dc",
      "source": "Nervous: Нет?.. Хи-хи, просто мне показалось…",
      "target": "Nervous: Nem?.. Hihihi, csak úgy tűnt…",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11332,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454015492105",
      "collection": "Dialogs",
      "key": "line:Nervous_Ears_DontShoot_0801df9",
      "source": "Nervous: Тебя… кто-то попросил?",
      "target": "Nervous: Téged… megkért valaki?",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11333,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454015492104",
      "collection": "Dialogs",
      "key": "line:Nervous_Ears_DontShoot_048ba26",
      "source": "Nervous: Как ты принял это решение?",
      "target": "Nervous: Hogyan jutottál erre a döntésre?",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11334,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454015492103",
      "collection": "Dialogs",
      "key": "line:Nervous_Ears_DontShoot_0d2a7d1",
      "source": "Nervous: Почему ты решил вообще наставить на меня оружие?",
      "target": "Nervous: Miért döntöttél úgy, hogy egyáltalán fegyvert fogsz rám?",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11335,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454015492102",
      "collection": "Dialogs",
      "key": "line:Nervous_Photo_DontShoot_09ae41d",
      "source": "Nervous: Или просто засвет какой?",
      "target": "Nervous: Vagy csak valami fényfolt?",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11336,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454015492101",
      "collection": "Dialogs",
      "key": "line:Nervous_Photo_DontShoot_0778e30",
      "source": "Nervous: Или это как иглы?",
      "target": "Nervous: Vagy ez olyan, mint a tűk?",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11337,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454015492100",
      "collection": "Dialogs",
      "key": "line:Nervous_Photo_DontShoot_0a54a4e",
      "source": "Nervous: А что вообще эти полосы значат? Ты знаешь?",
      "target": "Nervous: Egyáltalán mit jelentenek ezek a csíkok? Tudod?",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11338,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454015492099",
      "collection": "Dialogs",
      "key": "line:Nervous_Photo_DontShoot_0e2a94b",
      "source": "Nervous: Рядом со мной кто-то встал? Или это такой засвет странный?",
      "target": "Nervous: Valaki mellém állt? Vagy ez valami furcsa fényfolt?",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11339,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454015492098",
      "collection": "Dialogs",
      "key": "line:Nervous_Photo_DontShoot_04e3ad5",
      "source": "Nervous: А что вообще это всё значит? Почему там рядом тень какая-то?",
      "target": "Nervous: Egyáltalán mit jelent ez az egész? Miért van mellettem az a furcsa árnyék?",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11340,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454015492097",
      "collection": "Dialogs",
      "key": "line:Nervous_Armpit_DontShoot_0f9cd7b",
      "source": "Nervous: Как понять, что перед тобой именно Гость?",
      "target": "Nervous: Honnan tudod, hogy tényleg Vendég áll előtted?",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11341,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454015492096",
      "collection": "Dialogs",
      "key": "line:Nervous_Armpit_DontShoot_0691a49",
      "source": "Nervous: И те, и другие пытаются как-то подс-роиться под окружение.",
      "target": "Nervous: Mindkettő próbál valahogy beillesz-kedni a környezetébe.",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11342,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454011297803",
      "collection": "Dialogs",
      "key": "line:Nervous_Armpit_DontShoot_075b8cf",
      "source": "Nervous: Чем вообще Гости отличаются от людей, которые не понимают, как себя вести в обществе?",
      "target": "Nervous: Egyáltalán miben különböznek a Vendégek azoktól, akik nem tudják, hogyan kell társaságban viselkedni?",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11343,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454011297802",
      "collection": "Dialogs",
      "key": "line:Nervous_Eyes_DontShoot_0110297",
      "source": "Nervous: Не самая лучшая стратегия — тыкать дробашом в лицо тому, кто знает, во сколько ты засыпаешь.",
      "target": "Nervous: Nem túl jó ötlet puskát szegezni annak az arcába, aki tudja, mikor szoktál elaludni.",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11344,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454011297801",
      "collection": "Dialogs",
      "key": "line:Nervous_Hands_DontShoot_0301c83",
      "source": "Nervous: Хи-хи.",
      "target": "Nervous: Hihihi.",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11345,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454011297800",
      "collection": "Dialogs",
      "key": "line:Nervous_Hands_DontShoot_0f33db5",
      "source": "Nervous: А перестал обдирать пальцы я как раз потому, что начал грызть щёки и губы.",
      "target": "Nervous: Azért hagytam abba az ujjaim bőrének tépkedését, mert elkezdtem az arcom belsejét és az ajkaimat harapdálni.",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "proposed correction"
    },
    {
      "ordinal": 11346,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454011297799",
      "collection": "Dialogs",
      "key": "line:Nervous_Teeth_DontShoot_045fe51",
      "source": "Nervous: Мне смог помочь только… я сам? Хи-хи.",
      "target": "Nervous: Csak… én magam tudtam segíteni magamon? Hihihi.",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11347,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454011297798",
      "collection": "Dialogs",
      "key": "line:Nervous_Teeth_DontShoot_0a42d92",
      "source": "Nervous: Я чувствую, что в больничке мне просто прожгли мозги, если честно.",
      "target": "Nervous: Őszintén szólva úgy érzem, abban a diliházban egyszerűen kiégették az agyam.",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11348,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454011297797",
      "collection": "Dialogs",
      "key": "line:Nervous_Ears_Gun_0deda11",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11349,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454011297796",
      "collection": "Dialogs",
      "key": "line:Nervous_Ears_Gun_0e53f3d",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11350,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454011297795",
      "collection": "Dialogs",
      "key": "line:Nervous_Ears_Gun_054956c",
      "source": "Nervous: Ты сам лучше? Чище?",
      "target": "Nervous: Te talán jobb vagy? Tisztább?",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11351,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454011297794",
      "collection": "Dialogs",
      "key": "line:Nervous_Ears_Gun_0dd701e",
      "source": "Nervous: А от тебя-то почему такой отклик?",
      "target": "Nervous: És belőled miért vált ki ilyen reakciót?",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11352,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454011297793",
      "collection": "Dialogs",
      "key": "line:Nervous_Photo_Gun_0748e99",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11353,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454011297792",
      "collection": "Dialogs",
      "key": "line:Nervous_Photo_Gun_0b41fcd",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11354,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454007103499",
      "collection": "Dialogs",
      "key": "line:Nervous_Photo_Gun_081411e",
      "source": "Nervous: Спасибо, что без буллинга, хи-хи.",
      "target": "Nervous: Kösz, hogy nem kezdtél zaklatni, hihihi.",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11355,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454007103498",
      "collection": "Dialogs",
      "key": "line:Nervous_Armpit_Gun_0c19814",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11356,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454007103497",
      "collection": "Dialogs",
      "key": "line:Nervous_Armpit_Gun_056bdef",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11357,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454007103496",
      "collection": "Dialogs",
      "key": "line:Nervous_Armpit_Gun_0c602e4",
      "source": "Nervous: Но я точно знаю, что не Гость!",
      "target": "Nervous: De azt biztosan tudom, hogy nem vagyok Vendég!",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11358,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454007103495",
      "collection": "Dialogs",
      "key": "line:Nervous_Armpit_Gun_04cb51a",
      "source": "Nervous: А, без волос — это признак Гостя…",
      "target": "Nervous: Ja, hogy a szőr hiánya a Vendég egyik jele…",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11359,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454007103494",
      "collection": "Dialogs",
      "key": "line:Nervous_Armpit_Gun_0e34905",
      "source": "Nervous: Да что не так?",
      "target": "Nervous: Most meg mi a baj?",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11360,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454007103493",
      "collection": "Dialogs",
      "key": "line:Nervous_Eyes_Gun_0b242e3",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11361,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454007103492",
      "collection": "Dialogs",
      "key": "line:Nervous_Eyes_Gun_0e25c16",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11362,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454007103491",
      "collection": "Dialogs",
      "key": "line:Nervous_Eyes_Gun_07a0aa4",
      "source": "Nervous: Что не так?",
      "target": "Nervous: Mi a baj?",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11363,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454007103490",
      "collection": "Dialogs",
      "key": "line:Nervous_Eyes_Gun_0be43f1",
      "source": "Nervous: Я же не убил тебя ночью, пока ты спал!",
      "target": "Nervous: Hiszen nem öltelek meg éjjel, amíg aludtál!",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11364,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454007103489",
      "collection": "Dialogs",
      "key": "line:Nervous_Eyes_Gun_024c538",
      "source": "Nervous: МНЕ?",
      "target": "Nervous: ENGEM?",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11365,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454007103488",
