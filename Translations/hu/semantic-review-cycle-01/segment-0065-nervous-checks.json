      "collection": "Dialogs",
      "key": "line:Nervous_Armpit_0704290",
      "source": "Nervous: У меня так ничего и не получилось, хи-хи.",
      "target": "Nervous: Nekem sehogy sem sikerült, hihihi.",
      "authoredFile": "Translations/hu/dialogue-batch-355.json",
