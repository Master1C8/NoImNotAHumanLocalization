      "collection": "Dialogs",
      "key": "line:Nervous_Armpit_085003a",
      "source": "Nervous: Меня не научили, как за собой ухаживать.",
      "target": "Nervous: Nem tanítottak meg rá, hogyan gondoskodjak magamról.",
      "authoredFile": "Translations/hu/dialogue-batch-355.json",
      "reviewResult": "pass"
    },
    {
