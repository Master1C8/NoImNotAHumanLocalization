    },
    {
      "ordinal": 11367,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454002909193",
      "collection": "Dialogs",
      "key": "line:Nervous_Hands_Gun_0788222",
      "source": "Nervous: Но вот это лишнее.",
      "target": "Nervous: Na, ez már túlzás.",
      "authoredFile": "Translations/hu/dialogue-batch-354.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11368,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454002909192",
      "collection": "Dialogs",
