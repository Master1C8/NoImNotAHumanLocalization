      "collection": "Dialogs",
      "key": "line:Nervous_Ears_0787bb2",
      "source": "Nervous: Забываю их чистить.",
      "target": "Nervous: Elfelejtem megtisztítani.",
      "authoredFile": "Translations/hu/dialogue-batch-355.json",
      "reviewResult": "pass"
    },
