      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11366,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454002909194",
      "collection": "Dialogs",
      "key": "line:Nervous_Hands_Gun_0f02496",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
