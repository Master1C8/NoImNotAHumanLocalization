      "collection": "Dialogs",
      "key": "line:Nervous_Hands_05018b4",
      "source": "Nervous: И оно какое-то время еще щиплет.",
      "target": "Nervous: És még egy darabig csíp.",
      "authoredFile": "Translations/hu/dialogue-batch-355.json",
