      "collection": "Dialogs",
      "key": "line:Nervous_Photo_0cd504d",
      "source": "Nervous: Ладно-ладно.",
      "target": "Nervous: Jól van, jól van.",
      "authoredFile": "Translations/hu/dialogue-batch-355.json",
      "reviewResult": "pass"
    },
