  "rows": [
    {
      "ordinal": 8341,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455097622528",
      "collection": "Dialogs",
      "key": "line:Daughter_Asking_3_009e901",
      "source": "Daughter: Вроде бы это её номер телефона: {0}.",
      "target": "Daughter: Azt hiszem, ez a telefonszáma: {0}.",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8342,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455093428236",
      "collection": "Dialogs",
      "key": "line:Daughter_Asking_3_003ccef",
      "source": "Daughter: Когда взрослые зовут, её отпускают... А если я сама, то меня всегда ругают.",
      "target": "Daughter: Ha felnőttek hívják, elengedik... De ha én hívom, mindig leszidnak.",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8343,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455093428235",
      "collection": "Dialogs",
      "key": "line:Daughter_Asking_3_04109f4",
      "source": "Daughter: И ещё... может, вы позовёте мою подружку в гости?..",
      "target": "Daughter: És még... talán meghívná a barátnőmet vendégségbe?..",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8344,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455093428234",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_6_05951f6",
      "source": "Cold: Прости. Я этого не хотел.",
      "target": "Cold: Bocsáss meg. Nem akartam.",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8345,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455093428233",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_6_0ec1e3b",
      "source": "Cold: И всё же.",
      "target": "Cold: És mégis.",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8346,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455093428232",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_6_04b8bcc",
      "source": "Cold: Понимаю, как ты меня ненавидишь.",
      "target": "Cold: Megértem, mennyire gyűlölsz.",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8347,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455093428231",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_6_025373f",
      "source": "Cold: Спасибо.",
      "target": "Cold: Köszönöm.",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8348,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455093428230",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_5_003ca08",
      "source": "Cold: Может, хоть на солнце получится согреться. В последний раз.",
      "target": "Cold: Talán a napon végre felmelegedhetek. Utoljára.",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8349,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455093428229",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_5_0290ff2",
      "source": "Cold: Извини.",
      "target": "Cold: Sajnálom.",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8350,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455093428228",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_5_0aae1d4",
      "source": "Cold: Я понял.",
      "target": "Cold: Megértettem.",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8351,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455093428227",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_4_0752e5c",
      "source": "Только дай мне повод выстрелить",
      "target": "Csak adj okot, hogy lőjek",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8352,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455093428226",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_4_09c48e9",
      "source": "Иди сейчас",
      "target": "Menj el most",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8353,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455093428225",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_4_07cfe10",
      "source": "Cold: Я могу остаться до ночи?",
      "target": "Cold: Maradhatok éjszakáig?",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8354,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455093428224",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_4_0c5da7b",
      "source": "Cold: Солнце будет убивать медленно.",
      "target": "Cold: A Nap lassan fog megölni.",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8355,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455089233931",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_4_0f00063",
      "source": "Cold: Этичнее было бы застрелить меня. Я чувствую боль, к сожалению.",
      "target": "Cold: Erkölcsösebb volna lelőni engem. Sajnos érzek fájdalmat.",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8356,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455089233930",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_4_0afe56f",
      "source": "Cold: Прямо сейчас?",
      "target": "Cold: Most rögtön?",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8357,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455089233929",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_3_0b43e84",
      "source": "Cold: Не думай, что я специально.",
      "target": "Cold: Ne hidd, hogy szándékosan tettem.",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8358,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455089233928",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_3_0afceb9",
      "source": "Cold: Я только хотел бы…",
      "target": "Cold: Én csak azt szeretném…",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8359,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455089233927",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_3_0ab2638",
      "source": "Cold: Тогда закончатся проблемы с холодом и одиночеством.",
      "target": "Cold: Akkor véget érnének a hideggel és a magánnyal kapcsolatos gondjaim.",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8360,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455089233926",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_3_0b47187",
      "source": "Cold: Наверно, так безопаснее.",
      "target": "Cold: Talán így biztonságosabb.",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8361,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455089233925",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_2_0d09969",
      "source": "Выгнать",
      "target": "Elzavarni",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8362,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455089233924",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_2_0ac4f0a",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8363,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455089233923",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_2_057e0a2",
      "source": "Cold: Я не этого хотел…",
      "target": "Cold: Nem ezt akartam…",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8364,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455089233922",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_2_058710c",
      "source": "Cold: Я не делал это по какой-то злой воле.",
      "target": "Cold: Nem rosszindulatból tettem.",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8365,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455089233921",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_2_0c21c3a",
      "source": "Cold: Не делай поспешных выводов.",
      "target": "Cold: Ne vonj le elhamarkodott következtetéseket.",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8366,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455089233920",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_2_05ae695",
      "source": "Cold: Почему я подумал, что в этот раз что-то изменится?",
      "target": "Cold: Miért hittem, hogy ezúttal bármi megváltozik?",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8367,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455085039628",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_2_0003b35",
      "source": "Cold: Так было раньше.",
      "target": "Cold: Régen is így volt.",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8368,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455085039627",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_1_0098328",
      "source": "Выгнать",
      "target": "Elzavarni",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8369,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455085039626",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_1_02d1fbf",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8370,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455085039625",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_1_0f04871",
      "source": "Cold: Правда, не хотел.",
      "target": "Cold: Tényleg nem akartam.",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8371,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455085039624",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_1_0e0e849",
      "source": "Cold: Я не хотел.",
      "target": "Cold: Nem akartam.",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8372,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455085039623",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_1_0ea65d2",
      "source": "Cold: Почему со мной так?",
      "target": "Cold: Miért történik ez velem?",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8373,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455085039622",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_1_0044b98",
      "source": "Cold: Надеялся, что тут такого не будет.",
      "target": "Cold: Reméltem, itt nem így lesz.",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8374,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455085039621",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_1_06d70f6",
      "source": "Cold: Я не специально…",
      "target": "Cold: Nem szándékosan…",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8375,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455085039620",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_06a60c2",
      "source": "Тебе пиздец",
      "target": "Neked kurvára véged",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8376,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455085039619",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_0fae8f1",
      "source": "Ты что наделал?",
      "target": "Mit műveltél?",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8377,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455085039618",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_033b172",
      "source": "Cold: О нет. Опять.",
      "target": "Cold: Ó, ne. Már megint.",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8378,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455085039617",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_0428112",
      "source": "Cold: Смотри.",
      "target": "Cold: Nézd.",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8379,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455085039616",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_027bd42",
      "source": "Cold: Под одеждой я действительно прячу, как я думаю, причину сжирающего одиночества и холода.",
      "target": "Cold: A ruhám alatt valóban azt rejtegetem, amit a kínzó magány és hideg okának tartok.",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8380,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455080845324",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_0e11e7a",
      "source": "Cold: Обычно оно не заканчивается ничем хорошим, но вдруг сейчас будет по-другому.",
      "target": "Cold: Ez általában nem végződik jól, de hátha most másképp lesz.",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8381,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455080845323",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_0a9c891",
      "source": "Cold: Пожалуй, я готов.",
      "target": "Cold: Azt hiszem, készen állok.",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8382,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455080845322",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_4_0e6c186",
      "source": "Cold: Да, я хотел открыть тебе одну свою тайну.",
      "target": "Cold: Igen, el akartam árulni neked egy titkomat.",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8383,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455080845321",
      "collection": "Dialogs",
      "key": "line:talk_cold_4_09af37f",
      "source": "Мне надо тебя проверить",
      "target": "Meg kell vizsgálnom téged",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8384,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455080845320",
      "collection": "Dialogs",
      "key": "line:talk_cold_4_0ee5fdb",
      "source": "Так что ты там скрываешь?",
      "target": "Szóval mit rejtegetsz?",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8385,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455080845319",
      "collection": "Dialogs",
      "key": "line:talk_cold_4_0fd1c8e",
      "source": "Cold: Вот бы немного тепла...",
      "target": "Cold: Bárcsak egy kis meleghez jutnék...",
      "authoredFile": "Translations/hu/dialogue-batch-275.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8386,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455080845318",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_3_0de0fa6",
      "source": "Cold: Завтра я буду готов кое-чем поделиться.",
      "target": "Cold: Holnap kész leszek elmondani valamit.",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8387,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455080845317",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_3_06c8abd",
      "source": "Cold: Я…",
      "target": "Cold: Én…",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8388,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455080845316",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_3_0875ea7",
      "source": "Cold: Я бы вообще не говорил об этом, но тоска сжирает меня изнутри.",
      "target": "Cold: Egyáltalán nem beszélnék erről, de a szomorúság belülről emészt.",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8389,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455080845315",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_3_0dc8cba",
      "source": "Cold: …",
      "target": "Cold: …",
      "authoredFile": "Translations/hu/dialogue-batch-038.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8390,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455080845314",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_3_0d3734e",
      "source": "Cold: Меня волнует кое-что. Уже довольно давно. Скорее всего, из-за этого я и чувствую себя так… холодно.",
      "target": "Cold: Valami régóta nyugtalanít. Valószínűleg emiatt érzem magam ilyen… hidegnek.",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8391,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455080845313",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_3_02d076d",
      "source": "Cold: М. Не уверен, что хочу сейчас поднимать эту тему.",
      "target": "Cold: Hm. Nem vagyok biztos benne, hogy most akarok erről beszélni.",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8392,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455080845312",
      "collection": "Dialogs",
      "key": "line:talk_cold_3_0cd9fd3",
      "source": "Мне надо тебя проверить",
      "target": "Meg kell vizsgálnom téged",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8393,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455076651020",
      "collection": "Dialogs",
      "key": "line:talk_cold_3_0ae1c4e",
      "source": "Когда ты только пришёл, сказал, что хочешь что-то раскрыть мне. О чём речь?",
      "target": "Amikor megérkeztél, azt mondtad, el akarsz árulni nekem valamit. Miről van szó?",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8394,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455076651019",
      "collection": "Dialogs",
      "key": "line:talk_cold_3_0352fa4",
      "source": "Cold: Вот бы немного тепла...",
      "target": "Cold: Bárcsak kaphatnék egy kis meleget...",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8395,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455076651018",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_2_06ad475",
      "source": "Cold: Мне кажется, я этому обществу, как и космосу, не нужен.",
      "target": "Cold: Úgy érzem, ennek a társadalomnak éppúgy nincs szüksége rám, mint a világűrnek.",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8396,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455076651017",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_2_0cf9a77",
      "source": "Cold: Равно как не испытаю человеческого тепла при объятии.",
      "target": "Cold: Egy ölelésben sem érezhetem meg az emberi meleget.",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8397,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455076651016",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_2_00945a6",
      "source": "Cold: Мне никогда не почувствовать энергию солнца.",
      "target": "Cold: Soha nem fogom érezni a nap energiáját.",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8398,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455076651015",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_2_03498c0",
      "source": "Cold: А я в этом скоплении событий – сторонний наблюдатель.",
      "target": "Cold: Én pedig csak külső szemlélő vagyok ebben az események forgatagában.",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8399,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455076651014",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_2_09bd309",
      "source": "Cold: Существуют галактики по своим правилам, взрываются сверхновые.",
      "target": "Cold: A galaxisok a saját törvényeik szerint léteznek, szupernóvák robbannak fel.",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8400,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455076651013",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_2_013db7d",
      "source": "Cold: Представь огромный холодный космос.",
      "target": "Cold: Képzeld el a hatalmas, hideg világűrt.",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8401,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455076651012",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_2_02caa47",
      "source": "Cold: Кажется, я придумал ассоциацию ко всей этой истории.",
      "target": "Cold: Azt hiszem, találtam egy hasonlatot erre az egész történetre.",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8402,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455076651011",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_2_0ceffd0",
      "source": "Cold: Знаешь…",
      "target": "Cold: Tudod…",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8403,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455076651010",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_2_0ea8b8f",
      "source": "Cold: Ванна из кипятка оставляет только ожоги, но никак мне не помогает согреться.",
      "target": "Cold: A forró vízzel teli fürdő csak égési sérüléseket okoz, de nem melegít fel.",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8404,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455076651009",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_2_0c40371",
      "source": "Cold: Я не думаю, что могу поменять свой организм.",
      "target": "Cold: Nem hiszem, hogy meg tudnám változtatni a testemet.",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8405,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455076651008",
      "collection": "Dialogs",
      "key": "line:talk_cold_2_09941b0",
      "source": "Мне надо тебя проверить",
      "target": "Meg kell vizsgálnom téged",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8406,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455072456715",
      "collection": "Dialogs",
      "key": "line:talk_cold_2_0724aeb",
      "source": "Есть мысли, что делать с твоей температурой?",
      "target": "Van ötleted, mit lehetne tenni a testhőmérsékleteddel?",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8407,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455072456714",
      "collection": "Dialogs",
      "key": "line:talk_cold_2_07a588f",
      "source": "Cold: Вот бы немного тепла...",
      "target": "Cold: Bárcsak kaphatnék egy kis meleget...",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8408,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455072456713",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_1_2_0e988cd",
      "source": "Cold: Проигнорирую этот вопрос, извини.",
      "target": "Cold: Ezt a kérdést inkább figyelmen kívül hagyom, bocsánat.",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8409,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455072456712",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_1_1_04d3923",
      "source": "Cold: Думаю, мне уже некуда холодеть.",
      "target": "Cold: Azt hiszem, már nem is fázhatok jobban.",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "finding"
    },
    {
      "ordinal": 8410,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455072456711",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_1_1_0cc8d1e",
      "source": "Cold: Тело потеет, хочет охладиться.",
      "target": "Cold: A test azért izzad, hogy lehűtse magát.",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8411,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455072456710",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_1_1_08358be",
      "source": "Cold: Нет.",
      "target": "Cold: Nem.",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8412,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455072456709",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_1_0e145f1",
      "source": "И ты не моешься, получается?",
      "target": "Akkor nem is mosakszol?",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8413,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455072456708",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_1_07d6e8d",
      "source": "И ты не потеешь под курткой?",
      "target": "És nem izzadsz a kabátod alatt?",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8414,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455072456707",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_1_0594286",
      "source": "Cold: Или, что ещё мучительнее, не умру, но станет холоднее, чем сейчас.",
      "target": "Cold: Vagy ami még kínzóbb: nem halok meg, csak még hidegebb lesz, mint most.",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8415,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455072456706",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_1_0e9a12b",
      "source": "Cold: Но если снять куртку – умру ли я от переохлаждения?",
      "target": "Cold: De ha leveszem a kabátom, meghalok a kihűléstől?",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8416,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455072456705",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_1_03b6dde",
      "source": "Cold: Что произойдёт, если я сниму одежду. Я даже в жару на улице не могу согреться.",
      "target": "Cold: Mi történik, ha leveszem a ruháimat? Odakint még hőségben sem tudok felmelegedni.",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8417,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455072456704",
      "collection": "Dialogs",
      "key": "line:Cold_Asking_1_07be981",
      "source": "Cold: Да. Меня пугает одна мысль.",
      "target": "Cold: Igen. Egy gondolat megrémít.",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8418,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455068262412",
      "collection": "Dialogs",
      "key": "line:talk_cold_1_0612649",
      "source": "Мне надо тебя проверить",
      "target": "Meg kell vizsgálnom téged",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8419,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455068262411",
      "collection": "Dialogs",
      "key": "line:talk_cold_1_08d09cd",
      "source": "Ты и в доме будешь в куртке?",
      "target": "A házban is kabátban leszel?",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8420,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455068262410",
      "collection": "Dialogs",
      "key": "line:talk_cold_1_05def44",
      "source": "Cold: Вот бы немного тепла...",
      "target": "Cold: Bárcsak kaphatnék egy kis meleget...",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
      "reviewResult": "pass"
    }
  ],
  "findings": [
    {
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504455072456712",
      "reason": "In the discussion of body temperature and sweating, «мне уже некуда холодеть» means he cannot become any colder. Hungarian «már nem is fázhatok jobban» means he cannot feel colder, switching the physical-temperature claim to a subjective sensation.",
      "proposedTarget": "Cold: Azt hiszem, már nem lehetek hidegebb.",
      "context": "Cold_Asking_1_1; this is his reply to whether he sweats under his coat; the next line says sweat cools the body.",
      "source": "Cold: Думаю, мне уже некуда холодеть.",
      "currentTarget": "Cold: Azt hiszem, már nem is fázhatok jobban.",
      "authoredFile": "Translations/hu/dialogue-batch-276.json",
