      "collection": "Dialogs",
      "key": "line:FormerFema_Teeth_Gun_017f5f8",
      "source": "FormerFema: Стоп, стоп, погоди. У меня с зубами всё в порядке, я уверен. Ты что?!",
      "target": "FormerFema: Állj, állj, várj. Biztos vagyok benne, hogy a fogaim rendben vannak. Mi ütött beléd?!",
      "authoredFile": "Translations/hu/dialogue-batch-387.json",
      "reviewResult": "pass"
    },
