  "rows": [
    {
      "ordinal": 13958,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452635566088",
      "collection": "Dialogs",
      "key": "line:Luka_Death_0de7b6e",
      "source": "Luka: Стреляй.",
      "target": "Luka: Lőj.",
      "authoredFile": "Translations/hu/dialogue-batch-419.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13959,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452635566087",
      "collection": "Dialogs",
      "key": "line:Luka_Death_0f1d309",
      "source": "Luka: Если тебе от этого станет легче...",
      "target": "Luka: Ha ettől könnyebb lesz neked...",
      "authoredFile": "Translations/hu/dialogue-batch-419.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13960,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452635566086",
      "collection": "Dialogs",
      "key": "line:Luka_Ears_DontShoot_0cf8763",
      "source": "Luka: Слышать — это не просто воспринимать звуки. Это понимать других, даже когда они молчат.",
      "target": "Luka: Hallani nem csupán a hangok érzékelését jelenti. Azt is, hogy megérted a többieket, még amikor hallgatnak is.",
      "authoredFile": "Translations/hu/dialogue-batch-419.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13961,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452635566085",
      "collection": "Dialogs",
      "key": "line:Luka_Photo_DontShoot_094e2a6",
      "source": "Luka: Фотографии – это не просто снимки. Это моменты, которые мы хотим сохранить.",
      "target": "Luka: A fényképek nem csupán képek. Pillanatok, amelyeket meg akarunk őrizni.",
      "authoredFile": "Translations/hu/dialogue-batch-419.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13962,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452635566084",
      "collection": "Dialogs",
      "key": "line:Luka_Armpit_DontShoot_0b75e73",
      "source": "Luka: Знаешь, запахи — это память. Запах дома, запах хлеба, запах утра. Они дают силы жить дальше.",
      "target": "Luka: Tudod, az illatok emlékek. Az otthon illata, a kenyéré, a reggelé. Erőt adnak, hogy tovább éljünk.",
      "authoredFile": "Translations/hu/dialogue-batch-419.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13963,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452635566083",
      "collection": "Dialogs",
      "key": "line:Luka_Eyes_DontShoot_033fd7c",
      "source": "Luka: Глаза... они и радости видели, и смерти. Но я всё равно стараюсь смотреть вперёд.",
      "target": "Luka: A szemem… látott örömöt és halált is. Mégis igyekszem előre nézni.",
      "authoredFile": "Translations/hu/dialogue-batch-419.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13964,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452635566082",
      "collection": "Dialogs",
      "key": "line:Luka_Hands_DontShoot_097f821",
      "source": "Luka: Знаешь, руки держат всё: и потери, и радости. Если бы мы не могли протянуть её ближнему, нам бы не выжить.",
      "target": "Luka: Tudod, a kezünk mindent hordoz: veszteséget és örömöt. Ha nem nyújthatnánk kezet embertársunknak, nem élnénk túl.",
      "authoredFile": "Translations/hu/dialogue-batch-419.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13965,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452635566081",
      "collection": "Dialogs",
      "key": "line:Luka_Teeth_DontShoot_0b1060f",
      "source": "Luka: Смерть про то же самое.",
      "target": "Luka: A halálról is ugyanez mondható el.",
      "authoredFile": "Translations/hu/dialogue-batch-419.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13966,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452635566080",
      "collection": "Dialogs",
      "key": "line:Luka_Teeth_DontShoot_09a1358",
      "source": "Luka: Знаешь, я раньше ненавидел себя за многое. Но потом понял — жизнь не о том, чтобы всё исправить. Она о том, чтобы принять себя.",
      "target": "Luka: Tudod, régen sok mindenért gyűlöltem magam. Aztán megértettem: az élet nem arról szól, hogy mindent helyrehozzunk. Hanem arról, hogy elfogadjuk magunkat.",
      "authoredFile": "Translations/hu/dialogue-batch-419.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13967,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452631371786",
      "collection": "Dialogs",
      "key": "line:Luka_Ears_Gun_0fe740b",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13968,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452631371785",
      "collection": "Dialogs",
      "key": "line:Luka_Ears_Gun_0f5d123",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13969,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452631371784",
      "collection": "Dialogs",
      "key": "line:Luka_Ears_Gun_0d7eca9",
      "source": "Luka: Ты хочешь, чтобы тишина всё затмила в этом доме? Тогда тебе придётся слушать себя самого…",
      "target": "Luka: Azt akarod, hogy ebben a házban mindent elnyomjon a csend? Akkor önmagadat kell hallgatnod…",
      "authoredFile": "Translations/hu/dialogue-batch-419.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13970,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452631371783",
      "collection": "Dialogs",
      "key": "line:Luka_Photo_Gun_040bfe2",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13971,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452631371782",
      "collection": "Dialogs",
      "key": "line:Luka_Photo_Gun_01fcd60",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13972,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452631371781",
      "collection": "Dialogs",
      "key": "line:Luka_Photo_Gun_09de48a",
      "source": "Luka: Я не думал, что она может стать последней.",
      "target": "Luka: Nem gondoltam, hogy az lehet az utolsó.",
      "authoredFile": "Translations/hu/dialogue-batch-419.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13973,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452631371780",
      "collection": "Dialogs",
      "key": "line:Luka_Armpit_Gun_0ee96be",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13974,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452631371779",
      "collection": "Dialogs",
      "key": "line:Luka_Armpit_Gun_069415f",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13975,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452631371778",
      "collection": "Dialogs",
      "key": "line:Luka_Armpit_Gun_015a968",
      "source": "Luka: Я не хочу быть твоим врагом.",
      "target": "Luka: Nem akarok az ellenséged lenni.",
      "authoredFile": "Translations/hu/dialogue-batch-419.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13976,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452631371777",
      "collection": "Dialogs",
      "key": "line:Luka_Eyes_Gun_0d54e27",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13977,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452631371776",
      "collection": "Dialogs",
      "key": "line:Luka_Eyes_Gun_0e94524",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13978,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452627177481",
      "collection": "Dialogs",
      "key": "line:Luka_Eyes_Gun_0bc288a",
      "source": "Luka: Если тебе хочется что-то разрушить – уничтожь свои страхи.",
      "target": "Luka: Ha mindenképpen szét akarsz zúzni valamit, pusztítsd el a félelmeidet.",
      "authoredFile": "Translations/hu/dialogue-batch-419.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13979,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452627177480",
      "collection": "Dialogs",
      "key": "line:Luka_Hands_Gun_0fc6f34",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13980,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452627177479",
      "collection": "Dialogs",
      "key": "line:Luka_Hands_Gun_0628691",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13981,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452627177478",
      "collection": "Dialogs",
      "key": "line:Luka_Hands_Gun_0c9fc3f",
      "source": "Luka: Ты думаешь, иметь руки – это преступление?",
      "target": "Luka: Azt hiszed, bűn, ha valakinek van keze?",
      "authoredFile": "Translations/hu/dialogue-batch-419.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13982,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452627177477",
      "collection": "Dialogs",
      "key": "line:Luka_Hands_Gun_00b4ee9",
      "source": "Luka: Вся эта сыпь – следы воспоминаний о прошлой жизни.",
      "target": "Luka: Ez a sok kiütés mind az egykori életem emlékeinek nyoma.",
      "authoredFile": "Translations/hu/dialogue-batch-419.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13983,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452627177476",
      "collection": "Dialogs",
      "key": "line:Luka_Hands_Gun_013dc2d",
      "source": "Luka: Вся эта грязь – следы борьбы за жизнь.",
      "target": "Luka: Ez a sok kosz az életben maradásért vívott küzdelem nyoma.",
      "authoredFile": "Translations/hu/dialogue-batch-419.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13984,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452627177475",
      "collection": "Dialogs",
      "key": "line:Luka_Teeth_Gun_00ea2e2",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13985,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452627177474",
      "collection": "Dialogs",
      "key": "line:Luka_Teeth_Gun_0741ca3",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13986,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452627177473",
      "collection": "Dialogs",
      "key": "line:Luka_Teeth_Gun_08cbe1b",
      "source": "Luka: С оружием проще, да? Не слушать, не думать, просто нажать.",
      "target": "Luka: Fegyverrel könnyebb, ugye? Nem hallgatni, nem gondolkodni, csak meghúzni a ravaszt.",
      "authoredFile": "Translations/hu/dialogue-batch-419.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13987,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452627177472",
