      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13988,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452622983177",
      "collection": "Dialogs",
      "key": "line:Luka_Ears_0aa7eae",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13989,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452622983176",
      "collection": "Dialogs",
      "key": "line:Luka_Ears_0cddb57",
      "source": "Luka: Я всегда готов тебя выслушать.",
      "target": "Luka: Mindig kész vagyok meghallgatni téged.",
      "authoredFile": "Translations/hu/dialogue-batch-420.json",
      "reviewResult": "pass"
    },
    {
