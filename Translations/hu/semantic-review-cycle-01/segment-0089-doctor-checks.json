      "target": "Doctor: ...",
      "authoredFile": "Translations/hu/dialogue-batch-039.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13278,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452954333191",
      "collection": "Dialogs",
      "key": "line:Doctor_Photo_0353b00",
      "source": "Doctor: Понимаю, что надо проверить все признаки. Этот в том числе.",
      "target": "Doctor: Értem, hogy minden jelet ellenőrizni kell. Ezt is.",
      "authoredFile": "Translations/hu/dialogue-batch-401.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13279,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452954333190",
      "collection": "Dialogs",
      "key": "line:Doctor_Photo_00a0977",
      "source": "Doctor: Хорошо, без проблем.",
      "target": "Doctor: Rendben, semmi gond.",
      "authoredFile": "Translations/hu/dialogue-batch-401.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13280,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452954333189",
      "collection": "Dialogs",
      "key": "line:Doctor_Armpit_0bd61e4",
