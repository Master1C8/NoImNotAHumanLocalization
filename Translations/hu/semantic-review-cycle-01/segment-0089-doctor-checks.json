      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13281,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452954333188",
      "collection": "Dialogs",
      "key": "line:Doctor_Armpit_0304520",
      "source": "Отпустить",
