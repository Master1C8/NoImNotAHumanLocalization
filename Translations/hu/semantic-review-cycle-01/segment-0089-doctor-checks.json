      "collection": "Dialogs",
      "key": "line:Doctor_Ears_00846b4",
      "source": "Doctor: И раз я ещё жив, принимаете здравые решения.",
      "target": "Doctor: És mivel még élek, maga józan döntéseket hoz.",
      "authoredFile": "Translations/hu/dialogue-batch-401.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13271,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452958527493",
      "collection": "Dialogs",
      "key": "line:Doctor_Ears_02804d6",
      "source": "Doctor: ...",
