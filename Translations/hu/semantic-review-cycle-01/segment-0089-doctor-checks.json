      "reviewResult": "pass"
    },
    {
      "ordinal": 13285,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452954333184",
      "collection": "Dialogs",
      "key": "line:Doctor_Armpit_0dd8566",
      "source": "Doctor: Да, сейчас. Я уже не такой шустрый как раньше.",
      "target": "Doctor: Igen, egy pillanat. Már nem mozgok olyan fürgén, mint régen.",
      "authoredFile": "Translations/hu/dialogue-batch-401.json",
      "reviewResult": "pass"
    },
    {
