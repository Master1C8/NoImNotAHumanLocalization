      "collection": "Dialogs",
      "key": "line:Doctor_Ears_0bf5989",
      "source": "Doctor: Хорошо, думаю, вы знаете, что делаете.",
      "target": "Doctor: Rendben, azt hiszem, tudja, mit csinál.",
      "authoredFile": "Translations/hu/dialogue-batch-401.json",
      "reviewResult": "pass"
    },
    {
