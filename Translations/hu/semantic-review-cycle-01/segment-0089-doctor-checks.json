      "collection": "Dialogs",
      "key": "line:Doctor_Photo_0bb6336",
      "source": "Doctor: А что ты думаешь?",
      "target": "Doctor: És te mit gondolsz?",
      "authoredFile": "Translations/hu/dialogue-batch-401.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13276,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452958527488",
      "collection": "Dialogs",
      "key": "line:Doctor_Photo_06572b9",
      "source": "Doctor: Мне все говорили, что у меня необычная внешность.",
      "target": "Doctor: Mindig azt mondták, szokatlan a külsőm.",
      "authoredFile": "Translations/hu/dialogue-batch-401.json",
      "reviewResult": "proposed correction"
    },
    {
      "ordinal": 13277,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452954333192",
      "collection": "Dialogs",
      "key": "line:Doctor_Photo_0eefed1",
