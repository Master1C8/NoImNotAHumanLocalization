      "collection": "Dialogs",
      "key": "line:Doctor_Hands_018da39",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13297,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452945944578",
      "collection": "Dialogs",
      "key": "line:Doctor_Hands_0be90f0",
      "source": "Doctor: Кто знает, что случится завтра?",
      "target": "Doctor: Ki tudja, mit hoz a holnap?",
      "authoredFile": "Translations/hu/dialogue-batch-401.json",
      "reviewResult": "pass"
    },
    {
