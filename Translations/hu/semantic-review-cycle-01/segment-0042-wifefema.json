  "rows": [
    {
      "ordinal": 9538,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454669803528",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_6_0059815",
      "source": "Wifefema: Я так и думала…",
      "target": "Wifefema: Gondoltam…",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9539,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454669803527",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_6_0401377",
      "source": "Wifefema: …",
      "target": "Wifefema: …",
      "authoredFile": "Translations/hu/dialogue-batch-038.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9540,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454669803526",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_6_033e0ac",
      "source": "Wifefema: Чем вы лучше КЧС, у которых есть полномочия на это, скажите мне?",
      "target": "Wifefema: Mondja, miben jobb maga a KCsSz-nél, amelynek felhatalmazása van erre?",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9541,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454669803525",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_6_02442b0",
      "source": "Wifefema: Это не вам дозволено. Для этого есть КЧС! А вы тут самосудом занимаетесь.",
      "target": "Wifefema: Magának ehhez nincs joga. Erre ott a KCsSz! Maga meg önbíráskodik.",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9542,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454669803524",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_6_0cdb9e9",
      "source": "Wifefema: Вы тут условия диктуете, решаете, кто Гость, а кто нет.",
      "target": "Wifefema: Itt maga diktálja a feltételeket, maga dönti el, ki Vendég, és ki nem.",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9543,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454669803523",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_6_00077da",
      "source": "Wifefema: Сами-то, небось, захотели быть главным, это ведь ваш дом, все к вам идут.",
      "target": "Wifefema: Nyilván maga akart itt főnök lenni. Hiszen ez a maga háza, mindenki magához jön.",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9544,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454669803522",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_6_027490a",
      "source": "Wifefema: Я не спрашивала вашего мнения. К тому же, не лицемерно ли это?",
      "target": "Wifefema: Nem kértem a véleményét. Ráadásul ez nem képmutatás?",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9545,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454669803521",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_6_0029388",
      "source": "Wifefema: Что вы о себе возомнили?",
      "target": "Wifefema: Kinek képzeli magát?",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9546,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454669803520",
      "collection": "Dialogs",
      "key": "line:talk_wifefema_6_02035aa",
      "source": "Мне надо тебя проверить",
      "target": "Meg kell vizsgálnom téged",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9547,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454665609227",
      "collection": "Dialogs",
      "key": "line:talk_wifefema_6_0f47f00",
      "source": "На таможне-то работалось лучше? Там хотя бы была власть",
      "target": "Jobb volt a vámnál dolgozni? Ott legalább volt hatalmad.",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9548,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454665609226",
      "collection": "Dialogs",
      "key": "line:talk_wifefema_6_07fdcbb",
      "source": "Wifefema: Чего там?",
      "target": "Wifefema: Mi az?",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9549,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454665609225",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_5_0602a13",
      "source": "Wifefema: Ну, скажи пару ласковых, замолви словечко… А там, глядишь, и меня к делу подпустят.",
      "target": "Wifefema: Na, mondj rólam pár jó szót, járj közben az érdekemben… Talán akkor engem is beengednek dolgozni.",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9550,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454665609224",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_5_02cccc6",
      "source": "Wifefema: Скажи, мол, встретил женщину с нюхом, с характером, с прошлым опытом. Скажи, что она ещё и новый кадр им привела – мужа своего.",
      "target": "Wifefema: Mondd, hogy találkoztál egy jó szimatú, határozott nővel, akinek tapasztalata is van. Azt is mondd el, hogy új embert hozott nekik: a saját férjét.",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9551,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454665609223",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_5_0f80f1d",
      "source": "Wifefema: Позвони, а? По внутренней линии КЧС, у них там есть спецномер – {0}.",
      "target": "Wifefema: Telefonálj, jó? A KCsSz belső vonalán van egy külön számuk: {0}.",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9552,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454665609222",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_5_0db20bd",
      "source": "Wifefema: Слушай, у меня к тебе просьбочка есть.",
      "target": "Wifefema: Figyelj, lenne egy kis kérésem.",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9553,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454665609221",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_5_009791a",
      "source": "Wifefema: …",
      "target": "Wifefema: …",
      "authoredFile": "Translations/hu/dialogue-batch-038.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9554,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454665609220",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_5_0f842a4",
      "source": "Wifefema: Я его ненавижу всей душой.",
      "target": "Wifefema: Teljes szívemből gyűlölöm őt.",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9555,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454665609219",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_5_05b7177",
      "source": "Wifefema: Ей-богу, не понимаю. Это тупость…",
      "target": "Wifefema: Istenemre, nem értem. Ez ostobaság…",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9556,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454665609218",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_5_013d675",
      "source": "Wifefema: Это же беспредел! Привожу Гостя, исполняю свой гражданский долг, а работу дают ему?",
      "target": "Wifefema: Ez felháborító! Átadok nekik egy Vendéget, teljesítem az állampolgári kötelességemet, és ő kap munkát?",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9557,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454665609217",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_5_0c5e312",
      "source": "Wifefema: Хочу обжаловать отказ в работе в КЧС.",
      "target": "Wifefema: Fellebbezni akarok amiatt, hogy elutasították a jelentkezésemet a KCsSz-hez.",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9558,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454665609216",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_5_09daa28",
      "source": "Wifefema: Ну да, я сюда приехала, чтобы достучаться до руководства.",
      "target": "Wifefema: Igen, azért jöttem ide, hogy eljussak a vezetőséghez.",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9559,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454661414923",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_5_0788a17",
      "source": "Wifefema: И что с того?",
      "target": "Wifefema: És akkor mi van?",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9560,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454661414922",
      "collection": "Dialogs",
      "key": "line:talk_wifefema_5_0c34417",
      "source": "Мне надо тебя проверить",
      "target": "Meg kell vizsgálnom téged",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9561,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454661414921",
      "collection": "Dialogs",
      "key": "line:talk_wifefema_5_0c2d34c",
      "source": "Тебе ведь нужен не муж, а КЧС, верно?",
      "target": "Nem is a férjed kell neked, hanem a KCsSz, igaz?",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9562,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454661414920",
      "collection": "Dialogs",
      "key": "line:talk_wifefema_5_0346d5c",
      "source": "Wifefema: Чего там?",
      "target": "Wifefema: Mi az?",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9563,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454661414919",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_4_049cbdb",
      "source": "Wifefema: Вот тут-то я и поняла, что мне НУЖНА эта работа в КЧС!",
      "target": "Wifefema: Akkor értettem meg, hogy NEKEM KELL ez a munka a KCsSz-nél!",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9564,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454661414918",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_4_061150f",
      "source": "Wifefema: Это, знаете, напомнило мне времена, когда я работала на таможне…",
      "target": "Wifefema: Tudja, eszembe jutott, amikor a vámnál dolgoztam…",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9565,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454661414917",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_4_0dc31bd",
      "source": "Wifefema: Скажу вам начистоту, мне было приятно его сдать.",
      "target": "Wifefema: Őszintén szólva jólesett feljelentenem.",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9566,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454661414916",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_4_09fd465",
      "source": "Wifefema: К тому же он мне противен.",
      "target": "Wifefema: Ráadásul undorodom tőle.",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9567,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454661414915",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_4_041519e",
      "source": "Wifefema: Я вроде вам русским языком сказала, он был Гостем.",
      "target": "Wifefema: Azt hiszem, világosan megmondtam: Vendég volt.",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9568,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454661414914",
      "collection": "Dialogs",
      "key": "line:talk_wifefema_4_00e9170",
      "source": "Мне надо тебя проверить",
      "target": "Meg kell vizsgálnom téged",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9569,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454661414913",
      "collection": "Dialogs",
      "key": "line:talk_wifefema_4_036dbf6",
      "source": "Почему ты сдала своего соседа?",
      "target": "Miért jelentetted fel a szomszédodat?",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9570,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454661414912",
      "collection": "Dialogs",
      "key": "line:talk_wifefema_4_0605974",
      "source": "Wifefema: Чего там?",
      "target": "Wifefema: Mi az?",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9571,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454657220619",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_3_0adc633",
      "source": "Wifefema: Честно говоря, обидно, знаете ли.",
      "target": "Wifefema: Őszintén szólva bánt a dolog.",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9572,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454657220618",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_3_07b824a",
      "source": "Wifefema: …",
      "target": "Wifefema: …",
      "authoredFile": "Translations/hu/dialogue-batch-038.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9573,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454657220617",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_3_0b1a7cb",
      "source": "Wifefema: Я, конечно, очень горда тем, что хотя бы мой муж попал в ряды сотрудников КЧС, но…",
      "target": "Wifefema: Persze nagyon büszke vagyok rá, hogy legalább a férjem bekerült a KCsSz munkatársai közé, de…",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9574,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454657220616",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_3_0703a65",
      "source": "Wifefema: Вот только… это. Я донесла на него в КЧС! Но они взяли не меня, а МУЖА!",
      "target": "Wifefema: Csakhogy… ez az. Én jelentettem fel őt a KCsSz-nél! Ők mégsem engem vettek fel, hanem a FÉRJEMET!",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9575,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454657220615",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_3_0b45277",
      "source": "Wifefema: Вот уже внесла свой вклад, сдав нашего соседа.",
      "target": "Wifefema: Már hozzá is járultam az ügyhöz azzal, hogy feljelentettem a szomszédunkat.",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9576,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454657220614",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_3_004814b",
      "source": "Wifefema: Я верю, что Гостей можно и нужно остановить.",
      "target": "Wifefema: Hiszem, hogy a Vendégeket meg lehet és meg is kell állítani.",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9577,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454657220613",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_3_0513f59",
      "source": "Wifefema: Хочу быть причастной к правому делу.",
      "target": "Wifefema: Részt akarok venni ebben az igaz ügyben.",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9578,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454657220612",
      "collection": "Dialogs",
      "key": "line:talk_wifefema_3_06ef036",
      "source": "Мне надо тебя проверить",
      "target": "Meg kell vizsgálnom téged",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9579,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454657220611",
      "collection": "Dialogs",
      "key": "line:talk_wifefema_3_060dbf7",
      "source": "Почему ты так хочешь работать в КЧС?",
      "target": "Miért akarsz ennyire a KCsSz-nél dolgozni?",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9580,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454657220610",
      "collection": "Dialogs",
      "key": "line:talk_wifefema_3_0e8d5e7",
      "source": "Wifefema: Чего там?",
      "target": "Wifefema: Mi az?",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9581,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454657220609",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_2_0fa0964",
      "source": "Wifefema: Вот только в КЧС бы взяли…",
      "target": "Wifefema: Csak felvennének már a KCsSz-hez…",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9582,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454657220608",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_2_07276bf",
      "source": "Wifefema: Но ничего, пройдёт время, и я научусь их чуять так же легко, как тогда, на таможне.",
      "target": "Wifefema: De sebaj, idővel megtanulom ugyanolyan könnyen kiszimatolni őket, mint akkor a vámnál.",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9583,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454653026316",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_2_09c0723",
      "source": "Wifefema: Ей-богу, я бы их всех перебила, если бы могла.",
      "target": "Wifefema: Istenemre, mindegyiküket megölném, ha tehetném.",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9584,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454653026315",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_2_03a6430",
      "source": "Wifefema: Из-за них начались взрывы на солнце, а ходить по улице теперь опасно.",
      "target": "Wifefema: Miattuk kezdődtek a napkitörések, és most veszélyes az utcára menni.",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9585,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454653026314",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_2_01cbb90",
      "source": "Wifefema: От них все беды. Вы не смотрите телевизор?",
      "target": "Wifefema: Minden baj miattuk van. Maga nem néz tévét?",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9586,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454653026313",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_2_0916740",
      "source": "Wifefema: Что за глупый вопрос?",
      "target": "Wifefema: Micsoda ostoba kérdés!",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9587,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454653026312",
      "collection": "Dialogs",
      "key": "line:talk_wifefema_2_01767aa",
      "source": "Мне надо тебя проверить",
      "target": "Meg kell vizsgálnom téged",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9588,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454653026311",
      "collection": "Dialogs",
      "key": "line:talk_wifefema_2_0077962",
      "source": "Почему ты ненавидишь Гостей?",
      "target": "Miért gyűlölöd a Vendégeket?",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9589,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454653026310",
      "collection": "Dialogs",
      "key": "line:talk_wifefema_2_01f9393",
      "source": "Wifefema: Чего там?",
      "target": "Wifefema: Mi az?",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9590,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454653026309",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_1_07c499d",
      "source": "Wifefema: Назвали бы как-то более очевидно.",
      "target": "Wifefema: Adhattak volna nekik valami egyértelműbb nevet.",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9591,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454653026308",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_1_060cf4b",
      "source": "Wifefema: Кто вообще придумал называть этих нелюдей Гостями?",
      "target": "Wifefema: Ki találta ki egyáltalán, hogy ezeket a nem emberi lényeket Vendégeknek hívják?",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9592,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454653026307",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_1_06c57e6",
      "source": "Wifefema: Блин, ну масло масляное, честное слово.",
      "target": "Wifefema: A francba, ez kész szóismétlés, komolyan.",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9593,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454653026306",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_1_0894118",
      "source": "Wifefema: Слушай, а ты уже проверял признаки Гостей?",
      "target": "Wifefema: Figyelj, te már ellenőrizted a Vendégek jeleit?",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9594,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454653026305",
      "collection": "Dialogs",
      "key": "line:Wifefema_Asking_1_0da3a50",
      "source": "Wifefema: Да, это правда.",
      "target": "Wifefema: Igen, ez igaz.",
      "authoredFile": "Translations/hu/dialogue-batch-305.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9595,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454653026304",
      "collection": "Dialogs",
