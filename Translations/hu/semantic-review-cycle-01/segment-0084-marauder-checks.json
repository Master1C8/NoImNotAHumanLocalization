    },
    {
      "ordinal": 12904,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453138882565",
      "collection": "Dialogs",
      "key": "line:Marauder_Teeth_099b960",
      "source": "Marauder: Я однажды видел такие зубы. А, ну, да. Сначала свои показать, а потом уже история.",
      "target": "Marauder: Egyszer láttam ilyen fogakat. Á, igen. Előbb a sajátomat mutatom meg, aztán jöhet a történet.",
      "authoredFile": "Translations/hu/dialogue-batch-392.json",
      "reviewResult": "proposed correction"
    },
