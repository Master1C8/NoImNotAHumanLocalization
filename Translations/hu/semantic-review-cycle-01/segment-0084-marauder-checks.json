      "collection": "Dialogs",
      "key": "line:Marauder_Photo_0046e8d",
      "source": "Marauder: Ну ладно. Твой дом – твои правила…",
      "target": "Marauder: Jól van. A te házad, a te szabályaid…",
      "authoredFile": "Translations/hu/dialogue-batch-392.json",
