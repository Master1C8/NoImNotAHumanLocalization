    },
    {
      "ordinal": 14593,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452396490758",
      "collection": "Dialogs",
      "key": "line:Blind_Teeth_0352817",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14594,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452396490757",
      "collection": "Dialogs",
      "key": "line:Blind_Teeth_05fee81",
      "source": "Blind: Теперь мои руки цепляются за пустоту. Ждут, пока смерть позволит мне забыть всё.",
      "target": "Blind: Most a kezeim a semmibe kapaszkodnak. Várják, hogy a halál végre megengedje, hogy mindent elfelejtsek.",
      "authoredFile": "Translations/hu/dialogue-batch-433.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14595,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452396490756",
      "collection": "Dialogs",
      "key": "line:Blind_Teeth_06e1df9",
      "source": "Blind: Пальцы мои сжались до боли, когда я скользнул взглядом по ЭТОМУ.",
      "target": "Blind: Az ujjaim fájdalomig összeszorultak, amikor végigsiklott a tekintetem AZON.",
      "authoredFile": "Translations/hu/dialogue-batch-433.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14596,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452396490755",
      "collection": "Dialogs",
      "key": "line:Blind_Teeth_07a427c",
      "source": "Blind: Я жевал правду, давился ею, пока нёбо не сомкнулось у меня в горле.",
      "target": "Blind: Rágtam az igazságot, fuldokoltam tőle, míg a szájpadlásom össze nem zárult a torkomban.",
      "authoredFile": "Translations/hu/dialogue-batch-433.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14597,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452396490754",
      "collection": "Dialogs",
      "key": "line:Blind_Teeth_0b8c49c",
      "source": "Blind: ...",
