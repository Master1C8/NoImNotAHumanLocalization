    },
    {
      "ordinal": 14584,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452396490767",
      "collection": "Dialogs",
      "key": "line:Blind_Hands_0529bb5",
      "source": "Отпустить",
