    },
    {
      "ordinal": 14542,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452417462278",
      "collection": "Dialogs",
      "key": "line:Blind_Ears_Gun_04aadea",
      "source": "Blind: Как воздух шевелится, когда оно вдыхает твой запах…",
      "target": "Blind: Ahogy megmozdul a levegő, amikor beszívja a szagodat…",
      "authoredFile": "Translations/hu/dialogue-batch-433.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14543,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452417462277",
      "collection": "Dialogs",
      "key": "line:Blind_Ears_Gun_0491f5d",
      "source": "Blind: Как его шаги путаются с твоими…",
      "target": "Blind: Ahogy a léptei összekeverednek a tieiddel…",
      "authoredFile": "Translations/hu/dialogue-batch-433.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14544,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452417462276",
      "collection": "Dialogs",
      "key": "line:Blind_Ears_Gun_0ab0654",
      "source": "Blind: Если бы ты слышал, как оно скользит…",
      "target": "Blind: Ha hallanád, ahogy siklik…",
      "authoredFile": "Translations/hu/dialogue-batch-433.json",
      "reviewResult": "pass"
    },
    {
