    },
    {
      "ordinal": 14585,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452396490766",
      "collection": "Dialogs",
      "key": "line:Blind_Hands_0c41e50",
      "source": "Blind: Стены, стены, двери, окна, а ОНО было рядом…",
      "target": "Blind: Falak, falak, ajtók, ablakok, és AZ ott volt mellettem…",
      "authoredFile": "Translations/hu/dialogue-batch-433.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14586,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452396490765",
      "collection": "Dialogs",
      "key": "line:Blind_Hands_0f2f279",
      "source": "Blind: Череп крепко разворочен, и мозги текли сквозь стены",
      "target": "Blind: A koponya szétzúzva, az agy átfolyt a falakon",
      "authoredFile": "Translations/hu/dialogue-batch-433.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14587,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452396490764",
      "collection": "Dialogs",
      "key": "line:Blind_Hands_0c0e823",
      "source": "Blind: Стал я жрать, орать, блевать, себя на части раздирать",
      "target": "Blind: Zabáltam, ordítottam, hánytam, magamat darabokra téptem",
      "authoredFile": "Translations/hu/dialogue-batch-433.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14588,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452396490763",
      "collection": "Dialogs",
      "key": "line:Blind_Hands_0db0eea",
      "source": "Blind: Но тогда… Тогда…",
      "target": "Blind: De akkor… Akkor…",
      "authoredFile": "Translations/hu/dialogue-batch-433.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14589,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452396490762",
      "collection": "Dialogs",
      "key": "line:Blind_Hands_045a91f",
      "source": "Blind: Ха. Хорошо. Значит, ещё не всё из меня вытянуло.",
      "target": "Blind: Ha. Jó. Szóval még nem szívott ki belőlem mindent.",
      "authoredFile": "Translations/hu/dialogue-batch-433.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14590,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452396490761",
      "collection": "Dialogs",
