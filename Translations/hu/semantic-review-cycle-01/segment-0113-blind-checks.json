    {
      "ordinal": 14582,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452404879361",
      "collection": "Dialogs",
      "key": "line:Blind_Eyes_0607280",
      "source": "Blind: Хахахаахаха…Ладно, ничего в этом необычного нет. Вот они!",
      "target": "Blind: Hahahahaha… Na jó, ebben nincs semmi különös. Itt vannak!",
      "authoredFile": "Translations/hu/dialogue-batch-433.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14583,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452404879360",
      "collection": "Dialogs",
      "key": "line:Blind_Hands_0a6da15",
