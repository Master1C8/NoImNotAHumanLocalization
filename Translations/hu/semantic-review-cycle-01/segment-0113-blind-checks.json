    },
    {
      "ordinal": 14575,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452404879368",
      "collection": "Dialogs",
      "key": "line:Blind_Armpit_0203ae9",
      "source": "Blind: Ты знаешь, что первым покрывает липкая тень?",
