    {
      "ordinal": 12206,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453533147139",
      "collection": "Dialogs",
      "key": "line:Esenin_Armpit_DontShoot_0337120",
      "source": "Esenin: Иди-ка ты нахуй, а...",
      "target": "Esenin: Menj a picsába, jó...",
      "authoredFile": "Translations/hu/dialogue-batch-374.json",
