      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453512175622",
      "collection": "Dialogs",
      "key": "line:Esenin_Teeth_DontShoot_0589293",
      "source": "Esenin: Ну вот и иди нахуй.",
      "target": "Esenin: Akkor menj a picsába.",
      "authoredFile": "Translations/hu/dialogue-batch-374.json",
      "reviewResult": "pass"
    },
