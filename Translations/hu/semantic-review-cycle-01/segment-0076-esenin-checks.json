      "collection": "Dialogs",
      "key": "line:Esenin_Armpit_Gun_0252cb4",
      "source": "Esenin: Как это понимать?",
      "target": "Esenin: Ezt most hogy értsem?",
      "authoredFile": "Translations/hu/dialogue-batch-375.json",
      "reviewResult": "pass"
    },
