    {
      "ordinal": 12201,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453537341440",
      "collection": "Dialogs",
      "key": "line:Esenin_Ears_DontShoot_0e53182",
      "source": "Esenin: Как тут оставаться трезвым...",
      "target": "Esenin: Így mégis hogy maradjon józan az ember...",
      "authoredFile": "Translations/hu/dialogue-batch-374.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12202,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453533147143",
      "collection": "Dialogs",
      "key": "line:Esenin_Ears_DontShoot_0d39981",
      "source": "Esenin: Либо сплошные нытики вокруг, либо психопаты...",
      "target": "Esenin: Körülöttem vagy csak nyafogók vannak, vagy pszichopaták...",
      "authoredFile": "Translations/hu/dialogue-batch-374.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12203,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453533147142",
      "collection": "Dialogs",
      "key": "line:Esenin_Photo_DontShoot_094ca32",
      "source": "Esenin: Или что теперь лучше говорить?..",
      "target": "Esenin: Vagy most inkább mit kellene mondanom?..",
      "authoredFile": "Translations/hu/dialogue-batch-374.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12204,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453533147141",
