  "rows": [
    {
      "ordinal": 13083,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453050802180",
      "collection": "Dialogs",
      "key": "line:Edgar_Death_00f6124",
      "source": "Edgar: Дорогая…",
      "target": "Edgar: Kedvesem…",
      "authoredFile": "Translations/hu/dialogue-batch-397.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13084,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453050802179",
      "collection": "Dialogs",
      "key": "line:Edgar_Death_02c3b4e",
      "source": "Edgar: Я иду к тебе…",
      "target": "Edgar: Megyek hozzád…",
      "authoredFile": "Translations/hu/dialogue-batch-397.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13085,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453050802178",
      "collection": "Dialogs",
      "key": "line:Edgar_Ears_DontShoot_0619eb9",
      "source": "Edgar: Наверное, потому что мне хотелось думать, что это что-то хорошее. Но она была уже мертва…",
      "target": "Edgar: Talán azért, mert hinni akartam, hogy valami jó. De ő már halott volt…",
      "authoredFile": "Translations/hu/dialogue-batch-397.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13086,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453050802177",
      "collection": "Dialogs",
      "key": "line:Edgar_Ears_DontShoot_04c0fe5",
      "source": "Edgar: Она любила шептать мне на ухо. Я никогда не понимал, что именно.",
      "target": "Edgar: Szeretett a fülembe suttogni. Sosem értettem, hogy mit.",
      "authoredFile": "Translations/hu/dialogue-batch-397.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13087,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453050802176",
      "collection": "Dialogs",
      "key": "line:Edgar_Photo_DontShoot_0ebd97c",
      "source": "Edgar: Но я всего лишь безнадёжный романтик… И ей суждено жить только в моих воспоминаниях, пока не исчезну сам.",
      "target": "Edgar: De én csak reménytelen romantikus vagyok… És ő már csak az emlékeimben élhet, amíg én is el nem tűnök.",
      "authoredFile": "Translations/hu/dialogue-batch-397.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13088,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453046607880",
      "collection": "Dialogs",
      "key": "line:Edgar_Photo_DontShoot_0594fb5",
      "source": "Edgar: Фотографии хранят внешность, но не суть человека. Будь я художником, сохранил бы её образ на холсте.",
      "target": "Edgar: A fényképek megőrzik a külsőt, de az ember lényegét nem. Ha festő volnék, vászonra vinném az alakját.",
      "authoredFile": "Translations/hu/dialogue-batch-397.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13089,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453046607879",
      "collection": "Dialogs",
      "key": "line:Edgar_Armpit_DontShoot_0f015dd",
      "source": "Edgar: А что, если наоборот?",
      "target": "Edgar: És ha épp fordítva van?",
      "authoredFile": "Translations/hu/dialogue-batch-397.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13090,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453046607878",
      "collection": "Dialogs",
      "key": "line:Edgar_Armpit_DontShoot_0ffdf00",
      "source": "Edgar: Смешно… Говорят, живые перенимают что-то у мёртвых, если долго находятся рядом.",
      "target": "Edgar: Furcsa… Azt mondják, az élők átvesznek valamit a holtaktól, ha sokáig vannak a közelükben.",
      "authoredFile": "Translations/hu/dialogue-batch-397.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13091,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453046607877",
      "collection": "Dialogs",
      "key": "line:Edgar_Eyes_DontShoot_0ad0e10",
      "source": "Edgar: Чужие слова, чужие голоса. Мёртвые говорят вместо неё.",
      "target": "Edgar: Mások szavai, mások hangjai. A holtak beszélnek helyette.",
      "authoredFile": "Translations/hu/dialogue-batch-397.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13092,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453046607876",
      "collection": "Dialogs",
      "key": "line:Edgar_Eyes_DontShoot_0a774c3",
      "source": "Edgar: А теперь… только пустота. Чёрная дыра. Засасывает, тянет внутрь. И чем дольше смотришь, тем больше понимаешь – это не её взгляд. Это эхо.",
      "target": "Edgar: Most pedig… csak az üresség. Egy fekete lyuk. Beszippant, magába húz. És minél tovább nézed, annál inkább érted: ez nem az ő tekintete. Csak a visszhangja.",
      "authoredFile": "Translations/hu/dialogue-batch-397.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13093,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453046607875",
      "collection": "Dialogs",
      "key": "line:Edgar_Eyes_DontShoot_0f575d0",
      "source": "Edgar: Когда я смотрел в её глаза… мне казалось, что там отражается небо. Всегда.",
      "target": "Edgar: Amikor a szemébe néztem… mindig úgy éreztem, az ég tükröződik benne.",
      "authoredFile": "Translations/hu/dialogue-batch-397.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13094,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453046607874",
      "collection": "Dialogs",
      "key": "line:Edgar_Eyes_DontShoot_0499c15",
      "source": "Edgar: Так-то лучше.",
      "target": "Edgar: Így már jobb.",
      "authoredFile": "Translations/hu/dialogue-batch-397.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13095,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453046607873",
      "collection": "Dialogs",
      "key": "line:Edgar_Hands_DontShoot_027ec51",
      "source": "Edgar: Мне казалось, если хотя бы одна часть меня останется чистой, это будет напоминанием. Но теперь… смысл в этом всём?..",
      "target": "Edgar: Azt hittem, ha legalább egy részem tiszta marad, emlékeztetőül szolgál majd. De most… mi értelme az egésznek?..",
      "authoredFile": "Translations/hu/dialogue-batch-397.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13096,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453046607872",
      "collection": "Dialogs",
      "key": "line:Edgar_Hands_DontShoot_0466f2a",
      "source": "Edgar: Я так долго пытался сохранить руку…",
      "target": "Edgar: Olyan sokáig próbáltam megóvni a kezemet…",
      "authoredFile": "Translations/hu/dialogue-batch-397.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13097,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453042413573",
      "collection": "Dialogs",
      "key": "line:Edgar_Teeth_DontShoot_004d6f5",
      "source": "Edgar: Знаешь… она всегда целовала меня так, будто боялась, что делает это в последний раз. Теперь я понимаю почему.",
      "target": "Edgar: Tudod… mindig úgy csókolt meg, mintha attól félt volna, hogy utoljára teszi. Most már értem, miért.",
      "authoredFile": "Translations/hu/dialogue-batch-397.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13098,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453042413572",
      "collection": "Dialogs",
      "key": "line:Edgar_Ears_Gun_04a976c",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
