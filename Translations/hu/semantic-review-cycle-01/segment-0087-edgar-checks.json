    },
    {
      "ordinal": 13103,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453038219273",
      "collection": "Dialogs",
      "key": "line:Edgar_Photo_Gun_0d84504",
      "source": "Edgar: Интересно…",
      "target": "Edgar: Érdekes…",
      "authoredFile": "Translations/hu/dialogue-batch-397.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13104,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453038219272",
      "collection": "Dialogs",
      "key": "line:Edgar_Armpit_Gun_0c1d89b",
