      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13105,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453038219271",
      "collection": "Dialogs",
      "key": "line:Edgar_Armpit_Gun_0e4fbd3",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13106,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453038219270",
      "collection": "Dialogs",
      "key": "line:Edgar_Armpit_Gun_05ebfd2",
      "source": "Edgar: Знаешь, когда долго лежишь рядом с кем-то… начинаешь перенимать его черты. Мне кажется, я стал её частью.",
      "target": "Edgar: Tudod, ha sokáig fekszel valaki mellett… lassan átveszed a vonásait. Azt hiszem, a részévé váltam.",
      "authoredFile": "Translations/hu/dialogue-batch-397.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13107,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453038219269",
      "collection": "Dialogs",
      "key": "line:Edgar_Eyes_Gun_08c5be6",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13108,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453038219268",
      "collection": "Dialogs",
      "key": "line:Edgar_Eyes_Gun_0cbe833",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13109,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453038219267",
      "collection": "Dialogs",
      "key": "line:Edgar_Eyes_Gun_0dca5b5",
      "source": "Edgar: Дай мне уйти самостоятельно. Прибереги патроны…",
      "target": "Edgar: Hadd menjek el a magam módján. Tartsd meg a töltényeidet…",
      "authoredFile": "Translations/hu/dialogue-batch-397.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13110,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453038219266",
      "collection": "Dialogs",
      "key": "line:Edgar_Hands_Gun_0141301",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13111,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453038219265",
      "collection": "Dialogs",
      "key": "line:Edgar_Hands_Gun_09524be",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13112,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453038219264",
      "collection": "Dialogs",
      "key": "line:Edgar_Hands_Gun_0d8d1b6",
      "source": "Edgar: Знаешь, мне хотелось уйти по-своему, а не так…",
      "target": "Edgar: Tudod, a magam módján szerettem volna távozni, nem így…",
      "authoredFile": "Translations/hu/dialogue-batch-397.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13113,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453034024969",
      "collection": "Dialogs",
