    {
      "ordinal": 13100,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453042413570",
      "collection": "Dialogs",
      "key": "line:Edgar_Ears_Gun_0c34a00",
      "source": "Edgar: Что ж…",
      "target": "Edgar: Hát akkor…",
      "authoredFile": "Translations/hu/dialogue-batch-397.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13101,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453042413569",
