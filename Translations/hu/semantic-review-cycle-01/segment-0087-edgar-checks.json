      "reviewResult": "pass"
    },
    {
      "ordinal": 13117,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453034024965",
      "collection": "Dialogs",
      "key": "line:Edgar_Ears_0c799f0",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13118,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453034024964",
      "collection": "Dialogs",
      "key": "line:Edgar_Ears_00177ca",
      "source": "Edgar: Одно из немногого, что осталось прежним.",
      "target": "Edgar: Egyike annak a kevés dolognak, ami változatlan maradt.",
      "authoredFile": "Translations/hu/dialogue-batch-398.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13119,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453034024963",
