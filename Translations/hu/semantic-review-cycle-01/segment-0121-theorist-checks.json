    },
    {
      "ordinal": 15238,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452161609733",
      "collection": "Dialogs",
      "key": "line:Theorist_Teeth_Gun_0559f9f",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15239,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452161609732",
      "collection": "Dialogs",
      "key": "line:Theorist_Teeth_Gun_070ed5c",
      "source": "Theorist: Стреляйте, но знайте: вам в рот тоже могут что-то подложить. Пища давно уже не просто пища…",
      "target": "Theorist: Lőjön, de tudja: az ön szájába is tehetnek valamit. Az étel már régen nem csupán étel…",
      "authoredFile": "Translations/hu/dialogue-batch-448.json",
      "reviewResult": "pass"
    },
    {
