    },
    {
      "ordinal": 15236,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452161609735",
      "collection": "Dialogs",
      "key": "line:Theorist_Hands_Gun_0a282ec",
      "source": "Theorist: Вы боитесь тех, кто ищет правду? Тогда вы боитесь не меня, а себя.",
      "target": "Theorist: Fél azoktól, akik az igazságot keresik? Akkor nem tőlem fél, hanem önmagától.",
      "authoredFile": "Translations/hu/dialogue-batch-448.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15237,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452161609734",
