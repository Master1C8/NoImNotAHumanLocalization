      "collection": "Dialogs",
      "key": "line:Theorist_Armpit_0359fd6",
      "source": "Theorist: Подмышки, говорите?.. Это редкость.",
      "target": "Theorist: A hónaljam, mondja?.. Ez ritka kérés.",
      "authoredFile": "Translations/hu/dialogue-batch-448.json",
