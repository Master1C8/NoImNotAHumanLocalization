    {
      "ordinal": 15235,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452161609736",
      "collection": "Dialogs",
      "key": "line:Theorist_Hands_Gun_0119949",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
