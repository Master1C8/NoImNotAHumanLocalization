    {
      "ordinal": 12164,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453554118661",
      "collection": "Dialogs",
      "key": "line:Daughter_Hands_DontShoot_0ebe95a",
      "source": "Daughter: Так, всё. Я не плачу. Я взрослая девочка...",
      "target": "Daughter: Na, kész. Nem sírok. Már nagy lány vagyok...",
      "authoredFile": "Translations/hu/dialogue-batch-373.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12165,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453554118660",
      "collection": "Dialogs",
      "key": "line:Daughter_Hands_DontShoot_0d570aa",
      "source": "Daughter: Папка...",
      "target": "Daughter: Apuci...",
      "authoredFile": "Translations/hu/dialogue-batch-373.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12166,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453554118659",
      "collection": "Dialogs",
      "key": "line:Daughter_Hands_DontShoot_06cf86d",
      "source": "Daughter: Папа говорит, что я такой красавицей уродилась в нашу маму!",
      "target": "Daughter: Apa azt mondja, olyan szépnek születtem, mint anya!",
      "authoredFile": "Translations/hu/dialogue-batch-373.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12167,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453554118658",
      "collection": "Dialogs",
      "key": "line:Daughter_Hands_DontShoot_09523f8",
      "source": "Daughter: Прямо как у меня!",
      "target": "Daughter: Pont olyan, mint nekem!",
      "authoredFile": "Translations/hu/dialogue-batch-373.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12168,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453554118657",
      "collection": "Dialogs",
      "key": "line:Daughter_Hands_DontShoot_06a66f4",
      "source": "Daughter: Ещё у неё платье тоже было очень-очень красивое!",
      "target": "Daughter: És neki is nagyon-nagyon szép ruhája volt!",
      "authoredFile": "Translations/hu/dialogue-batch-373.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12169,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453554118656",
      "collection": "Dialogs",
      "key": "line:Daughter_Hands_DontShoot_0de2a20",
      "source": "Daughter: Помню только, что они красивые были.",
      "target": "Daughter: Csak arra emlékszem, hogy szépek voltak.",
      "authoredFile": "Translations/hu/dialogue-batch-373.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12170,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453549924359",
      "collection": "Dialogs",
      "key": "line:Daughter_Hands_DontShoot_0d41c27",
      "source": "Daughter: Но я уже плохо их помню.",
      "target": "Daughter: De már alig emlékszem rájuk.",
      "authoredFile": "Translations/hu/dialogue-batch-373.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12171,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453549924358",
      "collection": "Dialogs",
      "key": "line:Daughter_Hands_DontShoot_0e952bd",
      "source": "Daughter: Мне очень нравились ногти мамы.",
      "target": "Daughter: Nagyon tetszettek anya körmei.",
      "authoredFile": "Translations/hu/dialogue-batch-373.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12172,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453549924357",
      "collection": "Dialogs",
      "key": "line:Daughter_Hands_Gun_0dcea17",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12173,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453549924356",
      "collection": "Dialogs",
      "key": "line:Daughter_Hands_Gun_067ffb8",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12174,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453549924355",
      "collection": "Dialogs",
      "key": "line:Daughter_Hands_Gun_01348f5",
      "source": "Daughter: Я же показала вам свои ноготочки!..",
      "target": "Daughter: Hiszen megmutattam magának a körmöcskéimet!..",
      "authoredFile": "Translations/hu/dialogue-batch-373.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12175,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453549924354",
      "collection": "Dialogs",
      "key": "line:Daughter_Hands_Gun_08c83ee",
      "source": "Daughter: Можете, пожалуйста, не пугать меня так!",
      "target": "Daughter: Kérem, ne ijesztgessen így!",
      "authoredFile": "Translations/hu/dialogue-batch-373.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12176,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453549924353",
      "collection": "Dialogs",
      "key": "line:Daughter_Hands_Gun_0b6ccca",
      "source": "Daughter: Мне не нравится эта игра...",
      "target": "Daughter: Nem szeretem ezt a játékot...",
      "authoredFile": "Translations/hu/dialogue-batch-373.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12177,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453549924352",
      "collection": "Dialogs",
      "key": "line:Daughter_Hands_0b98b2f",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12178,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453545730055",
      "collection": "Dialogs",
      "key": "line:Daughter_Hands_0dff554",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12179,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453545730054",
      "collection": "Dialogs",
      "key": "line:Daughter_Teeth_DontShoot_035cfe0",
      "source": "Daughter: ...",
      "target": "Daughter: ...",
      "authoredFile": "Translations/hu/dialogue-batch-039.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12180,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453545730053",
      "collection": "Dialogs",
      "key": "line:Daughter_Teeth_DontShoot_0e56072",
      "source": "Daughter: А у меня и ничего ценного нет, чтобы спрятать...",
      "target": "Daughter: Nekem nincs is semmi értékesem, amit elrejthetnék...",
      "authoredFile": "Translations/hu/dialogue-batch-373.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12181,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453545730052",
      "collection": "Dialogs",
      "key": "line:Daughter_Teeth_DontShoot_0580ab4",
      "source": "Daughter: ...",
      "target": "Daughter: ...",
      "authoredFile": "Translations/hu/dialogue-batch-039.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12182,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453545730051",
      "collection": "Dialogs",
      "key": "line:Daughter_Teeth_DontShoot_06dd786",
      "source": "Daughter: А я ж клад не успела спрятать!",
      "target": "Daughter: Jaj, nem volt időm elrejteni a kincset!",
      "authoredFile": "Translations/hu/dialogue-batch-373.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12183,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453545730050",
      "collection": "Dialogs",
      "key": "line:Daughter_Teeth_DontShoot_04763cd",
      "source": "Daughter: Ой...",
      "target": "Daughter: Jaj...",
      "authoredFile": "Translations/hu/dialogue-batch-373.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12184,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453545730049",
      "collection": "Dialogs",
      "key": "line:Daughter_Teeth_DontShoot_0c4d326",
      "source": "Daughter: Вы тоже с ним играли в эту игру, когда были маленькими, а теперь со мной играете?",
      "target": "Daughter: Maga is játszott vele ilyet, amikor kicsi volt, és most velem játszik?",
      "authoredFile": "Translations/hu/dialogue-batch-373.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12185,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453545730048",
      "collection": "Dialogs",
      "key": "line:Daughter_Teeth_DontShoot_00290cc",
      "source": "Daughter: Ой, я вспомнила! Она вроде называется казаки-разбойники!",
      "target": "Daughter: Jaj, eszembe jutott! Azt hiszem, Kozákok és rablók a neve!",
      "authoredFile": "Translations/hu/dialogue-batch-373.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12186,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453541535751",
      "collection": "Dialogs",
      "key": "line:Daughter_Teeth_DontShoot_0e59804",
      "source": "Daughter: Только папа говорил, что они пользовались палочками.",
      "target": "Daughter: Csak apa azt mondta, ők botokat használtak.",
      "authoredFile": "Translations/hu/dialogue-batch-373.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12187,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453541535750",
      "collection": "Dialogs",
      "key": "line:Daughter_Teeth_DontShoot_048a97b",
      "source": "Daughter: И все они там ходят с оружием!",
      "target": "Daughter: És ott mindenkinek fegyvere van!",
      "authoredFile": "Translations/hu/dialogue-batch-373.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12188,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453541535749",
      "collection": "Dialogs",
      "key": "line:Daughter_Teeth_DontShoot_0b6af69",
      "source": "Daughter: А другие должны победить всех первых или найти клад.",
      "target": "Daughter: A másik csapatnak le kell győznie az elsőt, vagy meg kell találnia a kincset.",
      "authoredFile": "Translations/hu/dialogue-batch-373.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12189,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453541535748",
      "collection": "Dialogs",
      "key": "line:Daughter_Teeth_DontShoot_0e72c3f",
      "source": "Daughter: А потом одна команда прячет клад, а ещё рисует тюрьму, куда потом из другой команды будет кого-то вести.",
      "target": "Daughter: Az egyik csapat elrejti a kincset, és még egy börtönt is rajzol, ahová a másik csapatból valakit elvezetnek.",
      "authoredFile": "Translations/hu/dialogue-batch-373.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12190,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453541535747",
      "collection": "Dialogs",
      "key": "line:Daughter_Teeth_DontShoot_077988a",
      "source": "Daughter: Там, в общем, делатся на две команды.",
      "target": "Daughter: Szóval két csapatra oszlanak.",
      "authoredFile": "Translations/hu/dialogue-batch-373.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12191,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453541535746",
      "collection": "Dialogs",
      "key": "line:Daughter_Teeth_DontShoot_04b0b95",
      "source": "Daughter: Папа мне как-то рассказывал про игру такую!",
      "target": "Daughter: Apa egyszer mesélt nekem egy ilyen játékról!",
      "authoredFile": "Translations/hu/dialogue-batch-373.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12192,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453541535745",
      "collection": "Dialogs",
      "key": "line:Daughter_Teeth_Gun_0ae429e",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12193,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453541535744",
      "collection": "Dialogs",
      "key": "line:Daughter_Teeth_Gun_0bd328c",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12194,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453537341447",
      "collection": "Dialogs",
      "key": "line:Daughter_Teeth_Gun_0d7ee81",
      "source": "Daughter: Правда, я не знаю, что это за игра такая!",
      "target": "Daughter: Pedig nem is tudom, miféle játék ez!",
      "authoredFile": "Translations/hu/dialogue-batch-373.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12195,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453537341446",
      "collection": "Dialogs",
      "key": "line:Daughter_Teeth_Gun_0fe71f3",
      "source": "Daughter: Вы победили!",
      "target": "Daughter: Maga nyert!",
      "authoredFile": "Translations/hu/dialogue-batch-373.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12196,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453537341445",
      "collection": "Dialogs",
      "key": "line:Daughter_Teeth_Gun_0639080",
      "source": "Daughter: Я сдаюсь, сдаюсь!",
      "target": "Daughter: Megadom magam, megadom magam!",
      "authoredFile": "Translations/hu/dialogue-batch-373.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12197,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453537341444",
      "collection": "Dialogs",
