    },
    {
      "ordinal": 12113,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453579284487",
      "collection": "Dialogs",
      "key": "line:Daughter_Death_0eed827",
      "source": "Daughter: Папочка...",
      "target": "Daughter: Apuci...",
      "authoredFile": "Translations/hu/dialogue-batch-371.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12114,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453579284486",
      "collection": "Dialogs",
      "key": "line:Daughter_Ears_DontShoot_0b73773",
      "source": "Daughter: Надо бы сходить к моей подружке, как папа за мной зайдёт...",
      "target": "Daughter: El kellene mennem a barátnőmhöz, ha apa eljön értem...",
      "authoredFile": "Translations/hu/dialogue-batch-371.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12115,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453579284485",
      "collection": "Dialogs",
      "key": "line:Daughter_Ears_DontShoot_01d49b0",
      "source": "Daughter: Мне вот папа тоже запрещает, но не всё же!",
      "target": "Daughter: Nekem is megtilt ezt-azt apa, de azért nem mindent!",
      "authoredFile": "Translations/hu/dialogue-batch-371.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12116,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453579284484",
      "collection": "Dialogs",
      "key": "line:Daughter_Ears_DontShoot_0bfa33d",
      "source": "Daughter: Может быть, её мама Гость?",
      "target": "Daughter: Lehet, hogy az ő anyukája Vendég?",
      "authoredFile": "Translations/hu/dialogue-batch-371.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12117,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453579284483",
      "collection": "Dialogs",
      "key": "line:Daughter_Ears_DontShoot_0ac09c3",
      "source": "Daughter: Она много чего ей запрещает.",
      "target": "Daughter: Sok mindent megtilt neki.",
      "authoredFile": "Translations/hu/dialogue-batch-371.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12118,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453579284482",
      "collection": "Dialogs",
      "key": "line:Daughter_Ears_DontShoot_05d04e2",
      "source": "Daughter: Ей просто дома тяжело. У неё мама очень строгая.",
      "target": "Daughter: Csak nehéz neki otthon. Nagyon szigorú az anyukája.",
      "authoredFile": "Translations/hu/dialogue-batch-371.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12119,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453579284481",
      "collection": "Dialogs",
      "key": "line:Daughter_Ears_DontShoot_05c499d",
      "source": "Daughter: Но она вообще хорошая.",
      "target": "Daughter: De egyébként jó kislány.",
      "authoredFile": "Translations/hu/dialogue-batch-371.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12120,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453579284480",
      "collection": "Dialogs",
      "key": "line:Daughter_Ears_DontShoot_08f1b5f",
      "source": "Daughter: А потом – бац! – и сделает какую-то пакость!",
      "target": "Daughter: Aztán egyszer csak – bumm! – csinál valami rosszaságot!",
      "authoredFile": "Translations/hu/dialogue-batch-371.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12121,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453575090183",
      "collection": "Dialogs",
      "key": "line:Daughter_Ears_DontShoot_007da24",
      "source": "Daughter: Мы с ней играем, играем.",
      "target": "Daughter: Játszunk, csak játszunk vele.",
      "authoredFile": "Translations/hu/dialogue-batch-371.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12122,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453575090182",
      "collection": "Dialogs",
      "key": "line:Daughter_Ears_Gun_041b2dd",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12123,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453575090181",
      "collection": "Dialogs",
      "key": "line:Daughter_Ears_Gun_0d0a482",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12124,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453575090180",
      "collection": "Dialogs",
      "key": "line:Daughter_Ears_Gun_0f0ac04",
      "source": "Daughter: Вы прям как моя лучшая подружка порой...",
      "target": "Daughter: Maga néha pont olyan, mint a legjobb barátnőm...",
      "authoredFile": "Translations/hu/dialogue-batch-371.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12125,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453575090179",
      "collection": "Dialogs",
      "key": "line:Daughter_Ears_Gun_056edc6",
      "source": "Daughter: Вы что, хотите меня обидеть?",
      "target": "Daughter: Maga bántani akar engem?",
      "authoredFile": "Translations/hu/dialogue-batch-371.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12126,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453575090178",
      "collection": "Dialogs",
      "key": "line:Daughter_Ears_Gun_022c7ba",
      "source": "Daughter: А об этом тоже расскажу!",
      "target": "Daughter: Ezt is el fogom mesélni!",
      "authoredFile": "Translations/hu/dialogue-batch-371.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12127,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453575090177",
      "collection": "Dialogs",
      "key": "line:Daughter_Ears_Gun_02ec339",
      "source": "Daughter: Ой...",
      "target": "Daughter: Jaj...",
      "authoredFile": "Translations/hu/dialogue-batch-371.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12128,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453575090176",
      "collection": "Dialogs",
      "key": "line:Daughter_Ears_0e8514e",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12129,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453570895880",
      "collection": "Dialogs",
      "key": "line:Daughter_Ears_0410de2",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12130,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453570895879",
      "collection": "Dialogs",
      "key": "line:Daughter_Photo_DontShoot_016a772",
      "source": "Daughter: Не помню-ю-ю-ю-ю-ю...",
      "target": "Daughter: Nem emléksze-e-e-e-em...",
      "authoredFile": "Translations/hu/dialogue-batch-371.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12131,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453570895878",
      "collection": "Dialogs",
      "key": "line:Daughter_Photo_DontShoot_010275a",
      "source": "Daughter: Или мне это приснилось?..",
      "target": "Daughter: Vagy csak álmodtam?..",
      "authoredFile": "Translations/hu/dialogue-batch-371.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12132,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453570895877",
      "collection": "Dialogs",
      "key": "line:Daughter_Photo_DontShoot_0dbb10e",
      "source": "Daughter: ...",
      "target": "Daughter: ...",
      "authoredFile": "Translations/hu/dialogue-batch-039.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12133,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453570895876",
      "collection": "Dialogs",
      "key": "line:Daughter_Photo_DontShoot_0218b71",
      "source": "Daughter: Папа испугался, а потом они обнялись.",
      "target": "Daughter: Apa megijedt, aztán megölelték egymást.",
      "authoredFile": "Translations/hu/dialogue-batch-371.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12134,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453570895875",
      "collection": "Dialogs",
      "key": "line:Daughter_Photo_DontShoot_07cc54b",
      "source": "Daughter: С длинными волосами и в длинном плаще.",
      "target": "Daughter: Hosszú haja és hosszú köpenye volt.",
      "authoredFile": "Translations/hu/dialogue-batch-371.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12135,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453570895874",
      "collection": "Dialogs",
      "key": "line:Daughter_Photo_DontShoot_0996e6a",
      "source": "Daughter: Там в одном месте на нас с папкой какой-то дяденька оружием показал.",
      "target": "Daughter: Egy helyen valami bácsi fegyvert fogott rám meg apára.",
      "authoredFile": "Translations/hu/dialogue-batch-371.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12136,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453570895873",
      "collection": "Dialogs",
      "key": "line:Daughter_Photo_DontShoot_076ef6d",
      "source": "Daughter: Мы как-то с папкой пошли на рынок.",
      "target": "Daughter: Egyszer elmentünk apával a piacra.",
      "authoredFile": "Translations/hu/dialogue-batch-371.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12137,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453570895872",
      "collection": "Dialogs",
      "key": "line:Daughter_Photo_DontShoot_0c4efe1",
      "source": "Daughter: Ой, а я вспомнила!",
      "target": "Daughter: Jaj, eszembe jutott!",
      "authoredFile": "Translations/hu/dialogue-batch-371.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12138,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453566701575",
      "collection": "Dialogs",
      "key": "line:Daughter_Photo_DontShoot_0e04875",
      "source": "Daughter: Наверное, нет.",
      "target": "Daughter: Valószínűleg nem.",
      "authoredFile": "Translations/hu/dialogue-batch-371.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12139,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453566701574",
      "collection": "Dialogs",
      "key": "line:Daughter_Photo_Gun_06feec8",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12140,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453566701573",
      "collection": "Dialogs",
      "key": "line:Daughter_Photo_Gun_0eb28fe",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12141,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453566701572",
      "collection": "Dialogs",
      "key": "line:Daughter_Photo_Gun_0d70c91",
      "source": "Daughter: У вас такое же ружьё, что ли?",
      "target": "Daughter: Magának is ilyen puskája van?",
      "authoredFile": "Translations/hu/dialogue-batch-371.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12142,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453566701571",
      "collection": "Dialogs",
      "key": "line:Daughter_Photo_Gun_0c6c0cf",
      "source": "Daughter: Там у собаки было ружьё, из которого он щёлкал, и получались фотографии!",
      "target": "Daughter: Ott a kutyának volt egy puskája, amivel kattogtatott, és fényképek lettek belőle!",
      "authoredFile": "Translations/hu/dialogue-batch-371.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12143,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453566701570",
      "collection": "Dialogs",
      "key": "line:Daughter_Photo_Gun_04b0c4d",
      "source": "Daughter: Ой, я тут вспомнила, что видела мультик такой!",
      "target": "Daughter: Jaj, most jutott eszembe, láttam egy ilyen rajzfilmet!",
      "authoredFile": "Translations/hu/dialogue-batch-371.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12144,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453566701569",
      "collection": "Dialogs",
      "key": "line:Daughter_Photo_083ed22",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12145,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453566701568",
      "collection": "Dialogs",
      "key": "line:Daughter_Photo_0d3f1fb",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12146,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453562507270",
      "collection": "Dialogs",
      "key": "line:Daughter_Eyes_DontShoot_0ffd110",
      "source": "Daughter: Надеюсь, что сейчас он тоже вернётся. Просто он заблудился где-то. Да...",
      "target": "Daughter: Remélem, most is visszajön. Csak eltévedt valahol. Igen...",
      "authoredFile": "Translations/hu/dialogue-batch-372.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12147,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453562507269",
      "collection": "Dialogs",
      "key": "line:Daughter_Eyes_DontShoot_07b8ecc",
      "source": "Daughter: Но потом папка нашёлся.",
      "target": "Daughter: De akkor apa előkerült.",
      "authoredFile": "Translations/hu/dialogue-batch-372.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12148,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453562507268",
      "collection": "Dialogs",
      "key": "line:Daughter_Eyes_DontShoot_026f2ac",
      "source": "Daughter: Я же даже не знала, как домой вернуться, мы же были очень далеко!",
      "target": "Daughter: Azt sem tudtam, hogyan jutok haza, olyan messze voltunk!",
      "authoredFile": "Translations/hu/dialogue-batch-372.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12149,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453562507267",
      "collection": "Dialogs",
      "key": "line:Daughter_Eyes_DontShoot_0b6d276",
      "source": "Daughter: Я испугалась, что я умру без него!",
      "target": "Daughter: Féltem, hogy meghalok nélküle!",
      "authoredFile": "Translations/hu/dialogue-batch-372.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12150,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453562507266",
      "collection": "Dialogs",
      "key": "line:Daughter_Eyes_DontShoot_029af80",
      "source": "Daughter: Но папа тогда потерялся, куда-то ушёл.",
      "target": "Daughter: De apa akkor eltűnt, elment valahová.",
      "authoredFile": "Translations/hu/dialogue-batch-372.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12151,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453562507265",
      "collection": "Dialogs",
      "key": "line:Daughter_Eyes_DontShoot_030e054",
      "source": "Daughter: И я так много туда поднималась, что готова была выпить целое море. Нет, океан!",
      "target": "Daughter: Olyan sokszor másztam fel oda, hogy egy egész tengert meg tudtam volna inni. Nem is, egy óceánt!",
      "authoredFile": "Translations/hu/dialogue-batch-372.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12152,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453562507264",
      "collection": "Dialogs",
      "key": "line:Daughter_Eyes_DontShoot_00afad5",
      "source": "Daughter: И мне даже нисколечко не было страшно! Вот совсем! Это было весело!",
      "target": "Daughter: És egy cseppet sem féltem! Egyáltalán nem! Jó móka volt!",
      "authoredFile": "Translations/hu/dialogue-batch-372.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12153,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453558312968",
      "collection": "Dialogs",
      "key": "line:Daughter_Eyes_DontShoot_0b6ff57",
      "source": "Daughter: Я таких ещё никогда не видела!",
      "target": "Daughter: Olyat még sosem láttam!",
      "authoredFile": "Translations/hu/dialogue-batch-372.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12154,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453558312967",
      "collection": "Dialogs",
      "key": "line:Daughter_Eyes_DontShoot_0fd688f",
      "source": "Daughter: Там была очень-преочень большущая горка!",
      "target": "Daughter: Ott volt egy nagyon-nagyon hatalmas csúszda!",
      "authoredFile": "Translations/hu/dialogue-batch-372.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12155,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453558312966",
      "collection": "Dialogs",
      "key": "line:Daughter_Eyes_DontShoot_0aef2a6",
      "source": "Daughter: Как-то я была на далёкой-далёкой площадке!",
      "target": "Daughter: Egyszer egy messzi-messzi játszótéren voltam!",
      "authoredFile": "Translations/hu/dialogue-batch-372.json",
      "reviewResult": "pass"
    },
    {
