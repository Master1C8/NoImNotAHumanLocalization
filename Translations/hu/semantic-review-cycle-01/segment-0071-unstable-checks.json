  "rows": [
    {
      "ordinal": 11863,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453826748419",
      "collection": "Dialogs",
      "key": "line:Unstable_Death_0591c71",
      "source": "Unstable: Ну и что?",
      "target": "Unstable: És akkor mi van?",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11864,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453826748418",
      "collection": "Dialogs",
      "key": "line:Unstable_Death_0653e3a",
      "source": "Unstable: Вот и всё.",
      "target": "Unstable: Ennyi volt.",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11865,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453826748417",
      "collection": "Dialogs",
      "key": "line:Unstable_Ears_DontShoot_06533da",
      "source": "Unstable: Давай я просто скоро уйду и перестану тебя пугать.",
      "target": "Unstable: Hamarosan egyszerűen elmegyek, és nem ijesztgetlek tovább.",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11866,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453826748416",
      "collection": "Dialogs",
      "key": "line:Unstable_Photo_DontShoot_0f5dea4",
      "source": "Unstable: Короче… не наставляй ты на всех это ружьё. Ничем оно… не поможет.",
      "target": "Unstable: Szóval… ne szegezd mindenkire azt a puskát. Semmin sem… segít.",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11867,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453822554122",
      "collection": "Dialogs",
      "key": "line:Unstable_Photo_DontShoot_0b290ef",
      "source": "Unstable: Да господи, погоди-ка… Сраное сердце.",
      "target": "Unstable: Uramisten, várj csak… Ez a rohadt szívem.",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11868,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453822554121",
      "collection": "Dialogs",
      "key": "line:Unstable_Photo_DontShoot_0483136",
      "source": "Unstable: Это ты всех… против себя настроишь только…",
      "target": "Unstable: Ezzel csak mindenkit… magad ellen fordítasz…",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11869,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453822554120",
      "collection": "Dialogs",
      "key": "line:Unstable_Photo_DontShoot_065a8be",
      "source": "Unstable: Нет никакого смысла… запугивать людей.",
      "target": "Unstable: Semmi értelme… halálra rémiszteni az embereket.",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11870,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453822554119",
      "collection": "Dialogs",
      "key": "line:Unstable_Armpit_DontShoot_0d606a8",
      "source": "Unstable: Оно того стоит?",
      "target": "Unstable: Megéri ez?",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11871,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453822554118",
      "collection": "Dialogs",
      "key": "line:Unstable_Armpit_DontShoot_0fd7525",
      "source": "Unstable: Ты так сам становишься страшным челом.",
      "target": "Unstable: Így te magad válsz ijesztő alakká.",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11872,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453822554117",
      "collection": "Dialogs",
      "key": "line:Unstable_Armpit_DontShoot_02ea20d",
      "source": "Unstable: Разве Гости от этого меньше убивают?",
      "target": "Unstable: Ettől talán kevesebb embert ölnek meg a Vendégek?",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11873,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453822554116",
      "collection": "Dialogs",
      "key": "line:Unstable_Armpit_DontShoot_093680d",
      "source": "Unstable: Ты не создашь ощущения безопасности, пугая всех убийством.",
      "target": "Unstable: Attól, hogy mindenkit halállal fenyegetsz, senki sem fogja magát biztonságban érezni.",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11874,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453822554115",
      "collection": "Dialogs",
      "key": "line:Unstable_Eyes_DontShoot_07a6350",
      "source": "Unstable: Вот это меня зарядило нормально.",
      "target": "Unstable: Na, ez rendesen felpörgetett.",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11875,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453822554114",
      "collection": "Dialogs",
      "key": "line:Unstable_Eyes_DontShoot_0b230a1",
      "source": "Unstable: Чего-то я даже не заметил, когда у меня всё покрасилось само…",
      "target": "Unstable: Észre sem vettem, mikor vörösödött be magától minden…",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11876,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453822554113",
      "collection": "Dialogs",
      "key": "line:Unstable_Eyes_DontShoot_0249e54",
      "source": "Unstable: А… какое?",
      "target": "Unstable: És… milyen?",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11877,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453822554112",
      "collection": "Dialogs",
      "key": "line:Unstable_Eyes_DontShoot_081165a",
      "source": "Unstable: Так всё вокруг не зеленоватое?",
      "target": "Unstable: Nem zöldes minden körülöttünk?",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11878,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453818359819",
      "collection": "Dialogs",
      "key": "line:Unstable_Hands_DontShoot_0a481ff",
      "source": "Unstable: Бестолково, конечно, но я не знаю человека, который бы не попытался закрыться от выстрела хоть как-нибудь.",
      "target": "Unstable: Persze hasztalan, de nem ismerek senkit, aki ne próbálná valahogy megvédeni magát egy lövéstől.",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11879,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453818359818",
      "collection": "Dialogs",
      "key": "line:Unstable_Hands_DontShoot_02df5f5",
      "source": "Unstable: Знаешь, страшно, когда не можешь даже прикрыться руками или ещё как от ружья.",
      "target": "Unstable: Tudod, ijesztő, amikor még a kezeddel sem tudod védeni magad a puskától.",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11880,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453818359817",
      "collection": "Dialogs",
      "key": "line:Unstable_Teeth_DontShoot_05b18e7",
      "source": "Unstable: Дальше от этих мест.",
      "target": "Unstable: Messze innen.",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11881,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453818359816",
      "collection": "Dialogs",
      "key": "line:Unstable_Teeth_DontShoot_072ddfa",
      "source": "Unstable: Как будто тебе было бы легче тоже пойти в поисках спокойствия куда-нибудь.",
      "target": "Unstable: Mintha neked is könnyebb lenne elindulni valahová, nyugalmat keresni.",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11882,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453818359815",
      "collection": "Dialogs",
      "key": "line:Unstable_Teeth_DontShoot_015b9c9",
      "source": "Unstable: Но так до шизы недалеко. Это ты всех людей перестреляешь. Из-за того, что завтра тебе кто-то ещё подозрительным покажется.",
      "target": "Unstable: De innen már nincs messze az őrület. Holnap megint gyanús lesz neked valaki, és a végén mindenkit lelősz.",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11883,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453818359814",
      "collection": "Dialogs",
      "key": "line:Unstable_Teeth_DontShoot_0c74284",
      "source": "Unstable: Я понимаю, безопасность, все дела.",
      "target": "Unstable: Értem én, biztonság meg minden.",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11884,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453818359813",
      "collection": "Dialogs",
      "key": "line:Unstable_Ears_Gun_0700e71",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11885,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453818359812",
      "collection": "Dialogs",
      "key": "line:Unstable_Ears_Gun_04c13ee",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11886,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453818359811",
      "collection": "Dialogs",
      "key": "line:Unstable_Ears_Gun_039e4a8",
      "source": "Unstable: Ты мне хоть правила расскажи сначала!",
      "target": "Unstable: Legalább a szabályokat mondd el nekem előbb!",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11887,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453818359810",
      "collection": "Dialogs",
      "key": "line:Unstable_Photo_Gun_019f68e",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11888,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453818359809",
      "collection": "Dialogs",
      "key": "line:Unstable_Photo_Gun_056e13a",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11889,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453818359808",
      "collection": "Dialogs",
      "key": "line:Unstable_Photo_Gun_09d7c21",
      "source": "Unstable: Ща, погоди, у меня одышка какая-то.",
      "target": "Unstable: Várj egy kicsit, valahogy elfogyott a levegőm.",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11890,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453814165515",
      "collection": "Dialogs",
      "key": "line:Unstable_Photo_Gun_046c3ea",
      "source": "Unstable: Это оно так ебашит. Понимаешь?",
      "target": "Unstable: A szívem ver ilyen kurva erősen. Érted?",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11891,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453814165514",
      "collection": "Dialogs",
      "key": "line:Unstable_Photo_Gun_0a70962",
      "source": "Unstable: Погоди, так на фото не дырка ж в сердце.",
      "target": "Unstable: De várj, a képen nem lyuk van a szívemben.",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11892,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453814165513",
      "collection": "Dialogs",
      "key": "line:Unstable_Armpit_Gun_03e3bf6",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11893,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453814165512",
      "collection": "Dialogs",
      "key": "line:Unstable_Armpit_Gun_03fc80e",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11894,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453814165511",
      "collection": "Dialogs",
      "key": "line:Unstable_Armpit_Gun_0cabd8a",
      "source": "Unstable: Не кайф.",
      "target": "Unstable: Ez nem valami jó.",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11895,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453814165510",
      "collection": "Dialogs",
      "key": "line:Unstable_Eyes_Gun_0cb4fca",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11896,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453814165509",
      "collection": "Dialogs",
      "key": "line:Unstable_Eyes_Gun_0a4015a",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11897,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453814165508",
      "collection": "Dialogs",
      "key": "line:Unstable_Eyes_Gun_098b4d3",
      "source": "Unstable: Так, ты скажи честно, а то я уже не понимаю.",
      "target": "Unstable: Na, mondd meg őszintén, mert már nem értem.",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11898,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453814165507",
      "collection": "Dialogs",
      "key": "line:Unstable_Eyes_Gun_04ea651",
      "source": "Unstable: Ты же сам сказал про красноту. Или они у меня красные?",
      "target": "Unstable: Te magad beszéltél a vörösségről. Vagy vörös a szemem?",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11899,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453814165506",
      "collection": "Dialogs",
      "key": "line:Unstable_Eyes_Gun_056932e",
      "source": "Unstable: Ну это не дело. Чел.",
      "target": "Unstable: Hát ez így nincs rendben, haver.",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11900,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453814165505",
      "collection": "Dialogs",
      "key": "line:Unstable_Hands_Gun_01caeb8",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11901,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453814165504",
      "collection": "Dialogs",
      "key": "line:Unstable_Hands_Gun_0c01694",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11902,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453809971211",
      "collection": "Dialogs",
      "key": "line:Unstable_Hands_Gun_033d669",
      "source": "Unstable: Или судороги какой-то новый признак теперь?",
      "target": "Unstable: Vagy most már a görcs is új jelnek számít?",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11903,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453809971210",
      "collection": "Dialogs",
      "key": "line:Unstable_Hands_Gun_0ea09a0",
      "source": "Unstable: Ты ж не станешь стрелять?",
      "target": "Unstable: Ugye nem fogsz lőni?",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11904,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453809971209",
      "collection": "Dialogs",
      "key": "line:Unstable_Hands_Gun_0a57e88",
      "source": "Unstable: Ну момент ты удачный подгадал, конечно.",
      "target": "Unstable: Hát jó pillanatot választottál hozzá.",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11905,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453809971208",
      "collection": "Dialogs",
      "key": "line:Unstable_Teeth_Gun_0c5dad9",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11906,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453809971207",
      "collection": "Dialogs",
      "key": "line:Unstable_Teeth_Gun_049281f",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11907,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453809971206",
      "collection": "Dialogs",
      "key": "line:Unstable_Teeth_Gun_0c64349",
      "source": "Unstable: А я думал тут отдохнуть от насилия немного, если честно.",
      "target": "Unstable: Őszintén szólva azt hittem, itt kicsit kipihenhetem az erőszakot.",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11908,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453809971205",
      "collection": "Dialogs",
      "key": "line:Unstable_Teeth_Gun_0e20a13",
      "source": "Unstable: А я думал, ты не собирался умножать насилие, которого и так хватает сейчас.",
      "target": "Unstable: Azt hittem, nem akarod tovább szaporítani az erőszakot, amiből így is van elég.",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11909,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453809971204",
      "collection": "Dialogs",
      "key": "line:Unstable_Teeth_Gun_071c913",
      "source": "Unstable: О как.",
      "target": "Unstable: Hát ez szép.",
      "authoredFile": "Translations/hu/dialogue-batch-366.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11910,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453809971203",
      "collection": "Dialogs",
