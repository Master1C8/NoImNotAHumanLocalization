    {
      "ordinal": 11929,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453801582600",
      "collection": "Dialogs",
      "key": "line:Unstable_Armpit_05c6d63",
      "source": "Unstable: Во, единственный нормальный признак.",
      "target": "Unstable: Na, ez az egyetlen normális jel.",
      "authoredFile": "Translations/hu/dialogue-batch-367.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11930,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453801582599",
      "collection": "Dialogs",
      "key": "line:Unstable_Eyes_023f9b5",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11931,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453801582598",
      "collection": "Dialogs",
      "key": "line:Unstable_Eyes_05f5415",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11932,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453801582597",
      "collection": "Dialogs",
      "key": "line:Unstable_Eyes_07bb8fa",
      "source": "Unstable: А чего по телику зелёные показывали?",
      "target": "Unstable: Akkor miért zöldeket mutattak a tévében?",
      "authoredFile": "Translations/hu/dialogue-batch-367.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11933,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453801582596",
      "collection": "Dialogs",
      "key": "line:Unstable_Eyes_00a55fa",
      "source": "Unstable: А чего по телику зелёные показывали? А у меня какие?",
      "target": "Unstable: Akkor miért zöldeket mutattak a tévében? És az enyém milyen?",
      "authoredFile": "Translations/hu/dialogue-batch-367.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11934,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453801582595",
      "collection": "Dialogs",
      "key": "line:Unstable_Eyes_0cdcea9",
      "source": "Unstable: ОНИ ДОЛЖНЫ БЫТЬ КРАСНЫМИ?",
      "target": "Unstable: VÖRÖSNEK KELL LENNIÜK?",
      "authoredFile": "Translations/hu/dialogue-batch-367.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11935,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453801582594",
      "collection": "Dialogs",
      "key": "line:Unstable_Eyes_0d2d5f0",
      "source": "Unstable: Подожди, что не так?",
      "target": "Unstable: Várj, mi a baj?",
      "authoredFile": "Translations/hu/dialogue-batch-367.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11936,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453801582593",
      "collection": "Dialogs",
      "key": "line:Unstable_Eyes_0947067",
      "source": "Unstable: ...",
      "target": "Unstable: ...",
      "authoredFile": "Translations/hu/dialogue-batch-039.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11937,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453801582592",
      "collection": "Dialogs",
      "key": "line:Unstable_Eyes_0c96234",
      "source": "Unstable: Не перепутай только, в мире много зелёного.",
      "target": "Unstable: Csak ne keverd össze, sok zöld dolog van a világon.",
      "authoredFile": "Translations/hu/dialogue-batch-367.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11938,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453797388298",
      "collection": "Dialogs",
      "key": "line:Unstable_Eyes_072298c",
      "source": "Unstable: Я тоже смотрел репортаж, там глаза должны быть тёмно-зелёные.",
      "target": "Unstable: Én is láttam a tudósítást, ott azt mondták, a szemnek sötétzöldnek kell lennie.",
      "authoredFile": "Translations/hu/dialogue-batch-367.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11939,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453797388297",
      "collection": "Dialogs",
      "key": "line:Unstable_Hands_061dfb6",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11940,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453797388296",
      "collection": "Dialogs",
      "key": "line:Unstable_Hands_0fff87a",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11941,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453797388295",
      "collection": "Dialogs",
      "key": "line:Unstable_Hands_0f5abb1",
      "source": "Unstable: Ща, подышу минут десять, может, отпустит.",
      "target": "Unstable: Most lélegzem vagy tíz percig, hátha elmúlik.",
      "authoredFile": "Translations/hu/dialogue-batch-367.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11942,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453797388294",
      "collection": "Dialogs",
      "key": "line:Unstable_Hands_02c83eb",
      "source": "Unstable: Хех, от избытка кофеина судорога началась.",
      "target": "Unstable: Heh, a sok koffeintől görcsöt kaptam.",
      "authoredFile": "Translations/hu/dialogue-batch-367.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11943,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453797388293",
      "collection": "Dialogs",
      "key": "line:Unstable_Hands_0c988be",
      "source": "Unstable: Как-то я их перекрутил.",
      "target": "Unstable: Valahogy kicsavartam őket.",
      "authoredFile": "Translations/hu/dialogue-batch-367.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11944,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453797388292",
      "collection": "Dialogs",
      "key": "line:Unstable_Hands_01983c1",
      "source": "Unstable: ...",
      "target": "Unstable: ...",
      "authoredFile": "Translations/hu/dialogue-batch-039.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11945,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453797388291",
      "collection": "Dialogs",
      "key": "line:Unstable_Hands_0967649",
      "source": "Unstable: Я вроде нигде не ковырялся, так что должны быть норм.",
      "target": "Unstable: Nem turkáltam sehol, úgyhogy rendben kell lenniük.",
      "authoredFile": "Translations/hu/dialogue-batch-367.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11946,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453797388290",
      "collection": "Dialogs",
      "key": "line:Unstable_Hands_0228e92",
      "source": "Unstable: Я вроде чешусь часто, иногда даже до крови расчёсываюсь, хах.",
      "target": "Unstable: Azt hiszem, sokat vakarózom, néha még véresre is kaparom magam, hah.",
      "authoredFile": "Translations/hu/dialogue-batch-367.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11947,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453797388289",
      "collection": "Dialogs",
      "key": "line:Unstable_Hands_0018bf5",
      "source": "Unstable: Так-с, руки показать. Ну давай.",
      "target": "Unstable: Szóval a kezemet mutassam meg. Rendben.",
      "authoredFile": "Translations/hu/dialogue-batch-367.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11948,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453797388288",
      "collection": "Dialogs",
      "key": "line:Unstable_Teeth_0b7923a",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11949,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453793193994",
      "collection": "Dialogs",
      "key": "line:Unstable_Teeth_02468e1",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11950,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453793193993",
      "collection": "Dialogs",
      "key": "line:Unstable_Teeth_027bd2d",
      "source": "Unstable: А, ой. Зубам пиздец.",
      "target": "Unstable: Á, jaj. A fogaimnak annyi.",
      "authoredFile": "Translations/hu/dialogue-batch-367.json",
      "reviewResult": "pass"
    },
