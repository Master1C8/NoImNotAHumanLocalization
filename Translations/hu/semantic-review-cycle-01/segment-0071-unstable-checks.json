      "collection": "Dialogs",
      "key": "line:Unstable_Ears_09fd8b4",
      "source": "Unstable: Надо было почистить?",
      "target": "Unstable: Ki kellett volna tisztítanom?",
      "authoredFile": "Translations/hu/dialogue-batch-367.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11914,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453805776907",
      "collection": "Dialogs",
