    },
    {
      "ordinal": 11918,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453805776903",
      "collection": "Dialogs",
      "key": "line:Unstable_Photo_0f1d144",
      "source": "Unstable: На меня энергетоса не напасёшься.",
      "target": "Unstable: Nekem nem győznél energiaitalt adni.",
      "authoredFile": "Translations/hu/dialogue-batch-367.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11919,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453805776902",
      "collection": "Dialogs",
      "key": "line:Unstable_Photo_0b3e48c",
      "source": "Unstable: Ну да, сердце колотится люто.",
      "target": "Unstable: Ja, a szívem iszonyúan ver.",
      "authoredFile": "Translations/hu/dialogue-batch-367.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11920,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453805776901",
      "collection": "Dialogs",
      "key": "line:Unstable_Photo_0bbc708",
      "source": "Unstable: ...",
      "target": "Unstable: ...",
      "authoredFile": "Translations/hu/dialogue-batch-039.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11921,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453805776900",
      "collection": "Dialogs",
      "key": "line:Unstable_Photo_0128d5d",
      "source": "Unstable: Сейчас тусовки особо не собирают. Или меня на них не зовут.",
      "target": "Unstable: Mostanában alig vannak bulik. Vagy csak engem nem hívnak meg.",
      "authoredFile": "Translations/hu/dialogue-batch-367.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11922,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453805776899",
      "collection": "Dialogs",
      "key": "line:Unstable_Photo_072a783",
      "source": "Unstable: Меня фоткали только на тусовках.",
      "target": "Unstable: Engem csak bulikon fényképeztek.",
      "authoredFile": "Translations/hu/dialogue-batch-367.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11923,
