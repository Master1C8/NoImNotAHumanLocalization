      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11917,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453805776904",
      "collection": "Dialogs",
      "key": "line:Unstable_Photo_0aae707",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
