    },
    {
      "ordinal": 11925,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453805776896",
      "collection": "Dialogs",
      "key": "line:Unstable_Armpit_07b8530",
      "source": "Unstable: Кайф.",
      "target": "Unstable: Király.",
      "authoredFile": "Translations/hu/dialogue-batch-367.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11926,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453801582603",
      "collection": "Dialogs",
      "key": "line:Unstable_Armpit_0c34ffe",
      "source": "Unstable: Просто. Обычные. Подмыхи.",
      "target": "Unstable: Csak. Közönséges. Hónaljak.",
      "authoredFile": "Translations/hu/dialogue-batch-367.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11927,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453801582602",
      "collection": "Dialogs",
      "key": "line:Unstable_Armpit_077ca2c",
      "source": "Unstable: Ни цвета определённого, ни грязи, ни какой-нибудь ерунды.",
      "target": "Unstable: Nincs különös színe, nincs kosz, semmi ilyesmi.",
      "authoredFile": "Translations/hu/dialogue-batch-367.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11928,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453801582601",
      "collection": "Dialogs",
      "key": "line:Unstable_Armpit_059ab57",
