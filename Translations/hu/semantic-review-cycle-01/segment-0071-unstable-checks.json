    },
    {
      "ordinal": 11915,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453805776906",
      "collection": "Dialogs",
      "key": "line:Unstable_Ears_021926d",
      "source": "Unstable: Ну давай, чего нет.",
      "target": "Unstable: Persze, miért ne.",
      "authoredFile": "Translations/hu/dialogue-batch-367.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11916,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453805776905",
      "collection": "Dialogs",
      "key": "line:Unstable_Photo_0b3a86b",
