  "rows": [
    {
      "ordinal": 11508,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453952577546",
      "collection": "Dialogs",
      "key": "line:Tough_Death_028f6e3",
      "source": "Tough: Закончится в доме у одинокого фрика.",
      "target": "Tough: Egy magányos különc házában ér véget.",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11509,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453952577545",
      "collection": "Dialogs",
      "key": "line:Tough_Death_08fe7a1",
      "source": "Tough: И эта вся моя борьба за жизнь…",
      "target": "Tough: És az egész küzdelmem az életben maradásért…",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11510,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453952577544",
      "collection": "Dialogs",
      "key": "line:Tough_Death_000c290",
      "source": "Tough: Ты действительно спустишь курок?",
      "target": "Tough: Tényleg meghúzod a ravaszt?",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11511,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453952577543",
      "collection": "Dialogs",
      "key": "line:Tough_Ears_DontShoot_0a0c563",
      "source": "Tough: Каково им будет?",
      "target": "Tough: Vajon mit fognak érezni?",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11512,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453952577542",
      "collection": "Dialogs",
      "key": "line:Tough_Ears_DontShoot_0f30496",
      "source": "Tough: Вот мне интересно, когда всё кончится, как будут чувствовать себя те, кто позволял слишком много? М?",
      "target": "Tough: Arra lennék kíváncsi, hogy ha mindennek vége, mit éreznek majd azok, akik túl sok mindent megengedtek maguknak. Hm?",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11513,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453952577541",
      "collection": "Dialogs",
      "key": "line:Tough_Photo_DontShoot_0de57dd",
      "source": "Tough: Ты считаешь, что кто-то может остаться гандоном даже после смерти?",
      "target": "Tough: Szerinted valaki a halála után is szemétláda maradhat?",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11514,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453952577540",
      "collection": "Dialogs",
      "key": "line:Tough_Photo_DontShoot_082165f",
      "source": "Tough: Вот ты веришь в ауру? Душу? Ещё что-то такое?",
      "target": "Tough: Te hiszel az aurában? A lélekben? Vagy valami ilyesmiben?",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11515,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453952577539",
      "collection": "Dialogs",
      "key": "line:Tough_Armpit_DontShoot_00eb97c",
      "source": "Tough: Насколько этот мир проклят…",
      "target": "Tough: Mennyire átkozott ez a világ…",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11516,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453952577538",
      "collection": "Dialogs",
      "key": "line:Tough_Armpit_DontShoot_0ee74ec",
      "source": "Tough: И убив меня, ты бы смотрел тело?..",
      "target": "Tough: És ha megölnél, megnéznéd a holttestemet?..",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11517,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453952577537",
      "collection": "Dialogs",
      "key": "line:Tough_Armpit_DontShoot_09c6df9",
      "source": "Tough: Оно действительно того стоит? Ты бы меня застрелил, если бы вдруг захотел?",
      "target": "Tough: Tényleg megéri? Lelövnél, ha hirtelen úgy tartaná kedved?",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11518,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453952577536",
      "collection": "Dialogs",
      "key": "line:Tough_Eyes_DontShoot_005197e",
      "source": "Tough: Надо просто бороться за жизнь дальше.",
      "target": "Tough: Egyszerűen tovább kell küzdeni az életért.",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11519,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453948383244",
      "collection": "Dialogs",
      "key": "line:Tough_Eyes_DontShoot_00e53b9",
      "source": "Tough: Но по-другому не будет.",
      "target": "Tough: Másképp nem is lesz.",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11520,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453948383243",
      "collection": "Dialogs",
      "key": "line:Tough_Eyes_DontShoot_00093e0",
      "source": "Tough: Мне не нравится видеть всё, что происходит вокруг нас сейчас.",
      "target": "Tough: Nem szeretem látni, mi minden történik most körülöttünk.",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11521,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453948383242",
      "collection": "Dialogs",
      "key": "line:Tough_Hands_DontShoot_05f2fff",
      "source": "Tough: Но самой так приятно просто… хорошо выглядеть. Нравиться самой себе.",
      "target": "Tough: De olyan jó egyszerűen… jól kinézni. Tetszeni saját magamnak.",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11522,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453948383241",
      "collection": "Dialogs",
      "key": "line:Tough_Hands_DontShoot_079214b",
      "source": "Tough: Да, красота сейчас ничего не значит.",
      "target": "Tough: Igen, a szépség ma már semmit sem jelent.",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11523,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453948383240",
      "collection": "Dialogs",
      "key": "line:Tough_Teeth_DontShoot_02117a5",
      "source": "Tough: Но признаюсь, неприятно, когда в тебя целятся.",
      "target": "Tough: De bevallom, kellemetlen, ha rád fognak egy fegyvert.",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11524,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453948383239",
      "collection": "Dialogs",
      "key": "line:Tough_Teeth_DontShoot_0139817",
      "source": "Tough: Это ты испытываешь меня? Ну как, прошла испытание? Не дрогнула?",
      "target": "Tough: Most próbára teszel? Na, átmentem a próbán? Nem rezzentem össze?",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11525,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453948383238",
      "collection": "Dialogs",
      "key": "line:Tough_Ears_Gun_02ccb1e",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11526,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453948383237",
      "collection": "Dialogs",
      "key": "line:Tough_Ears_Gun_0bd612c",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11527,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453948383236",
      "collection": "Dialogs",
      "key": "line:Tough_Ears_Gun_030087e",
      "source": "Tough: За что ты хоть достаёшь оружие-то, блять?",
      "target": "Tough: Mi a faszért veszed egyáltalán elő a fegyvert?",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11528,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453948383235",
      "collection": "Dialogs",
      "key": "line:Tough_Ears_Gun_0a0fd7e",
      "source": "Tough: Что ты такое там увидел? Серу? Или что?",
      "target": "Tough: Mit láttál ott? Fülzsírt? Vagy mit?",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11529,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453948383234",
      "collection": "Dialogs",
      "key": "line:Tough_Photo_Gun_0b4f28b",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11530,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453948383233",
      "collection": "Dialogs",
      "key": "line:Tough_Photo_Gun_041ff02",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11531,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453948383232",
      "collection": "Dialogs",
      "key": "line:Tough_Photo_Gun_0b50759",
      "source": "Tough: Но для тебя в этом смысла нет.",
      "target": "Tough: De számodra ennek semmi értelme.",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11532,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453944188939",
      "collection": "Dialogs",
      "key": "line:Tough_Armpit_Gun_0e604b5",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11533,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453944188938",
      "collection": "Dialogs",
      "key": "line:Tough_Armpit_Gun_0cfb6c0",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11534,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453944188937",
      "collection": "Dialogs",
      "key": "line:Tough_Armpit_Gun_02b3c43",
      "source": "Tough: Ебануться…",
      "target": "Tough: Ez kibaszott hihetetlen…",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11535,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453944188936",
      "collection": "Dialogs",
      "key": "line:Tough_Eyes_Gun_0a3b97e",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11536,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453944188935",
      "collection": "Dialogs",
      "key": "line:Tough_Eyes_Gun_091c88e",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11537,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453944188934",
      "collection": "Dialogs",
      "key": "line:Tough_Eyes_Gun_0303cbf",
      "source": "Tough: Жаль, что так не получится.",
      "target": "Tough: Kár, hogy ez nem fog menni.",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11538,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453944188933",
      "collection": "Dialogs",
      "key": "line:Tough_Eyes_Gun_05de4b7",
      "source": "Tough: Вообще всё.",
      "target": "Tough: Mindent. Az égvilágon mindent.",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11539,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453944188932",
      "collection": "Dialogs",
      "key": "line:Tough_Eyes_Gun_0c51111",
      "source": "Tough: Я бы рада забыть всё, что видела.",
      "target": "Tough: Szívesen elfelejtenék mindent, amit láttam.",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11540,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453944188931",
      "collection": "Dialogs",
      "key": "line:Tough_Eyes_Gun_01e2c57",
      "source": "Tough: Но тут ничего не поделать.",
      "target": "Tough: De ez ellen nem tehetek semmit.",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11541,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453944188930",
      "collection": "Dialogs",
      "key": "line:Tough_Eyes_Gun_065d68a",
      "source": "Tough: Вообще за всем.",
      "target": "Tough: Úgy általában mindent.",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11542,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453944188929",
      "collection": "Dialogs",
      "key": "line:Tough_Eyes_Gun_0aa6ebd",
      "source": "Tough: Приходится следить за всем вокруг.",
      "target": "Tough: Kénytelen vagyok figyelni mindenre magam körül.",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11543,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453944188928",
      "collection": "Dialogs",
      "key": "line:Tough_Hands_Gun_010eaa6",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11544,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453939994636",
      "collection": "Dialogs",
      "key": "line:Tough_Hands_Gun_0138c07",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11545,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453939994635",
      "collection": "Dialogs",
      "key": "line:Tough_Hands_Gun_0712d61",
      "source": "Tough: Мне снять их, что ли? Как я покажу тебе не нарощенные ногти сейчас?",
      "target": "Tough: Most vegyem le őket? Hogy mutassam meg neked a saját körmeimet?",
      "authoredFile": "Translations/hu/dialogue-batch-358.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11546,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453939994634",
      "collection": "Dialogs",
      "key": "line:Tough_Teeth_Gun_07e3481",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11547,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453939994633",
      "collection": "Dialogs",
      "key": "line:Tough_Teeth_Gun_0e51b21",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11548,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453939994632",
      "collection": "Dialogs",
      "key": "line:Tough_Teeth_Gun_0362fa8",
      "source": "Tough: Монстр в доме явно не я.",
      "target": "Tough: A szörny ebben a házban biztosan nem én vagyok.",
