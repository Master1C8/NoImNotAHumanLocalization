  "rows": [
    {
      "ordinal": 13320,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452933361670",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Death_0013150",
      "source": "Wolfhound: ХХААААА!",
      "target": "Wolfhound: HÁÁÁÁÁ!",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13321,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452933361669",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Death_0376ab4",
      "source": "Wolfhound: Ну давай посмотрим, кто быстрее.",
      "target": "Wolfhound: Na, lássuk, melyikünk gyorsabb.",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13322,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452933361668",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Death_05e7e87",
      "source": "Wolfhound: Из такого я уже выбирался.",
      "target": "Wolfhound: Kerültem már ki ennél rosszabból is.",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "proposed correction"
    },
    {
      "ordinal": 13323,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452933361667",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Ears_DontShoot_066c9ec",
      "source": "Wolfhound: Перестань позориться.",
      "target": "Wolfhound: Ne égesd magad.",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13324,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452933361666",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Ears_DontShoot_05e2652",
      "source": "Wolfhound: Успокойся и отдай ответственность нормальным людям.",
      "target": "Wolfhound: Nyugodj meg, és bízd a felelősséget értelmes emberekre.",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13325,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452933361665",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Photo_DontShoot_0393a37",
      "source": "Wolfhound: А скоро ещё и в башку свою же попадёшь.",
      "target": "Wolfhound: Hamarosan még a saját fejedbe is belelősz.",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13326,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452933361664",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Photo_DontShoot_0c8fd39",
      "source": "Wolfhound: Выглядишь как мальчишка, которому досталось по наследству что-то опасное. А ты им себе руки ломаешь.",
      "target": "Wolfhound: Úgy nézel ki, mint egy kölyök, aki valami veszélyeset örökölt. Aztán még a saját kezedet töröd össze vele.",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13327,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452929167368",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Photo_DontShoot_02bdd9f",
      "source": "Wolfhound: Это уже не серьёзно.",
      "target": "Wolfhound: Ez már komolytalan.",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13328,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452929167367",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Armpit_DontShoot_0b5c94b",
      "source": "Wolfhound: Выкинешь ещё какую подлянку - мы с тобой отдельно поговорим.",
      "target": "Wolfhound: Ha még egyszer kibaszol velem, négyszemközt elbeszélgetünk.",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13329,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452929167366",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Armpit_DontShoot_0dfb6f8",
      "source": "Wolfhound: Ты мне неприятен.",
      "target": "Wolfhound: Nem vagy szimpatikus nekem.",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13330,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452929167365",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Eyes_DontShoot_0e99e37",
      "source": "Wolfhound: Если ты берёшься за ружьё и не ипользуешь его, то так видна твоя неуверенность. А это опасно для тебя же.",
      "target": "Wolfhound: Ha előveszed a puskát, de nem használod, csak megmutatod, mennyire bizonytalan vagy. Ez pedig neked veszélyes.",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13331,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452929167364",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Eyes_DontShoot_0b7bf78",
      "source": "Wolfhound: Ошибся я в тебе.",
      "target": "Wolfhound: Tévedtem veled kapcsolatban.",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13332,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452929167363",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Eyes_DontShoot_0a01d64",
      "source": "Wolfhound: Спокойно, опускай-опускай.",
      "target": "Wolfhound: Nyugalom. Ereszd le, csak ereszd le.",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13333,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452929167362",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Hands_DontShoot_089e2f7",
      "source": "Wolfhound: И тогда ружьё будет у меня.",
      "target": "Wolfhound: És akkor nálam lesz a puska.",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13334,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452929167361",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Hands_DontShoot_06119cc",
      "source": "Wolfhound: Я ведь могу быстрее тебя оказаться.",
      "target": "Wolfhound: Mert én gyorsabb is lehetek nálad.",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13335,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452929167360",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Teeth_DontShoot_08fb8f2",
      "source": "Wolfhound: Не делай ошибок.",
      "target": "Wolfhound: Ne hibázz.",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13336,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452924973063",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Teeth_DontShoot_0531ec7",
      "source": "Wolfhound: И если что — я тебя живьём загрызу, дитя.",
      "target": "Wolfhound: Ha kell, elevenen szétmarcangollak, kölyök.",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13337,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452924973062",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Teeth_DontShoot_0fc7118",
      "source": "Wolfhound: Я же знаю, когда и сколько ты спишь.",
      "target": "Wolfhound: Tudom ám, mikor és mennyit alszol.",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13338,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452924973061",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Teeth_DontShoot_0cac22d",
      "source": "Wolfhound: Ты на меня больше ружьё не наводи.",
      "target": "Wolfhound: Ne fogd rám még egyszer azt a puskát.",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13339,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452924973060",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Ears_Gun_066a3d9",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13340,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452924973059",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Ears_Gun_00e1a53",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13341,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452924973058",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Ears_Gun_0003bf6",
      "source": "Wolfhound: Перебей всех и дело с концом.",
      "target": "Wolfhound: Lőj le mindenkit, és kész.",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13342,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452924973057",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Ears_Gun_037e0b2",
      "source": "Wolfhound: Сколько ты будешь за других держаться, если ты так любишь быть один?",
      "target": "Wolfhound: Meddig kapaszkodsz másokba, ha annyira szeretsz egyedül lenni?",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13343,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452924973056",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Ears_Gun_03d86b0",
      "source": "Wolfhound: Не успели угомонить.",
      "target": "Wolfhound: Nem sikerült időben lecsillapítani.",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13344,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452920778757",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Photo_Gun_048482c",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13345,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452920778756",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Photo_Gun_0ed4df0",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13346,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452920778755",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Photo_Gun_0d09222",
      "source": "Wolfhound: Авторитет держится на уважении, а не на страхе. Тебя быстро сметут, ты только утоми своих людей достаточно.",
      "target": "Wolfhound: A tekintély tiszteleten alapul, nem félelmen. Gyorsan elsöpörnek, ha eléggé kifárasztod az embereidet.",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13347,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452920778754",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Photo_Gun_076bcff",
      "source": "Wolfhound: Ты не обзаведёшься авторитетом, размахивая оружием.",
      "target": "Wolfhound: Attól nem lesz tekintélyed, hogy fegyverrel hadonászol.",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13348,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452920778753",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Armpit_Gun_00a8ab6",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13349,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452920778752",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Armpit_Gun_0c59490",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13350,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452916584457",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Armpit_Gun_0f51aaf",
      "source": "Wolfhound: В наших кругах с тобой бы не долго церемонились.",
      "target": "Wolfhound: A mi köreinkben nem sokáig udvariaskodnának veled.",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13351,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452916584456",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Armpit_Gun_0cb55b2",
      "source": "Wolfhound: Заставляешь взрослого мужика плясать под твою дудку. А потом ещё и угрожаешь.",
      "target": "Wolfhound: Ráveszel egy felnőtt férfit, hogy a te nótádra táncoljon. Aztán még meg is fenyegeted.",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13352,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452916584455",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Eyes_Gun_0839972",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13353,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452916584454",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Eyes_Gun_03d3519",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13354,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452916584453",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Eyes_Gun_055bc04",
      "source": "Wolfhound: Не советую. Даже если умру, сочтёмся на том свете. Я сдеру с тебя шкуру.",
      "target": "Wolfhound: Nem ajánlom. Ha meghalok, a túlvilágon elszámolunk. Lenyúzom rólad a bőrt.",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13355,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452916584452",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Eyes_Gun_03926cf",
      "source": "Wolfhound: Отражение увидел?",
      "target": "Wolfhound: Megláttad a tükörképedet?",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13356,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452916584451",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Hands_Gun_02d3602",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13357,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452916584450",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Hands_Gun_0927602",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13358,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452916584449",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Hands_Gun_0b0cb19",
      "source": "Wolfhound: И что дальше?",
      "target": "Wolfhound: És aztán?",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13359,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452916584448",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Hands_Gun_0dd5c09",
      "source": "Wolfhound: И что? Ты будешь стрелять?",
      "target": "Wolfhound: Na és? Lőni fogsz?",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13360,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452912390153",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Teeth_Gun_0dc0cf7",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13361,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452912390152",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Teeth_Gun_0485661",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13362,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452912390151",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Teeth_Gun_0354f8b",
      "source": "Wolfhound: Думаешь, на меня никогда не направляли оружие?",
      "target": "Wolfhound: Azt hiszed, még sosem fogtak rám fegyvert?",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13363,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452912390150",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Teeth_Gun_08e3b2f",
      "source": "Wolfhound: Сигареты губят не только тех, кто ими не делится, но и дёсна. Слишком смягчаются.",
      "target": "Wolfhound: A cigaretta nemcsak azt teszi tönkre, aki nem ad belőle másnak, hanem az ínyt is. Túl puhává teszi.",
      "authoredFile": "Translations/hu/dialogue-batch-402.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13364,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452912390149",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Ears_03987a2",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13365,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452912390148",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Ears_01c7dd8",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13366,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452912390147",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Ears_0e897a3",
      "source": "Wolfhound: Может, тебе смирительную рубашку надеть от греха подальше?",
      "target": "Wolfhound: Talán jobb volna kényszerzubbonyt adni rád, mielőtt baj lesz?",
      "authoredFile": "Translations/hu/dialogue-batch-403.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13367,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452912390146",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Ears_0d040f1",
      "source": "Wolfhound: ...",
      "target": "Wolfhound: ...",
      "authoredFile": "Translations/hu/dialogue-batch-039.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13368,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452912390145",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Ears_05455e1",
      "source": "Wolfhound: Ещё спроси, зачем мне такие острые зубы. Дурдом.",
      "target": "Wolfhound: Még azt is kérdezd meg, miért ilyen hegyesek a fogaim. Őrület.",
      "authoredFile": "Translations/hu/dialogue-batch-403.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13369,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452912390144",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Photo_024b7cc",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13370,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452908195849",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Photo_0527842",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13371,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452908195848",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Photo_0029b44",
      "source": "Wolfhound: Дай сюда. Я выкину сам.",
      "target": "Wolfhound: Add ide. Majd én kidobom.",
      "authoredFile": "Translations/hu/dialogue-batch-403.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13372,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452908195847",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Photo_0c66c16",
      "source": "Wolfhound: Ты только глянь как получился! Тебе не оставлю.",
      "target": "Wolfhound: Csak nézd, milyen lettem a képen! Nem hagyom nálad.",
      "authoredFile": "Translations/hu/dialogue-batch-403.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13373,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452908195846",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Photo_0344fb0",
      "source": "Wolfhound: ...",
      "target": "Wolfhound: ...",
      "authoredFile": "Translations/hu/dialogue-batch-039.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13374,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452908195845",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Photo_04a2740",
      "source": "Wolfhound: Ты понимаешь это?",
      "target": "Wolfhound: Ezt érted?",
      "authoredFile": "Translations/hu/dialogue-batch-403.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13375,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452908195844",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Photo_0cf41b5",
      "source": "Wolfhound: Если потом эти фотографии окажутся не в мусорном ведре, мне придется принять меры.",
      "target": "Wolfhound: Ha ezek a fényképek később nem a szemetesben lesznek, kénytelen leszek lépni.",
      "authoredFile": "Translations/hu/dialogue-batch-403.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13376,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452908195843",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Photo_0aabc04",
      "source": "Wolfhound: Я не люблю фотографироваться.",
      "target": "Wolfhound: Nem szeretek fényképezkedni.",
      "authoredFile": "Translations/hu/dialogue-batch-403.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13377,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452908195842",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Armpit_0226d45",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13378,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452908195841",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Armpit_0ab6c93",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13379,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452908195840",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Armpit_02d2162",
      "source": "Wolfhound: Мужчина должен пахнуть естественно. Если ему нечего скрывать.",
      "target": "Wolfhound: Egy férfinak természetes szaga legyen. Ha nincs titkolnivalója.",
      "authoredFile": "Translations/hu/dialogue-batch-403.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13380,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452904001544",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Armpit_0e14392",
      "source": "Wolfhound: Мой дезодорант очень сушит кожу. Но не ходить же вонять.",
      "target": "Wolfhound: A dezodorom nagyon szárítja a bőrömet. De azért nem járhatok bűzölögve.",
      "authoredFile": "Translations/hu/dialogue-batch-403.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13381,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452904001543",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Armpit_0057b1a",
      "source": "Wolfhound: ...",
      "target": "Wolfhound: ...",
      "authoredFile": "Translations/hu/dialogue-batch-039.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13382,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452904001542",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Armpit_09a7b1c",
      "source": "Wolfhound: Я такое не уважаю. И тебе это припомню.",
      "target": "Wolfhound: Az ilyesmit nem tűröm. Ezt még megemlegeted.",
      "authoredFile": "Translations/hu/dialogue-batch-403.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13383,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452904001541",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Eyes_065c6f6",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13384,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452904001540",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Eyes_0b001f9",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13385,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452904001539",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Eyes_0489410",
      "source": "Wolfhound: Не все выдерживают мой взгляд.",
      "target": "Wolfhound: Nem mindenki állja a tekintetemet.",
      "authoredFile": "Translations/hu/dialogue-batch-403.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13386,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452904001538",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Eyes_036dc88",
      "source": "Wolfhound: Я впечатлён.",
      "target": "Wolfhound: Lenyűgöztél.",
      "authoredFile": "Translations/hu/dialogue-batch-403.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13387,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452904001537",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Eyes_0d5a77e",
      "source": "Wolfhound: ...",
      "target": "Wolfhound: ...",
      "authoredFile": "Translations/hu/dialogue-batch-039.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13388,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452904001536",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Eyes_010b744",
      "source": "Wolfhound: Не боишься в них своё отражение увидеть?",
      "target": "Wolfhound: Nem félsz, hogy a saját tükörképedet látod meg bennük?",
      "authoredFile": "Translations/hu/dialogue-batch-403.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13389,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452899807238",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Eyes_025e91c",
      "source": "Wolfhound: Ищешь во мне чужака?",
      "target": "Wolfhound: Idegent keresel bennem?",
      "authoredFile": "Translations/hu/dialogue-batch-403.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13390,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452899807237",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Hands_0aaf7fa",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13391,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452899807236",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Hands_0217eea",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13392,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452899807235",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Hands_0f54628",
      "source": "Wolfhound: Ну, доволен?",
      "target": "Wolfhound: Na, elégedett vagy?",
      "authoredFile": "Translations/hu/dialogue-batch-403.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13393,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452899807234",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Hands_0d9a506",
      "source": "Wolfhound: ...",
      "target": "Wolfhound: ...",
      "authoredFile": "Translations/hu/dialogue-batch-039.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13394,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452899807233",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Hands_0a0174b",
      "source": "Wolfhound: Я из тех, кто бьёт.",
      "target": "Wolfhound: Én azok közé tartozom, akik ütnek.",
      "authoredFile": "Translations/hu/dialogue-batch-403.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13395,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452899807232",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Hands_025ccbc",
      "source": "Wolfhound: Есть люди, которые при опасности замирают, а есть те, кто бегут.",
      "target": "Wolfhound: Van, aki veszélyben megdermed, más meg elfut.",
      "authoredFile": "Translations/hu/dialogue-batch-403.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13396,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452895612933",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Hands_025fcf5",
      "source": "Wolfhound: Меня пытались убить. Никогда не буду стоять и ждать, пока меня убьют.",
      "target": "Wolfhound: Megpróbáltak megölni. Én sosem fogok állva várni arra, hogy megöljenek.",
      "authoredFile": "Translations/hu/dialogue-batch-403.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13397,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452895612932",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Hands_08d7cb0",
      "source": "Wolfhound: Да, я убивал. Недавно.",
      "target": "Wolfhound: Igen, öltem már. Nemrég is.",
      "authoredFile": "Translations/hu/dialogue-batch-403.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13398,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452895612931",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Hands_01b9042",
      "source": "Wolfhound: Хочешь послушать про мои руки?",
      "target": "Wolfhound: A kezeimről akarsz hallani?",
      "authoredFile": "Translations/hu/dialogue-batch-403.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13399,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452895612930",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Teeth_00e7995",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13400,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452895612929",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Teeth_097f11c",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13401,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452895612928",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Teeth_04b4636",
      "source": "Wolfhound: Ну пусть их в могиле покрепче сжимают те ублюдки.",
      "target": "Wolfhound: Akkor szorítsák csak őket jó erősen a sírban azok a rohadékok.",
      "authoredFile": "Translations/hu/dialogue-batch-403.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13402,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452891418633",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Teeth_0169640",
      "source": "Wolfhound: А тех, что не хватает...",
      "target": "Wolfhound: Azok pedig, amelyek hiányoznak...",
      "authoredFile": "Translations/hu/dialogue-batch-403.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13403,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452891418632",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Teeth_073f534",
      "source": "Wolfhound: Я за своими зубами ухаживаю.",
      "target": "Wolfhound: Vigyázok a fogaimra.",
      "authoredFile": "Translations/hu/dialogue-batch-403.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13404,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452891418631",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Teeth_04d5c89",
      "source": "Wolfhound: ...",
      "target": "Wolfhound: ...",
      "authoredFile": "Translations/hu/dialogue-batch-039.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13405,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452891418630",
      "collection": "Dialogs",
      "key": "line:Wolfhound_Teeth_03d8e55",
      "source": "Wolfhound: Если нападёшь — я тебе шею этими зубами прокушу.",
      "target": "Wolfhound: Ha rám támadsz, ezekkel a fogakkal harapom át a torkodat.",
      "authoredFile": "Translations/hu/dialogue-batch-403.json",
      "reviewResult": "proposed correction"
    },
    {
      "ordinal": 13406,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452891418629",
      "collection": "Dialogs",
