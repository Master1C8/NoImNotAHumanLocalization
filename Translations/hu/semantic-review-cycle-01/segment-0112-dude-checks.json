      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452455211009",
      "collection": "Dialogs",
      "key": "line:Dude_Eyes_Gun_080897e",
      "source": "Выстрелить",
      "target": "Lövés",
