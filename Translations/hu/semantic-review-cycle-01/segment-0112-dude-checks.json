    },
    {
      "ordinal": 14456,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452455211008",
      "collection": "Dialogs",
      "key": "line:Dude_Eyes_Gun_0c362ab",
      "source": "Dude: Да ты погоди, не так всё плохо будет. Угарная история ж!",
      "target": "Dude: Várj már, nem lesz olyan vészes. Tök vicces sztori!",
      "authoredFile": "Translations/hu/dialogue-batch-431.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14457,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452451016711",
      "collection": "Dialogs",
      "key": "line:Dude_Hands_Gun_040ad1d",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14458,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452451016710",
      "collection": "Dialogs",
      "key": "line:Dude_Hands_Gun_05ab597",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14459,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452451016709",
      "collection": "Dialogs",
      "key": "line:Dude_Hands_Gun_0c4f248",
      "source": "Dude: Ну ты, чел, жёсткий. А, погоди, ты теперь чувствуешь пушку частью себя? Чума, братан!..",
      "target": "Dude: Azta, haver, te aztán kemény vagy. Várj, most úgy érzed, mintha a puska a részed lenne? Ez durva, tesó!..",
      "authoredFile": "Translations/hu/dialogue-batch-431.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14460,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452451016708",
      "collection": "Dialogs",
      "key": "line:Dude_Teeth_Gun_0b76f23",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14461,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452451016707",
      "collection": "Dialogs",
      "key": "line:Dude_Teeth_Gun_0497971",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14462,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452451016706",
      "collection": "Dialogs",
      "key": "line:Dude_Teeth_Gun_0e297d1",
      "source": "Dude: Блин, чел, ты чего? Расслабься, присядь и поболтай со мной ещё!",
      "target": "Dude: Basszus, haver, mi van veled? Nyugi, ülj le, és dumálj velem még egy kicsit!",
      "authoredFile": "Translations/hu/dialogue-batch-431.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14463,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452451016705",
      "collection": "Dialogs",
      "key": "line:Dude_Ears_0c5d4c5",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14464,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452451016704",
      "collection": "Dialogs",
      "key": "line:Dude_Ears_08e6baf",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14465,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452446822410",
      "collection": "Dialogs",
      "key": "line:Dude_Ears_0f5d77e",
      "source": "Dude: Почему висит? Да было тоннельное время…",
      "target": "Dude: Miért lóg? Hát volt egy korszakom, amikor fültágítót hordtam…",
      "authoredFile": "Translations/hu/dialogue-batch-431.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14466,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452446822409",
      "collection": "Dialogs",
      "key": "line:Dude_Ears_060d599",
      "source": "Dude: ...",
      "target": "Dude: ...",
      "authoredFile": "Translations/hu/dialogue-batch-040.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14467,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452446822408",
      "collection": "Dialogs",
      "key": "line:Dude_Ears_06cf205",
      "source": "Dude: Угу, угу.",
      "target": "Dude: Aha, aha.",
      "authoredFile": "Translations/hu/dialogue-batch-431.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14468,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452446822407",
      "collection": "Dialogs",
      "key": "line:Dude_Photo_023b7ce",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14469,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452446822406",
      "collection": "Dialogs",
      "key": "line:Dude_Photo_0437496",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14470,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452446822405",
      "collection": "Dialogs",
      "key": "line:Dude_Photo_04826d2",
      "source": "Dude: Чё, как там моя аура? Яркая? Ха, ну, я так и знал.",
      "target": "Dude: Na, milyen az aurám? Fényes? Ha, tudtam én.",
      "authoredFile": "Translations/hu/dialogue-batch-431.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14471,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452446822404",
      "collection": "Dialogs",
      "key": "line:Dude_Photo_0c9a371",
      "source": "Dude: ...",
      "target": "Dude: ...",
      "authoredFile": "Translations/hu/dialogue-batch-040.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14472,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452446822403",
      "collection": "Dialogs",
      "key": "line:Dude_Photo_0475679",
      "source": "Dude: Да без базара!",
      "target": "Dude: Persze, simán!",
      "authoredFile": "Translations/hu/dialogue-batch-431.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14473,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452446822402",
      "collection": "Dialogs",
      "key": "line:Dude_Armpit_0f85cd1",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14474,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452446822401",
      "collection": "Dialogs",
      "key": "line:Dude_Armpit_06cffe3",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14475,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452446822400",
      "collection": "Dialogs",
      "key": "line:Dude_Armpit_09fedee",
      "source": "Dude: Насекомые не кусают, от холода защищаться не надо. Нафига тогда?",
      "target": "Dude: Nem csípnek meg a rovarok, a hidegtől sem kell védekeznünk. Akkor meg minek?",
      "authoredFile": "Translations/hu/dialogue-batch-431.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14476,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452442628106",
      "collection": "Dialogs",
      "key": "line:Dude_Armpit_0d85e66",
      "source": "Dude: Типа, мы уже не в каменном веке.",
      "target": "Dude: Mármint nem a kőkorszakban élünk.",
      "authoredFile": "Translations/hu/dialogue-batch-431.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14477,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452442628105",
      "collection": "Dialogs",
      "key": "line:Dude_Armpit_0ded5b0",
      "source": "Dude: Чел, ты только скажи – зачем нам вообще подмышечные волосы?",
      "target": "Dude: Haver, mondd meg nekem, minek van egyáltalán hónaljszőrünk?",
      "authoredFile": "Translations/hu/dialogue-batch-431.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14478,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452442628104",
      "collection": "Dialogs",
      "key": "line:Dude_Armpit_0493c4a",
      "source": "Dude: Бритые, как у младенца! Ну, почти.",
      "target": "Dude: Leborotválva, mint egy kisbabánál! Na jó, majdnem.",
      "authoredFile": "Translations/hu/dialogue-batch-431.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14479,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452442628103",
      "collection": "Dialogs",
      "key": "line:Dude_Armpit_0b27099",
      "source": "Dude: Они, блин, чешутся постоянно. Мне говорили, что это из-за того, что я одежду не стираю. Но это же естественно — так ходить, а!",
      "target": "Dude: Folyton viszketnek, basszus. Azt mondták, azért, mert nem mosom a ruháimat. Pedig így járni teljesen természetes, nem?",
      "authoredFile": "Translations/hu/dialogue-batch-431.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14480,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452442628102",
      "collection": "Dialogs",
      "key": "line:Dude_Armpit_06a9d2e",
      "source": "Dude: ...",
      "target": "Dude: ...",
      "authoredFile": "Translations/hu/dialogue-batch-040.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14481,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452442628101",
      "collection": "Dialogs",
      "key": "line:Dude_Armpit_0a8042d",
      "source": "Dude: Ок, ща, погодь, надо, это… небольшой стриптиз сделать, и покажу.",
      "target": "Dude: Oké, várj csak, ehhez… egy kis sztriptízt kell csinálnom, aztán megmutatom.",
      "authoredFile": "Translations/hu/dialogue-batch-431.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14482,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452442628100",
      "collection": "Dialogs",
      "key": "line:Dude_Eyes_0784337",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14483,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452442628099",
      "collection": "Dialogs",
      "key": "line:Dude_Eyes_06c8e52",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14484,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452442628098",
      "collection": "Dialogs",
      "key": "line:Dude_Eyes_0c627ba",
      "source": "Dude: Я тебе такой прикол расскажу, ты охереешь.",
      "target": "Dude: Elmesélek egy sztorit, teljesen ki fogsz akadni.",
      "authoredFile": "Translations/hu/dialogue-batch-431.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14485,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452442628097",
      "collection": "Dialogs",
      "key": "line:Dude_Eyes_0b0cab9",
      "source": "Dude: Красные, да? Ха, привык уже. Ты бы знал, сколько раз меня палили из-за этого.",
      "target": "Dude: Vörösek, mi? Ha, már megszoktam. Ha tudnád, hányszor buktam le miattuk.",
      "authoredFile": "Translations/hu/dialogue-batch-431.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14486,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452442628096",
      "collection": "Dialogs",
      "key": "line:Dude_Eyes_04e0203",
      "source": "Dude: Зрачки широкие, да? Ха, привык уже. Ты бы знал, сколько раз меня в магазине палили из-за этого.",
      "target": "Dude: Tágak a pupilláim, mi? Ha, már megszoktam. Ha tudnád, hányszor buktam le miattuk a boltban.",
      "authoredFile": "Translations/hu/dialogue-batch-431.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14487,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452438433801",
      "collection": "Dialogs",
      "key": "line:Dude_Eyes_055371e",
      "source": "Dude: ...",
      "target": "Dude: ...",
      "authoredFile": "Translations/hu/dialogue-batch-040.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14488,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452438433800",
      "collection": "Dialogs",
      "key": "line:Dude_Eyes_038a5f1",
      "source": "Dude: Я так долго не смогу держать их открытыми. Синдром «тяжёлых век», хехе.",
      "target": "Dude: Nem bírom őket sokáig nyitva tartani. „Nehéz szemhéj” szindróma, hehe.",
      "authoredFile": "Translations/hu/dialogue-batch-431.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14489,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452438433799",
      "collection": "Dialogs",
      "key": "line:Dude_Hands_0c8c45c",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14490,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452438433798",
      "collection": "Dialogs",
      "key": "line:Dude_Hands_0a9daa9",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14491,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452438433797",
      "collection": "Dialogs",
      "key": "line:Dude_Hands_00ec006",
      "source": "Dude: Чувак, это был капец, я тогда вообще только и делал, что двигал пальцами и наблюдал за этим всем.",
      "target": "Dude: Haver, az kész volt. Akkor csak mozgattam az ujjaimat, és néztem, ahogy mozognak.",
      "authoredFile": "Translations/hu/dialogue-batch-431.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14492,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452438433796",
      "collection": "Dialogs",
      "key": "line:Dude_Hands_002ff75",
      "source": "Dude: Как-то раз… Да блин, укурился я сильно, смотрю на пальцы, и до меня доходит, что это МОИ пальцы!",
      "target": "Dude: Egyszer… Basszus, rendesen be voltam tépve, nézem az ujjaimat, és egyszer csak leesik, hogy ezek az ÉN ujjaim!",
      "authoredFile": "Translations/hu/dialogue-batch-431.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14493,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452438433795",
      "collection": "Dialogs",
      "key": "line:Dude_Hands_0c1560f",
      "source": "Dude: ...",
      "target": "Dude: ...",
      "authoredFile": "Translations/hu/dialogue-batch-040.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14494,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452438433794",
      "collection": "Dialogs",
      "key": "line:Dude_Hands_06d3faa",
      "source": "Dude: Оба-на!",
      "target": "Dude: Hűha!",
      "authoredFile": "Translations/hu/dialogue-batch-431.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14495,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452438433793",
      "collection": "Dialogs",
      "key": "line:Dude_Hands_076adb3",
      "source": "Dude: Я, это, закладку недавно искал. Соррян за грязь под ногтями.",
      "target": "Dude: Nemrég egy eldugott cuccot kerestem. Bocs a koszért a körmöm alatt.",
      "authoredFile": "Translations/hu/dialogue-batch-431.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14496,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452438433792",
      "collection": "Dialogs",
      "key": "line:Dude_Teeth_0092c15",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14497,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452434239496",
      "collection": "Dialogs",
      "key": "line:Dude_Teeth_0f91d35",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14498,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452434239495",
      "collection": "Dialogs",
      "key": "line:Dude_Teeth_079e6e2",
      "source": "Dude: Прост курю много.",
      "target": "Dude: Csak sokat szívok.",
      "authoredFile": "Translations/hu/dialogue-batch-431.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14499,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452434239494",
      "collection": "Dialogs",
      "key": "line:Dude_Teeth_0f9c84b",
      "source": "Dude: Как-то открывал ими бутылку – чуть язык не откусил, но зато бахнул пивка.",
      "target": "Dude: Egyszer ezekkel próbáltam felnyitni egy üveget – majdnem leharaptam a nyelvem, de legalább bedobtam egy sört.",
      "authoredFile": "Translations/hu/dialogue-batch-431.json",
      "reviewResult": "pass"
    },
    {
