    },
    {
      "ordinal": 14267,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452522319882",
      "collection": "Dialogs",
      "key": "line:Ballerina_Armpit_Gun_06ff038",
      "source": "Ballerina: Ты же не долбоёб так делать?",
      "target": "Ballerina: Ugye nem vagy akkora barom, hogy ezt tedd?",
      "authoredFile": "Translations/hu/dialogue-batch-425.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14268,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452522319881",
      "collection": "Dialogs",
      "key": "line:Ballerina_Armpit_Gun_033d2e8",
      "source": "Ballerina: Я виновата, что тебе не понравилось, а?",
      "target": "Ballerina: Én tehetek róla, hogy nem tetszett neked, mi?",
      "authoredFile": "Translations/hu/dialogue-batch-425.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14269,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452522319880",
      "collection": "Dialogs",
      "key": "line:Ballerina_Armpit_Gun_02ed1ee",
      "source": "Ballerina: Что? Свой шанс упустил, а злишься на меня?",
      "target": "Ballerina: Elszalasztottad az esélyedet, és rám haragszol?",
      "authoredFile": "Translations/hu/dialogue-batch-425.json",
      "reviewResult": "pass"
    },
    {
