    },
    {
      "ordinal": 14272,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452522319877",
      "collection": "Dialogs",
      "key": "line:Ballerina_Eyes_Gun_0bc963e",
      "source": "Ballerina: Или как это говорить?",
      "target": "Ballerina: Vagy hogy is mondják?",
      "authoredFile": "Translations/hu/dialogue-batch-425.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14273,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452522319876",
      "collection": "Dialogs",
      "key": "line:Ballerina_Eyes_Gun_0d4f521",
      "source": "Ballerina: Ты же её льёшь тут, я думала, ты… фанат.",
      "target": "Ballerina: Te ontod itt a vért, azt hittem, te… rajongó vagy.",
      "authoredFile": "Translations/hu/dialogue-batch-425.json",
