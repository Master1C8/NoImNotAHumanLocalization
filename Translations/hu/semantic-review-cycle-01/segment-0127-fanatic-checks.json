    },
    {
      "ordinal": 15894,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451905757193",
      "collection": "Dialogs",
      "key": "line:Fanatic_Eyes_DontShoot_0f417a9",
      "source": "Fanatic: Ща, подожди.",
      "target": "Fanatic: Várjá, egy pillanat.",
      "authoredFile": "Translations/hu/dialogue-batch-461.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15895,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451905757192",
      "collection": "Dialogs",
      "key": "line:Fanatic_Eyes_DontShoot_0e10893",
      "source": "Fanatic: Как-то не так там было.",
      "target": "Fanatic: Nem egészen így volt.",
      "authoredFile": "Translations/hu/dialogue-batch-461.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15896,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451905757191",
      "collection": "Dialogs",
      "key": "line:Fanatic_Eyes_DontShoot_0efe4af",
      "source": "Fanatic: А, нет, подожди...",
      "target": "Fanatic: Ja, nem, várj csak...",
      "authoredFile": "Translations/hu/dialogue-batch-461.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15897,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451905757190",
      "collection": "Dialogs",
      "key": "line:Fanatic_Eyes_DontShoot_09c5c73",
      "source": "Fanatic: Ну и что? Стреляться теперь?",
      "target": "Fanatic: Na és? Lőjem fejbe magam?",
      "authoredFile": "Translations/hu/dialogue-batch-461.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15898,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451905757189",
      "collection": "Dialogs",
      "key": "line:Fanatic_Eyes_DontShoot_00c7836",
      "source": "Fanatic: Говорят, в глазах правды нет.",
      "target": "Fanatic: Azt mondják, a szemekben nincs igazság.",
      "authoredFile": "Translations/hu/dialogue-batch-461.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15899,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451905757188",
      "collection": "Dialogs",
      "key": "line:Fanatic_Hands_DontShoot_00546e3",
      "source": "Fanatic: Скупердяй, невежа, и мне хочется пива.",
      "target": "Fanatic: Fukar vagy, tudatlan vagy, és sört akarok.",
      "authoredFile": "Translations/hu/dialogue-batch-461.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15900,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451905757187",
      "collection": "Dialogs",
      "key": "line:Fanatic_Hands_DontShoot_03d7437",
      "source": "Fanatic: ПОЧЕМУ?",
      "target": "Fanatic: MIÉRT?",
      "authoredFile": "Translations/hu/dialogue-batch-461.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15901,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451905757186",
      "collection": "Dialogs",
      "key": "line:Fanatic_Hands_DontShoot_047f105",
      "source": "Fanatic: Подожди, а тебе мои руки не нравятся?",
      "target": "Fanatic: Várj, nem tetszenek a kezeim?",
      "authoredFile": "Translations/hu/dialogue-batch-461.json",
      "reviewResult": "pass"
    },
    {
