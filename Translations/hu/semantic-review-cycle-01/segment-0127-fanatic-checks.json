    },
    {
      "ordinal": 15887,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451909951493",
      "collection": "Dialogs",
      "key": "line:Fanatic_Armpit_06d9f47",
      "source": "Fanatic: Вот ты каков, любитель шалостей!",
      "target": "Fanatic: Szóval ilyen huncut vagy te!",
      "authoredFile": "Translations/hu/dialogue-batch-461.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15888,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451909951492",
      "collection": "Dialogs",
      "key": "line:Fanatic_Armpit_DontShoot_03a02e0",
      "source": "Fanatic: У тебя щедрый запас живительной холодной влаги!",
      "target": "Fanatic: Jó nagy készleted van az éltető, hűs nedvességből!",
      "authoredFile": "Translations/hu/dialogue-batch-461.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15889,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451909951491",
      "collection": "Dialogs",
      "key": "line:Fanatic_Armpit_DontShoot_0afd153",
      "source": "Fanatic: А обо мне не беспокойся, я не обижаюсь.",
      "target": "Fanatic: Miattam pedig ne aggódj, nem sértődtem meg.",
      "authoredFile": "Translations/hu/dialogue-batch-461.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15890,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451909951490",
      "collection": "Dialogs",
      "key": "line:Fanatic_Armpit_DontShoot_0e4bfca",
      "source": "Fanatic: Не застрелишь же ты Солнце!",
      "target": "Fanatic: Csak nem lövöd le a Napot!",
      "authoredFile": "Translations/hu/dialogue-batch-461.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15891,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451909951489",
      "collection": "Dialogs",
      "key": "line:Fanatic_Armpit_DontShoot_0ede245",
      "source": "Fanatic: Вот и правильно.",
      "target": "Fanatic: Na, így már helyes.",
      "authoredFile": "Translations/hu/dialogue-batch-461.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15892,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451909951488",
      "collection": "Dialogs",
      "key": "line:Fanatic_Eyes_DontShoot_0040833",
      "source": "Fanatic: Да и похуй.",
      "target": "Fanatic: És le is szarom.",
      "authoredFile": "Translations/hu/dialogue-batch-461.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15893,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451905757194",
      "collection": "Dialogs",
      "key": "line:Fanatic_Eyes_DontShoot_06464ca",
      "source": "Fanatic: ...",
      "target": "Fanatic: ...",
      "authoredFile": "Translations/hu/dialogue-batch-040.json",
