      "source": "Fanatic: ...",
      "target": "Fanatic: ...",
      "authoredFile": "Translations/hu/dialogue-batch-040.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15886,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451909951494",
      "collection": "Dialogs",
      "key": "line:Fanatic_Armpit_0da6935",
      "source": "Fanatic: Ну а что, ну понюхай, раз хочется.",
      "target": "Fanatic: Hát jó, szagold meg, ha annyira akarod.",
      "authoredFile": "Translations/hu/dialogue-batch-461.json",
