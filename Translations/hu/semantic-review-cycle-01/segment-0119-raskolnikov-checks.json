    {
      "ordinal": 15067,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452220329996",
      "collection": "Dialogs",
      "key": "line:Raskolnikov_Photo_Gun_0bacde9",
      "source": "Raskolnikov: Наверное, стрелять – разумно.",
      "target": "Raskolnikov: Talán észszerű lenne lőni.",
      "authoredFile": "Translations/hu/dialogue-batch-445.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15068,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452220329995",
      "collection": "Dialogs",
      "key": "line:Raskolnikov_Photo_Gun_03d23c7",
      "source": "Raskolnikov: Если ты по фото понял, кто я есть…",
      "target": "Raskolnikov: Ha a fényképből rájöttél, ki vagyok…",
      "authoredFile": "Translations/hu/dialogue-batch-445.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15069,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452220329994",
