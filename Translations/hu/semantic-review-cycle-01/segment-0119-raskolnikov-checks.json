      "reviewResult": "pass"
    },
    {
      "ordinal": 15102,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452207747083",
      "collection": "Dialogs",
      "key": "line:Raskolnikov_Armpit_095dd5b",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
