  "rows": [
    {
      "ordinal": 13812,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452690092042",
      "collection": "Dialogs",
      "key": "line:Hunter_Death_097663b",
      "source": "Hunter: Страшно.",
      "target": "Hunter: Félelmetes.",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13813,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452690092041",
      "collection": "Dialogs",
      "key": "line:Hunter_Death_098dc51",
      "source": "Hunter: Будешь выкидывать меня — положи поближе к этим.",
      "target": "Hunter: Ha majd kidobsz, tegyél azokhoz közelebb.",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13814,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452690092040",
      "collection": "Dialogs",
      "key": "line:Hunter_Ears_DontShoot_0c2eb10",
      "source": "Hunter: А то я вот поймаю ублюдка, даже не пойму, к чему присматриваться. Ты вот понял?",
      "target": "Hunter: Mert ha elkapom azt a rohadékot, azt sem tudom majd, mit nézzek rajta. Te érted?",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13815,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452690092039",
      "collection": "Dialogs",
      "key": "line:Hunter_Ears_DontShoot_02c88bc",
      "source": "Hunter: Если уж рассказывают про новый признак, то хоть бы сказали, на что обращать внимание.",
      "target": "Hunter: Ha már új ismertetőjegyről beszélnek, legalább mondanák meg, mire kell figyelni.",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13816,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452690092038",
      "collection": "Dialogs",
      "key": "line:Hunter_Photo_DontShoot_0ad0ff3",
      "source": "Hunter: Мне это всё не интересно.",
      "target": "Hunter: Engem ez az egész nem érdekel.",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13817,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452690092037",
      "collection": "Dialogs",
      "key": "line:Hunter_Photo_DontShoot_0c55770",
      "source": "Hunter: Бррррр.",
      "target": "Hunter: Brrrr.",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13818,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452690092036",
      "collection": "Dialogs",
      "key": "line:Hunter_Photo_DontShoot_0452a9b",
      "source": "Hunter: Знаешь, не люблю я это всё. Фоткаться, резкие вспышки, звуки.",
      "target": "Hunter: Tudod, nem szeretem az ilyesmit. A fényképezkedést, a hirtelen vakukat meg a zajt.",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13819,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452690092035",
      "collection": "Dialogs",
      "key": "line:Hunter_Photo_DontShoot_0ec2e8f",
      "source": "Hunter: Спасибо. За понимание.",
      "target": "Hunter: Köszönöm. Hogy megérted.",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13820,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452690092034",
      "collection": "Dialogs",
      "key": "line:Hunter_Armpit_DontShoot_0bb1827",
      "source": "Hunter: Или это реально паника была?",
      "target": "Hunter: Vagy tényleg pánikba estél?",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13821,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452690092033",
      "collection": "Dialogs",
      "key": "line:Hunter_Armpit_DontShoot_0a95cf3",
      "source": "Hunter: А что тебя смутило? Я же вроде не подхожу по признакам.",
      "target": "Hunter: Mi zavart meg? Szerintem egyik ismertetőjegy sem illik rám.",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13822,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452690092032",
      "collection": "Dialogs",
      "key": "line:Hunter_Armpit_DontShoot_008e378",
      "source": "Hunter: Я уж чуть не поверил, что ты выстрелишь.",
      "target": "Hunter: Már majdnem elhittem, hogy lelősz.",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13823,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452685897738",
      "collection": "Dialogs",
      "key": "line:Hunter_Eyes_DontShoot_01af6c8",
      "source": "Hunter: Никогда не принимай поспешных выводов. На охоте это всегда приводит к тому, что тебя загрызут.",
      "target": "Hunter: Soha ne vonj le elhamarkodott következtetéseket. Vadászat közben ezért széttépnek.",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13824,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452685897737",
      "collection": "Dialogs",
      "key": "line:Hunter_Eyes_DontShoot_01fe2fb",
      "source": "Hunter: Вот и правильно.",
      "target": "Hunter: Így helyes.",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13825,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452685897736",
      "collection": "Dialogs",
      "key": "line:Hunter_Hands_DontShoot_06fd095",
      "source": "Hunter: Пойдём за ними охотиться.",
      "target": "Hunter: Menjünk vadászni rájuk.",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13826,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452685897735",
      "collection": "Dialogs",
      "key": "line:Hunter_Hands_DontShoot_07f21e8",
      "source": "Hunter: Этой ночью пойдёшь тоже душить Гостей?",
      "target": "Hunter: Ma éjjel te is Vendégeket fogsz fojtogatni?",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13827,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452685897734",
      "collection": "Dialogs",
      "key": "line:Hunter_Hands_DontShoot_02022ad",
      "source": "Hunter: Ещё бы!",
      "target": "Hunter: Hát persze!",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13828,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452685897733",
      "collection": "Dialogs",
      "key": "line:Hunter_Teeth_DontShoot_09e4ce5",
      "source": "Hunter: Вовремя ты одумался.",
      "target": "Hunter: Még időben észhez tértél.",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13829,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452685897732",
      "collection": "Dialogs",
      "key": "line:Hunter_Teeth_DontShoot_0f4973f",
      "source": "Hunter: Но месить-то надо Гостей, а не друг друга.",
      "target": "Hunter: De a Vendégeket kell szétverni, nem egymást.",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13830,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452685897731",
      "collection": "Dialogs",
      "key": "line:Hunter_Teeth_DontShoot_0ddbcfd",
      "source": "Hunter: Я понимаю, стресс, все дела.",
      "target": "Hunter: Értem én, stressz meg minden.",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13831,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452685897730",
      "collection": "Dialogs",
      "key": "line:Hunter_Ears_Gun_0e30b2b",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13832,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452685897729",
      "collection": "Dialogs",
      "key": "line:Hunter_Ears_Gun_09cd94a",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13833,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452685897728",
      "collection": "Dialogs",
      "key": "line:Hunter_Ears_Gun_0bf2dd6",
      "source": "Hunter: Вывод интересный. А как ты его сделал?",
      "target": "Hunter: Érdekes következtetés. Hogyan jutottál erre?",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13834,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452681703435",
      "collection": "Dialogs",
      "key": "line:Hunter_Ears_Gun_0a102d1",
      "source": "Hunter: Ага. Это я — Гость, получается?",
      "target": "Hunter: Aha. Szóval én lennék a Vendég?",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13835,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452681703434",
      "collection": "Dialogs",
      "key": "line:Hunter_Photo_Gun_0613bf1",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13836,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452681703433",
      "collection": "Dialogs",
      "key": "line:Hunter_Photo_Gun_02024d0",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13837,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452681703432",
      "collection": "Dialogs",
      "key": "line:Hunter_Photo_Gun_0181b0e",
      "source": "Hunter: Всё?",
      "target": "Hunter: Ennyi?",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13838,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452681703431",
      "collection": "Dialogs",
      "key": "line:Hunter_Photo_Gun_02009ca",
      "source": "Hunter: ОЙ!",
      "target": "Hunter: JAJ!",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13839,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452681703430",
      "collection": "Dialogs",
      "key": "line:Hunter_Photo_Gun_09d94bc",
      "source": "Hunter: ...",
      "target": "Hunter: ...",
      "authoredFile": "Translations/hu/dialogue-batch-040.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13840,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452681703429",
      "collection": "Dialogs",
      "key": "line:Hunter_Photo_Gun_03f4817",
      "source": "Hunter: Я вздрогну.",
      "target": "Hunter: Össze fogok rezzenni.",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13841,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452681703428",
      "collection": "Dialogs",
      "key": "line:Hunter_Photo_Gun_0a26479",
      "source": "Hunter: Ох...",
      "target": "Hunter: Óh...",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13842,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452681703427",
      "collection": "Dialogs",
      "key": "line:Hunter_Photo_Gun_0ec25fb",
      "source": "Hunter: Фоткай других. Бей Гостей. От меня отъебись.",
      "target": "Hunter: Másokat fényképezz. A Vendégeket verd. Engem meg hagyj a faszba.",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13843,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452681703426",
      "collection": "Dialogs",
      "key": "line:Hunter_Photo_Gun_0880c9f",
      "source": "Hunter: Да бля, отстань, ты меня не заставишь.",
      "target": "Hunter: Bassza meg, szállj már le rólam! Nem kényszeríthetsz rá.",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13844,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452681703425",
      "collection": "Dialogs",
      "key": "line:Hunter_Armpit_Gun_06ef820",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13845,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452681703424",
      "collection": "Dialogs",
      "key": "line:Hunter_Armpit_Gun_00e033c",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13846,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452677509130",
      "collection": "Dialogs",
      "key": "line:Hunter_Armpit_Gun_0074e05",
      "source": "Hunter: Паранойя только на руку этим монстрам. Успокаиваемся, хорошо?",
      "target": "Hunter: A paranoia csak ezeknek a szörnyeknek kedvez. Nyugodjunk meg, jó?",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13847,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452677509129",
      "collection": "Dialogs",
      "key": "line:Hunter_Armpit_Gun_0d0b87f",
      "source": "Hunter: Сходить с ума не надо.",
      "target": "Hunter: Nem kell megőrülni.",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13848,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452677509128",
      "collection": "Dialogs",
      "key": "line:Hunter_Eyes_Gun_0fe40f1",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13849,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452677509127",
      "collection": "Dialogs",
      "key": "line:Hunter_Eyes_Gun_077cd51",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13850,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452677509126",
      "collection": "Dialogs",
      "key": "line:Hunter_Eyes_Gun_08b377d",
      "source": "Hunter: Не делай резких выводов. Это всегда чревато ошибками.",
      "target": "Hunter: Ne következtess elhamarkodottan. Abból mindig baj lesz.",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13851,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452677509125",
      "collection": "Dialogs",
      "key": "line:Hunter_Eyes_Gun_093c286",
      "source": "Hunter: Подожди, что тебя встревожило? Ты чего, паренёк?",
      "target": "Hunter: Várj, mi aggasztott? Mi van veled, fiú?",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13852,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452677509124",
      "collection": "Dialogs",
      "key": "line:Hunter_Eyes_Gun_09fd436",
      "source": "Hunter: Ну давай, покажи хоть одну нормально работающую больницу! После лечения посмотришь в глаза мне.",
      "target": "Hunter: Na mutass egyetlen rendesen működő kórházat! A kezelés után nézz majd a szemembe.",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13853,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452677509123",
      "collection": "Dialogs",
      "key": "line:Hunter_Eyes_Gun_07f114d",
      "source": "Hunter: Да пиздец, ты ещё и всех безруких отстреливаешь? Они же ногти не покажут!",
      "target": "Hunter: A kurva életbe, most már a kezetleneket is lelövöd? Ők nem tudják megmutatni a körmüket!",
      "authoredFile": "Translations/hu/dialogue-batch-416.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13854,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452677509122",
      "collection": "Dialogs",
      "key": "line:Hunter_Hands_Gun_072611d",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13855,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452677509121",
      "collection": "Dialogs",
      "key": "line:Hunter_Hands_Gun_0cacc9a",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13856,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452677509120",
      "collection": "Dialogs",
      "key": "line:Hunter_Hands_Gun_0f54f57",
      "source": "Hunter: Я хотя бы ночью вглядываюсь в окна, чтобы никакой Гость не подошёл. Одному тебе будет сложнее.",
      "target": "Hunter: Én legalább éjjel az ablakokat figyelem, nehogy egy Vendég idejöjjön. Neked egyedül nehezebb lesz.",
      "authoredFile": "Translations/hu/dialogue-batch-417.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13857,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452673314827",
      "collection": "Dialogs",
      "key": "line:Hunter_Hands_Gun_0a7ccd1",
      "source": "Hunter: Выдыхай давай, не нажми случайно на курок.",
      "target": "Hunter: Fújd ki a levegőt, nehogy véletlenül meghúzd a ravaszt.",
      "authoredFile": "Translations/hu/dialogue-batch-417.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13858,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452673314826",
      "collection": "Dialogs",
      "key": "line:Hunter_Teeth_Gun_0e79a56",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13859,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452673314825",
      "collection": "Dialogs",
      "key": "line:Hunter_Teeth_Gun_0acf272",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13860,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452673314824",
      "collection": "Dialogs",
      "key": "line:Hunter_Teeth_Gun_01e4ab6",
      "source": "Hunter: Нихера себе.",
      "target": "Hunter: Azta kurva.",
      "authoredFile": "Translations/hu/dialogue-batch-417.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13861,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452673314823",
      "collection": "Dialogs",
      "key": "line:Hunter_Teeth_Gun_02c3f77",
      "source": "Hunter: Подожди, и что теперь?",
      "target": "Hunter: Várj, és most mi lesz?",
      "authoredFile": "Translations/hu/dialogue-batch-417.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13862,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452673314822",
      "collection": "Dialogs",
      "key": "line:Hunter_Ears_0ae0de2",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13863,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452673314821",
      "collection": "Dialogs",
      "key": "line:Hunter_Ears_0c345fb",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13864,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452673314820",
      "collection": "Dialogs",
      "key": "line:Hunter_Ears_0d2352d",
      "source": "Hunter: Просто понять бы, на что смотреть вообще.",
      "target": "Hunter: Csak azt kellene tudni, mire nézzünk egyáltalán.",
      "authoredFile": "Translations/hu/dialogue-batch-417.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13865,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452673314819",
      "collection": "Dialogs",
      "key": "line:Hunter_Ears_0c69258",
      "source": "Hunter: Ну что там? Что там, что? Что-то видно, что, что там?",
      "target": "Hunter: Na, mi van ott? Mi van, mi? Látsz valamit? Mit? Mi van ott?",
      "authoredFile": "Translations/hu/dialogue-batch-417.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13866,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452673314818",
      "collection": "Dialogs",
      "key": "line:Hunter_Ears_0af33fd",
      "source": "Hunter: ...",
      "target": "Hunter: ...",
      "authoredFile": "Translations/hu/dialogue-batch-040.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13867,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452673314817",
      "collection": "Dialogs",
      "key": "line:Hunter_Ears_0396e18",
      "source": "Hunter: Ну да, я тоже видел этот выпуск новостей. Давай смотреть, хорошо.",
      "target": "Hunter: Ja, én is láttam azt a híradót. Nézzük meg, jó?",
      "authoredFile": "Translations/hu/dialogue-batch-417.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13868,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452673314816",
      "collection": "Dialogs",
      "key": "line:Hunter_Photo_093a38f",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13869,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452669120521",
      "collection": "Dialogs",
      "key": "line:Hunter_Photo_02ac9ad",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13870,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452669120520",
      "collection": "Dialogs",
      "key": "line:Hunter_Photo_024dd45",
      "source": "Hunter: Я не буду фоткаться.",
      "target": "Hunter: Nem fogok fényképezkedni.",
      "authoredFile": "Translations/hu/dialogue-batch-417.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13871,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452669120519",
      "collection": "Dialogs",
      "key": "line:Hunter_Photo_0508eed",
      "source": "Hunter: Вспышка напоминает мне грозу, у меня сразу паника.",
      "target": "Hunter: A vaku a viharra emlékeztet, rögtön pánikba esem.",
      "authoredFile": "Translations/hu/dialogue-batch-417.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13872,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452669120518",
      "collection": "Dialogs",
      "key": "line:Hunter_Photo_0d8ed21",
      "source": "Hunter: Да я особо не люблю фоткаться.",
      "target": "Hunter: Amúgy sem szeretek fényképezkedni.",
      "authoredFile": "Translations/hu/dialogue-batch-417.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13873,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452669120517",
      "collection": "Dialogs",
      "key": "line:Hunter_Armpit_08c02c5",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13874,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452669120516",
      "collection": "Dialogs",
      "key": "line:Hunter_Armpit_03a2975",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13875,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452669120515",
      "collection": "Dialogs",
      "key": "line:Hunter_Armpit_01bbe11",
      "source": "Hunter: Ну я-то нормальный мужик, как могло быть иначе?",
      "target": "Hunter: Hát én normális férfi vagyok, hogy is lehetne másképp?",
      "authoredFile": "Translations/hu/dialogue-batch-417.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13876,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452669120514",
      "collection": "Dialogs",
      "key": "line:Hunter_Armpit_0d3b012",
      "source": "Hunter: ...",
      "target": "Hunter: ...",
      "authoredFile": "Translations/hu/dialogue-batch-040.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13877,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452669120513",
      "collection": "Dialogs",
      "key": "line:Hunter_Armpit_0104620",
      "source": "Hunter: Отлично, чем больше признаков, тем легче отличить своих от Гостей. Верно?",
      "target": "Hunter: Remek, minél több az ismertetőjegy, annál könnyebb megkülönböztetni a mieinket a Vendégektől. Nem?",
      "authoredFile": "Translations/hu/dialogue-batch-417.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13878,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452669120512",
      "collection": "Dialogs",
      "key": "line:Hunter_Eyes_0c7afcc",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13879,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452664926217",
      "collection": "Dialogs",
      "key": "line:Hunter_Eyes_0576aeb",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13880,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452664926216",
      "collection": "Dialogs",
      "key": "line:Hunter_Eyes_02c145a",
      "source": "Hunter: Тогда мы снова спокойно заживем.",
      "target": "Hunter: Akkor megint nyugodtan élhetünk.",
      "authoredFile": "Translations/hu/dialogue-batch-417.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13881,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452664926215",
      "collection": "Dialogs",
      "key": "line:Hunter_Eyes_03e6d64",
      "source": "Hunter: Но я доберусь до всех. Раздеру их руками.",
      "target": "Hunter: De mindet elkapom. Puszta kézzel tépem szét őket.",
      "authoredFile": "Translations/hu/dialogue-batch-417.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13882,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452664926214",
      "collection": "Dialogs",
      "key": "line:Hunter_Eyes_0ca8c5d",
      "source": "Hunter: ...",
      "target": "Hunter: ...",
      "authoredFile": "Translations/hu/dialogue-batch-040.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13883,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452664926213",
      "collection": "Dialogs",
      "key": "line:Hunter_Eyes_0455790",
      "source": "Hunter: ...",
      "target": "Hunter: ...",
      "authoredFile": "Translations/hu/dialogue-batch-040.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13884,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452664926212",
      "collection": "Dialogs",
      "key": "line:Hunter_Eyes_0a2a522",
      "source": "Hunter: Сейчас, конечно, от такой жизни только серые глаза достаются нам.",
      "target": "Hunter: Persze, ettől az élettől most csak szürke szem jut nekünk.",
      "authoredFile": "Translations/hu/dialogue-batch-417.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13885,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452664926211",
      "collection": "Dialogs",
      "key": "line:Hunter_Eyes_0a102f8",
      "source": "Hunter: Ай-ай, больно, осторожно.",
      "target": "Hunter: Jaj, fáj, óvatosan.",
      "authoredFile": "Translations/hu/dialogue-batch-417.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13886,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452664926210",
      "collection": "Dialogs",
      "key": "line:Hunter_Eyes_0e2dcb6",
      "source": "Hunter: ...",
      "target": "Hunter: ...",
      "authoredFile": "Translations/hu/dialogue-batch-040.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13887,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452664926209",
      "collection": "Dialogs",
      "key": "line:Hunter_Eyes_0699b69",
      "source": "Hunter: Когда я одного из Гостей мочил, кинул мне то ли землю, то ли говно какое в глаза. Постоянно болят теперь.",
      "target": "Hunter: Amikor az egyik Vendéget intéztem el, valami földet vagy szart vágott a szemembe. Azóta folyton fáj.",
      "authoredFile": "Translations/hu/dialogue-batch-417.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13888,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452664926208",
      "collection": "Dialogs",
      "key": "line:Hunter_Eyes_05f6eaa",
      "source": "Hunter: А от недавнего случая глаза у меня только красные.",
      "target": "Hunter: Attól a nemrég történt esettől csak vörös lett a szemem.",
      "authoredFile": "Translations/hu/dialogue-batch-417.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13889,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452660731914",
      "collection": "Dialogs",
      "key": "line:Hunter_Eyes_0923f29",
      "source": "Hunter: Знаешь, у меня когда-то был цвет в глазах.",
      "target": "Hunter: Tudod, régen még volt színe a szememnek.",
      "authoredFile": "Translations/hu/dialogue-batch-417.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13890,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452660731913",
      "collection": "Dialogs",
      "key": "line:Hunter_Hands_0d64763",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13891,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452660731912",
      "collection": "Dialogs",
      "key": "line:Hunter_Hands_052d166",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13892,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452660731911",
      "collection": "Dialogs",
      "key": "line:Hunter_Hands_0cbcc7f",
      "source": "Hunter: Тебе советую делать то же самое.",
      "target": "Hunter: Neked is azt tanácsolom, hogy ugyanezt tedd.",
      "authoredFile": "Translations/hu/dialogue-batch-417.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13893,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452660731910",
      "collection": "Dialogs",
      "key": "line:Hunter_Hands_0861937",
      "source": "Hunter: Их так даже проще убивать!",
      "target": "Hunter: Így még könnyebb megölni őket!",
      "authoredFile": "Translations/hu/dialogue-batch-417.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13894,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452660731909",
      "collection": "Dialogs",
      "key": "line:Hunter_Hands_070b3be",
      "source": "Hunter: Конечно, у меня руки будут грязные, я хожу по ночам копать этих чертей.",
      "target": "Hunter: Persze hogy koszos a kezem, éjjelente ezeket a rohadékokat ásom elő.",
      "authoredFile": "Translations/hu/dialogue-batch-417.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13895,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452660731908",
      "collection": "Dialogs",
      "key": "line:Hunter_Hands_0f1082f",
      "source": "Hunter: ...",
      "target": "Hunter: ...",
      "authoredFile": "Translations/hu/dialogue-batch-040.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13896,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452660731907",
      "collection": "Dialogs",
      "key": "line:Hunter_Hands_0ac0c90",
      "source": "Hunter: Погнали-погнали.",
      "target": "Hunter: Gyerünk, gyerünk.",
      "authoredFile": "Translations/hu/dialogue-batch-417.json",
