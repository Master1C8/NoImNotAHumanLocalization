    },
    {
      "ordinal": 12972,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453105328135",
      "collection": "Dialogs",
      "key": "line:Provocateur_Eyes_02460f1",
      "source": "Provocateur: И что вы пытаетесь в них найти? Злой взгляд?",
      "target": "Provocateur: És mit akar találni bennük? Gonosz tekintetet?",
      "authoredFile": "Translations/hu/dialogue-batch-394.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12973,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453105328134",
      "collection": "Dialogs",
      "key": "line:Provocateur_Eyes_00f4e1e",
      "source": "Provocateur: И что вы пытаетесь в них найти? Красноту?",
      "target": "Provocateur: És mit akar találni bennük? Piros elszíneződést?",
      "authoredFile": "Translations/hu/dialogue-batch-394.json",
