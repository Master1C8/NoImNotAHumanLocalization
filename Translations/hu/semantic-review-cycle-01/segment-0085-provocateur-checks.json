      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453101133828",
      "collection": "Dialogs",
      "key": "line:Provocateur_Teeth_0792627",
      "source": "Provocateur: Может, вы у меня ещё в зубах поковыряться хотите?",
      "target": "Provocateur: Talán még a fogaim közt is turkálna?",
      "authoredFile": "Translations/hu/dialogue-batch-394.json",
