      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12968,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453109522435",
      "collection": "Dialogs",
      "key": "line:Provocateur_Eyes_04ea1f7",
