    {
      "ordinal": 12953,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453117911040",
      "collection": "Dialogs",
      "key": "line:Provocateur_Ears_053f573",
      "source": "Provocateur: Тебе в доктора захотелось поиграть? И как? Ушные пробки есть? Что пропишите, господин доктор?",
      "target": "Provocateur: Orvososdit akarsz játszani? Na, van fülzsírdugó? Mit ír fel, doktor úr?",
      "authoredFile": "Translations/hu/dialogue-batch-394.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12954,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453113716744",
      "collection": "Dialogs",
      "key": "line:Provocateur_Ears_00d2fd9",
      "source": "Provocateur: ...",
      "target": "Provocateur: ...",
      "authoredFile": "Translations/hu/dialogue-batch-039.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12955,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453113716743",
      "collection": "Dialogs",
      "key": "line:Provocateur_Ears_01711fd",
      "source": "Provocateur: А если скажут, что лобковые волосы – это новый признак, будете со всех штаны спускать!?",
      "target": "Provocateur: És ha azt mondják, hogy a szeméremszőrzet az új ismertetőjel, mindenkiről lerángatja a nadrágot!?",
      "authoredFile": "Translations/hu/dialogue-batch-394.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12956,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453113716742",
      "collection": "Dialogs",
      "key": "line:Provocateur_Ears_01e7dd3",
      "source": "Provocateur: Боже, вы верите всему, что говорят по телевизору?",
      "target": "Provocateur: Úristen, maga mindent elhisz, amit a tévében mondanak?",
      "authoredFile": "Translations/hu/dialogue-batch-394.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12957,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453113716741",
      "collection": "Dialogs",
