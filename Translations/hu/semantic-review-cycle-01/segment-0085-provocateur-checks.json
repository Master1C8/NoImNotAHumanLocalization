  "rows": [
    {
      "ordinal": 12912,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453134688263",
      "collection": "Dialogs",
      "key": "line:Provocateur_Death_047b2b2",
      "source": "Provocateur: НЕ-Е-Е-Е-ЕТ!!!",
      "target": "Provocateur: NE-E-E-E!!!",
      "authoredFile": "Translations/hu/dialogue-batch-393.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12913,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453134688262",
      "collection": "Dialogs",
      "key": "line:Provocateur_Death_0e61d9f",
      "source": "Provocateur: Стойте, не надо!",
      "target": "Provocateur: Álljon meg, ne tegye!",
      "authoredFile": "Translations/hu/dialogue-batch-393.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12914,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453134688261",
      "collection": "Dialogs",
      "key": "line:Provocateur_Death_0cb9660",
      "source": "Provocateur: Подождите, вы что, правда нажмёте на курок…",
      "target": "Provocateur: Várjon, maga tényleg meghúzza a ravaszt…",
      "authoredFile": "Translations/hu/dialogue-batch-393.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12915,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453134688260",
      "collection": "Dialogs",
      "key": "line:Provocateur_Ears_DontShoot_01adf79",
      "source": "Provocateur: Какого чёрта вы каждый раз достаёте ружьё? В чём странность иметь серу в ушах? Куда катиться мир…",
      "target": "Provocateur: Mi a francért kapja elő folyton a puskát? Mi olyan furcsa abban, hogy fülzsír van a fülemben? Hová jutott ez a világ…",
      "authoredFile": "Translations/hu/dialogue-batch-393.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12916,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453134688259",
      "collection": "Dialogs",
      "key": "line:Provocateur_Ears_DontShoot_0a55aad",
      "source": "Provocateur: Если вы ждёте благодарности за то, что не снесли мне полбашки, то напрасно.",
      "target": "Provocateur: Ha hálát vár azért, mert nem lőtte szét a fél fejemet, hiába várja.",
      "authoredFile": "Translations/hu/dialogue-batch-393.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12917,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453134688258",
      "collection": "Dialogs",
      "key": "line:Provocateur_Armpit_DontShoot_0490979",
      "source": "Provocateur: Дожили…",
      "target": "Provocateur: Hát ezt is megértük…",
      "authoredFile": "Translations/hu/dialogue-batch-393.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12918,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453134688257",
      "collection": "Dialogs",
      "key": "line:Provocateur_Armpit_DontShoot_020e609",
      "source": "Provocateur: По вашему мнению, я должен не брить подмышки, чтобы вы не тыкали в меня ружьём?",
      "target": "Provocateur: Maga szerint nem szabadna borotválnom a hónaljamat, hogy ne szegezze rám a puskáját?",
      "authoredFile": "Translations/hu/dialogue-batch-393.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12919,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453134688256",
      "collection": "Dialogs",
      "key": "line:Provocateur_Photo_DontShoot_0ee0d57",
      "source": "Provocateur: Вы так скоро меня до седых волос доведёте!",
      "target": "Provocateur: Így hamar megőszülök magától!",
      "authoredFile": "Translations/hu/dialogue-batch-393.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12920,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453130493961",
      "collection": "Dialogs",
      "key": "line:Provocateur_Photo_DontShoot_00daad5",
      "source": "Provocateur: Прекращайте этот цирк, нет никаких Гостей!",
      "target": "Provocateur: Fejezze be ezt a cirkuszt, nincsenek is Vendégek!",
      "authoredFile": "Translations/hu/dialogue-batch-393.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12921,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453130493960",
      "collection": "Dialogs",
      "key": "line:Provocateur_Eyes_DontShoot_0436b18",
      "source": "Provocateur: Вы вообще нормальный? Сначала наставили ружьё, а потом убрали, будто ничего и не было. Псих!",
      "target": "Provocateur: Normális maga? Előbb rám fogja a puskát, aztán leereszti, mintha mi sem történt volna. Pszichopata!",
      "authoredFile": "Translations/hu/dialogue-batch-393.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12922,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453130493959",
      "collection": "Dialogs",
      "key": "line:Provocateur_Hands_DontShoot_035978b",
      "source": "Provocateur: Не надо при малейшей несостыковке доставать ружьё!",
      "target": "Provocateur: Ne kapja elő a puskát minden apró ellentmondásnál!",
      "authoredFile": "Translations/hu/dialogue-batch-393.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12923,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453130493958",
      "collection": "Dialogs",
      "key": "line:Provocateur_Teeth_DontShoot_0c07698",
      "source": "Provocateur: Зачем вы вообще к себе пускаете людей, если так легко готовы их убить? Грёбаный маньяк!",
      "target": "Provocateur: Minek enged be embereket, ha ilyen könnyen megölné őket? Rohadt mániákus!",
      "authoredFile": "Translations/hu/dialogue-batch-393.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12924,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453130493957",
      "collection": "Dialogs",
      "key": "line:Provocateur_Teeth_DontShoot_0fda0a6",
      "source": "Provocateur: Надо же, крупицы здравых мыслей у вас всё-таки остались!",
      "target": "Provocateur: Nahát, maradt magában egy csipetnyi józan ész!",
      "authoredFile": "Translations/hu/dialogue-batch-393.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12925,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453130493956",
      "collection": "Dialogs",
      "key": "line:Provocateur_Ears_Gun_0eec4c6",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12926,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453130493955",
      "collection": "Dialogs",
      "key": "line:Provocateur_Ears_Gun_0c64ec7",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12927,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453130493954",
      "collection": "Dialogs",
      "key": "line:Provocateur_Ears_Gun_0894b53",
      "source": "Provocateur: Или вы считаете, что выстрел из ружья как-то поможет прочистить мне уши?",
      "target": "Provocateur: Vagy azt hiszi, egy lövéstől kitisztul a fülem?",
      "authoredFile": "Translations/hu/dialogue-batch-393.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12928,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453130493953",
      "collection": "Dialogs",
      "key": "line:Provocateur_Ears_Gun_0ce6adc",
      "source": "Provocateur: Может, вы перестанете при малейшей несостыковке со сказанным по телевизору тыкать в людей ружьём!?",
      "target": "Provocateur: Abbahagyná végre, hogy minden alkalommal puskát szegez az emberekre, amikor valami nem egyezik azzal, amit a tévében mondtak!?",
      "authoredFile": "Translations/hu/dialogue-batch-393.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12929,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453130493952",
      "collection": "Dialogs",
      "key": "line:Provocateur_Armpit_Gun_00bbc5b",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12930,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453126299657",
      "collection": "Dialogs",
      "key": "line:Provocateur_Armpit_Gun_0799de9",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12931,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453126299656",
      "collection": "Dialogs",
      "key": "line:Provocateur_Armpit_Gun_0978b12",
      "source": "Provocateur: Гениально! В этом вообще нет логики, но действительно, давайте и этому верить.",
      "target": "Provocateur: Zseniális! Semmi logika nincs benne, de persze higgyük el ezt is.",
      "authoredFile": "Translations/hu/dialogue-batch-393.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12932,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453126299655",
      "collection": "Dialogs",
      "key": "line:Provocateur_Armpit_Gun_00c63f4",
      "source": "Provocateur: …",
      "target": "Provocateur: …",
      "authoredFile": "Translations/hu/dialogue-batch-039.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12933,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453126299654",
      "collection": "Dialogs",
      "key": "line:Provocateur_Armpit_Gun_009c075",
      "source": "Provocateur: По-вашему, так называемые Гости бреют подмышки, находясь под землёй?",
      "target": "Provocateur: Maga szerint az úgynevezett Vendégek a föld alatt borotválják a hónaljukat?",
      "authoredFile": "Translations/hu/dialogue-batch-393.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12934,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453126299653",
      "collection": "Dialogs",
      "key": "line:Provocateur_Armpit_Gun_0f9182a",
      "source": "Provocateur: Вы в своём уме? Каким боком бритые подмышки доказывают, что я — Гость?",
      "target": "Provocateur: Magánál minden rendben? Miből bizonyítaná a borotvált hónaljam, hogy Vendég vagyok?",
      "authoredFile": "Translations/hu/dialogue-batch-393.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12935,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453126299652",
      "collection": "Dialogs",
      "key": "line:Provocateur_Photo_Gun_0f49423",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12936,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453126299651",
      "collection": "Dialogs",
      "key": "line:Provocateur_Photo_Gun_06b4fcc",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12937,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453126299650",
      "collection": "Dialogs",
      "key": "line:Provocateur_Photo_Gun_04738c1",
      "source": "Provocateur: С таким же успехом можете подбрасыванием монетки решать, кого вы убьёте следующим.",
      "target": "Provocateur: Ennyi erővel pénzfeldobással is eldönthetné, kit öl meg legközelebb.",
      "authoredFile": "Translations/hu/dialogue-batch-393.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12938,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453126299649",
      "collection": "Dialogs",
      "key": "line:Provocateur_Photo_Gun_073c63b",
      "source": "Provocateur: Да вы издеваетесь!? Вы по фотографии «ауры» хотите определять людей?",
      "target": "Provocateur: Most szórakozik velem!? Egy „aurafotó” alapján akarja eldönteni, ki ember?",
      "authoredFile": "Translations/hu/dialogue-batch-393.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12939,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453126299648",
      "collection": "Dialogs",
      "key": "line:Provocateur_Photo_Gun_05fcbd5",
      "source": "Provocateur: Да вы издеваетесь!? Я что, дёрнулся на фотке, и вам это кажется подозрительным?",
      "target": "Provocateur: Most szórakozik velem!? Bemozdultam a képen, és ez magának gyanús?",
      "authoredFile": "Translations/hu/dialogue-batch-393.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12940,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453122105351",
      "collection": "Dialogs",
      "key": "line:Provocateur_Eyes_Gun_07a6a87",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12941,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453122105350",
      "collection": "Dialogs",
      "key": "line:Provocateur_Eyes_Gun_04fb0cd",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12942,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453122105349",
      "collection": "Dialogs",
      "key": "line:Provocateur_Eyes_Gun_00908a7",
      "source": "Provocateur: Серьёзно!? А сейчас что не так?",
      "target": "Provocateur: Komolyan!? Most meg mi a baj?",
      "authoredFile": "Translations/hu/dialogue-batch-393.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12943,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453122105348",
      "collection": "Dialogs",
      "key": "line:Provocateur_Hands_Gun_0c1e601",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12944,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453122105347",
      "collection": "Dialogs",
      "key": "line:Provocateur_Hands_Gun_085d9a4",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12945,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453122105346",
      "collection": "Dialogs",
      "key": "line:Provocateur_Hands_Gun_02b745d",
      "source": "Provocateur: А сейчас-то что не так?",
      "target": "Provocateur: Most meg mi a baj?",
      "authoredFile": "Translations/hu/dialogue-batch-393.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12946,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453122105345",
      "collection": "Dialogs",
      "key": "line:Provocateur_Hands_Gun_04b6dd8",
      "source": "Provocateur: Какого хрена!? Грязь под ногтями теперь означает, что я Гость?",
      "target": "Provocateur: Mi a franc!? A kosz a körmöm alatt most már azt jelenti, hogy Vendég vagyok?",
      "authoredFile": "Translations/hu/dialogue-batch-393.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12947,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453122105344",
      "collection": "Dialogs",
      "key": "line:Provocateur_Teeth_Gun_0861084",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12948,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453117911045",
      "collection": "Dialogs",
      "key": "line:Provocateur_Teeth_Gun_02d5b8a",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12949,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453117911044",
      "collection": "Dialogs",
      "key": "line:Provocateur_Teeth_Gun_070d869",
      "source": "Provocateur: Ну давайте, стреляйте, чистые зубы – это ведь точно говорит о том, что я Гость.",
      "target": "Provocateur: Hát tessék, lőjön le, a tiszta fogaim nyilván bizonyítják, hogy Vendég vagyok.",
      "authoredFile": "Translations/hu/dialogue-batch-393.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12950,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453117911043",
      "collection": "Dialogs",
      "key": "line:Provocateur_Teeth_Gun_09f7cae",
      "source": "Provocateur: Ну конечно, меньшего я и не ждал от вас.",
      "target": "Provocateur: Persze, magától nem is vártam mást.",
      "authoredFile": "Translations/hu/dialogue-batch-393.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12951,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453117911042",
