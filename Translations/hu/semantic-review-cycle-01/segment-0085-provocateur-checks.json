      "collection": "Dialogs",
      "key": "line:Provocateur_Hands_01acfd1",
      "source": "Provocateur: Руки? Зачем?",
      "target": "Provocateur: A kezemet? Minek?",
      "authoredFile": "Translations/hu/dialogue-batch-394.json",
