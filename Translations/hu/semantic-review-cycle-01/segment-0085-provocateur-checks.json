    {
      "ordinal": 12952,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453117911041",
      "collection": "Dialogs",
      "key": "line:Provocateur_Ears_0f4b1a7",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
