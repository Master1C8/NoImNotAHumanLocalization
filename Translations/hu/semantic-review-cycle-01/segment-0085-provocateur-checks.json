      "collection": "Dialogs",
      "key": "line:Provocateur_Eyes_0abb55f",
      "source": "Provocateur: Ну! Нашли что-нибудь!?",
      "target": "Provocateur: Na! Talált valamit!?",
      "authoredFile": "Translations/hu/dialogue-batch-394.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12970,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453109522433",
      "collection": "Dialogs",
      "key": "line:Provocateur_Eyes_0f53acf",
      "source": "Provocateur: Ну! Без красноты, не правда ли!",
      "target": "Provocateur: Na! Nincs bennük semmi piros, ugye!",
      "authoredFile": "Translations/hu/dialogue-batch-394.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12971,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453109522432",
      "collection": "Dialogs",
      "key": "line:Provocateur_Eyes_04931f9",
      "source": "Provocateur: ...",
      "target": "Provocateur: ...",
      "authoredFile": "Translations/hu/dialogue-batch-039.json",
