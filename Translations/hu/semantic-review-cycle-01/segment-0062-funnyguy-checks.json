  "rows": [
    {
      "ordinal": 11083,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454107766784",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Death_053df51",
      "source": "FunnyGuy: Мой ад заканчивается.",
      "target": "FunnyGuy: Véget ér a poklom.",
      "authoredFile": "Translations/hu/dialogue-batch-348.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11084,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454103572491",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Death_0f03917",
      "source": "FunnyGuy: Ну хоть для меня это закончится.",
      "target": "FunnyGuy: Legalább nekem véget ér.",
      "authoredFile": "Translations/hu/dialogue-batch-348.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11085,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454103572490",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Death_0f03b3b",
      "source": "FunnyGuy: Вот это у тебя смехуечки.",
      "target": "FunnyGuy: Hát ez aztán remek vicc volt tőled.",
      "authoredFile": "Translations/hu/dialogue-batch-348.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11086,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454103572489",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Ears_DontShoot_0e48715",
      "source": "FunnyGuy: И с работы попёрли нас несправедливо.",
      "target": "FunnyGuy: A munkából is igazságtalanul rúgtak ki minket.",
      "authoredFile": "Translations/hu/dialogue-batch-348.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11087,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454103572488",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Ears_DontShoot_063aac5",
      "source": "FunnyGuy: Всё-таки несправедливо у меня отжали деньги.",
      "target": "FunnyGuy: Végül is igazságtalanul vették el a pénzemet.",
      "authoredFile": "Translations/hu/dialogue-batch-348.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11088,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454103572487",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Photo_DontShoot_0495903",
      "source": "FunnyGuy: У меня теперь тоже такое отношение к фоткам.",
      "target": "FunnyGuy: Most már én is így viszonyulok a fényképekhez.",
      "authoredFile": "Translations/hu/dialogue-batch-348.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11089,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454103572486",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Photo_DontShoot_065f41a",
      "source": "FunnyGuy: «Ой, убери, чё ты припёрся с фотиком, иди лягушек пофоткай».",
      "target": "FunnyGuy: „Jaj, tedd el! Minek jössz ide a fényképeződdel? Menj, fotózz inkább békákat.”",
      "authoredFile": "Translations/hu/dialogue-batch-348.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11090,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454103572485",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Photo_DontShoot_0b4dff0",
      "source": "FunnyGuy: В нашей семье все как-то реагировали на фото… по-злому, что ли.",
      "target": "FunnyGuy: A családunkban valahogy mindenki… haragosan reagált a fényképekre.",
      "authoredFile": "Translations/hu/dialogue-batch-348.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11091,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454103572484",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Armpit_DontShoot_0ea2aa1",
      "source": "FunnyGuy: Не жизнь, а сказка, АХАХАХА.",
      "target": "FunnyGuy: Kész tündérmese ez az élet, AHAHAHAHA.",
      "authoredFile": "Translations/hu/dialogue-batch-348.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11092,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454103572483",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Armpit_DontShoot_08b08aa",
      "source": "FunnyGuy: Работы нет, деньги украли банки, ещё и солнце жарит каждый день.",
      "target": "FunnyGuy: Nincs munka, a bankok ellopták a pénzt, a nap meg mindennap perzsel.",
      "authoredFile": "Translations/hu/dialogue-batch-348.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11093,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454103572482",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Armpit_DontShoot_0f079ff",
      "source": "FunnyGuy: Ну, видимо, сейчас на пенсию выхожу.",
      "target": "FunnyGuy: Hát akkor úgy látszik, most megyek nyugdíjba.",
      "authoredFile": "Translations/hu/dialogue-batch-348.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11094,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454103572481",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Eyes_DontShoot_058da0b",
      "source": "FunnyGuy: Ну и бог тебе судья.",
      "target": "FunnyGuy: Hát majd Isten ítélkezik fölötted.",
      "authoredFile": "Translations/hu/dialogue-batch-348.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11095,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454103572480",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Eyes_DontShoot_0428cc1",
      "source": "FunnyGuy: Я тебя прекрасно вижу. Как и ружьё, которое ты недавно наставлял.",
      "target": "FunnyGuy: Tökéletesen látlak. Ahogy a puskát is, amit nemrég rám szegeztél.",
      "authoredFile": "Translations/hu/dialogue-batch-348.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11096,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454099378186",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Eyes_DontShoot_0ed12bc",
      "source": "FunnyGuy: Что ты хочешь ещё услышать-то?",
      "target": "FunnyGuy: Mit akarsz még hallani?",
      "authoredFile": "Translations/hu/dialogue-batch-348.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11097,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454099378185",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Hands_DontShoot_09515fe",
      "source": "FunnyGuy: Даже умереть спокойно не дадут.",
      "target": "FunnyGuy: Még békésen meghalni sem hagyják az embert.",
      "authoredFile": "Translations/hu/dialogue-batch-348.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11098,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454099378184",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Hands_DontShoot_0d2dde8",
      "source": "FunnyGuy: Предприятие закрывают из-за растущих убытков.",
      "target": "FunnyGuy: A növekvő veszteségek miatt bezárják a vállalatot.",
      "authoredFile": "Translations/hu/dialogue-batch-348.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11099,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454099378183",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Hands_DontShoot_0df0a38",
      "source": "FunnyGuy: Отпахал как чёрт, а что толку.",
      "target": "FunnyGuy: Dolgoztam, mint az állat, és mire mentem vele?",
      "authoredFile": "Translations/hu/dialogue-batch-348.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11100,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454099378182",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Hands_DontShoot_08b88c6",
      "source": "FunnyGuy: Вот мог ты себе представить, что в очередной рабочий день тебя просто сократят?",
      "target": "FunnyGuy: El tudtad volna képzelni, hogy egy átlagos munkanapon egyszerűen leépítenek?",
      "authoredFile": "Translations/hu/dialogue-batch-348.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11101,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454099378181",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Teeth_DontShoot_02fa344",
      "source": "FunnyGuy: История про зубы? Ну не, ты ж не думал, что можешь просто наставить оружие, а потом как ни в чём не бывало общаться!",
      "target": "FunnyGuy: A fogam története? Ne már, ugye nem gondoltad, hogy csak úgy rám foghatod a fegyvert, aztán úgy beszélgethetünk, mintha mi sem történt volna!",
      "authoredFile": "Translations/hu/dialogue-batch-348.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11102,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454099378180",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Teeth_DontShoot_0f5b829",
      "source": "FunnyGuy: Ну спасибо, что не застрелил.",
      "target": "FunnyGuy: Kösz, hogy nem lőttél le.",
      "authoredFile": "Translations/hu/dialogue-batch-348.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11103,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454099378179",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Ears_Gun_0bb674a",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11104,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454099378178",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Ears_Gun_03e25cf",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11105,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454099378177",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Ears_Gun_0ad19ae",
      "source": "FunnyGuy: Ты сам-то махать ружьём не устал?",
      "target": "FunnyGuy: Te nem unod még, hogy hadonászol a puskával?",
      "authoredFile": "Translations/hu/dialogue-batch-348.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11106,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454099378176",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Photo_Gun_0f0a6ae",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11107,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454095183883",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Photo_Gun_0de865f",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11108,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454095183882",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Photo_Gun_0c267ed",
      "source": "FunnyGuy: Это не то, что я просил показать.",
      "target": "FunnyGuy: Nem ezt kértem, hogy mutasd meg.",
      "authoredFile": "Translations/hu/dialogue-batch-348.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11109,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454095183881",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Armpit_Gun_0b2672f",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11110,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454095183880",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Armpit_Gun_01942b1",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11111,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454095183879",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Armpit_Gun_07ceea7",
      "source": "FunnyGuy: От чего угодно и сразу!",
      "target": "FunnyGuy: Bármitől, méghozzá azonnal!",
      "authoredFile": "Translations/hu/dialogue-batch-348.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11112,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454095183878",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Armpit_Gun_04c20a7",
      "source": "FunnyGuy: Хах, ну только если так решать проблему, то оно, конечно, поможет.",
      "target": "FunnyGuy: Hah, ha így akarod megoldani a problémát, persze, ez segít.",
      "authoredFile": "Translations/hu/dialogue-batch-348.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11113,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454095183877",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Eyes_Gun_0b56b97",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11114,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454095183876",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Eyes_Gun_09454db",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11115,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454095183875",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Eyes_Gun_0a7fa1d",
      "source": "FunnyGuy: Хочешь стрелять — стреляй.",
      "target": "FunnyGuy: Ha lőni akarsz, lőj.",
      "authoredFile": "Translations/hu/dialogue-batch-348.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11116,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454095183874",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Eyes_Gun_0994a72",
      "source": "FunnyGuy: Ой, да пошло оно всё нахуй.",
      "target": "FunnyGuy: Jaj, menjen az egész a faszba.",
      "authoredFile": "Translations/hu/dialogue-batch-348.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11117,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454095183873",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Hands_Gun_08dbd98",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11118,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454095183872",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Hands_Gun_0c766d8",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11119,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454090989578",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Hands_Gun_012caf9",
      "source": "FunnyGuy: Ну чего ты бесишься? Давай прекращай вот это вот.",
      "target": "FunnyGuy: Miért húzod fel magad? Hagyd már abba ezt az egészet.",
      "authoredFile": "Translations/hu/dialogue-batch-348.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11120,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454090989577",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Teeth_Gun_09f521d",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11121,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454090989576",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Teeth_Gun_0e9a0fa",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11122,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454090989575",
      "collection": "Dialogs",
      "key": "line:FunnyGuy_Teeth_Gun_06a0bb5",
      "source": "FunnyGuy: Э, давай-ка спокойнее. Характер мне показывать не надо.",
