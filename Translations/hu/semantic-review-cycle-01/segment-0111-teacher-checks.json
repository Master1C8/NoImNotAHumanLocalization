      "collection": "Dialogs",
      "key": "line:Teacher_Death_0a93fdd",
      "source": "Teacher: Наконец-то это закончится…",
      "target": "Teacher: Végre vége lesz ennek…",
      "authoredFile": "Translations/hu/dialogue-batch-428.json",
