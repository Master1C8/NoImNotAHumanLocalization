      "collection": "Dialogs",
      "key": "line:Teacher_Teeth_070d4e7",
      "source": "Teacher: Они били меня, когда привязали к столбу. Хотели, чтобы я смотрела…",
      "target": "Teacher: Megvertek, amikor az oszlophoz kötöztek. Azt akarták, hogy végignézzem…",
      "authoredFile": "Translations/hu/dialogue-batch-429.json",
      "reviewResult": "pass"
    },
