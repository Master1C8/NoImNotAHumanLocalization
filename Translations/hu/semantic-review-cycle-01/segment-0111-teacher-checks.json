      "reviewResult": "pass"
    },
    {
      "ordinal": 14393,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452480376840",
      "collection": "Dialogs",
      "key": "line:Teacher_Armpit_06da366",
      "source": "Teacher: Что, простите?.. Вы уверены, что это обязательно?.. Ох уж эти признаки…",
      "target": "Teacher: Tessék, elnézést?.. Biztos benne, hogy ez szükséges?.. Jaj, ezek a jelek…",
      "authoredFile": "Translations/hu/dialogue-batch-429.json",
      "reviewResult": "pass"
    },
