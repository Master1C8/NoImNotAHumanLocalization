      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451998031877",
      "collection": "Dialogs",
      "key": "line:Widow_Hands_DontShoot_0bfb6d5",
      "source": "Widow: Я срываюсь на всех вокруг. Но...",
      "target": "Widow: Mindenkin kitöltöm a dühömet. De...",
      "authoredFile": "Translations/hu/dialogue-batch-456.json",
      "reviewResult": "pass"
    },
    {
