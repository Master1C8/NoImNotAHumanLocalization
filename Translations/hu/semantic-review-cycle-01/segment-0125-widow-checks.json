      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451998031878",
      "collection": "Dialogs",
      "key": "line:Widow_Hands_DontShoot_07f8956",
      "source": "Widow: Никто не виноват. Кроме определённых ублюдков.",
      "target": "Widow: Senki sem hibás. Bizonyos rohadékokat kivéve.",
      "authoredFile": "Translations/hu/dialogue-batch-456.json",
      "reviewResult": "pass"
    },
    {
