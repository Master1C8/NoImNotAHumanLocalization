  "rows": [
    {
      "ordinal": 13496,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452845281284",
      "collection": "Dialogs",
      "key": "line:Greatmother_Death_0a34b8d",
      "source": "Greatmother: Ты всех обрёк на смерть, хахахаха!",
      "target": "Greatmother: Mindenkit halálra ítéltél, hahahaha!",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13497,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452845281283",
      "collection": "Dialogs",
      "key": "line:Greatmother_Death_026faf4",
      "source": "Greatmother: После меня придут и добьют тебя и всю твою шоблу.",
      "target": "Greatmother: Utánam mások jönnek, és végeznek veled meg az egész bandáddal.",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13498,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452845281282",
      "collection": "Dialogs",
      "key": "line:Greatmother_Death_0454ea2",
      "source": "Greatmother: Да ты стреляй.",
      "target": "Greatmother: Csak lőj.",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13499,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452845281281",
      "collection": "Dialogs",
      "key": "line:Greatmother_Ears_DontShoot_0fb0ea3",
      "source": "Greatmother: Зараза, как бы яйца не отложил в мозг.",
      "target": "Greatmother: A rohadt dög, nehogy petéket rakjon az agyamba.",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13500,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452845281280",
      "collection": "Dialogs",
      "key": "line:Greatmother_Ears_DontShoot_02dee2b",
      "source": "Greatmother: Уши-то у меня самый здоровый орган в теле.",
      "target": "Greatmother: A fülem a legegészségesebb részem.",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13501,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452841086985",
      "collection": "Dialogs",
      "key": "line:Greatmother_Ears_DontShoot_0d7ea7e",
      "source": "Greatmother: А тебе насекомые не залетали в рот или ещё куда?",
      "target": "Greatmother: A te szádba nem repültek még rovarok? Vagy máshová?",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13502,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452841086984",
      "collection": "Dialogs",
      "key": "line:Greatmother_Photo_DontShoot_022bdbc",
      "source": "Greatmother: У меня и фотографий не осталось уже. Мне и на эту плевать, но пусть полежит, что ли.",
      "target": "Greatmother: Nekem már fényképeim sincsenek. Ez sem érdekel különösebben, de hadd maradjon meg.",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13503,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452841086983",
      "collection": "Dialogs",
      "key": "line:Greatmother_Photo_DontShoot_04de354",
      "source": "Greatmother: Можно я у себя оставлю?",
      "target": "Greatmother: Megtarthatom magamnak?",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13504,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452841086982",
      "collection": "Dialogs",
      "key": "line:Greatmother_Armpit_DontShoot_0827b0a",
      "source": "Greatmother: Не то что в моём возрасте так, а при жизни современной так дрянно чувствовать себя будем.",
      "target": "Greatmother: Nem csak az én koromban van ez így. A mai élet mellett mind ilyen pocsékul érezzük magunkat.",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13505,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452841086981",
      "collection": "Dialogs",
      "key": "line:Greatmother_Armpit_DontShoot_0056077",
      "source": "Greatmother: Недавно фразу такую услышала. Если ничего не болит, значит, уже умер.",
      "target": "Greatmother: Nemrég hallottam egy mondást. Ha semmid sem fáj, akkor már meghaltál.",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13506,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452841086980",
      "collection": "Dialogs",
      "key": "line:Greatmother_Eyes_DontShoot_039a0c8",
      "source": "Greatmother: Много ли раз ты ошибался? Берешь ли ты на себя ответственность за такие убийства?",
      "target": "Greatmother: Hányszor tévedtél már? Vállalod a felelősséget az ilyen gyilkosságokért?",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13507,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452841086979",
      "collection": "Dialogs",
      "key": "line:Greatmother_Eyes_DontShoot_07cabf9",
      "source": "Greatmother: Было бы страшно ошибиться и случайно убить человека.",
      "target": "Greatmother: Borzasztó volna tévedésből megölni egy embert.",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13508,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452841086978",
      "collection": "Dialogs",
      "key": "line:Greatmother_Eyes_DontShoot_0b3e34c",
      "source": "Greatmother: Конечно, какой же это признак?",
      "target": "Greatmother: Persze, miféle jel volna ez?",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13509,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452841086977",
      "collection": "Dialogs",
      "key": "line:Greatmother_Hands_DontShoot_0608507",
      "source": "Greatmother: Но я бы еще пострадала какое-то время, хахаха.",
      "target": "Greatmother: De szenvedhettem volna még egy darabig, hahahaha.",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13510,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452841086976",
      "collection": "Dialogs",
      "key": "line:Greatmother_Hands_DontShoot_01fa1a3",
      "source": "Greatmother: Ты бы мог меня, конечно, избавить от страданий.",
      "target": "Greatmother: Persze akár meg is szabadíthattál volna a szenvedéstől.",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13511,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452836892681",
      "collection": "Dialogs",
      "key": "line:Greatmother_Hands_DontShoot_0afea5e",
      "source": "Greatmother: Какой смысл стрелять в больного человека?",
      "target": "Greatmother: Mi értelme egy beteg emberre lőni?",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13512,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452836892680",
      "collection": "Dialogs",
      "key": "line:Greatmother_Teeth_DontShoot_018da98",
      "source": "Greatmother: Ты же не всегда держишь в руках это своё ружьё, а?",
      "target": "Greatmother: Ugye nem mindig tartod a kezedben azt a puskádat?",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13513,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452836892679",
      "collection": "Dialogs",
      "key": "line:Greatmother_Teeth_DontShoot_008dade",
      "source": "Greatmother: Во всех оружием тыкать — так каждый начнёт на тебя косо смотреть.",
      "target": "Greatmother: Ha mindenkire fegyvert szegezel, előbb-utóbb mindenki ferde szemmel néz majd rád.",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13514,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452836892678",
      "collection": "Dialogs",
      "key": "line:Greatmother_Teeth_DontShoot_02164a8",
      "source": "Greatmother: Ты с этой ерундой поосторожнее обращайся.",
      "target": "Greatmother: Bánj óvatosabban azzal az izével.",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13515,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452836892677",
      "collection": "Dialogs",
      "key": "line:Greatmother_Ears_Gun_0c3f053",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13516,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452836892676",
      "collection": "Dialogs",
      "key": "line:Greatmother_Ears_Gun_02c7df4",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13517,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452836892675",
      "collection": "Dialogs",
      "key": "line:Greatmother_Ears_Gun_0d2cdfe",
      "source": "Greatmother: Ненавижу этих тварей. А тут ещё и в ухо заполз, гнида.",
      "target": "Greatmother: Utálom ezeket a dögöket. Erre az egyik még a fülembe is bemászott, a rohadék.",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13518,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452836892674",
      "collection": "Dialogs",
      "key": "line:Greatmother_Ears_Gun_07fdde6",
      "source": "Greatmother: Да меня-то что ловить, я не денусь никуда! Таракана держи!",
      "target": "Greatmother: Minek engem elkapni? Nem megyek sehová! A csótányt fogd meg!",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13519,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452836892673",
      "collection": "Dialogs",
      "key": "line:Greatmother_Photo_Gun_0b7c142",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13520,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452836892672",
      "collection": "Dialogs",
      "key": "line:Greatmother_Photo_Gun_072c365",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13521,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452832698376",
      "collection": "Dialogs",
      "key": "line:Greatmother_Photo_Gun_089ac8f",
      "source": "Greatmother: Ой, смешно стало даже.",
      "target": "Greatmother: Jaj, ezen még nevetnem is kell.",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13522,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452832698375",
      "collection": "Dialogs",
      "key": "line:Greatmother_Photo_Gun_020ad5a",
      "source": "Greatmother: Да какая аура, сынок? Тебя надурили на деньги, а ты как простак повёлся.",
      "target": "Greatmother: Ugyan miféle aura, fiam? Lehúztak egy csomó pénzzel, te meg bedőltél nekik, mint egy balek.",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "proposed correction"
    },
    {
      "ordinal": 13523,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452832698374",
      "collection": "Dialogs",
      "key": "line:Greatmother_Photo_Gun_0ef408f",
      "source": "Greatmother: Что? Аура?",
      "target": "Greatmother: Mi? Aura?",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13524,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452832698373",
      "collection": "Dialogs",
      "key": "line:Greatmother_Armpit_Gun_0e626c8",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13525,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452832698372",
      "collection": "Dialogs",
      "key": "line:Greatmother_Armpit_Gun_0f023bd",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13526,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452832698371",
      "collection": "Dialogs",
      "key": "line:Greatmother_Armpit_Gun_04ebc29",
      "source": "Greatmother: Ну что, излечишь добрую женщину?",
      "target": "Greatmother: Na, meggyógyítod ezt a derék asszonyt?",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13527,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452832698370",
      "collection": "Dialogs",
      "key": "line:Greatmother_Armpit_Gun_07e3b1e",
      "source": "Greatmother: АХАХАХА, вот и лекарство от всех болезней!",
      "target": "Greatmother: HAHAHAHA, hát itt a gyógyszer minden bajra!",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13528,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452832698369",
      "collection": "Dialogs",
      "key": "line:Greatmother_Eyes_Gun_05c6869",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13529,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452832698368",
      "collection": "Dialogs",
      "key": "line:Greatmother_Eyes_Gun_0fc141e",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13530,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452828504071",
      "collection": "Dialogs",
      "key": "line:Greatmother_Eyes_Gun_002c493",
      "source": "Greatmother: Или это вообще рак.",
      "target": "Greatmother: Vagy talán egyenesen rák.",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13531,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452828504070",
      "collection": "Dialogs",
      "key": "line:Greatmother_Eyes_Gun_0c999d9",
      "source": "Greatmother: Наверно, сосуды, которые постоянно лопаются, перестают восстанавливаться.",
      "target": "Greatmother: Talán az erek, amelyek folyton elpattannak, már nem tudnak helyrejönni.",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13532,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452828504069",
      "collection": "Dialogs",
      "key": "line:Greatmother_Eyes_Gun_05294e8",
      "source": "Greatmother: Последние года три стала видеть хуже.",
      "target": "Greatmother: Úgy három éve egyre rosszabbul látok.",
      "authoredFile": "Translations/hu/dialogue-batch-407.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13533,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452828504068",
