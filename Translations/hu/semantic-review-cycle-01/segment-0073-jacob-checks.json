  "rows": [
    {
      "ordinal": 11967,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453788999683",
      "collection": "Dialogs",
      "key": "line:Jacob_Death_05000f5",
      "source": "Jacob: Всегда знал, что помру от чьей-то тупости.",
      "target": "Jacob: Mindig tudtam, hogy valaki más ostobasága miatt fogok meghalni.",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11968,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453788999682",
      "collection": "Dialogs",
      "key": "line:Jacob_Death_024124b",
      "source": "Jacob: Я думал, ты умнее…",
      "target": "Jacob: Azt hittem, okosabb vagy…",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11969,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453788999681",
      "collection": "Dialogs",
      "key": "line:Jacob_Death_0eba2a8",
      "source": "Jacob: Сука...",
      "target": "Jacob: A kurva életbe...",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11970,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453788999680",
      "collection": "Dialogs",
      "key": "line:Jacob_Ears_DontShoot_041629f",
      "source": "Jacob: Уверен, на этих говнюков ты потратишь больше боезапаса, чем на Гостей.",
      "target": "Jacob: Biztos vagyok benne, hogy azokra a rohadékokra több töltényt pazarolsz majd, mint a Vendégekre.",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11971,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453784805385",
      "collection": "Dialogs",
      "key": "line:Jacob_Ears_DontShoot_0691cb5",
      "source": "Jacob: Побереги патроны.",
      "target": "Jacob: Takarékoskodj a töltényekkel.",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11972,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453784805384",
      "collection": "Dialogs",
      "key": "line:Jacob_Ears_DontShoot_01c4219",
      "source": "Jacob: А сразу ведут себя как мудаки.",
      "target": "Jacob: Rögtön úgy viselkednek, mint a seggfejek.",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11973,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453784805383",
      "collection": "Dialogs",
      "key": "line:Jacob_Ears_DontShoot_0cefc9a",
      "source": "Jacob: Они, в отличие от Гостей, людьми не притворяются…",
      "target": "Jacob: A Vendégekkel ellentétben ők nem is tettetik, hogy emberek…",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11974,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453784805382",
      "collection": "Dialogs",
      "key": "line:Jacob_Ears_DontShoot_0bcb160",
      "source": "Jacob: Я надеюсь, что в КЧС-ников ты так же стволом тычешь.",
      "target": "Jacob: Remélem, a KCsSz embereire is ugyanígy fegyvert fogsz.",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11975,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453784805381",
      "collection": "Dialogs",
      "key": "line:Jacob_Photo_DontShoot_082a4fb",
      "source": "Jacob: То шея твоя останется целой.",
      "target": "Jacob: Akkor a nyakad egyben marad.",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11976,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453784805380",
      "collection": "Dialogs",
      "key": "line:Jacob_Photo_DontShoot_0b69bb5",
      "source": "Jacob: Но если будешь вести себя уважительно…",
      "target": "Jacob: De ha tisztelettel viselkedsz…",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11977,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453784805379",
      "collection": "Dialogs",
      "key": "line:Jacob_Photo_DontShoot_00a4c63",
      "source": "Jacob: Иначе тебе же хуже будет.",
      "target": "Jacob: Különben te jársz rosszabbul.",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11978,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453784805378",
      "collection": "Dialogs",
      "key": "line:Jacob_Photo_DontShoot_012d33b",
      "source": "Jacob: Лучше больше не наставляй пушку на меня.",
      "target": "Jacob: Jobb lesz, ha többé nem szegezel rám fegyvert.",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11979,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453784805377",
      "collection": "Dialogs",
      "key": "line:Jacob_Armpit_DontShoot_0741545",
      "source": "Jacob: Пусть приходят, я им дам попробовать свои на вкус.",
      "target": "Jacob: Csak jöjjenek ide, majd megkóstolhatják az enyéimet.",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11980,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453784805376",
      "collection": "Dialogs",
      "key": "line:Jacob_Armpit_DontShoot_091facc",
      "source": "Jacob: Может, они там ещё яйца Гостям лижут, чтобы новые признаки выявить?",
      "target": "Jacob: Talán még a Vendégek tökét is nyalogatják, hogy új jeleket találjanak?",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11981,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453780611082",
      "collection": "Dialogs",
      "key": "line:Jacob_Armpit_DontShoot_030ea8f",
      "source": "Jacob: В КЧС совсем ёбу дали.",
      "target": "Jacob: A KCsSz-nél teljesen megőrültek.",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11982,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453780611081",
      "collection": "Dialogs",
      "key": "line:Jacob_Armpit_DontShoot_0769bf2",
      "source": "Jacob: Тоже мне признак. Подмышки.",
      "target": "Jacob: Már ez is jel? A hónalj?",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11983,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453780611080",
      "collection": "Dialogs",
      "key": "line:Jacob_Eyes_DontShoot_043a2b2",
      "source": "Jacob: Я не мог себе позволить даже глаз сомкнуть.",
      "target": "Jacob: Még egy pillanatra sem hunyhattam le a szemem.",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11984,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453780611079",
      "collection": "Dialogs",
      "key": "line:Jacob_Eyes_DontShoot_0cb7097",
      "source": "Jacob: Днём прячась от солнца, а ночью от Гостей и КЧС-ников…",
      "target": "Jacob: Nappal a Nap, éjjel a Vendégek és a KCsSz emberei elől bujkálva…",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11985,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453780611078",
      "collection": "Dialogs",
      "key": "line:Jacob_Eyes_DontShoot_019cbc8",
      "source": "Jacob: Переться через полгорода…",
      "target": "Jacob: A fél városon átvágni…",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11986,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453780611077",
      "collection": "Dialogs",
      "key": "line:Jacob_Eyes_DontShoot_03c09b2",
      "source": "Jacob: Я бы посмотрел на твои глаза, если бы ты не спал несколько ночей.",
      "target": "Jacob: Megnézném a te szemedet is, ha több éjszakán át nem aludnál.",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11987,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453780611076",
      "collection": "Dialogs",
      "key": "line:Jacob_Hands_DontShoot_0a95e58",
      "source": "Jacob: В нынешнее время сложно оставаться чистюлей.",
      "target": "Jacob: Manapság nehéz tisztának maradni.",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11988,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453780611075",
      "collection": "Dialogs",
      "key": "line:Jacob_Hands_DontShoot_0292b7e",
      "source": "Jacob: Телевизор поменьше смотри.",
      "target": "Jacob: Nézz kevesebb tévét.",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11989,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453780611074",
      "collection": "Dialogs",
      "key": "line:Jacob_Hands_DontShoot_0b20367",
      "source": "Jacob: Любой бы руки запачкал.",
      "target": "Jacob: Bárkinek piszkos lenne a keze.",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11990,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453780611073",
      "collection": "Dialogs",
      "key": "line:Jacob_Hands_DontShoot_0c44f73",
      "source": "Jacob: На окраине в таком дерьме приходилось ковыряться.",
      "target": "Jacob: A város szélén mindenféle szarban kellett turkálnom.",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11991,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453780611072",
      "collection": "Dialogs",
      "key": "line:Jacob_Hands_DontShoot_0f9061b",
      "source": "Jacob: Я понимаю, как это выглядит.",
      "target": "Jacob: Értem, hogyan néz ki.",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11992,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453776416778",
      "collection": "Dialogs",
      "key": "line:Jacob_Teeth_DontShoot_0cf646b",
      "source": "Jacob: Пальцем.",
      "target": "Jacob: Az ujjammal.",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11993,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453776416777",
      "collection": "Dialogs",
      "key": "line:Jacob_Teeth_DontShoot_00b9bed",
      "source": "Jacob: То в следующий раз я их почищу…",
      "target": "Jacob: Akkor legközelebb majd megtisztítom őket…",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11994,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453776416776",
      "collection": "Dialogs",
      "key": "line:Jacob_Teeth_DontShoot_080609a",
      "source": "Jacob: Если тебя так напрягают мои зубы…",
      "target": "Jacob: Ha ennyire zavarnak a fogaim…",
      "authoredFile": "Translations/hu/dialogue-batch-368.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11995,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453776416775",
      "collection": "Dialogs",
      "key": "line:Jacob_Ears_Gun_08bbcc4",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11996,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453776416774",
      "collection": "Dialogs",
      "key": "line:Jacob_Ears_Gun_0ab9127",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11997,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453776416773",
      "collection": "Dialogs",
      "key": "line:Jacob_Ears_Gun_0c5a298",
      "source": "Jacob: Поверь, я вернусь и сверну тебе башку.",
      "target": "Jacob: Hidd el, visszajövök, és kitekerem a nyakadat.",
      "authoredFile": "Translations/hu/dialogue-batch-369.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11998,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453776416772",
      "collection": "Dialogs",
      "key": "line:Jacob_Ears_Gun_0425c47",
      "source": "Jacob: Но я это так просто не оставлю.",
      "target": "Jacob: De ezt nem hagyom annyiban.",
      "authoredFile": "Translations/hu/dialogue-batch-369.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11999,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453776416771",
      "collection": "Dialogs",
      "key": "line:Jacob_Ears_Gun_0be8486",
      "source": "Jacob: Да жми ты на курок, если веришь этому зомбоящику.",
      "target": "Jacob: Akkor húzd meg a ravaszt, ha hiszel annak az agymosó tévének.",
      "authoredFile": "Translations/hu/dialogue-batch-369.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12000,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453776416770",
      "collection": "Dialogs",
      "key": "line:Jacob_Photo_Gun_02ca074",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12001,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453776416769",
      "collection": "Dialogs",
      "key": "line:Jacob_Photo_Gun_01e7748",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12002,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453776416768",
      "collection": "Dialogs",
      "key": "line:Jacob_Photo_Gun_0a9a306",
      "source": "Jacob: И остатки моего терпения.",
      "target": "Jacob: És a maradék türelmemet is.",
      "authoredFile": "Translations/hu/dialogue-batch-369.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12003,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453772222474",
      "collection": "Dialogs",
      "key": "line:Jacob_Photo_Gun_0c85030",
      "source": "Jacob: Иначе попросту потратишь патроны…",
      "target": "Jacob: Különben csak a töltényeidet pazarlod…",
      "authoredFile": "Translations/hu/dialogue-batch-369.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12004,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453772222473",
      "collection": "Dialogs",
      "key": "line:Jacob_Photo_Gun_032ebb9",
      "source": "Jacob: Я надеюсь, ты серебро зарядил туда.",
      "target": "Jacob: Remélem, ezüstgolyót töltöttél bele.",
      "authoredFile": "Translations/hu/dialogue-batch-369.json",
      "reviewResult": "proposed correction"
