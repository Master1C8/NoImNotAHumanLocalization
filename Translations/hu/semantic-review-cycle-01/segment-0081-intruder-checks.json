      "collection": "Dialogs",
      "key": "line:Intruder_Photo_06d4e5a",
      "source": "Intruder: Сны есть. Были, по крайней мере. А вот аура…",
      "target": "Intruder: Álmok vannak. Legalábbis voltak. De az aura…",
      "authoredFile": "Translations/hu/dialogue-batch-385.json",
