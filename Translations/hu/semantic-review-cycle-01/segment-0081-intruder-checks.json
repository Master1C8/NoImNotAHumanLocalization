      "collection": "Dialogs",
      "key": "line:Intruder_Ears_0a82482",
      "source": "Intruder: М? Я о таком не слышал.",
      "target": "Intruder: Hm? Ilyesmiről még nem hallottam.",
      "authoredFile": "Translations/hu/dialogue-batch-385.json",
