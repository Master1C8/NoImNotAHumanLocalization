    },
    {
      "ordinal": 12646,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453277294596",
      "collection": "Dialogs",
      "key": "line:Intruder_Eyes_045b0ee",
      "source": "Intruder: Кстати, я же не сплю уже … ну, долго.",
      "target": "Intruder: Egyébként már… hát, jó ideje nem alszom.",
      "authoredFile": "Translations/hu/dialogue-batch-385.json",
