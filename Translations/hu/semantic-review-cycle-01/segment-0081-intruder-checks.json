  "rows": [
    {
      "ordinal": 12565,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453319237638",
      "collection": "Dialogs",
      "key": "line:Intruder_Death_0577bfe",
      "source": "Intruder: Или усну.",
      "target": "Intruder: Vagy elalszom.",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12566,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453319237637",
      "collection": "Dialogs",
      "key": "line:Intruder_Death_0366598",
      "source": "Intruder: Снов нет. Люди обезумели. Я умру.",
      "target": "Intruder: Nincsenek álmok. Az emberek megőrültek. Én meghalok.",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12567,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453319237636",
      "collection": "Dialogs",
      "key": "line:Intruder_Death_0c31bed",
      "source": "Intruder: Хотя это больше жутко, чем смешно.",
      "target": "Intruder: Bár ez inkább rémisztő, mint vicces.",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12568,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453319237635",
      "collection": "Dialogs",
      "key": "line:Intruder_Death_0b74ec9",
      "source": "Intruder: Мне немного смешно, что из-за непонятно чего ты решил убить человека.",
      "target": "Intruder: Kicsit mulatságosnak találom, hogy valami érthetetlen okból úgy döntöttél, megölsz egy embert.",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12569,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453319237634",
      "collection": "Dialogs",
      "key": "line:Intruder_Ears_DontShoot_0f8616b",
      "source": "Intruder: Хотя, я бы понял это. Странно.",
      "target": "Intruder: Bár ezt megérteném. Furcsa.",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12570,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453319237633",
      "collection": "Dialogs",
      "key": "line:Intruder_Ears_DontShoot_06e72e1",
      "source": "Intruder: Может, он тебе приснился?",
      "target": "Intruder: Talán csak álmodtad?",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12571,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453319237632",
      "collection": "Dialogs",
      "key": "line:Intruder_Ears_DontShoot_0207148",
      "source": "Intruder: А ты точно видел этот выпуск новостей?",
      "target": "Intruder: Biztosan láttad azt a híradást?",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12572,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453315043336",
      "collection": "Dialogs",
      "key": "line:Intruder_Ears_DontShoot_0349526",
      "source": "Intruder: Интересный выпуск новостей был. На грани сна и реальности.",
      "target": "Intruder: Érdekes híradás lehetett. Valahol álom és valóság határán.",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12573,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453315043335",
      "collection": "Dialogs",
      "key": "line:Intruder_Photo_DontShoot_0d6461b",
      "source": "Intruder: Мы-то с естественными ещё не разобрались.",
      "target": "Intruder: Hiszen még a természetes dolgokat sem értjük teljesen.",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12574,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453315043334",
      "collection": "Dialogs",
      "key": "line:Intruder_Photo_DontShoot_041e7ec",
      "source": "Intruder: Меня вообще пугает, как многие помешались в последнее время на каких-то сверхъестественных штуках.",
      "target": "Intruder: Engem megrémít, hogy mostanában mennyien megszállottjai valamiféle természetfeletti dolgoknak.",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12575,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453315043333",
      "collection": "Dialogs",
      "key": "line:Intruder_Photo_DontShoot_0027c7f",
      "source": "Intruder: Я могу понять всё остальное, но аура.",
      "target": "Intruder: Minden mást még megértek, de az aurát?",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12576,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453315043332",
      "collection": "Dialogs",
      "key": "line:Intruder_Photo_DontShoot_0761661",
      "source": "Intruder: Просто… не знаю.",
      "target": "Intruder: Egyszerűen… nem tudom.",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12577,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453315043331",
      "collection": "Dialogs",
      "key": "line:Intruder_Photo_DontShoot_048305f",
      "source": "Intruder: А, из телевизора…Странно.",
      "target": "Intruder: Á, a tévéből… Furcsa.",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12578,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453315043330",
      "collection": "Dialogs",
      "key": "line:Intruder_Photo_DontShoot_0da30ca",
      "source": "Intruder: А где ты услышал об этом признаке?",
      "target": "Intruder: Hol hallottál erről a jelről?",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12579,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453315043329",
      "collection": "Dialogs",
      "key": "line:Intruder_Armpit_DontShoot_05b4b8a",
      "source": "Intruder: И со временем становится только хуже.",
      "target": "Intruder: És idővel csak rosszabb lesz.",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12580,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453315043328",
      "collection": "Dialogs",
      "key": "line:Intruder_Armpit_DontShoot_0bf432a",
      "source": "Intruder: И со временем нарастает какой-то жар.",
      "target": "Intruder: És idővel valamiféle forróság támad.",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12581,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453310849031",
      "collection": "Dialogs",
      "key": "line:Intruder_Armpit_DontShoot_0ed5b72",
      "source": "Intruder: Когда долго не спишь, начинаешь чувствовать холодок, а через какое-то время сухость.",
      "target": "Intruder: Ha sokáig nem alszol, előbb hideget érzel, aztán egy idő múlva szárazságot.",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12582,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453310849030",
      "collection": "Dialogs",
      "key": "line:Intruder_Armpit_DontShoot_0f23611",
      "source": "Intruder: Так ни у кого такого нет?",
      "target": "Intruder: Másnak tényleg nincs ilyen?",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12583,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453310849029",
      "collection": "Dialogs",
      "key": "line:Intruder_Eyes_DontShoot_0197f9b",
      "source": "Intruder: Да и снов я давно не видел. Что не так в этой всей схеме?..",
      "target": "Intruder: És álmot is rég láttam már. Mi nem stimmel ebben az egészben?..",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12584,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453310849028",
      "collection": "Dialogs",
      "key": "line:Intruder_Eyes_DontShoot_0d1bdcb",
      "source": "Intruder: Разве они не высыхают и не устают от постоянной нагрузки?",
      "target": "Intruder: Nem száradnak ki és nem fáradnak el az állandó terheléstől?",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12585,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453310849027",
      "collection": "Dialogs",
      "key": "line:Intruder_Eyes_DontShoot_07f0584",
      "source": "Intruder: Нет, а всё-таки. Почему глаза не красные?",
      "target": "Intruder: De azért mégis. Miért nem vörösek a szemeim?",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12586,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453310849026",
      "collection": "Dialogs",
      "key": "line:Intruder_Eyes_DontShoot_06381ba",
      "source": "Intruder: Разве они не высыхают и не устают от постоянной нагрузки? Должны стекленеть, наверно.",
      "target": "Intruder: Nem száradnak ki és nem fáradnak el az állandó terheléstől? Talán üvegessé kellene válniuk.",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12587,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453310849025",
      "collection": "Dialogs",
      "key": "line:Intruder_Eyes_DontShoot_00d8bdf",
      "source": "Intruder: Нет, а всё-таки. Почему глаза темнеют?",
      "target": "Intruder: De azért mégis. Miért sötétednek el a szemeim?",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12588,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453310849024",
      "collection": "Dialogs",
      "key": "line:Intruder_Hands_DontShoot_0eb7e83",
      "source": "Intruder: Это потеряет смысл.",
      "target": "Intruder: Annak akkor már nem lesz értelme.",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12589,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453306654728",
      "collection": "Dialogs",
      "key": "line:Intruder_Hands_DontShoot_08bbaa9",
      "source": "Intruder: Если у меня получится, я перестану себя травмировать.",
      "target": "Intruder: Ha sikerül, abbahagyom, hogy kárt tegyek magamban.",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12590,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453306654727",
      "collection": "Dialogs",
      "key": "line:Intruder_Hands_DontShoot_0fb37a9",
      "source": "Intruder: Я просто пытаюсь хоть как-то оказаться во сне.",
      "target": "Intruder: Csak megpróbálok valahogy bejutni egy álomba.",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12591,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453306654726",
      "collection": "Dialogs",
      "key": "line:Intruder_Hands_DontShoot_06aa9f2",
      "source": "Intruder: Почему ты принял мои ногти за грязные?",
      "target": "Intruder: Miért hitted, hogy piszkosak a körmeim?",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12592,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453306654725",
      "collection": "Dialogs",
      "key": "line:Intruder_Teeth_DontShoot_069fc52",
      "source": "Intruder: Как будто… если они лезут из-под земли, её и зубами будешь грызть, лишь бы выбраться.",
      "target": "Intruder: Mintha… ha a föld alól másznak elő, akár a fogukkal is rágnák a földet, csak hogy kijussanak.",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12593,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453306654724",
      "collection": "Dialogs",
      "key": "line:Intruder_Teeth_DontShoot_06d7a84",
      "source": "Intruder: Не было бы логичнее, если бы у Гостей были грязные зубы?",
      "target": "Intruder: Nem lenne logikusabb, ha a Vendégek foga piszkos volna?",
      "authoredFile": "Translations/hu/dialogue-batch-383.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12594,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453306654723",
      "collection": "Dialogs",
      "key": "line:Intruder_Ears_Gun_0a70ca8",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12595,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453306654722",
      "collection": "Dialogs",
      "key": "line:Intruder_Ears_Gun_08aa125",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12596,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453306654721",
      "collection": "Dialogs",
      "key": "line:Intruder_Ears_Gun_021c4bd",
      "source": "Intruder: Я как-нибудь дальше без этого.",
      "target": "Intruder: Ezután valahogy boldogulok enélkül.",
      "authoredFile": "Translations/hu/dialogue-batch-384.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12597,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453306654720",
      "collection": "Dialogs",
      "key": "line:Intruder_Ears_Gun_09e3725",
      "source": "Intruder: Я как-нибудь дальше в Смерти потусую.",
      "target": "Intruder: A Halálnál majd valahogy elleszek.",
      "authoredFile": "Translations/hu/dialogue-batch-384.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12598,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453302460423",
      "collection": "Dialogs",
      "key": "line:Intruder_Ears_Gun_024e57a",
      "source": "Intruder: Чтобы тело так и осталось лежать.",
      "target": "Intruder: Hogy a testem ott maradjon fekve.",
      "authoredFile": "Translations/hu/dialogue-batch-384.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12599,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453302460422",
      "collection": "Dialogs",
      "key": "line:Intruder_Ears_Gun_04299e2",
      "source": "Intruder: Чтобы даже если я проснусь, обратно в теле оказаться не смог.",
      "target": "Intruder: Hogy még ha fel is ébredek, ne kerülhessek vissza a testembe.",
      "authoredFile": "Translations/hu/dialogue-batch-384.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12600,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453302460421",
      "collection": "Dialogs",
      "key": "line:Intruder_Ears_Gun_0244feb",
      "source": "Intruder: Можешь тогда полностью расстрелять тело?",
      "target": "Intruder: Akkor teljesen szét tudnád lőni a testemet?",
      "authoredFile": "Translations/hu/dialogue-batch-384.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12601,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453302460420",
      "collection": "Dialogs",
      "key": "line:Intruder_Photo_Gun_05c2f97",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12602,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453302460419",
      "collection": "Dialogs",
      "key": "line:Intruder_Photo_Gun_046af4c",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12603,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453302460418",
      "collection": "Dialogs",
      "key": "line:Intruder_Photo_Gun_070d34a",
      "source": "Intruder: Знаешь, у меня к тебе вопросы из-за этого.",
      "target": "Intruder: Tudod, emiatt volna néhány kérdésem hozzád.",
      "authoredFile": "Translations/hu/dialogue-batch-384.json",
      "reviewResult": "pass"
    },
