    },
    {
      "ordinal": 12632,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453285683202",
      "collection": "Dialogs",
      "key": "line:Intruder_Photo_0cdcfc4",
      "source": "Intruder: Просто… аура вообще есть? Ты её видел?",
      "target": "Intruder: Egyszerűen… egyáltalán létezik aura? Láttál már olyat?",
      "authoredFile": "Translations/hu/dialogue-batch-385.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12633,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453285683201",
      "collection": "Dialogs",
      "key": "line:Intruder_Photo_078e89a",
      "source": "Intruder: А ты уверен, что эта штука вообще работает?",
      "target": "Intruder: Biztos vagy benne, hogy ez a szerkezet működik?",
      "authoredFile": "Translations/hu/dialogue-batch-385.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12634,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453285683200",
      "collection": "Dialogs",
      "key": "line:Intruder_Photo_0ffab40",
      "source": "Intruder: Как-то… пустовато.",
      "target": "Intruder: Olyan… üres.",
      "authoredFile": "Translations/hu/dialogue-batch-385.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12635,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453281488903",
      "collection": "Dialogs",
      "key": "line:Intruder_Photo_01ba756",
      "source": "Intruder: А, так это не обычный, а с какой-то аурой?",
      "target": "Intruder: Á, szóval ez nem közönséges, hanem valami aurás fényképezőgép?",
      "authoredFile": "Translations/hu/dialogue-batch-385.json",
      "reviewResult": "pass"
    },
