    },
    {
      "ordinal": 12620,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453294071808",
      "collection": "Dialogs",
      "key": "line:Intruder_Teeth_Gun_0d8d624",
      "source": "Intruder: Это бы многое объяснило.",
      "target": "Intruder: Ez sok mindent megmagyarázna.",
      "authoredFile": "Translations/hu/dialogue-batch-384.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 12621,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453289877510",
      "collection": "Dialogs",
      "key": "line:Intruder_Teeth_Gun_081ab01",
      "source": "Intruder: Знаешь, я так давно не сплю, что не понимаю, происходит ли всё это во сне или всё по-настоящему.",
      "target": "Intruder: Tudod, olyan régóta nem alszom, hogy már nem tudom, álomban történik-e mindez, vagy tényleg valóság.",
      "authoredFile": "Translations/hu/dialogue-batch-384.json",
      "reviewResult": "pass"
    },
