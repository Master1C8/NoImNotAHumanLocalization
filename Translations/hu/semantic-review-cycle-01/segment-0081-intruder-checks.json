      "collection": "Dialogs",
      "key": "line:Intruder_Eyes_091bba9",
      "source": "Intruder: Почему глаза не краснеют?",
      "target": "Intruder: Miért nem vörösödik be a szemem?",
      "authoredFile": "Translations/hu/dialogue-batch-385.json",
