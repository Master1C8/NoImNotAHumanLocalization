    },
    {
      "ordinal": 9884,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454552363010",
      "collection": "Dialogs",
      "key": "line:Daughter_Asking_3_3_05e9ce8",
      "source": "Мне очень жаль твоего отца. Он был настоящим человеком. Но слишком добрым",
      "target": "Nagyon sajnálom apádat. Igazi ember volt. De túlságosan jószívű.",
      "authoredFile": "Translations/hu/dialogue-batch-313.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9885,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454552363009",
      "collection": "Dialogs",
      "key": "line:Daughter_Asking_3_3_08ac8e3",
      "source": "Daughter: Он… он скоро должен прийти.",
      "target": "Daughter: Ő… hamarosan jönnie kell.",
      "authoredFile": "Translations/hu/dialogue-batch-313.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9886,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454552363008",
      "collection": "Dialogs",
      "key": "line:Daughter_Asking_3_3_0819df2",
      "source": "Daughter: Он пошёл побить этих плохих людей.",
      "target": "Daughter: Elment megverni azokat a rossz embereket.",
      "authoredFile": "Translations/hu/dialogue-batch-313.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9887,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454548168715",
      "collection": "Dialogs",
      "key": "line:Daughter_Asking_3_3_0c99b53",
      "source": "Daughter: Может, ему что-то нужно сделать сначала?",
      "target": "Daughter: Lehet, hogy előbb még el kell intéznie valamit?",
      "authoredFile": "Translations/hu/dialogue-batch-313.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9888,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454548168714",
      "collection": "Dialogs",
      "key": "line:Daughter_Asking_3_3_0aba821",
      "source": "Daughter: …",
      "target": "Daughter: …",
      "authoredFile": "Translations/hu/dialogue-batch-038.json",
