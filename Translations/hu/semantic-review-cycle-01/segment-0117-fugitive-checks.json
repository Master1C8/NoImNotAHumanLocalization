    {
      "ordinal": 14913,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452279050243",
      "collection": "Dialogs",
      "key": "line:Fugitive_Ears_0f79806",
      "source": "Fugitive: Серьёзно? Ты думаешь, Гостя можно вычислить по ушам? Ну, смотри.",
      "target": "Fugitive: Komolyan? Szerinted a füle alapján fel lehet ismerni egy Vendéget? Na, nézd.",
      "authoredFile": "Translations/hu/dialogue-batch-441.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14914,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452279050242",
      "collection": "Dialogs",
      "key": "line:Fugitive_Ears_0dc82e2",
      "source": "Fugitive: Грязные, ага. Как у любого человека, если он живёт и что-то делает, а моется не каждый день.",
      "target": "Fugitive: Koszosak, igen. Mint bárkié, aki él és tesz-vesz, de nem mosakszik mindennap.",
      "authoredFile": "Translations/hu/dialogue-batch-441.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14915,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452279050241",
      "collection": "Dialogs",
      "key": "line:Fugitive_Ears_08fce5e",
      "source": "Fugitive: ...",
      "target": "Fugitive: ...",
      "authoredFile": "Translations/hu/dialogue-batch-040.json",
