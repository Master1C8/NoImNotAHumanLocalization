    {
      "ordinal": 14916,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452279050240",
      "collection": "Dialogs",
      "key": "line:Fugitive_Ears_0036756",
      "source": "Fugitive: Серьёзно? Ты думаешь, это не признак для того, чтобы посеять панику ещё больше?",
      "target": "Fugitive: Komolyan? Nem gondolod, hogy ez csak újabb jel, amivel még nagyobb pánikot keltenek?",
      "authoredFile": "Translations/hu/dialogue-batch-441.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14917,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452274855948",
