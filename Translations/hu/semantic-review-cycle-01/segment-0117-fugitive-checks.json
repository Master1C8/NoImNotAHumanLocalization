      "collection": "Dialogs",
      "key": "line:Fugitive_Photo_0848972",
      "source": "Fugitive: Ха, а я думал, никто уже не занимается таким!",
      "target": "Fugitive: Ha, azt hittem, ilyesmivel már senki sem foglalkozik!",
      "authoredFile": "Translations/hu/dialogue-batch-441.json",
      "reviewResult": "pass"
