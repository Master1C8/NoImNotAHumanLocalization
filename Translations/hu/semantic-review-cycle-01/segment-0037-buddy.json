    },
    {
      "ordinal": 9199,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454791438340",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_5_0a19186",
      "source": "Buddy: Сука, я бы всё отдал, чтобы его придушить. Но он скрылся, а номер я не успел рассмотреть…",
      "target": "Buddy: A kurva életbe, mindent odaadnék, hogy megfojthassam. De elhajtott, a rendszámot meg nem tudtam leolvasni…",
      "authoredFile": "Translations/hu/dialogue-batch-295.json",
