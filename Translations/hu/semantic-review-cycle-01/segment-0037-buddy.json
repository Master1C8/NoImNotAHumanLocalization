    },
    {
      "ordinal": 9200,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454791438339",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_5_025f904",
      "source": "Buddy: ЕБУЧИЙ АВТОМОБИЛЬ! Если бы таксист смотрел, куда прёт, она бы прожила дольше.",
      "target": "Buddy: AZ A KIBASZOTT AUTÓ! Ha a taxis nézte volna, hová hajt, tovább élhetett volna.",
      "authoredFile": "Translations/hu/dialogue-batch-295.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9201,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454791438338",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_5_071f02b",
      "source": "Buddy: Изо дня в день я видел, как ей плохо. Как она по ночам скулит, воет от боли в лапах.",
      "target": "Buddy: Nap mint nap láttam, milyen rosszul van. Éjjelente nyüszített, a mancsai fájdalmától vonyított.",
      "authoredFile": "Translations/hu/dialogue-batch-295.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9202,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454791438337",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_5_0029d31",
      "source": "Buddy: Я знаю, как это может прозвучать. Но дай мне сказать, корешок. Она… очень мучилась. Я просто не мог смотреть на это.",
      "target": "Buddy: Tudom, hogy hangzik ez. De hadd mondjam el, haverkám. Ő… nagyon szenvedett. Egyszerűen nem bírtam tovább nézni.",
      "authoredFile": "Translations/hu/dialogue-batch-295.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9203,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454791438336",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_4_0173349",
      "source": "Ах ты ублюдок!",
      "target": "Te rohadék!",
      "authoredFile": "Translations/hu/dialogue-batch-295.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9204,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454787244046",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_4_0aff8a1",
      "source": "Что ты сделал!?",
      "target": "Mit tettél!?",
      "authoredFile": "Translations/hu/dialogue-batch-295.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9205,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454787244045",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_4_06ff9e0",
      "source": "Buddy: Я убил её.",
      "target": "Buddy: Megöltem őt.",
      "authoredFile": "Translations/hu/dialogue-batch-295.json",
      "reviewResult": "pass"
    },
    {
