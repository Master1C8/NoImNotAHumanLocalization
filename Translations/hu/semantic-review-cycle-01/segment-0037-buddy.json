  "rows": [
    {
      "ordinal": 9173,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454799826950",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_8_0ce9c05",
      "source": "Buddy: …",
      "target": "Buddy: …",
      "authoredFile": "Translations/hu/dialogue-batch-038.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9174,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454799826949",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_8_0f17bc2",
      "source": "Buddy: Боюсь, я никогда этого не узнаю…",
      "target": "Buddy: Attól tartok, ezt soha nem fogom megtudni…",
      "authoredFile": "Translations/hu/dialogue-batch-295.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9175,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454799826948",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_8_0b16374",
      "source": "Buddy: Я каждый день думаю, правильно ли я поступил, прекратив её мучения.",
      "target": "Buddy: Mindennap azon gondolkodom, helyesen tettem-e, hogy véget vetettem a szenvedésének.",
      "authoredFile": "Translations/hu/dialogue-batch-295.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9176,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454799826947",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_8_0c4dbf3",
      "source": "Buddy: Ты прав, корешок. Возможно, так будет лучше.",
      "target": "Buddy: Igazad van, haverkám. Talán így jobb lesz.",
      "authoredFile": "Translations/hu/dialogue-batch-295.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9177,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454799826946",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_7_07992de",
      "source": "Buddy: Рад, что ты меня понял.",
      "target": "Buddy: Örülök, hogy megértettél.",
      "authoredFile": "Translations/hu/dialogue-batch-295.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9178,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454799826945",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_7_0590581",
      "source": "Buddy: Спасибо, корешок.",
      "target": "Buddy: Köszönöm, haverkám.",
      "authoredFile": "Translations/hu/dialogue-batch-295.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9179,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454799826944",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_6_007a13a",
      "source": "Тебе лучше уйти",
      "target": "Jobb, ha elmész",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9180,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454795632651",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_6_00f8b28",
      "source": "Ладно, можешь остаться",
      "target": "Rendben, maradhatsz.",
      "authoredFile": "Translations/hu/dialogue-batch-295.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9181,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454795632650",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_6_07bf515",
      "source": "Buddy: Знаешь, как говорят: они для нас мгновение, мы для них вся жизнь, и при этом они нас учат большему, чем кто-либо",
      "target": "Buddy: Tudod, hogy mondják: ők nekünk csak egy pillanatot jelentenek, mi viszont az egész életet jelentjük nekik. Mégis többre tanítanak minket bárki másnál.",
      "authoredFile": "Translations/hu/dialogue-batch-295.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9182,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454795632649",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_6_049097f",
      "source": "Buddy: Ты не представляешь, как тяжело терять домашнее животное.",
      "target": "Buddy: El sem tudod képzelni, milyen nehéz elveszíteni egy háziállatot.",
      "authoredFile": "Translations/hu/dialogue-batch-295.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9183,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454795632648",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_6_041025b",
      "source": "Buddy: …",
      "target": "Buddy: …",
      "authoredFile": "Translations/hu/dialogue-batch-038.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9184,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454795632647",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_6_0d221b4",
      "source": "Buddy: Сука, я бы всё отдал чтобы его придушить. Но он скрылся, а номер я не успел рассмотреть…",
      "target": "Buddy: A kurva életbe, mindent odaadnék, hogy megfojthassam. De elhajtott, a rendszámot meg nem tudtam leolvasni…",
      "authoredFile": "Translations/hu/dialogue-batch-295.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9185,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454795632646",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_6_02aff93",
      "source": "Buddy: Будто это не живое существо, а какой-то камень!",
      "target": "Buddy: Mintha nem is élőlény lett volna, csak egy darab kő!",
      "authoredFile": "Translations/hu/dialogue-batch-295.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9186,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454795632645",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_6_0e5e3f7",
      "source": "Buddy: Ублюдок переехал мою собаку! И скрылся как ни в чём не бывало!",
      "target": "Buddy: Az a rohadék elütötte a kutyámat! Aztán úgy hajtott el, mintha mi sem történt volna!",
      "authoredFile": "Translations/hu/dialogue-batch-295.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9187,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454795632644",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_6_0f14fe5",
      "source": "Buddy: ЁБАНЫЙ ТАКСИСТ!",
      "target": "Buddy: AZ A KIBASZOTT TAXIS!",
      "authoredFile": "Translations/hu/dialogue-batch-295.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9188,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454795632643",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_6_0658bb3",
      "source": "Buddy: …",
      "target": "Buddy: …",
      "authoredFile": "Translations/hu/dialogue-batch-038.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9189,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454795632642",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_6_0a9a687",
      "source": "Buddy: Я правда не хотел! Я не хотел, у меня в жизни рука бы не…",
      "target": "Buddy: Én tényleg nem akartam! Nem akartam, soha az életben nem emeltem volna rá a kezem…",
      "authoredFile": "Translations/hu/dialogue-batch-295.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9190,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454795632641",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_6_0e968eb",
      "source": "Buddy: Ты когда-нибудь видел, как собаки плачут? Её глаза будто просили прекратить все эти мучения.",
      "target": "Buddy: Láttál már kutyát sírni? A szeme mintha azt kérte volna, hogy vessek véget ennek a szenvedésnek.",
      "authoredFile": "Translations/hu/dialogue-batch-295.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9191,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454795632640",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_6_0005d09",
      "source": "Buddy: Изо дня в день, я видел, как ей становилось всё хуже. По ночам она скулила, выла от боли, а слёзы…",
      "target": "Buddy: Nap mint nap láttam, ahogy egyre rosszabbul van. Éjszakánként nyüszített, vonyított a fájdalomtól, a könnyei pedig…",
      "authoredFile": "Translations/hu/dialogue-batch-295.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9192,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454791438347",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_6_095f33e",
      "source": "Buddy: Она… очень мучилась. Я просто не мог смотреть на это.",
      "target": "Buddy: Ő… nagyon szenvedett. Egyszerűen nem bírtam tovább nézni.",
      "authoredFile": "Translations/hu/dialogue-batch-295.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9193,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454791438346",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_6_04b4f71",
      "source": "Buddy: Да, я знаю… Я ублюдок. До сих пор не могу себе этого простить.",
      "target": "Buddy: Igen, tudom… Egy rohadék vagyok. Máig nem tudok megbocsátani magamnak.",
      "authoredFile": "Translations/hu/dialogue-batch-295.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9194,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454791438345",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_5_0ad14fd",
      "source": "Тебе лучше уйти",
      "target": "Jobb, ha elmész",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9195,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454791438344",
      "collection": "Dialogs",
      "key": "line:Buddy_Asking_3_5_0c3ce80",
      "source": "Ладно, можешь остаться",
      "target": "Rendben, maradhatsz.",
      "authoredFile": "Translations/hu/dialogue-batch-295.json",
      "reviewResult": "pass"
    },
    {
