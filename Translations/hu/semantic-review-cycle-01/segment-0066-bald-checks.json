    {
      "ordinal": 11466,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453969354756",
      "collection": "Dialogs",
      "key": "line:Bald_Teeth_Gun_0f704e1",
      "source": "Bald: Эй, братан, ты что? Давай, не шути так. Нормально же общались…",
      "target": "Bald: Hé, haver, mit csinálsz? Ne viccelj így. Olyan jól elbeszélgettünk…",
      "authoredFile": "Translations/hu/dialogue-batch-357.json",
      "reviewResult": "proposed correction"
    },
