      "collection": "Dialogs",
      "key": "line:Bald_Armpit_04ce465",
      "source": "Bald: Подмышки как подмышки.",
      "target": "Bald: A hónaljam olyan, amilyen.",
      "authoredFile": "Translations/hu/dialogue-batch-357.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11480,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453965160451",
      "collection": "Dialogs",
      "key": "line:Bald_Armpit_021a31e",
