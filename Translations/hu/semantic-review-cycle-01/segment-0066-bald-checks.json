  "rows": [
    {
      "ordinal": 11418,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453986131972",
      "collection": "Dialogs",
      "key": "line:Bald_Death_0eedc95",
      "source": "Bald: …",
      "target": "Bald: …",
      "authoredFile": "Translations/hu/dialogue-batch-039.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11419,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453986131971",
      "collection": "Dialogs",
      "key": "line:Bald_Death_0ae4381",
      "source": "Bald: Ах ты гнида!",
      "target": "Bald: Te rohadék!",
      "authoredFile": "Translations/hu/dialogue-batch-356.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11420,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453986131970",
      "collection": "Dialogs",
      "key": "line:Bald_Ears_DontShoot_0b9f91a",
      "source": "Bald: Пиздец…",
      "target": "Bald: A kurva életbe…",
      "authoredFile": "Translations/hu/dialogue-batch-356.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11421,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453986131969",
      "collection": "Dialogs",
      "key": "line:Bald_Ears_DontShoot_0a5f69a",
      "source": "Bald: Теперь-то она мне не почистит уши… с такими пальцами-то…",
      "target": "Bald: Most már nem tudja kitisztítani a fülemet… ilyen ujjakkal…",
      "authoredFile": "Translations/hu/dialogue-batch-356.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11422,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453986131968",
      "collection": "Dialogs",
      "key": "line:Bald_Ears_DontShoot_0020f37",
      "source": "Bald: Я очень любил, когда мне мама уши чистила. У неё получалось очень аккуратно и ни разу не было больно.",
      "target": "Bald: Nagyon szerettem, amikor anyám kitisztította a fülemet. Óvatosan csinálta, sosem fájt.",
      "authoredFile": "Translations/hu/dialogue-batch-356.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11423,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453981937675",
      "collection": "Dialogs",
      "key": "line:Bald_Photo_DontShoot_03b16f4",
      "source": "Bald: А ведь хорошая девчонка была. Симпатичная…",
      "target": "Bald: Pedig rendes lány volt. Csinos is…",
      "authoredFile": "Translations/hu/dialogue-batch-356.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11424,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453981937674",
      "collection": "Dialogs",
      "key": "line:Bald_Photo_DontShoot_096467c",
      "source": "Bald: Это пиздец…",
      "target": "Bald: Ez kibaszott szörnyű…",
      "authoredFile": "Translations/hu/dialogue-batch-356.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11425,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453981937673",
      "collection": "Dialogs",
      "key": "line:Bald_Photo_DontShoot_0a5b3e8",
      "source": "Bald: Она бухая шла, оступилась, упала в речку и утонула.",
      "target": "Bald: Részegen ment hazafelé, megbotlott, beleesett a folyóba, és megfulladt.",
      "authoredFile": "Translations/hu/dialogue-batch-356.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11426,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453981937672",
      "collection": "Dialogs",
      "key": "line:Bald_Photo_DontShoot_0badd9a",
      "source": "Bald: И знаешь что?",
      "target": "Bald: És tudod, mi történt?",
      "authoredFile": "Translations/hu/dialogue-batch-356.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11427,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453981937671",
      "collection": "Dialogs",
      "key": "line:Bald_Photo_DontShoot_09b12c5",
      "source": "Bald: Мы нашли её фотку, распечатали и развесили всюду объявления о том, что она пропала.",
      "target": "Bald: Találtunk róla egy fényképet, kinyomtattuk, és mindenhová kiragasztottuk, hogy eltűnt.",
      "authoredFile": "Translations/hu/dialogue-batch-356.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11428,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453981937670",
      "collection": "Dialogs",
      "key": "line:Bald_Photo_DontShoot_03c6083",
      "source": "Bald: А потом через несколько дней узнали, что наша подруга, которая домой возвращалась, не дошла.",
      "target": "Bald: Aztán pár nappal később megtudtuk, hogy a barátnőnk, aki hazafelé indult, sosem ért haza.",
      "authoredFile": "Translations/hu/dialogue-batch-356.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11429,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453981937669",
      "collection": "Dialogs",
      "key": "line:Bald_Photo_DontShoot_0855c08",
      "source": "Bald: Мы как-то пьянствовали в очередной раз.",
      "target": "Bald: Egyszer megint együtt piáltunk.",
      "authoredFile": "Translations/hu/dialogue-batch-356.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11430,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453981937668",
      "collection": "Dialogs",
      "key": "line:Bald_Armpit_DontShoot_00a0fb7",
      "source": "Bald: Это пиздец…",
      "target": "Bald: Ez kibaszott szörnyű…",
      "authoredFile": "Translations/hu/dialogue-batch-356.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11431,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453981937667",
      "collection": "Dialogs",
      "key": "line:Bald_Armpit_DontShoot_075d67b",
      "source": "Bald: Ты опасный, брат, тем, что можешь решать, кого отправить на тот свет, а кому остаться жить.",
      "target": "Bald: Veszélyes ember vagy, haver, mert te döntheted el, kit küldesz a másvilágra, és kit hagysz életben.",
      "authoredFile": "Translations/hu/dialogue-batch-356.json",
      "reviewResult": "proposed correction"
    },
    {
      "ordinal": 11432,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453981937666",
      "collection": "Dialogs",
      "key": "line:Bald_Armpit_DontShoot_05439dc",
      "source": "Bald: Ну что тут сказать.",
      "target": "Bald: Hát erre mit mondjak.",
      "authoredFile": "Translations/hu/dialogue-batch-356.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11433,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453981937665",
      "collection": "Dialogs",
      "key": "line:Bald_Eyes_DontShoot_0a80592",
      "source": "Bald: А у меня нихера не осталось…",
      "target": "Bald: Nekem meg egy rohadt fillérem sem maradt…",
      "authoredFile": "Translations/hu/dialogue-batch-356.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11434,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453981937664",
      "collection": "Dialogs",
      "key": "line:Bald_Eyes_DontShoot_0587c2a",
      "source": "Bald: Но нет. Так уже несколько лет. А если лечиться, то это явно денег нужно будет много выложить.",
      "target": "Bald: De nem. Már évek óta ilyen. Ha kezeltetni akarnám, biztos egy rakás pénzembe kerülne.",
      "authoredFile": "Translations/hu/dialogue-batch-356.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11435,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453977743371",
      "collection": "Dialogs",
      "key": "line:Bald_Eyes_DontShoot_0b9a305",
      "source": "Bald: Мне кажется, что я начал сам себя загонять. Мне начало казаться, что у меня зрение пропадает, и вся такая хуйня.",
      "target": "Bald: Azt hiszem, kezdtem magamat is teljesen kikészíteni. Már azt képzeltem, hogy romlik a látásom, meg mindenféle szarságot.",
      "authoredFile": "Translations/hu/dialogue-batch-356.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11436,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453977743370",
      "collection": "Dialogs",
      "key": "line:Bald_Eyes_DontShoot_08d3b01",
      "source": "Bald: Хотя писос как страшно сначала было.",
      "target": "Bald: Pedig eleinte kibaszottul ijesztő volt.",
      "authoredFile": "Translations/hu/dialogue-batch-356.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11437,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453977743369",
      "collection": "Dialogs",
      "key": "line:Bald_Hands_DontShoot_00a7389",
      "source": "Bald: Но обосрался я знатно. После этого бросил пить. А то так и сдохнуть можно…",
      "target": "Bald: De úgy beszartam tőle, hogy utána abbahagytam az ivást. Így simán meg is lehet dögleni…",
      "authoredFile": "Translations/hu/dialogue-batch-356.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11438,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453977743368",
      "collection": "Dialogs",
      "key": "line:Bald_Hands_DontShoot_020b39a",
      "source": "Bald: Хорошо, что ничего жёсткого не натворил. Ушёл в разных ботинках и добрался, куда мне надо было.",
      "target": "Bald: Még jó, hogy nem csináltam semmi durvát. Két különböző cipőben mentem el, de eljutottam oda, ahová kellett.",
      "authoredFile": "Translations/hu/dialogue-batch-356.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11439,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453977743367",
      "collection": "Dialogs",
      "key": "line:Bald_Hands_DontShoot_0b13c50",
      "source": "Bald: Я аж руки свои нихера не узнавал. Было ощущение, будто я смотрю фильм от первого лица.",
      "target": "Bald: Még a saját kezemet sem ismertem fel, baszki. Olyan volt, mintha egy belső nézetes filmet néznék.",
      "authoredFile": "Translations/hu/dialogue-batch-356.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11440,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453977743366",
      "collection": "Dialogs",
      "key": "line:Bald_Hands_DontShoot_0bbc438",
      "source": "Bald: Это был полный пиздец.",
      "target": "Bald: Kibaszott rémes volt.",
      "authoredFile": "Translations/hu/dialogue-batch-356.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11441,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453977743365",
      "collection": "Dialogs",
      "key": "line:Bald_Hands_DontShoot_065405d",
      "source": "Bald: Я однажды нажрался до белочки со своими чуваками из театрального.",
      "target": "Bald: Egyszer delíriumosra ittam magam a színész haverjaimmal.",
      "authoredFile": "Translations/hu/dialogue-batch-356.json",
      "reviewResult": "proposed correction"
    },
    {
      "ordinal": 11442,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453977743364",
      "collection": "Dialogs",
      "key": "line:Bald_Teeth_DontShoot_016392b",
      "source": "Bald: Мама иногда даже одежду мне сама шила из остатков тканей…",
      "target": "Bald: Anyám néha még a ruháimat is maga varrta a maradék anyagokból…",
      "authoredFile": "Translations/hu/dialogue-batch-356.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11443,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453977743363",
      "collection": "Dialogs",
      "key": "line:Bald_Teeth_DontShoot_0c34b7f",
      "source": "Bald: Если так подумать, то у нас обычно ни на что, кроме еды, не было особо денег.",
      "target": "Bald: Ha belegondolok, kaján kívül szinte semmire sem volt pénzünk.",
      "authoredFile": "Translations/hu/dialogue-batch-356.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11444,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453977743362",
      "collection": "Dialogs",
      "key": "line:Bald_Teeth_DontShoot_0347587",
      "source": "Bald: На лечение зубов тупо денег не было. Хотя, знаешь…",
      "target": "Bald: Egyszerűen nem volt pénzünk a fogaim kezeltetésére. Pedig tudod…",
      "authoredFile": "Translations/hu/dialogue-batch-356.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11445,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453977743361",
      "collection": "Dialogs",
      "key": "line:Bald_Ears_Gun_01b46b7",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11446,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453977743360",
      "collection": "Dialogs",
      "key": "line:Bald_Ears_Gun_067ba65",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11447,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453973549067",
      "collection": "Dialogs",
      "key": "line:Bald_Ears_Gun_004105b",
      "source": "Bald: Я же ничего не сделал!",
      "target": "Bald: Hiszen semmit sem csináltam!",
      "authoredFile": "Translations/hu/dialogue-batch-357.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11448,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453973549066",
      "collection": "Dialogs",
      "key": "line:Bald_Photo_Gun_02dde01",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11449,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453973549065",
      "collection": "Dialogs",
      "key": "line:Bald_Photo_Gun_0a72600",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11450,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453973549064",
      "collection": "Dialogs",
      "key": "line:Bald_Photo_Gun_0e0232e",
      "source": "Bald: Может, фотик у тебя какой бракованный, а?",
      "target": "Bald: Lehet, hogy hibás a fényképezőgéped, mi?",
      "authoredFile": "Translations/hu/dialogue-batch-357.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11451,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453973549063",
      "collection": "Dialogs",
      "key": "line:Bald_Photo_Gun_03abc51",
      "source": "Bald: Да ладно тебе! Ч-чё там такое ты увидел?",
      "target": "Bald: Ugyan már! M-mit láttál rajta?",
      "authoredFile": "Translations/hu/dialogue-batch-357.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11452,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453973549062",
      "collection": "Dialogs",
      "key": "line:Bald_Armpit_Gun_0a66f1f",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11453,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453973549061",
      "collection": "Dialogs",
      "key": "line:Bald_Armpit_Gun_0ddb825",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11454,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453973549060",
      "collection": "Dialogs",
      "key": "line:Bald_Armpit_Gun_0f81e46",
      "source": "Bald: Ой, да ладно тебе. Всё ж с ними нормально. Не надо мне тут угрожать ружьём!",
      "target": "Bald: Ugyan már, semmi baj nincs velük. Ne fenyegess azzal a puskával!",
      "authoredFile": "Translations/hu/dialogue-batch-357.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11455,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453973549059",
      "collection": "Dialogs",
      "key": "line:Bald_Eyes_Gun_00e4e2e",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
