      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453960966148",
      "collection": "Dialogs",
      "key": "line:Bald_Hands_05d9549",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
