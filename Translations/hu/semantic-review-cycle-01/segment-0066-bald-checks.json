      "collection": "Dialogs",
      "key": "line:Bald_Photo_08bfba7",
      "source": "Bald: Ну чё там? Покажь!",
      "target": "Bald: Na, mi van rajta? Mutasd!",
      "authoredFile": "Translations/hu/dialogue-batch-357.json",
      "reviewResult": "pass"
    },
    {
