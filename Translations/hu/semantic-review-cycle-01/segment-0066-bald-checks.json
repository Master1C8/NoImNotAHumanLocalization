    {
      "ordinal": 11481,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453965160450",
      "collection": "Dialogs",
      "key": "line:Bald_Armpit_0830f11",
      "source": "Bald: Чёрт, я давно не мылся. Пардоньте.",
      "target": "Bald: A francba, rég fürödtem. Bocsesz.",
      "authoredFile": "Translations/hu/dialogue-batch-357.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11482,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453965160449",
      "collection": "Dialogs",
      "key": "line:Bald_Armpit_041c7d2",
      "source": "Bald: Это тоже какая-то кожная болячка. Видишь, я и лысый, и на теле всюду есть такая фигня.",
      "target": "Bald: Ez is valami bőrnyavalya. Látod, kopasz vagyok, és a testemen mindenütt ilyen izék vannak.",
      "authoredFile": "Translations/hu/dialogue-batch-357.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11483,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453965160448",
      "collection": "Dialogs",
      "key": "line:Bald_Armpit_0c176bd",
      "source": "Bald: ...",
      "target": "Bald: ...",
      "authoredFile": "Translations/hu/dialogue-batch-039.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11484,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453960966154",
      "collection": "Dialogs",
      "key": "line:Bald_Armpit_0bff792",
      "source": "Bald: Ты ток не пересрись.",
      "target": "Bald: Csak ne szard össze magad.",
      "authoredFile": "Translations/hu/dialogue-batch-357.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11485,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453960966153",
