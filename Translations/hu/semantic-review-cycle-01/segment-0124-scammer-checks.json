      "collection": "Dialogs",
      "key": "line:Scammer_Eyes_0b23f40",
      "source": "Scammer: У меня глаза в последнее время чешутся.",
      "target": "Scammer: Mostanában viszket a szemem.",
      "authoredFile": "Translations/hu/dialogue-batch-455.json",
