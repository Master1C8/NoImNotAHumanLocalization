  "rows": [
    {
      "ordinal": 15577,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452035780614",
      "collection": "Dialogs",
      "key": "line:Scammer_Teeth_DontShoot_0b4365a",
      "source": "Scammer: Короче, не держу на тебя зла. От души.",
      "target": "Scammer: Szóval nem haragszom rád. Komolyan.",
      "authoredFile": "Translations/hu/dialogue-batch-454.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15578,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452035780613",
      "collection": "Dialogs",
      "key": "line:Scammer_Teeth_DontShoot_04efaaa",
      "source": "Scammer: Да и ради нас всё же это делаешь.",
      "target": "Scammer: Végül is értünk csinálod.",
      "authoredFile": "Translations/hu/dialogue-batch-454.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15579,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452035780612",
      "collection": "Dialogs",
      "key": "line:Scammer_Teeth_DontShoot_0ecfcaf",
      "source": "Scammer: Я понимаю, конечно, начнёшь напрягаться из-за всяких там Гостей и прочего.",
      "target": "Scammer: Persze, értem, az ember elkezd idegeskedni a Vendégek meg az ilyesmik miatt.",
      "authoredFile": "Translations/hu/dialogue-batch-454.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15580,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452035780611",
      "collection": "Dialogs",
      "key": "line:Scammer_Armpit_DontShoot_0159cad",
      "source": "Scammer: Не? Ну ладно. Потом.",
      "target": "Scammer: Nem? Na jó. Majd később.",
      "authoredFile": "Translations/hu/dialogue-batch-454.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15581,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452035780610",
      "collection": "Dialogs",
      "key": "line:Scammer_Armpit_DontShoot_0824fd5",
      "source": "Scammer: Давай лучше чмошников напряжём?",
      "target": "Scammer: Inkább a lúzereket szorongassuk?",
      "authoredFile": "Translations/hu/dialogue-batch-454.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15582,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452035780609",
      "collection": "Dialogs",
      "key": "line:Scammer_Armpit_DontShoot_0bbc6b3",
      "source": "Scammer: Я знал, что ты ровный чел. Не станешь серьёзно на нормальных наезжать, хе-хе.",
      "target": "Scammer: Tudtam, hogy rendes csávó vagy. A normálisakat nem fogod komolyan piszkálni, hehe.",
      "authoredFile": "Translations/hu/dialogue-batch-454.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15583,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452035780608",
      "collection": "Dialogs",
      "key": "line:Scammer_Armpit_Gun_00666b4",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15584,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452031586313",
      "collection": "Dialogs",
      "key": "line:Scammer_Armpit_Gun_073fe3f",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15585,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452031586312",
      "collection": "Dialogs",
      "key": "line:Scammer_Armpit_Gun_0ee7fc3",
      "source": "Scammer: Ну сам подумай, у нормального пацана не могут быть палёные подмышки.",
      "target": "Scammer: Gondolj bele, egy rendes srácnak nem lehet gyanús a hónalja.",
      "authoredFile": "Translations/hu/dialogue-batch-454.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15586,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452031586311",
      "collection": "Dialogs",
      "key": "line:Scammer_Armpit_Gun_0baa4a7",
      "source": "Scammer: Да подожди-подожди! Ты бы ещё трусы попросил показать.",
      "target": "Scammer: Várj már, várj! Még a gatyámat is levetetnéd velem.",
      "authoredFile": "Translations/hu/dialogue-batch-454.json",
      "reviewResult": "proposed correction"
    },
    {
      "ordinal": 15587,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452031586310",
      "collection": "Dialogs",
      "key": "line:Scammer_Armpit_Gun_068c50d",
      "source": "Scammer: Только не говори никому. Ты ж не трепло, да?",
      "target": "Scammer: Csak senkinek se mondd el. Nem vagy pletykás, ugye?",
      "authoredFile": "Translations/hu/dialogue-batch-454.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15588,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452031586309",
      "collection": "Dialogs",
      "key": "line:Scammer_Armpit_Gun_0afa2c2",
      "source": "Scammer: Да подожди-подожди! Да, бля, один раз попробовал побриться, решил так дальше делать.",
      "target": "Scammer: Várj már, várj! Igen, bazdmeg, egyszer kipróbáltam a borotválást, aztán úgy döntöttem, folytatom.",
      "authoredFile": "Translations/hu/dialogue-batch-454.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15589,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452031586308",
      "collection": "Dialogs",
      "key": "line:Scammer_Armpit_0323b75",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15590,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452031586307",
      "collection": "Dialogs",
      "key": "line:Scammer_Armpit_00244cd",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15591,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452031586306",
      "collection": "Dialogs",
      "key": "line:Scammer_Armpit_02b5e54",
      "source": "Scammer: Так а чё в итоге? Норм?",
      "target": "Scammer: Na, mi a vége? Rendben van?",
      "authoredFile": "Translations/hu/dialogue-batch-454.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15592,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452031586305",
      "collection": "Dialogs",
      "key": "line:Scammer_Armpit_021ae2c",
      "source": "Scammer: Ты тут босс.",
      "target": "Scammer: Te vagy itt a főnök.",
      "authoredFile": "Translations/hu/dialogue-batch-454.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15593,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452031586304",
      "collection": "Dialogs",
      "key": "line:Scammer_Armpit_05cff92",
      "source": "Scammer: Чёт ты не той темой занялся.",
      "target": "Scammer: Nem a megfelelő dologgal foglalkozol.",
      "authoredFile": "Translations/hu/dialogue-batch-454.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15594,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452027392008",
      "collection": "Dialogs",
      "key": "line:Scammer_Armpit_0ab714f",
      "source": "Scammer: Ёбаный в рот.",
      "target": "Scammer: A kurva életbe.",
      "authoredFile": "Translations/hu/dialogue-batch-454.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15595,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452027392007",
      "collection": "Dialogs",
      "key": "line:Scammer_PhotoShoot_0316e3a",
      "source": "Scammer: Прямо под солнцем. Оставляю это на твоей совести.",
      "target": "Scammer: Egyenesen a napra. Ezt a lelkiismeretedre bízom.",
      "authoredFile": "Translations/hu/dialogue-batch-454.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15596,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452027392006",
      "collection": "Dialogs",
      "key": "line:Scammer_PhotoShoot_00b0114",
      "source": "Scammer: Нахуй тебя и твой дом, я пошел.",
      "target": "Scammer: Baszd meg te is, meg a házad is. Megyek.",
      "authoredFile": "Translations/hu/dialogue-batch-454.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15597,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452027392005",
      "collection": "Dialogs",
      "key": "line:Scammer_PhotoShoot_086402c",
      "source": "Scammer: Подожди!",
      "target": "Scammer: Várj!",
      "authoredFile": "Translations/hu/dialogue-batch-454.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15598,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452027392004",
      "collection": "Dialogs",
      "key": "line:Scammer_PhotoDontShoot_0e51c32",
      "source": "Scammer: А то расслабятся, забудут, благодаря кому они тут и не будут платить.",
      "target": "Scammer: Különben elkényelmesednek, elfelejtik, kinek köszönhetik, hogy itt vannak, és nem fizetnek majd.",
      "authoredFile": "Translations/hu/dialogue-batch-454.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15599,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452027392003",
      "collection": "Dialogs",
      "key": "line:Scammer_PhotoDontShoot_04ae88f",
      "source": "Scammer: Пусть в тонусе держатся.",
      "target": "Scammer: Maradjanak csak résen.",
      "authoredFile": "Translations/hu/dialogue-batch-454.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15600,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452027392002",
      "collection": "Dialogs",
      "key": "line:Scammer_PhotoDontShoot_0300a30",
      "source": "Scammer: Ты меня не разводи, ты этих лохов прогревай.",
      "target": "Scammer: Ne engem verj át, inkább azokat a balekokat puhítsd meg.",
      "authoredFile": "Translations/hu/dialogue-batch-454.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15601,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452027392001",
      "collection": "Dialogs",
      "key": "line:Scammer_Photo_0f7ff2b",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15602,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452027392000",
      "collection": "Dialogs",
      "key": "line:Scammer_Photo_06b4b68",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15603,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452023197705",
      "collection": "Dialogs",
      "key": "line:Scammer_Photo_023b04c",
      "source": "Scammer: Перефоткаешь?",
      "target": "Scammer: Újra lefényképezel?",
      "authoredFile": "Translations/hu/dialogue-batch-454.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15604,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452023197704",
      "collection": "Dialogs",
      "key": "line:Scammer_Photo_0afec29",
      "source": "Scammer: Вот об этом я и говорил.",
      "target": "Scammer: Pont erről beszéltem.",
      "authoredFile": "Translations/hu/dialogue-batch-454.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15605,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452023197703",
      "collection": "Dialogs",
      "key": "line:Scammer_Photo_0ab2967",
      "source": "Scammer: (Оно получилось очень размазанным)",
      "target": "Scammer: (Nagyon elmosódott lett)",
      "authoredFile": "Translations/hu/dialogue-batch-454.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15606,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452023197702",
      "collection": "Dialogs",
      "key": "line:Scammer_Photo_0f4651e",
      "source": "Scammer: (Вроде, фотография нормальная, но лицо...)",
      "target": "Scammer: (A fénykép nagyjából rendben van, de az arc...)",
      "authoredFile": "Translations/hu/dialogue-batch-454.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15607,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452023197701",
      "collection": "Dialogs",
      "key": "line:Scammer_Photo_0dbc018",
      "source": "Scammer: (Вы фотографируете собеседника)",
      "target": "Scammer: (Lefényképezi a beszélgetőpartnerét)",
      "authoredFile": "Translations/hu/dialogue-batch-454.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15608,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452023197700",
      "collection": "Dialogs",
      "key": "line:Scammer_Photo_00f4feb",
      "source": "Scammer: У меня светочувствительность только высокая. Могу дернуться.",
      "target": "Scammer: Csak nagyon fényérzékeny vagyok. Lehet, hogy összerezzenek.",
      "authoredFile": "Translations/hu/dialogue-batch-454.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15609,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452023197699",
      "collection": "Dialogs",
      "key": "line:Scammer_Photo_0798ae7",
      "source": "Scammer: Сфоткаться со мной хочешь? Ну погнали.",
      "target": "Scammer: Közös képet akarsz velem? Na, gyerünk.",
      "authoredFile": "Translations/hu/dialogue-batch-454.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15610,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452023197698",
      "collection": "Dialogs",
      "key": "line:Scammer_Eyes_DontShoot_0f75f41",
      "source": "Scammer: А я бы не купил всё равно. Ну, по своим причинам.",
      "target": "Scammer: Én amúgy sem vennék. Megvannak rá az okaim.",
      "authoredFile": "Translations/hu/dialogue-batch-455.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15611,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452023197697",
      "collection": "Dialogs",
      "key": "line:Scammer_Eyes_DontShoot_0953c08",
      "source": "Scammer: Если бы у тебя капли были бы...",
      "target": "Scammer: Ha lenne nálad szemcsepp...",
      "authoredFile": "Translations/hu/dialogue-batch-455.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15612,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452023197696",
      "collection": "Dialogs",
      "key": "line:Scammer_Eyes_DontShoot_0cb77bd",
      "source": "Scammer: Ладно, если тебе темка не зашла — понимаю. Но у меня реально болячка на глазу.",
      "target": "Scammer: Rendben, ha az ötletem nem jött be, megértem. De tényleg van valami baj a szememmel.",
      "authoredFile": "Translations/hu/dialogue-batch-455.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15613,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452019003402",
      "collection": "Dialogs",
      "key": "line:Scammer_Eyes_Gun_01270f1",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15614,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452019003401",
      "collection": "Dialogs",
      "key": "line:Scammer_Eyes_Gun_09321f5",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15615,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452019003400",
      "collection": "Dialogs",
      "key": "line:Scammer_Eyes_Gun_0ec926e",
      "source": "Scammer: Чего? Надо подумать?",
      "target": "Scammer: Mi? Át kell gondolnod?",
      "authoredFile": "Translations/hu/dialogue-batch-455.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15616,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452019003399",
      "collection": "Dialogs",
      "key": "line:Scammer_Eyes_Gun_059c9a7",
      "source": "Scammer: Давай с других деньги брать, чтобы не стрелять им в лицо?",
