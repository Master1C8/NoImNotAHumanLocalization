      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452014809094",
      "collection": "Dialogs",
      "key": "line:Scammer_Hands_DontShoot_0b3c4bb",
      "source": "Scammer: Мне кажется, по рукам странно определять монстров этих.",
      "target": "Scammer: Szerintem fura a kezek alapján felismerni ezeket a szörnyeket.",
      "authoredFile": "Translations/hu/dialogue-batch-455.json",
      "reviewResult": "pass"
    },
    {
