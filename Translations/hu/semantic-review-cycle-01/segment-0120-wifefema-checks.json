      "collection": "Dialogs",
      "key": "line:Wifefema_Photo_05b4c9f",
      "source": "Wifefema: Ну? Обычное, ага? Хех, а ты думал, там что-то особенное будет?",
      "target": "Wifefema: Na? Teljesen átlagos, mi? Heh, azt hitted, valami különleges lesz rajta?",
      "authoredFile": "Translations/hu/dialogue-batch-447.json",
      "reviewResult": "pass"
    },
    {
