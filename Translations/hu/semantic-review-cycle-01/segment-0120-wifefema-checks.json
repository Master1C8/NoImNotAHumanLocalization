      "collection": "Dialogs",
      "key": "line:Wifefema_Photo_0bd28cb",
      "source": "Wifefema: Хорошо. Только муженьку моему не показывай, хихи.",
      "target": "Wifefema: Rendben. Csak a férjemnek ne mutasd meg, hihi.",
      "authoredFile": "Translations/hu/dialogue-batch-447.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15177,
