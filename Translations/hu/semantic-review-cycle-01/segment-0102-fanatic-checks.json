  "rows": [
    {
      "ordinal": 13911,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452652343307",
      "collection": "Dialogs",
      "key": "line:Fanatic_Ears_DontShoot_0a6c85a",
      "source": "Fanatic: Ты просто пива мне дай.",
      "target": "Fanatic: Csak adj nekem sört.",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13912,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452652343306",
      "collection": "Dialogs",
      "key": "line:Fanatic_Ears_DontShoot_08dfbb3",
      "source": "Fanatic: Но если уж ты хочешь со мной больше общаться, не обязательно всматриваться в части тела.",
      "target": "Fanatic: De ha többet akarsz beszélgetni velem, nem muszáj a testrészeimet bámulnod.",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13913,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452652343305",
      "collection": "Dialogs",
      "key": "line:Fanatic_Ears_DontShoot_07d83d7",
      "source": "Fanatic: А вообще я не понял, что ты там высматривал.",
      "target": "Fanatic: Amúgy sem értettem, mit kerestél ott.",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13914,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452652343304",
      "collection": "Dialogs",
      "key": "line:Fanatic_Ears_DontShoot_050e34c",
      "source": "Fanatic: Другое дело твоё серое вещество! Оно должно стать жёлтым.",
      "target": "Fanatic: Bezzeg a szürkeállományod! Annak sárgává kell válnia.",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13915,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452652343303",
      "collection": "Dialogs",
      "key": "line:Fanatic_Ears_DontShoot_0990fe2",
      "source": "Fanatic: Уши ничего не значат!",
      "target": "Fanatic: A fülek nem jelentenek semmit!",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13916,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452652343302",
      "collection": "Dialogs",
      "key": "line:Fanatic_Ears_DontShoot_07ebf28",
      "source": "Fanatic: Вот это ты дал жару.",
      "target": "Fanatic: Hát ezt jól megcsináltad.",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13917,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452652343301",
      "collection": "Dialogs",
      "key": "line:Fanatic_Photo_DontShoot_030e6ba",
      "source": "Fanatic: После этого я его не видел. Наконец, пошёл заниматься делом, а не хуйнёй, видимо.",
      "target": "Fanatic: Utána nem láttam többé. Gondolom, végre valami értelmeset csinált a faszságok helyett.",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13918,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452652343300",
      "collection": "Dialogs",
      "key": "line:Fanatic_Photo_DontShoot_0653aab",
      "source": "Fanatic: Так внутри ведра создастся пивной угар, и можно получить силы Солнца!",
      "target": "Fanatic: Így sörgőz képződik a vödörben, és elnyerheted a NAP erejét!",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13919,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452652343299",
      "collection": "Dialogs",
      "key": "line:Fanatic_Photo_DontShoot_007ef1e",
      "source": "Fanatic: И кричал вот так вот: УАААААААА.",
      "target": "Fanatic: És így kiabált: UÁÁÁÁÁÁÁÁ!",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13920,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452652343298",
      "collection": "Dialogs",
      "key": "line:Fanatic_Photo_DontShoot_08852f0",
      "source": "Fanatic: Даю ему ведро, говорю, чтобы дома покрасил в чёрный цвет, вышел на улицу с надетым на голову ведром.",
      "target": "Fanatic: Adtam neki egy vödröt, és mondtam, hogy otthon fesse feketére, aztán menjen ki az utcára a fején a vödörrel.",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13921,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452652343297",
      "collection": "Dialogs",
      "key": "line:Fanatic_Photo_DontShoot_0dd5aac",
      "source": "Fanatic: Я ему сразу сказал: СОЛНЦЕ НЕ ТРОНЕТ ТЕБЯ! Но ты слабачок,сейчас научу тебя трюку.",
      "target": "Fanatic: Rögtön mondtam neki: A NAP NEM BÁNT TÉGED! De te gyönge vagy, majd megtanítok egy trükköt.",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13922,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452652343296",
      "collection": "Dialogs",
      "key": "line:Fanatic_Photo_DontShoot_067a4f0",
      "source": "Fanatic: Приходит ко мне хиленький мужичок. Рассказывает, что хочет понять, как спасаться от Солнца.",
      "target": "Fanatic: Odajött hozzám egy vézna fickó. Azt mondta, meg akarja tudni, hogyan menekülhet meg a Naptól.",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13923,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452648149003",
      "collection": "Dialogs",
      "key": "line:Fanatic_Photo_DontShoot_009ce6f",
      "source": "Fanatic: Ну, есть история, как я учил солнечного лидера принимать силу Солнца.",
      "target": "Fanatic: Van egy történetem arról, hogyan tanítottam a Napvezért befogadni a NAP erejét.",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13924,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452648149002",
      "collection": "Dialogs",
      "key": "line:Fanatic_Ears_Gun_0a9ef5b",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13925,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452648149001",
      "collection": "Dialogs",
      "key": "line:Fanatic_Ears_Gun_0420112",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13926,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452648149000",
      "collection": "Dialogs",
      "key": "line:Fanatic_Ears_Gun_022ad2a",
      "source": "Fanatic: Ты же не вонючий подземник, правильно? ЗАЧЕМ ВЕДЁШЬ СЕБЯ, КАК ОНИ?",
      "target": "Fanatic: Te nem vagy büdös földalatti, ugye? AKKOR MIÉRT VISELKEDSZ ÚGY, MINT ŐK?",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13927,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452648148999",
      "collection": "Dialogs",
      "key": "line:Fanatic_Ears_Gun_03a2ecd",
      "source": "Fanatic: ВОТ ЭТО НИХУЯ СЕБЕ!",
      "target": "Fanatic: HÁT EZ KURVÁRA HIHETETLEN!",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13928,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452648148998",
      "collection": "Dialogs",
      "key": "line:Fanatic_Photo_Gun_00c1272",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13929,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452648148997",
      "collection": "Dialogs",
      "key": "line:Fanatic_Photo_Gun_0b75c63",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13930,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452648148996",
      "collection": "Dialogs",
      "key": "line:Fanatic_Photo_Gun_08f03c4",
      "source": "Fanatic: Так что давай-ка ты уберёшь вот это вот своё агрессивное и послушаешь меня.",
      "target": "Fanatic: Szóval tedd el azt az agresszív izét, és hallgass meg.",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13931,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452648148995",
      "collection": "Dialogs",
      "key": "line:Fanatic_Photo_Gun_092ae2b",
      "source": "Fanatic: Я должен принимать пиво, чтобы Солнце не жгло меня.",
      "target": "Fanatic: Sört kell innom, hogy a Nap ne égessen meg.",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13932,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452648148994",
      "collection": "Dialogs",
      "key": "line:Fanatic_Photo_Gun_0915a19",
      "source": "Fanatic: Это моя пивная аура, да.",
      "target": "Fanatic: Ez az én sörös aurám, igen.",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13933,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452648148993",
      "collection": "Dialogs",
      "key": "line:Fanatic_Photo_Gun_0648ead",
      "source": "Fanatic: Меня охлаждает само СОЛНЦЕ! Оно не даст мне сгореть в его праведном свету... свете... ты понял, короче.",
      "target": "Fanatic: Maga a NAP hűt engem! Nem hagy elégni az ő igazságos fényében… fényé… na, érted.",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13934,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452648148992",
      "collection": "Dialogs",
      "key": "line:Fanatic_Photo_Gun_057c88d",
      "source": "Fanatic: А ну стоять, умалишённый!",
      "target": "Fanatic: Hé, megállj, te őrült!",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13935,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452643954698",
      "collection": "Dialogs",
      "key": "line:Fanatic_Ears_0c240d3",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13936,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452643954697",
      "collection": "Dialogs",
      "key": "line:Fanatic_Ears_0c9c959",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13937,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452643954696",
      "collection": "Dialogs",
      "key": "line:Fanatic_Ears_05fb7ab",
      "source": "Fanatic: Мозг обрабатывает энергию и даёт мне силы противостоять ГАДКИМ УБЛЮДКАМ ПОД ЗЕМЛЁЙ!",
      "target": "Fanatic: Az agy feldolgozza az energiát, és erőt ad nekem, hogy szembeszálljak a FÖLD ALATTI ROHADÉKOKKAL!",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13938,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452643954695",
      "collection": "Dialogs",
      "key": "line:Fanatic_Ears_0f7f601",
      "source": "Fanatic: Это переработанный солнечный свет льётся из ГОЛОВЫ!",
      "target": "Fanatic: A feldolgozott napfény a FEJEMBŐL ÁRAD!",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13939,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452643954694",
      "collection": "Dialogs",
      "key": "line:Fanatic_Ears_0c01099",
      "source": "Fanatic: ...",
      "target": "Fanatic: ...",
      "authoredFile": "Translations/hu/dialogue-batch-040.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13940,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452643954693",
      "collection": "Dialogs",
      "key": "line:Fanatic_Ears_0fe5094",
      "source": "Fanatic: Да, я принимаю в уши сигналы ЖИЗНИ! Как ты узнал?",
      "target": "Fanatic: Igen, a fülemmel fogom az ÉLET jeleit! Honnan tudtad?",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13941,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452643954692",
      "collection": "Dialogs",
      "key": "line:Fanatic_Photo_0db3fe0",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13942,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452643954691",
      "collection": "Dialogs",
      "key": "line:Fanatic_Photo_0063c37",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13943,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452643954690",
      "collection": "Dialogs",
      "key": "line:Fanatic_Photo_05c8078",
      "source": "Fanatic: ЭТО ЖЕ НА СПАСЕНИЕ ЭНЕРГИИ СОЛНЦА!",
      "target": "Fanatic: EZ A NAP ENERGIÁJÁNAK MEGMENTÉSÉRE SZOLGÁL!",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13944,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452643954689",
      "collection": "Dialogs",
      "key": "line:Fanatic_Photo_061464c",
      "source": "Fanatic: А ты мне за это дашь немного денег.",
      "target": "Fanatic: Te pedig adsz majd érte nekem egy kis pénzt.",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13945,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452643954688",
      "collection": "Dialogs",
      "key": "line:Fanatic_Photo_0a97f54",
      "source": "Fanatic: Приходи ко мне, буду рассказывать свое житие-бытие.",
      "target": "Fanatic: Gyere el hozzám, és mesélek neked az életemről.",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13946,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452639760394",
      "collection": "Dialogs",
      "key": "line:Fanatic_Photo_01acaf9",
      "source": "Fanatic: КАК ЖЕ ПРЕКРАСНО ВСЁ ПОЛУЧИЛОСЬ!",
      "target": "Fanatic: MILYEN CSODÁLATOSAN SIKERÜLT MINDEN!",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13947,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452639760393",
      "collection": "Dialogs",
      "key": "line:Fanatic_Photo_05761d7",
      "source": "Fanatic: ...",
      "target": "Fanatic: ...",
      "authoredFile": "Translations/hu/dialogue-batch-040.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13948,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452639760392",
      "collection": "Dialogs",
      "key": "line:Fanatic_Photo_0f5d103",
      "source": "Fanatic: Давай, ФОТКАЙ МЕНЯ!",
      "target": "Fanatic: Na, FÉNYKÉPEZZ LE!",
      "authoredFile": "Translations/hu/dialogue-batch-418.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 13949,
