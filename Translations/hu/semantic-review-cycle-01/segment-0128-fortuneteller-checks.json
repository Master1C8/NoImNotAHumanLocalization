  "rows": [
    {
      "ordinal": 15971,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451876397061",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Ears_DontShoot_065fb16",
      "source": "FortuneTeller: Однажды я услышала в ушах шум, как будто Вселенная мне что-то сказала. Оказалось, это просто сквозняк. Но знаешь, мне всё равно понравилось.",
      "target": "FortuneTeller: Egyszer zúgást hallottam a fülemben, mintha a Világegyetem mondott volna nekem valamit. Kiderült, hogy csak huzat volt. De tudod, nekem így is tetszett.",
      "authoredFile": "Translations/hu/dialogue-batch-464.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15972,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451876397060",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Ears_DontShoot_04f92a4",
      "source": "FortuneTeller: Однажды я услышала в ушах шум, как будто Вселенная мне что-то сказала. Но я думаю, это было что-то гораздо сильнее.",
      "target": "FortuneTeller: Egyszer zúgást hallottam a fülemben, mintha a Világegyetem mondott volna nekem valamit. De azt hiszem, valami annál sokkal erősebb volt.",
      "authoredFile": "Translations/hu/dialogue-batch-464.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15973,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451876397059",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Photo_DontShoot_0ce14f1",
      "source": "FortuneTeller: Знаешь, однажды мне сделали такое фото, что я подумала: это знак от звёзд! А потом поняла: просто свет неправильно упал.",
      "target": "FortuneTeller: Tudod, egyszer olyan fénykép készült rólam, hogy azt hittem: ez jel a csillagoktól! Aztán rájöttem: csak rossz szögből jött a fény.",
      "authoredFile": "Translations/hu/dialogue-batch-464.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15974,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451876397058",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Armpit_DontShoot_0ee02a9",
      "source": "FortuneTeller: Наверное, сейчас моё нынешнее состояние может сравниться с тамошним.",
      "target": "FortuneTeller: Valószínűleg a mostani állapotom az akkorihoz hasonlítható.",
      "authoredFile": "Translations/hu/dialogue-batch-464.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15975,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451876397057",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Armpit_DontShoot_064fc2a",
      "source": "FortuneTeller: Мысли материальны, и так я приближаюсь к исполнению желания. Нужно всего-то правильно его загадать.",
      "target": "FortuneTeller: A gondolatoknak erejük van, így közelebb jutok a kívánságom teljesüléséhez. Csak jól kell megfogalmaznom.",
      "authoredFile": "Translations/hu/dialogue-batch-464.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15976,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451876397056",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Armpit_DontShoot_0beb138",
      "source": "FortuneTeller: Ты знаешь, однажды я три недели жила аскетично и думала только о своей мечте.",
      "target": "FortuneTeller: Tudod, egyszer három hétig aszkéta módon éltem, és csak az álmomra gondoltam.",
      "authoredFile": "Translations/hu/dialogue-batch-464.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15977,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451872202762",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Eyes_DontShoot_026a05d",
      "source": "FortuneTeller: Глаза — это врата в другой мир. Однажды у одного человека они светились, как фонари. Он сказал, что это от любви, но я думаю — от Марса.",
      "target": "FortuneTeller: A szem kapu egy másik világba. Egyszer láttam valakit, akinek úgy világított a szeme, mint két lámpás. Azt mondta, a szerelemtől van, de szerintem a Mars miatt.",
      "authoredFile": "Translations/hu/dialogue-batch-464.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15978,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451872202761",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Hands_DontShoot_0bd3916",
      "source": "FortuneTeller: Однажды после обряда я всю ночь вытаскивала занозы. Больно было, но знаешь что? Каждая заноза — это как урок от Вселенной. Понимаешь, да?",
      "target": "FortuneTeller: Egy szertartás után egyszer egész éjjel szálkákat szedegettem magamból. Fájt, de tudod mit? Minden szálka olyan, mint egy lecke a Világegyetemtől. Érted, ugye?",
      "authoredFile": "Translations/hu/dialogue-batch-464.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15979,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451872202760",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Teeth_DontShoot_084a8e9",
      "source": "FortuneTeller: Я ему сказала: «Всё хорошо, но твоя душа-то прогнила!» Вот и думай после этого, что важнее. Понимаешь, да?",
      "target": "FortuneTeller: Azt mondtam neki: „Minden szép és jó, de a lelked belülről rohadt!” Na, ezek után döntsd el, mi a fontosabb. Érted, ugye?",
      "authoredFile": "Translations/hu/dialogue-batch-464.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15980,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451872202759",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Teeth_DontShoot_0c01b73",
      "source": "FortuneTeller: Знаешь, однажды ко мне пришёл человек с идеальными зубами.",
      "target": "FortuneTeller: Tudod, egyszer egy tökéletes fogsorú ember jött hozzám.",
      "authoredFile": "Translations/hu/dialogue-batch-464.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15981,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451872202758",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Death_0783e5e",
      "source": "FortuneTeller: Вечный понос!",
      "target": "FortuneTeller: Örök hasmenés!",
      "authoredFile": "Translations/hu/dialogue-batch-464.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15982,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451872202757",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Death_04f9353",
      "source": "FortuneTeller: Убьёшь меня – будешь обречён на…",
      "target": "FortuneTeller: Ha megölsz, arra leszel kárhoztatva, hogy…",
      "authoredFile": "Translations/hu/dialogue-batch-464.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15983,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451872202756",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Ears_Gun_0ef8a3b",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15984,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451872202755",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Ears_Gun_0c2c286",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15985,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451872202754",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Ears_Gun_095428f",
      "source": "FortuneTeller: Может, опустишь эту штуку? Ну что ты по ушам поймёшь? Они нужны для того, чтобы слушать мудрых людей!",
      "target": "FortuneTeller: Leengednéd azt az izét? Mégis mit tudsz meg a fülemből? Arra való, hogy a bölcs embereket hallgassam vele!",
      "authoredFile": "Translations/hu/dialogue-batch-464.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15986,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451872202753",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Photo_Gun_083b217",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15987,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451872202752",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Photo_Gun_0c4261f",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15988,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451868008458",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Photo_Gun_071c251",
      "source": "FortuneTeller: Эй! Я ж не виновата, что ты к такому не готов, голубчик!",
      "target": "FortuneTeller: Hé! Nem az én hibám, hogy erre nem vagy felkészülve, kedvesem!",
      "authoredFile": "Translations/hu/dialogue-batch-464.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15989,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451868008457",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Armpit_Gun_0585526",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15990,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451868008456",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Armpit_Gun_00c5a11",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15991,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451868008455",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Armpit_Gun_0109393",
      "source": "FortuneTeller: Это уже не астрология, а какая-то дичь! Давай-ка ты уберёшь ружьё, а я тебе ещё расскажу своих тайн. Бесплатно!",
      "target": "FortuneTeller: Ez már nem asztrológia, hanem kész őrület! Tedd el azt a puskát, és elárulok még néhány titkot. Ingyen!",
      "authoredFile": "Translations/hu/dialogue-batch-464.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15992,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451868008454",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Eyes_Gun_057d5d8",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15993,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451868008453",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Eyes_Gun_00c74a3",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15994,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451868008452",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Eyes_Gun_00e0c43",
      "source": "FortuneTeller: Ты что?! Это ж просто Луна шалит, понимаешь, да?",
      "target": "FortuneTeller: Mi van veled?! Csak a Hold tréfálkozik, érted, ugye?",
      "authoredFile": "Translations/hu/dialogue-batch-464.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15995,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451868008451",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Eyes_Gun_0581aea",
      "source": "FortuneTeller: Ты что?! Это ж просто Луна шалит, понимаешь, да? За её движениями не так просто уследить!",
      "target": "FortuneTeller: Mi van veled?! Csak a Hold tréfálkozik, érted, ugye? Nem olyan könnyű követni a mozgását!",
      "authoredFile": "Translations/hu/dialogue-batch-464.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15996,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451868008450",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Hands_Gun_0881bdb",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15997,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451868008449",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Hands_Gun_00426c2",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15998,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451868008448",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Hands_Gun_01f99ea",
      "source": "FortuneTeller: Ты что, серьёзно? За руки с занозами стрелять будешь? Это последствия работы с ловцами снов!",
      "target": "FortuneTeller: Komolyan? A szálkás kezem miatt lőnél le? Az álomfogókkal végzett munka következménye!",
      "authoredFile": "Translations/hu/dialogue-batch-464.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15999,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451863814154",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Teeth_Gun_0effb5d",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16000,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451863814153",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Teeth_Gun_0860e44",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16001,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451863814152",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Teeth_Gun_0467191",
      "source": "FortuneTeller: Ты что, из-за зубов в меня стрелять собрался? Ты же понимаешь, что это не из-за меня? Это Марс обиделся на Венеру.",
      "target": "FortuneTeller: A fogaim miatt akarsz lelőni? Ugye érted, hogy nem én tehetek róla? A Mars megharagudott a Vénuszra.",
      "authoredFile": "Translations/hu/dialogue-batch-464.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16002,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451863814151",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Ears_006a955",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16003,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451863814150",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Ears_0072a99",
      "source": "Отпустить",
      "target": "Elengedés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16004,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451863814149",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Ears_0531358",
      "source": "FortuneTeller: Ну что? Нашёл ответы?",
      "target": "FortuneTeller: Nos? Megtaláltad a válaszokat?",
      "authoredFile": "Translations/hu/dialogue-batch-464.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16005,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451863814148",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Ears_0082536",
      "source": "FortuneTeller: Ну смотри, только осторожно — они всё слышат, даже твои мысли.",
      "target": "FortuneTeller: Csak nézd, de óvatosan: mindent meghallanak, még a gondolataidat is.",
      "authoredFile": "Translations/hu/dialogue-batch-464.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16006,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504451863814147",
      "collection": "Dialogs",
      "key": "line:FortuneTeller_Photo_04622b9",
      "source": "Достать ружьё",
      "target": "Puska elővétele",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 16007,
