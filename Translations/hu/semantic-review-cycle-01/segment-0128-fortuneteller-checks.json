      "collection": "Dialogs",
      "key": "line:FortuneTeller_Hands_07d86b8",
      "source": "FortuneTeller: Ну, пожалуйста, смотри.",
      "target": "FortuneTeller: Hát persze, nézd csak meg.",
      "authoredFile": "Translations/hu/dialogue-batch-464.json",
