    },
    {
      "ordinal": 13486,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452853669888",
      "collection": "Dialogs",
      "key": "line:NotTrue_Ears_0de0f18",
      "source": "NotTrue: Самые обыкновенные. Как слышала, так и слышу. Но, знаешь… Иногда кажется, что меня и нет вовсе.",
      "target": "NotTrue: Egészen közönséges fülek. Ugyanúgy hallok, mint régen. De tudod… Néha olyan, mintha egyáltalán nem is léteznék.",
      "authoredFile": "Translations/hu/dialogue-batch-406.json",
      "reviewResult": "pass"
    },
