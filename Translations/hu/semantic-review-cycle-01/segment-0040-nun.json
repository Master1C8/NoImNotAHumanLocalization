  "rows": [
    {
      "ordinal": 9429,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454707552265",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_4_07bad6b",
      "source": "Nun: Прощайте. Бог вас покарает!",
      "target": "Nun: Isten vele. Isten megbünteti!",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9430,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454707552264",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_4_037062e",
      "source": "Nun: Но, видимо, он мне подсказывает, что я должна уходить.",
      "target": "Nun: De úgy látszik, azt sugallja, hogy mennem kell.",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9431,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454707552263",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_4_03c6263",
      "source": "Nun: Как чувствовала, что в этом доме Бога нет.",
      "target": "Nun: Éreztem, hogy ebben a házban nincs jelen Isten.",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9432,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454707552262",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_4_0c4fb29",
      "source": "Nun: Да я и не собиралась оставаться.",
      "target": "Nun: Nem is akartam maradni.",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9433,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454707552261",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_3_05b634c",
      "source": "Nun: Прощайте. Бог вас покарает!",
      "target": "Nun: Isten vele. Isten megbünteti!",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9434,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454707552260",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_3_027e7c6",
      "source": "Nun: Мне не нужен ваш отвратительный дом! Я ни минутой больше здесь не останусь.",
      "target": "Nun: Nincs szükségem az undorító házára! Egy perccel sem maradok itt tovább.",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9435,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454707552259",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_3_054f68e",
      "source": "Nun: Решили выставить себя героем?",
      "target": "Nun: Hősnek akarja beállítani magát?",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9436,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454707552258",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_2_0da0e56",
      "source": "Лучше уходи, пока я тебя не пристрелил",
      "target": "Jobb, ha elmész, mielőtt lelőlek.",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9437,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454707552257",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_2_03a696c",
      "source": "Ты отвратительна, но не мне тебя судить",
      "target": "Undorító vagy, de nem az én dolgom ítélkezni fölötted.",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9438,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454707552256",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_2_02b2ed7",
      "source": "Nun: Пути Господни неисповедимы! Нам всё равно никогда не понять Его замыслов.",
      "target": "Nun: Az Úr útjai kifürkészhetetlenek! Úgysem érthetjük meg soha a szándékait.",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9439,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454703357963",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_2_01cf7dd",
      "source": "Nun: Всё, что мы можем, — принять нашу судьбу!",
      "target": "Nun: Csak annyit tehetünk, hogy elfogadjuk a sorsunkat!",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9440,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454703357962",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_2_07360d4",
      "source": "Nun: Мы рабы! РАБЫ БОЖЬИ!",
      "target": "Nun: Rabszolgák vagyunk! ISTEN RABSZOLGÁI!",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9441,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454703357961",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_2_0e41a4e",
      "source": "Nun: Я думала, вы поймёте меня. Но вы такой же глупец, как и те варвары.",
      "target": "Nun: Azt hittem, megért. De ugyanolyan ostoba, mint azok a barbárok.",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9442,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454703357960",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_2_01104ea",
      "source": "Nun: БОГОХУЛЬНИК! ВЫ ТАКОЙ ЖЕ БОГОХУЛЬНИК!",
      "target": "Nun: ISTENKÁROMLÓ! MAGA IS ISTENKÁROMLÓ!",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9443,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454703357959",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_2_05cb987",
      "source": "Nun: Да вы не человек, а настоящий змей!",
      "target": "Nun: Maga nem is ember, hanem valóságos kígyó!",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9444,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454703357958",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_2_02d48a0",
      "source": "Nun: …",
      "target": "Nun: …",
      "authoredFile": "Translations/hu/dialogue-batch-038.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9445,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454703357957",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_2_0d0f67e",
      "source": "Nun: Злорадствуете и считаете, что я это заслужила!?",
      "target": "Nun: Kárörvend, és azt gondolja, megérdemeltem!?",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9446,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454703357956",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_2_05fd839",
      "source": "Nun: Меня, священнослужителя, выгнали деревенщины из святого места по каким-то своим причинам, а вы…",
      "target": "Nun: Engem, Isten szolgáját, holmi parasztok kiűztek a szent helyről valami saját indokukra hivatkozva, maga pedig…",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9447,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454703357955",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_2_0c84d9d",
      "source": "Nun: Вы… совсем из ума выжили!?",
      "target": "Nun: Maga… teljesen megőrült!?",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9448,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454703357954",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_2_0f8830f",
      "source": "Nun: Ах вы нахал!",
      "target": "Nun: Micsoda szemtelenség!",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9449,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454703357953",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_1_023b191",
      "source": "Лучше уходи, пока я тебя не пристрелил",
      "target": "Jobb, ha elmész, mielőtt lelőlek.",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9450,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454703357952",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_1_0ef9116",
      "source": "Ты отвратительна, но не мне тебя судить",
      "target": "Undorító vagy, de nem az én dolgom ítélkezni fölötted.",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9451,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454699163659",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_1_01fc664",
      "source": "Nun: А раз они оказались на улице, значит, такова была их судьба. Значит, им было за что гореть на солнце.",
      "target": "Nun: Ha az utcára kerültek, hát ez volt a sorsuk. Biztos rászolgáltak, hogy elégjenek a napon.",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9452,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454699163658",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_1_0c8889d",
      "source": "Nun: Господь милостив только к тем, кто принял веру в него.",
      "target": "Nun: Az Úr csak azokhoz irgalmas, akik hisznek benne.",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9453,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454699163657",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_1_0016f1c",
      "source": "Nun: Да хоть потоп, но это храм господа Бога, а не какой-то притон для уродцев.",
      "target": "Nun: Lehet akár özönvíz is, de ez az Úristen temploma, nem holmi torzszülöttek tanyája.",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9454,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454699163656",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_1_052c107",
      "source": "Nun: Мало ли что им захотелось. От солнца спрятаться или от каких-то Гостей.",
      "target": "Nun: Mit számít, mit akartak? Elbújni a Nap vagy néhány Vendég elől.",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9455,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454699163655",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_1_05a1f75",
      "source": "Nun: В монастыре место только тем, кто принял веру!",
      "target": "Nun: A kolostorban csak a híveknek van helyük!",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9456,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454699163654",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_0e38567",
      "source": "Я бы тоже тебя выкинул на улицу",
      "target": "Én is kidobtalak volna az utcára.",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9457,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454699163653",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_0987223",
      "source": "Ты не пускала людей, которым нужна была помощь?",
      "target": "Nem engedted be azokat, akik segítségre szorultak?",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9458,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454699163652",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_0c4494e",
      "source": "Nun: А потом ворвались и выгнали меня из храма.",
      "target": "Nun: Aztán berontottak, és kiűztek a templomból.",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9459,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454699163651",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_012abd9",
      "source": "Nun: А эти варвары… разозлились, начали стучать, выламывать ворота.",
      "target": "Nun: Azok a barbárok pedig… feldühödtek, dörömbölni kezdtek, és be akarták törni a kaput.",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9460,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454699163650",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_0acf0c1",
      "source": "Nun: А всё из-за чего? Я их просто не пускала в храм. Сказала, что мы не пускаем некрещёных!",
      "target": "Nun: Mindezt miért? Csak nem engedtem be őket a templomba. Megmondtam, hogy kereszteletleneket nem engedünk be!",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9461,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454699163649",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_4_0f88def",
      "source": "Nun: Они столпились оравой, кричали на меня, ругались как дикари!",
      "target": "Nun: Egy egész csőcselék gyűlt össze, kiabáltak velem, és úgy káromkodtak, mint a vademberek!",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9462,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454699163648",
      "collection": "Dialogs",
      "key": "line:talk_nun_4_05ace4d",
      "source": "Мне надо тебя проверить",
      "target": "Meg kell vizsgálnom téged",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9463,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454694969355",
      "collection": "Dialogs",
      "key": "line:talk_nun_4_0604578",
      "source": "Чего хотели те «богохульники»?",
      "target": "Mit akartak azok az „istenkáromlók”?",
      "authoredFile": "Translations/hu/dialogue-batch-302.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9464,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454694969354",
      "collection": "Dialogs",
      "key": "line:talk_nun_4_0eb8ad9",
      "source": "Nun: Иже еси на небеси…",
      "target": "Nun: Ki vagy a mennyekben…",
      "authoredFile": "Translations/hu/dialogue-batch-303.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9465,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454694969353",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_3_0090b96",
      "source": "Nun: Гореть тварям в аду!",
      "target": "Nun: Égjenek a pokolban azok a szörnyetegek!",
      "authoredFile": "Translations/hu/dialogue-batch-303.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9466,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454694969352",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_3_03bc25d",
      "source": "Nun: Небось святой водой напиваются, чтоб им ей захлебнуться.",
      "target": "Nun: Biztos vedelik a szenteltvizet. Bárcsak megfulladnának benne!",
      "authoredFile": "Translations/hu/dialogue-batch-303.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9467,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454694969351",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_3_0904637",
      "source": "Nun: У меня было всё по-Божески, мы читали молитвы, соблюдали пост. А эти дикари…",
      "target": "Nun: Nálam minden Isten rendje szerint zajlott: imádkoztunk, böjtöltünk. Azok a vademberek pedig…",
      "authoredFile": "Translations/hu/dialogue-batch-303.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9468,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454694969350",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_3_0252a61",
      "source": "Nun: …",
      "target": "Nun: …",
      "authoredFile": "Translations/hu/dialogue-batch-038.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9469,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454694969349",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_3_0f39054",
      "source": "Nun: Поселились там как у себя дома. Варвары – вот они кто!",
      "target": "Nun: Beköltöztek, mintha a saját otthonuk lenne. Barbárok, mind egy szálig!",
      "authoredFile": "Translations/hu/dialogue-batch-303.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9470,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454694969348",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_3_0e3d826",
      "source": "Nun: Ворвались, выгнали всех – и меня, и мою паству.",
      "target": "Nun: Berontottak, és mindenkit elűztek: engem is, a híveimet is.",
      "authoredFile": "Translations/hu/dialogue-batch-303.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9471,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454694969347",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_3_043de22",
      "source": "Nun: Они осквернили Божий храм, будь они прокляты!",
      "target": "Nun: Megszentségtelenítették Isten templomát, legyenek átkozottak!",
      "authoredFile": "Translations/hu/dialogue-batch-303.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9472,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454694969346",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_3_047ab26",
      "source": "Nun: Во-вторых — всё из-за толп богохульников.",
      "target": "Nun: Másodszor: mindez az istenkáromlók tömege miatt történt.",
      "authoredFile": "Translations/hu/dialogue-batch-303.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9473,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454694969345",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_3_0b4b8a6",
      "source": "Nun: Во-первых, монастырь не мой — он Господа Бога.",
      "target": "Nun: Először is, a kolostor nem az enyém, hanem az Úristené.",
      "authoredFile": "Translations/hu/dialogue-batch-303.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9474,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454694969344",
      "collection": "Dialogs",
      "key": "line:talk_nun_3_0a2a038",
      "source": "Мне надо тебя проверить",
      "target": "Meg kell vizsgálnom téged",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9475,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454690775051",
      "collection": "Dialogs",
      "key": "line:talk_nun_3_0117aa1",
      "source": "А чего ты не осталась в своём монастыре?",
      "target": "Miért nem maradtál a kolostorodban?",
      "authoredFile": "Translations/hu/dialogue-batch-303.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9476,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454690775050",
      "collection": "Dialogs",
      "key": "line:talk_nun_3_0a37243",
      "source": "Nun: Иже еси на небеси…",
      "target": "Nun: Ki vagy a mennyekben…",
      "authoredFile": "Translations/hu/dialogue-batch-303.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9477,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454690775049",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_2_09795e6",
      "source": "Nun: Но я вас не боюсь. Господь-Боженька меня защитит, если понадобится.",
      "target": "Nun: De nem félek magától. A Jóisten megvéd, ha szükség lesz rá.",
      "authoredFile": "Translations/hu/dialogue-batch-303.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9478,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454690775048",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_2_0865ebe",
      "source": "Nun: А может, вы сам демон! Рожки-то того погляди выступят у вас!",
      "target": "Nun: Talán maga egyenesen démon! Már-már látom a szarvait előbújni!",
      "authoredFile": "Translations/hu/dialogue-batch-303.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9479,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454690775047",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_2_0831a05",
      "source": "Nun: Убиваете всех, кто вам демоном кажется.",
      "target": "Nun: Megöl mindenkit, akit démonnak vél.",
      "authoredFile": "Translations/hu/dialogue-batch-303.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9480,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454690775046",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_2_0a81b44",
      "source": "Nun: Здесь смердит убийством и смертью. А вы небось и рады распространять этот грех!",
      "target": "Nun: Itt gyilkosság és halál bűze terjeng. Maga pedig biztos örömmel terjeszti tovább ezt a bűnt!",
      "authoredFile": "Translations/hu/dialogue-batch-303.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9481,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454690775045",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_2_0bfef93",
      "source": "Nun: Да если бы у меня был выбор, я бы в жизни не приходила сюда.",
      "target": "Nun: Ha lett volna választásom, soha nem jövök ide.",
      "authoredFile": "Translations/hu/dialogue-batch-303.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9482,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454690775044",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_2_024b87e",
      "source": "Nun: Думаете, мне сильно нужна ваша гнилая лачуга?",
      "target": "Nun: Azt hiszi, szükségem van erre a rothadó viskójára?",
      "authoredFile": "Translations/hu/dialogue-batch-303.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9483,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454690775043",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_2_05b7cd2",
      "source": "Nun: Я бы не стала идти в это Богом забытое место, если бы монастырь выстоял.",
      "target": "Nun: Nem jöttem volna erre az Isten háta mögötti helyre, ha a kolostor megmaradt volna.",
      "authoredFile": "Translations/hu/dialogue-batch-303.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9484,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454690775042",
      "collection": "Dialogs",
      "key": "line:talk_nun_2_0dbf2e4",
      "source": "Мне надо тебя проверить",
      "target": "Meg kell vizsgálnom téged",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9485,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454690775041",
      "collection": "Dialogs",
      "key": "line:talk_nun_2_0229108",
      "source": "Если не нравится дом, почему не свалишь?",
      "target": "Ha nem tetszik a ház, miért nem húzol el?",
      "authoredFile": "Translations/hu/dialogue-batch-303.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9486,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454690775040",
      "collection": "Dialogs",
      "key": "line:talk_nun_2_0456dfa",
      "source": "Nun: Иже еси на небеси…",
      "target": "Nun: Ki vagy a mennyekben…",
      "authoredFile": "Translations/hu/dialogue-batch-303.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9487,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454686580746",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_1_000bd87",
      "source": "Nun: Ладно, забудьте.",
      "target": "Nun: Jól van, felejtse el.",
      "authoredFile": "Translations/hu/dialogue-batch-303.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9488,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454686580745",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_1_0eba984",
      "source": "Nun: …",
      "target": "Nun: …",
      "authoredFile": "Translations/hu/dialogue-batch-038.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9489,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454686580744",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_1_04d1228",
      "source": "Nun: Вы не могли повесить крест в комнату получше?",
      "target": "Nun: Nem tudott volna egy jobb szobába keresztet akasztani?",
      "authoredFile": "Translations/hu/dialogue-batch-303.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9490,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454686580743",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_1_04886e3",
      "source": "Nun: Там мебель вся старая и трухлявая. Небось её моль объела.",
      "target": "Nun: Ott minden bútor régi és korhadt. Biztos még a molyok is megrágták.",
      "authoredFile": "Translations/hu/dialogue-batch-303.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9491,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454686580742",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_1_0bde67d",
      "source": "Nun: И ещё – вы меня специально в самую убогую комнату поселили?",
      "target": "Nun: És még valami: szándékosan a legnyomorúságosabb szobába tett?",
      "authoredFile": "Translations/hu/dialogue-batch-303.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9492,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454686580741",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_1_07e478e",
      "source": "Nun: Ужасно кривой, с ужасной планировкой.",
      "target": "Nun: Borzalmasan ferde, és a beosztása is szörnyű.",
      "authoredFile": "Translations/hu/dialogue-batch-303.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9493,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454686580740",
      "collection": "Dialogs",
      "key": "line:Nun_Asking_1_072d9fd",
      "source": "Nun: Отвратительно.",
      "target": "Nun: Undorító.",
      "authoredFile": "Translations/hu/dialogue-batch-303.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9494,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454686580739",
      "collection": "Dialogs",
      "key": "line:talk_nun_1_0d1b083",
      "source": "Мне нужно тебя проверить",
      "target": "Meg kell vizsgálnom téged",
      "authoredFile": "Translations/hu/dialogue-batch-003.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9495,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454686580738",
      "collection": "Dialogs",
      "key": "line:talk_nun_1_016010d",
      "source": "Как тебе дом?",
      "target": "Milyen a ház?",
      "authoredFile": "Translations/hu/dialogue-batch-303.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9496,
