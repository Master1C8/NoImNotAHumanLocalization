      "key": "line:Leper_Hands_Gun_0bb90a7",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11275,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454036463626",
      "collection": "Dialogs",
      "key": "line:Leper_Hands_Gun_0d4f8dd",
      "source": "Leper: Просто дефектная кожа.",
      "target": "Leper: Csak bőrhiba.",
      "authoredFile": "Translations/hu/dialogue-batch-352.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11276,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454036463625",
      "collection": "Dialogs",
      "key": "line:Leper_Hands_Gun_007a2f8",
      "source": "Leper: Я же говорю, это дефектная кожа.",
      "target": "Leper: Mondom, ez csak bőrhiba.",
      "authoredFile": "Translations/hu/dialogue-batch-352.json",
      "reviewResult": "pass"
    },
    {
