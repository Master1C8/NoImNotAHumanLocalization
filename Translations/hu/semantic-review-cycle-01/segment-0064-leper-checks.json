    },
    {
      "ordinal": 11245,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454044852231",
      "collection": "Dialogs",
      "key": "line:Leper_Death_09ed1a0",
      "source": "Leper: Чёрт, я не хочу…",
      "target": "Leper: A fenébe, nem akarok…",
      "authoredFile": "Translations/hu/dialogue-batch-352.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11246,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454044852230",
      "collection": "Dialogs",
      "key": "line:Leper_Ears_DontShoot_02c37c1",
      "source": "Leper: КЧС ни разу не говорил, что есть такой признак.",
      "target": "Leper: A KCsSz egyszer sem mondta, hogy ez is jel lenne.",
      "authoredFile": "Translations/hu/dialogue-batch-352.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11247,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454044852229",
      "collection": "Dialogs",
      "key": "line:Leper_Ears_DontShoot_03c1f92",
      "source": "Leper: Ты меня так до инфаркта доведёшь. Ты вообще откуда узнал про уши?",
      "target": "Leper: Így még szívrohamot kapok miattad. Egyáltalán honnan hallottál a fülekről?",
      "authoredFile": "Translations/hu/dialogue-batch-352.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11248,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454044852228",
      "collection": "Dialogs",
      "key": "line:Leper_Ears_DontShoot_0517384",
      "source": "Leper: Ёбаный свет…",
      "target": "Leper: Kibaszott fény…",
      "authoredFile": "Translations/hu/dialogue-batch-352.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11249,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454044852227",
      "collection": "Dialogs",
      "key": "line:Leper_Photo_DontShoot_0f0a840",
      "source": "Leper: Каким боком шарлатанский фотоаппарат определяет Гость ли перед тобой?",
      "target": "Leper: Honnan állapítja meg az a sarlatán fényképezőgép, hogy Vendég áll-e előtted?",
      "authoredFile": "Translations/hu/dialogue-batch-352.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11250,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454044852226",
      "collection": "Dialogs",
      "key": "line:Leper_Photo_DontShoot_0bdc945",
      "source": "Leper: С тобой точно всё в порядке!?",
      "target": "Leper: Biztos, hogy jól vagy!?",
      "authoredFile": "Translations/hu/dialogue-batch-352.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11251,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454044852225",
      "collection": "Dialogs",
      "key": "line:Leper_Armpit_DontShoot_09b9afd",
      "source": "Leper: Ты нихрена не лучше людей, которые считают, что я заразный.",
      "target": "Leper: Semmivel sem vagy jobb azoknál, akik fertőzőnek tartanak.",
      "authoredFile": "Translations/hu/dialogue-batch-352.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11252,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454044852224",
      "collection": "Dialogs",
      "key": "line:Leper_Armpit_DontShoot_0ee2741",
      "source": "Leper: …",
      "target": "Leper: …",
      "authoredFile": "Translations/hu/dialogue-batch-039.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11253,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454040657940",
      "collection": "Dialogs",
      "key": "line:Leper_Eyes_DontShoot_0cc1a11",
      "source": "Leper: Ты при каждом подозрении на признак достаёшь ружьё?",
      "target": "Leper: Valahányszor valami jelre gyanakszol, előveszed a puskát?",
      "authoredFile": "Translations/hu/dialogue-batch-352.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11254,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454040657939",
      "collection": "Dialogs",
      "key": "line:Leper_Eyes_DontShoot_0247dcc",
      "source": "Leper: Пиздец.",
      "target": "Leper: Ez kész őrület.",
      "authoredFile": "Translations/hu/dialogue-batch-352.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11255,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454040657938",
      "collection": "Dialogs",
      "key": "line:Leper_Hands_DontShoot_063a0ab",
      "source": "Leper: Я на секунду подумал, что ты правда убьёшь меня за мою особенность.",
      "target": "Leper: Egy pillanatig azt hittem, tényleg megölsz azért, mert ilyen vagyok.",
      "authoredFile": "Translations/hu/dialogue-batch-352.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11256,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454040657937",
      "collection": "Dialogs",
      "key": "line:Leper_Hands_DontShoot_07f885f",
      "source": "Leper: Спасибо.",
      "target": "Leper: Köszönöm.",
      "authoredFile": "Translations/hu/dialogue-batch-352.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11257,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454040657936",
      "collection": "Dialogs",
      "key": "line:Leper_Teeth_DontShoot_04ccb3e",
      "source": "Leper: Нахуй ты ствол-то направлял на меня?",
      "target": "Leper: Mi a faszért fogtad rám a puskát?",
      "authoredFile": "Translations/hu/dialogue-batch-352.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11258,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454040657935",
      "collection": "Dialogs",
      "key": "line:Leper_Teeth_DontShoot_09c4b58",
      "source": "Leper: Пиздец…",
      "target": "Leper: A kurva életbe…",
      "authoredFile": "Translations/hu/dialogue-batch-352.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11259,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454040657934",
      "collection": "Dialogs",
      "key": "line:Leper_Ears_Gun_0175c31",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11260,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454040657933",
      "collection": "Dialogs",
      "key": "line:Leper_Ears_Gun_07beb8a",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11261,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454040657932",
      "collection": "Dialogs",
      "key": "line:Leper_Ears_Gun_0fed963",
      "source": "Leper: Уши же даже не являются признаком Гостей. О них ни разу не говорили по телевизору.",
      "target": "Leper: A fül nem is tartozik a Vendégek jelei közé. A tévében egyszer sem beszéltek róla.",
      "authoredFile": "Translations/hu/dialogue-batch-352.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11262,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454040657931",
      "collection": "Dialogs",
      "key": "line:Leper_Ears_Gun_0ddfd31",
      "source": "Leper: Ты что, издеваешься?",
      "target": "Leper: Most szórakozol velem?",
      "authoredFile": "Translations/hu/dialogue-batch-352.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11263,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454040657930",
      "collection": "Dialogs",
      "key": "line:Leper_Photo_Gun_074d44f",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11264,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454040657929",
      "collection": "Dialogs",
      "key": "line:Leper_Photo_Gun_078d808",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11265,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454040657928",
      "collection": "Dialogs",
      "key": "line:Leper_Photo_Gun_00dca38",
      "source": "Leper: Это что, фотка ауры? Ты меня из-за какой-то грёбаной ауры убить хочешь?",
      "target": "Leper: Ez meg mi, aurafotó? Valami rohadt aura miatt akarsz megölni?",
      "authoredFile": "Translations/hu/dialogue-batch-352.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11266,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454040657927",
      "collection": "Dialogs",
      "key": "line:Leper_Photo_Gun_00a577c",
      "source": "Leper: Чёрт, подожди? Это даже не обычный фотоаппарат.",
      "target": "Leper: A fenébe, várj csak! Ez nem is közönséges fényképezőgép.",
      "authoredFile": "Translations/hu/dialogue-batch-352.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11267,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454040657926",
      "collection": "Dialogs",
      "key": "line:Leper_Armpit_Gun_065e3f1",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11268,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454040657925",
      "collection": "Dialogs",
      "key": "line:Leper_Armpit_Gun_00b8497",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11269,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454040657924",
      "collection": "Dialogs",
      "key": "line:Leper_Armpit_Gun_0ce7467",
      "source": "Leper: Ты издеваешься!? За что?",
      "target": "Leper: Most szórakozol!? Miért?",
      "authoredFile": "Translations/hu/dialogue-batch-352.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11270,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454040657923",
      "collection": "Dialogs",
      "key": "line:Leper_Eyes_Gun_05fa604",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11271,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454040657922",
      "collection": "Dialogs",
      "key": "line:Leper_Eyes_Gun_059e7ae",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11272,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454040657921",
      "collection": "Dialogs",
      "key": "line:Leper_Eyes_Gun_002659a",
      "source": "Leper: Чёрт, я же сказал, это из-за болезни.",
      "target": "Leper: A fenébe, mondtam már, hogy a betegség miatt van.",
      "authoredFile": "Translations/hu/dialogue-batch-352.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11273,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454040657920",
      "collection": "Dialogs",
      "key": "line:Leper_Hands_Gun_0eb015e",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11274,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454036463627",
