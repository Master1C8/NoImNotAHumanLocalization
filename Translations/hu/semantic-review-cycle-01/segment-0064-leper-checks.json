      "collection": "Dialogs",
      "key": "line:Leper_Teeth_Gun_0501ea2",
      "source": "Leper: Ёбаный свет, ты что?",
      "target": "Leper: Kibaszott fény, mit csinálsz?",
      "authoredFile": "Translations/hu/dialogue-batch-352.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11280,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454036463621",
      "collection": "Dialogs",
      "key": "line:Leper_Ears_08fa210",
      "source": "Достать ружьё",
