    },
    {
      "ordinal": 11282,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454036463619",
      "collection": "Dialogs",
      "key": "line:Leper_Ears_055f747",
      "source": "Leper: И как, нашёл что-нибудь подозрительное?",
      "target": "Leper: Na, találtál valami gyanúsat?",
      "authoredFile": "Translations/hu/dialogue-batch-352.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11283,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454036463618",
      "collection": "Dialogs",
      "key": "line:Leper_Ears_00ff779",
      "source": "Leper: ...",
      "target": "Leper: ...",
      "authoredFile": "Translations/hu/dialogue-batch-039.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11284,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454036463617",
      "collection": "Dialogs",
      "key": "line:Leper_Ears_0a63ec8",
      "source": "Leper: Впрочем, если ты хочешь глянуть на мои уши — смотри.",
      "target": "Leper: De ha meg akarod nézni a fülemet, hát nézd.",
      "authoredFile": "Translations/hu/dialogue-batch-352.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11285,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454036463616",
      "collection": "Dialogs",
      "key": "line:Leper_Ears_04cf39e",
      "source": "Leper: Без обид, но я знаю Гостевые признаки, и это — не один из них.",
      "target": "Leper: Ne vedd sértésnek, de ismerem a Vendégek jeleit, és ez nem tartozik közéjük.",
