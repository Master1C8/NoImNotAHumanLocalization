  "rows": [
    {
      "ordinal": 10756,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454225207301",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_5_2_0a52af4",
      "source": "WheelChair: Ну, я и не стану рассказывать. Чего мучить тебя?",
      "target": "WheelChair: Akkor nem is mesélem el. Minek kínozzalak vele?",
      "authoredFile": "Translations/hu/dialogue-batch-338.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10757,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454225207300",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_5_2_08bd7b5",
      "source": "WheelChair: Чего молчишь? Неинтересно?",
      "target": "WheelChair: Miért hallgatsz? Nem érdekel?",
      "authoredFile": "Translations/hu/dialogue-batch-338.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10758,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454225207299",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_5_2_0d32904",
      "source": "WheelChair: …",
      "target": "WheelChair: …",
      "authoredFile": "Translations/hu/dialogue-batch-039.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10759,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454225207298",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_5_1_094170b",
      "source": "WheelChair: Не, по-другому всё было.",
      "target": "WheelChair: Nem, másképp történt.",
      "authoredFile": "Translations/hu/dialogue-batch-338.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10760,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454225207297",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_5_1_0d7b0a8",
      "source": "WheelChair: Или подожди…",
      "target": "WheelChair: Vagy várj csak…",
      "authoredFile": "Translations/hu/dialogue-batch-338.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10761,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454225207296",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_5_1_0148db9",
      "source": "WheelChair: Упал, и мне трамваем ноги срубило.",
      "target": "WheelChair: Elestem, és a villamos levágta a lábaimat.",
      "authoredFile": "Translations/hu/dialogue-batch-338.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10762,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454221013003",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_5_1_015e64c",
      "source": "WheelChair: … Ну да, я как раз потом пошёл пива выпить.",
      "target": "WheelChair: … Ja igen, utána mentem is sörözni.",
      "authoredFile": "Translations/hu/dialogue-batch-338.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10763,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454221013002",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_5_0406138",
      "source": "…",
      "target": "…",
      "authoredFile": "Translations/hu/dialogue-batch-003.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10764,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454221013001",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_5_0a6c25f",
      "source": "Ладно, забей",
      "target": "Jó, hagyjuk",
      "authoredFile": "Translations/hu/dialogue-batch-338.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10765,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454221013000",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_5_0ab53e8",
      "source": "WheelChair: Да чёрт с ногами, интересно, докопал ли он куда хотел.",
      "target": "WheelChair: A francba a lábaimmal. Inkább az érdekel, eljutott-e az ásással odáig, ahová akart.",
      "authoredFile": "Translations/hu/dialogue-batch-338.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10766,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454221012999",
      "collection": "Dialogs",
      "key": "line:talk_wheelchair_5_0bd1129",
      "source": "Мне надо тебя проверить",
      "target": "Meg kell vizsgálnom téged",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10767,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454221012998",
      "collection": "Dialogs",
      "key": "line:talk_wheelchair_5_08630e7",
      "source": "А с ногами-то что?",
      "target": "És mi történt a lábaiddal?",
      "authoredFile": "Translations/hu/dialogue-batch-338.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10768,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454221012997",
      "collection": "Dialogs",
      "key": "line:talk_wheelchair_5_0df0d56",
      "source": "WheelChair: Эх, жизнь моя – жестянка…",
      "target": "WheelChair: Ej, bádogdoboz az életem…",
      "authoredFile": "Translations/hu/dialogue-batch-338.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10769,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454221012996",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_4_08807f9",
      "source": "WheelChair: Наверно, тогда я в последний раз его и видел.",
      "target": "WheelChair: Talán akkor láttam őt utoljára.",
      "authoredFile": "Translations/hu/dialogue-batch-338.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10770,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454221012995",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_4_099245e",
      "source": "WheelChair: Блин…",
      "target": "WheelChair: Basszus…",
      "authoredFile": "Translations/hu/dialogue-batch-338.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10771,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454221012994",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_4_0529ef4",
      "source": "WheelChair: …",
      "target": "WheelChair: …",
      "authoredFile": "Translations/hu/dialogue-batch-039.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10772,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454221012993",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_4_0fe62bd",
      "source": "WheelChair: И полез копать…",
      "target": "WheelChair: Aztán ásni kezdett…",
      "authoredFile": "Translations/hu/dialogue-batch-338.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10773,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454221012992",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_4_0f2145c",
      "source": "WheelChair: Он заказал себе ручной бур или типо того.",
      "target": "WheelChair: Rendelt magának egy kézi fúrót vagy valami olyasmit.",
      "authoredFile": "Translations/hu/dialogue-batch-338.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10774,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454216818699",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_4_02e7c9f",
      "source": "WheelChair: Ему в голову попала мысль, что под домом у него проходит туннель из мяса.",
      "target": "WheelChair: Az jutott eszébe, hogy a háza alatt húsból álló alagút húzódik.",
      "authoredFile": "Translations/hu/dialogue-batch-338.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10775,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454216818698",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_4_0c014e1",
      "source": "WheelChair: Так вот… он решил у себя во дворе прокопать траншею.",
      "target": "WheelChair: Szóval… elhatározta, hogy árkot ás az udvarán.",
      "authoredFile": "Translations/hu/dialogue-batch-338.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10776,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454216818697",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_4_052a7d4",
      "source": "WheelChair: Помнишь друга со скалы, о котором я тебе говорил?",
      "target": "WheelChair: Emlékszel arra a barátomra a sziklánál, akiről meséltem?",
      "authoredFile": "Translations/hu/dialogue-batch-338.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10777,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454216818696",
      "collection": "Dialogs",
      "key": "line:talk_wheelchair_4_0457fcd",
      "source": "Мне надо тебя проверить",
      "target": "Meg kell vizsgálnom téged",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10778,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454216818695",
      "collection": "Dialogs",
      "key": "line:talk_wheelchair_4_0778f53",
      "source": "Как ты потерял ноги?",
      "target": "Hogyan veszítetted el a lábaidat?",
      "authoredFile": "Translations/hu/dialogue-batch-338.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10779,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454216818694",
      "collection": "Dialogs",
      "key": "line:talk_wheelchair_4_003ceee",
      "source": "WheelChair: Эх, жизнь моя – жестянка…",
      "target": "WheelChair: Ej, bádogdoboz az életem…",
      "authoredFile": "Translations/hu/dialogue-batch-338.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10780,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454216818693",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_3_2_003f44d",
      "source": "WheelChair: Вон, Бог уже простил толпы намоленных пастей. Может, и с нами что хорошее случится.",
      "target": "WheelChair: Nézd, Isten már az imádkozó pofák tömegeinek is megbocsátott. Hátha velünk is történik valami jó.",
      "authoredFile": "Translations/hu/dialogue-batch-338.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10781,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454216818692",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_3_2_021b112",
      "source": "WheelChair: Когда-то ужасные чудеса кончатся. Вот тогда начнутся хорошие, добрые чудеса.",
      "target": "WheelChair: Egyszer véget érnek a borzalmas csodák. Akkor kezdődnek majd a jó, kedves csodák.",
      "authoredFile": "Translations/hu/dialogue-batch-339.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10782,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454216818691",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_3_2_0d42a01",
      "source": "WheelChair: Пока что только ужасные. НО!",
      "target": "WheelChair: Egyelőre csak borzalmasak vannak. DE!",
      "authoredFile": "Translations/hu/dialogue-batch-339.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10783,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454216818690",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_3_2_02f8944",
      "source": "WheelChair: Слушай, мы в мире живём, где происходят чудеса.",
      "target": "WheelChair: Figyelj, olyan világban élünk, ahol csodák történnek.",
      "authoredFile": "Translations/hu/dialogue-batch-339.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10784,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454216818689",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_3_1_058fa82",
      "source": "WheelChair: Ты не по кругу ходишь, что ли?",
      "target": "WheelChair: Te nem körbe-körbe jársz?",
      "authoredFile": "Translations/hu/dialogue-batch-339.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10785,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454216818688",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_3_1_05f99d5",
      "source": "WheelChair: А так если подумать, ты чем-то от меня отличаешься?",
      "target": "WheelChair: Ha belegondolsz, te miben különbözöl tőlem?",
      "authoredFile": "Translations/hu/dialogue-batch-339.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10786,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454212624395",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_3_1_0631b3d",
      "source": "WheelChair: …",
      "target": "WheelChair: …",
      "authoredFile": "Translations/hu/dialogue-batch-039.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10787,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454212624394",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_3_1_0e8145a",
      "source": "WheelChair: Да нихуя. Всё тот же. Просто живу в цикле.",
      "target": "WheelChair: Hát kurvára semmiben. Ugyanaz vagyok. Csak egy körforgásban élek.",
      "authoredFile": "Translations/hu/dialogue-batch-339.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10788,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454212624393",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_3_1_0c0ef85",
      "source": "WheelChair: Кончится этот день – начнётся другой. Но будет ли это новый день?",
      "target": "WheelChair: Véget ér ez a nap, kezdődik egy másik. De tényleg új nap lesz?",
      "authoredFile": "Translations/hu/dialogue-batch-339.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10789,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454212624392",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_3_1_0bb93f6",
      "source": "WheelChair: Всё одно и то же, никак из этого цикла не выйти.",
      "target": "WheelChair: Minden ugyanaz, sehogy sem lehet kitörni ebből a körforgásból.",
      "authoredFile": "Translations/hu/dialogue-batch-339.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10790,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454212624391",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_3_1_05463f3",
      "source": "WheelChair: Вот и моя нога это доказывает.",
      "target": "WheelChair: A lábam is ezt bizonyítja.",
      "authoredFile": "Translations/hu/dialogue-batch-339.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10791,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454212624390",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_3_1_047ad39",
      "source": "WheelChair: У правой ноги длиннее шаги. Поэтому мы нарезаем круги.",
      "target": "WheelChair: A jobb láb lépései hosszabbak. Ezért járunk körbe-körbe.",
      "authoredFile": "Translations/hu/dialogue-batch-339.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10792,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454212624389",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_3_1_0484db3",
      "source": "WheelChair: Вот знаешь как говорят?",
      "target": "WheelChair: Tudod, mit szoktak mondani?",
      "authoredFile": "Translations/hu/dialogue-batch-339.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10793,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454212624388",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_3_1_0234409",
      "source": "WheelChair: Конечно!",
      "target": "WheelChair: Hát persze!",
      "authoredFile": "Translations/hu/dialogue-batch-339.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10794,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454212624387",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_3_0f638fa",
      "source": "Почему думаешь, что ноги отрастут?",
      "target": "Miért gondolod, hogy visszanőnek a lábaid?",
      "authoredFile": "Translations/hu/dialogue-batch-339.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10795,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454212624386",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_3_056ccef",
      "source": "Ты правда в это веришь?",
      "target": "Tényleg hiszel ebben?",
      "authoredFile": "Translations/hu/dialogue-batch-339.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10796,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454212624385",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_3_00e106e",
      "source": "WheelChair: У тебя коляски нет, как ты меня поймёшь?",
      "target": "WheelChair: Neked nincs tolókocsid, hogy érthetnél meg engem?",
      "authoredFile": "Translations/hu/dialogue-batch-339.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10797,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454212624384",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_3_097adc2",
      "source": "WheelChair: Если у меня ног нет, как я заторможу на большой скорости? Или войду в поворот?",
      "target": "WheelChair: Ha nincsenek lábaim, hogy fékeznék nagy sebességnél? Vagy hogyan vennék be egy kanyart?",
      "authoredFile": "Translations/hu/dialogue-batch-339.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10798,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454208430091",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_3_0411596",
      "source": "WheelChair: Я на коляске без ног не могу гонять. Понимаешь?",
      "target": "WheelChair: Lábak nélkül nem tudok száguldozni a tolókocsival. Érted?",
      "authoredFile": "Translations/hu/dialogue-batch-339.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10799,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454208430090",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_3_02d7248",
      "source": "WheelChair: У меня волосы не сожгло, не выпали. Значит, всё хорошо.",
      "target": "WheelChair: A hajam nem égett meg és nem hullott ki. Szóval minden rendben.",
      "authoredFile": "Translations/hu/dialogue-batch-339.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10800,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454208430089",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_3_0d02a75",
      "source": "WheelChair: Да причём тут это?",
      "target": "WheelChair: Ennek meg mi köze hozzá?",
      "authoredFile": "Translations/hu/dialogue-batch-339.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10801,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454208430088",
      "collection": "Dialogs",
      "key": "line:talk_wheelchair_3_012f131",
      "source": "Мне надо тебя проверить",
      "target": "Meg kell vizsgálnom téged",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10802,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454208430087",
      "collection": "Dialogs",
      "key": "line:talk_wheelchair_3_0b45431",
      "source": "Тебе голову напекло?",
      "target": "Napszúrást kaptál?",
      "authoredFile": "Translations/hu/dialogue-batch-339.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10803,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454208430086",
      "collection": "Dialogs",
      "key": "line:talk_wheelchair_3_0c6214b",
      "source": "WheelChair: Эх, жизнь моя – жестянка…",
      "target": "WheelChair: Ej, bádogdoboz az életem…",
      "authoredFile": "Translations/hu/dialogue-batch-339.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10804,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454208430085",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_2_0de7c69",
      "source": "WheelChair: Да ничего, хорошо. Спасибо, что поинтересовался.",
      "target": "WheelChair: Semmi baj, jól vagyok. Kösz, hogy érdeklődtél.",
      "authoredFile": "Translations/hu/dialogue-batch-340.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10805,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454208430084",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_2_0e426ba",
      "source": "WheelChair: Так, подожди, ты спрашивал, как у меня дела.",
      "target": "WheelChair: Na várj, azt kérdezted, hogy vagyok.",
      "authoredFile": "Translations/hu/dialogue-batch-340.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10806,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454208430083",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_2_051a1b5",
      "source": "WheelChair: Я так люблю гонять. А у тебя как-то возможности нет.",
      "target": "WheelChair: Annyira szeretek száguldozni. Nálad viszont nincs rá lehetőség.",
      "authoredFile": "Translations/hu/dialogue-batch-340.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10807,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454208430082",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_2_0dfec44",
      "source": "WheelChair: Как было бы угарно скатиться на коляске сейчас. После, конечно, въехать в стену. Но это фигня.",
      "target": "WheelChair: Mekkora buli lenne most legurulni a tolókocsival. Persze utána nekimennék a falnak. De sebaj.",
      "authoredFile": "Translations/hu/dialogue-batch-340.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10808,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454208430081",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_2_0f0da62",
      "source": "WheelChair: У тебя дом не под наклоном.",
      "target": "WheelChair: A házad nem lejtős.",
      "authoredFile": "Translations/hu/dialogue-batch-340.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10809,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454208430080",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_2_0688d21",
      "source": "WheelChair: Знаешь, я только об одном жалею…",
      "target": "WheelChair: Tudod, csak egy dolgot bánok…",
      "authoredFile": "Translations/hu/dialogue-batch-340.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10810,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454204235787",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_2_0702c7c",
      "source": "WheelChair: У тебя в доме хотя бы лестниц и порогов нет, я могу спокойно ездить.",
      "target": "WheelChair: Legalább a házadban nincsenek lépcsők és küszöbök, nyugodtan gurulhatok.",
      "authoredFile": "Translations/hu/dialogue-batch-340.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10811,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454204235786",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_2_0f98ee7",
      "source": "WheelChair: Бордюры эти ебучие, ещё и стоят криво.",
      "target": "WheelChair: Azok a kibaszott járdaszegélyek, még ferdék is.",
      "authoredFile": "Translations/hu/dialogue-batch-340.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10812,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454204235785",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_2_0d384ef",
      "source": "WheelChair: Как по лестницам передвигаться? А дорогу переходить?",
      "target": "WheelChair: Hogyan jutok fel a lépcsőkön? És hogyan kelek át az úton?",
      "authoredFile": "Translations/hu/dialogue-batch-340.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10813,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454204235784",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_2_01b76b8",
      "source": "WheelChair: ВОТ ИМЕННО! Ты даже из дома выйти бы не смог!",
      "target": "WheelChair: PONTOSAN! Még a házból sem tudnál kijutni!",
      "authoredFile": "Translations/hu/dialogue-batch-340.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10814,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454204235783",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_2_0b75b14",
      "source": "WheelChair: Короче, если бы у тебя ног не было.",
      "target": "WheelChair: Szóval, ha nem lennének lábaid.",
      "authoredFile": "Translations/hu/dialogue-batch-340.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10815,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454204235782",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_2_0cde9a3",
      "source": "WheelChair: Блять, я не про то…",
      "target": "WheelChair: Bazmeg, nem erre gondoltam…",
      "authoredFile": "Translations/hu/dialogue-batch-340.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10816,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454204235781",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_2_06b5aa8",
      "source": "WheelChair: Вот ты пробовал просто представить, как бы ты гулял, если бы был на колёсах?",
      "target": "WheelChair: Próbáltad már elképzelni, hogyan sétálnál, ha kerekeken gurulnál?",
      "authoredFile": "Translations/hu/dialogue-batch-340.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10817,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454204235780",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_2_023f6ba",
      "source": "WheelChair: А этого баланса нихуя в городе нет.",
      "target": "WheelChair: A városban meg kurvára nincs meg ez az egyensúly.",
      "authoredFile": "Translations/hu/dialogue-batch-340.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10818,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454204235779",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_2_0d80efb",
      "source": "WheelChair: Короче, тут баланс нужен.",
      "target": "WheelChair: Szóval itt egyensúly kell.",
      "authoredFile": "Translations/hu/dialogue-batch-340.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10819,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454204235778",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_2_0e7d7f5",
      "source": "WheelChair: Но и игнорировать мою инвалидность тупо. Ну, она существует, да.",
      "target": "WheelChair: De hülyeség úgy tenni, mintha nem lenne fogyatékosságom. Mert hát van.",
      "authoredFile": "Translations/hu/dialogue-batch-340.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10820,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454204235777",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_2_0d8c630",
      "source": "WheelChair: Хотя когда прям пялятся – тоже неприятно.",
      "target": "WheelChair: Bár az sem jó, ha valaki bámul.",
      "authoredFile": "Translations/hu/dialogue-batch-340.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10821,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454204235776",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_2_08d3b9e",
      "source": "WheelChair: Все начнут оправдываться, что просто посмотрели на ноги.",
      "target": "WheelChair: Mindenki mentegetőzni kezd, hogy csak a lábaimat nézte.",
      "authoredFile": "Translations/hu/dialogue-batch-340.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10822,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454200041483",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_2_0992218",
      "source": "WheelChair: Никто мне честно не ответит. Вот в чём беда.",
      "target": "WheelChair: Senki sem válaszol nekem őszintén. Ez a baj.",
      "authoredFile": "Translations/hu/dialogue-batch-340.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10823,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454200041482",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_2_0936188",
      "source": "WheelChair: Всё из-за того, что у меня вместо ног колёса великого ГОНЩИКА?",
      "target": "WheelChair: Talán azért, mert a lábaim helyén a nagy VERSENYZŐ kerekei vannak?",
      "authoredFile": "Translations/hu/dialogue-batch-340.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10824,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454200041481",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_2_04e2944",
      "source": "WheelChair: Мало кто спрашивает, как я себя чувствую или как прошёл мой день.",
      "target": "WheelChair: Kevesen kérdezik meg, hogy érzem magam, vagy milyen napom volt.",
      "authoredFile": "Translations/hu/dialogue-batch-340.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10825,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454200041480",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_2_077a0c7",
      "source": "WheelChair: Спасибо, знаешь, это очень приятно!",
      "target": "WheelChair: Köszönöm, tudod, ez nagyon jólesik!",
      "authoredFile": "Translations/hu/dialogue-batch-340.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10826,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454200041479",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_2_036c5ae",
      "source": "WheelChair: Ты просто спросил, как у меня дела?",
      "target": "WheelChair: Csak azt kérdezted, hogy vagyok?",
      "authoredFile": "Translations/hu/dialogue-batch-340.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10827,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454200041478",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_1_0500473",
      "source": "WheelChair: … Получилось неловко.",
      "target": "WheelChair: … Ez kínos lett.",
      "authoredFile": "Translations/hu/dialogue-batch-340.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10828,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454200041477",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_1_0d200a1",
      "source": "WheelChair: Я думал, ты сразу выкупил прикол.",
      "target": "WheelChair: Azt hittem, rögtön értetted a poént.",
      "authoredFile": "Translations/hu/dialogue-batch-340.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10829,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454200041476",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_1_01f5701",
      "source": "WheelChair: Ты не понял? Это шутка была.",
      "target": "WheelChair: Nem értetted? Csak vicc volt.",
      "authoredFile": "Translations/hu/dialogue-batch-340.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10830,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454200041475",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_028a202",
      "source": "Ну… хорошо",
      "target": "Hát… rendben",
      "authoredFile": "Translations/hu/dialogue-batch-340.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10831,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454200041474",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_0c2d451",
      "source": "Я про голоса в голове",
      "target": "A fejedben lévő hangokról beszélek",
      "authoredFile": "Translations/hu/dialogue-batch-341.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10832,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454200041473",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_03f0eb4",
      "source": "WheelChair: Так что я у тебя посижу маленько.",
      "target": "WheelChair: Szóval maradok itt nálad egy kicsit.",
      "authoredFile": "Translations/hu/dialogue-batch-341.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10833,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454200041472",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_04b1442",
      "source": "WheelChair: Уже вот правая начала понемногу расти.",
      "target": "WheelChair: A jobb lábam már lassan vissza is kezd nőni.",
      "authoredFile": "Translations/hu/dialogue-batch-341.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10834,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454195847179",
      "collection": "Dialogs",
      "key": "line:Wheelchair_Asking_2_01f45a7",
      "source": "WheelChair: Да. Я просто жду, когда отрастут ноги.",
      "target": "WheelChair: Igen. Csak várom, hogy visszanőjenek a lábaim.",
      "authoredFile": "Translations/hu/dialogue-batch-341.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10835,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454195847178",
      "collection": "Dialogs",
      "key": "line:talk_wheelchair_2_0bb4f61",
      "source": "Мне надо тебя проверить",
      "target": "Meg kell vizsgálnom téged",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 10836,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454195847177",
      "collection": "Dialogs",
      "key": "line:talk_wheelchair_2_0ef9ab6",
