    {
      "ordinal": 14065,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452593623050",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Armpit_Gun_03bd2a1",
      "source": "BigLebowski: ДАВАЙ, СДЕЛАЙ ЭТО!",
      "target": "BigLebowski: NA GYERÜNK, TEDD MEG!",
      "authoredFile": "Translations/hu/dialogue-batch-421.json",
