    },
    {
      "ordinal": 14059,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452597817349",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Photo_Gun_0a0e240",
      "source": "BigLebowski: Я уже достаточно видела тебя с оружием в руках.",
      "target": "BigLebowski: Eleget láttalak már fegyverrel a kezedben.",
      "authoredFile": "Translations/hu/dialogue-batch-421.json",
