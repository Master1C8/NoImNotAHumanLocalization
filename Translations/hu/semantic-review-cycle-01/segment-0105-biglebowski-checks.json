  "rows": [
    {
      "ordinal": 14028,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452610400258",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Death_011bfe5",
      "source": "BigLebowski: Спасибо тебе…",
      "target": "BigLebowski: Köszönöm neked…",
      "authoredFile": "Translations/hu/dialogue-batch-421.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14029,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452610400257",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Death_0d31891",
      "source": "BigLebowski: Хах, я думала, что я это сделаю с собой сама…",
      "target": "BigLebowski: Hah, azt hittem, magammal én végzek majd…",
      "authoredFile": "Translations/hu/dialogue-batch-421.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14030,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452610400256",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Ears_DontShoot_02cd283",
      "source": "BigLebowski: Ааааа, да похер…",
      "target": "BigLebowski: Ááá, leszarom…",
      "authoredFile": "Translations/hu/dialogue-batch-421.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14031,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452606205963",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Ears_DontShoot_04f7e4e",
      "source": "BigLebowski: Почему они принимают такое решение за них?..",
      "target": "BigLebowski: Miért döntenek erről helyettük?..",
      "authoredFile": "Translations/hu/dialogue-batch-421.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14032,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452606205962",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Ears_DontShoot_04398fc",
      "source": "BigLebowski: А вдруг им это не нужно?",
      "target": "BigLebowski: Mi van, ha nekik erre nincs szükségük?",
      "authoredFile": "Translations/hu/dialogue-batch-421.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14033,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452606205961",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Ears_DontShoot_0245061",
      "source": "BigLebowski: Не понимаю, зачем некоторые родоки прокалывают своим годовалым дочкам уши?",
      "target": "BigLebowski: Nem értem, egyes szülők miért lyukasztják ki az egyéves lányaik fülét?",
      "authoredFile": "Translations/hu/dialogue-batch-421.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14034,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452606205960",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Photo_DontShoot_0fee5ca",
      "source": "BigLebowski: Ах да, мне поставили эти дурацкие брекеты…",
      "target": "BigLebowski: Ja igen, rám rakták azt az idióta fogszabályzót…",
      "authoredFile": "Translations/hu/dialogue-batch-421.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14035,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452606205959",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Photo_DontShoot_0f7d719",
      "source": "BigLebowski: Интересно, что изменилось…",
      "target": "BigLebowski: Kíváncsi vagyok, mi változott…",
      "authoredFile": "Translations/hu/dialogue-batch-421.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14036,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452606205958",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Photo_DontShoot_0c39982",
      "source": "BigLebowski: У нас есть семейный альбом. Я часто смотрела на свои фотки до начала школы, и я там всегда так много улыбалась.",
      "target": "BigLebowski: Van egy családi albumunk. Gyakran néztem a képeimet az iskoláskorom előttről. Azokon mindig olyan sokat mosolyogtam.",
      "authoredFile": "Translations/hu/dialogue-batch-421.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14037,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452606205957",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Armpit_DontShoot_0490212",
      "source": "BigLebowski: Ещё одна такая выходка, и я уйду нахер.",
      "target": "BigLebowski: Még egy ilyen húzás, és elhúzok a faszba.",
      "authoredFile": "Translations/hu/dialogue-batch-421.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14038,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452606205956",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Armpit_DontShoot_0b83b6d",
      "source": "BigLebowski: Ты ебанутый.",
      "target": "BigLebowski: Te teljesen kattant vagy.",
      "authoredFile": "Translations/hu/dialogue-batch-421.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14039,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452606205955",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Eyes_DontShoot_0cbee9f",
      "source": "BigLebowski: Разве не насрать? Главное, что глаза видят…",
      "target": "BigLebowski: Nem tök mindegy? Az a lényeg, hogy mit látnak a szemek…",
      "authoredFile": "Translations/hu/dialogue-batch-421.json",
      "reviewResult": "proposed correction"
    },
    {
      "ordinal": 14040,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452606205954",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Eyes_DontShoot_0ad59cb",
      "source": "BigLebowski: О какой же глупости они вообще заботятся…",
      "target": "BigLebowski: Micsoda baromságon aggódnak egyáltalán…",
      "authoredFile": "Translations/hu/dialogue-batch-421.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14041,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452606205953",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Eyes_DontShoot_01b1fd5",
      "source": "BigLebowski: Знаешь, у меня в классе были девчонки, которые говорили, что в зависимости от их настроения меняется цвет их глаз.",
      "target": "BigLebowski: Tudod, voltak az osztályomban lányok, akik szerint a szemük színe a hangulatukkal együtt változik.",
      "authoredFile": "Translations/hu/dialogue-batch-421.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14042,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452606205952",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Hands_DontShoot_02802a3",
      "source": "BigLebowski: Я, пожалуй, пасану.",
      "target": "BigLebowski: Én inkább kihagyom.",
      "authoredFile": "Translations/hu/dialogue-batch-421.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14043,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452602011658",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Hands_DontShoot_0126296",
      "source": "BigLebowski: Ага, прикол, конечно…",
      "target": "BigLebowski: Ja, persze, remek vicc…",
      "authoredFile": "Translations/hu/dialogue-batch-421.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14044,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452602011657",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Hands_DontShoot_0c6ee7c",
      "source": "BigLebowski: …",
      "target": "BigLebowski: …",
      "authoredFile": "Translations/hu/dialogue-batch-040.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14045,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452602011656",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Hands_DontShoot_0450788",
      "source": "BigLebowski: Найти мужа, от которого родишь ребёночка!",
      "target": "BigLebowski: Férjet találni, akinek gyereket szülhetsz!",
      "authoredFile": "Translations/hu/dialogue-batch-421.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14046,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452602011655",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Hands_DontShoot_09ec4c7",
      "source": "BigLebowski: …",
      "target": "BigLebowski: …",
      "authoredFile": "Translations/hu/dialogue-batch-040.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14047,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452602011654",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Hands_DontShoot_09a4d3a",
      "source": "BigLebowski: Ведь самое главное в жизни, знаешь, что?",
      "target": "BigLebowski: Hiszen tudod, mi a legfontosabb az életben?",
      "authoredFile": "Translations/hu/dialogue-batch-421.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14048,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452602011653",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Hands_DontShoot_0c1f247",
      "source": "BigLebowski: Короче, пофиг…",
      "target": "BigLebowski: Na mindegy, leszarom…",
      "authoredFile": "Translations/hu/dialogue-batch-421.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14049,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452602011652",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Hands_DontShoot_094e74c",
      "source": "BigLebowski: А я что могу сделать, если у меня аллергия? Типа, я контролирую это высыпание на коже…",
      "target": "BigLebowski: És én mit tehetnék róla, hogy allergiás vagyok? Mintha irányítani tudnám a kiütéseket a bőrömön…",
      "authoredFile": "Translations/hu/dialogue-batch-421.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14050,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452602011651",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Hands_DontShoot_01d66f6",
      "source": "BigLebowski: Меня мама всегда ругала за руки. Говорила, что нужно быть больше похожей на девочку.",
      "target": "BigLebowski: Anyám mindig leszidott a kezeim miatt. Azt mondta, jobban kellene hasonlítanom egy lányra.",
      "authoredFile": "Translations/hu/dialogue-batch-421.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14051,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452602011650",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Teeth_DontShoot_0f0e5e8",
      "source": "Надоело уже…",
      "target": "Már elegem van belőle…",
      "authoredFile": "Translations/hu/dialogue-batch-421.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14052,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452602011649",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Teeth_DontShoot_0997501",
      "source": "BigLebowski: В следующий раз стреляй сразу. Я не буду тебя молить о пощаде. Мне как-то похер.",
      "target": "BigLebowski: Legközelebb rögtön lőj. Nem fogok kegyelemért könyörögni. Leszarom.",
      "authoredFile": "Translations/hu/dialogue-batch-421.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14053,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452602011648",
      "collection": "Dialogs",
