      "collection": "Dialogs",
      "key": "line:BigLebowski_Photo_Gun_061c548",
      "source": "BigLebowski: Как-то похрен.",
      "target": "BigLebowski: Valahogy leszarom.",
      "authoredFile": "Translations/hu/dialogue-batch-421.json",
