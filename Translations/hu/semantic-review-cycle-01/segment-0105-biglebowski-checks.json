    },
    {
      "ordinal": 14066,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452593623049",
      "collection": "Dialogs",
      "key": "line:BigLebowski_Armpit_Gun_04669a3",
      "source": "BigLebowski: Знаешь, да похер! Стреляй! Я уже так устала от этого всего вокруг!",
      "target": "BigLebowski: Tudod mit, leszarom! Lőj! Már kurvára elegem van mindenből, ami körülöttünk zajlik!",
