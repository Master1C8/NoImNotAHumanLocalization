      "collection": "Dialogs",
      "key": "line:Buddy_Ears_0ac6626",
      "source": "Buddy: Вот они, уши как уши.",
      "target": "Buddy: Itt vannak, fülek, mint a többi.",
      "authoredFile": "Translations/hu/dialogue-batch-437.json",
