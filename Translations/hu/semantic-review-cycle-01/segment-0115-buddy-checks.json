    },
    {
      "ordinal": 14750,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452337770498",
      "collection": "Dialogs",
      "key": "line:Buddy_Hands_0422f3f",
      "source": "Buddy: А я ими бутылки открываю. Вот тебе и жизнь.",
      "target": "Buddy: Én meg üvegeket nyitok velük. Ilyen az élet.",
      "authoredFile": "Translations/hu/dialogue-batch-437.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14751,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452337770497",
      "collection": "Dialogs",
      "key": "line:Buddy_Hands_0a39fe3",
      "source": "Buddy: А я ими бутылки открываю да бью вещи от отчаяния. Вот тебе и жизнь.",
      "target": "Buddy: Én meg üvegeket nyitok velük, és kétségbeesésemben tárgyakat török össze. Ilyen az élet.",
      "authoredFile": "Translations/hu/dialogue-batch-437.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14752,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452337770496",
      "collection": "Dialogs",
      "key": "line:Buddy_Hands_0a4548f",
      "source": "Buddy: Большие, да? Такие руки хлеб месить должны или дом строить…",
      "target": "Buddy: Nagyok, mi? Ilyen kezekkel kenyeret kéne dagasztani vagy házat építeni…",
      "authoredFile": "Translations/hu/dialogue-batch-437.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14753,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452333576202",
      "collection": "Dialogs",
      "key": "line:Buddy_Hands_0713bea",
      "source": "Buddy: ...",
      "target": "Buddy: ...",
