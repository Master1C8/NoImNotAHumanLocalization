    },
    {
      "ordinal": 14735,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452341964805",
      "collection": "Dialogs",
      "key": "line:Buddy_Photo_007a820",
      "source": "Buddy: У меня очень мало фоток было. Как-то не выходило.",
      "target": "Buddy: Nagyon kevés fényképem volt. Valahogy sosem jött össze.",
      "authoredFile": "Translations/hu/dialogue-batch-437.json",
      "reviewResult": "pass"
    },
    {
