      "collection": "Dialogs",
      "key": "line:Buddy_Photo_066ef22",
      "source": "Buddy: А, ну фоткай, раз надо.",
      "target": "Buddy: Ja, hát fényképezz le, ha kell.",
      "authoredFile": "Translations/hu/dialogue-batch-437.json",
      "reviewResult": "pass"
    },
    {
