    },
    {
      "ordinal": 14747,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452337770501",
      "collection": "Dialogs",
      "key": "line:Buddy_Eyes_018de8d",
      "source": "Buddy: Да смотри, смотри.",
      "target": "Buddy: Nézd csak, nézd.",
      "authoredFile": "Translations/hu/dialogue-batch-437.json",
      "reviewResult": "pass"
    },
    {
