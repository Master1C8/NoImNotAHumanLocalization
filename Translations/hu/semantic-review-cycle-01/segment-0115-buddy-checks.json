  "rows": [
    {
      "ordinal": 14689,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452358742024",
      "collection": "Dialogs",
      "key": "line:Buddy_Death_0f1360b",
      "source": "Buddy: Эх, корешок…",
      "target": "Buddy: Ehh, haver…",
      "authoredFile": "Translations/hu/dialogue-batch-436.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14690,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452358742023",
      "collection": "Dialogs",
      "key": "line:Buddy_Death_082548b",
      "source": "Buddy: Значит, вот так.",
      "target": "Buddy: Szóval így állunk.",
      "authoredFile": "Translations/hu/dialogue-batch-436.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14691,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452358742022",
      "collection": "Dialogs",
      "key": "line:Buddy_Ears_DontShoot_029cc79",
      "source": "Buddy: Я тогда подумал: «Вот бы и со мной так… Если испугаюсь, то был бы уверен, что меня обнимут, не бросят».",
      "target": "Buddy: Akkor arra gondoltam: „Bárcsak engem is így ölelnének át… Ha megijednék, biztos lehetnék benne, hogy átölelnek, nem hagynak magamra.”",
      "authoredFile": "Translations/hu/dialogue-batch-436.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14692,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452358742021",
      "collection": "Dialogs",
      "key": "line:Buddy_Ears_DontShoot_0d19340",
      "source": "Buddy: Ну, я обнял её. Успокаивал.",
      "target": "Buddy: Úgyhogy átöleltem. Nyugtattam.",
      "authoredFile": "Translations/hu/dialogue-batch-436.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14693,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452358742020",
      "collection": "Dialogs",
      "key": "line:Buddy_Ears_DontShoot_0133b6a",
      "source": "Buddy: Как-то рядом с нами гремели фейерверки. А собачка моя начала трястись, жаться к полу и ко мне поближе. Страшно бедняжке стало.",
      "target": "Buddy: Egyszer tűzijáték durrogott a közelünkben. A kutyusom remegni kezdett, a földhöz lapult, és hozzám húzódott. Szegényke nagyon megijedt.",
      "authoredFile": "Translations/hu/dialogue-batch-436.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14694,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452358742019",
      "collection": "Dialogs",
      "key": "line:Buddy_Photo_DontShoot_08335e5",
      "source": "Buddy: А себя? Нет, я не люблю. Особенно, когда в школе общую фотку делали. Каждый год все наряжаются так, как не наряжаются обычно. Эхх…",
      "target": "Buddy: Magamat? Nem, azt nem szeretem. Főleg amikor az iskolában osztályképet csináltak. Minden évben mindenki úgy kiöltözött, ahogy máskor soha. Ehh…",
      "authoredFile": "Translations/hu/dialogue-batch-436.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14695,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452358742018",
      "collection": "Dialogs",
      "key": "line:Buddy_Photo_DontShoot_0cf3fad",
      "source": "Buddy: Я вот собаку свою фотографировал часто. Всё не мог ей налюбоваться. Хотелось делиться с другими, показывать её.",
      "target": "Buddy: A kutyámat viszont gyakran fényképeztem. Nem tudtam betelni vele. Meg akartam osztani másokkal, megmutatni nekik.",
      "authoredFile": "Translations/hu/dialogue-batch-436.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14696,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452358742017",
      "collection": "Dialogs",
      "key": "line:Buddy_Armpit_DontShoot_03069c6",
      "source": "Buddy: Странно, да? Она ушла, а я до сих пор ношу на себе её следы, так сказать…",
      "target": "Buddy: Furcsa, mi? Ő már nincs itt, én meg még mindig magamon hordom a nyomait, hogy úgy mondjam…",
      "authoredFile": "Translations/hu/dialogue-batch-436.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14697,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452358742016",
      "collection": "Dialogs",
      "key": "line:Buddy_Armpit_DontShoot_085149d",
      "source": "Buddy: Думал, может, согрею её, может, легче будет… Ну и вот, видимо, грибок на память оставила.",
      "target": "Buddy: Azt hittem, talán felmelegíthetem, és könnyebb lesz neki… Hát úgy tűnik, emlékül egy gombás fertőzést hagyott rám.",
      "authoredFile": "Translations/hu/dialogue-batch-436.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14698,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452354547720",
      "collection": "Dialogs",
      "key": "line:Buddy_Armpit_DontShoot_0e19a9c",
      "source": "Buddy: Я в последнюю ночь не отходил от неё.",
      "target": "Buddy: Az utolsó éjszakán egy percre sem mozdultam mellőle.",
      "authoredFile": "Translations/hu/dialogue-batch-436.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14699,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452354547719",
      "collection": "Dialogs",
      "key": "line:Buddy_Eyes_DontShoot_04f8038",
      "source": "Buddy: А теперь вспоминаю этот момент и понимаю, что она была права. Только ей этого уже не скажешь.",
      "target": "Buddy: Most felidézem azt a pillanatot, és értem, hogy igaza volt. Csakhogy ezt már nem mondhatom el neki.",
      "authoredFile": "Translations/hu/dialogue-batch-436.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14700,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452354547718",
      "collection": "Dialogs",
      "key": "line:Buddy_Eyes_DontShoot_081a7cc",
      "source": "Buddy: Я тогда не понял, что это значит.",
      "target": "Buddy: Akkor nem értettem, mit jelent.",
      "authoredFile": "Translations/hu/dialogue-batch-436.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14701,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452354547717",
      "collection": "Dialogs",
      "key": "line:Buddy_Eyes_DontShoot_0671f46",
      "source": "Buddy: Бабушка мне как-то говорила: «Ты когда на меня так смотришь, будто уже прощаешься».",
      "target": "Buddy: A nagymamám egyszer azt mondta: „Amikor így nézel rám, olyan, mintha már búcsúznál tőlem.”",
      "authoredFile": "Translations/hu/dialogue-batch-436.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14702,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452354547716",
      "collection": "Dialogs",
      "key": "line:Buddy_Hands_DontShoot_07e8daf",
      "source": "Buddy: Как же я скучаю по ней, ты бы знал, корешок…",
      "target": "Buddy: Ha tudnád, mennyire hiányzik, haver…",
      "authoredFile": "Translations/hu/dialogue-batch-436.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14703,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452354547715",
      "collection": "Dialogs",
      "key": "line:Buddy_Hands_DontShoot_0a7c0e7",
      "source": "Buddy: Этими руками я когда-то держал собаку, когда она ещё живая была. Гладил её, а у неё была такая мягкая шерсть!",
      "target": "Buddy: Valaha ezekkel a kezekkel tartottam a kutyámat, amikor még élt. Simogattam, olyan puha volt a bundája!",
      "authoredFile": "Translations/hu/dialogue-batch-436.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14704,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452354547714",
      "collection": "Dialogs",
      "key": "line:Buddy_Teeth_DontShoot_0c96482",
      "source": "Buddy: Я ведь даже не дрался, просто хохотнул не вовремя.",
      "target": "Buddy: Nem is verekedtem, csak rosszkor nevettem fel.",
      "authoredFile": "Translations/hu/dialogue-batch-436.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14705,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452354547713",
      "collection": "Dialogs",
      "key": "line:Buddy_Teeth_DontShoot_0f36f8d",
      "source": "Buddy: А потом… Ха, потом их выбили той же ночью. Чисто за улыбку. Смешно, да?",
      "target": "Buddy: Aztán… Ha, még aznap éjjel kiverték őket. Csak mert mosolyogtam. Vicces, mi?",
      "authoredFile": "Translations/hu/dialogue-batch-436.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14706,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452354547712",
      "collection": "Dialogs",
      "key": "line:Buddy_Teeth_DontShoot_0667b4d",
      "source": "Buddy: Мне один стоматолог сказал, что с такими зубами можно в рекламе сниматься.",
      "target": "Buddy: Egy fogorvos egyszer azt mondta, ilyen fogakkal reklámban szerepelhetnék.",
      "authoredFile": "Translations/hu/dialogue-batch-436.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14707,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452350353418",
      "collection": "Dialogs",
      "key": "line:Buddy_Ears_Gun_0abfd65",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14708,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452350353417",
      "collection": "Dialogs",
      "key": "line:Buddy_Ears_Gun_06db6f4",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14709,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452350353416",
      "collection": "Dialogs",
      "key": "line:Buddy_Ears_Gun_06955bd",
      "source": "Buddy: Шутишь, что ли, корешок?",
      "target": "Buddy: Csak viccelsz, ugye, haver?",
      "authoredFile": "Translations/hu/dialogue-batch-437.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14710,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452350353415",
      "collection": "Dialogs",
      "key": "line:Buddy_Photo_Gun_0c571fb",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14711,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452350353414",
      "collection": "Dialogs",
      "key": "line:Buddy_Photo_Gun_06b3699",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14712,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452350353413",
      "collection": "Dialogs",
      "key": "line:Buddy_Photo_Gun_0409b99",
      "source": "Buddy: Да ты чего? Покажь хотя бы, что там получилось. Неужели так страшно?",
      "target": "Buddy: Mi van veled? Legalább mutasd meg, milyen lett a kép. Tényleg olyan rémes?",
      "authoredFile": "Translations/hu/dialogue-batch-437.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14713,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452350353412",
      "collection": "Dialogs",
      "key": "line:Buddy_Armpit_Gun_0952f2e",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14714,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452350353411",
      "collection": "Dialogs",
      "key": "line:Buddy_Armpit_Gun_03c4cc3",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14715,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452350353410",
      "collection": "Dialogs",
      "key": "line:Buddy_Armpit_Gun_01de03a",
      "source": "Buddy: Да я б пошёл с этим грибком по врачам, но а смысл-то? Особенно теперь…",
      "target": "Buddy: Elmennék ezzel a gombával orvoshoz, de mi értelme? Főleg most…",
      "authoredFile": "Translations/hu/dialogue-batch-437.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14716,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452350353409",
      "collection": "Dialogs",
      "key": "line:Buddy_Eyes_Gun_0b46933",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14717,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452350353408",
      "collection": "Dialogs",
      "key": "line:Buddy_Eyes_Gun_0f6ca9e",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14718,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452346159115",
      "collection": "Dialogs",
      "key": "line:Buddy_Eyes_Gun_01b0f84",
      "source": "Buddy: Хотелось бы в последний момент на что-то красивое посмотреть.",
      "target": "Buddy: Jó lenne az utolsó pillanatban valami szépet látni.",
      "authoredFile": "Translations/hu/dialogue-batch-437.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14719,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452346159114",
      "collection": "Dialogs",
      "key": "line:Buddy_Eyes_Gun_020569b",
      "source": "Buddy: Только в глаз не стреляй, ладно? Хех…",
      "target": "Buddy: Csak a szemembe ne lőj, jó? Heh…",
      "authoredFile": "Translations/hu/dialogue-batch-437.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14720,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452346159113",
      "collection": "Dialogs",
      "key": "line:Buddy_Eyes_Gun_0a6f054",
      "source": "Buddy: Что ж, за это сразу стрелять? Я просто слабый человек…",
      "target": "Buddy: Miért kell ezért rögtön lőni? Csak gyenge ember vagyok…",
      "authoredFile": "Translations/hu/dialogue-batch-437.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14721,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452346159112",
      "collection": "Dialogs",
      "key": "line:Buddy_Eyes_Gun_0162b73",
      "source": "Buddy: Да ты чего, корешок? Ты ж пойми, тяжело, когда у тебя любимое существо отбирают. Ну, не сдерживаюсь, могу всплакнуть.",
      "target": "Buddy: Mi van veled, haver? Értsd meg, nehéz, ha elvesznek tőled valakit, akit szeretsz. Néha nem bírom visszatartani a könnyeimet.",
      "authoredFile": "Translations/hu/dialogue-batch-437.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14722,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452346159111",
      "collection": "Dialogs",
      "key": "line:Buddy_Hands_Gun_01b5a82",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14723,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452346159110",
      "collection": "Dialogs",
      "key": "line:Buddy_Hands_Gun_052d7d5",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14724,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452346159109",
      "collection": "Dialogs",
      "key": "line:Buddy_Hands_Gun_05caff7",
      "source": "Buddy: Ну, давай, корешок. Я хочу верить, что после смерти что-то есть, и мы где-то там увидимся с моей собачкой…",
      "target": "Buddy: Hát rajta, haver. Szeretném hinni, hogy van valami a halál után, és valahol ott újra találkozom a kutyusommal…",
      "authoredFile": "Translations/hu/dialogue-batch-437.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14725,
