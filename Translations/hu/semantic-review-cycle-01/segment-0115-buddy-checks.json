      "reviewResult": "pass"
    },
    {
      "ordinal": 14742,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452337770506",
      "collection": "Dialogs",
      "key": "line:Buddy_Armpit_0e6e420",
      "source": "Buddy: Фу, корешок, ты уверен? Ну ладно.",
      "target": "Buddy: Fúj, haver, biztos ezt akarod? Na jó.",
      "authoredFile": "Translations/hu/dialogue-batch-437.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14743,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452337770505",
