    {
      "ordinal": 14740,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452341964800",
      "collection": "Dialogs",
      "key": "line:Buddy_Armpit_0240b62",
      "source": "Buddy: Нечего тут смотреть, честное слово. Толстые, волосатые, да ещё и с грибком каким-то. Наверное, подцепил, когда с собакой ночевал на полу.",
      "target": "Buddy: Itt nincs mit nézni, komolyan. Vastag, szőrös hónaljak, ráadásul valami gombával. Biztos akkor szedtem össze, amikor a kutyámmal aludtam a földön.",
      "authoredFile": "Translations/hu/dialogue-batch-437.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14741,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452337770507",
      "collection": "Dialogs",
      "key": "line:Buddy_Armpit_0f1af7a",
