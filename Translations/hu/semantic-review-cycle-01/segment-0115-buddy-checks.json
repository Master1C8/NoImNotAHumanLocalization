    },
    {
      "ordinal": 14757,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452333576198",
      "collection": "Dialogs",
      "key": "line:Buddy_Teeth_05002c1",
      "source": "Buddy: Жизнь – она, знаешь, бывает немилостива.",
      "target": "Buddy: Az élet, tudod, néha kegyetlen.",
      "authoredFile": "Translations/hu/dialogue-batch-437.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14758,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452333576197",
      "collection": "Dialogs",
      "key": "line:Buddy_Teeth_00d1f59",
      "source": "Buddy: Ну, скажем так, из этой половины часть потеряла хоть сколько-нибудь приличный вид.",
      "target": "Buddy: Mondjuk úgy, hogy ennek a felének egy része elvesztette minden valamirevaló külsejét.",
      "authoredFile": "Translations/hu/dialogue-batch-437.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14759,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452333576196",
      "collection": "Dialogs",
      "key": "line:Buddy_Teeth_0317ac3",
      "source": "Buddy: Видишь? Половина – как с картинки, беленькие такие. Остальные…",
      "target": "Buddy: Látod? A fele mintha képről lenne: szép fehér. A többi…",
      "authoredFile": "Translations/hu/dialogue-batch-437.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14760,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452333576195",
