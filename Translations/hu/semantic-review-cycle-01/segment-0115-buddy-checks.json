    {
      "ordinal": 14745,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452337770503",
      "collection": "Dialogs",
      "key": "line:Buddy_Eyes_02f0ee9",
      "source": "Buddy: Обычные, карие. Как у половины мира. Никакого секрета.",
      "target": "Buddy: Átlagos barna szemek. Mint a fél világnak. Semmi titok.",
      "authoredFile": "Translations/hu/dialogue-batch-437.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 14746,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452337770502",
      "collection": "Dialogs",
      "key": "line:Buddy_Eyes_050d3ee",
      "source": "Buddy: ...",
      "target": "Buddy: ...",
      "authoredFile": "Translations/hu/dialogue-batch-040.json",
