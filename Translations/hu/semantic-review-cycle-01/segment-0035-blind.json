  "rows": [
    {
      "ordinal": 8961,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454875324429",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_5_020d55c",
      "source": "Blind: Я… оставь меня.",
      "target": "Blind: Én… hagyj békén.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8962,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454875324428",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_5_01b135a",
      "source": "Blind: Да неважно. Это конец.",
      "target": "Blind: Nem számít. Ez a vég.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8963,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454875324427",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_5_0defde7",
      "source": "Blind: Солнце сожжёт нас.",
      "target": "Blind: A Nap eléget minket.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8964,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454875324426",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_5_0e1272b",
      "source": "Blind: Оно нас разорвёт. Во сне или наяву.",
      "target": "Blind: Széttép minket. Akár alszunk, akár ébren vagyunk.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8965,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454875324425",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_5_0a3b328",
      "source": "Blind: Мы умрём.",
      "target": "Blind: Meg fogunk halni.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8966,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454875324424",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_5_094c7fb",
      "source": "Blind: Я понял.",
      "target": "Blind: Megértettem.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8967,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454875324423",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_5_07379b3",
      "source": "Blind: Не хочу говорить об этом.",
      "target": "Blind: Nem akarok erről beszélni.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8968,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454875324422",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_5_04159dd",
      "source": "Blind: Да.",
      "target": "Blind: Igen.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8969,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454875324421",
      "collection": "Dialogs",
      "key": "line:talk_blind_5_03b9fda",
      "source": "Мне надо тебя проверить",
      "target": "Meg kell vizsgálnom téged",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8970,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454875324420",
      "collection": "Dialogs",
      "key": "line:talk_blind_5_0af8948",
      "source": "Снилось сегодня что-то?",
      "target": "Álmodtál ma valamit?",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8971,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454875324419",
      "collection": "Dialogs",
      "key": "line:talk_blind_5_0837eb2",
      "source": "Blind: Как темно…",
      "target": "Blind: Milyen sötét van…",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8972,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454875324418",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_4_085da25",
      "source": "Blind: Может, это побочка от обезболивающего?",
      "target": "Blind: Talán a fájdalomcsillapító mellékhatása?",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8973,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454875324417",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_4_0e9e648",
      "source": "Blind: А ко мне тянется это существо, перевешиваясь через забор.",
      "target": "Blind: Az a lény pedig a kerítés fölé hajolva felém nyúl.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8974,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454875324416",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_4_06441d7",
      "source": "Blind: Поднимаю голову.",
      "target": "Blind: Felemelem a fejem.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8975,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454871130123",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_4_05a3b31",
      "source": "Blind: Замираю. Не слышно ни единого звука.",
      "target": "Blind: Megdermedek. Egyetlen hang sem hallatszik.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8976,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454871130122",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_4_071a04a",
      "source": "Blind: Тогда я забегаю за угол дома и прыгаю снова через забор.",
      "target": "Blind: Ekkor a ház sarka mögé futok, és újra átugrom a kerítést.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8977,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454871130121",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_4_085a102",
      "source": "Blind: Копошусь в кармане, ключи просто постоянно скользят по пальцам, не могу их достать.",
      "target": "Blind: A zsebemben matatva próbálom elővenni a kulcsokat, de folyton kicsúsznak az ujjaim közül.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8978,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454871130120",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_4_0c005e0",
      "source": "Blind: Прибегаю к своему дому, но понимаю, что не успеваю открыть калитку. Прыгаю через забор.",
      "target": "Blind: Hazaérek, de rájövök, hogy nem tudom időben kinyitni a kiskaput. Átugrom a kerítést.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8979,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454871130119",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_4_0c4a261",
      "source": "Blind: Пытаюсь убежать, но чувствую, как оно приближается.",
      "target": "Blind: Próbálok elfutni, de érzem, hogy közeledik.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8980,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454871130118",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_4_080d665",
      "source": "Blind: В этот раз я чётко вижу, его движения.",
      "target": "Blind: Ezúttal tisztán látom a mozdulatait.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8981,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454871130117",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_4_09dcc75",
      "source": "Blind: Оборачиваюсь и вижу, как оно ко мне медленно бежит.",
      "target": "Blind: Hátrafordulok, és látom, hogy lassan fut felém.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8982,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454871130116",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_4_0b62b0c",
      "source": "Blind: Иду по асфальтовой дороге. Ночь. Только фонари кое-как светят.",
      "target": "Blind: Egy aszfaltúton sétálok. Éjszaka van. Csak az utcai lámpák pislákolnak.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8983,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454871130115",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_4_0069252",
      "source": "Blind: Знаешь, я видел сон. Оно опять приходило.",
      "target": "Blind: Tudod, álmodtam valamit. Az a lény megint eljött.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8984,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454871130114",
      "collection": "Dialogs",
      "key": "line:talk_blind_4_09a8f8f",
      "source": "Мне надо тебя проверить",
      "target": "Meg kell vizsgálnom téged",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8985,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454871130113",
      "collection": "Dialogs",
      "key": "line:talk_blind_4_000f0e4",
      "source": "У тебя всё хорошо?",
      "target": "Minden rendben veled?",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8986,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454871130112",
      "collection": "Dialogs",
      "key": "line:talk_blind_4_07378b3",
      "source": "Blind: Как темно…",
      "target": "Blind: Milyen sötét van…",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8987,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454866935818",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_3_02630d7",
      "source": "Blind: Так и проснулся.",
      "target": "Blind: Ekkor felébredtem.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8988,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454866935817",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_3_0f01222",
      "source": "Blind: Пытаюсь догнать трамвай, но всё никак не могу даже приблизиться. И никогда больше я не доберусь туда, где скрыта правда о невидимом ужасе.",
      "target": "Blind: Próbálom utolérni a villamost, de még csak közelebb sem jutok hozzá. És soha többé nem érek el oda, ahol a láthatatlan borzalomról szóló igazság rejtőzik.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8989,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454866935816",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_3_06194c6",
      "source": "Blind: Оно быстро вокруг человека носится, я не могу его разглядеть. Но точно знаю, кто это.",
      "target": "Blind: Valami gyorsan cikázik az ember körül, nem tudom kivenni. De pontosan tudom, ki az.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8990,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454866935815",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_3_04579af",
      "source": "Blind: Оборачиваюсь и вижу, что человека что-то поймало.",
      "target": "Blind: Hátrafordulok, és látom, hogy valami elkapta azt az embert.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8991,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454866935814",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_3_07156b5",
      "source": "Blind: Понимаю, что по рельсам едет трамвай, отхожу в сторону.",
      "target": "Blind: Rájövök, hogy villamos jön a síneken, ezért félreállok.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8992,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454866935813",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_3_0594940",
      "source": "Blind: Я иду по рельсам трамвая домой. Вокруг частные дома, много деревьев.",
      "target": "Blind: A villamossíneken megyek hazafelé. Körülöttem családi házak és sok fa.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8993,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454866935812",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_3_0b206db",
      "source": "Blind: Мне снился сон этой ночью.",
      "target": "Blind: Ma éjjel álmodtam valamit.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8994,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454866935811",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_3_04a58c8",
      "source": "Blind: Это потому что я не могу найти расчёску? Ахах.",
      "target": "Blind: Mert nem találom a fésűmet? Haha.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8995,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454866935810",
      "collection": "Dialogs",
      "key": "line:talk_blind_3_00b1bed",
      "source": "Мне надо тебя проверить",
      "target": "Meg kell vizsgálnom téged",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8996,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454866935809",
      "collection": "Dialogs",
      "key": "line:talk_blind_3_0acd6e6",
      "source": "Выглядишь помято",
      "target": "Elég nyúzottnak tűnsz.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8997,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454866935808",
      "collection": "Dialogs",
      "key": "line:talk_blind_3_035be9b",
      "source": "Blind: Как темно…",
      "target": "Blind: Milyen sötét van…",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8998,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454862741515",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_2_078937b",
      "source": "Blind: Правда, меня пугает осознание. Что я видел, останется со мной до конца времён…",
      "target": "Blind: De megrémít a felismerés, hogy amit láttam, örökre velem marad…",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 8999,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454862741514",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_2_080ee04",
      "source": "Blind: В общем, я привыкну, но больше не увижу этот ужас.",
      "target": "Blind: Végül megszokom majd, de azt a borzalmat többé nem kell látnom.",
      "authoredFile": "Translations/hu/dialogue-batch-290.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 9000,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454862741513",
      "collection": "Dialogs",
      "key": "line:Blind_Asking_2_09fb14c",
      "source": "Blind: Я не знаю, как выглядит твой дом, сложновато ориентироваться. Да ещё глазницы болели бы, если бы не обезболивающее…",
      "target": "Blind: Nem tudom, hogy néz ki a házad, nehéz tájékozódnom. Ráadásul a szemgödreim is fájnának, ha nem lenne fájdalomcsillapító…",
