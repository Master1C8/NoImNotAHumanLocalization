    {
      "ordinal": 9288,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454757883908",
      "collection": "Dialogs",
      "key": "line:Bestson_Asking_4_1_1_05df4aa",
      "source": "Bestson: Но я взял заначку родителей. Может, её хватит, чтобы оплатить поездку к сестре.",
      "target": "Bestson: De elhoztam a szüleim félretett pénzét. Talán elég lesz a taxira a lánytestvéremhez.",
      "authoredFile": "Translations/hu/dialogue-batch-298.json",
      "reviewResult": "pass"
    },
    {
