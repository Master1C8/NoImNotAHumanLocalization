      "collection": "Dialogs",
      "key": "line:Bestson_Asking_4_1_0e76304",
      "source": "Bestson: Я никогда так далеко не уезжал без родителей.",
      "target": "Bestson: Még soha nem utaztam ilyen messzire a szüleim nélkül.",
      "authoredFile": "Translations/hu/dialogue-batch-298.json",
