      "key": "line:Bestson_Asking_4_2_1_0c7aef7",
      "source": "Bestson: Может… может, я правда найду их там.",
      "target": "Bestson: Talán… talán tényleg megtalálom őket ott.",
      "authoredFile": "Translations/hu/dialogue-batch-298.json",
