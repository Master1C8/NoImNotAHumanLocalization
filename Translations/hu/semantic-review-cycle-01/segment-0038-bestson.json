    },
    {
      "ordinal": 9332,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504454741106696",
      "collection": "Dialogs",
      "key": "line:talk_bestson_3_01fb214",
      "source": "Мне нужно тебя проверить",
      "target": "Meg kell vizsgálnom téged",
      "authoredFile": "Translations/hu/dialogue-batch-003.json",
