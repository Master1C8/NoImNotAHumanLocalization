      "collection": "Dialogs",
      "key": "line:Sirin_Hands_Gun_0c845dd",
      "source": "Sirin: Смерть всё равно уже рядом.",
      "target": "Sirin: A halál már úgyis közel van.",
      "authoredFile": "Translations/hu/dialogue-batch-449.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15372,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452111278087",
      "collection": "Dialogs",
      "key": "line:Sirin_Hands_Gun_05b0e08",
      "source": "Sirin: Не надо этого.",
      "target": "Sirin: Ne tedd ezt.",
      "authoredFile": "Translations/hu/dialogue-batch-449.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15373,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452111278086",
