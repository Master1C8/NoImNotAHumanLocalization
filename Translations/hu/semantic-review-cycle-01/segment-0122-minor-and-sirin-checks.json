      "collection": "Dialogs",
      "key": "line:Sirin_Death_0301f09",
      "source": "Sirin: Но она предназначалась тебе!",
      "target": "Sirin: Pedig neked volt szánva!",
      "authoredFile": "Translations/hu/dialogue-batch-449.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15342,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452123860994",
      "collection": "Dialogs",
      "key": "line:Sirin_Death_0e6f553",
      "source": "Sirin: Моя песнь.",
      "target": "Sirin: Az én dalom.",
      "authoredFile": "Translations/hu/dialogue-batch-449.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15343,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452123860993",
      "collection": "Dialogs",
      "key": "line:Sirin_Armpit_DontShoot_0f5b4c7",
      "source": "Sirin: Я дождусь своего часа, значит.",
      "target": "Sirin: Akkor kivárom az én időmet.",
      "authoredFile": "Translations/hu/dialogue-batch-449.json",
      "reviewResult": "pass"
    },
    {
