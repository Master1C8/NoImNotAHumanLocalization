      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452111278090",
      "collection": "Dialogs",
      "key": "line:Sirin_Hands_Gun_0205f0f",
      "source": "Sirin: Дай ружьё.",
      "target": "Sirin: Add ide a puskát.",
      "authoredFile": "Translations/hu/dialogue-batch-449.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 15370,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504452111278089",
      "collection": "Dialogs",
      "key": "line:Sirin_Hands_Gun_07fbf63",
      "source": "Sirin: Ты можешь просто оставить это мне.",
      "target": "Sirin: Ezt egyszerűen rám bízhatod.",
