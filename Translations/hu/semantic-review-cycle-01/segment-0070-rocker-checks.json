    },
    {
      "ordinal": 11803,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453847719940",
      "collection": "Dialogs",
      "key": "line:Rocker_Photo_Gun_020d5eb",
      "source": "Rocker: А, это без крышки.",
      "target": "Rocker: Á, ez már az objektívsapka nélkül készült.",
      "authoredFile": "Translations/hu/dialogue-batch-364.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11804,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453847719939",
      "collection": "Dialogs",
      "key": "line:Rocker_Armpit_Gun_026cef9",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11805,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453847719938",
      "collection": "Dialogs",
      "key": "line:Rocker_Armpit_Gun_01f7f65",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11806,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453847719937",
      "collection": "Dialogs",
      "key": "line:Rocker_Armpit_Gun_0976c26",
      "source": "Rocker: Вот это тебя впечатлило.",
      "target": "Rocker: Na, ez aztán lenyűgözött téged.",
      "authoredFile": "Translations/hu/dialogue-batch-364.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11807,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453847719936",
      "collection": "Dialogs",
      "key": "line:Rocker_Armpit_Gun_01514f5",
      "source": "Rocker: Я не хочу вонять. И это причина для стрельбы?",
      "target": "Rocker: Nem akarok bűzleni. Ezért már lelőnél?",
      "authoredFile": "Translations/hu/dialogue-batch-364.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11808,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453843525642",
