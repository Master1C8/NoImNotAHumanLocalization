      "collection": "Dialogs",
      "key": "line:Rocker_Ears_Gun_047eeb4",
      "source": "Rocker: А тебе вот не зашло.",
      "target": "Rocker: Neked viszont nem jött be.",
      "authoredFile": "Translations/hu/dialogue-batch-364.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11801,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453847719942",
      "collection": "Dialogs",
      "key": "line:Rocker_Photo_Gun_0d2c389",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11802,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453847719941",
      "collection": "Dialogs",
      "key": "line:Rocker_Photo_Gun_0edc7df",
      "source": "Выстрелить",
      "target": "Lövés",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
