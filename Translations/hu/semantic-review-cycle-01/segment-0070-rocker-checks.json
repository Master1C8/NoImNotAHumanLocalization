      "collection": "Dialogs",
      "key": "line:Rocker_Hands_Gun_08738c7",
      "source": "Rocker: Мне особо бояться-то нечего уже.",
      "target": "Rocker: Nekem már nem sok félnivalóm maradt.",
      "authoredFile": "Translations/hu/dialogue-batch-364.json",
      "reviewResult": "pass"
    },
    {
