      "collection": "Dialogs",
      "key": "line:Rocker_Eyes_Gun_0b322ab",
      "source": "Rocker: Да расслабься ты. За оружие взялся зачем-то.",
      "target": "Rocker: Nyugodj már meg. Miért kaptál fegyvert?",
      "authoredFile": "Translations/hu/dialogue-batch-364.json",
      "reviewResult": "proposed correction"
    },
    {
