  "rows": [
    {
      "ordinal": 11780,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453856108547",
      "collection": "Dialogs",
      "key": "line:Rocker_Death_04fc244",
      "source": "Rocker: ЕБАШЬ РОК!",
      "target": "Rocker: SZÓLJON A ROCK!",
      "authoredFile": "Translations/hu/dialogue-batch-364.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11781,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453856108546",
      "collection": "Dialogs",
      "key": "line:Rocker_Death_0d93815",
      "source": "Rocker: Кто знает, может, и братаны меня встретят там.",
      "target": "Rocker: Ki tudja, talán a haverok is várnak majd odaát.",
      "authoredFile": "Translations/hu/dialogue-batch-364.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11782,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453856108545",
      "collection": "Dialogs",
      "key": "line:Rocker_Death_0991e13",
      "source": "Rocker: Это будет моё самое яркое выступление.",
      "target": "Rocker: Ez lesz életem legemlékezetesebb fellépése.",
      "authoredFile": "Translations/hu/dialogue-batch-364.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11783,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453856108544",
      "collection": "Dialogs",
      "key": "line:Rocker_Death_0df9823",
      "source": "Rocker: Знаешь…",
      "target": "Rocker: Tudod…",
      "authoredFile": "Translations/hu/dialogue-batch-364.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11784,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453851914251",
      "collection": "Dialogs",
      "key": "line:Rocker_Ears_DontShoot_0304c10",
      "source": "Rocker: Нашу… говорю так, будто есть с кем играть.",
      "target": "Rocker: A mi… Úgy beszélek, mintha még volna kivel zenélni.",
      "authoredFile": "Translations/hu/dialogue-batch-364.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11785,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453851914250",
      "collection": "Dialogs",
      "key": "line:Rocker_Ears_DontShoot_09e9caf",
      "source": "Rocker: Мне прям хочется добавить колокольный звон в нашу песню.",
      "target": "Rocker: Most kedvem támadt harangszót rakni a dalunkba.",
      "authoredFile": "Translations/hu/dialogue-batch-364.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11786,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453851914249",
      "collection": "Dialogs",
      "key": "line:Rocker_Ears_DontShoot_05a87ee",
      "source": "Rocker: Знаешь, никогда бы не добавил колокольный звон в нашу песню.",
      "target": "Rocker: Tudod, sosem tettem volna harangszót a dalunkba.",
      "authoredFile": "Translations/hu/dialogue-batch-364.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11787,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453851914248",
      "collection": "Dialogs",
      "key": "line:Rocker_Photo_DontShoot_0ecb1ca",
      "source": "Rocker: Даже у нас на репточке как-то посветлее получалось. А тут у тебя свет есть.",
      "target": "Rocker: Még a próbatermünkben is világosabb képek készültek. Nálad pedig van világítás.",
      "authoredFile": "Translations/hu/dialogue-batch-364.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11788,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453851914247",
      "collection": "Dialogs",
      "key": "line:Rocker_Photo_DontShoot_0005853",
      "source": "Rocker: Чё фотка такая тёмная?",
      "target": "Rocker: Miért ilyen sötét ez a fotó?",
      "authoredFile": "Translations/hu/dialogue-batch-364.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11789,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453851914246",
      "collection": "Dialogs",
      "key": "line:Rocker_Armpit_DontShoot_0cc59c8",
      "source": "Rocker: Спасибо, что посмотрел. Наверно.",
      "target": "Rocker: Kösz, hogy megnézted. Azt hiszem.",
      "authoredFile": "Translations/hu/dialogue-batch-364.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11790,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453851914245",
      "collection": "Dialogs",
      "key": "line:Rocker_Armpit_DontShoot_0225f8b",
      "source": "Rocker: Знаешь, мне тут даже сказать нечего.",
      "target": "Rocker: Tudod, erre már mondani sem tudok semmit.",
      "authoredFile": "Translations/hu/dialogue-batch-364.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11791,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453851914244",
      "collection": "Dialogs",
      "key": "line:Rocker_Eyes_DontShoot_041d9c1",
      "source": "Rocker: Так наебениться охота.",
      "target": "Rocker: Úgy berúgnék most.",
      "authoredFile": "Translations/hu/dialogue-batch-364.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11792,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453851914243",
      "collection": "Dialogs",
      "key": "line:Rocker_Eyes_DontShoot_0a4ef57",
      "source": "Rocker: Жаль у тебя чего покрепче пива нет.",
      "target": "Rocker: Kár, hogy nincs nálad valami erősebb a sörnél.",
      "authoredFile": "Translations/hu/dialogue-batch-364.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11793,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453851914242",
      "collection": "Dialogs",
      "key": "line:Rocker_Hands_DontShoot_0a6eead",
      "source": "Rocker: Заебашить бы сейчас рок фестиваль какой… Прям под настроение.",
      "target": "Rocker: Most de csinálnék egy kibaszott rockfesztivált… Pont ilyen hangulatban vagyok.",
      "authoredFile": "Translations/hu/dialogue-batch-364.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11794,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453851914241",
      "collection": "Dialogs",
      "key": "line:Rocker_Hands_DontShoot_01ddf2c",
      "source": "Rocker: Разве спою я ща где-нибудь?",
      "target": "Rocker: Hol énekelhetnék én most egyáltalán?",
      "authoredFile": "Translations/hu/dialogue-batch-364.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11795,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453851914240",
      "collection": "Dialogs",
      "key": "line:Rocker_Hands_DontShoot_03eda66",
      "source": "Rocker: А в целом, и выстрелил бы, что изменилось?",
      "target": "Rocker: De összességében, ha lelőttél volna, mi változott volna?",
      "authoredFile": "Translations/hu/dialogue-batch-364.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11796,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453847719947",
      "collection": "Dialogs",
      "key": "line:Rocker_Teeth_DontShoot_0163e7c",
      "source": "Rocker: У меня пока особо нет под него идей, но пока в голове просто монотонный гул.",
      "target": "Rocker: Egyelőre nincs hozzá különösebb ötletem, csak egy monoton zúgás jár a fejemben.",
      "authoredFile": "Translations/hu/dialogue-batch-364.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11797,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453847719946",
      "collection": "Dialogs",
      "key": "line:Rocker_Teeth_DontShoot_0b7add3",
      "source": "Rocker: Значит, видать, впереди ещё ждёт меня тот самый жирнющий рифф.",
      "target": "Rocker: Úgy látszik, még előttem van az a bizonyos dögös riff.",
      "authoredFile": "Translations/hu/dialogue-batch-364.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11798,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453847719945",
      "collection": "Dialogs",
      "key": "line:Rocker_Ears_Gun_0a3fb9b",
      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
