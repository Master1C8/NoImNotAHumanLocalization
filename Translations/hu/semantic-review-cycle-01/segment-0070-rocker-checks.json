      "source": "Выслушать",
      "target": "Meghallgatás",
      "authoredFile": "Translations/hu/dialogue-batch-001.json",
      "reviewResult": "pass"
    },
    {
      "ordinal": 11809,
      "stableId": "string:444ff14f1967f5a4c8eb9e4cf4c913f1:110504453843525641",
