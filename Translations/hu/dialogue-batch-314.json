  "entries": [
    {
      "id": 110504454543974407,
      "target": "Daughter: Én... én a-anyához aka-rok menni."
    },
    {
      "id": 110504454543974406,
      "target": "Daughter: Futottam, de láttam őt."
    },
    {
      "id": 110504454543974405,
      "target": "Daughter: Láttam, hogy aztán felkelt és elment."
    },
    {
      "id": 110504454543974404,
      "target": "Daughter: Ugye eljön értem?"
    },
    {
      "id": 110504454543974403,
      "target": "Daughter: Apa nélkül nem megyek sehová."
    },
    {
      "id": 110504454543974402,
      "target": "Daughter: Ugye hamarosan itt lesz?"
    },
    {
      "id": 110504454543974401,
      "target": "Daughter: Vagy egyszerűen elindulhatott megkeresni engem."
    },
    {
      "id": 110504454543974400,
      "target": "Daughter: Akkor… akkor a tüzet is el tudta oltani."
    },
    {
      "id": 110504454539780107,
      "target": "Daughter: Apát megütötték, de aztán felkelt. Láttam."
    },
    {
      "id": 110504454539780106,
      "target": "Daughter: Nem vagyok biztos benne."
    },
    {
      "id": 110504454539780105,
      "target": "Daughter: Nem tudom."
    },
    {
      "id": 110504454539780104,
      "target": "Jobb, ha egyelőre itt maradsz."
    },
    {
      "id": 110504454539780103,
      "target": "Hiszen láttad, mi történt."
    },
    {
      "id": 110504454539780102,
      "target": "Daughter: Maradt még valaki közülünk?"
    },
    {
      "id": 110504454539780101,
      "target": "Daughter: Anya nem jön értünk?"
    },
    {
      "id": 110504454539780099,
      "target": "Daughter: És a szobám? Az is leégett?"
    },
    {
      "id": 110504454539780098,
      "target": "Daughter: De apával minden rendben?"
    },
    {
      "id": 110504454539780097,
      "target": "Jobb, ha egyelőre itt maradsz."
    },
    {
      "id": 110504454539780096,
      "target": "Hiszen láttad, mi történt."
    },
    {
      "id": 110504454535585803,
      "target": "Daughter: Akkor apa mégis eljön értem, ugye?"
    },
    {
      "id": 110504454535585802,
      "target": "Daughter: Csinálnak nekem új szobát?"
    },
    {
      "id": 110504454535585801,
      "target": "Daughter: Vagy ugyanabba a házba?"
    },
    {
      "id": 110504454535585800,
      "target": "Daughter: És elvisznek az új házba?"
    },
    {
      "id": 110504454535585799,
      "target": "Daughter: Jó. Akkor hamarosan jönnek értem?"
    },
    {
      "id": 110504454535585798,
      "target": "Nem mostanában. Leégett a házatok."
    },
    {
      "id": 110504454535585797,
      "target": "Később. Felújítják."
    },
    {
      "id": 110504454535585796,
      "target": "Daughter: Mikor mehetek haza?"
    },
    {
      "id": 110504454535585795,
      "target": "Daughter: Haza szeretnék menni…"
    },
    {
      "id": 110504454535585794,
      "target": "Daughter: Egész jó itt."
    },
    {
      "id": 110504454535585792,
      "target": "Hogy vagy? Tetszik itt?"
    },
    {
      "id": 110504454531391500,
      "target": "Daughter: Én... én a-anyához aka-rok menni."
    },
    {
      "id": 110504454531391499,
      "target": "Daughter: (A kislány meg sem hallja önt. Egyedül van a gyászával.)"
    },
    {
      "id": 110504454531391498,
      "target": "Daughter: (A kislány megállás nélkül az apját kiáltja. A hisztériás rohama nem fog hamar elmúlni.)"
    },
    {
      "id": 110504454531391497,
      "target": "Holnap még beszélek veled, jó?"
    },
    {
      "id": 110504454531391496,
      "target": "Te… most pihenj."
    },
    {
      "id": 110504454531391495,
      "target": "Daughter: APÁÁÁ-ÁÁÁ!"
    },
    {
      "id": 110504454531391494,
      "target": "Daughter: APA, APUKÁM!"
    },
    {
      "id": 110504454531391493,
      "target": "Daughter: Bejöttek, beszélni kezdtek, apa azt mondta, hogy ilyet nem szabad, ők meg azt mondták, hogy … mondták…"
    },
    {
      "id": 110504454531391492,
      "target": "Daughter: Nem tu-u-udom."
    },
    {
      "id": 110504454531391490,
      "target": "Meséld el, mi történt."
    },
    {
      "id": 110504454531391489,
      "target": "Daughter: Én... én a-anyához aka-rok menni."
    }
  ]
}
