  "entries": [
    {
      "id": 110504453352792068,
      "target": "Cultist1: Ez hiba volt."
    },
    {
      "id": 110504453352792067,
      "target": "Cultist1: Viselned kell majd a döntésed következményeit."
    },
    {
      "id": 110504453352792065,
      "target": "Cultist1: Régóta nem fényképezkedtem."
    },
    {
      "id": 110504453348597767,
      "target": "Cultist1: Nincs mit mondanom."
    },
    {
      "id": 110504453348597766,
      "target": "Cultist1: Nem tudom, mire vársz."
    },
    {
      "id": 110504453348597765,
      "target": "Cultist1: Csak állj készen a távozásra, ha eljön az ideje."
    },
    {
      "id": 110504453348597764,
      "target": "Cultist1: Mire jók neked ezek a vizsgálatok?"
    },
    {
      "id": 110504453344403462,
      "target": "Cultist1: Nem kellene."
    },
    {
      "id": 110504453344403456,
      "target": "Cultist1: Ezt nem kellene megtenned."
    },
    {
      "id": 110504453340209155,
      "target": "Cultist1: Még korai."
    },
    {
      "id": 110504453336014849,
      "target": "Cultist1: Hát miért ne."
    },
    {
      "id": 110504453331820544,
      "target": "Cultist1: Elfáradtam a készülődésben."
    },
    {
      "id": 110504453319237639,
      "target": "Cultist1: A Halál hideg kezében melenget majd minket."
    }
  ]
}
