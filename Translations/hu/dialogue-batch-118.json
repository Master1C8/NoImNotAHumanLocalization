  "entries": [
    {
      "id": 110504456867618824,
      "target": "Otthagytad a munkahelyedet?"
    },
    {
      "id": 110504456867618823,
      "target": "És mi érdekeset láttál?"
    },
    {
      "id": 110504456867618822,
      "target": "GraveDigger: Mindent úgy hagytak, ahogy volt, a napon úgyis elég."
    },
    {
      "id": 110504456867618821,
      "target": "GraveDigger: Mostanában tömegesen halnak meg az emberek, de senki sem temeti el őket."
    },
    {
      "id": 110504456867618820,
      "target": "GraveDigger: Ha láttad volna, amit én láttam, miközben egy újabb gödröt ástam…"
    },
    {
      "id": 110504456867618819,
      "target": "GraveDigger: Haver, haver, bocsáss meg, hogy így dörömbölök az ajtódon."
    },
    {
      "id": 110504456867618818,
      "target": "Otthagytad a munkahelyedet?"
    },
    {
      "id": 110504456867618817,
      "target": "És mi érdekeset láttál?"
    },
    {
      "id": 110504456867618816,
      "target": "GraveDigger: Senkinek sem kell már gödröt ásni, teljesen értelmetlen munka."
    },
    {
      "id": 110504456863424522,
      "target": "GraveDigger: Sírásóként dolgozom. Vagyis dolgoztam."
    },
    {
      "id": 110504456863424521,
      "target": "GraveDigger: Álom sincs a szememben."
    },
    {
      "id": 110504456863424520,
      "target": "GraveDigger: Ne haragudj, ha felébresztettelek."
    },
    {
      "id": 110504456863424519,
      "target": "A saját fejedet kopogtasd"
    },
    {
      "id": 110504456863424518,
      "target": "Ne dörömbölj itt"
    },
    {
      "id": 110504456863424517,
      "target": "GraveDigger: Engedjenek már be!"
    },
    {
      "id": 110504456863424516,
      "target": "GraveDigger: Van itt még élő ember? HAHÓ!"
    }
  ]
}
