{
  "schemaVersion": 1,
  "sourceInventorySha256": "ecd96645c2ca6f23f8bf3ab2fcf65709e961478ae15a38e83d94cc335a408bf0",
  "entries": [
    {
      "id": 110504457870057480,
      "key": "line:radio_5_09b3a2c",
      "source": "Звоните прямо сейчас по номеру 891-533 и мы подберём для вас идеального собеседника.",
      "sourceSha256": "f4eaaca14ad6858f2daa3a11484302e6477b6df7db79373b944bcb7858fb18ca",
      "nodeNames": [
        "radio_5"
      ]
    },
    {
      "id": 110504457870057479,
      "key": "line:radio_5_011a65c",
      "source": "Тогда телефонная рулетка — то, что вам нужно.",
      "sourceSha256": "d7787f04493591dc504e00fd592a999b80b194e7934540e7df368e88fb33139f",
      "nodeNames": [
        "radio_5"
      ]
    },
    {
      "id": 110504457870057478,
      "key": "line:radio_5_004014d",
      "source": "Не с кем поговорить и чувствуете тревогу?",
      "sourceSha256": "36c9533e9020776576dba009cebc6e2541f1e5eececb5065468b706708fe0ba3",
      "nodeNames": [
        "radio_5"
      ]
    },
    {
      "id": 110504457870057477,
      "key": "line:radio_5_09578ef",
      "source": "Вы чувствуете себя одиноко?",
      "sourceSha256": "4ed6d4c60144d5632e6d0637295c00ec767f878313f529a7859e24fcacea4ca0",
      "nodeNames": [
        "radio_5"
      ]
    },
    {
      "id": 110504457719062535,
      "key": "line:radio_13_0e310a4",
      "source": "Повт…ряю, вызывайте подкр…пление. Нам не спр…виться с субъ…ктом.",
      "sourceSha256": "446cddcd442d4d9d3641ecb886765a2bfba61c336f99cc8c5fe7a1994d98e5f8",
      "nodeNames": [
        "radio_13"
      ]
    },
    {
      "id": 110504457719062534,
      "key": "line:radio_13_00e01fd",
      "source": "Субъ…кт покинул террит…рию города. Ср…чно вызывайте подкр…пление.",
      "sourceSha256": "23d5ba39496cfd2b1f3fb87d95a3a344176464c85a4571b6f3e790ba48a8e48f",
      "nodeNames": [
        "radio_13"
      ]
    },
    {
      "id": 110504457719062533,
      "key": "line:radio_13_03cbc34",
      "source": "Говорит с…трудник 18-8: угр…зу не уд…лось сдержать.",
      "sourceSha256": "d346d0422694fb8e69b208c3e7179fefee1af8e8bcdd5c90208c29f435d51483",
      "nodeNames": [
        "radio_13"
      ]
    },
    {
      "id": 110504457719062532,
      "key": "line:radio_12_0b4364c",
      "source": "Повт…ряю, код 451 от…еняется. Сожжение тру…ов недопуст…мо для сдерж…вания угрозы от субъ…кта………",
      "sourceSha256": "15f9e5e55adf57fd10b7b810852933158b03441000864bd1ee979644025df4a1",
      "nodeNames": [
        "radio_12"
      ]
    },
    {
      "id": 110504457719062531,
      "key": "line:radio_12_0bafc77",
      "source": "Тела не сж…гать. Покрывать их изв…стью.",
      "sourceSha256": "6bc773fd67698387af9934dea3caf79ff9bb3564cfceb3d72b28fb123cdae797",
      "nodeNames": [
        "radio_12"
      ]
    },
    {
      "id": 110504457719062530,
      "key": "line:radio_12_07bc747",
      "source": "Новые ук…зания: код 451 заменяется н…вым кодом 955",
      "sourceSha256": "10591698f960d5ee2e5875575c8d594abdd276b8ca19489710a56f5d3f6247b4",
      "nodeNames": [
        "radio_12"
      ]
    },
    {
      "id": 110504457719062529,
      "key": "line:radio_12_066787a",
      "source": "Дисп…тчер на связи, вс…м сотрудн…кам КЧС…",
      "sourceSha256": "33c1bcdd736dcf1310621da755a0d5254516e6d7deed2e49ae309d0277dd5a50",
      "nodeNames": [
        "radio_12"
      ]
    },
    {
      "id": 110504457719062528,
      "key": "line:radio_11_0531e92",
      "source": "Если бы ……… те тела, оно бы не приш……",
      "sourceSha256": "7c2a704c1f9d8d1c9762eed054d0bc92b56093af83cff68b0c6bd1583dc7d1c8",
      "nodeNames": [
        "radio_11"
      ]
    },
    {
      "id": 110504457714868236,
      "key": "line:radio_11_082894a",
      "source": "Они зря сжи…али тела. Это при…анивает ………",
      "sourceSha256": "b5bc60ea6b862846384a1245296f48b5d4e762e7bf68dd7231a14d8967845bb3",
      "nodeNames": [
        "radio_11"
      ]
    },
    {
      "id": 110504457714868235,
      "key": "line:radio_10_0d71019",
      "source": "БЕГ…ТЕ ОТС…ДА КАК М…ЖНО СК…РЕЕ………",
      "sourceSha256": "c28fd624ba60e8ac544d1a10b619ff03e3e09ff4f50865d1fc748d142950855c",
      "nodeNames": [
        "radio_10"
      ]
    },
    {
      "id": 110504457714868234,
      "key": "line:radio_10_06ef9d6",
      "source": "Изб…гайте патрулей КЧС, они ……таются убить в…с.",
      "sourceSha256": "1e813768798ee4b08b39dd36b71e1058fd664cd447ad93da23a14a8559522ea1",
      "nodeNames": [
        "radio_10"
      ]
    },
    {
      "id": 110504457714868233,
      "key": "line:radio_10_0b25018",
      "source": "Если вы в городе, выб…райтесь отсюда, зд…сь небезопасно.",
      "sourceSha256": "39de90f75aae17ab46bc440f4d6e66c90336efb18ae461e09f1658b003414a02",
      "nodeNames": [
        "radio_10"
      ]
    },
    {
      "id": 110504457714868232,
      "key": "line:radio_10_043f1a7",
      "source": "Пытаются всё свалить на того психа, который завалил всех в карантинной зоне.",
      "sourceSha256": "314733fc3388257cff7c4a521e97846f89e627d4b3f1ccfd6d3d7e7c362ea27a",
      "nodeNames": [
        "radio_10"
      ]
    },
    {
      "id": 110504457714868231,
      "key": "line:radio_10_0358cf4",
      "source": "Они хотят, чтобы все события в городе оставались засекречены.",
      "sourceSha256": "f9b4469da0b22ee5039d0b5bb195301934281c0870d50be0ffca574158e35a3f",
      "nodeNames": [
        "radio_10"
      ]
    },
    {
      "id": 110504457714868230,
      "key": "line:radio_10_0028ae0",
      "source": "КЧС пытается глушить связь в городе, чтобы избежать утечки информации.",
      "sourceSha256": "4ae43d594347a9615a63e2c709b5e467efbac0ff5e52f526d29ae0abb42b1b3d",
      "nodeNames": [
        "radio_10"
      ]
    },
    {
      "id": 110504457714868229,
      "key": "line:radio_10_088e182",
      "source": "Всем, кто меня слышит…",
      "sourceSha256": "e5b99a0e698e8e4e1fee2a5a29caca8ed645a248f21314064905daa9891c047d",
      "nodeNames": [
        "radio_10"
      ]
    },
    {
      "id": 110504457714868228,
      "key": "line:radio_9_0c4bcb1",
      "source": "Если вы можете поделиться едой, это очень поможет нам.",
      "sourceSha256": "5d22872157dcda4c2dad4a54520aa766d5a25195e3ba283e6dfbab91c2d7c6e3",
      "nodeNames": [
        "radio_9"
      ]
    },
    {
      "id": 110504457714868227,
      "key": "line:radio_9_0fb60c1",
      "source": "У нас есть совсем немного еды. Скоро мы начнем голодать.",
      "sourceSha256": "f9e31a7dcf7e45e09ac7bd1ac1b3cb4036f2bbd2eb71dc92464ae7f8869cf3c7",
      "nodeNames": [
        "radio_9"
      ]
    },
    {
      "id": 110504457714868226,
      "key": "line:radio_9_08e4440",
      "source": "Это недалеко от дома отшельника.",
      "sourceSha256": "58c565b2460b6781d57c418328cbf7b1784e812050ae1f1e4675832061405753",
      "nodeNames": [
        "radio_9"
      ]
    },
    {
      "id": 110504457714868225,
      "key": "line:radio_9_021ee49",
      "source": "Если КЧС вас выселили так же, как и нас, мы находимся в уцелевшем подвале сожжённого дома.",
      "sourceSha256": "3026e07a8c3d19a600f3f26970376fb1572f0a5c3db736a0a04fc5cb6d6f9790",
      "nodeNames": [
        "radio_9"
      ]
    },
    {
      "id": 110504457714868224,
      "key": "line:radio_9_03b4339",
      "source": "Говорят выселенные из домов.",
      "sourceSha256": "e22399ba697e8c4e5848f678eff9e58d098690a4bc6cfb84a67f551f55b957e4",
      "nodeNames": [
        "radio_9"
      ]
    },
    {
      "id": 110504457710673931,
      "key": "line:radio_8_06ef580",
      "source": "Это не человек…",
      "sourceSha256": "c574e7a3ebf27def7307c10c1721ffdfaaaeaee1de023631c32c74689fdbd3b2",
      "nodeNames": [
        "radio_8"
      ]
    },
    {
      "id": 110504457710673930,
      "key": "line:radio_8_00c6b84",
      "source": "Я видел, что там было.",
      "sourceSha256": "a8486e047a6084d34856a8a022c975957639cde02de077232b1bd9f87e4d4623",
      "nodeNames": [
        "radio_8"
      ]
    },
    {
      "id": 110504457710673929,
      "key": "line:radio_8_060c53b",
      "source": "Это не те люди, что напали на карантинную зону.",
      "sourceSha256": "2ef6a76464893e482ef4404382b80113bf22d58a89938442e466df66e33331b2",
      "nodeNames": [
        "radio_8"
      ]
    },
    {
      "id": 110504457710673928,
      "key": "line:radio_7_0306a22",
      "source": "КТО-НИБУДЬ ПОМО……",
      "sourceSha256": "1cfd0ef2b28d6d5254c9465d557f173dbf8a22b06f3ef432944c62b67ef8bf18",
      "nodeNames": [
        "radio_7"
      ]
    },
    {
      "id": 110504457710673927,
      "key": "line:radio_7_08975a7",
      "source": "Я НЕ ЗНАЮ, ЧТО ПРОИСХОДИТ. Я ПРОСТО ХОЧУ УЙТИ ОТСЮДА.",
      "sourceSha256": "02e23d43034b15f5ea03e3773eb523a9f1fdda4e19f6bdbc9744ed8391609a91",
      "nodeNames": [
        "radio_7"
      ]
    },
    {
      "id": 110504457710673926,
      "key": "line:radio_7_0de9ac3",
      "source": "Сотрудники КЧС стреляют по всем, кто пытается выбраться отсюда.",
      "sourceSha256": "a2f37f17f34d3d73a637265f7971a797caa506aa0236e94bcd73ae3b70ae5cea",
      "nodeNames": [
        "radio_7"
      ]
    },
    {
      "id": 110504457710673925,
      "key": "line:radio_7_0c949eb",
      "source": "Если вы меня слышите, не приближайтесь к окраинам города.",
      "sourceSha256": "11f7cf39714e8a48c878526e6f2755c77c2e8e2be408416401b773d3a14c2eb0",
      "nodeNames": [
        "radio_7"
      ]
    },
    {
      "id": 110504457710673924,
      "key": "line:radio_6_03964f5",
      "source": "Принято. Инициируется код 984: город взят в оцепление до выяснения обстоятельств. Ожидайте подкрепление.",
      "sourceSha256": "89025fc6412364f1f81335b524bd8904d6158f24483b9236c9fd22ebd4ea151b",
      "nodeNames": [
        "radio_6"
      ]
    },
    {
      "id": 110504457710673923,
      "key": "line:radio_6_05ac3fe",
      "source": "Докладывает сотрудник 28-8. Код 451: нужна бригада для сожжения трупов.",
      "sourceSha256": "fcbf08eb4912c66f7542df72b6a5f09cfb3e4603738d963ce3471c2ea522a68f",
      "nodeNames": [
        "radio_6"
      ]
    },
    {
      "id": 110504457710673922,
      "key": "line:radio_6_0aa3b6b",
      "source": "Сотрудник 32-8 докладывает. Код 60: множество жертв среди гражданских, сотрудники убиты…",
      "sourceSha256": "efc5038c99a4d49aa97991ec05498f991327d5d1b288af6af69fcdc34fe5fad5",
      "nodeNames": [
        "radio_6"
      ]
    },
    {
      "id": 110504457710673921,
      "key": "line:radio_6_06502d0",
      "source": "Говорит диспетчер. Проверьте, что случилось в карантинной зоне. Код 51. Докладывают о взрывах в 3 часа ночи.",
      "sourceSha256": "bf5b1131b51b51ede5d30d56529c14813c0e4804cce4dbb86b2521d4977d16c3",
      "nodeNames": [
        "radio_6"
      ]
    },
    {
      "id": 110504457576456197,
      "key": "line:radio_4_010d417",
      "source": "Проклятье, я знал, что нам не позволят вещать правду. Мать их…",
      "sourceSha256": "b986daca88aabbeec911ab66e667310e78a41d23d9c1c09395f8f383a906d505",
      "nodeNames": [
        "radio_4"
      ]
    },
    {
      "id": 110504457576456196,
      "key": "line:radio_4_0c66193",
      "source": "Как это у него украли все документы? Там же КИЛОТОННЫ ИНФОРМАЦИИ!",
      "sourceSha256": "5df194ea6ff69aab6ccaf3336841fd47da1e4e95c7a151d781c48313c305b070",
      "nodeNames": [
        "radio_4"
      ]
    },
    {
      "id": 110504457576456195,
      "key": "line:radio_4_02787e8",
      "source": "Погодите, что!? Он не придёт?",
      "sourceSha256": "d2da9d2553705ec0fa79cc9579b18d4b178c6d168f87d39e7bb1e1300dba2a00",
      "nodeNames": [
        "radio_4"
      ]
    },
    {
      "id": 110504457576456194,
      "key": "line:radio_4_07ccc41",
      "source": "Сегодня мы расскажем всю правду про Гостей. А в гостях у нас уважаемый сотрудник НИИ, доктор наук…",
      "sourceSha256": "02dba64d03f113c6022ea65f3fa3a7047334ac515050a071e3e21f90c24a23ed",
      "nodeNames": [
        "radio_4"
      ]
    },
    {
      "id": 110504457576456193,
      "key": "line:radio_4_05b109a",
      "source": "Добрый день, дорогие слушатели. В эфире передача “Я хочу верить”. Здесь мы раскрываем тайны и заговоры правительства.",
      "sourceSha256": "535b58e7698211a19068373a02bd025ca934392f114e5b522c8cc42979ed1e03",
      "nodeNames": [
        "radio_4"
      ]
    },
    {
      "id": 110504457576456192,
      "key": "line:radio_3_0c00d44",
      "source": "Они прогонят злой дух, очистят ваше тело от пагубной ауры и установят вам семь степеней защиты.",
      "sourceSha256": "60fc01083c3a9053d6234f23834017d82bc5fce09fe1a5fdd0bbd2f8cdc12268",
      "nodeNames": [
        "radio_3"
      ]
    },
    {
      "id": 110504457572261899,
      "key": "line:radio_3_0b0b505",
      "source": "Не позвольте этой гнили завладеть вашим телом! Срочно звоните нашим экспертам: 777-460.",
      "sourceSha256": "52ace19c2c2debe37ce5f04dd24a75ababd59cb32d9b1e8d9121a71f208da280",
      "nodeNames": [
        "radio_3"
      ]
    },
    {
      "id": 110504457572261898,
      "key": "line:radio_3_0b9d95a",
      "source": "В вас вселился злой дух: Гостевой!",
      "sourceSha256": "55f03dfd55b5caee4b047b03a88a1940c81784551e08634b7b2e8400be49abac",
      "nodeNames": [
        "radio_3"
      ]
    },
    {
      "id": 110504457572261897,
      "key": "line:radio_3_076e145",
      "source": "У вас покраснели глаза? Побелели зубы? Под ногтями появилась грязь?",
      "sourceSha256": "69728bcd977b21ec885417a8336e36493b3db8ff4131f7e303a0da38358e2625",
      "nodeNames": [
        "radio_3"
      ]
    },
    {
      "id": 110504457572261896,
      "key": "line:radio_2_01f56ed",
      "source": "Но, пожалуйста, не шлите ничего, кроме глаз, зубов и ногтей. Ничего другого мы не принимаем.",
      "sourceSha256": "e712fdb04decd8b4700d04c1afaf42b29f3e065d89b2aef1468e48b609dfb366",
      "nodeNames": [
        "radio_2"
      ]
    },
    {
      "id": 110504457572261895,
      "key": "line:radio_2_0c8dc22",
      "source": "Присылайте на нашу почту: yesiam@humanverification.agency свои фотографии и узнайте же, кто вы.",
      "sourceSha256": "9f4fad6604fc85a453ed7cc4c07efb936e859522c95626b2887f41294b530707",
      "nodeNames": [
        "radio_2"
      ]
    },
    {
      "id": 110504457572261894,
      "key": "line:radio_2_09c9a83",
      "source": "Цель проста: вы присылаете ваши фотографии, а мы смотрим, кто же вы на самом деле.",
      "sourceSha256": "8f43db417199ba274cc55f0a2135c867a5c7114debc3a1fa5126139152209210",
      "nodeNames": [
        "radio_2"
      ]
    },
    {
      "id": 110504457572261893,
      "key": "line:radio_2_044ab03",
      "source": "А сейчас в эфире наша новая передача «Да, я человек».",
      "sourceSha256": "d30027279293e691e539fc6d52ce3bb9b481938388f23c7384b3d16359528290",
      "nodeNames": [
        "radio_2"
      ]
    },
    {
      "id": 110504457572261892,
      "key": "line:radio_1_0e22647",
      "source": "— Не выходите из дома до того, как стемнеет. — Нет, ночью ходит он. Тощий и бледный… это не человек.",
      "sourceSha256": "5451714c55f1def2b4a836aa7965aa2ff65dc45bdc0f49a1db34fbbf1eb2b8b3",
      "nodeNames": [
        "radio_1"
      ]
    },
    {
      "id": 110504457572261891,
      "key": "line:radio_1_0988229",
      "source": "— Опишите, что вы видите? Пожар? — Нет, это солнце. Они… они сгорают на солнце.",
      "sourceSha256": "3dfdf8645b909ca9c4ecfe78c14ce06862d393bc93746a343b545a0e54330a8c",
      "nodeNames": [
        "radio_1"
      ]
    },
    {
      "id": 110504457572261890,
      "key": "line:radio_1_0d6b913",
      "source": "— Алло, это диспетчер службы спасения. Чем вам помочь? — Люди… они горят.",
      "sourceSha256": "09adeb524f1289bbf192baa8932c85e5d578171065cd217b4bdb3a541de3f8ed",
      "nodeNames": [
        "radio_1"
      ]
    }
  ]
}
